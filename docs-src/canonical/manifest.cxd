[# Table of contents for cx-data-and-code-guide.
   Each entry is one section file under sections/; the order here is the
   reading order in the rendered output. Section numbers (1.1.1, etc.)
   are derived from depth at render time, not hand-maintained — so
   reordering or inserting sections does not require renumbering.

   STATUS: scaffold only. Section files do not yet exist. Authoring
   begins after ADR 0028 lands so the guide can render with full
   sectional structure. This manifest is the working outline. #]

[manifest
  title='CX — The CX Data and Code Language'
  subtitle='Developer guide and reference'
  branch=v0.8.0-dev
  target-output='docs/cx-data-and-code-guide.md (single file) + multi-file emit later'
  status=scaffold

  [section n=1 id=intro file='01-intro.cxd'
    [child n=1.1 id=hello       title='Hello, CX']
    [child n=1.2 id=philosophy  title='Design philosophy']
    [child n=1.3 id=reading     title='How to read this guide']]

  [section n=2 id=data file='02-data-language.cxd'
    [child n=2.1 id=lexical
      [child n=2.1.1 id=identifiers title='Identifiers']
      [child n=2.1.2 id=comments    title='Comments (line and block)']
      [child n=2.1.3 id=whitespace  title='Whitespace']]
    [child n=2.2 id=elements
      [child n=2.2.1 id=names       title='Element names']
      [child n=2.2.2 id=attributes  title='Attributes']
      [child n=2.2.3 id=bodies      title='Body content']]
    [child n=2.3 id=scalars
      [child n=2.3.1 id=strings     title='Strings — single, double, triple-quoted']
      [child n=2.3.2 id=numbers     title='Numbers — int, float, sized, hex']
      [child n=2.3.3 id=booleans    title='Booleans']
      [child n=2.3.4 id=dates       title='Dates and datetimes']
      [child n=2.3.5 id=null        title='Null']]
    [child n=2.4 id=collections
      [child n=2.4.1 id=seq         title='Sequence literals (a, b, c)']
      [child n=2.4.2 id=arr         title='Array literals [a, b, c]']
      [child n=2.4.3 id=map         title='Map literals {k: v}']]
    [child n=2.5 id=sigils
      [child n=2.5.1 id=anchor      title='The & anchor sigil']
      [child n=2.5.2 id=merge       title='The * merge sigil']
      [child n=2.5.3 id=id          title='The # id sigil']
      [child n=2.5.4 id=type        title='The : type sigil']
      [child n=2.5.5 id=bool        title='The + and - bool sigils']]
    [child n=2.6 id=prose           title='Mixed content and prose']
    [child n=2.7 id=tables          title='Typed columnar tables']
    [child n=2.8 id=schema          title='Schema language (.cxs)']
    [child n=2.9 id=includes        title='Include resolver']]

  [section n=3 id=surfaces file='03-surfaces.cxd'
    [child n=3.1 id=cx-canonical title='CX — the canonical dialect']
    [child n=3.2 id=json         title='JSON projection']
    [child n=3.3 id=yaml         title='YAML projection']
    [child n=3.4 id=toml         title='TOML projection']
    [child n=3.5 id=xml          title='XML projection']
    [child n=3.6 id=md           title='Markdown projection']
    [child n=3.7 id=roundtrip    title='Round-trip guarantees']]

  [section n=4 id=identity file='04-identity.cxd'
    [child n=4.1 id=canonical    title='Canonical bytes']
    [child n=4.2 id=hash         title='SHA-256 content hash']
    [child n=4.3 id=ast-bin      title='ast-bin wire format']
    [child n=4.4 id=data-bin     title='data-bin schema-driven format']]

  [section n=5 id=code file='05-code.cxd'
    [child n=5.1 id=overview     title='The CX code language']
    [child n=5.2 id=directives   title='Directive registry']
    [child n=5.3 id=cxpath       title='CXPath — the universal selector']
    [child n=5.4 id=patterns     title='Patterns and matching']
    [child n=5.5 id=bindings     title='Bindings and paths']
    [child n=5.6 id=constructs
      [child n=5.6.1 id=for      title='[?for] — iteration']
      [child n=5.6.2 id=match    title='[?match] — dispatch']
      [child n=5.6.3 id=if       title='[?if] — boolean branch']
      [child n=5.6.4 id=let      title='[?let] — binding']
      [child n=5.6.5 id=modify   title='[?modify] — pure-functional updates']
      [child n=5.6.6 id=pipe     title='Pipelines and composition']]
    [child n=5.7 id=builtins
      [child n=5.7.1 id=sequence-builtins title='Sequence built-ins']
      [child n=5.7.2 id=string-builtins   title='String built-ins']
      [child n=5.7.3 id=numeric-builtins  title='Numeric built-ins']
      [child n=5.7.4 id=logical-builtins  title='Logical built-ins']
      [child n=5.7.5 id=accessor-builtins title='Node-accessor built-ins']]
    [child n=5.8 id=errors       title='Errors as values']
    [child n=5.9 id=concurrency
      [child n=5.9.1 id=services title='Services and clients']
      [child n=5.9.2 id=workers  title='Workers and channels']
      [child n=5.9.3 id=async    title='Async and await']]
    [child n=5.10 id=resilience  title='Resilience directives']]

  [section n=6 id=bindings file='06-bindings.cxd'
    [child n=6.1 id=c-abi        title='The C ABI surface']
    [child n=6.2 id=layer-1      title='Layer 1 — canonical method set']
    [child n=6.3 id=layer-2      title='Layer 2 — host idiom packs']
    [child n=6.4 id=schema-codegen title='Schema-driven codegen']
    [child n=6.5 id=quickstarts
      [child n=6.5.1 id=v        title='V (native reference)']
      [child n=6.5.2 id=python   title='Python']
      [child n=6.5.3 id=go       title='Go']
      [child n=6.5.4 id=rust     title='Rust']]]

  [section n=7 id=tooling file='07-tooling.cxd'
    [child n=7.1 id=cli          title='The cx CLI']
    [child n=7.2 id=editors      title='Editor integration']
    [child n=7.3 id=lsp          title='Language server (LSP)']
    [child n=7.4 id=tree-sitter  title='Tree-sitter grammar']]

  [section n=8 id=concepts file='08-concepts.cxd'
    [child n=8.1 id=homoiconicity      title='Homoiconicity']
    [child n=8.2 id=errors-as-values   title='Errors as values']
    [child n=8.3 id=pure-updates       title='Pure-functional updates and lenses']
    [child n=8.4 id=streaming          title='Streaming']
    [child n=8.5 id=parallelism        title='Parallelism by construction']]

  [section n=9 id=migration file='09-migration.cxd'
    [child n=9.1 id=from-v07x        title='From v0.7.x to v0.8.0']
    [child n=9.2 id=from-xml         title='From XML']
    [child n=9.3 id=from-json-yaml   title='From JSON / YAML / TOML']
    [child n=9.4 id=retired-surfaces title='Retired surfaces and replacements']]
]
