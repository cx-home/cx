[# Table of contents for cx-data-and-code-guide.
   Each entry is one section file under sections/; the order here is the
   reading order in the rendered output. Section numbers (1.1.1, etc.)
   are derived from depth at render time, not hand-maintained — so
   reordering or inserting sections does not require renumbering.

   STATUS: scaffold only. Section files do not yet exist. Authoring
   begins once the guide can render with full sectional structure.
   This manifest is the working outline. #]

[manifest
  title='CX — The CX Data and Code Language'
  subtitle='Developer guide and reference'
  branch=v0.8.0-dev
  target-output='docs/cx-data-and-code-guide.md (single file) + multi-file emit later'
  status=scaffold

  [# front-matter — appears before [section n=1] in render order #]
  [section n=0 id=quickstart file='00-quickstart.cxd'
    [child n=0.1 id=install          title='Install']
    [child n=0.2 id=hello-cx         title='Hello, CX']
