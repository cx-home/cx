  [open

    [issue &i-doc-gen-sectional-regression
      :priority high
      :title 'Doc-gen flat-section render replaces v0.7.5 nested structure'
      :symptom 'All h2s clumped, then all p clumped — no per-section grouping; ‹section›→content relationship lost'
      :evidence '_site_staging/quickstart.html structurally different from docs/quickstart.html (v0.7.5 byte-identical baseline)'
      :blocks-on '[adr-0028, scoped-find-spec-amendment]'
      :resolution-plan 'After ADR 0028: rewrite build.cx using CXPath value kind + sectional [?for] over //section']

    [issue &i-cxpath-retired-binding-pain
      :priority high
      :title 'CXPath retired from C ABI; no terse equivalent in bindings'
      :symptom 'doc.select_all() removed; host-language nested loops required for any predicate selection'
      :evidence 'lang/python/cxlib/cx.py:749 — "cx_select_all_paths removed"'
      :blocks-on adr-0028
      :resolution-plan 'CXPath as first-class expression value; bindings expose select_all(path) as Layer-1 method that wraps cx_code_eval']

    [issue &i-no-multi-arm-match
      :priority high
      :title '[?match] is single-arm only; no scalar literals; no :else'
      :symptom 'Shape dispatch over heterogeneous values requires chained [?if] + name() — verbose and unergonomic'
      :evidence 'spec/code.md §8.2 single-arm only; conformance program-err-001 locks single-arm error behavior but does not preclude N-arm extension'
      :blocks-on adr-0029
      :resolution-plan 'Add multi-arm :case / :when / :else + scalar literal patterns + _ wildcard']

    [issue &i-no-modify-surface
      :priority high
      :title 'No write/modify directive; cannot express pure-functional updates'
      :symptom 'CRUD restricted to R; no idiomatic U/D in CX code; bindings cannot offer doc.modify()'
      :blocks-on adr-0030
      :resolution-plan '[?modify VAL PATH :set | :delete | :using | :append | :prepend | :replace | :insert-before | :insert-after | :rename]']

    [issue &i-version-drift-across-files
      :priority low
      :title 'Version strings stale across binding manifests'
      :details '[(rust: 0.6.1), (python: 0.6.1), (vcx-binary: 0.7.5), (typescript: 0.7.6)]'
      :target-version 0.8.0
      :resolution-plan 'Cleanup commit early on v0.8.0-dev — single PR touches Cargo.toml + pyproject.toml + V version constant + package.json']

    [issue &i-rust-dead-code-warnings
      :priority low
      :title 'Rust binding has unused functions from Tier-2 catchup'
      :details '[cx_code_eval (unused — wrong arity?), node_from_value, attr_from_value, element_from_value, doc_from_value]'
      :resolution-plan 'Cleanup commit on v0.8.0-dev']

    [issue &i-examples-programs-tour-deleted
      :priority medium
      :title 'examples/programs-tour.cx deleted in 3a232283; never ported'
      :resolution-plan 'Restore on v0.8.0-dev once ADR 0028+0029 land — port to CXPath + multi-arm match syntax']

    [issue &i-playground-graph-mixed-input
      :priority medium
      :title 'Playground graph view fails CXER0100 on data+code mixed inputs'
      :symptom 'Corpus inputs stack [data] then [?find ...]; diagram emitter parses whole as code'
      :resolution-plan 'Split input before passing to diagram, OR graceful data-only handling (e.g., emit empty diagram + hint)']

    [issue &i-no-binding-api-parity-fixtures
      :priority medium
      :title 'No binding-API parity test surface (Layer-1 contract)'
      :symptom 'conformance/code.txt validates evaluator output; nothing validates that doc.find_all / doc.select / doc.modify exist with identical semantics in every binding'
      :resolution-plan 'Add conformance/binding_api.txt — input doc + method call + expected result/error; every binding runs the same fixtures']]

