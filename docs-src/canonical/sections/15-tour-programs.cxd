[# Section 15 — appendix: "50 Ways to Love Your CX Programs".
   Pizzeria-edition tour of CX directives, simple to complex,
   in 50 examples. Migrated from docs-src/content/tour/programs.cx
   during Phase B docs → guide consolidation (2026-05-24).
   Migrated to the current homoiconic-Lisp-1 surface
   2026-05-27. Designer pre-approved as guide appendix.
   File extension .cxd — data-only source. #]

[section id=tour-programs n=15 title='50 Ways to Love Your CX Programs'

  [intro
    """Fifty short CX code examples — paths, filters, conditionals,
       iteration, functions, modules — that walk from the simplest
       attribute read to a full pipeline with module activation,
       HTML-safe escaping, function definition, structured logging,
       semantic merge, and iteration. Each example pairs a tiny
       data input with a directive snippet."""]

  [child id=tp-1  n=15.1  title='1. A literal value'
    [body """A bare expression evaluates to itself. Here, the number 42."""]
    [example lang=cx """42"""]]

  [child id=tp-2  n=15.2  title='2. A literal string'
    [body """Same form; strings and numbers evaluate identically."""]
    [example lang=cx """'Hand-tossed since 1987'"""]]

  [child id=tp-3  n=15.3  title='3. Read an attribute — @name'
    [body """`@name` after a path step selects the attribute named `name`. Prints "Margherita"."""]
    [example lang=cx
      """[pizza name=Margherita]
         //pizza/@name"""]]

  [child id=tp-4  n=15.4  title='4. Find anywhere — //'
    [body """`//` matches a `pizza` element at any depth."""]
    [example lang=cx
      """[order [pizza name=Margherita]]
         //pizza/@name"""]]

  [child id=tp-5  n=15.5  title='5. Inside body text'
    [body """A `[?str]` template drops a computed value into text. The rest stays as written."""]
    [example lang=cx
      """[pizza name=Margherita]
         [?let [= $p [$first //pizza]]
           [receipt [?str 'Thanks for ordering {$p@name}!']]]"""]]

  [child id=tp-6  n=15.6  title='6. Inside an attribute value'
    [body """Expressions evaluate in attribute-value position via `[?str …]`. One mechanism, two positions."""]
    [example lang=cx
      """[user id=42 name=Joe]
         [?let [= $u [$first //user]]
           [a href=[?str '/u/{$u@id}/profile'] [?str "View {$u@name}'s profile"]]]"""]]

  [child id=tp-7  n=15.7  title='7. Several holes in one template'
    [body """A template can carry any number of holes."""]
    [example lang=cx
      """[pizza name=Margherita price=12]
         [?let [= $p [$first //pizza]]
           [line [?str '{$p@name} — {$p@price}€']]]"""]]

  [child id=tp-8  n=15.8  title='8. Inside a generated element'
    [body """Per iteration, build a fully-formed `[a href=… …]` element."""]
    [example lang=cx
      """[catalog [c cid=42 name=Joe] [c cid=43 name=Ann]]
         [?for [in $c //c] [yield [a href=[?str "/u/{$c/@cid}"] $c/@name]]]"""]]

  [child id=tp-9  n=15.9  title='9. Child step'
    [body """Child steps separated by `/`. Prints "Margherita"."""]
    [example lang=cx
      """[shop [menu [pizza name=Margherita]]]
         //shop/menu/pizza/@name"""]]

  [child id=tp-10 n=15.10 title='10. Parent axis — parent::*'
    [body """Walks up one element. Prints "New Haven"."""]
    [example lang=cx
      """[shop name='New Haven' [pizza name=Margherita]]
         //pizza/parent::*/@name"""]]

  [child id=tp-11 n=15.11 title='11. Ancestor axis'
    [body """All ancestors of `c`. Prints "mid;top;"."""]
    [example lang=cx
      """[a tag=top [b tag=mid [c found]]]
         [?for [in $x //c/ancestor::*] [yield [?str "{$x/@tag};"]]]"""]]

  [child id=tp-12 n=15.12 title='12. Following-sibling axis'
    [body """Walks siblings to the right of the matched node."""]
    [example lang=cx
      """[row [cell n=1] [cell n=2] [cell n=3]]
         [?for [in $x //cell[= $_@n 1]/following-sibling::*] [yield [?str "{$x/@n};"]]]"""]]

  [child id=tp-13 n=15.13 title='13. Predicate filter — [@attr=value]'
    [body """Brackets inside path expressions are predicates — prefix code over the context node `$_`."""]
    [example lang=cx
      """[menu [pizza name=Margherita] [pizza name=Hawaiian]]
         //pizza[= $_@name 'Hawaiian']/@name"""]]

  [child id=tp-14 n=15.14 title='14. Upper-case'
    [body """Wrap a value in a call form to apply a function."""]
    [example lang=cx
      """[pizza name=margherita]
         [?let [= $p [$first //pizza]] [$upper $p@name]]"""]]

  [child id=tp-15 n=15.15 title='15. Default — fall back when missing'
    [body """`[?else EXPR DEFAULT]` yields EXPR unless it is absent (or an error) — graceful fallback, no exception."""]
    [example lang=cx
      """[pizza name=Mystery]
         [?else //pizza/@price 0]"""]]

  [child id=tp-16 n=15.16 title='16. Composed filters — nested'
    [body """Inside-out: trim, then upper."""]
    [example lang=cx
      """[pizza name='  margherita  ']
         [?lib 'cx-stdlib/strings']
         [?let [= $p [$first //pizza]]
           [$upper [$strings:trim [$string $p@name]]]]"""]]

  [child id=tp-17 n=15.17 title='17. String length'
    [body """Counts characters. Prints 10."""]
    [example lang=cx
      """[pizza name=Margherita]
         [?let [= $p [$first //pizza]] [$string-length $p@name]]"""]]

  [child id=tp-18 n=15.18 title="18. Today's date"
    [body """`[$time:now]` and `[$time:today]` from the `cx-stdlib/time` module (clock capability — grant `--allow-clock`)."""]
    [example lang=cx """[?lib 'cx-stdlib/time']
[$time:today]"""]]

  [child id=tp-19 n=15.19 title='19. Pipeline — left-to-right composition'
    [body """Same result as composed filters, read top-down instead of inside-out."""]
    [example lang=cx
      """[pizza name='  margherita  ']
         [?lib 'cx-stdlib/strings']
         [?let [= $p [$first //pizza]]
           [?pipe [$string $p@name] [$strings:trim] [$upper]]]"""]]

  [child id=tp-20 n=15.20 title='20. Method-call style via pipe'
    [body """Reads as "take name, then lower it". The value threads through each bare stage; `_` is the threaded value."""]
    [example lang=cx
      """[pizza name=MARGHERITA]
         [?let [= $p [$first //pizza]]
           [?pipe $p@name [$lower]]]"""]]

  [child id=tp-21 n=15.21 title='21. String concatenation'
    [body """Join strings with `[$concat …]`."""]
    [example lang=cx
      """[user first=Ada last=Lovelace]
         [?let [= $u [$first //user]]
           [$concat $u@first ' ' $u@last]]"""]]

  [child id=tp-22 n=15.22 title='22. Range — M to N'
    [body """Inclusive range. Prints "1;2;3;4;"."""]
    [example lang=cx """[?for [in $n [$range 1 4]] [yield [?str "{$n};"]]]"""]]

  [child id=tp-23 n=15.23 title='23. If — bracket-clause form'
    [body """Three clauses: condition, [then …], [else …]."""]
    [example lang=cx
      """[pizza stock=0]
         [?let [= $p [$first //pizza]]
           [?if [> $p@stock 0] [then 'in stock'] [else 'out of stock']]]"""]]

  [child id=tp-24 n=15.24 title='24. If — alternate values'
    [body """Same semantics, named clause children read clearly."""]
    [example lang=cx
      """[pizza stock=5]
         [?let [= $p [$first //pizza]]
           [?if [> $p@stock 0] [then 'in stock'] [else 'out of stock']]]"""]]

  [child id=tp-25 n=15.25 title='25. Skip the else branch'
    [body """A false condition yields the empty sequence — `[else …]` is optional."""]
    [example lang=cx
      """[pizza featured=true]
         [?let [= $p [$first //pizza]]
           [?if $p@featured [then '★ featured!']]]"""]]

  [child id=tp-26 n=15.26 title='26. Existence check'
    [body """A node-set is truthy when non-empty."""]
    [example lang=cx
      """[pizza [tags vegan]]
         [?if //tags [then yes] [else no]]"""]]

  [child id=tp-27 n=15.27 title='27. Multi-branch — no else-if ladder'
    [body """Use multi-arm `[?match]` with predicate-only `[when …]` clauses."""]
    [example lang=cx
      """[pizza stock=2]
         [?let [= $p [$first //pizza]]
           [?match
             [when [> $p@stock 100] 'plenty']
             [when [> $p@stock 10]  'some']
             [when [> $p@stock 0]   'last few']
             [else                  'sold out']]]"""]]

  [child id=tp-28 n=15.28 title='28. For — explicit binding'
    [body """The `[in $v SRC]` clause introduces the loop variable and source."""]
    [example lang=cx
      """[pizza [topping cheese] [topping basil] [topping oil]]
         [?for [in $t //topping] [yield [?str '{[$text $t]};']]]"""]]

  [child id=tp-29 n=15.29 title='29. For — anonymous over implicit $_'
    [body """Drop the variable to bind `$_` automatically for each iteration."""]
    [example lang=cx
      """[pizza [topping cheese] [topping basil] [topping oil]]
         [?for [in //topping] [yield [?str '{[$text $_]};']]]"""]]

  [child id=tp-30 n=15.30 title='30. Range loop — generate elements'
    [body """Produces `[slot id=1][slot id=2][slot id=3]`."""]
    [example lang=cx """[?for [in $n [$range 1 3]] [yield [slot id=$n]]]"""]]

  [child id=tp-31 n=15.31 title='31. Nested for'
    [body """Loop over pizzas; inside, loop over each pizza's toppings."""]
    [example lang=cx
      """[shop [pizza name=Margherita [topping cheese] [topping basil]]]
         [?for [in $p //pizza] [yield
           [grp [?str "{$p/@name}: "] [?for [in $t $p/topping] [yield [?str '{[$text $t]},']]]]]]"""]]

  [child id=tp-32 n=15.32 title='32. For — over a single element'
    [body """A single-element source binds once. Prints "Pepe / IT"."""]
    [example lang=cx
      """[shop [meta owner=Pepe region=IT]]
         [?for [in $m //meta] [yield [?str "{$m/@owner} / {$m/@region}"]]]"""]]

  [child id=tp-33 n=15.33 title='33. Let — bind an element, project its attrs'
    [body """`[?let]` binds the `meta` element once, then projects two attributes from it."""]
    [example lang=cx
      """[shop [meta owner=Pepe region=IT]]
         [?let [= $m //meta] [?str "{$m/@owner}/{$m/@region}"]]"""]]

  [child id=tp-34 n=15.34 title='34. Let — bind once, reuse'
    [body """Compute tax once, use it where the binding is in scope."""]
    [example lang=cx
      """[pizza price=12]
         [?let [= $p   [$first //pizza]]
               [= $tax [* $p@price 0.22]]
           [?str "Total: {[+ $p@price $tax]}€"]]"""]]

  [child id=tp-35 n=15.35 title='35. Let — bind a pipeline result'
    [body """Pipelines and let-bindings compose naturally."""]
    [example lang=cx
      """[pizza name='  margherita  ']
         [?lib 'cx-stdlib/strings']
         [?let [= $p [$first //pizza]]
               [= $clean [?pipe [$string $p@name] [$strings:trim] [$upper]]]
           [?str "Welcome, {$clean}!"]]"""]]

  [child id=tp-36 n=15.36 title='36. Define a template fragment'
    [body """`[?def name () BODY]` — zero-arg function definition. Call as `[$slogan]`."""]
    [example lang=cx
      """[?def slogan () [?str 'Hand-tossed since 1987']]
         [$slogan]"""]]

  [child id=tp-37 n=15.37 title='37. With one parameter'
    [body """Parameters go in the `(…)` parameter list. Call with `[$shout arg]`."""]
    [example lang=cx
      """[?def shout ($x) [?str "LOUD: {$x}!"]]
         [$shout 'pizza ready']"""]]

  [child id=tp-38 n=15.38 title='38. Multiple parameters'
    [body """Space-separated params; prints "cheese / basil"."""]
    [example lang=cx
      """[?def pair ($a $b) [?str "{$a} / {$b}"]]
         [$pair 'cheese' 'basil']"""]]

  [child id=tp-39 n=15.39 title='39. Function plus iteration'
    [body """A reusable per-item template, mapped over a node set."""]
    [example lang=cx
      """[?def line ($item) [?str "sku={$item/@sku};"]]
         [order [v sku=A] [v sku=B] [v sku=C]]
         [?for [in $x //v] [yield [$line $x]]]"""]]

  [child id=tp-40 n=15.40 title='40. Higher-order — [?fn] and call'
    [body """`[?fn ($p) BODY]` is an anonymous function literal; pass it as a value."""]
    [example lang=cx
      """[pizza [v n=5]]
         [?let [= $dbl [?fn ($x) [* $x 2]]]
           [?for [in $x //v] [yield [$dbl $x/@n]]]]"""]]

  [child id=tp-41 n=15.41 title='41. HTML-safe output'
    [body """`[?cx output-target=html]` switches the evaluator into context-aware escaping. No XSS from the menu."""]
    [; check=none — [?cx output-target] is approved evaluator-config
       surface; the current binary rejects every [?cx …] directive,
       tracked as engine regression #421. ]
    [example lang=cx check=none
      """[?cx output-target=html]
         [pizza name='<script>alert(1)</script>']
         //pizza/@name"""]]

  [child id=tp-42 n=15.42 title='42. Plain-text output'
    [body """Useful for terminals and files where escaping would be noise."""]
    [; check=none — [?cx output-target] is approved evaluator-config
       surface; rejected by the current binary (#421). ]
    [example lang=cx check=none
      """[?cx output-target=text]
         [pizza name='<b>Margherita</b>']
         //pizza/@name"""]]

  [child id=tp-43 n=15.43 title='43. Load a module'
    [body """`[?lib]` loads a bundled stdlib module; module-qualified calls use `[$prefix:fn args]`."""]
    [example lang=cx
      """[?lib 'cx-stdlib/cx']
         [?lib 'cx-stdlib/format']
         [$format:canonical [$cx:parse '[a   x=1  ]']]"""]]

  [child id=tp-44 n=15.44 title='44. [$cx:parse] — read CX from a string'
    [body """CX reads its own syntax as data. Code is data."""]
    [example lang=cx
      """[?lib 'cx-stdlib/cx']
         [$cx:parse '[pizza name=Margherita]']"""]]

  [child id=tp-45 n=15.45 title='45. [$cx:emit] — emit a value back to text'
    [body """Round-trip: parse then emit. Prints `[a x=1 y=2]`."""]
    [example lang=cx
      """[?lib 'cx-stdlib/cx']
         [$cx:emit [$cx:parse '[a x=1 y=2]']]"""]]

  [child id=tp-46 n=15.46 title='46. [$format:canonical] — normalize'
    [body """Whitespace and attribute order canonicalized; idempotent."""]
    [example lang=cx
      """[?lib 'cx-stdlib/cx']
         [?lib 'cx-stdlib/format']
         [$format:canonical [$cx:parse '[a   x=1   y=2]']]"""]]

  [child id=tp-47 n=15.47 title='47. Content digest — hash the canonical form'
    [body """Stable digest over the canonical bytes. Same input always yields the same hash, in every binding."""]
    [example lang=cx
      """[?lib 'cx-stdlib/cx']
         [?lib 'cx-stdlib/format']
         [?lib 'cx-stdlib/hash']
         [$hash:sha256-hex [$format:canonical [$cx:parse '[pizza name=Margherita]']]]"""]]

  [child id=tp-48 n=15.48 title='48. Override — pure-functional update as merge'
    [body """Two trees combined with `[?modify]`. The coupon's `price=10` overrides the order's; the original order is unchanged."""]
    [example lang=cx
      """[order [pizza name=Margherita price=12]]
         [coupon price=10]
         [?let [= $order [$first //order]]
               [= $coupon [$first //coupon]]
           [?modify $order //pizza/@price [set $coupon@price]]]"""]]

  [child id=tp-49 n=15.49 title='49. Structured logging'
    [body """`[$log:LEVEL msg fields=…]` emits a structured event; `fields=` is a map."""]
    [example lang=cx
      """[?lib 'cx-stdlib/log']
         [$log:info 'sale' fields={pizza: 'Margherita', price: 12}]
         [$log:debug 'suppressed at the default level']"""]]

  [child id=tp-50 n=15.50 title='50. The whole kitchen'
    [body """Module loading, function definition, structured logging, pure-functional override, iteration. A handful of lines; the whole arc."""]
    [example lang=cx
      """[order [pizza name=Margherita price=12]]
         [coupon price=10]
         [?lib 'cx-stdlib/log']
         [?def line ($p) [li [?str "{$p/@name} — {$p/@price}€"]]]
         [?let [= $order [$first //order]]
               [= $coupon [$first //coupon]]
               [= $final [?modify $order //pizza/@price [set $coupon@price]]]
           ([$log:info 'rendering receipt'],
            [ul [?for [in $p $final/pizza] [yield [$line $p]]]])]"""]]

  [note
    """**The arc.** Read a value → put it in context → walk paths
       → filter and combine → branch → loop → factor into
       functions → swap output mode → reflect / hash / merge /
       log. Every step adds exactly one capability; data from §14
       flows through unchanged."""]]
