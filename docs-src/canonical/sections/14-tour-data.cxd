[# Section 14 — appendix: "50 Ways to Love Your CX Data".
   Pizzeria-edition tour of CX data forms, simple to complex,
   in 50 examples. Migrated from docs-src/content/tour/data.cx
   during Phase B docs → guide consolidation (2026-05-24).
   Designer pre-approved as guide appendix.
   File extension .cxd — data-only source. #]

[section id=tour-data group='Ring 0 — Data' n=14 title='50 Ways to Love Your CX Data'

  [intro
    """Fifty examples that walk through CX data — bare attributes
       through anchors and merge, with stops at quoted strings,
       multi-line text, comments, collection literals, typed
       columns, and a final whole-shop document. Each step adds
       one shape; no shape requires anything the earlier ones do
       not already give you. The companion §15 covers
       directives."""]

  [child id=td-1  n=14.1  title='1. The atom'
    [body """Just `name=value`. In CX this is a valid document on its own — logfmt mode, intended for log lines and structured events."""]
    [example lang=cx """size=large"""]]

  [child id=td-2  n=14.2  title='2. Several atoms — a one-line event'
    [body """A whole log line — no brackets, no root, just attributes."""]
    [example lang=cx """time=2026-05-09T12:00:00Z level=INFO svc=oven pizza=Margherita"""]]

  [child id=td-3  n=14.3  title='3. Empty element'
    [body """Brackets give a name. Empty, but a thing."""]
    [example lang=cx """[pizza]"""]]

  [child id=td-4  n=14.4  title='4. Element with one property'
    [body """The atom from example 1, now attached to a pizza."""]
    [example lang=cx """[pizza size=large]"""]]

  [child id=td-5  n=14.5  title='5. Several properties'
    [body """Keep adding. No commas required between attrs."""]
    [example lang=cx """[pizza size=large crust=thin price=12]"""]]

  [child id=td-6  n=14.6  title='6. Bare flag (no equals-value)'
    [body """Presence means yes, absence means no — same idea as `--verbose` or HTML's `required`. Here, this pizza is controversial."""]
    [example lang=cx """[pizza name=Hawaiian controversial]"""]]

  [child id=td-7  n=14.7  title='7. Explicit boolean values'
    [body """When you want both polarities, write the word."""]
    [example lang=cx """[pizza vegan=true gluten-free=false]"""]]

  [child id=td-8  n=14.8  title='8. Booleans are ordinary attributes'
    [body """Booleans are ordinary attributes — `name=true` / `name=false`; the bare tokens auto-type as bool."""]
    [example lang=cx """[pizza vegan=true nuts=false gluten=false]"""]]

  [child id=td-9  n=14.9  title='9. Numbers — int, decimal, negative, hex, underscores'
    [body """All bare, all auto-typed. Underscores in numbers are readability sugar."""]
    [example lang=cx """[pizza price=12.50 discount=-2 ovens=4 mask=0xFF00FF batch=1_000_000]"""]]

  [child id=td-10 n=14.10 title='10. Quoted — single quotes'
    [body """Reads: attribute `name`, value is the string "BBQ Chicken"."""]
    [example lang=cx """[pizza name='BBQ Chicken']"""]]

  [child id=td-11 n=14.11 title='11. Quoted — double quotes'
    [body """Pick the quote that does not appear in the value."""]
    [example lang=cx """[pizza name="Quattro Formaggi"]"""]]

  [child id=td-12 n=14.12 title='12. Mix when the value has an apostrophe'
    [body """Double-quote around an apostrophe; no escaping needed."""]
    [example lang=cx """[pizza name="Tony's Special"]"""]]

  [child id=td-13 n=14.13 title='13. The empty string'
    [body """Distinct from missing: the attribute is there, just empty."""]
    [example lang=cx """[pizza name=Mystery description=""]"""]]

  [child id=td-14 n=14.14 title='14. Escape sequences inside quotes'
    [body """Same family as C and JSON: `\\n`, `\\r`, `\\t`, `\\uXXXX`, `\\"`, `\\\\`."""]
    [example lang=cx """[pizza alert='Hot!\\nHandle with care.\\tCafé']"""]]

  [child id=td-15 n=14.15 title='15. Entity references (XML-style)'
    [body """`&amp;`, `&lt;`, `&gt;` are recognized in **body text** — they round-trip faithfully, and an `--xml` emit renders them as proper XML entities. In attribute values they are **not** decoded: the characters stay literal (and `--xml` escapes the ampersand a second time). For a literal `&` or `<` in an attribute, just write the character inside quotes."""]
    [example lang=cx """[note Cheese &amp; Pepper]"""]]

  [child id=td-16 n=14.16 title='16. Null'
    [body """A real null value, distinct from empty string or the word "null" as a string."""]
    [example lang=cx """[pizza discount=null reviewed=null]"""]]

  [child id=td-17 n=14.17 title='17. Date and datetime literals'
    [body """ISO 8601 shapes are auto-typed as date or datetime."""]
    [example lang=cx """[promo starts=2026-05-01 ends=2026-05-31 cutoff=2026-05-31T23:59:00Z]"""]]

  [child id=td-18 n=14.18 title='18. Plain text body'
    [body """After the name, the rest of the bracket is text."""]
    [example lang=cx """[motto Hand-tossed since 1987]"""]]

  [child id=td-19 n=14.19 title='19. Attributes plus text body'
    [body """Reads: element `pizza`, attribute `name=Margherita`, then text body "Classic since day one."."""]
    [example lang=cx """[pizza name=Margherita Classic since day one.]"""]]

  [child id=td-20 n=14.20 title='20. Multi-line text — preserved as written'
    [body """Whitespace and newlines inside a text body are kept literally."""]
    [example lang=cx
      """[description
           Stone-baked, hand-stretched,
           and ready in 90 seconds.]"""]]

  [child id=td-21 n=14.21 title='21. Triple-quoted string'
    [body """Three quotes open and close. Single and double quotes inside need no escaping. Common leading whitespace is stripped."""]
    [example lang=cx
      """[bio '''
           Born in Naples, 1955.
           Started New Haven in 1987.
           Still on the line every Friday.
         ''']"""]]

  [child id=td-22 n=14.22 title='22. Block content [| … |]'
    [body """Like a text body, but indentation and newlines are kept verbatim; the block closes with `|]`. Unlike triple-quoted, inner elements such as `[em best]` are still real markup."""]
    [example lang=cx
      """[poem [|
           Roses are red,
             violets are blue,
           the [em best] pizza
             is waiting for you.
         |]]"""]]

  [child id=td-23 n=14.23 title='23. Raw text [# … #]'
    [body """The CDATA of CX. Brackets, quotes, `<`, `>` — all literal characters. The terminator is `#]`."""]
    [example lang=cx """[snippet [# if (x < 10) { return "[pizza]"; } #]]"""]]

  [child id=td-24 n=14.24 title='24. Embedded code in another language'
    [body """Raw text is how you embed SQL, JS, or regex without escaping every quote."""]
    [example lang=cx
      """[query language=sql [#
           SELECT name, price FROM pizza
           WHERE price < 15 AND vegan = true;
         #]]"""]]

  [child id=td-25 n=14.25 title='25. Line comment'
    [body """`#` comments out the rest of the line. Lives outside elements, like a script header."""]
    [example lang=cx
      """# weekend special — pulled Monday
         [pizza name=TruffleSpecial price=24]"""]]

  [child id=td-26 n=14.26 title='26. Inline block comment'
    [body """Element-shaped — fits inside brackets where `#` cannot reach."""]
    [example lang=cx """[pizza name=Diavola [; TODO confirm price ] price=14]"""]]

  [child id=td-27 n=14.27 title='27. Multi-line block comment'
    [body """Canonical for multi-line notes."""]
    [example lang=cx
      """[;
           Pricing review:
             - Diavola: bump to 16?
             - Hawaiian: hold at 14
         ]"""]]

  [child id=td-28 n=14.28 title='28. When to use which'
    [body """`#` for line-scoped headers; `[; … ]` when the comment must nest inside an element or span lines. Not HTML's `<!-- … -->` — CX has its own."""]
    [example lang=cx
      """# top-of-file header
         [shop [; inline aside on this branch ] port=8080]"""]]

  [child id=td-29 n=14.29 title='29. Nesting'
    [body """Brackets inside brackets."""]
    [example lang=cx """[pizza name=Margherita [base tomato]]"""]]

  [child id=td-30 n=14.30 title='30. Siblings'
    [body """Same shape, side by side. No separators required."""]
    [example lang=cx """[pizza [topping cheese] [topping basil] [topping oil]]"""]]

  [child id=td-31 n=14.31 title='31. Inline prose with markup'
    [body """Prose and tags interleave freely. The same shapes you would write in HTML."""]
    [example lang=cx """[note Try the [b Margherita] — our [em best seller], hand-tossed [strong daily].]"""]]

  [child id=td-32 n=14.32 title='32. A whole article — prose and data'
    [body """Headings, paragraphs, links, emphasis — CX handles document text as cleanly as XML."""]
    [example lang=cx
      """[article
           [h1 New Haven Story]
           [p Founded in [em 1987]. See the [a href=/menu menu].]
           [p Still [strong hand-tossing] every pie.]]"""]]

  [child id=td-33 n=14.33 title='33. Deeper nesting — children with their own data'
    [body """Each child carries its own attributes."""]
    [example lang=cx
      """[pizza name=Quattro
           [topping cheese price=2]
           [topping ham    price=3]
           [topping olives price=2]]"""]]

  [child id=td-34 n=14.34 title='34. Multiple top-level elements (no required root)'
    [body """A document can be a flat list."""]
    [example lang=cx
      """[pizza name=Margherita]
         [pizza name=Hawaiian]
         [pizza name=Diavola]"""]]

  [child id=td-35 n=14.35 title='35. Multi-document file'
    [body """One file, several independent documents. Same separator as YAML — three dashes on a line by themselves between documents."""]]

  [child id=td-36 n=14.36 title='36. Sequence (a, b, c) — flat list'
    [body """Reads: element `toppings`, body is the sequence of three strings.
       Collections live in a child element's body — attributes hold a single
       scalar, never a collection."""]
    [example lang=cx """[pizza [toppings (cheese, basil, oil)]]"""]]

  [child id=td-37 n=14.37 title='37. Array [a, b, c] — nested list'
    [body """Arrays preserve structure; sequences flatten. Use arrays when nesting matters."""]
    [example lang=cx """[grid [cells [1, 2, 3]]]"""]]

  [child id=td-38 n=14.38 title='38. Nested arrays'
    [body """A matrix is just an array of arrays."""]
    [example lang=cx
      """[board
           [cells [[1, 0, 1],
                   [0, 1, 0],
                   [1, 0, 1]]]]"""]]

  [child id=td-39 n=14.39 title='39. Map {k: v} — named key to value'
    [body """Reads: element `prices`, body is a map with three entries."""]
    [example lang=cx """[pizza [prices {small: 9, medium: 12, large: 15}]]"""]]

  [child id=td-40 n=14.40 title='40. Collections in body position'
    [body """Sequences, arrays, and maps can sit inside an element body too."""]
    [example lang=cx
      """[favorites
           (Margherita, Hawaiian, Diavola)]"""]]

  [child id=td-41 n=14.41 title='41. Mixed-shape composition'
    [body """Map of sequences, multi-line. Compose freely."""]
    [example lang=cx
      """[stats {
           monday: (12, 8, 14),
           tuesday: (10, 9, 11),
           wednesday: (15, 11, 18)
         }]"""]]

  [child id=td-42 n=14.42 title='42. Explicit type annotation'
    [body """A glued `::T` ascription on the name pins the body's type, overriding auto-typing."""]
    [example lang=cx
      """[count::int 42]
         [ratio::decimal 3.14159]"""]]

  [child id=td-43 n=14.43 title='43. Typed array as body'
    [body """`::int[]` for typed; `::[]` for inferred (string array here)."""]
    [example lang=cx
      """[oven-temps::int[] 220 240 260 480]
         [tags::[] cheap fast tasty]"""]]

  [child id=td-44 n=14.44 title='44. Plain table — header plus rows'
    [body """The `[table[…]]` block declares column names once. Each line below is a row."""]
    [example lang=cx
      """[menu [table[name size price]]
           Margherita medium 12
           Hawaiian   large  14
           Diavola    medium 13]"""]]

  [child id=td-45 n=14.45 title='45. Typed columns'
    [body """Each column can carry a colon-type. Cells parse accordingly."""]
    [example lang=cx
      """[orders [table[item::string qty::int paid::bool when::date]]
           Margherita 2 true  2026-05-09
           Hawaiian   1 false 2026-05-09]"""]]

  [child id=td-46 n=14.46 title='46. Quoted cells and nulls'
    [body """Quote cells with spaces. `null` is a real null in the cell."""]
    [example lang=cx
      """[shifts [table[cook hours::int notes]]
           Pepe       8 morning
           Maria      6 'closing crew'
           'Jean-Luc' 4 null]"""]]

  [child id=td-47 n=14.47 title='47. Anchor and alias'
    [body """`&classic` **names** this element; `[*classic]` is an alias node referencing it. Which reading you get depends on the lane. The **lossless lanes** carry the reference as written: canonical CX emit prints `[*classic]` back out, and `--xml` marks it with a `cx:` attribute, so the document round-trips byte-faithfully. The **semantic lanes resolve it**: under `--json`/`--yaml`/`--csv` (any lossy projection) and inside a program's `$doc`, each alias expands to a deep copy of its anchor — the JSON of the example below carries two full Margheritas inside `menu`. `cx lint` (CX-L004) errors on a reference whose anchor does not exist, and a lossy projection of a dangling alias refuses outright."""]
    [example lang=cx
      """[pizza &classic name=Margherita price=12 [base tomato]]
         [menu [*classic] [*classic]]"""]]

  [child id=td-48 n=14.48 title='48. Merge declaration'
    [body """`*classic` **declares** a merge from the anchor, with the element's own attrs as overrides. The same lane split as the alias: the lossless lanes keep the declaration as written — canonical emit prints `[pizza *classic …]`, `--xml` emits a `cx:merge="classic"` attribute — while the semantic lanes **apply** it: under a lossy projection or `$doc`, the second pizza inherits `name=Margherita price=12 [base tomato]` and its own attrs win on collision, so it comes out `name=ClassicXL size=large price=16` with the tomato base. CX-L004 checks the target anchor exists."""]
    [example lang=cx
      """[pizza &classic name=Margherita price=12 [base tomato]]
         [pizza *classic name=ClassicXL size=large price=16]"""]]

  [child id=td-49 n=14.49 title='49. A recipe — prose, data, table, all together'
    [body """Tabular ingredients, prose steps with inline markup, multi-line notes — all in one document, one syntax."""]
    [example lang=cx
      """[recipe name=Margherita serves=2
           [ingredients [table[item amount::string]]
             flour      300g
             water      200ml
             yeast      2g
             'San Marzano tomato' 150g
             mozzarella 120g
             basil      'a handful']
           [steps
             [step Mix the dough and rest [em 24 hours] cold.]
             [step Stretch by hand — no rolling pin.]
             [step Bake at [strong 480 degrees] for 90 seconds.]]
           [notes '''
             A wetter dough gives a softer cornicione.
             Do not skip the cold rest.
           ''']]"""]]

  [child id=td-50 n=14.50 title='50. The whole shop'
    [body """XML decl, anchor, block comments, typed table, a merge declaration (carried on the lossless lanes, applied on the semantic ones — see 48), map and sequence children, triple-quoted text. One syntax, everywhere."""]
    [example lang=cx
      """[?xml version=1.0 encoding=UTF-8]
         [shop &flagship name='New Haven' port=8080 open=true
           [; opening hours ]
           [hours mon-fri=11-22 sat=12-23 sun=closed]
           [; menu reviewed 2026-05-01 ]
           [menu [table[name::string size price::decimal vegan::bool]]
             Margherita medium 12.00 true
             Hawaiian   large  14.00 false
             Diavola    medium 13.00 false]
           [staff [cook &lead name=Pepe shift=morning founder=true]
                  [cook *lead name=Maria shift=closing founder=false]]
           [contact address='123 Forno Lane'
             [coords {lat: 40.8518, lon: 14.2681}]
             [phones ('+39 555 0101', '+39 555 0102')]]
           [tagline '''
             Hand-tossed since 1987.
             Still tossing.
           ''']]"""]]

  [note
    """**The arc.** Bare attribute → element → strings → text
       bodies → comments → structure → collections → typed arrays
       → tables → anchors → the whole shop. Every step adds one
       shape; no shape requires anything the earlier ones do not
       already give you."""]]
