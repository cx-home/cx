[- Reference: CXL language. -]
[page id='cxl'
  [meta
    title='CXL Language Reference'
    layout='reference'
    nav-order='400'
    audience='lookup'
    summary='Every CXL directive and its slot shape.'
  ]

  [section id='what' title='What CXL Is'
    [prose CXL is CX that does things. A CXL program is a CX document with directives — square-bracketed forms whose name starts with a question mark — that evaluate against an input tree and produce output. The same syntax is data, the same parser parses both.]
    [code lang='cx' src='[h1 [?= //page/@title]]']
    [code lang='shell' src='cx eval template.cxl --data=page.cx']
  ]

  [section id='substitution' title='Substitution and Interpolation'
    [code lang='cx' src='''[?= EXPR]                          # substitute value at this position
[?str-template 'Hi [?=name]!']     # text template with embedded substitution
[?cx output-target=html]           # configure the evaluator''']
  ]

  [section id='control-flow' title='Control Flow'
    [code lang='cx' src='''[?if   [cond, then, else]]
[?if   [[c1, v1], [c2, v2], [*, default]]]    # multi-branch
[?for  x :in PATH :return BODY]
[?for  x :in PATH :where COND :return BODY]
[?let  x :be EXPR :return BODY]
[?match [VALUE, p1, body1, p2, body2, [*, default]]]
[?try  [BODY, CATCH]]''']
  ]

  [section id='filters' title='Filter Directives'
    [code lang='cx' src='''[?upper [STR]]   [?lower [STR]]   [?trim [STR]]
[?length [SEQ]]  [?count [SEQ]]   [?sum [SEQ]]
[?concat [A, B, …]]
[?for-each [SEQ, fn]]  [?filter [SEQ, pred]]
[?fold-left [SEQ, init, fn]]  [?fold-right [SEQ, init, fn]]''']
  ]

  [section id='templates' title='Named Templates'
    [code lang='cx' src='''[?def name :params [a, b] :body [tag [?= a] [?= b]]]
[?name 'one' 'two']
[?use name]              # zero-parameter call sugar''']
  ]

  [section id='functions' title='Function Values'
    [code lang='cx' src='''[?fn (x) { [?= x * 2] }]
-> (x) { [?= x * 2] }
[?partial [name, _, 2]]
[?focus [?= _ + 1]]''']
  ]

  [section id='includes' title='Includes'
    [code lang='cx' src='''[?cx include=partial.cx]     # parse-time include directive
[?include 'partial.cxl']     # eval-time include directive''']
  ]

  [section id='related' title='Related'
    [list
      [item path='concepts/evaluation' label='How CXL sees the data — context, bindings, scoping']
      [item path='reference/includes'  label='Includes — both forms']
    ]
  ]

  [preserve id='author-notes'
    [- Hand-written notes survive regeneration. Empty by default. -]
  ]
]
