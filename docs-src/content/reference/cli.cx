[- Reference: CLI. -]
[page id='cli'
  [meta
    title='CLI Reference'
    layout='reference'
    nav-order='410'
    audience='lookup'
    summary='Every subcommand and flag the cx binary accepts.'
  ]

  [section id='format' title='Format Conversion'
    [prose Input from a file or stdin; output to stdout.]
    [code lang='shell' src='''cx --cx pizza.cx                 # canonical CX form
cx --xml pizza.cx                # XML
cx --json pizza.cx               # semantic JSON
cx --ast pizza.cx                # AST as JSON
cx --yaml pizza.cx | cx --toml   # chain conversions''']
  ]

  [section id='from-to' title='From-To Flags'
    [code lang='shell' src='''cx --from=yaml --to=json < config.yaml
cx convert config.yaml --to=json
cx convert order.json --from=json --to=cx --compact''']
  ]

  [section id='subcommands' title='Subcommands'
    [code lang='shell' src='''cx fmt FILE              # lossless canonical formatter
cx canonical FILE        # strict canonical text
cx hash FILE             # SHA-256 over canonical bytes
cx eq A.cx B.cx          # exit 0 if data-equivalent
cx diff A.cx B.cx        # semantic diff
cx lint FILE             # style + correctness
cx validate FILE --schema=S.cxs
cx eval TEMPLATE.cxl --data=CTX.cx
cx select EXPR --data=CTX.cx
cx table info FILE
cx scaffold KIND         # drop a skeleton on stdout''']
  ]

  [section id='include-root' title='Include Resolution'
    [code lang='shell' src='''cx --xml --include-root=./conf main.cx       # resolve [?cx include=…]
cx eval template.cxl --include-root=./tpl    # also activates [?include]''']
  ]

  [section id='exit-codes' title='Exit Codes'
    [list
      [item path='reference/cli' label='0 — success (no diagnostics at or above the configured fail-on threshold)']
      [item path='reference/cli' label='1 — diagnostics found (lint or validate) or comparison returned not-equal']
      [item path='reference/cli' label='2 — I/O failure, schema load failure, or unrecoverable parse error']
    ]
  ]

  [section id='related' title='Related'
    [list
      [item path='reference/cxl'      label='CXL language reference']
      [item path='bindings/index' label='Language bindings']
    ]
  ]

  [preserve id='author-notes'
    [- Hand-written notes survive regeneration. Empty by default. -]
  ]
]
