[- Cookbook: task-shaped recipes. -]
[page id='cookbook'
  [meta
    title='Cookbook'
    layout='reference'
    nav-order='170'
    audience='user'
    summary='Task-shaped recipes. I want to X — here is the X.'
  ]

  [section id='intro' title='Read This First'
    [prose Each recipe is a concrete task with the smallest CX or CXL that solves it. Browse the headings, find the one that sounds like what you are trying to do, copy-paste, and adapt. Each recipe links to the deeper reference where the underlying mechanism is documented.]
  ]

  [section id='convert-yaml' title='Convert YAML to JSON'
    [code lang='shell' src='cx convert config.yaml --to=json > config.json']
    [prose Auto-detected by extension. Override with --from when the extension lies.]
  ]

  [section id='convert-toml' title='Convert TOML to YAML'
    [code lang='shell' src='cx convert config.toml --to=yaml > config.yaml']
  ]

  [section id='extract' title='Extract a Single Value'
    [code lang='shell' src="cx eval -e '[?= //server/@host]' --data=config.cx"]
    [prose The -e flag takes the template inline; --data is the input file. The CXPath finds the host attribute of any server element at any depth.]
  ]

  [section id='filter-attr' title='Filter Records by Attribute'
    [prose Run cx eval -e with a CXL inline that filters by predicate. The CXPath predicate //user[@role='admin'] selects only admins.]
    [code lang='shell' src='cx eval template.cxl --data=users.cx']
  ]

  [section id='count' title='Count Records'
    [code lang='shell' src="cx eval -e '[?= count(//order)]' --data=orders.cx"]
  ]

  [section id='validate' title='Validate Against a Schema'
    [code lang='shell' src='''cx validate order.cx --schema=order.cxs
cx validate order.cx --schema=order.cxs --mode=strict
cx validate order.cx --schema=order.cxs --fail-on=warn''']
    [prose Exit 0 if no diagnostics at or above fail-on, 1 if any, 2 on I/O or schema-load failure.]
  ]

  [section id='canonicalize' title='Compute the Canonical Hash'
    [code lang='shell' src='''cx canonical menu.cx
cx hash menu.cx
cx eq a.cx b.cx''']
    [prose Use the hash for content-addressing, cache keys, or signing. cx eq returns exit 0 iff canonical(a) equals canonical(b).]
  ]

  [section id='diff' title='Semantic Diff Between Two Documents'
    [code lang='shell' src='''cx diff old.cx new.cx                          # unified
cx diff --format=json   old.cx new.cx
cx diff --format=summary old.cx new.cx''']
    [prose The diff walks the canonical form so comment and whitespace changes do not show up.]
  ]

  [section id='lint' title='Lint a File'
    [code lang='shell' src='''cx lint config.cx
cx lint config.cx --only=CX-L005
cx lint config.cx --disable=CX-L001,CX-L007''']
  ]

  [section id='fmt' title='Format / Re-Indent'
    [code lang='shell' src='''cx fmt config.cx                # in-place if you redirect
cx fmt --check config.cx        # exit non-zero if not canonical
cx fmt < input.cx > output.cx''']
  ]

  [section id='generate-config' title='Generate a Config From a Template'
    [code lang='cx' src='''[server
  host=[?= //env/@host]
  port=[?= //env/@port]
  workers=[?if [//env/@env = "prod", 32, 4]]
  cache=[?if [//env/@env = "prod", /var/cache/app, /tmp/cache]]]''']
    [code lang='shell' src='cx eval server.cxl --data=env.prod.cx --to=toml > server.toml']
  ]

  [section id='stream-large' title='Stream a Large File'
    [code lang='python' src='''import cx
with open("events.cx", "rb") as f:
    for event in cx.stream(f):
        if event.kind == "element_start" and event.name == "error":
            print(event.attrs)''']
    [prose RSS stays bounded regardless of input size. Tier-1 bindings (V, Python, Go) ship the streaming reader and writer; Tier-2/3 follow in v0.7.x.]
  ]

  [section id='write-stream' title='Write a Stream'
    [code lang='python' src='''with cx.stream_writer(open("out.cx", "wb")) as w:
    for record in fetch_records():
        w.write(record)''']
  ]

  [section id='compose-include' title='Compose a Document From Files'
    [code lang='cx' src='''[server
  [?cx include=lib/defaults.cx]
  port=8080
  log-level=info]''']
    [code lang='shell' src='cx --cx --include-root=./conf server.cx > resolved.cx']
    [prose The parse-time include splices the contents of lib/defaults.cx in place. The eval-time variant is [?include path] for dynamic includes inside CXL templates.]
  ]

  [section id='render-template' title='Render a Template With Includes'
    [code lang='cx' src="[?include 'partials/header.cxl']
[?for item :in //order/line :return [?include 'partials/line.cxl']]
[?include 'partials/footer.cxl']"]
    [code lang='shell' src='cx eval order.cxl --data=order.cx --include-root=./templates']
  ]

  [section id='emit-csv' title='Emit a Table as CSV'
    [code lang='shell' src='''cx table dump orders.cx --to=csv > orders.csv
cx table dump orders.cx --to=tsv > orders.tsv
cx table dump orders.cx --to=psv > orders.psv''']
    [prose The CSV header carries the column types so the reverse direction (cx table load) reconstructs them.]
  ]

  [section id='read-parquet' title='Read a Parquet File Into CX'
    [code lang='shell' src='cx table load orders.parquet --to=cx > orders.cx']
    [prose Phase A (Arrow round-trip) ships at v0.7.0; Phase B (Parquet writer) and Phase C (read-side schema inference) follow in v0.7.x.]
  ]

  [section id='hash-id' title='Use an ID-Based Reference'
    [code lang='cx' src='''[order #o1234 customer=alice
  [line item=@margherita count=2]
  [line item=@salad count=1]]
[receipt order=@o1234]''']
    [prose Hash declares an id; at-sigil references it. Identifiers are unique within the documents scope.]
  ]

  [section id='anchor-merge' title='Share Defaults Across Records'
    [code lang='cx' src='''[defaults &shared timeout=30 retries=3]
[server *shared name=api]
[server *shared name=worker retries=5]''']
    [prose Ampersand declares an anchor; asterisk merges from it. Local fields override; missing ones inherit.]
  ]

  [section id='multi-doc' title='Iterate Multiple Documents in One File'
    [code lang='shell' src='cx parse multi.cx --to=json     # writes a JSON array']
    [prose Top-level three-dashes on a line by themselves separate independent documents. cx parse walks each in order; cx --json emits an array.]
  ]

  [section id='html-safe' title='HTML-Safe Templating'
    [code lang='cx' src="[?cx output-target=html]
[h1 [?= //page/@title]]
[?for u :in //user :return [li [?= u/@name]]]"]
    [prose [?cx output-target=html] switches the evaluator into context-aware escaping. Substituted values that contain less-than / greater-than / ampersand / quotes escape correctly with no manual sprintf.]
  ]

  [section id='log-structured' title='Emit Structured Log Records'
    [code lang='cx' src="[?cx use-module=log log-level=info]
[?log:info ['sale', {pizza: 'Margherita', price: 12}]]
[?log:warn ['low-stock', {pizza: 'Diavola', stock: 2}]]"]
    [prose The log module emits structured records to stderr (default) or a configured sink. Fields are a map; level is one of trace / debug / info / warn / error.]
  ]

  [section id='related' title='Where to Next'
    [list
      [item path='tour/data'      label='50 Ways to Love Your CX Data — example shapes']
      [item path='tour/programs'  label='50 Ways to Love Your CXL Code — CXL snippets']
      [item path='reference/cli'  label='Full CLI reference']
      [item path='reference/cxl'  label='Full CXL reference']
    ]
  ]

  [preserve id='author-notes'
    [- Hand-written notes survive regeneration. Empty by default. -]
  ]
]
