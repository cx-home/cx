[- Binding: Java. -]
[page id='binding-java'
  [meta
    title='Java Binding'
    layout='reference'
    nav-order='660'
    audience='lookup'
    summary='Maven Central: io.cx-lang:cx. JNA wrapper, Java 17+.'
  ]

  [section id='install' title='Install (Maven)'
    [code lang='xml' src='''<dependency>
  <groupId>io.cx-lang</groupId>
  <artifactId>cx</artifactId>
  <version>0.7.0</version>
</dependency>''']
  ]

  [section id='install-gradle' title='Install (Gradle)'
    [code lang='kotlin' src="implementation('io.cx-lang:cx:0.7.0')"]
  ]

  [section id='parse-emit' title='Parse and Emit'
    [code lang='java' src='''import io.cxlang.Cx;
import io.cxlang.Format;

String input = Files.readString(Path.of("pizza.cx"));
String json  = Cx.emit(input, Format.JSON);
String xml   = Cx.emit(input, Format.XML);

var tree = Cx.parse(input);
for (var pizza : tree.findAll("pizza")) {
    System.out.println(pizza.attr("name") + " @ " + pizza.attr("price"));
}''']
  ]

  [section id='eval' title='Run a CXL Template'
    [code lang='java' src='''import io.cxlang.Eval;

String out = Eval.run(programText)
    .withData(dataText)
    .withIncludeRoot("/proj")
    .execute();''']
  ]

  [section id='validate' title='Schema Validation'
    [code lang='java' src='''import io.cxlang.Validate;

var diagnostics = Validate.run(doc, schema)
    .withMode(Validate.Mode.STRICT)
    .execute();''']
  ]

  [section id='types' title='Type Mapping'
    [prose CX type to Java type: int sized variants to byte / short / int / long (signed) or int / long / BigInteger (unsigned wider widths); bigint to BigInteger; decimal to BigDecimal; float / f64 / f32 to double / float; bool to boolean; string to String; date to LocalDate; datetime to OffsetDateTime; bytes to byte[].]
  ]

  [section id='related' title='Related'
    [list
      [item path='bindings/c-abi' label='C ABI']
      [item path='bindings/index' label='Binding catalog']
    ]
  ]

  [preserve id='author-notes'
    [- Empty by default. -]
  ]
]
