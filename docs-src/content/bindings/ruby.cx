[- Binding: Ruby. -]
[page id='binding-ruby'
  [meta
    title='Ruby Binding'
    layout='reference'
    nav-order='680'
    audience='lookup'
    summary='gem install cx-lang. FFI wrapper around libcx.'
  ]

  [section id='install' title='Install'
    [code lang='shell' src='gem install cx-lang']
  ]

  [section id='parse-emit' title='Parse and Emit'
    [code lang='ruby' src='''require "cx"

input = File.read("pizza.cx")
json  = Cx.emit(input, to: :json)
xml   = Cx.emit(input, to: :xml)

tree = Cx.parse(input)
tree.find_all("pizza").each do |pizza|
  puts "#{pizza['name']} @ #{pizza['price']}"
end''']
  ]

  [section id='eval' title='Run a CXL Template'
    [code lang='ruby' src='''out = Cx.eval(program_text,
              data: data_text,
              include_root: "/proj")''']
  ]

  [section id='types' title='Type Mapping'
    [prose CX type to Ruby type: int / sized integers to Integer; bigint to Integer; decimal to BigDecimal; float to Float; bool to true and false; string to String; date to Date; datetime to DateTime; bytes to String with Encoding::ASCII_8BIT.]
  ]

  [section id='related' title='Related'
    [list
      [item path='bindings/c-abi' label='C ABI']
      [item path='bindings/index' label='Binding catalog']
    ]
  ]

  [preserve id='author-notes'
    [- Empty by default. -]
  ]
]
