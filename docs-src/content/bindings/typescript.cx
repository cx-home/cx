[- Binding: TypeScript. -]
[page id='binding-typescript'
  [meta
    title='TypeScript Binding'
    layout='reference'
    nav-order='650'
    audience='lookup'
    summary='npm install @cx-lang/cxlib. koffi wrapper around libcx for Node and Bun.'
  ]

  [section id='install' title='Install'
    [code lang='shell' src='npm install @cx-lang/cxlib']
  ]

  [section id='parse-emit' title='Parse and Emit'
    [code lang='ts' src='''import { parse, emit, canonical } from "@cx-lang/cxlib"

const tree = parse(await Bun.file("pizza.cx").text())
const json = emit(tree, { to: "json" })
const xml  = emit(tree, { to: "xml" })
const c    = canonical(await Bun.file("pizza.cx").text())''']
  ]

  [section id='eval' title='Run a CXL Template'
    [code lang='ts' src='''import { evalCxl } from "@cx-lang/cxlib"

const out = evalCxl(programText, {
  data: dataText,
  includeRoot: "/proj",
  target: "html",
})''']
  ]

  [section id='runtime' title='Runtime Notes'
    [prose The TS binding works under Node.js (18+) and Bun. Both use koffi for the C ABI handshake. The libcx Boehm GC settings (GC_DONT_GC, GC_INITIAL_HEAP_SIZE=32MB) are applied before koffi.load so the mark phase under Node and Bun is bounded. For long-running processes a worker-recycle policy is recommended; the trade-off is documented in the binding README.]
  ]

  [section id='related' title='Related'
    [list
      [item path='bindings/c-abi' label='C ABI']
      [item path='bindings/index' label='Binding catalog']
    ]
  ]

  [preserve id='author-notes'
    [- Empty by default. -]
  ]
]
