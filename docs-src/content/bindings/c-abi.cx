[- Binding: C ABI. -]
[page id='c-abi'
  [meta
    title='C ABI'
    layout='reference'
    nav-order='601'
    audience='lookup'
    summary='Every libcx symbol that bindings link against. UTF-8 in, UTF-8 out, capability bits gate features.'
  ]

  [section id='format' title='Format Conversion'
    [code lang='c' src='''char *cx_to_cx        (const char *in, char **err);
char *cx_to_xml       (const char *in, char **err);
char *cx_to_json      (const char *in, char **err);
char *cx_to_yaml      (const char *in, char **err);
char *cx_to_toml      (const char *in, char **err);
char *cx_to_md        (const char *in, char **err);
char *cx_to_csv       (const char *in, char **err);
char *cx_to_ast       (const char *in, char **err);    // JSON AST
char *cx_from_xml     (const char *in, char **err);    // reverse
char *cx_from_json    (const char *in, char **err);
/* …yaml / toml / md / csv variants… */''']
  ]

  [section id='canonical' title='Canonical and Identity'
    [code lang='c' src='''char *cx_canonical(const char *in, char **err);  // strict canonical text
char *cx_hash     (const char *in, char **err);  // SHA-256 hex
int   cx_eq       (const char *a, const char *b, char **err);
char *cx_diff     (const char *a, const char *b, const char *fmt, char **err);''']
  ]

  [section id='binary' title='Binary Forms'
    [code lang='c' src='''/* ast-bin — versioned binary AST */
char *cx_to_ast_bin   (const char *in, size_t *out_len, char **err);
char *cx_from_ast_bin (const char *buf, size_t buf_len, char **err);

/* data-bin — Arrow / Parquet bridge (via libcx_arrow) */
char *cx_to_data_bin  (const char *in, size_t *out_len, char **err);''']
  ]

  [section id='include' title='Include Resolution'
    [code lang='c' src='''char *cx_to_cx_with_include_root      (const char *in, const char *root, char **err);
char *cx_to_ast_bin_with_include_root (const char *in, const char *root,
                                       size_t *out_len, char **err);''']
  ]

  [section id='eval' title='CXL Evaluator'
    [code lang='c' src='''char *cx_eval                    (const char *input, const char *program,
                                  const char *target, char **err);
char *cx_eval_with_include_root  (const char *input, const char *program,
                                  const char *target, const char *root, char **err);''']
  ]

  [section id='schema' title='Schema Validation'
    [code lang='c' src='''char *cx_validate (const char *doc, const char *schema,
                   const char *mode, const char *fail_on, char **err);''']
  ]

  [section id='caps' title='Capability Bits'
    [prose cx_features returns a 32-bit bitfield naming the capabilities the linked libcx supports. Each capability has a stable bit; bindings query before calling new symbols.]
    [code lang='c' src='unsigned int cx_features(void);']
  ]

  [section id='threading' title='Threading and GC'
    [prose libcx uses Boehm GC under the hood. Each calling thread must register before its first call and unregister at exit. Tier-1 bindings handle this automatically; embedders calling the C ABI directly should pair every thread setup with a tear-down.]
    [code lang='c' src='''void cx_init(void);              // process-once initialization
void cx_thread_register(void);   // per-thread entry
void cx_thread_unregister(void); // per-thread exit''']
  ]

  [section id='memory' title='Memory'
    [prose Every char-pointer returned by libcx is heap-allocated. Call cx_free to release it.]
    [code lang='c' src='void cx_free(void *p);']
  ]

  [section id='header' title='Header File'
    [prose The dist/include/cx.h header is generated alongside the libcx build and ships with the release tarball. The header is the normative source of truth for the surface; this page tracks the same set in prose.]
  ]

  [section id='related' title='Related'
    [list
      [item path='bindings/index'             label='All bindings']
      [item path='reference/cli'              label='CLI — the command-line equivalent of every C-ABI call']
    ]
  ]

  [preserve id='author-notes'
    [- Hand-written notes survive regeneration. Empty by default. -]
  ]
]
