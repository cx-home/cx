[- Binding: Rust. -]
[page id='binding-rust'
  [meta
    title='Rust Binding'
    layout='reference'
    nav-order='640'
    audience='lookup'
    summary='cargo add cx-lang. extern C wrapper, typed AST nodes.'
  ]

  [section id='install' title='Install'
    [code lang='shell' src='cargo add cx-lang']
  ]

  [section id='parse-emit' title='Parse and Emit'
    [code lang='rust' src='''use cx_lang::{parse, emit, canonical, Format};

let tree = parse(&input)?;
let json = emit(&tree, Format::Json)?;
let xml  = emit(&tree, Format::Xml)?;
let canon = canonical(&input)?;''']
  ]

  [section id='access' title='Typed AST Access'
    [code lang='rust' src='''let tree = parse("[shop [pizza name=Margherita price=12]]")?;

for pizza in tree.find_all("pizza") {
    let name: &str = pizza.attr("name")?.as_str()?;
    let price: f64 = pizza.attr("price")?.as_f64()?;
    println!("{} @ {}", name, price);
}''']
  ]

  [section id='eval' title='Run a CXL Template'
    [code lang='rust' src='''use cx_lang::eval;

let out = eval(program_text)
    .with_data(data_text)
    .with_include_root("/proj")
    .with_target(Target::Html)
    .run()?;''']
  ]

  [section id='validate' title='Schema Validation'
    [code lang='rust' src='''use cx_lang::{validate, Mode, Severity};

let diags = validate(doc, schema)
    .mode(Mode::Strict)
    .fail_on(Severity::Warn)
    .run()?;
for d in diags {
    eprintln!("{:?} {} at {}", d.severity, d.message, d.path);
}''']
  ]

  [section id='threading' title='Threading'
    [prose The Rust binding registers each calling thread with libcx via ensure_thread at every FFI chokepoint. cx_thread_register and cx_thread_unregister fire automatically; manual setup is unnecessary. Stateless conversions can be called from any thread without coordination.]
  ]

  [section id='types' title='Type Mapping'
    [prose CX type to Rust type: int to i64 (or i8 / i16 / i32 / u8 / u16 / u32 / u64 if sized), bigint to num_bigint::BigInt, decimal to rust_decimal::Decimal, float to f64 (or f32 if sized), bool to bool, string to String, date to chrono::NaiveDate, datetime to chrono::DateTime, bytes to Vec u8.]
  ]

  [section id='related' title='Related'
    [list
      [item path='bindings/c-abi' label='C ABI — the layer this binding wraps']
      [item path='bindings/index' label='Binding catalog']
    ]
  ]

  [preserve id='author-notes'
    [- Empty by default. -]
  ]
]
