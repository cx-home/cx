[- Binding: Kotlin. -]
[page id='binding-kotlin'
  [meta
    title='Kotlin Binding'
    layout='reference'
    nav-order='690'
    audience='lookup'
    summary='JNA wrapper. Idiomatic Kotlin DSL on top of the Java surface.'
  ]

  [section id='install' title='Install'
    [code lang='kotlin' src="implementation('io.cx-lang:cx-kotlin:0.7.0')"]
  ]

  [section id='parse-emit' title='Parse and Emit'
    [code lang='kotlin' src='''import io.cxlang.kotlin.Cx
import io.cxlang.kotlin.Format

val input = java.io.File("pizza.cx").readText()
val json  = Cx.emit(input, Format.JSON)
val xml   = Cx.emit(input, Format.XML)

val tree = Cx.parse(input)
tree.findAll("pizza").forEach { pizza ->
    val name = pizza.attr<String>("name")
    val price = pizza.attr<Double>("price")
    println("$name @ $price")
}''']
  ]

  [section id='eval' title='Run a CXL Template'
    [code lang='kotlin' src='''val out = Cx.eval(program) {
    data = dataText
    includeRoot = "/proj"
}''']
  ]

