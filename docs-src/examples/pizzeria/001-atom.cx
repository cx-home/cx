[; Teaching fixture: the smallest interesting CX example.
   Referenced by content/surfaces/parse.cx and any other page that
   wants to show "an element with one attribute".

   The 'src' attribute holds the verbatim source — keeps the value
   parseable as a string regardless of bracket content. ]
[example id='atom-element'
  [meta
    title='An atom inside an element'
    tags='parse basics'
  ]
  [in-cx    src='[pizza size=large]']
  [out-xml  src='<pizza size="large"/>']
  [out-json src='{"pizza":{"@size":"large"}}']
]
