    [page path="docs-src/llm/primer-platform.chapter.md" word=landed allow=1 why="regenerated from spec/03-approved/platform/composition.md — the sentence is the spec's"]
        [page path="docs-src/repos/cx-platform-agent.cxd" word=task allow=2 why="the A2A protocol's own Task object, which the agent module's client shapes"]
    [page path="docs-src/repos/cx-registry.cxd" word=stage allow=2 why="the registry's growth stages (stage 1 a git registry, stage 2 served) — xap_dist.md's own term, not a pipeline unit"]
