    [page path="docs-src/llm/reference-code-language.md.tmpl" word=stage allow=1 why="the `[?pipe]` stage — the code language's own word for one transform of a pipe (code.md §6.4, §8.9), not a pipeline unit"]
    [page path="docs-src/llm/primer-platform.chapter.md" word=job allow=2 why="regenerated from composition.md — an outside system's export job, the bulk-export pattern's own domain word"]
    [page path="scripts/gen_guide/guide_build.cx" word=ruling allow=4 why="file comments citing #826's numbered rulings by their historical name"]
    [; the tree's own prose (RULED: WORDS-1): a sentence that NAMES the refused word, or quotes it as history, and nothing else ]
    [page path="Makefile" word=lane allow=1 why="docs-vocabulary-check's own comment names the words the step counts"]
    [page path="scripts/gen_site/docs_vocabulary_check.cx" word=lane allow=2 why="the program's header names the words it counts and the one the [tree] rows hold"]
    [page path="AGENTS.md" word=lane allow=1 why="the Words rule names the refused word: not ruling, not campaign, not lane, not gate run"]
    [page path="AGENT-STANDING-RULES.md" word=lane allow=3 why="the vocabulary line names the refused word; two handoff rules of 2026-09-26 and 09-27 quoted verbatim as history"]
    [page path="scripts/spec_freeze_gate.sh" word=lane allow=1 why="an exemption row quoting commit efd780b17's recorded note, history"]]
