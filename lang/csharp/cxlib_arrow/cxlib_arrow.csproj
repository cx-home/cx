<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Ardec.CXLib.Arrow</PackageId>
    <Version>0.6.0</Version>
    <Description>Apache Arrow C-Data interop for CXLib — bridges CXDB chunked-tables ↔ Arrow ArrowArrayStream via libcx_arrow (capability bit 0x800000).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>cx;arrow;parquet;analytics;c-data</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>CX.Arrow</RootNamespace>
    <AssemblyName>CXLib.Arrow</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../cxlib/cxlib.csproj" />
    <PackageReference Include="Apache.Arrow" Version="18.1.0" />
  </ItemGroup>
</Project>
