# flows/release.env.cx — the ENV program of the release document (RULED:
# RFLOW-1 L96, L103, PRIVMK-1; flow.md §4.1, §4.15): the module its acts
# resolve through.
#
#   cx flow validate flows/release.flow.cx --env flows/release.env.cx --allow-read=.
#
# PUBLIC, like the document. The path allocation gives the release document,
# this env, flows/ci-acts.cx and flows/sim/release/ to the front door, so the
# public cx cuts its own releases with them. The integrator protocol's
# documents resolve through flows/ci.env.cx instead, which stays private.
#
# An ORDINARY CX program: `cx --allow-read flows/release.env.cx` prints the
# inventory below. The [?lib … :as ci] import is what names the acts
# `ci/<def>`. A relative [?lib] path resolves against the WORKING DIRECTORY,
# so every caller runs from the repository root.
[?lib './flows/ci-acts.cx' :as ci]

[acts of='flows/release.flow.cx'
  [act name='ci/release-preflight' compensates='ci/nothing-to-undo'
       does='phase 0, real in both modes: the tag, the line or the bumped commit, a clean tree, the notes, gh, devbox, the pins']
  [act name='ci/release-tag' compensates='ci/release-untag'
       does='phase 1: scripts/tag_release.sh (gate, bump, tag, build at the tag), or the tag alone under --from-bump']
  [act name='ci/release-package' compensates='ci/release-unpackage'
       does="phases 2 and 2b: the platform and profile tarballs, the asset-links and R2.2 gates, the linux lane"]
  [act name='ci/release-merge-main' compensates='ci/release-unmerge'
       does='phase 2c: the release line merged into main, locally (skipped under --from-bump)']
  [act name='ci/release-push' pivot=true
       does='phase 3: the branch(es) and the tag to origin — the irreversible point']
  [act name='ci/release-gh'
       does='phase 4: the one GitHub release, notes and every asset']
  [act name='ci/release-org-page'
       does='phase 5: make release-all (the org profile README)']
  [act name='ci/release-vscode'
       does='phase 7: the editor extension packaged from the pinned cx-tooling and attached (CO-20)']]
