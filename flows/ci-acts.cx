# flows/ci-acts.cx — the ONE module of the CI/CD flows' shared idioms (RULED:
# RFLOW-1 L97, PRIVMK-1, CICD-1, CXF-1).
#
# L97 puts the flows' idioms in ONE place: make-one, tail-of, git, log-line,
# the gap wait, and the runner paths. Each idiom lives here and nowhere else,
# so a grant changes in one place and no copy can drift. Every flow's acts
# reach them through a [?lib] of this file:
#   - flows/private-acts.cx, the acts of the integrator protocol's documents
#     (merge, premerge, postmerge, refresh). Those stay private (L96).
#   - the release document's acts, below. They are public, like the document.
#   - docs-src/flow/docs-acts.cx, the documentation flow's acts (L97's tail).
#
# THIS FILE IS PUBLIC. The path allocation (registry/repos.cxd) gives it to the
# front door with the release document. That is why the documents that stay
# private keep their acts in their own module rather than here. A compensator
# must live in the module of the act it undoes, because `[compensates …]`
# names a def of the same module. So each acts module carries its own
# `nothing-to-undo`.
#
# EVERY IDIOM IS A TOOL UNDERNEATH, never a second copy of a recipe: git, make
# targets through scripts/build-slot.sh (the runner lock live agents share,
# L102), and the process module's bounded subprocess. The helpers are
# scope=public with no [effects] clause. That makes them callable from an
# importing module, but they are not commands, so no flow can name one as an
# act (flow.md §4.1: an act is an [effects]-bearing def).
#
# FIELDS ARE NEVER EMPTY. An empty field is the one a performer supplies
# (flow.md §4.6, RULED: #1260 CA-2), and the runner refuses to invoke it. So
# every value an act needs is either a non-empty argument or derived.
[?lib 'cx-stdlib/process' :as process]
[?lib 'cx-stdlib/io'      :as io]
[?lib 'cx-stdlib/strings' :as strings]
[?lib 'cx-stdlib/env'     :as env]
# NO [?lib 'cx-stdlib/cx']: an acts module importing it, directly or through a
# module it imports, gives `cx flow --env` no resolver rows at all (#1709), so
# documents are read and written through the codec's own native primitives,
# [$cx-parse] and [$cx-serialize], which need no import.
[?lib 'cx-stdlib/re'      :as re]
[?lib 'cx-stdlib/path'    :as path]

# ══ shared ═══════════════════════════════════════════════════════════════════


# the wall-clock budgets a subprocess gets: a local git read, a network git
# call (fetch / ls-remote / push), and one make target (the longest selected
# step is the fixtures grader, well inside four hours). Defs, not consts: a
# [?const] is not importable, and the importing modules need the same three.
[?def git-ms  scope=public pure [returns int] () 120000]
[?def net-ms  scope=public pure [returns int] () 600000]
[?def make-ms scope=public pure [returns int] () 14400000]

# log-line: one progress line to stderr, so a run that takes minutes is not
# silent until its record prints. It writes through io, which the `write`
# grant covers, and the runner narrows each act to the [effects] its def
# declares — so an act that logs declares [write] (an undeclared one answers
# the denial as a value mid-act, not a line).
[?def log-line scope=public impure ($s) [$io:write-line [$env:stderr] [$concat 'ci flow: ' $s]]]

[?def fail scope=public pure [returns element] ($msg)
  [err code='cx-err:CXER0100' message=$msg]]

[?def seq-of scope=public pure [returns any] ($xs)
  [?to-sequence [?for [in $x $xs] [yield $x]]]]

[?def cat2 scope=public pure [returns any] ($a $b) [?to-sequence [?concat $a $b]]]

[?def nonblank-lines scope=public pure [returns any] ($text)
  [?to-sequence [?for [in $l [$strings:split [$string $text] "\n"]]
    [where [not [= [$str-trim $l] '']]] [yield [$str-trim $l]]]]]

[?def member scope=public pure [returns bool] ($x $xs)
  [> [$count [?to-sequence [?for [in $y $xs] [where [= [$string $y] [$string $x]]] [yield $y]]]] 0]]

# tail-of: the last $k non-blank lines of a text, joined — what a red step's
# record carries, so the failure is read in the record, not in a log.
[?def tail-of scope=public pure [returns string] ($text $k)
  [?let [= $ls [?to-sequence [?for [in $l [$strings:split [$string $text] "\n"]]
                 [where [not [= [$str-trim $l] '']]] [yield $l]]]]
        [= $n [$count $ls]]
        [= $d [?if [> $n $k] [then [- $n $k]] [else 0]]]
    [$strings:join [?to-sequence [?drop $d $ls]] "\n"]]]

# found: does $rx match ANYWHERE in $s. [$re:matches] is a FULL match
# (re.md), which is what is-sha and evidence-ok want and nothing else here does.
[?def found scope=public pure [returns bool] ($rx $s) [> [$count [$re:find-all $rx [$string $s]]] 0]]

[?def ok scope=public pure [returns bool] ($r) [= [$string $r@exit-code] '0']]
[?def out scope=public pure [returns string] ($r) [$str-trim [$string $r@stdout]]]
[?def why scope=public pure [returns string] ($r)
  [$concat 'exit ' [$string $r@exit-code]
           [?if [= [$string $r@timed-out] 'true'] [then ' (timed out)'] [else '']] ': '
           [$tail-of [$concat [$string $r@stderr] "\n" [$string $r@stdout]] 6]]]

# git: `git -C DIR ARGS…`, bounded — no git call can hang a run.
[?def git scope=public impure [returns element] ($dir $args $ms)
  [$process:run [$cat2 ('git', '-C', [$string $dir]) $args] timeout-ms=$ms]]

# git-out: the trimmed stdout of a git call that must succeed, or the err.
[?def git-out scope=public impure [returns any] ($dir $args $ms $what)
  [?let [= $r [$git $dir $args $ms]]
    [?if [$ok $r] [then [$out $r]]
      [else [$fail [$concat $what ': git ' [$strings:join $args ' '] ' in ' [$string $dir]
                            ' — ' [$why $r]]]]]]]

[?def git-ok scope=public impure [returns bool] ($dir $args $ms) [$ok [$git $dir $args $ms]]]


# ── the gap: the post-merge loop's last RUN line ─────────────────────────────
# The loop grades the MAIN checkout's tree and appends `<utc> <sha>
# RUN-START (kind)` before a run and `<utc> <sha> RUN-EXIT=<n> <status> (kind)`
# after it to vcx/target/gate-loop.log; only those two kinds are verdict
# lines. A merge lands, and a load-sensitive step runs, only in a GAP — the
# last RUN line a RUN-EXIT (AGENTS-1, rule 5 of 2026-09-24).
[?def last-run-line scope=public impure [returns string] ($log)
  [?if [not [$io:is-file $log]] [then '']
    [else [?let [= $ls [?to-sequence [?for [in $l [$strings:split [$io:read-file $log] "\n"]]
                         [where [or [$strings:contains $l ' RUN-START'] [$strings:contains $l ' RUN-EXIT=']]]
                         [yield [$str-trim $l]]]]]
      [?if [= [$count $ls] 0] [then ''] [else [$strings:join [?to-sequence [?drop [- [$count $ls] 1] $ls]] '']]]]]]]

# seconds in a duration literal: `90s`, `45m`, `4h`.
[?def seconds-of scope=public pure [returns int] ($d)
  [?let [= $t [$str-trim [$string $d]]]
        [= $len [$strings:length $t]]
        [= $n [$strings:slice $t 1 [- $len 1]]]
        [= $u [$strings:slice $t $len $len]]
        [= $v [?else [$strings:to-int $n] -1]]
    [?if [< $v 0] [then -1]
      [else [?match $u [case 's' $v] [case 'm' [* $v 60]] [case 'h' [* $v 3600]] [else -1]]]]]]

# gap-wait: block until the last RUN line is a RUN-EXIT, polling every 30 s,
# at most $secs seconds. A RUN-EXIT that is not =0 answers now: a merge on a
# red head waits for its fix unless the caller allows it ($red-ok).
[?def gap-wait scope=public impure [returns element] ($log $secs $red-ok)
  [?let [= $max [?if [< $secs 30] [then 1] [else [/ $secs 30]]]]
    [?loop [= $i 0]
      [?let [= $line [$last-run-line $log]]
        [?if [= $line '']
          [then [break [$fail [$concat 'no RUN-START / RUN-EXIT line in ' $log
                                       ' — the post-merge loop has never written a verdict there']]]]
          [else [?if [$strings:contains $line ' RUN-EXIT=']
            [then [?if [or $red-ok [$strings:contains $line ' RUN-EXIT=0 ']]
              [then [break [gap line=$line polls=[$string [+ $i 1]]]]]
              [else [break [$fail [$concat 'the head is RED — ' $line
                                           ' — a merge waits for the fix (allow-red=true in the specs merges anyway)']]]]]]
            [else [?if [>= $i $max]
              [then [break [$fail [$concat 'no gap after ' [$string $secs] ' s: the last RUN line is still `'
                                           $line '`']]]]
              [else [?let [= $_ [?if [= $i 0] [then [$log-line [$concat 'waiting for RUN-EXIT: ' $line]]] [else null]]]
                          [= $_z [?sleep 30s]]
                      [continue [+ $i 1]]]]]]]]]]]]]

# ── the runner paths and the one make idiom ─────────────────────────────────
#
# The integration branch derives from VERSION (release/<major>.<minor>), never a
# literal. The own runner is $HOME/git-repos/cx/.build-slot-<worktree dir> and the
# shared one .build-slot-impl (D17a). The loop's log is the MAIN checkout's, the
# first row of `git worktree list`.

[?def base-ref scope=public impure [returns string] ()
  [?let [= $v [$str-trim [$io:read-file 'VERSION']]]
        [= $xy [$strings:join [?to-sequence [?take 2 [$strings:split $v '.']]] '.']]
    [$concat 'origin/release/' $xy]]]

[?def home scope=public impure [returns string] () [$env:var-or-default 'HOME' '']]
[?def own-slot scope=public impure [returns string] ()
  [$concat [$home] '/git-repos/cx/.build-slot-' [$path:basename [$env:cwd]]]]
[?def shared-slot scope=public impure [returns string] () [$concat [$home] '/git-repos/cx/.build-slot-impl']]

[?def main-checkout scope=public impure [returns string] ()
  [?let [= $l [$first [$nonblank-lines [$out [$git '.' ('worktree', 'list', '--porcelain') [$git-ms]]]]]]
    [$str-trim [$strings:replace-first [$string $l] 'worktree ' '']]]]

# run make under a runner: the lock stays scripts/build-slot.sh's (L102;
# its stale-holder break needs #1706), the toolchain devbox's, the output a
# log file per step so no capture is held in memory.
[?def slot-make scope=public impure [returns element] ($runner $words $log)
  [$process:run [$cat2 ('sh', 'scripts/build-slot.sh', 'devbox', 'run', '--', 'make', '--no-print-directory') $words]
                env={CX_BUILD_SLOT: $runner} timeout-ms=[$make-ms]
                capture={stdout: $log, stderr: [$concat $log '.err']}]]

[?def log-tail scope=public impure [returns string] ($log $k)
  [$tail-of [$concat [?else [$io:read-file $log] ''] "\n" [?else [$io:read-file [$concat $log '.err']] '']] $k]]

# ══ release.flow.cx — a release cut, as acts (RULED: RFLOW-1 L103) ═══════════
#
# The phases of the retired scripts/release.sh, one act each, in its order,
# over the same tools underneath: scripts/tag_release.sh (the gate, the bump,
# the tag and the build at the tag), scripts/lib/r22_profile_gate.sh (the R2.2
# staging and the blocking install gate, PGL-1), scripts/release_linux.sh
# (the docker lane), scripts/release_asset_links_gate.cx (#1670), git, gh and
# make. The fields:
#   --tag=vX.Y.Z           the release; never derived here and never written:
#                          the tag is an argument;
#   --from-bump=none|<sha> D83a: cut from an ALREADY-BUMPED commit (the front
#                          door's refresh of cx-private's bump). No gate, no
#                          bump, no merge. Fail-closed: HEAD must be <sha>,
#                          and VERSION must already be the tag's version;
#   --mode=real|dry        dry runs the preflight for real (and tag_release.sh
#                          --dry-run), then every later act answers
#                          `[would-… …]`. That is release.sh's --dry-run;
#   --publish=yes|no       no skips the org page and the editor extension
#                          (release.sh's --no-publish);
#   --linux=yes|no         no ships no linux tarballs (release.sh's
#                          --no-linux), said out loud.
#
# THE PIVOT IS `push` (phase 3): the source repository's branch and tag on
# origin. Everything before it is local and compensable, undone in reverse:
#   - the merge to main is reset to the main it had;
#   - dist/ is removed;
#   - the local tag is deleted, and the bump commit reset.
# Everything after it is forward-only: the GitHub release, the org page, and
# the editor extension. A red one lands the run :incomplete with the count.

[?def rel-sh scope=private impure [returns element] ($args $env $ms)
  [$process:run [$cat2 ('bash', '-c') $args] env=$env timeout-ms=$ms]]

# a call into scripts/lib/r22_profile_gate.sh, the R2.2 staging the cut and
# release_profile_gate.sh share (PGL-1). The library is shell; this sources it
# and calls one function with its arguments. It is a call, not a recipe.
[?def r22 scope=private impure [returns element] ($fn $args $env)
  [$rel-sh [$cat2 ([$concat '. scripts/lib/r22_profile_gate.sh && ' $fn ' "$@"'], 'r22') $args] $env [$make-ms]]]

[?def rel-version scope=private pure [returns string] ($tag) [$strings:replace-first [$str-trim [$string $tag]] 'v' '']]
[?def rel-notes scope=private pure [returns string] ($tag) [$concat 'RELEASE_NOTES_' [$str-trim [$string $tag]] '.md']]
[?def rel-line scope=private pure [returns string] ($tag)
  [?let [= $v [$rel-version $tag]] [$concat 'release/' [$strings:join [?to-sequence [?take 2 [$strings:split $v '.']]] '.']]]]
[?def rel-bump scope=private pure [returns bool] ($from-bump) [not [= [$str-trim [$string $from-bump]] 'none']]]
[?def dry scope=private pure [returns bool] ($mode) [= [$str-trim [$string $mode]] 'dry']]

[?def ran scope=private impure [returns element] ($argv $ms)
  [?else [$process:run $argv timeout-ms=$ms] [not-found exit-code='127' stderr=[$concat [$string [$first $argv]] ': not found']]]]

# the platform names: the internal target (macos-arm64) and the STABLE public
# one (darwin-arm64), which the quickstart's releases/latest/download resolves.
[?def platforms scope=private impure [returns element] ()
  [?let [= $arch [$out [$process:run ('uname', '-m') timeout-ms=10000]]]
        [= $os [$strings:lower [$out [$process:run ('uname', '-s') timeout-ms=10000]]]]
    [plat target=[$concat [?if [= $os 'darwin'] [then 'macos'] [else $os]] '-' $arch] public=[$concat $os '-' $arch]]]]

# nothing-to-undo — the reversal of a read (flows/private-acts.cx's header
# says why a read before the pivot still names a compensator).
[?def nothing-to-undo scope=public impure [effects [read]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='')
  [nothing-undone why='the act read and changed nothing']]

# ── ci/release-preflight — phase 0, real in both modes ───────────────────────
[?def release-preflight scope=public impure [effects [read] [write] [subprocess] [env]] [compensates nothing-to-undo]
  [returns element] ($tag='' $from-bump='' $mode='' $publish='' $linux='')
  [?let [= $t [$str-trim [$string $tag]]] [= $v [$rel-version $t]]
    [?if [not [$re:matches [$re:compile '^v[0-9]+\.[0-9]+\.[0-9]+(-.+)?$'] $t]]
      [then [$fail [$concat 'ci/release-preflight: --tag=`' $t '` is not vX.Y.Z']]]
      [else [?let
        [= $head [$out [$git '.' ('rev-parse', 'HEAD') [$git-ms]]]]
        [= $cur [$out [$git '.' ('rev-parse', '--abbrev-ref', 'HEAD') [$git-ms]]]]
        [= $on [$str-trim [?else [$io:read-file 'VERSION'] '']]]
        [= $fb [$str-trim [$string $from-bump]]]
        [= $branch [?if [$rel-bump $fb] [then $cur] [else [$rel-line $t]]]]
        [= $gh [$ran ('gh', 'auth', 'status') [$net-ms]]]
        [= $bad [$cat2
          [$cat2
            [?if [$rel-bump $fb]
              [then [$cat2 [?if [not [= $head $fb]] [then ([$concat '--from-bump=' $fb ' given but HEAD is ' $head ' — refresh the clone onto the bumped commit first'])] [else ()]]
                           [$cat2 [?if [not [= $on $v]] [then ([$concat '--from-bump: VERSION on disk is `' $on '`, not ' $v ' from ' $t ' (fail-closed, RULED: D83a)'])] [else ()]]
                                  [?if [= $cur 'HEAD'] [then ('--from-bump: a detached HEAD — check out the branch the refresh refreshed')] [else ()]]]]]
              [else [?if [not [= $cur $branch]] [then ([$concat 'not on ' $branch ' (a v-tag is cut from its release line — #666)'])] [else ()]]]]
            [$cat2 [?if [not [$ok [$git '.' ('diff-index', '--quiet', 'HEAD') [$git-ms]]]] [then ('the working tree has tracked changes')] [else ()]]
                   [?if [not [$io:is-file [$rel-notes $t]]] [then ([$concat 'no ' [$rel-notes $t] ' (every release needs its notes file)'])] [else ()]]]]
          [$cat2
            [$cat2 [?if [$ok [$git '.' ('rev-parse', '-q', '--verify', [$concat 'refs/tags/' $t]) [$git-ms]]] [then ([$concat 'the tag ' $t ' already exists'])] [else ()]]
                   [?if [not [$ok [$ran ('devbox', 'version') 60000]]] [then ('no devbox (the gate\'s make needs it)')] [else ()]]]
            [$cat2 [?if [not [$ok $gh]] [then ('gh is missing or not authenticated (gh auth login)')] [else ()]]
                   [?if [not [$c-member [$string $publish] ('yes', 'no')]] [then ([$concat '--publish=`' [$string $publish] '` is neither yes nor no'])] [else ()]]]]]]
        [= $bad2 [$cat2 $bad
          [$cat2 [?if [not [$c-member [$string $linux] ('yes', 'no')]] [then ([$concat '--linux=`' [$string $linux] '` is neither yes nor no'])] [else ()]]
                 [?if [not [$c-member [$string $mode] ('real', 'dry')]] [then ([$concat '--mode=`' [$string $mode] '` is neither real nor dry'])] [else ()]]]]]
        [= $pins [?if [or [$dry $mode] [> [$count $bad2] 0]] [then [skipped-pins exit-code='0']]
                   [else [$process:run ('devbox', 'run', '--', 'make', '-s', 'deps-check') timeout-ms=[$net-ms]]]]]
        [= $all [$cat2 $bad2 [?if [$ok $pins] [then ()] [else ('the pins are stale or a deps/ checkout drifted — make deps-sync (RS-7)')]]]]
        [?if [> [$count $all] 0]
          [then [$fail [$concat 'ci/release-preflight: ' [$string [$count $all]] " defect(s):\n  " [$strings:join $all "\n  "]]]]
          [else [preflight tag=$t version=$v branch=$branch head=$head notes=[$rel-notes $t]
                           from-bump=$fb mode=[$string $mode]]]]]]]]]

[?def c-member scope=private pure [returns bool] ($x $xs) [$member $x $xs]]

# ── ci/release-tag — phase 1: gate + bump + tag (+ the build at the tag) ─────
# tag_release.sh runs make test and verify-doc-links, bumps VERSION through
# bump_version.sh, commits the bump, TAGS it, and builds at the tag (#979,
# CO-4). Under --from-bump the gate and the bump already happened in
# cx-private, so the tag alone is made here, signed when a key is configured.
# Undone by release-untag.
[?def release-tag scope=public impure [effects [read] [write] [subprocess] [env]] [compensates release-untag]
  [returns element] ($tag='' $from-bump='' $mode='' $publish='' $linux='' $preflight='')
  [?let [= $t [$str-trim [$string $tag]]] [= $before [$string $preflight@head]]
        [= $fb [$rel-bump $from-bump]]
    [?if [$dry $mode]
      [then [?if $fb
        [then [would-tag tag=$t on=[$string $from-bump] how='an annotated tag, signed if a key is configured; no gate, no bump (D83a)']]
        [else [?let [= $r [$process:run ('devbox', 'run', '--', 'scripts/tag_release.sh', '--dry-run', $t) timeout-ms=[$net-ms]]]
          [?if [not [$ok $r]] [then [$fail [$concat 'ci/release-tag: tag_release.sh --dry-run ' $t ' — ' [$why $r]]]]
            [else [would-tag tag=$t on=$before how='scripts/tag_release.sh: make test + verify-doc-links, the bump, the tag, the build at the tag'
                             checks=[$tail-of [$string $r@stdout] 2]]]]]]]]
      [else [?let
        [= $msg [$concat 'CX ' $t ' release. See RELEASE_NOTES_' [$strings:replace $t '.' '_'] '.md for full release notes.']]
        [= $signed [and [$ok [$git '.' ('config', '--get', 'user.signingkey') [$git-ms]]] [$ok [$ran ('gpg', '--list-secret-keys') 60000]]]]
        [= $r [?if $fb
                [then [$git '.' ('tag', [?if $signed [then '-s'] [else '-a']], $t, '-m', $msg) [$git-ms]]]
                [else [$process:run ('devbox', 'run', '--', 'scripts/tag_release.sh', $t) timeout-ms=28800000]]]]
        [?if [not [$ok $r]] [then [$fail [$concat 'ci/release-tag: ' [?if $fb [then 'git tag'] [else 'scripts/tag_release.sh']] ' — ' [$why $r]]]]
          [else [tagged tag=$t sha=[$out [$git '.' ('rev-parse', [$concat $t '^{commit}']) [$git-ms]]]
                        before=$before bumped=[$string [not $fb]]]]]]]]]]

# release-untag — the local tag deleted and, when this run bumped, the bump
# commit reset to the head preflight measured. Nothing had left the machine.
[?def release-untag scope=public impure [effects [read] [write] [subprocess]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='' $preflight='')
  [?if [$dry $mode] [then [untagged what='nothing — a dry run tags nothing']]
    [else [?let [= $t [$str-trim [$string $tag]]]
                [= $_d [$git '.' ('tag', '-d', $t) [$git-ms]]]
                [= $before [$string $preflight@head]]
                [= $_r [?if [$rel-bump $from-bump] [then null] [else [$git '.' ('reset', '-q', '--hard', $before) [$git-ms]]]]]
            [?if [$ok [$git '.' ('rev-parse', '-q', '--verify', [$concat 'refs/tags/' $t]) [$git-ms]]]
              [then [$fail [$concat 'release-untag: the tag ' $t ' is still there']]]
              [else [untagged tag=$t head=[$out [$git '.' ('rev-parse', 'HEAD') [$git-ms]]]]]]]]]]

# ── ci/release-package — phases 2 and 2b: the artifacts, at the tag ──────────
# EVERY artifact build runs while HEAD is still the tagged commit (#979,
# CO-4). The merge to main is the next act, and it moves HEAD off the tag.
[?def write-sums scope=private impure [returns element] ($tag $extra)
  [$rel-sh ([$concat 'cd dist && { shasum -a 256 cx-"$0"-*.tar.gz "cx-conformance-$0.zip" "$@"; '
                     '( cd public && shasum -a 256 cx-*.tar.gz ); } > SHA256SUMS.txt'], $tag, [?splice $extra]) {} 60000]]

[?def release-package scope=public impure [effects [read] [write] [subprocess] [env]] [compensates release-unpackage]
  [returns element] ($tag='' $from-bump='' $mode='' $publish='' $linux='' $tagged='')
  [?let [= $t [$str-trim [$string $tag]]] [= $p [$platforms]]
        [= $tg [$string $p@target]] [= $pp [$string $p@public]]
        [= $lin [= [$string $linux] 'yes']]
    [?if [$dry $mode]
      [then [would-package tag=$t target=$tg public=$pp linux=[$string $lin]
                           what=[$concat 'cx + libcx + cx.h for ' $tg '; the conformance bundle + deps.cxd; the flat dist/public/cx-' $pp
                                         '.tar.gz and the profile tarballs; one SHA256SUMS.txt; the asset-links gate; the R2.2 install gate, '
                                         'each staged library loaded through the extraction probe, its cx_codec_inventory and cx_features compared with the build\'s own'
                                         [?if $lin [then '; the linux lane (docker)'] [else '; NO linux tarballs (--linux=no)']]]]]
      [else [?let
        [= $env {R22_EXPECT_HEADLINE: [$concat 'cx v' [$rel-version $t]]}]
        [= $_c [?if [$io:exists [$concat 'dist/' $tg]] [then [$io:remove-tree [$concat 'dist/' $tg]]] [else null]]]
        [= $_m [$io:make-dirs [$concat 'dist/' $tg]]]
        [= $steps ([step what='collect' r=[$r22 'r22_collect_platform_files' ([$concat 'dist/' $tg]) $env]],
                   [step what='tar' r=[$process:run ('tar', 'czf', [$concat 'cx-' $t '-' $tg '.tar.gz'], [$concat $tg '/']) cwd='dist' timeout-ms=600000]],
                   [step what='conformance bundle' r=[$process:run ('zip', '-qr', [$concat 'dist/cx-conformance-' $t '.zip'], 'conformance', 'deps.cxd', '-x', '*.bak') timeout-ms=600000]])]
        [= $bad0 [?to-sequence [?for [in $s $steps] [where [not [$ok $s/r]]] [yield [$concat [$string $s@what] ' — ' [$why $s/r]]]]]]
        [?if [> [$count $bad0] 0] [then [$fail [$concat 'ci/release-package: ' [$strings:join $bad0 '; ']]]]
          [else [?let
            [= $_pub [?if [$io:exists 'dist/public'] [then [$io:remove-tree 'dist/public']] [else null]]]
            [= $_pm [$io:make-dirs 'dist/public']]
            [= $cxdir [$out [$r22 'r22_vcx_target' () $env]]]
            [= $more ([step what='flat public tarball' r=[$r22 'r22_tar_platform' ([$concat 'dist/' $tg], [$concat [$env:cwd] '/dist/public'], $pp) $env]],
                      [step what='make build-profiles' r=[$process:run ('devbox', 'run', '--', 'make', 'build-profiles') timeout-ms=[$make-ms]]],
                      [step what='the profile tarballs' r=[$r22 'r22_stage_profiles' ('dist/public', $pp) $env]],
                      [step what='SHA256SUMS' r=[$write-sums $t ()]],
                      [step what='the asset-links gate (#1670)'
                            r=[$process:run ('devbox', 'run', '--', [$concat $cxdir '/cx'], '--allow-all', 'scripts/release_asset_links_gate.cx', '--dir', 'dist/public')
                                            timeout-ms=[$net-ms]]],
                      [step what='make build-extraction-probe (the R2.2 loading probe, RLOAD-1)'
                            r=[$process:run ('devbox', 'run', '--', 'make', 'build-extraction-probe') timeout-ms=[$make-ms]]],
                      [step what='R2.2, the per-profile install gate' r=[$r22 'r22_profile_gate' ('dist/public', $pp) $env]],
                      [step what='the linux lane'
                            r=[?if $lin [then [$process:run [$cat2 ('scripts/release_linux.sh')
                                                                   [$cat2 [?if [= [$env:var-or-default 'RELEASE_LINUX_AMD64' ''] ''] [then ()] [else ('--amd64')]] ($t)]]
                                                            env=$env timeout-ms=28800000]]
                                 [else [skipped exit-code='0']]]],
                      [step what='SHA256SUMS over every platform' r=[$write-sums $t ()]])]
            [= $bad [?to-sequence [?for [in $s $more] [where [not [$ok $s/r]]] [yield [$concat [$string $s@what] ' — ' [$why $s/r]]]]]]
            [?if [> [$count $bad] 0] [then [$fail [$concat 'ci/release-package: ' [$strings:join $bad '; ']]]]
              [else [packaged tag=$t target=$tg public=$pp linux=[$string $lin]
                              assets=[$string [$count [$io:list-dir 'dist/public']]]]]]]]]]]]]]

[?def release-unpackage scope=public impure [effects [read] [write]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='' $tagged='')
  [?let [= $_r [?if [and [not [$dry $mode]] [$io:exists 'dist']] [then [$io:remove-tree 'dist']] [else null]]]
    [unpackaged dir='dist' dry=[$string [$dry $mode]]]]]

# ── ci/release-merge-main — phase 2c: the release line into main, locally ────
# AFTER every build, because it moves HEAD off the tag (CO-4). It is local, so
# it is undone by resetting main to what it was. Under --from-bump there is no
# second branch, so there is nothing to merge (D83a).
[?def release-merge-main scope=public impure [effects [read] [write] [subprocess]] [compensates release-unmerge]
  [returns element] ($tag='' $from-bump='' $mode='' $publish='' $linux='' $preflight='')
  [?let [= $t [$str-trim [$string $tag]]] [= $line [$string $preflight@branch]]
    [?if [$rel-bump $from-bump] [then [merged-main status='skipped' why=[$concat $line ' is already the branch being tagged (D83a)']]]
      [else [?if [$dry $mode]
        [then [would-merge from=$line into='main' how='git checkout main, pull --ff-only, merge --no-ff']]
        [else [?let [= $co [$git '.' ('checkout', '-q', 'main') [$git-ms]]]
                    [= $pl [$git '.' ('pull', '-q', '--ff-only', 'origin', 'main') [$net-ms]]]
                    [= $mainb [$out [$git '.' ('rev-parse', 'main') [$git-ms]]]]
                    [= $mg [$git '.' ('merge', '--no-ff', $line, '-m', [$concat 'Merge ' $line ' — ' $t]) [$git-ms]]]
          [?if [not [and [$ok $co] [$ok $pl] [$ok $mg]]]
            [then [$fail [$concat 'ci/release-merge-main: ' [$why [?if [not [$ok $co]] [then $co] [else [?if [not [$ok $pl]] [then $pl] [else $mg]]]]]]]]
            [else [merged-main status='merged' from=$line main-before=$mainb main=[$out [$git '.' ('rev-parse', 'main') [$git-ms]]]]]]]]]]]]]

[?def release-unmerge scope=public impure [effects [read] [write] [subprocess]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='' $preflight='')
  [?if [or [$dry $mode] [$rel-bump $from-bump]] [then [unmerged what='nothing was merged']]
    [else [?let [= $co [$git '.' ('checkout', '-q', 'main') [$git-ms]]]
                [= $rs [$git '.' ('reset', '-q', '--hard', 'origin/main') [$git-ms]]]
                [= $back [$git '.' ('checkout', '-q', [$string $preflight@branch]) [$git-ms]]]
            [?if [and [$ok $rs] [$ok $back]] [then [unmerged main=[$out [$git '.' ('rev-parse', 'main') [$git-ms]]]]]
              [else [$fail [$concat 'release-unmerge: ' [$why [?if [$ok $rs] [then $back] [else $rs]]]]]]]]]]]

# ── ci/release-push — phase 3: THE PIVOT ─────────────────────────────────────
# The release line (or, under --from-bump, the one branch) and the tag, with
# main too when this run merged it. Once origin has the tag, nothing takes it
# back.
[?def release-push scope=public impure [effects [read] [write] [subprocess]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='' $preflight='')
  [?let [= $t [$str-trim [$string $tag]]] [= $line [$string $preflight@branch]]
        [= $refs [?if [$rel-bump $from-bump] [then ($line, $t)] [else ('main', $line, $t)]]]
    [?if [$dry $mode] [then [would-push to='origin' refs=[$strings:join $refs ' ']]]
      [else [?let [= $_l [$log-line [$concat 'push origin ' [$strings:join $refs ' ']]]]
                  [= $r [$git '.' [$cat2 ('push', 'origin') $refs] [$net-ms]]]
        [?if [$ok $r] [then [pushed to='origin' refs=[$strings:join $refs ' ']]]
          [else [$fail [$concat 'ci/release-push: ' [$why $r]]]]]]]]]]

# ── ci/release-gh — phase 4: the ONE GitHub release (RS-11) ──────────────────
[?def release-gh scope=public impure [effects [read] [write] [subprocess]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='' $preflight='')
  [?let [= $t [$str-trim [$string $tag]]] [= $notes [$string $preflight@notes]] [= $title [$concat 'CX ' $t]]
        [= $versioned [$cat2 [?to-sequence [?for [in $f [$io:list-dir 'dist']] [where [$re:matches [$re:compile [$concat '^cx-' [$re:escape $t] '-.*\.tar\.gz$']] [$string $f]]]
                                              [yield [$concat 'dist/' [$string $f]]]]]
                             ([$concat 'dist/cx-conformance-' $t '.zip'], 'dist/SHA256SUMS.txt')]]
        [= $flat [?to-sequence [?for [in $f [?else [$io:list-dir 'dist/public'] ()]] [where [$re:matches [$re:compile '^cx-.*\.tar\.gz$'] [$string $f]]]
                   [yield [$concat 'dist/public/' [$string $f]]]]]]
    [?if [$dry $mode] [then [would-release tag=$t title=$title notes=$notes]]
      [else [?let
        [= $exists [$ok [$process:run ('gh', 'release', 'view', $t) timeout-ms=[$net-ms]]]]
        [= $a [?if $exists
                [then [$process:run ('gh', 'release', 'edit', $t, '--notes-file', $notes, '--title', $title) timeout-ms=[$net-ms]]]
                [else [$process:run [$cat2 ('gh', 'release', 'create', $t, '--title', $title, '--notes-file', $notes) $versioned] timeout-ms=[$make-ms]]]]]
        [= $b [?if $exists [then [$process:run [$cat2 ('gh', 'release', 'upload', $t) [$cat2 $versioned ('--clobber')]] timeout-ms=[$make-ms]]] [else [skipped exit-code='0']]]]
        [= $c [$process:run [$cat2 ('gh', 'release', 'upload', $t) [$cat2 $flat ('--clobber')]] timeout-ms=[$make-ms]]]
        [?if [not [and [$ok $a] [$ok $b] [$ok $c]]]
          [then [$fail [$concat 'ci/release-gh: ' [$why [?if [not [$ok $a]] [then $a] [else [?if [not [$ok $b]] [then $b] [else $c]]]]]]]]
          [else [released tag=$t assets=[$string [+ [$count $versioned] [$count $flat]]] existed=[$string $exists]]]]]]]]]

# ── ci/release-org-page — phase 5: the org profile README (best-effort) ──────
[?def release-org-page scope=public impure [effects [read] [write] [subprocess]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='')
  [?if [= [$string $publish] 'no'] [then [org-page status='skipped' why='--publish=no']]
    [else [?if [$dry $mode] [then [would-sync what='make release-all (publish-org)']]
      [else [?let [= $r [$process:run ('make', 'release-all') timeout-ms=[$net-ms]]]
        [?if [$ok $r] [then [org-page status='synced']] [else [$fail [$concat 'ci/release-org-page: make release-all — ' [$why $r]]]]]]]]]]]

# ── ci/release-vscode — phase 7: the extension, a release asset (CO-20) ──────
# Packaged from the pinned cx-tooling checkout under deps/ (RS-12, D59a) and
# attached to the release with a regenerated SHA256SUMS.txt. The marketplace
# and Open VSX publishes run only when VSCE_PAT / OVSX_PAT are set, and say
# so when they are not.
[?def release-vscode scope=public impure [effects [read] [write] [subprocess] [env]] [returns element]
  ($tag='' $from-bump='' $mode='' $publish='' $linux='')
  [?let [= $t [$str-trim [$string $tag]]] [= $dir 'deps/cx-tooling/tooling/vscode']
    [?if [= [$string $publish] 'no'] [then [vscode status='skipped' why='--publish=no']]
      [else [?if [$dry $mode]
        [then [would-attach what=[$concat 'npm ci + npm run package in ' $dir '; the vsix and a refreshed SHA256SUMS.txt uploaded to ' $t
                                          '; vsce/ovsx only when VSCE_PAT/OVSX_PAT are set']]]
        [else [?let [= $i [$process:run ('npm', 'ci', '--silent') cwd=$dir timeout-ms=[$net-ms]]]
                    [= $p [$process:run ('npm', 'run', '--silent', 'package') cwd=$dir timeout-ms=[$net-ms]]]
                    [= $vsix [$last-of-seq [$sort [?to-sequence [?for [in $f [$io:list-dir $dir]]
                               [where [$re:matches [$re:compile '^cx-language-.*\.vsix$'] [$string $f]]] [yield [$string $f]]]]]]]
          [?if [or [not [$ok $i]] [not [$ok $p]] [= $vsix '']]
            [then [$fail [$concat 'ci/release-vscode: no .vsix — ' [$why [?if [$ok $i] [then $p] [else $i]]]]]]
            [else [?let [= $_c [$io:copy [$concat $dir '/' $vsix] [$concat 'dist/' $vsix]]]
                        [= $s [$write-sums $t ($vsix)]]
                        [= $u [$process:run ('gh', 'release', 'upload', $t, [$concat 'dist/' $vsix], 'dist/SHA256SUMS.txt', '--clobber') timeout-ms=[$net-ms]]]
                        [= $vp [$env:var-or-default 'VSCE_PAT' '']] [= $op [$env:var-or-default 'OVSX_PAT' '']]
                        [= $m1 [?if [= $vp ''] [then 'Marketplace not requested (VSCE_PAT unset, optional per CO-20)']
                                 [else [?if [$ok [$process:run ('npx', '--yes', '@vscode/vsce', 'publish', '--packagePath', [$concat $dir '/' $vsix], '--pat', $vp) timeout-ms=[$net-ms]]]
                                   [then 'published to the VS Code Marketplace'] [else 'the Marketplace publish FAILED']]]]]
                        [= $m2 [?if [= $op ''] [then 'Open VSX not requested (OVSX_PAT unset, optional per CO-20)']
                                 [else [?if [$ok [$process:run ('npx', '--yes', 'ovsx', 'publish', [$concat $dir '/' $vsix], '--pat', $op) timeout-ms=[$net-ms]]]
                                   [then 'published to Open VSX'] [else 'the Open VSX publish FAILED']]]]]
              [?if [not [and [$ok $s] [$ok $u]]] [then [$fail [$concat 'ci/release-vscode: attaching ' $vsix ' — ' [$why [?if [$ok $s] [then $u] [else $s]]]]]]
                [else [vscode status='attached' vsix=$vsix marketplace=$m1 open-vsx=$m2]]]]]]]]]]]]]

[?def last-of-seq scope=private pure [returns string] ($xs)
  [?if [= [$count $xs] 0] [then ''] [else [$string [$nth $xs [$count $xs]]]]]]

# ══ make-one — one make target, run once, as a row (L97) ═════════════════════
# The one make invocation the documentation flow's acts use
# (docs-src/flow/docs-acts.cx): `-o build-vcx` and the three *_SKIP_CX_BUILD
# switches, because the caller built the binary the flow runs under. A relink
# under a running flow is the 'Exec format error' class, and every
# `build-vcx` on the head relinks (#1697). The answer is a [made …] row
# either way. ok=true carries the last line of its stdout (its summary line).
# ok=false carries its exit code and the tail of stdout and stderr together.
# So a caller running several can report every red one. $label prefixes the
# progress line ('docs flow').
[?def make-argv scope=public pure [returns any] ($target)
  ('make', '--no-print-directory', '-o', 'build-vcx',
   'DOCS_SKIP_CX_BUILD=1', 'GUIDE_SKIP_CX_BUILD=1', 'SITE_SKIP_CX_BUILD=1',
   $target)]

[?def make-one scope=public impure [returns element] ($target $label)
  [?let [= $_ [$io:write-line [$env:stderr] [$concat $label ': make ' $target]]]
        [= $r [$process:run [$make-argv $target]]]
        [= $out [$concat [$string $r@stdout] [$string $r@stderr]]]
    [?if [= [$string $r@exit-code] '0']
      [then [made target=$target ok=true
                  tail=[$tail-of [?if [= [$str-trim [$string $r@stdout]] '']
                                   [then $out] [else $r@stdout]] 1]]]
      [else [made target=$target ok=false exit=[$string $r@exit-code]
                  tail=[$tail-of $out 25]]]]]]
