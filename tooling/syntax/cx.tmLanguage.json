{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CX",
  "scopeName": "source.cx",
  "fileTypes": ["cx", "cxl"],
  "comment": "Q6 v0.7.0: TextMate grammar for CX. Covers v0.7.0 surface — directive forms, FLWOR clauses, fn / partial / match / try, lookup operator, operator-token forms, body-position refs, anchors / IDs / merges.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#xml-decl" },
    { "include": "#cx-directive" },
    { "include": "#eval-directive" },
    { "include": "#interpolation" },
    { "include": "#element" },
    { "include": "#scalar" },
    { "include": "#quoted-string" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.number-sign.cx", "match": "#.*$" },
        { "name": "comment.block.cx", "begin": "\\[-", "end": "\\]" }
      ]
    },
    "xml-decl": {
      "match": "\\[\\?xml\\s+[^\\]]*\\]",
      "name": "meta.xml-decl.cx"
    },
    "cx-directive": {
      "begin": "\\[\\?cx\\b",
      "end": "\\]",
      "name": "meta.cx-directive.cx",
      "patterns": [
        { "name": "entity.name.tag.cx-directive.cx", "match": "\\b(allow-eval|pure-only|log-level|log-format|log-output|test-mode|max-eval-depth|output-target|output-strict|cx-eval-version|cxl-version|use-module|schema|include|version)\\b" },
        { "include": "#scalar" },
        { "include": "#quoted-string" }
      ]
    },
    "eval-directive": {
      "begin": "\\[\\?",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.section.eval-directive.begin.cx" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.eval-directive.end.cx" }
      },
      "name": "meta.eval-directive.cx",
      "patterns": [
        { "name": "keyword.control.eval-directive.cx", "match": "\\b(if|for|with|include|def|use|let|fn|match|try|for-tumbling|for-sliding|for-group-by|fn-ref|partial|apply|focus|str-template|error|range)\\b" },
        { "name": "entity.name.function.module.cx", "match": "\\b(cx|log|fn|map|array|math):[A-Za-z][A-Za-z0-9_-]*" },
        { "name": "keyword.operator.flwor.cx", "match": ":(let|where|count|order-by|group-by|tumbling|sliding|in|return|while|be|then|else|body|params)\\b" },
        { "name": "constant.language.placeholder.cx", "match": "\\b_\\b" },
        { "name": "keyword.operator.token.cx", "match": "\\|>|=>|\\|\\||!=|<=|>=|->" },
        { "include": "#interpolation" },
        { "include": "#scalar" },
        { "include": "#quoted-string" }
      ]
    },
    "interpolation": {
      "begin": "\\[\\?=",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.cx" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.cx" }
      },
      "name": "meta.interpolation.cx",
      "patterns": [
        { "name": "variable.other.cxpath.cx", "match": "@[A-Za-z_][A-Za-z0-9_-]*" },
        { "name": "constant.cxpath.id.cx", "match": "#[A-Za-z_][A-Za-z0-9_-]*" },
        { "name": "keyword.operator.token.cx", "match": "\\|>|=>|\\?[A-Za-z_]|<=|>=|->" }
      ]
    },
    "element": {
      "begin": "\\[",
      "end": "\\]",
      "name": "meta.element.cx",
      "patterns": [
        { "name": "entity.name.tag.cx", "match": "(?<=\\[)[A-Za-z][A-Za-z0-9_:-]*" },
        { "name": "constant.cxpath.id.cx", "match": "#[A-Za-z_][A-Za-z0-9_-]*" },
        { "name": "constant.cxpath.anchor.cx", "match": "&[A-Za-z_][A-Za-z0-9_-]*" },
        { "name": "constant.cxpath.merge.cx", "match": "\\*[A-Za-z_][A-Za-z0-9_-]*" },
        { "name": "support.type.cx", "match": ":[a-z][a-z0-9_-]*" },
        { "name": "entity.other.attribute-name.cx", "match": "\\b([A-Za-z_][A-Za-z0-9_-]*)=" },
        { "name": "variable.other.bodyref.cx", "match": "@[A-Za-z_][A-Za-z0-9_-]*" },
        { "include": "#scalar" },
        { "include": "#quoted-string" }
      ]
    },
    "scalar": {
      "patterns": [
        { "name": "constant.numeric.integer.cx", "match": "\\b-?(0x[0-9A-Fa-f]+|0o[0-7]+|0b[01]+|[0-9]+)\\b" },
        { "name": "constant.numeric.float.cx", "match": "\\b-?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.language.boolean.cx", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.null.cx", "match": "\\bnull\\b" },
        { "name": "constant.other.date.cx", "match": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}\\b" },
        { "name": "constant.other.datetime.cx", "match": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([Zz]|[+-][0-9]{2}:?[0-9]{2})\\b" }
      ]
    },
    "quoted-string": {
      "patterns": [
        { "name": "string.quoted.single.cx", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.cx", "match": "\\\\." }] },
        { "name": "string.quoted.double.cx", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.cx", "match": "\\\\." }] }
      ]
    }
  }
}
