# tooling/lsp/tests/probe.cx — probe `cx lsp` for diagnostics / hover /
# completion on a source file via LSP stdio (#922 / PYE-5: probe.py
# retires; this is its CX successor).
#
#   cx --allow-read --allow-write --allow-subprocess tooling/lsp/tests/probe.cx \
#     CXBIN OP FILE [LINE COL]
#
#   OP: diag        — print the published diagnostics for FILE (JSON array)
#       hover       — print the hover result at LINE COL (0-based)
#       completion  — print the completion result at LINE COL (0-based)
#
# This is a MANUAL exploration driver: it answers "what does the server say
# about THIS file at THIS position", which the gated harness
# (vcx/tests/lint_lsp_umbrella_test.v, #996) deliberately does not — that one
# pins fixed cases. The fixtures beside this file are its usual subjects; see
# README.md. Nothing gates on this script, and nothing should: a manual driver
# that is also a gate is the vacuous-gate shape #1003 closed.
#
# ── Why FILES and no pipe at all (#1003) ──────────────────────────────
#
# The previous shape spawned `cx lsp`, wrote every request to the child's
# stdin, then read frames off the child's stdout until the shutdown response.
# It drained stdout and NEVER drained stderr — and `process/spawn` always
# gives the child a stderr PIPE. A pipe holds 64 KiB. A server that says more
# than that on stderr (`--verbose`, a panic backtrace, a runtime warning
# storm) blocks in write(2) on a full stderr pipe while this script blocks in
# read(2) on a stdout pipe the server can no longer reach: both processes idle
# in S, forever, with no timeout anywhere. Measured on macOS: 65536 bytes of
# child stderr completes, 65537 hangs.
#
# `process/run` is not the fix either. It drains BOTH streams, and its
# `$timeout-ms` bounds the wait — but it drains them only after the child has
# exited, so a child that fills either pipe first never gets to exit. It is
# bounded, not safe: the session dies at the deadline and the response is lost.
# That is not hypothetical here. `textDocument/completion` on the fixtures
# beside this file answers with about 159 KB — two and a half pipe buffers.
#
# So the session uses no pipe at all: the request stream goes to a file, the
# shell redirects the child's stdout and stderr to files, and this script
# reads the files back afterwards. Files cannot fill. `$timeout-ms` still
# bounds a server that wedges for its own reasons. This is the same pattern,
# and the same reason, as the #996 harness (vcx/tests/lint_lsp_umbrella_test.v
# lsph_run).
#
# All defs are strictly define-before-use.

[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/process']
[?lib 'cx-stdlib/strings']
[?lib 'cx-stdlib/json']
[?lib 'cx-stdlib/jsonrpc']
[?lib 'cx-stdlib/array']
[?lib 'cx-stdlib/bytes']
[?lib 'cx-stdlib/fp']

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def die scope=public impure ($msg)
  [?let [= $w [$cry $msg]] [$env:exit 2]]]
[?def seq-flat scope=public ($xs) [$fp:flat-map $xs [?fn ($x) $x]]]

# The wall-clock budget for one whole LSP session. A server that has not
# finished answering a handful of requests inside this is wedged, and the
# escalation in `process/run` is what makes that a REPORTED failure instead
# of a hang.
[?const SESSION-TIMEOUT-MS 20000]

# ── LSP framing ───────────────────────────────────────────────────────

[?def frame scope=public ($payload)
  [?let [= $body [$json:emit $payload]]
    [$cat ('Content-Length: ', [$string [$strings:length-bytes $body]],
           '\r\n\r\n', $body)]]]

# ── un-framing: the response stream is a STRING, not a live pipe ──────
#
# Byte offsets throughout: Content-Length counts BYTES, and a diagnostic
# message carrying non-ASCII would desynchronise a rune-indexed scan.

[?def header-length scope=public ($header)
  [?let
    [= $lines [$strings:split $header '\r\n']]
    [= $hits [?for [in $l $lines]
        [where [$strings:starts-with $l 'Content-Length:']]
        [yield [?else [$strings:to-int [$strings:trim
          [$strings:slice $l 15 [$strings:length $l]]]] -1]]]]
    [?if [$empty $hits] [then -1] [else $hits[1]]]]]

# split-frames: peel `Content-Length: N\r\n\r\n<N bytes>` off the front of
# $rest until it no longer parses. $fuel bounds the walk; a stream that
# outruns it is truncated rather than looped on.
[?def split-frames scope=public ($rest $acc $fuel)
  [?let
    [= $sep [$bytes:find $rest [$bytes:from-string-utf8 '\r\n\r\n']]]
    [= $len [?if [< $sep 0]
        [then -1]
        [else [$header-length
          [$bytes:to-string-utf8 [$bytes:slice $rest 0 $sep]]]]]]
    [= $start [+ $sep 4]]
    [= $end [+ $start $len]]
    [?if [or [= $fuel 0] [< $sep 0] [< $len 1] [> $end [$bytes:length $rest]]]
      [then $acc]
      [else [?let
        [= $body [$bytes:to-string-utf8 [$bytes:slice $rest $start $end]]]
        [= $msg [?match [$json:parse $body]
            [case [err $e] ()]
            [else [$json:parse $body]]]]
        [$split-frames [$bytes:slice $rest $end [$bytes:length $rest]]
          [$seq-flat ($acc, $msg)] [- $fuel 1]]]]]]]

# ── one LSP session ───────────────────────────────────────────────────
# Writes the whole request stream to a file (shutdown id 99, then `exit`, so
# the server closes itself down), has the shell redirect all three of the
# child's descriptors to files, and reads the response stream back. The server
# processes its stdin sequentially, so everything published before the
# shutdown response is collected deterministically — no sleeping, no partial
# reads, and nothing that can fill.
#
# `exec` in the shell string matters: it makes `cx lsp` REPLACE the shell, so
# `$timeout-ms`'s escalation targets the server itself rather than a wrapper
# that would leave the real child behind. `$new-process-group=true` covers the
# rest: without it the escalation signals one pid, and any grandchild the
# server left behind survives, reparents to init, and keeps running — measured
# once here against a wrapper server that forked a `sleep`.
#
# WHY STILL THE SHELL, after #1014 gave `spawn` per-stream dispositions
# (process.md §3.2): the three-way redirect is only half of what this needs.
# The other half is a WALL-CLOCK BUDGET with group escalation and a `timed-out`
# flag to `$die` on — and that lives on `run` (§3.1 `$timeout-ms` / §4.5), not
# on `spawn`. `spawn` + `wait-timeout` returns absence and kills nothing ("no
# kill — caller decides", §3.2), so migrating would mean re-implementing
# SIGTERM → grace → SIGKILL-the-group here, in a probe, one layer further from
# the thing that already does it correctly. `run` has no file dispositions and
# `$capture` does not reach files, so the shell's `< > 2>` is the shortest
# honest spelling of "all three streams to files, under a killable budget".
# NOT a workaround for the 64 KiB pipe class §4.3 names — that is exactly what
# the redirect to files avoids, and it must stay avoided: `capture=:none` here
# means there is no pipe of ours anywhere, so nothing can fill.

[?def lsp-session scope=public impure ($cxbin $path $extras)
  [?let
    [= $text [?match [$io:read-file $path]
        [case [err $e] [$die [$cat ('probe: cannot read ', $path, ': ', $e@message)]]]
        [else [$io:read-file $path]]]]
    [= $uri [$cat ('file://', $path)]]
    [= $requests [$seq-flat (
        ([$jsonrpc:request 1 'initialize'
            {processId: null, rootUri: null, capabilities: {}}],
         [$jsonrpc:notification 'initialized' {}],
         [$jsonrpc:notification 'textDocument/didOpen'
            {textDocument: {uri: $uri, languageId: 'cx', version: 1, text: $text}}]),
        $extras,
        ([$jsonrpc:request 99 'shutdown' {}],
         [$jsonrpc:notification 'exit' {}]))]]
    [= $dir [$io:temp-dir 'cx-lsp-probe-']]
    [= $in-f [$cat ($dir, '/in.bin')]]
    [= $out-f [$cat ($dir, '/out.bin')]]
    [= $err-f [$cat ($dir, '/err.log')]]
    [= $wrote [$io:write-file $in-f
        [$cat [?for [in $r $requests] [yield [$frame $r]]]]]]
    [= $result [$process:run ('/bin/sh', '-c',
        [$cat ("exec '", $cxbin, "' lsp < '", $in-f, "' > '", $out-f,
               "' 2> '", $err-f, "'")])
        timeout-ms=SESSION-TIMEOUT-MS capture=:none new-process-group=true]]
    [= $serr [?match [$io:read-file $err-f] [case [err $e] ''] [else [$io:read-file $err-f]]]]
    [= $raw [?match [$io:read-file $out-f] [case [err $e] ''] [else [$io:read-file $out-f]]]]
    [= $swept [$io:remove-tree $dir]]
    [= $wedged [?if [= [?else $result@timed-out false] true]
        [then [$die [$cat ('probe: ', $cxbin, ' lsp did not finish inside ',
                           [$string SESSION-TIMEOUT-MS], 'ms and was killed; stderr: ',
                           $serr)]]]
        [else ()]]]
    [$split-frames [$bytes:from-string-utf8 $raw] () 2000]]]

# result-of: the .result of the message with the given id; () if none.
[?def result-of scope=public ($msgs $id)
  [$seq-flat [?for [in $m $msgs]
    [where [= [?else $m.id -1] $id]]
    [yield [?else $m.result ()]]]]]

# emit-result: pretty JSON of the FIRST collected result, 'null' when
# the slot is empty (Python parity: json.dumps(None) prints null).
[?def emit-result scope=public impure ($r)
  [?if [$empty $r]
    [then [$say 'null']]
    [else [$say [$json:emit-with-opts $r[1] {indent: 2}]]]]]

# ── main ──────────────────────────────────────────────────────────────

[?let
  [= $argv [$env:argv]]
  [= $usage [?if [< [$count $argv] 4]
      [then [$die 'usage: probe.cx CXBIN diag|hover|completion FILE [LINE COL]']]
      [else ()]]]
  [= $cxbin $argv[2]]
  [= $op $argv[3]]
  [= $path $argv[4]]
  [= $done
    [?if [= $op 'diag']
      [then [?let
        [= $msgs [$lsp-session $cxbin $path ()]]
        [= $diag-arrays [?for [in $m $msgs]
            [where [= [?else $m.method ''] 'textDocument/publishDiagnostics']]
            [yield [?else $m.params.diagnostics []]]]]
        [= $all [?if [$empty $diag-arrays] [then []]
            [else [$array:join $diag-arrays]]]]
        [$say [$json:emit-with-opts $all {indent: 2}]]]]
      [else [?if [or [= $op 'hover'] [= $op 'completion']]
        [then [?let
          [= $usage2 [?if [< [$count $argv] 6]
              [then [$die [$cat ('usage: probe.cx CXBIN ', $op, ' FILE LINE COL')]]]
              [else ()]]]
          [= $line [?else [$strings:to-int $argv[5]] -1]]
          [= $col [?else [$strings:to-int $argv[6]] -1]]
          [= $rid [?if [= $op 'hover'] [then 50] [else 60]]]
          [= $method [?if [= $op 'hover']
              [then 'textDocument/hover'] [else 'textDocument/completion']]]
          [= $uri [$cat ('file://', $path)]]
          [= $msgs [$lsp-session $cxbin $path
              ([$jsonrpc:request $rid $method
                 {textDocument: {uri: $uri},
                  position: {line: $line, character: $col}}],)]]
          [$emit-result [$result-of $msgs $rid]]]]
        [else [$die [$cat ('probe: unknown op "', $op, '" (diag|hover|completion)')]]]]]]]
  [?if false [then '']]]
