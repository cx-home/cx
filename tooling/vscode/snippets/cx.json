{
  "if directive": {
    "prefix": "?if",
    "body": ["[?if ${1:cond} :then ${2:then-expr} :else ${3:else-expr}]$0"],
    "description": "Conditional directive"
  },
  "for FLWOR": {
    "prefix": "?for",
    "body": ["[?for ${1:x} in ${2:coll} :return ${3:body}]$0"],
    "description": "FLWOR iteration"
  },
  "for with where + return": {
    "prefix": "?for-where",
    "body": [
      "[?for ${1:x} in ${2:coll}",
      "  :where ${3:predicate}",
      "  :return ${4:body}]$0"
    ],
    "description": "FLWOR with where predicate"
  },
  "let binding": {
    "prefix": "?let",
    "body": ["[?let :${1:name} ${2:value} :in ${3:body}]$0"],
    "description": "Lexical binding"
  },
  "fn first-class function": {
    "prefix": "?fn",
    "body": ["[?fn :params [${1:x}] :body ${2:body}]$0"],
    "description": "First-class function definition"
  },
  "match pattern": {
    "prefix": "?match",
    "body": [
      "[?match ${1:value}",
      "  :case ${2:pattern} ${3:result}",
      "  :else ${4:default}]$0"
    ],
    "description": "Pattern matching"
  },
  "try/catch": {
    "prefix": "?try",
    "body": [
      "[?try ${1:body}",
      "  :catch ${2:err-name} ${3:handler}]$0"
    ],
    "description": "Error handling"
  },
  "def top-level": {
    "prefix": "?def",
    "body": ["[?def ${1:name} ${2:value}]$0"],
    "description": "Top-level definition"
  },
  "include": {
    "prefix": "?include",
    "body": ["[?include \"${1:path.cx}\"]$0"],
    "description": "Sandboxed file inclusion"
  },
  "eval sandbox": {
    "prefix": "?eval",
    "body": ["[?eval ${1:source}]$0"],
    "description": "Sandboxed nested evaluation"
  },
  "element with id": {
    "prefix": "elid",
    "body": ["[${1:name} #${2:id} ${3:body}]$0"],
    "description": "Element with #id declaration"
  },
  "element with anchor": {
    "prefix": "elanchor",
    "body": ["[${1:name} &${2:anchor} ${3:body}]$0"],
    "description": "Element with &anchor"
  },
  "code block lang": {
    "prefix": "code",
    "body": ["[``` lang=${1:python} [|", "${2:source}", "|]]$0"],
    "description": "Embedded-language code block"
  },
  "cx:eval directive": {
    "prefix": "cxeval",
    "body": ["[?cx :eval \"${1:cx-source}\"]$0"],
    "description": "Self-host cx:eval call"
  },
  "log:info": {
    "prefix": "loginfo",
    "body": ["[log:info \"${1:message}\" ${2:fields}]$0"],
    "description": "Info-level structured log"
  }
}
