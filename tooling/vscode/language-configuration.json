{
  "comments": {
    "lineComment": "#",
    "blockComment": ["[-", "-]"]
  },
  "brackets": [
    ["[", "]"],
    ["[|", "|]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "[", "close": "]"},
    {"open": "[|", "close": "|]"},
    {"open": "(", "close": ")"},
    {"open": "\"\"\"", "close": "\"\"\""},
    {"open": "\"", "close": "\"", "notIn": ["string"]},
    {"open": "'", "close": "'", "notIn": ["string"]},
    {"open": "[```", "close": "]"}
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "\\[(\\?[A-Za-z_][A-Za-z0-9_-]*|[A-Za-z_][A-Za-z0-9_:-]*)\\b[^\\]]*$",
      "end": "^\\s*\\]"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_:.\\-?]*",
  "onEnterRules": [
    {
      "beforeText": "\\[[A-Za-z_][^\\]]*$",
      "action": {"indent": "indent"}
    },
    {
      "beforeText": "\\[\\?[A-Za-z_][^\\]]*$",
      "action": {"indent": "indent"}
    }
  ]
}
