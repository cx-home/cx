{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["[|", "|]"]
  ],
  "autoClosingPairs": [
    {"open": "[", "close": "]"},
    {"open": "[|", "close": "|]"},
    {"open": "\"", "close": "\"", "notIn": ["string"]},
    {"open": "'", "close": "'", "notIn": ["string"]},
    {"open": "[```", "close": "]"}
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "\\[\\s*$",
      "end": "^\\s*\\]"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_:.\\-?]*",
  "onEnterRules": [
    {
      "beforeText": "\\[[A-Za-z_][^\\]]*$",
      "action": {"indent": "indent"}
    }
  ]
}
