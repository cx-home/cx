{
  "name": "cx-language",
  "displayName": "CX Language",
  "description": "Syntax highlighting, LSP, snippets, and formatting for CX (.cx / .cxs) — the structured data + code language. Surface covers CXPath as a first-class value kind, multi-arm [?match], pure-functional [?modify], atom literals (:NAME), [?def] module functions, [?const] constants, and [?lib] module loading.",
  "version": "0.8.0",
  "publisher": "cx-home",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cx-home/cx.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "cx",
    "structured-data",
    "xpath",
    "xquery",
    "language-server"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cx",
        "aliases": ["CX", "cx"],
        "extensions": [".cx", ".cxs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cx",
        "scopeName": "source.cx",
        "path": "./syntaxes/cx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json.cx": "json",
          "meta.embedded.block.jsonc.cx": "jsonc",
          "meta.embedded.block.javascript.cx": "javascript",
          "meta.embedded.block.javascriptreact.cx": "javascriptreact",
          "meta.embedded.block.typescript.cx": "typescript",
          "meta.embedded.block.typescriptreact.cx": "typescriptreact",
          "meta.embedded.block.python.cx": "python",
          "meta.embedded.block.xml.cx": "xml",
          "meta.embedded.block.html.cx": "html",
          "meta.embedded.block.css.cx": "css",
          "meta.embedded.block.scss.cx": "scss",
          "meta.embedded.block.sass.cx": "sass",
          "meta.embedded.block.less.cx": "less",
          "meta.embedded.block.sql.cx": "sql",
          "meta.embedded.block.yaml.cx": "yaml",
          "meta.embedded.block.toml.cx": "toml",
          "meta.embedded.block.shellscript.cx": "shellscript",
          "meta.embedded.block.fish.cx": "fish",
          "meta.embedded.block.rust.cx": "rust",
          "meta.embedded.block.go.cx": "go",
          "meta.embedded.block.c.cx": "c",
          "meta.embedded.block.cpp.cx": "cpp",
          "meta.embedded.block.java.cx": "java",
          "meta.embedded.block.ruby.cx": "ruby",
          "meta.embedded.block.lua.cx": "lua",
          "meta.embedded.block.graphql.cx": "graphql",
          "meta.embedded.block.dockerfile.cx": "dockerfile",
          "meta.embedded.block.markdown.cx": "markdown",
          "meta.embedded.block.ini.cx": "ini",
          "meta.embedded.block.makefile.cx": "makefile",
          "meta.embedded.block.cmake.cx": "cmake",
          "meta.embedded.block.php.cx": "php",
          "meta.embedded.block.kotlin.cx": "kotlin",
          "meta.embedded.block.swift.cx": "swift",
          "meta.embedded.block.scala.cx": "scala",
          "meta.embedded.block.haskell.cx": "haskell",
          "meta.embedded.block.elixir.cx": "elixir",
          "meta.embedded.block.erlang.cx": "erlang",
          "meta.embedded.block.clojure.cx": "clojure",
          "meta.embedded.block.regexp.cx": "regexp",
          "meta.embedded.block.proto.cx": "proto",
          "meta.embedded.block.diff.cx": "diff",
          "meta.embedded.block.csv.cx": "csv"
        }
      }
    ],
    "snippets": [
      {
        "language": "cx",
        "path": "./snippets/cx.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CX",
      "properties": {
        "cx.serverPath": {
          "type": "string",
          "default": "cx",
          "description": "Path to the `cx` executable. Default `cx` looks it up on $PATH. The extension runs `<serverPath> lsp` for the language server."
        },
        "cx.serverArgs": {
          "type": "array",
          "items": {"type": "string"},
          "default": ["lsp"],
          "description": "Arguments passed to the cx server. Default `[\"lsp\"]`. Append `--verbose` to trace JSON-RPC on stderr."
        },
        "cx.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces communication between VS Code and the cx language server."
        },
        "cx.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run `cx fmt` on save (delegates to the language server's formatting capability)."
        }
      }
    },
    "commands": [
      {
        "command": "cx.restartServer",
        "title": "CX: Restart Language Server"
      },
      {
        "command": "cx.showServerVersion",
        "title": "CX: Show Server Version"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
