# Merge into github-linguist lib/linguist/languages.yml (alphabetical: after
# "CWeb", before "Cabal Config" — re-check at submission). language_id is a
# PLACEHOLDER: mint the real one with linguist's script/update-ids.
CX:
  type: programming
  color: "#1a1a17"
  extensions:
    - ".cx"
    - ".cxd"
    - ".cxs"
  tm_scope: source.cx
  ace_mode: text
  language_id: 999999901
