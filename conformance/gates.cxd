[# Conformance gate policy (toggle manifest).

   DEFAULT = enforced (deny-by-default, mirroring spec/core/security.md's grant
   model): a failing fixture BLOCKS its gate. A suite/module marked `advisory`
   is the spec-first frontier — its failures are RUN and REPORTED but do NOT
   block the gate. Promote `advisory -> enforced` as the implementation lands;
   that promotion is the gate-progression control.

   Resolution order for a fixture's effective gate (most specific wins):
     per-case `gate=` attr  >  per-module entry here  >  per-suite default  >  enforced

   This manifest is module/suite-level. Per-case overrides live on the [case]
   itself (gate=advisory|pending|skip). See conformance/stdlib/AUTHORING.md and
   conformance/stdlib/SPEC-FINDINGS.md. #]

[gate-policy default=enforced

  [# core program + format suites: fully enforced (no frontier carve-out — the
     code.txt frontier is driven to zero by the spec-compliance effort). #]
  [suite name=code default=enforced]

  [# stdlib: implemented modules are enforced; not-yet-implemented modules are
     advisory (their fixtures are the spec-first worklist — red until built,
     must not block). Flip a module to enforced the moment it lands. #]
  [suite name=stdlib default=enforced
    [# implemented + enforced: bytes env format hash path random strings time uuid
       (left at the suite default; listed here for the reader) #]
    [module name=bytes   gate=enforced]
    [module name=env     gate=enforced]
    [module name=format  gate=enforced]
    [module name=hash    gate=enforced]
    [module name=path    gate=enforced]
    [module name=random  gate=enforced]
    [module name=strings gate=enforced]
    [module name=time    gate=enforced]
    [module name=uuid    gate=enforced]

    [# not yet implemented -> advisory (spec-first frontier) #]
    [module name=crypto   gate=advisory reason='full §3 impl complete + spec-faithful (47/49); 18 capability-denial cases now ENFORCED+green (random cap-guard on the 4 entropy generators, SPEC-FINDINGS M/N); module stays advisory only for crypto-015/028 which use the [?fallback] 2-arg shorthand the directive grammar rejects']
    [module name=csv      gate=advisory reason='RFC-4180 impl complete (35/38); csv-007 comma quote-convention, csv-013 nth-over-array, csv-032 crlf (SPEC-FINDINGS J)']
    [module name=email    gate=advisory reason='full §3 impl complete + spec-faithful (40/61); all 21 misses are the render_value quote-convention defect (space-bearing/empty/MIME-word strings + a string sequence), no genuine gaps; all 9 CXER1300-1306 error cases pass (SPEC-FINDINGS Q)']
    [module name=ft       gate=advisory reason='full §3 impl complete (Porter2 stemmer, TF-IDF/BM25, boolean/phrase/field queries, snippets); 14/29 honest, all 15 misses outside impl: 13 fixture-grammar bugs (9 two-resolver [?lib a b], 4 colon-less map), 1 index-stats shape conflict, 1 core [?fn] parser bug (SPEC-FINDINGS U)']
    [module name=geo      gate=advisory reason='full impl complete + spec-faithful (54/58); 4 fixtures blocked outside impl: geo-052/053 WKT quote-convention (render_value single-quotes; fixtures want double), geo-043/044 construct an out-of-range lon=190 [point] that point() rejects with CXER3601 per geo-004 contract (SPEC-FINDINGS L)']
    [module name=html     gate=advisory reason='full §3 impl complete + spec-faithful (12/32); 17 misses are render_value quote-convention (HTML strings render bare/single vs fixture double), 3 are core CXPath/directive gaps (path-on-call-expr, attr-axis terminal unwrap, [?fn:count] head) — no impl gaps (SPEC-FINDINGS R)']
    [module name=i18n     gate=enforced reason='full §3 impl complete; 44/44 green under render_value (catalogs, locale-fallback, full ICU MessageFormat, CLDR cardinal en/ru/pl/ar + ordinal en, all 5 error codes incl. CXER0271 denial) — messages returned as TextNode so rendered text emits verbatim (SPEC-FINDINGS S)']
    [module name=io       gate=advisory reason='unimplemented']
    [module name=json     gate=advisory reason='impl complete + spec-faithful; 4 fixtures blocked outside impl: json-005 harness bare-string render, json-030 ensure-ascii fixture bug, json-031/037 @length projection on string/sequence (core gap)']
    [module name=locale   gate=advisory reason='full §3 impl complete + spec-faithful (50/66); all 28 error cases pass; 14 misses render_value quote-convention, 2 f64-scientific render (parse-number-locale exact value, renderer emits 1.23e+06) — no impl gaps (SPEC-FINDINGS T)']
    [module name=log      gate=advisory reason='full §3 impl complete; 25/27 under render_value (leveled emit, structured fields, configure/min-level/sink/format, is-enabled); only log-012/013 ([$log:current-scope] reading a [?with-scope] map context) mismatch — dyn_context scope-read gap (SPEC-FINDINGS V)']
    [module name=math     gate=advisory reason='unimplemented']
    [module name=mime     gate=advisory reason='full impl complete + spec-faithful (23/45 under real render_value); 21 fixtures blocked by the double-quote string convention vs harness render_value (SPEC-FINDINGS O), mime-043 by a core CXPath node-set gap ($seq/membername does not select sequence members)']
    [module name=process  gate=advisory reason='unimplemented']
    [module name=prof     gate=advisory reason='unimplemented']
    [module name=re       gate=advisory reason='RE2 impl complete + spec-faithful; 22 fixtures blocked by re.cxd double-quote string convention (harness render_value renders bare/single, see SPEC-FINDINGS I)']
    [module name=store    gate=enforced reason='mem:// backend implemented (functional matrix + file:// deny paths)']
    [module name=test     gate=advisory reason='unimplemented']
    [module name=url      gate=advisory reason='RFC-3986 impl complete (32/38); 6 fixtures blocked by render-contract/spec-order defects (SPEC-FINDINGS K)']
    [module name=validate gate=advisory reason='DATA-RECORD validator impl complete + spec-faithful (21/39); 13 fixtures blocked by render_value quote convention (SPEC-FINDINGS P.1), 5 by env-unreachable extends/validate-with const+FN refs (P.2/P.3)']]]
