[# Conformance gate policy (toggle manifest).

   DEFAULT = enforced (deny-by-default, mirroring spec/core/security.md's grant
   model): a failing fixture BLOCKS its gate. A suite/module marked `advisory`
   is the spec-first frontier — its failures are RUN and REPORTED but do NOT
   block the gate. Promote `advisory -> enforced` as the implementation lands;
   that promotion is the gate-progression control.

   Resolution order for a fixture's effective gate (most specific wins):
     per-case `gate=` attr  >  per-module entry here  >  per-suite default  >  enforced

   This manifest is module/suite-level. Per-case overrides live on the [case]
   itself (gate=advisory|pending|skip). See conformance/stdlib/AUTHORING.md and
   conformance/stdlib/SPEC-FINDINGS.md. #]

[gate-policy default=enforced

  [# core program + format suites: fully enforced (no frontier carve-out — the
     code.txt frontier is driven to zero by the spec-compliance effort). #]
  [suite name=code default=enforced]

  [# stdlib: implemented modules are enforced; not-yet-implemented modules are
     advisory (their fixtures are the spec-first worklist — red until built,
     must not block). Flip a module to enforced the moment it lands. #]
  [suite name=stdlib default=enforced
    [# implemented + enforced: bytes env format hash path random strings time uuid
       (left at the suite default; listed here for the reader) #]
    [module name=bytes   gate=enforced]
    [module name=env     gate=enforced]
    [module name=format  gate=enforced]
    [module name=hash    gate=enforced]
    [module name=path    gate=enforced]
    [module name=random  gate=enforced]
    [module name=strings gate=enforced]
    [module name=time    gate=enforced]
    [module name=uuid    gate=enforced]

    [# not yet implemented -> advisory (spec-first frontier) #]
    [module name=crypto   gate=enforced reason='full §3 impl complete + spec-faithful (ENFORCED, all cases green); crypto-015/028 fixtures corrected to the spec [?fallback PRIMARY [recover-with SECONDARY]] form (§10.2.4; the 2-arg shorthand is not grammar, SPEC-FINDINGS AD); 18 capability-denial cases enforced (random cap-guard on the 4 entropy generators, SPEC-FINDINGS M/N)']
    [module name=csv      gate=enforced reason='RFC-4180 impl complete (ENFORCED, all cases green); csv-032 asserts CRLF emission via strings:contains; csv-013 unblocked by the iterate() array-atomization core fix ($nth/$arr[N] now expand __cx_arr__ transparently per code.md §6.6, SPEC-FINDINGS AF); csv-007 comma quote-convention re-derived via real render_value']
    [module name=email    gate=enforced reason='full §3 impl complete + spec-faithful (61/61 ENFORCED); all 21 quote-convention expected-outputs re-derived via the real render_value (SPEC-FINDINGS Q); all 9 CXER1300-1306 error cases pass']
    [module name=ft       gate=enforced reason='full §3 impl complete + spec-faithful (ENFORCED, all cases green): Porter2 stemmer, TF-IDF/BM25, boolean/phrase/field queries, snippets. Fixed 9 two-resolver [?lib a b]→two [?lib] (grammar [149]) + ft-026 put→put-doc; ft-001 spec contradiction resolved (ft.md §143 prose → map form, matching [returns map]); ft-029 unblocked by the [?directive]-balancing parser fix (SPEC-FINDINGS U/AB)']
    [module name=geo      gate=enforced reason='full impl complete + spec-faithful (56/58 ENFORCED); geo-043/044 per-case advisory (normalize on out-of-range point — point() rejects per geo-004 contract, SPEC-FINDINGS L); geo-052/053 WKT quote-convention re-derived via real render_value']
    [module name=html     gate=enforced reason='full §3 impl complete + spec-faithful (ENFORCED, all cases green); html-001 rewritten bind-first + simple-accessor /a@href (terminal-attr unwrap), html-005/006 use [$count] not [?fn:count] (SPEC-FINDINGS AD); 17 quote-convention expected-outputs re-derived via real render_value']
    [module name=i18n     gate=enforced reason='full §3 impl complete; 44/44 green under render_value (catalogs, locale-fallback, full ICU MessageFormat, CLDR cardinal en/ru/pl/ar + ordinal en, all 5 error codes incl. CXER0271 denial) — messages returned as TextNode so rendered text emits verbatim (SPEC-FINDINGS S)']
    [module name=io       gate=enforced reason='full cap-gated §3 impl; 49/51 denial cases ENFORCED+green (cap_guard read/write per §7 at every effect point, real os.* behind the guard); io-005/008 per-case advisory — fixture typo [$bytes:from-string] (no such fn; should be from-string-utf8) errors at arg-eval before the io effect point (SPEC-FINDINGS W)']
    [module name=json     gate=enforced reason='impl complete + spec-faithful (ENFORCED, all cases green); json-031/037 rewritten to assert via spec primitives [$strings:length]/[$count] (the prior [?]@length was an UNSPEC invented attribute — SPEC-FINDINGS AD); json-005 bare-string + json-030 ensure-ascii expected-outputs re-derived via real render_value']
    [module name=locale   gate=enforced reason='full §3 impl complete + spec-faithful (ENFORCED, all cases green); all 28 error cases pass; locale-018/019 now assert the numeric value via tol= (f64 renders scientific 1.23e+06 — the value is exact, SPEC-FINDINGS T/AD); 14 quote-convention expected-outputs re-derived via real render_value']
    [module name=log      gate=enforced reason='full §3 impl complete (27/27 ENFORCED): leveled emit, structured fields, configure/min-level/sink/format, is-enabled, [$log:current-scope] over [?with-scope] dyn_context; log-012/013 were quote-convention only (map values render bare), re-derived via real render_value (SPEC-FINDINGS V)']
    [module name=math     gate=advisory reason='unimplemented']
    [module name=mime     gate=enforced reason='full impl complete + spec-faithful (ENFORCED, all cases green); mime-043 rewritten to bind [$first …] then /@q (parse-accept returns a [sequence element]; CXPath navigates element trees not sequence members — SPEC-FINDINGS AD); 21 double-quote-convention expected-outputs re-derived via real render_value']
    [module name=process  gate=advisory reason='unimplemented']
    [module name=prof     gate=advisory reason='unimplemented']
    [module name=re       gate=enforced reason='RE2 impl complete + spec-faithful (ENFORCED, all cases green); 22 double-quote-convention expected-outputs re-derived via the real render_value (bare/single, SPEC-FINDINGS I)']
    [module name=store    gate=enforced reason='mem:// backend implemented (functional matrix + file:// deny paths)']
    [module name=test     gate=enforced reason='full §3 impl complete (ENFORCED, all cases green): assert-eq/true/false, assert-throws via [?fn] thunk through the eval.v env-hook, lifecycle hooks, assert-snapshot in-memory, assert-shape via validate-shape; test-009 fixture corrected to child-element record form (validate reads fields as children, validate.md §91 — SPEC-FINDINGS AD)']
    [module name=url      gate=enforced reason='RFC-3986 impl complete (ENFORCED, all cases green); url-032 fixture corrected — a map round-trip groups repeated key `a` per url.md §124 (key=insertion order), so a=1&a=3&b=2 is spec-faithful (SPEC-FINDINGS AD); 5 render-contract quote-convention expected-outputs re-derived via real render_value']
    [module name=validate gate=enforced reason='DATA-RECORD validator impl complete + spec-faithful (28/39 ENFORCED); 11 cases per-case advisory (err-element vs sequence/count projection + [?def] :pure parse + env-unreachable extends=, SPEC-FINDINGS P); 10 quote-convention expected-outputs re-derived via real render_value']]]
