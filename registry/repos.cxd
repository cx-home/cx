  [repo name=cx-binding-ruby group=binding ring=none ships=archived about='archived at the ABI it was frozen with; lang/_archived/README.md names the version']
  [repo name=cx-registry group=ecosystem ring=none ships=none about='the package index: the store, publisher keys, the publish program']
  [repo name=cx-decisions group=ecosystem ring=none ships=none about='the ledger, the process specs, the standing rules, design texts']
  [repo name=cx-tooling group=ecosystem ring=none ships=editor about='vscode, neovim, tree-sitter, completions, syntax, the installer, diagram']

