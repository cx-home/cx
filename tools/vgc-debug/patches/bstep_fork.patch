+
+  // ============================================================
+  // #63 B-STEP single-step controller (-d vgc_bstep, diagnostic only).
+  // A handler thread catches each EXC_BREAKPOINT (hardware single-step via
+  // ARM_DEBUG_STATE64 MDSCR_EL1.SS) on a task-wide exception port and calls the V
+  // callback vgc_bstep_on_step(thread_port) to inspect the stepped (worker) thread's
+  // root coverage. Validated standalone in scratchpad/single_step_probe.c. The
+  // handler thread never allocates via vgc (so it is not GC-registered / does not
+  // perturb STW); the worker arms SS on itself at a watched MatchEnv_clone and
+  // disarms at clone exit. Run with GC disabled (VGC_NEXT_GC_MB huge) so vgc's own
+  // mach suspend never races the single-step.
+  // ============================================================
+  #include <pthread.h>
+  #include <string.h>
+  extern void vgc_bstep_on_step(uint32_t thread_port); // V callback
+  static mach_port_t vgc_bstep_exc_port = MACH_PORT_NULL;
+  static volatile int vgc_bstep_active = 0;     // re-arm SS while set
+  static volatile int vgc_bstep_handler_up = 0;
+  #pragma pack(4)
+  typedef struct { mach_msg_header_t Head; mach_msg_body_t body;
+    mach_msg_port_descriptor_t thread; mach_msg_port_descriptor_t task;
+    NDR_record_t NDR; exception_type_t exception; mach_msg_type_number_t codeCnt;
+    int64_t code[2]; char pad[256]; } vgc_bstep_req_t;
+  typedef struct { mach_msg_header_t Head; NDR_record_t NDR; kern_return_t RetCode; } vgc_bstep_rep_t;
+  #pragma pack()
+  static inline void vgc_bstep_set_ss(uint32_t th, int en) {
+    arm_debug_state64_t ds; mach_msg_type_number_t c = ARM_DEBUG_STATE64_COUNT;
+    if (thread_get_state((thread_act_t)th, ARM_DEBUG_STATE64, (thread_state_t)&ds, &c) != KERN_SUCCESS) return;
+    if (en) ds.__mdscr_el1 |= 1ULL; else ds.__mdscr_el1 &= ~1ULL;
+    thread_set_state((thread_act_t)th, ARM_DEBUG_STATE64, (thread_state_t)&ds, ARM_DEBUG_STATE64_COUNT);
+  }
+  static void* vgc_bstep_handler(void* a) {
+    (void)a;
+    for (;;) {
+      vgc_bstep_req_t req; memset(&req, 0, sizeof(req));
+      if (mach_msg(&req.Head, MACH_RCV_MSG, 0, sizeof(req), vgc_bstep_exc_port,
+                   MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL) != KERN_SUCCESS) continue;
+      uint32_t th = req.thread.name;
+      vgc_bstep_on_step(th);
+      if (vgc_bstep_active) vgc_bstep_set_ss(th, 1);
+      vgc_bstep_rep_t rep; memset(&rep, 0, sizeof(rep));
+      rep.Head.msgh_bits = MACH_MSGH_BITS(MACH_MSGH_BITS_REMOTE(req.Head.msgh_bits), 0);
+      rep.Head.msgh_size = sizeof(rep); rep.Head.msgh_remote_port = req.Head.msgh_remote_port;
+      rep.Head.msgh_local_port = MACH_PORT_NULL; rep.Head.msgh_id = req.Head.msgh_id + 100;
+      rep.NDR = req.NDR; rep.RetCode = KERN_SUCCESS;
+      mach_msg(&rep.Head, MACH_SEND_MSG, sizeof(rep), 0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL);
+    }
+    return 0;
+  }
+  static inline void vgc_bstep_init(void) {
+    if (vgc_bstep_handler_up) return;
+    if (mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &vgc_bstep_exc_port) != KERN_SUCCESS) return;
+    mach_port_insert_right(mach_task_self(), vgc_bstep_exc_port, vgc_bstep_exc_port, MACH_MSG_TYPE_MAKE_SEND);
+    task_set_exception_ports(mach_task_self(), EXC_MASK_BREAKPOINT, vgc_bstep_exc_port,
+        EXCEPTION_DEFAULT | MACH_EXCEPTION_CODES, ARM_THREAD_STATE64);
+    pthread_t t; pthread_create(&t, 0, vgc_bstep_handler, 0);
+    vgc_bstep_handler_up = 1;
+  }
+  static inline void vgc_bstep_arm(uint32_t th)    { vgc_bstep_active = 1; vgc_bstep_set_ss(th, 1); }
+  static inline void vgc_bstep_disarm(uint32_t th) { vgc_bstep_active = 0; vgc_bstep_set_ss(th, 0); }
