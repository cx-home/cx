+// branch 3 (transient: holder existed only at the GC instant / clone↔collect order).
+// Tags: 0x40f0=victim 0x40f1=K_live 0x40f2=reading-idx 0x41a0=hit-referrer
+//       0x41a1=region(0xa/0xb/0xc) 0x41a2=which(1=victim,2=K_live) 0x41af=hits-this-victim
+//       0x5f00/0x5f01/0x5f02=self-test (arena/anon/done).
+// ─────────────────────────────────────────────────────────────────────────────
+
+const vgc_hf_pend_n = 64
+__global vgc_hf_pv = [64]usize{} // pending victim buffer
+__global vgc_hf_pk = [64]usize{} // pending K_live (intermediate keys-array obj)
+__global vgc_hf_pr = [64]int{} // pending reading-cache-idx (excluded from 3a)
+__global vgc_hf_phead = u32(0)
+__global vgc_hf_invos = u64(0) // total holder-find runs (stat)
+__global vgc_hf_t1 = usize(0) // current target: victim buffer
+__global vgc_hf_t2 = usize(0) // current target: K_live
+__global vgc_hf_hits = u32(0) // hits for the current victim
+__global vgc_hf_curregion = u32(0) // region-class for the in-flight leg
+__global vgc_hf_budget = i64(0) // remaining word budget across all legs (caps work)
+// own-globals exclusion bounds (set per run): skip referrers inside our own arrays.
+__global vgc_hf_xt1 = usize(0)
+__global vgc_hf_xt2 = usize(0)
+__global vgc_hf_xpv_lo = usize(0)
+__global vgc_hf_xpv_hi = usize(0)
+__global vgc_hf_xpk_lo = usize(0)
+__global vgc_hf_xpk_hi = usize(0)
