+		// own-globals exclusion (prior pollution: these arrays STORE the targets).
+		if addr == vgc_hf_xt1 || addr == vgc_hf_xt2 || (addr >= vgc_hf_xpv_lo
+			&& addr < vgc_hf_xpv_hi) || (addr >= vgc_hf_xpk_lo && addr < vgc_hf_xpk_hi) {
+			addr += sizeof(usize)
+			continue
+		}
+		val := unsafe { *(&usize(voidptr(addr))) }
+		if (vgc_hf_t1 != 0 && val == vgc_hf_t1) || (vgc_hf_t2 != 0 && val == vgc_hf_t2) {
+			vgc_hf_hits++
