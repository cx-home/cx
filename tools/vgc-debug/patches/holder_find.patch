+fn C.vgc_hf_enumerate_anon(arena_lo usize, arena_hi usize)
+
+// vgc_hf_enqueue: read-time. Resolve K_live (keys-array object base containing pkey)
+// and push (victim, K_live, reading-idx) for the next GC's in-STW search. ~0 cost.
+@[markused]
+fn vgc_hf_enqueue(victim usize, pkey usize) {
+	mut klive := usize(0)
+	if pkey >= vgc_arena_lo && pkey < vgc_arena_hi {
+		ks := vgc_find_span(voidptr(pkey))
+		if ks != unsafe { nil } && ks.in_use && ks.elem_size != 0 {
+			kidx := u32((pkey - ks.base) / usize(ks.elem_size))
+			if kidx < ks.nelems {
+				klive = ks.base + usize(kidx) * usize(ks.elem_size)
+			}
+		}
+	}
+	h := vgc_hf_phead % u32(vgc_hf_pend_n)
+	vgc_hf_pv[h] = victim
+	vgc_hf_pk[h] = klive
+	vgc_hf_pr[h] = C.vgc_get_cache_idx()
+	vgc_hf_phead = h + 1
