+				}
+			}
+		}
+		if nrep < 64 {
+			C.vgc_say(0x6ab0, u64(buf))
+			C.vgc_say(0x6ab1, u64(hbase))
+			C.vgc_say(0x6ab2, u64(hm))
+		}
+		if hm == 1 {
+			vgc_assoc_marked++
+		} else if hm == 0 {
+			vgc_assoc_unmarked++
+		}
+		nrep++
+		vgc_assoc_buf[i] = 0 // report-once: clear the swept entry
+	}
+	if nrep > 0 {
+		C.vgc_say(0x6abf, u64(nrep))
+	}
