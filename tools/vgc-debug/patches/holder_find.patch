+// vgc_hf_scan_region: C callback for the anon walk (region-class 0xc).
+@[export: 'vgc_hf_scan_region']
+@[markused]
+fn vgc_hf_scan_region(lo usize, hi usize) {
+	vgc_hf_curregion = 0xc
+	vgc_hf_scan_range(lo, hi)
+}
+
+// vgc_hf_run_one: IN-STW, post-sweep. Search for one victim's K_live across 3a/3b/3c.
+fn vgc_hf_run_one(victim usize, klive usize, rdidx int) {
+	vgc_hf_invos++
+	vgc_hf_t1 = victim
+	vgc_hf_t2 = klive
+	vgc_hf_hits = 0
+	vgc_hf_budget = i64(8) * 1024 * 1024 // <=64 MiB scanned across all legs
+	// own-globals exclusion bounds for this run
+	vgc_hf_xt1 = usize(voidptr(&vgc_hf_t1))
+	vgc_hf_xt2 = usize(voidptr(&vgc_hf_t2))
+	vgc_hf_xpv_lo = usize(voidptr(&vgc_hf_pv[0]))
+	vgc_hf_xpv_hi = vgc_hf_xpv_lo + usize(vgc_hf_pend_n) * sizeof(usize)
+	vgc_hf_xpk_lo = usize(voidptr(&vgc_hf_pk[0]))
+	vgc_hf_xpk_hi = vgc_hf_xpk_lo + usize(vgc_hf_pend_n) * sizeof(usize)
+	C.vgc_say(0x40f0, u64(victim))
+	C.vgc_say(0x40f1, u64(klive))
+	C.vgc_say(0x40f2, u64(u32(rdidx)))
+	// 3a: other reactor stacks (suspended ⇒ frozen). reading thread EXCLUDED.
+	vgc_hf_curregion = 0xa
+	for i in 0 .. vgc_heap.ncaches {
+		if i == rdidx {
+			continue
+		}
+		c := unsafe { &vgc_heap.caches[i] }
+		if !c.registered {
+			continue
+		}
+		vgc_hf_scan_range(c.stack_lo, c.stack_hi)
+	}
+	// 3b: in-use scannable arena spans.
+	vgc_hf_curregion = 0xb
+	for i in 0 .. vgc_heap.nspans {
+		span := unsafe { vgc_heap.allspans[i] }
+		if span == unsafe { nil } || !span.in_use || span.noscan || span.elem_size == 0 {
+			continue
+		}
+		vgc_hf_scan_range(span.base, span.base + usize(span.nelems) * usize(span.elem_size))
+	}
+	// 3c: private-anon (libc/picoev/frame-pool). Per-victim ⇒ the per-GC extroots
+	// cost trap does not apply.
+	C.vgc_hf_enumerate_anon(vgc_arena_lo, vgc_arena_hi)
+	C.vgc_say(0x41af, u64(vgc_hf_hits)) // 0 ⇒ branch-3 candidate (transient)
+}
+
+// vgc_hf_drain: IN-STW, post-sweep. Process up to 8 pending victims/GC (caps STW add).
+fn vgc_hf_drain() {
+	mut done := 0
+	for i in 0 .. vgc_hf_pend_n {
+		if done >= 8 {
+			break
+		}
+		v := vgc_hf_pv[i]
+		k := vgc_hf_pk[i]
+		if v == 0 && k == 0 {
+			continue
+		}
+		vgc_hf_run_one(v, k, vgc_hf_pr[i])
+		vgc_hf_pv[i] = 0
+		vgc_hf_pk[i] = 0
+		done++
+	}
+}
