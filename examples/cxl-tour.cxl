[- CXL / cx-eval TOUR — every v0.7.0 directive in one document.
   Companion to examples/cx-tour.cx (which covers the data-format
   surface). This file showcases the eval / template / query side:
   FLWOR, pattern matching, error handling, first-class functions,
   the cx:/log:/fn: module surfaces, and the operator-token forms. ]

[program
  [- 1. Document-level eval config directives — pin the cx-eval
     version and the evaluator output target. ]
  [?cx output-target=text]

  [- 2. Variable interpolation [?=expr]. The basic surface — emits
     the string value of the expression at evaluation time. ]
  [data name=alice age=30]
  [intro Hello, [?=//data/@name]. You are [?=//data/@age].]

  [- 3. Conditional. Two-slot (cond + then) or three-slot
     (cond + then + else). Labeled form uses :then / :else. ]
  [section
    [h2 ?if]
    [?if @stock > 0 :then in stock :else out of stock]
    [?if @stock > 0 :then visible]
    [- multi-branch array form ]
    [?if [[@stock > 100, Plenty], [@stock > 10, Some], [*, None]]]
  ]

  [- 4. Top-level definition. Two forms:
     labeled: [?def NAME :body BODY]
     array:   [?def [NAME, BODY]]
     Bound name is callable as [?NAME] or via [?use NAME]. ]
  [section
    [h2 ?def + ?use]
    [?def greet :body Hello, [?=@name]!]
    [?use greet]
  ]

  [- 5. Functions with parameters. ]
  [section
    [h2 ?def with params]
    [?def shout :params [x] :body LOUD: [?=x]!]
    [?shout 'hi']
    [?def pair :params [a, b] :body [?=a]/[?=b]]
    [?pair 'left' 'right']
  ]

  [- 6. Lexical binding. labeled: NAME :be VALUE :return BODY.
     Array form: [?let [name, value, body]]. ]
  [section
    [h2 ?let]
    [?let v :be @price :return [?=v]]
    [?let [g, @name, [?=g]]]
  ]

  [- 7. FLWOR iteration over a node-sequence with all slots.
     :in (required), :where, :count, :order-by, :group-by, :return. ]
  [section
    [h2 ?for FLWOR]

    [- simple iteration ]
    [?for x :in //v :return [?=x/@sku];]

    [- filtered with :where ]
    [?for x :in //v :where x/@in > 0 :return [?=x/@s];]

    [- ordered ]
    [?for x :in //v :order-by x/@s :return [?=x/@s];]

    [- counted — bind 1-based position ]
    [?for x :in //v :count i :return [?=i]:[?=x/@s];]

    [- grouped — sum by key ]
    [?for x :in //v
       :group-by [k, x/@c]
       :return [g [?=k]:[?for y :in x :return [?=y/@n];]] ]
  ]

  [- 8. Windowing — tumbling and sliding windows over a sequence. ]
  [section
    [h2 Windowing]

    [- tumbling: non-overlapping size-N chunks ]
    [?for-tumbling w :in //v
       :size 2
       :return [?for x :in w :return [?=x/@n]];]

    [- sliding: overlapping size-N chunks, step-N apart ]
    [?for-sliding w :in //v
       :size 2 :step 1
       :return [?for x :in w :return [?=x/@n]];]
  ]

  [- 9. First-class functions, partial application, fn-ref, apply. ]
  [section
    [h2 Functions, partials, apply]

    [- inline fn, applied directly ]
    [?let dbl
       :be [?fn :params [n] :body [?=n][?=n]]
       :return [?=[?apply [dbl, 'X']]]]

    [- left-partial via fn-ref ]
    [?let greet
       :be [?partial [[?fn-ref [concat, 2]], 'Hello, ']]
       :return [?=[?apply [greet, @name]]]]

    [- middle placeholder via [?_] ]
    [?let f
       :be [?partial [[?fn-ref [concat, 2]], [?_], '!']]
       :return [?=[?apply [f, 'hi']]]]
  ]

  [- 10. Pattern matching. Array form with pattern, result pairs
     and [*, default] wildcard. ]
  [section
    [h2 ?match]
    [?match [@kind, [admin, A], [user, U], [*, ?]]]
  ]

  [- 11. Error handling. Array form with err-code patterns. ]
  [section
    [h2 ?try]
    [- catch by namespace prefix ]
    [?try [[?error ['FORG0006', 'wrong type']],
           [FOAR*, math],
           [FORG*, generic],
           [*, other]]]
    [- bind err-code to a name ]
    [?try [[?error ['FOAR0001', 'oops']], [?=err-code]]]
  ]

  [- 12. Sandboxed nested evaluation. ]
  [section
    [h2 ?eval]
    [?eval [?=//data/@name]]
  ]

  [- 13. Context shift — [?with [context, body]] re-roots queries. ]
  [section
    [h2 ?with]
    [?with [//data, [?=@name]]]
  ]

  [- 14. Filters (frozen v0.6 set). Composition by bracket nesting. ]
  [section
    [h2 Built-in filters]
    [?upper [@name]]
    [?join [', ', //tags]]
    [?upper [[?trim [@name]]]]
    [?escape-html [@user-input]]
  ]
]
