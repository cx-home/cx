[- vcore.cx — v0.8.0 core-grammar showcase.
   Demonstrates each non-trivial core feature in isolation so the test
   suite, format roundtrips, and binding parity tests have one canonical
   sample to exercise per feature. ]

[- 1. AUTO-ARRAY: 2+ homogeneous unquoted tokens become a typed array ]
[scores 10 20 30]
[temps -2.5 0.0 3.7 21.1]
[flags true false true]
[releases 2024-01-15 2025-03-01 2026-04-19]

[- 2. INFERRED-TYPE ARRAY: type inferred from tokens ]
[data ::[] 1 2.5 3]                     # all numeric → float[] after int/float promotion
[tags ::[] admin user guest]            # any string token → string[]

[- 3. TYPE ANNOTATIONS: ::int ::float ::bool ::string ::date ::datetime ]
[count ::int 42]
[ratio ::float 3.14]
[active ::bool true]
[label ::string 90210]
[launch ::date 2026-04-19]
[stamp ::datetime 2026-04-19T09:00:00Z]

[- 4. SIZED NUMERIC TYPES: width is part of the type ]
[port      ::u16    8080]
[tiny      ::u8     255]
[big       ::i64    -9_223_372_036_854_775_000]
[unsigned  ::u32    4_000_000_000]
[ratio32   ::f32    3.14]
[ratio64   ::f64    3.141_592_653_589_793]

[- 5. ARBITRARY-PRECISION NUMERIC: ::decimal, ::bigint ]
[balance   ::decimal  1234.56]
[user_id   ::bigint   1234567890123456789]
[microcoin ::decimal  0.000_000_01]      # eight zeros after the decimal

[- 6. NUMERIC UNDERSCORES: cosmetic separators in numeric literals ]
[heap_max  ::u64  16_777_216]            # 16 MiB
[heap_min  ::u64  4_096]
[pi_dig    ::f64  3.141_592_653_589_793]

[- 7. LEADING-ZERO TOKENS STAY STRINGS (leading-zero rule) ]
[zip       02134]                       # "02134" — not int 2134
[area      0420]                        # "0420" — not octal, not int
[hex       0xCAFE]                      # int — 0x prefix is not "leading zero"

[- 8. BOOLEAN ATTRIBUTES: explicit true / false ]
[server tls=true debug=false metrics=true host=0.0.0.0]

[- 9. TYPED TABLE: row-major in CX text, column-major in binary ]
[stocks [table[ticker::string price::f64 volume::u32]]
  AAPL 192.45 38291092
  GOOG 142.30 18234567
  MSFT 415.18 23456789
]

[- 10. TRIPLE-QUOTED STRINGS: ''' ... ''' — multiline, indent-stripped ]
[readme '''
  CX is a bracket-based format.
  It converts to XML, JSON, YAML, and TOML.
''']

[sql '''
  SELECT id, name, email
    FROM users
   WHERE active = true
   ORDER BY name
''']

[- 11. BLOCK CONTENT: [|...|] — parsed body with preserved newlines ]
[p [|
  Visit our [a href=https://example.com site] or
  read the [a href=https://docs.example.com docs].
|]]

[- 12. RAW TEXT: [#...#] — never parsed, preserves brackets and quotes ]
[code [#
  for (let i = 0; i < arr.length; i++) {
    console.log(arr[i]);
  }
#]]

[- 13. LINE COMMENTS: # to end-of-line, anywhere whitespace is allowed ]
[memory                                  # subsystem block
  [heap_initial ::u32 1_048_576]          # 1 MiB starting heap
  [heap_max     ::u32 16_777_216]         # 16 MiB cap
]
