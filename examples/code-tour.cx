[# code-tour.cx — comprehensive tour of the CX code language (v0.8.0).

   Covers every core directive + every v0.8.0 addition:
      1. [?fn]                 — lambdas
      2. [?def]                — named module-scope functions (ADR 0034)
      3. [?let]                — lexical binding
      4. [?if]                 — boolean branch
      5. [?for]                — iteration + pattern-generator (ADR 0028)
      6. [?match]              — multi-arm dispatch (ADR 0029)
      7. [?match] on [err]     — error recovery (§9.3)
      8. [?pipe] / |           — composition
      9. [?modify]             — pure-functional updates (ADR 0030)
     10. CXPath                — first-class path-value (ADR 0028)
     11. [expr] + $_           — general predicate (ADR 0036)
     12. [?lib] + [?const]     — module loading + constants (ADR 0035)
     13. Errors                — postfix ? and !
     14. Resilience            — [?retry], [?timeout], [?fallback]
     15. Services              — [?service], [?http-client]
     16. Concurrency           — [?channel], [?worker], [?select]
     17. Async                 — [?async], [?await], [?await-all]

   Run:
     cx eval examples/code-tour.cx
   Or with a sample document:
     cx eval examples/code-tour.cx --input examples/code-tour.input.cx #]


[tour version='0.8.0'

  [# ─── §1. Lambdas via [?fn] ─── #]

  [section title='lambdas'
    [?let $double = [?fn $x :body (* $x 2)] :in
      [example
        [input (1, 2, 3)]
        [output (map $double (1, 2, 3))]])]

  [# ─── §2. Module-scope functions via [?def] (ADR 0034) ─── #]

  [section title='module-scope functions ([?def])'
    [# Module-private by default; :scope public exports across modules.
       :pure (default) opts the function into the ADR 0034 D11
       purity algebra; :impure marks I/O / non-deterministic bodies. #]
    [?def shout
      :scope public
      :pure
      [$msg]
      :body (upper (concat $msg "!"))]

    [?def _internal-helper [$n] :body (+ $n 1)]

    [example
      [input "hello"]
      [output (shout "hello")]]]

  [# ─── §3. Lexical binding via [?let] ─── #]

  [section title='lexical binding'
    [?let $x = 10 :in
      [?let $y = (* $x 3) :in
        [example
          [bindings x=10 y=30]
          [result $y]]])]

  [# ─── §4. Boolean branch via [?if] ─── #]

  [section title='boolean branch'
    [?for $n :in 1 to 5
      :yield [?if (> $n 2)
               :then [classify $n 'big']
               :else [classify $n 'small']]]]

  [# ─── §5. Iteration via [?for] ─── #]

  [section title='iteration (basic)'
    [?for $n :in 1 to 3
      :yield [item index=$n]]]

  [section title='iteration (pattern-generator — ADR 0028 D8 replaces [?find])'
    [?for [user $u] :in //user
      :yield [profile name=($u/@name) email=($u/@email)]]]

  [section title='iteration with :where + :let + :order-by'
    [?for $u :in //user
      :where ($u/@active = true)
      :let $domain = (substring-after $u/@email "@")
      :order-by $domain
      :yield [active-user name=($u/@name) domain=$domain]]]

  [# ─── §6. Multi-arm match (ADR 0029) ─── #]

  [section title='multi-arm match'
    [?for $thing :in //thing
      :yield [?match $thing
        :case [user $_]    :yield [labeled kind='user'    node=$thing]
        :case [group $_]   :yield [labeled kind='group'   node=$thing]
        :case [service $_] :yield [labeled kind='service' node=$thing]
        :when (name($thing) = 'mystery') :yield [labeled kind='mystery']
        :else              :yield [labeled kind='other' name=(name($thing))]]]]

  [section title='scalar literal match (ADR 0029 D2)'
    [?for $code :in //response/@status
      :yield [?match $code
        :case 200 :yield 'ok'
        :case 404 :yield 'not-found'
        :case 500 :yield 'server-error'
        :else     :yield 'unknown']]]

  [# ─── §7. Error recovery via [?match] on the [err] channel ─── #]

  [section title='recover via [?match]'
    [?match
      [?for $n :in (1, 0, 2)
        :yield (/ 100 $n)]
      :case [err $err] :yield [recovered from-err=($err/@code)]
      :case $v :yield $v]]

  [# ─── §8. Pipe composition ─── #]

  [section title='pipe — left-to-right composition'
    //user
      | [?for $u :where ($u/@active = true) :yield $u]
      | [?for $u :yield ($u/@name)]
      | (sort)]

  [# ─── §9. Pure-functional updates (ADR 0030) ─── #]

  [section title='modify — :set on a single attribute'
    [?modify $doc //user[@id=1]/@name :set "Alice"]]

  [section title='modify — :delete with a predicate'
    [?modify $doc //user[@banned=true] :delete]]

  [section title='modify — :using a [?fn] lambda'
    [?modify $doc //user
      :using [?fn $u :body [user $u/@id (upper $u/@name)]]]]

  [section title='modify — pipeline of updates'
    $doc
      | [?modify //user/@status :set "verified"]
      | [?modify //user[@banned=true] :delete]
      | [?modify //section[@id="intro"] :append [para "Added."]]]

  [# ─── §10. CXPath value kind (ADR 0028) ─── #]

  [section title='cxpath — every axis worked'
    [examples
      [self      (//user[1]/self::user)]
      [child     (//section/child::para)]
      [descendant (//root/descendant::user)]
      [parent    (//user[1]/parent::*)]
      [ancestor  (//user[1]/ancestor::section)]
      [ancestor-or-self (//user[1]/ancestor-or-self::*)]
      [following-sibling (//user[1]/following-sibling::user)]
      [preceding-sibling (//user[2]/preceding-sibling::user)]
      [following (//user[1]/following::section)]
      [preceding (//section/preceding::user)]
      [attribute (//user[1]/attribute::*)]]]

  [# ─── §11. [expr] general predicate + $_ context (ADR 0036) ─── #]

  [section title='[expr] — atomic-predicate sugar (terse form)'
    [# Terse  [@active=true]  desugars to PredicateExpr  ($_@active = true).
       Both forms are equivalent at parse time. #]
    //user[@active=true]]

  [section title='[expr] — general predicate with $_ context binding'
    [# Inside any predicate, $_ is the candidate node.
       Use the general form when sugar can't express the test. #]
    //user[$_@active and $_@verified]]

  [section title='[expr] — nested predicate, $_ shadows innermost'
    [# Outer $_ is each team; inner $_ rebinds to each member. #]
    //team[count($_/member[$_/role = "lead"]) >= 1]]

  [section title='[expr] — $_position / $_last (1-based, no parens)'
    [examples
      [first-para  (//section/p[$_position = 1])]
      [last-para   (//section/p[$_position = $_last])]
      [rows-2-to-10 (//row[$_position >= 2 and $_position <= 10])]]]

  [section title='[expr] — :bind NAME for outer-scope reference across steps'
    [# $t carries the team through to the inner predicate, where $_
       has shadowed to the member. #]
    //team :bind $t / member[$_@role = "lead" and count($t/member) >= 3]]

  [# ─── §12. Modules via [?lib] + [?const] (ADR 0035) ─── #]

  [section title='[?lib] — three resolver shapes'
    [# Stdlib (bundled), HTTPS-with-SRI (via cx.lock), and relative file.
       Module-top-level only; not legal inside expressions. #]
    [?lib 'cx-stdlib/strings']
    [?lib 'cx-stdlib/json']
    [?lib 'github.com/example/regex-helpers' :as regex]
    [?lib './local-helpers.cx']]

  [section title='[?const] — eager (default) and :lazy'
    [?const GREETING "hello"]
    [?const :scope public PUBLIC-VERSION "1.0.0"]
    [?const PATTERN [regex/compile "^[a-z]+"]]
    [?const :lazy BIG-TABLE [load-big-table]]
    [example
      [eager (concat $GREETING ", world")]
      [public-exported PUBLIC-VERSION]]]

  [# ─── §13. Errors as values ─── #]

  [section title='postfix ? — default-propagate (documentation-only)'
    [?match
      (parse-int "not-a-number")?
      :case [err $err] :yield [err-handled $err]
      :case $v :yield $v]]

  [section title='postfix ! — escalate to hard error (catchable value-form)'
    [?match
      [err code="CXER0001" msg="synthetic"]!
      :case [err $err] :yield [escalated-and-caught $err]
      :case $v :yield $v]]

  [# ─── §14. Resilience directives ─── #]

  [section title='retry with exponential backoff'
    [?retry [http-get "https://flaky.example.org"]
      :max 5
      :strategy 'exponential'
      :base [duration 100 :ms]]]

  [section title='timeout + fallback composition'
    [?fallback
      [?timeout [http-get "https://slow.example.org"]
        :deadline [duration 250 :ms]
        :on-timeout 'cancel']
      :on-err [cached-response stale=true]]]

  [# ─── §15. Services ─── #]

  [section title='http service + client round-trip'
    [?service :on http :name "ping"
      [resource method=GET path="/ping"
        handler=[?fn $req :body [response status=200 body="pong"]]]]

    [?let $client = [?http-client :target "cx-service://ping"] :in
      $client | get("/ping")]]

  [# ─── §16. Concurrency ─── #]

  [section title='channel + worker pattern'
    [?channel :name "work" :buffer 16]

    [?worker :name "producer" :body
      [?for $i :in 1 to 10
        :yield [send channel="work" $i]]]

    [?worker :name "consumer" :body
      [?for $msg :in [receive channel="work"]
        :yield [processed $msg]]]

    [?wait-for :worker "producer"]
    [?wait-for :worker "consumer"]]

  [# ─── §17. Async + await ─── #]

  [section title='async + await + await-all'
    [?let $f1 = [?async [http-get "/a"]] :in
      [?let $f2 = [?async [http-get "/b"]] :in
        [?let $f3 = [?async [http-get "/c"]] :in
          [?await-all ($f1, $f2, $f3)]])]]

]
