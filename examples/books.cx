# Library catalogue as a [table[…]] block — typed columns declared once,
# rows as positional values. Column-major in binary form (5–10× smaller
# than element-per-row for large datasets); row-major in CX text for
# human reading.
#
# Try:  cx table info examples/books.cx
#       cx --csv examples/books.cx
#       cx examples/books.cx > /tmp/books.out.cx && cx eq examples/books.cx /tmp/books.out.cx

[; ISBNs stay strings even though the leading digit makes them look numeric ]
[books [table[title::string author::string year::int isbn::string available::bool]]
  'The Hobbit'        'J.R.R. Tolkien'     1937   '978-0547928227'   true
  'Dune'              'Frank Herbert'      1965   '978-0441172719'   false
  'Neuromancer'       'William Gibson'     1984   '978-0441569595'   true
  'Snow Crash'        'Neal Stephenson'    1992   '978-0553380958'   true
  'The Diamond Age'   'Neal Stephenson'    1995   '978-0553380965'   true
]

[; ad-hoc per-shelf tagging stays in element form, not the table ]
[shelf id=sci-fi-classics tags='hugo,nebula,canon']
