[?for a :in //agent :return
  [tr
    [td [?=a/@name]]
    [td [?=a/@email]]
    [td [?=a/@status]]
  ]
]
[tr id=replace-this-row
  [td colspan=3
    [button class=btn-primary
            hx-get=/agents?page=[?=@page]
            hx-target=#replace-this-row
            hx-swap=outerHTML
      Load More Agents
    ]
  ]
]
