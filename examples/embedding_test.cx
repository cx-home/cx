[doc title="Embedding Test"

  [- Demonstrates code blocks containing foreign-syntax content.
     Use [# ... #] (raw, never parsed) when the embedded code
     contains brackets or quotes; [| ... |] is for parsed-body
     content where you want CX to parse inline. ]

  [section
    [h1 Embedded JSON]
    [p Here is some JSON configuration:]
    [``` lang=json [#
{
  "name": "example",
  "version": "1.0.0",
  "enabled": true,
  "count": 42,
  "tags": ["cx", "test"]
}
    #]]
  ]

  [section
    [h2 Embedded Bash]
    [``` lang=bash [#
#!/bin/bash
for f in *.cx; do
  echo "Processing $f"
  cx --json "$f" > "dist/$(basename "$f" .cx).json"
done
    #]]
  ]

  [section
    [h3 Embedded Python]
    [``` lang=python [#
import cx

def parse_cx(path: str) -> dict:
    with open(path) as f:
        return cx.loads(f.read())

result = parse_cx("doc.cx")
print(result["title"])
    #]]
  ]

  [section
    [h4 Embedded YAML]
    [``` lang=yaml [#
server:
  host: localhost
  port: 8080
  debug: false
features:
  - auth
  - logging
    #]]
  ]
]
