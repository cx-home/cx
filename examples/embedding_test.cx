[doc title="Embedding Test"

  [- Demonstrates code blocks containing foreign-syntax content.
     Use [# ... #] (raw text, never parsed) when the embedded code
     contains brackets or quotes; the lang attr drives tree-sitter
     injection / syntax highlighting of the embedded source. ]

  [section
    [h1 Embedded JSON]
    [p Here is some JSON configuration:]
    [pre [code lang=json [#
{
  "name": "example",
  "version": "1.0.0",
  "enabled": true,
  "count": 42,
  "tags": ["cx", "test"]
}
#]]]
  ]

  [section
    [h2 Embedded Bash]
    [pre [code lang=bash [#
#!/bin/bash
for f in *.cx; do
  echo "Processing $f"
  cx --json "$f" > "dist/$(basename "$f" .cx).json"
done
#]]]
  ]

  [section
    [h3 Embedded Python]
    [pre [code lang=python [#
import cx

def parse_cx(path: str) -> dict:
    with open(path) as f:
        return cx.loads(f.read())

result = parse_cx("doc.cx")
print(result["title"])
#]]]
  ]

  [section
    [h4 Embedded YAML]
    [pre [code lang=yaml [#
server:
  host: localhost
  port: 8080
  debug: false
features:
  - auth
  - logging
#]]]
  ]
]
