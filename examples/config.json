{
  "server": {
    "host": "0.0.0.0",
    "tls": true,
    "debug": false,
    "port": 8080,
    "workers": 4,
    "max_request_bytes": 1048576,
    "allowed_origins": [
      "https://example.com",
      "https://app.example.com"
    ]
  },
  "database": {
    "host": "localhost",
    "name": "myapp",
    "ssl": false,
    "port": 5432,
    "pool_size": 10,
    "statement_timeout_ms": 30000
  },
  "logging": {
    "level": "info",
    "file": "/var/log/app.log",
    "rotate_at_hour": "03"
  }
}