[; cxstore.service.cx — the store daemon config for the client-server demo.
   The store wire is the XSP store profile (THE CX-to-CX store wire): the
   daemon holds a private mem:// store and serves it over cx-store+xsp://.
   floor policy admits an anonymous client as "guest" — data ops are open,
   so the client needs no identity for this demo (a production deployment
   names [grants …] and the client presents an xsp-did; see store.md §6.4).
   The bootstrap HTTP surface (health/ready) rides [bind]. ]
[cxstore-service
  [bind addr="127.0.0.1:18900"]
  [stores
    [store name="teststore" url="mem://client-server-example"]]
  [xsp enabled=true addr="127.0.0.1:18901"
    [identity did="did:key:z6MkiaMbhXHNA4eJVCCj8dbzKzTgYDKf6crKgHVHid1F1WCT"
      seed-env="CX_CLIENT_SERVER_EXAMPLE_SEED"]
    [policy mode=floor floor="guest"]]]
