# media.cx — an uploaded image's derivatives, stored by their content and
# served so a CDN in front can cache them forever (cx-home/cx-core-code#112:
# "derivatives stored content-addressed in the store and served behind the
# CDN"; RULED: STREAM-1).
#
#   1. The upload (a 16x16 PNG, inline so the scenario carries no binary file)
#      becomes two derivatives in one cx-stdlib/image pass each: a 64-wide
#      WebP avatar and an 8x8 JPEG thumbnail, cover-cropped.
#   2. Each is put in the store by $store:put-blob — its key IS the hash of
#      its bytes, so the same derivative is the same key on every node and
#      a changed one is a new key.
#   3. GET /media/<hash>.<ext> (the key's SHA-256 hex and the format's
#      extension) answers get-blob's bytes byte-exact with
#      ETag "<hash>" and Cache-Control: public, max-age=31536000, immutable:
#      the URL names the content, so nothing behind it can ever change, and a
#      cache (the CDN, the browser) may keep it for a year without asking.
#      A request carrying If-None-Match: "<hash>" is 304 with no body; a hash
#      the store does not hold, or the wrong extension for it, is 404.
#   4. GET /index lists the two derivatives' URLs, which is what an upload
#      handler would hand back to the client.
[?lib 'cx-stdlib/image']
[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/strings']
[?lib 'cx-stdlib/map']
[?lib 'cx-platform/store']

[?def upload [returns bytes] () ::bytes]

[?def hex-of [returns string] ($key::string) [$strings:replace $key 'sha2-256:' '']]

[?def cache-headers [returns element] ($hex::string $type::string)
  [?let [= $etag [$concat '"' $hex '"']]
    [headers [header name='Content-Type' value=$type]
             [header name='ETag' value=$etag]
             [header name='Cache-Control' value='public, max-age=31536000, immutable']]]]

[?def if-none-match [returns string] ($request::any)
  [$string [?else [$first [?for [in $h $request/headers/header]
                              [where [= [$strings:lower [$string $h@name]] 'if-none-match']]
                              [yield [$string $h@value]]]] '']]]

[?def media impure [returns element] ($request::any $store::element $types::map)
  [?let [= $file [$string $request/path-params/file]]
        [= $type [?else [$map:get $types $file] '']]
        [= $hex  [$first [$strings:split $file '.']]]
    [?if [= $type '']
      [then [response status=404 [body 'no such derivative']]]
      [else [?if [= [$if-none-match $request] [$concat '"' $hex '"']]
        [then [response status=304 [$cache-headers $hex $type]]]
        [else [response status=200 [$cache-headers $hex $type]
                [body [$store:get-blob $store [$concat 'sha2-256:' $hex]]]]]]]]]]

[?let
  [= $port   [$env:flag [$env:parse-args [argspec [flag name=port type=int default=8796]]] 'port']]
  [= $store  [$store:open 'mem://']]
  [= $avatar [$image:derive [$upload] [derive format=webp quality=80 [resize width=64]]]]
  [= $thumb  [$image:derive [$upload] [derive format=jpeg quality=85 [resize width=8 height=8 fit=cover]]]]
  [= $ka     [$store:put-blob $store $avatar]]
  [= $kt     [$store:put-blob $store $thumb]]
  [= $fa     [$concat [$hex-of $ka] '.webp']]
  [= $ft     [$concat [$hex-of $kt] '.jpg']]
  [= $types  {[?entry $fa 'image/webp'] [?entry $ft 'image/jpeg']}]
  [= $_b     [$env:write-line [$concat 'media: serving 2 derivatives on 127.0.0.1:' [$string $port]]]]
  [?http-service on=http port=$port name=media
    [bind-host '127.0.0.1']
    [block true]
    [resource [get '/health'] [response status=200 [body 'ok']]]
    [resource [get '/index']
      [response status=200 [headers [header name='Content-Type' value='text/plain']]
        [body [$concat '/media/' $fa '\n/media/' $ft '\n']]]]
    [resource [get '/media/:file'] [$media $request $store $types]]]]
