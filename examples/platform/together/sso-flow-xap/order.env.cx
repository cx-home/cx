# The ENV program for the composed run: the same acts module the flow
# example uses, reached from here.
#
# A relative [?lib] path resolves against the WORKING DIRECTORY, so this
# reads the checkout example's orders.cx and run.sh runs from this directory.
# The acts are not copied — one module, two scenarios. Since the extraction
# (RULED: RS-12) that example is cx-platform-flow's, so the path reaches it in
# the checkout deps.cxd pins, deps/cx-platform-flow/.
[?lib '../../../../deps/cx-platform-flow/examples/platform/flow/checkout/orders.cx' :as orders]

[acts of='../../../../deps/cx-platform-flow/examples/platform/flow/checkout/checkout.flow.cx'
  [act name='orders/check-order'   does='refuse an empty sku or a non-positive quantity']
  [act name='orders/price-order'   does='quantity x unit price']
  [act name='orders/confirm-order' does='the confirmation record']]
