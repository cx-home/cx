[- Deployment environments using anchors and merges. ]
[- Idioms: sized types, boolean sigils, numeric underscores. ]

[- shared baseline once with an anchor; ports use sized u16 ]
[defaults &base host=localhost -ssl +debug
  [port :u16 8080]
  [timeout_s :u16 30]
  [retries :u8 3]
  [max_connections :u16 10]
  [log_level info]
]

[- each environment merges base and overrides only what differs ]
[dev *base
  [log_level debug]
]

[staging *base host=staging.acme.com +ssl -debug
  [port :u16 443]
]

[prod *base host=acme.com +ssl -debug
  [port :u16 443]
  [retries :u8 5]
  [timeout_s :u16 60]
  [max_connections :u16 50]
]

[- canary mirrors prod but accepts a much higher connection cap ]
[canary *base host=canary.acme.com +ssl -debug
  [port :u16 443]
  [max_connections :u16 1_000]   # 1k — readable thanks to underscore
  [timeout_s :u16 120]
]
