[; Walk a graph held as a DOCUMENT: the edges are elements, and traversal is a
   path query plus a shape-matching comprehension — no adjacency list is built,
   because the document already is one.
   Rewritten for the v0.8.0 surface (RULED: VC-28); the original was
   pre-reshape (`[?let $x = … :in]`, `@from=$f` inside a `:in`/`:yield` for). ]
[?let [= $graph [g
                  [edges from=A to=B] [edges from=A to=C]
                  [edges from=B to=D] [edges from=C to=D]
                  [edges from=D to=E]]]
  [?for [in $e $graph//edges]
    [yield [edge $e@from $e@to]]]]
