[?lib 'cx-stdlib/url']
[?lib 'cx-stdlib/csv']
[?lib 'cx-stdlib/validate']

[?const LEAD_SCHEMA [schema
  [field :name "email"      :type "string" :pattern ".+@.+\..+"]
  [field :name "first_name" :type "string" :min-length 1]
  [field :name "last_name"  :type "string" :min-length 1]
  [field :name "score"      :type "int"    :min 0 :max 100]]]

[?def fetch-leads
  :scope public
  :returns [sequence element]
  (csv-url:string)
  [?let $parsed-url = [url/parse $csv-url] :in
   [?http-client :method "GET" :url (url/build $parsed-url) :yield-body $body :in
    [csv/parse $body]]]]

[?def validate-lead
  :pure
  :returns element
  (row:element)
  [validate/validate-shape $row :against LEAD_SCHEMA]]

[?def count-valid-leads
  :scope public
  :returns int
  (csv-url:string)
  [?let $rows = [fetch-leads $csv-url] :in
   [count [?for $row :in $rows
           :where (validate/is-ok (validate-lead $row))
           :yield $row]]]]

[count-valid-leads "https://crm.example.com/exports/leads.csv"]
