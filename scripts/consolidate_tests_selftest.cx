# consolidate_tests_selftest.cx — proves the #700 driver's absorb restore on a
# SYNTHETIC repo (mktemp; never the tracked tree — the same rule the
# spec-freeze-gate self-test follows). `absorb` strips the COMMITTED
# umbrella's generated header IN PLACE before it generates; the driver's own
# sentence is "Never leave a half-absorbed umbrella behind", and these cases
# are that sentence, executable. Four scenarios, every one against a copy of
# the live scripts/consolidate_tests.sh:
#   A  CX_BIN names a path that does not exist   → MUST exit non-zero AND
#      leave the committed umbrella byte-identical   (#1392, the measured
#      defect: `absorb` before vcx/target/cx was built left the committed
#      umbrella header-stripped, because `set -e` exits past the two explicit
#      restore calls and the EXIT trap only removed the scratch dir)
#   B  CX_BIN exists but the generator FAILS      → same two assertions (the
#      class A's cheap pre-flight cannot see; only the EXIT trap closes it)
#   C  the generator breaks the test-fn equivalence gate → same two assertions
#      (the explicit-failure path that always restored; the regression guard
#      on folding those calls into the trap)
#   D  a generator and a compiler that both succeed → absorb COMPLETES: the
#      umbrella is the newly generated one, the absorbed row is rewritten
#      `#absorbed`, the original is gone. The guard that the restore-on-exit
#      never runs on the success path.
# CXMACH-1 (owner 2026-10-16, (a)): the cx rewrite of consolidate_tests_selftest.sh — the same
# synthetic repo and the same five scenarios against a copy of the live driver; the planted
# generators and the planted compiler are cx programs (a #! line naming the cx running this
# selftest) that write what the shell fakes wrote, the same lines on the same streams, the same
# exits.
#   $(TOOL_CX) --allow-all scripts/consolidate_tests_selftest.cx

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/strings' as=strings]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$env:write-line $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def die scope=public impure ($t $s) [?let [= $_ [?if [= $s ''] [then null] [else [$cry $s]]]] [= $_x [?else [$io:remove-tree $t] null]] [$env:exit 1]]]
[?def run scope=public impure ($cwd $argv $env)
  [?let [= $r [$process:run $argv cwd=$cwd env=$env capture=:both]]
    [?match $r [case [err$e] [res rc=127 out='' err=[$string $e]]] [else [res rc=$r@exit-code out=[$string $r@stdout] err=[$string $r@stderr]]]]]]
[?def git scope=public impure ($repo $args) [$run $repo ('git', [?splice $args]) {}]]
[?def put scope=public impure ($p $s) [?let [= $_d [$io:make-dirs [$path:dirname $p]]] [$io:write-file $p $s]]]

# The planted generator: for each roster line (read as `while read` reads them), the umbrella
# itself carried through and every other input stamped `// ── source: <f> ──`; EQFAIL drops each
# `fn test_` line of a new input (the equivalence gate's in != out).
[?def FAKE-GEN scope=public ($cx $eqfail)
  [$cat ('#!', $cx, " --allow-all\n",
         "[?lib 'cx-stdlib/io' as=io]\n[?lib 'cx-stdlib/env' as=env]\n[?lib 'cx-stdlib/strings' as=strings]\n",
         "[?const ARG_SPEC [argspec [flag name=\"allow-read\" type=bool] [flag name=\"allow-write\" type=bool] [flag name=\"allow-env\" type=bool]]]\n",
         "[?let [= $m [$env:var-or-default 'MANIFEST' '']] [= $t [?else [$io:read-file $m] '']] [= $ls [$strings:split $t \"\\n\"]]\n",
         "      [= $rows [?if [$strings:ends-with $t \"\\n\"] [then [?to-sequence [?for [in $i [$range 1 [- [$count $ls] 1]]] [yield [$nth $ls $i]]]]] [else [?to-sequence [?for [in $i [$range 1 [- [$count $ls] 1]]] [yield [$nth $ls $i]]]]]]]\n",
         "      [= $body [$strings:join [?to-sequence [?for [in $f $rows]\n",
         "        [yield [?if [$strings:ends-with $f '_umbrella_test.v'] [then [?else [$io:read-file $f] '']]\n",
         "                 [else [$strings:join ([$strings:join ('// ── source: ', $f, ' ──\\n') ''], ",
         [?if $eqfail
           [then "[$strings:join [?to-sequence [?for [in $l [$strings:split [?else [$io:read-file $f] ''] \"\\n\"]] [where [not [$strings:starts-with $l 'fn test_']]] [yield $l]]] \"\\n\"]"]
           [else "[?else [$io:read-file $f] '']"]],
         ") '']]]]]] '']]\n",
         "  [?do [$io:write-file [$env:var-or-default 'OUT' '/dev/null'] [$strings:join ('// ', [$env:var-or-default 'AREA' ''], '_umbrella_test.v -- GENERATED by scripts/consolidate_tests.sh (#700):\\n// Manifest:   ', [$env:var-or-default 'MANIFEST_LABEL' ''], '\\n\\n', $body) '']] [$env:exit 0]]]\n")]]
[?def FAKE-EXIT scope=public ($cx $rc) [$cat ('#!', $cx, " --allow-all\n[?lib 'cx-stdlib/env' as=env]\n[$env:exit ", [$string $rc], "]\n")]]

[?let
  [= $here [$path:dirname [$path:absolute [$nth [$env:argv] 1]]]]
  [= $driver [$cat ($here, '/consolidate_tests.sh')]]
  [= $self-cx [$string [$env:executable-path]]]
  [= $t [$string [$io:temp-dir 'consolidate_selftest.']]]
  [= $bin [$cat ($t, '/bin')]] [= $repo [$cat ($t, '/repo')]]
  [= $_mk [$io:make-dirs $bin]] [= $_mr [$io:make-dirs $repo]]
  [= $umbrella 'vcx/tests/demo_umbrella_test.v'] [= $manifest 'scripts/consolidation/demo.files'] [= $pending 'vcx/tests/demo_b_test.v']
  [= $at [?fn ($p) [$cat ($repo, '/', $p)]]]
  [= $_g1 [$git $repo ('init', '-q', '.')]] [= $_g2 [$git $repo ('config', 'user.email', 't@t')]] [= $_g3 [$git $repo ('config', 'user.name', 't')]]
  [= $_d [$io:make-dirs [$at 'vcx/target']]]
  [= $_c [$put [$at 'scripts/consolidate_tests.sh'] [$io:read-file $driver]]]
  [= $_p [$io:write-file [$at 'scripts/consolidate_tests.sh'] [$io:read-file $driver]]]
  [= $_m [$put [$at $manifest] "# demo area for the self-test\n#absorbed vcx/tests/demo_a_test.v\nvcx/tests/demo_b_test.v\n"]]
  [= $_u [$put [$at $umbrella] "// demo_umbrella_test.v -- GENERATED by scripts/consolidate_tests.sh (#700):\n// the per-area test-binary umbrella. 1 source file merged verbatim.\n// Regenerate: scripts/consolidate_tests.sh gen demo\n// Manifest:   scripts/consolidation/demo.files\n\n// ── source: vcx/tests/demo_a_test.v ──\nmodule main\n\nfn test_a() {\n\tassert true\n}\n"]]
  [= $_q [$put [$at $pending] "module main\n\nfn test_b() {\n\tassert true\n}\n"]]
  [= $_s1 [$git $repo ('add', '-A')]] [= $_s2 [$git $repo ('commit', '-qm', 'seed the demo area')]]
  [= $committed [$strings:trim-end-chars [$git $repo ('rev-parse', [$cat ('HEAD:', $umbrella)])]@out "\n"]]
  [= $_f1 [$io:write-file [$cat ($bin, '/cx-ok')] [$FAKE-GEN $self-cx false]]]
  [= $_f2 [$io:write-file [$cat ($bin, '/cx-eqfail')] [$FAKE-GEN $self-cx true]]]
  [= $_f3 [$io:write-file [$cat ($bin, '/cx-err')] [$FAKE-EXIT $self-cx 3]]]
  [= $_f4 [$io:write-file [$cat ($bin, '/v')] [$FAKE-EXIT $self-cx 0]]]
  [= $_ch [$run $bin ('chmod', '+x', 'cx-ok', 'cx-eqfail', 'cx-err', 'v') {}]]
  [= $path [$cat ($bin, ':', [$env:var-or-default 'PATH' ''])]]
  [= $absorb [?fn ($cxbin) [$run $repo ('bash', 'scripts/consolidate_tests.sh', 'absorb', 'demo') {PATH: $path, CX_BIN: $cxbin}]]]
  [= $untouched [?fn ($case $rc)
    [?if [= $rc 0] [then [$die $t [$cat ('SELFTEST FAILED: scenario ', $case, ' — absorb exited 0 with a generator that could not have produced an umbrella')]]]
      [else [?if [not [= [$strings:trim-end-chars [$git $repo ('rev-parse', [$cat ('HEAD:', $umbrella)])]@out "\n"] $committed]]
              [then [$die $t [$cat ('SELFTEST FAILED: scenario ', $case, " — the self-test's own committed umbrella moved")]]]
        [else [?if [not [= [$git $repo ('diff', '--quiet', '--', $umbrella)]@rc 0]]
                [then [?let [= $_1 [$cry [$cat ('SELFTEST FAILED (#1392): scenario ', $case, ' — absorb exited ', [$string $rc], ' and left the COMMITTED ', $umbrella, ' modified:')]]]
                            [= $_2 [$io:write-string [$env:stderr] [$git $repo ('--no-pager', 'diff', '--stat', '--', $umbrella)]@out]]
                            [= $dl [$strings:split [$git $repo ('--no-pager', 'diff', '--', $umbrella)]@out "\n"]]
                            [= $_3 [$io:write-string [$env:stderr] [$cat [?to-sequence [?for [in $i [$range 1 [?if [> [$count $dl] 20] [then 20] [else [- [$count $dl] 1]]]]] [yield [$cat ([$nth $dl $i], "\n")]]]]]]]
                        [$die $t '']]]
          [else [?let [= $st [$git $repo ('status', '--porcelain')]@out]
                  [?if [= $st ''] [then null]
                    [else [?let [= $_1 [$cry [$cat ('SELFTEST FAILED: scenario ', $case, ' — absorb exited ', [$string $rc], ' and left the tree dirty:')]]]
                                [= $_2 [$io:write-string [$env:stderr] $st]]
                            [$die $t '']]]]]]]]]]]]]
  # A — CX_BIN that does not exist; B — the generator fails; C — the equivalence gate refuses
  [= $_a [$untouched 'A' [$absorb [$cat ($bin, '/does-not-exist-cx')]]@rc]]
  [= $_b [$untouched 'B' [$absorb [$cat ($bin, '/cx-err')]]@rc]]
  [= $_cc [$untouched 'C' [$absorb [$cat ($bin, '/cx-eqfail')]]@rc]]
  # D — the success path: absorb must COMPLETE, and the restore must not run
  # its output goes to one log as > absorb.log 2>&1 wrote it: both streams in arrival order
  [= $alog [$cat ($t, '/absorb.log')]]
  [= $rd [?let [= $r [$process:run ('bash', 'scripts/consolidate_tests.sh', 'absorb', 'demo') cwd=$repo env={PATH: $path, CX_BIN: [$cat ($bin, '/cx-ok')]}
                                   capture={stdout: {append: $alog}, stderr: :stdout}]]
           [res rc=[?match $r [case [err$e] 127] [else $r@exit-code]] out=[?else [$io:read-file $alog] ''] err='']]]
  [= $_d1 [?if [= $rd@rc 0] [then null]
            [else [?let [= $_1 [$cry [$cat ('SELFTEST FAILED: scenario D — a working absorb exited ', [$string $rd@rc], ':')]]]
                        [= $_2 [$io:write-string [$env:stderr] [$cat ($rd@out, $rd@err)]]]
                    [$die $t '']]]]]
  [= $_d2 [?if [= [$git $repo ('diff', '--quiet', '--', $umbrella)]@rc 0]
            [then [$die $t [$cat ('SELFTEST FAILED: scenario D — a successful absorb left ', $umbrella, ' at its committed bytes (the restore ran on the success path)')]]] [else null]]]
  [= $ul [$strings:split [?else [$io:read-file [$at $umbrella]] ''] "\n"]]
  [= $_d3 [?if [and [> [$count [?for [in $l $ul] [where [$strings:starts-with $l 'fn test_a']] [yield 1]]] 0] [> [$count [?for [in $l $ul] [where [$strings:starts-with $l 'fn test_b']] [yield 1]]] 0]]
            [then null] [else [$die $t 'SELFTEST FAILED: scenario D — the absorbed umbrella does not carry both sections']]]]
  [= $_d4 [?if [> [$count [?for [in $l [$strings:split [?else [$io:read-file [$at $manifest]] ''] "\n"]] [where [= $l [$cat ('#absorbed ', $pending)]]] [yield 1]]] 0]
            [then null] [else [$die $t 'SELFTEST FAILED: scenario D — the manifest row was not rewritten as history']]]]
  [= $_d5 [?if [$io:exists [$at $pending]] [then [$die $t 'SELFTEST FAILED: scenario D — the absorbed original is still in the tree']] [else null]]]
  # E — the REAL generator hoists a file-level attribute above the umbrella's one module clause
  [= $gen-cx [$env:var-or-default 'CX_BIN' [$cat ([$path:dirname $here], '/deps/cx-core-code/vcx/target/cx')]]]
  [= $gen [$cat ($here, '/consolidate_tests.cx')]]
  [= $exe [and [$io:exists $gen-cx] [= [$strings:slice [$string [$io:stat $gen-cx]@permissions] 3 3] 'x']]]
  [?if $exe
    [then [?let [= $gd [$cat ($t, '/gen')]] [= $_m [$io:make-dirs $gd]]
                [= $_1 [$io:write-file [$cat ($gd, '/p_test.v')] "module main\n\nimport os\n\nfn test_p() {\n\tassert os.args.len > 0\n}\n"]]
                [= $_2 [$io:write-file [$cat ($gd, '/q_test.v')] "@[has_globals]\nmodule main\n\n__global (\n\tq_count int\n)\n\nfn test_q() {\n\tq_count++\n\tassert q_count == 1\n}\n"]]
                [= $_3 [$io:write-file [$cat ($gd, '/roster.files')] [$cat ($gd, "/p_test.v\n", $gd, "/q_test.v\n")]]]
                [= $r [$run [$env:cwd] ($gen-cx, '--allow-read', '--allow-write', '--allow-env', $gen)
                         {MANIFEST: [$cat ($gd, '/roster.files')], MANIFEST_LABEL: 'demo', OUT: [$cat ($gd, '/out.v')], AREA: 'demo'}]]
                [= $_4 [?if [= $r@rc 0] [then null] [else [$die $t 'SELFTEST FAILED: scenario E — the generator failed on two plain inputs']]]]
                [= $ol [$strings:split [?else [$io:read-file [$cat ($gd, '/out.v')]] ''] "\n"]]
                [= $sig [?to-sequence [?for [in $l $ol] [where [and [not [$strings:starts-with $l '//']] [not [$re:matches [$re:compile '^[[:space:]]*$'] $l]]]] [yield $l]]]]
                [= $first [$cat [?to-sequence [?for [in $i [$range 1 [?if [> [$count $sig] 2] [then 2] [else [$count $sig]]]]] [yield [$cat ([$nth $sig $i], '|')]]]]]]
                [= $_5 [?if [= $first '@[has_globals]|module main|'] [then null]
                         [else [$die $t [$cat ("SELFTEST FAILED: scenario E — the umbrella opens with '", $first, "', not '@[has_globals]|module main|'")]]]]]
                [= $_6 [?if [= [$count [?for [in $l $ol] [where [$strings:starts-with $l '@[has_globals]']] [yield 1]]] 1] [then null]
                         [else [$die $t 'SELFTEST FAILED: scenario E — @[has_globals] appears more than once (left in its section as well)']]]]
                [= $_x [?else [$io:remove-tree $t] null]]
                [= $_s [$say 'consolidate-tests selftest: 5/5 (missing CX_BIN, generator failure, equivalence failure — each non-zero with the committed umbrella intact; a working absorb completes; the generator hoists a file-level attribute)']]
            [$env:exit 0]]]
    [else [?let [= $_x [?else [$io:remove-tree $t] null]]
                [= $_s [$say [$cat ('consolidate-tests selftest: 4/4 (missing CX_BIN, generator failure, equivalence failure — each non-zero with the committed umbrella intact; a working absorb completes) — scenario E SKIPPED: no cx at ', $gen-cx)]]]
            [$env:exit 0]]]]]
