# scripts/public_history_replace_selftest.cx — the fixture for
# scripts/public_history_replace.cx (#1669, RULED: D83a, RS-33, CXF-8), beside
# the script per AGENTS.md rule 2 (a fixture nothing runs is a liability) and
# wired the way #1675's check-vcache-soundness-selftest was: its own Makefile
# target `check-public-history-replace` (below), in TEST_TARGETS, classified
# in scripts/test_changed.sh's step_globs(). A scratch world of real git
# repositories under a fresh per-run `$io:temp-dir` root (removed at the end
# of the run, success or failure — the same unconditional-cleanup idiom
# _gate_evidence/pipeline_rs33_pass/strip_attribution_fixture.cx (K12b) used,
# whose shape this fixture otherwise follows), run through the tool with the
# real `cx` binary and the real `git-filter-repo`, each case checking exit
# code and stdout/stderr text.
#
#   cx --allow-all scripts/public_history_replace_selftest.cx <abs cx> <abs tool> <abs strip-tool> <abs replacements-file>
#   (the Makefile target below supplies all four; `make check-public-history-replace`)
#
# Exit 0 every case held, 1 a case failed (each case prints its own line).

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]

[?def say scope=private impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cat scope=private pure ($parts) [$strings:join $parts '']]

[?def literal scope=private pure ()
  [$cat ("ghp_", "abcdefghijklmnopqrstuvwxyz012345")]]

# The other two shapes scripts/public_history_replacements.txt carries,
# needed by world-d below (PUBFIX-1's self-match regression) to prove the
# real file still redacts all three after the fix, not only the ghp_ one
# `literal` above already exercised. Split the same way `literal` is (and the
# way scripts/check_no_ai_attribution.cx's own patterns are, per that
# comment): this .cx file is itself a tracked, scanned file, and a whole
# shape sitting contiguously in ITS OWN source would trip secrets-scan the
# moment it looked at this fixture. `xoxb-` is its own argument so the
# literal "xoxb-" text is never immediately followed, in this file's own
# bytes, by ten-or-more characters `[A-Za-z0-9-]` (`rx-slack`'s own
# threshold in scripts/secrets_scan.cx) — the digits/letters that make up
# the rest of the shape can sit in the next argument unsplit, because the
# pattern can never anchor there without the "xoxb-" immediately before it.
[?def akia-literal scope=private pure ()
  [$cat ("AKIA", "ABCDEFGHIJKLMNOP")]]

[?def xoxb-literal scope=private pure ()
  [$cat ("xoxb-", "1234567890-1234567890123-abcdefghijklmnopqrstuvwx")]]

[?def trailer scope=private pure ()
  [$cat ("Co-Authored-By", ":", " Claude <", "noreply", "@", "anthropic.com>")]]

[?def ident scope=private pure ()
  ("-c", "user.name=fixture", "-c", "user.email=fixture@example.invalid",
   "-c", "commit.gpgsign=false", "-c", "tag.gpgsign=false")]

[?def git scope=private impure ($dir::string $argv)
  [?let [= $r [$process:run ("git", "-C", $dir, [?splice [$ident]], [?splice $argv])]]
    [$strings:trim [$string $r@stdout]]]]

# git-raw: same, but UNTRIMMED — `git` above trims (fine for a sha or a
# count), but PUBFIX-1's own byte-identical assertion needs the exact blob,
# trailing newline and all; trimming it would let a trailing-byte drift pass.
[?def git-raw scope=private impure ($dir::string $argv)
  [?let [= $r [$process:run ("git", "-C", $dir, [?splice [$ident]], [?splice $argv])]]
    [$string $r@stdout]]]

[?def write-commit scope=private impure ($root::string $file::string $content::string $msg::string)
  [?let
    [= $_w [$io:write-file [$cat ($root, "/", $file)] $content]]
    [= $_a [$git $root ("add", $file)]]
    [= $_c [$git $root ("commit", "-q", "-m", $msg)]]
    [$git $root ("rev-parse", "HEAD")]]]

[?def rm-commit scope=private impure ($root::string $file::string $msg::string)
  [?let
    [= $_r [$git $root ("rm", "-q", $file)]]
    [= $_c [$git $root ("commit", "-q", "-m", $msg)]]
    [$git $root ("rev-parse", "HEAD")]]]

# world A/B: `src` — a seed commit, a HISTORICAL commit whose blob carries
# the planted `ghp_` literal, then a commit that removes that file — so the
# TIP's tree never names the affected blob and the rewrite's tree check
# (equal before/after) has something real to prove.
[?def world-ab scope=private impure ($root::string)
  [?let
    [= $src [$cat ($root, "/src")]]
    [= $_i [$process:run ("git", "init", "-q", "-b", "main", $src)]]
    [= $c1 [$write-commit $src "a.txt" "seed\n" "seed"]]
    [= $c2 [$write-commit $src "secret.txt" [$cat ("token ", [$literal], " here\n")] "oops: a secret-shaped literal"]]
    [= $c3 [$rm-commit $src "secret.txt" "remove it"]]
    [w src=$src c1=$c1 c2=$c2 c3=$c3]]]

# world C: a `src2` carrying BOTH an RS-33 attribution trailer (commit c2)
# AND the planted literal (commit c3, later removed at the tip like world
# A/B) — run through strip_attribution.cx first, into work=, then through
# public_history_replace.cx over the SAME work= with no source: override,
# proving the second pass reuses the first pass's mirror (the message strip
# already applied) instead of re-cloning the untouched source.
[?def world-c scope=private impure ($root::string)
  [?let
    [= $src [$cat ($root, "/src2")]]
    [= $_i [$process:run ("git", "init", "-q", "-b", "main", $src)]]
    [= $c1 [$write-commit $src "a.txt" "seed\n" "seed"]]
    [= $c2 [$write-commit $src "b.txt" [$cat ("second\n\n", [$trailer])] "second"]]
    [= $c3 [$write-commit $src "secret.txt" [$cat ("token ", [$literal], " here\n")] "oops"]]
    [= $c4 [$rm-commit $src "secret.txt" "remove it"]]
    [w src=$src c1=$c1 c2=$c2 c3=$c3 c4=$c4]]]

# world-d: PUBFIX-1's own regression (Letter 56 = (a), 2026-09-27; D83a,
# RS-33, #1669, CXF-8) — a repo whose history TRACKS the REAL, shipped
# scripts/public_history_replacements.txt (read from $repl-abs, the exact
# file the Makefile hands this fixture, not a synthetic stand-in), proving
# the expressions file survives its own pass byte-identical, and a SEPARATE
# blob carrying all three shapes, proving the pass still redacts every one
# of them in the same run. Run against the head as it stood before the fix,
# this is RED (REFRESH-4's measurement, reproduced): the tracked
# replacements file's own historical blob comes back rewritten, not
# byte-identical, because each of its three literal rows is, tautologically,
# present verbatim in that very row's own tracked bytes.
[?def world-d scope=private impure ($root::string $repl-abs::string)
  [?let
    [= $src [$cat ($root, "/src3")]]
    [= $_i [$process:run ("git", "init", "-q", "-b", "main", $src)]]
    [= $repl-content [$io:read-file $repl-abs]]
    [= $c1 [$write-commit $src "a.txt" "seed\n" "seed"]]
    [= $c2 [$write-commit $src "public_history_replacements.txt" $repl-content
             "carry the real replacements file into history (PUBFIX-1 self-match regression)"]]
    [= $planted [$cat ("xoxb: ", [$xoxb-literal], "\nakia: ", [$akia-literal], "\nghp: ", [$literal], "\n")]]
    [= $c3 [$write-commit $src "secret.txt" $planted "oops: all three shapes"]]
    [= $c4 [$rm-commit $src "secret.txt" "remove it"]]
    [w src=$src c1=$c1 c2=$c2 c3=$c3 c4=$c4 repl-content=$repl-content]]]

[?def run-tool scope=private impure ($cx::string $tool::string $cwd::string $args)
  [?let [= $r [$process:run ($cx, "--allow-all", $tool, [?splice $args]) cwd=$cwd]]
    [out code=[$string $r@exit-code] text=[$cat ([$string $r@stdout], [$string $r@stderr])]]]]

[?def has scope=private pure [returns bool] ($o $needles)
  [= [$count [?for [in $n $needles] [where [not [$strings:contains [$string $o@text] $n]]] [yield 1]]] 0]]

[?def check scope=private impure [returns bool] ($name::string $ok::bool $o)
  [?let [= $_ [?if $ok
                [then [$say [$cat ("fixture OK      ", $name)]]]
                [else [$say [$cat ("fixture FAILED  ", $name, " (exit ", [$string $o@code], ")\n", [$string $o@text])]]]]]
    $ok]]

[?let
  [= $raw [$env:argv]]
  [= $cx [$nth $raw 2]]
  [= $tool [$nth $raw 3]]
  [= $strip-tool [$nth $raw 4]]
  [= $repl-abs [$nth $raw 5]]
  [= $replarg [$cat ("replacements:", $repl-abs)]]
  [= $root [$io:temp-dir "cx-phr-fixture-"]]
  [= $wab [$world-ab $root]]
  [= $wc [$world-c $root]]
  [= $srcarg [$cat ("source:src=", [$string $wab@src])]]
  [= $w1 [$cat ($root, "/w1")]]

  # A — RED FIRST: verify-only before the rewrite finds the planted literal
  # (2 diff lines: the commit that adds it, the commit that removes it —
  # git log -p counts lines, same as REFRESH-3's own `grep -cE` method).
  [= $a [$run-tool $cx $tool $root ("src", [$cat ("verify-only:src")], [$cat ("work=", $w1)], $srcarg, $replarg)]]
  [= $ok-a [$check "A verify-only pre-rewrite (RED): 2 shape hits, exit 1"
             [and [= [$string $a@code] "1"] [$has $a ("src: verify-only, ", "2 shape hit(s)")]]
             $a]]

  # B — the rewrite (GREEN): hits 2 -> 0, commits/tree unchanged, fsck clean;
  # the historical blob itself now reads the redacted shape, not the literal.
  [= $b [$run-tool $cx $tool $root ("src", [$cat ("work=", $w1)], $replarg)]]
  [= $ok-b-report [$check "B rewrite (GREEN): commits unchanged, tree unchanged, hits 2 -> 0, fsck clean"
             [and [= [$string $b@code] "0"]
                  [$has $b ("src: every ref, commits 3 -> 3 (unchanged: true)", "tree(s) 1 unchanged: true",
                            "hits 2 -> 0", "fsck clean: true")]]
             $b]]
  # the rewrite gave the c2 commit a NEW sha (filter-repo rewrites every
  # commit whose content or ancestry changed) — find it by the message the
  # planted-literal commit still carries (messages are untouched by this
  # pass) rather than the pre-rewrite sha, which no longer resolves.
  [= $new-c2 [$strings:trim [$git [$cat ($w1, "/src.git")] ("log", "--all", "--format=%H", "--grep=oops: a secret-shaped literal")]]]
  [= $blob [$git [$cat ($w1, "/src.git")] ("show", [$cat ($new-c2, ":secret.txt")])]]
  [= $ok-b-blob [$check "B historical blob content: literal replaced by the redacted shape"
             [and [not [$strings:contains $blob [$literal]]] [$strings:contains $blob "<redacted-test-shape>"]]
             [out code="0" text=$blob]]]
  [= $c [$run-tool $cx $tool $root ("src", [$cat ("verify-only:src")], [$cat ("work=", $w1)], $replarg)]]
  [= $ok-c [$check "C verify-only post-rewrite (GREEN): 0 shape hits, exit 0"
             [and [= [$string $c@code] "0"] [$has $c ("0 shape hit(s)")]]
             $c]]

  # D — chaining: strip_attribution.cx's message pass runs first into work=w2,
  # then public_history_replace.cx over the SAME work=w2 with no source:
  # override (its default source does not exist for this scratch repo) —
  # it must reuse the mirror the strip pass left rather than fail to clone.
  [= $w2 [$cat ($root, "/w2")]]
  [= $srcarg2 [$cat ("source:src=", [$string $wc@src])]]
  [= $strip-run [$run-tool $cx $strip-tool $root ("src", [$cat ("work=", $w2)], $srcarg2)]]
  [= $ok-strip [$check "D0 strip_attribution.cx pass runs first, into the shared work="
             [= [$string $strip-run@code] "0"]
             $strip-run]]
  [= $d [$run-tool $cx $tool $root ("src", [$cat ("work=", $w2)], $replarg)]]
  [= $ok-d [$check "D public_history_replace.cx reuses the SAME work= mirror (no source: given) as its LAST pass"
             [and [= [$string $d@code] "0"] [$has $d ("reusing existing mirror at", "commits 4 -> 4 (unchanged: true)", "hits 2 -> 0")]]
             $d]]
  [= $trailer-still-in-msg [$git [$cat ($w2, "/src.git")] ("log", "--all", "--format=%B")]]
  [= $ok-d-msg [$check "D the message strip's own effect survived the second pass (no trailer in any message)"
             [not [$strings:contains $trailer-still-in-msg [$trailer]]]
             [out code="0" text=$trailer-still-in-msg]]]

  # E/F/G — world-d: PUBFIX-1's own regression. A repo that TRACKS the real
  # scripts/public_history_replacements.txt ($repl-abs, not a stand-in) at
  # one commit and carries all three shapes in a separate, later-removed
  # blob at another. Before the fix this is RED at E-selfmatch (the tracked
  # file's own historical blob comes back rewritten); after, every one of
  # E/F/G holds.
  [= $wd [$world-d $root $repl-abs]]
  [= $w3 [$cat ($root, "/w3")]]
  [= $srcarg3 [$cat ("source:src=", [$string $wd@src])]]
  [= $e [$run-tool $cx $tool $root ("src", [$cat ("work=", $w3)], $srcarg3, $replarg)]]
  [= $ok-e [$check "E rewrite over a repo that TRACKS the real replacements file: commits unchanged, fsck clean"
             [and [= [$string $e@code] "0"]
                  [$has $e ("src: every ref, commits 4 -> 4 (unchanged: true)", "fsck clean: true")]]
             $e]]
  [= $new-c2 [$strings:trim [$git [$cat ($w3, "/src.git")] ("log", "--all", "--format=%H",
                                                            "--grep=carry the real replacements file")]]]
  [= $blob-e [$git-raw [$cat ($w3, "/src.git")] ("show", [$cat ($new-c2, ":public_history_replacements.txt")])]]
  [= $ok-e-selfmatch [$check "F the tracked replacements file's own blob is BYTE-IDENTICAL after the pass (no self-match)"
             [= $blob-e [$string $wd@repl-content]]
             [out code="0" text=$blob-e]]]
  [= $new-c3 [$strings:trim [$git [$cat ($w3, "/src.git")] ("log", "--all", "--format=%H",
                                                            "--grep=oops: all three shapes")]]]
  [= $blob-secret [$git [$cat ($w3, "/src.git")] ("show", [$cat ($new-c3, ":secret.txt")])]]
  [= $ok-e-redact [$check "G another blob: all three shapes still redacted (no literal survives, three redacted markers)"
             [and [not [$strings:contains $blob-secret [$xoxb-literal]]]
                  [and [not [$strings:contains $blob-secret [$akia-literal]]]
                       [and [not [$strings:contains $blob-secret [$literal]]]
                            [= [$strings:count $blob-secret "<redacted-test-shape>"] 3]]]]
             [out code="0" text=$blob-secret]]]

  [= $_rm [$io:remove-tree $root]]
  [= $checks ($ok-a, $ok-b-report, $ok-b-blob, $ok-c, $ok-strip, $ok-d, $ok-d-msg,
              $ok-e, $ok-e-selfmatch, $ok-e-redact)]
  [= $all-ok [= [$count [?for [in $x $checks] [where [not $x]] [yield 1]]] 0]]
  [?if $all-ok
    [then [?let [= $_ [$say "public-history-replace fixture: 10/10 OK"]] [$env:exit 0]]]
    [else [?let [= $_ [$say "public-history-replace fixture: FAILED"]] [$env:exit 1]]]]]
