# scripts/issue_label_gate.cx — release membership is the label (#1781,
# RULED: LBL-1, SHIP-2, CXF-1, CXF-8).
#
# LBL-1 (the owner, 2026-10-04): the release label is the one truth of what
# ships in the release; the release milestone retires from open issues; every
# issue carries the label at creation — in a component repository, whose
# LABELS.md carries no release label, the title prefix `<release> ` (SHIP-2).
# Two issues filed on 10-04 had no label and 40 open ones still carried the
# milestone when that was ruled. This step refuses, on the live tracker:
#
#   a  an open cx-private issue created after CUTOFF (2026-10-02, the owner's
#      rule of that day) without the release label;
#   b  an open cx-private issue on a milestone, unless a [parking] row of the
#      register names it (v0.19 stays a parking milestone, LBL-1);
#   c  an open issue of a status=extracted repository of registry/repos.cxd
#      whose title does not start with `<release> `;
#
# unless an [exclude] row of scripts/issue_label_exclusions.cxd names the
# issue with its reason (SHIP-2's named exclusions). A register row without a
# why= is refused and excludes nothing. The release is derived from VERSION
# (`v` and its first two numbers), never written here.
#
# It reaches GitHub (`gh api`, the subprocess grant), so it is on the daily
# full run (TEST_TARGETS) and a selected run picks it only when its own inputs
# change (its selection row names this program, its case table, its register,
# the registry and VERSION). A read gh cannot make is a refusal, exit 2, never
# a pass. `--self-test` first grades the decision offline on
# scripts/issue_label_gate_cases.cxd (planted GitHub answers).
#
# Run (from the repository root):
#   cx --allow-read --allow-write --allow-env --allow-subprocess scripts/issue_label_gate.cx [--self-test]
# Exit: 0 nothing refused; 1 a refusal (each named, with its title); 2 a read
# that failed.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/json'    as=json]
[?lib 'cx-stdlib/map'     as=map]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]

[?const REGISTER "scripts/issue_label_exclusions.cxd"]
[?const CASES    "scripts/issue_label_gate_cases.cxd"]
[?const REPOS    "registry/repos.cxd"]
[?const ORG      "cx-home"]
[?const HOME     "cx-private"]
[?const CUTOFF   "2026-10-02T23:59:59Z"]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]

[?def attr scope=public ($e $k $d)
  [?let [= $hits [?for [in $a [$attrs $e]] [where [= [$string $a@name] $k]] [yield [$string $a]]]]
    [?if [$empty $hits] [then $d] [else [$first $hits]]]]]

# release-of: `v<major>.<minor>` from VERSION's text (0.18.0-pre.1 -> v0.18).
[?def release-of scope=public ($v)
  [?let [= $parts [$strings:split [$strings:trim $v] "."]]
    [$concat "v" [$nth $parts 1] "." [$nth $parts 2]]]]

# ── one issue, as GitHub answers it ──────────────────────────────────────
[?def num    scope=public ($i) [$string [$map:get $i "number"]]]
[?def title  scope=public ($i) [$string [$map:get $i "title"]]]
[?def labels scope=public ($i) [?for [in $l [$map:get $i "labels"]] [yield [$string [$map:get $l "name"]]]]]
[?def milestone scope=public ($i)
  [?let [= $m [$map:get $i "milestone"]]
    [?if [= [$string $m] "null"] [then ""] [else [$string [$map:get $m "title"]]]]]]
[?def is-pr scope=public ($i) [$map:contains $i "pull_request"]]
# stamp: an ISO-8601 UTC time as the integer its digits spell (2026-10-03T01:00:00Z
# -> 20261003010000), so two can be ordered; a time that does not read as one
# sorts after every cutoff, so an issue gh dates oddly is judged, never skipped.
[?def stamp scope=public ($t)
  [?let [= $n [$strings:to-int [$strings:replace [$strings:replace [$strings:replace [$strings:replace $t "-" ""] "T" ""] ":" ""] "Z" ""]]]
    [?match $n [case [err] 99999999999999] [else $n]]]]
[?def member scope=public ($seq $x) [> [$count [?for [in $y $seq] [where [= $y $x]] [yield 1]]] 0]]

# issues-of: the issues of one `gh api --paginate --slurp` answer (an array
# of pages), pull requests left out — the issues endpoint lists both.
[?def issues-of scope=public ($pages)
  [?for [in $p $pages] [in $i $p] [where [not [$is-pr $i]]] [yield $i]]]

# ── the decision ─────────────────────────────────────────────────────────
# judge: every refusal key, in order — register rows without a why, then a,
# b and c (the case table's want= grammar). $reg is the register document,
# $private the cx-private issues, $components a sequence of maps
# {repo: <name>, issues: <issues>}.
[?def judge scope=public ($release $cutoff $reg $private $components)
  [?let [= $why-ok [?fn ($r) [not [= [$strings:trim [$attr $r "why" ""]] ""]]]]
        [= $bad-rows (
            [?for [in $x $reg//exclude] [where [not [$why-ok $x]]]
              [yield [$concat "register:" [$attr $x "repo" "?"] "#" [$attr $x "number" "?"]]]],
            [?for [in $x $reg//parking] [where [not [$why-ok $x]]]
              [yield [$concat "register:milestone#" [$attr $x "milestone" "?"]]]])]
        [= $excluded [?for [in $x $reg//exclude] [where [$why-ok $x]]
                       [yield [$concat [$attr $x "repo" ""] "#" [$attr $x "number" ""]]]]]
        [= $parked [?for [in $x $reg//parking] [where [$why-ok $x]] [yield [$attr $x "milestone" ""]]]]
        [= $prefix [$concat $release " "]]
        [= $a [?for [in $i $private]
                [where [> [$stamp [$string [$map:get $i "created_at"]]] [$stamp $cutoff]]]
                [where [not [$member [$labels $i] $release]]]
                [where [not [$member $excluded [$concat HOME "#" [$num $i]]]]]
                [yield [$concat "a:" HOME "#" [$num $i]]]]]
        [= $b [?for [in $i $private]
                [= $m [$milestone $i]]
                [where [not [= $m ""]]]
                [where [not [$member $parked $m]]]
                [yield [$concat "b:" HOME "#" [$num $i]]]]]
        [= $c [?for [in $p $components]
                [= $repo [$string [$map:get $p "repo"]]]
                [in $i [$map:get $p "issues"]]
                [where [not [$strings:starts-with [$title $i] $prefix]]]
                [where [not [$member $excluded [$concat $repo "#" [$num $i]]]]]
                [yield [$concat "c:" $repo "#" [$num $i]]]]]
    [?to-array [?for [in $xs ($bad-rows, $a, $b, $c)] [in $x $xs] [where [not [= [$string $x] ""]]] [yield $x]]]]]


# ── the self-test (offline) ──────────────────────────────────────────────
[?def self-test scope=public impure ()
  [?let [= $doc [$cx:parse [$io:read-file CASES]]]
        [= $root $doc]
        [= $release [$attr $root "release" ""]]
        [= $cutoff [$attr $root "cutoff" ""]]
        [= $rows [?for [in $c $root/case]
                   [= $regs [?for [in $r $c/register] [yield $r]]]
                   [= $reg [?if [$empty $regs] [then [$cx:parse "[register]"]] [else [$first $regs]]]]
                   [= $private [?for [in $p $c/private] [in $i [$issues-of [$json:parse [$concat "[" [$string $p] "]"]]]] [yield $i]]]
                   [= $components [?for [in $p $c/component]
                                    [yield [$map:put [$map:put {} "repo" [$attr $p "repo" ""]] "issues"
                                                     [?to-array [$issues-of [$json:parse [$concat "[" [$string $p] "]"]]]]]]]]
                   [= $got [$strings:join [$judge $release $cutoff $reg $private $components] " "]]
                   [= $want [$attr $c "want" ""]]
                   [yield [row id=[$attr $c "id" "?"] ok=[= $got $want] got=$got want=$want]]]]
        [= $_l [?for [in $r $rows]
                 [yield [$say [$concat "  " [?if $r@ok [then "ok "] [else "RED"]] " " [$string $r@id] ": refused '"
                                       [$string $r@got] "'" [?if $r@ok [then ""] [else [$concat " — the table wants '" [$string $r@want] "'"]]]]]]]]
        [= $red [$count [?for [in $r $rows] [where [not $r@ok]] [yield 1]]]]
    [?if [= $red 0]
      [then [?let [= $_k [$say [$concat "issue-label-gate --self-test: " [$string [$count $rows]] " case(s), every one as the table says"]]]
              [$env:exit 0]]]
      [else [?let [= $_k [$cry [$concat "issue-label-gate --self-test: " [$string $red] " of " [$string [$count $rows]] " case(s) RED"]]]
              [$env:exit 1]]]]]]

# ── the live reading ─────────────────────────────────────────────────────
# fetch: every open issue of one repository, or exit 2 naming why not.
[?def fetch scope=public impure ($repo)
  [?let [= $r [$process:run ('gh', 'api', '--paginate', '--slurp',
                             [$concat "repos/" ORG "/" $repo "/issues?state=open&per_page=100"])]]
    [?match $r
      [case [err $e] [?let [= $_c [$cry [$concat "issue-label-gate: REFUSED — cannot run gh for " $repo ": " [$string $e@message]]]] [$env:exit 2]]]
      [else [?if [= [$string $r@exit-code] "0"]
              [then [?to-array [$issues-of [$json:parse [$string $r@stdout]]]]]
              [else [?let [= $_c [$cry [$concat "issue-label-gate: REFUSED — `gh api` for " $repo " exited " [$string $r@exit-code]
                                                 ": " [$strings:trim [$string $r@stderr]]]]]
                      [$env:exit 2]]]]]]]]

[?let
  [= $_st [?if [> [$count [?for [in $x [$env:argv]] [where [= $x "--self-test"]] [yield $x]]] 0]
            [then [$self-test]] [else ()]]]
  [= $release [$release-of [$io:read-file "VERSION"]]]
  [= $reg [$cx:parse [$io:read-file REGISTER]]]
  [= $names [?for [in $r [$cx:parse [$io:read-file REPOS]]//repo]
              [where [= [$attr $r "status" ""] "extracted"]]
              [yield [$attr $r "name" ""]]]]
  [= $private [$fetch HOME]]
  [= $components [?for [in $n $names] [yield [$map:put [$map:put {} "repo" $n] "issues" [$fetch $n]]]]]
  [= $keys [?to-array [$judge $release CUTOFF $reg $private $components]]]
  [= $all [?to-array [?for [in $i $private] [yield [$map:put [$map:put {} "key" [$concat HOME "#" [$num $i]]] "title" [$title $i]]]]]]
  [= $_r [?for [in $k $keys] [yield [$cry [$concat "issue-label-gate: REFUSED " $k]]]]]
  [= $stale [?for [in $x $reg/exclude]
              [where [= [$attr $x "repo" ""] HOME]]
              [where [not [$member [?for [in $i $private] [yield [$num $i]]] [$attr $x "number" ""]]]]
              [yield [$concat HOME "#" [$attr $x "number" ""]]]]]
  [= $_s [?for [in $s $stale] [yield [$say [$concat "issue-label-gate: NOTE — the exclusion of " $s " names an issue that is not open; the row can go"]]]]]
  [?if [$empty $keys]
    [then [?let [= $_k [$say [$concat "issue-label-gate: " [$string [$count $private]] " open " HOME " issue(s) and "
                                      [$string [$count [?for [in $c $components] [in $i [$map:get $c "issues"]] [yield 1]]]]
                                      " open issue(s) across " [$string [$count $names]] " component repositories hold to "
                                      $release " (" [$string [$count $reg//exclude]] " excluded by name)"]]]
            [$env:exit 0]]]
    [else [$env:exit 1]]]]
