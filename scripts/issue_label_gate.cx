# scripts/issue_label_gate.cx — release membership is the milestone (#1781,
# RULED: STREAM-1 -- the owner's MS-1, NOVER-1 and LGATE-1 of 2026-10-16;
# replaces LBL-1's label-and-prefix rule).
#
# MS-1 (the owner, 2026-10-16): release membership is the milestone. The
# milestones <release> (from VERSION), the next minor and `Backlog` exist in
# every deliverable repository: cx-private, cx, cx-examples, v,
# cx-standard-features, cx-platform-reference and the component repositories
# (status=extracted or created in registry/repos.cxd). NOVER-1 (the owner,
# 2026-10-16T00:15:05Z): no version number in an issue's title or body; the
# milestone carries it. This step refuses, on the live tracker:
#
#   m  an open issue of a deliverable repository that is not on exactly one
#      of the milestones <release>, the next minor, `Backlog` (on none, or on
#      any other milestone) -- a `board`-labelled issue excepted: boards are
#      off the milestone (AUDIT-1018 C (a), the owner, 2026-10-18);
#   t  an open issue created after NOVER-1 whose title or body names a version
#      of this line: `v<major>.<n>` or `<major>.<n>.<n>` (<major> from
#      VERSION; a third-party version such as a Python 3.12 or a TLS 1.3 is not
#      this line's). Issues filed before the ruling keep their text (the owner:
#      existing issues are not retitled).
#
# The cx-private release label stays on issues until the cut (the stream list
# query keys on it) but the gate no longer requires it; the exclusion
# register (LBL-1/SHIP-2's named exceptions to the label and the title
# prefix) retired with the rule it excused: a ruling now moves an issue to
# a milestone instead. The release is derived from VERSION, never written here.
#
# It reaches GitHub (`gh api`, the subprocess grant), so it is on the daily
# full run (TEST_TARGETS) and a selected run picks it only when its own inputs
# change (its selection row names this program, its case table, the registry
# and VERSION). A read gh cannot make is a refusal, exit 2, never a pass.
# `--self-test` first grades the decision offline on
# scripts/issue_label_gate_cases.cxd (planted GitHub answers).
#
# Run (from the repository root):
#   cx --allow-read --allow-write --allow-env --allow-subprocess scripts/issue_label_gate.cx [--self-test]
# Exit: 0 nothing refused; 1 a refusal (each named on stdout, the step's log,
# with why, the issue's title and the fix; a count on stderr); 2 a read that
# failed -- the ENVIRONMENT (no gh, no auth, no network, an answer that is not
# one), printed as its own sentence on both streams, never a milestone
# refusal. Under make either red shows as make's exit 2: the printed sentence
# says which.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/json'    as=json]
[?lib 'cx-stdlib/map'     as=map]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/re'      as=re]

[?const CASES    "scripts/issue_label_gate_cases.cxd"]
[?const REPOS    "registry/repos.cxd"]
[?const ORG      "cx-home"]
# the deliverable repositories registry/repos.cxd does not list as components (MS-1's thirty)
[?const FRONT    ("cx-private", "cx", "cx-examples", "v", "cx-standard-features", "cx-platform-reference")]
[?const BACKLOG  "Backlog"]
# NOVER-1's hour: an issue created after it names no version
[?const CUTOFF   "2026-10-16T00:15:05Z"]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]

[?def attr scope=public ($e $k $d)
  [?let [= $hits [?for [in $a [$attrs $e]] [where [= [$string $a@name] $k]] [yield [$string $a]]]]
    [?if [$empty $hits] [then $d] [else [$first $hits]]]]]

# release-of: `v<major>.<minor>` from VERSION's text (e.g. 7.7.0-pre.1 -> v7.7).
[?def release-of scope=public ($v)
  [?let [= $parts [$strings:split [$strings:trim $v] "."]]
    [$concat "v" [$nth $parts 1] "." [$nth $parts 2]]]]
# next-of: the next minor of a release (v7.7 -> v7.8); major-of: its major (v7.7 -> 7).
[?def next-of scope=public ($rel)
  [?let [= $parts [$strings:split $rel "."]]
    [$concat [$nth $parts 1] "." [$string [+ [$strings:to-int [$nth $parts 2]] 1]]]]]
[?def major-of scope=public ($rel)
  [$strings:trim-start-chars [$nth [$strings:split $rel "."] 1] "vV"]]
# version-rx: a version of this line, `v<major>.<n>[.<n>…]` (any case of v) or
# `<major>.<n>.<n>`, as group 1. The dotted run must stand alone: no word
# character or dot before it, no word character or dot-and-digit after it —
# so an IPv4 address is not a version (with the line's major 0, 127.0.0.1
# holds 0.0.1 and 0.0.0.0 holds 0.0.0; cx-platform-fabric#6 read RED on it).
# RE2 has no look-around, hence the bounding non-capturing groups.
[?def version-rx scope=public ($rel)
  [?let [= $mj [$major-of $rel]]
    [$re:compile [$concat "(?:^|[^0-9A-Za-z_.])([vV]" $mj "\\.[0-9]+(?:\\.[0-9]+)*|" $mj "\\.[0-9]+\\.[0-9]+)(?:$|[^0-9A-Za-z_.]|\\.$|\\.[^0-9])"]]]]

# ── one issue, as GitHub answers it ──────────────────────────────────────
[?def num    scope=public ($i) [$string [$map:get $i "number"]]]
[?def title  scope=public ($i) [$string [$map:get $i "title"]]]
# body: '' for none (missing or null).
[?def body   scope=public ($i)
  [?let [= $b [?else [$map:get $i "body"] null]]
    [?if [= [$string $b] "null"] [then ""] [else [$string $b]]]]]
# milestone: '' for none (missing or null); any other value is a milestone,
# and one with no readable title is named `(untitled milestone)` -- so an
# empty milestone object is refused like any other (REFUTE-1 i01).
[?def milestone scope=public ($i)
  [?let [= $m [?else [$map:get $i "milestone"] null]]
    [?if [= [$string $m] "null"] [then ""]
      [else [?let [= $t [?else [$map:get $m "title"] null]]
              [?if [or [= [$string $t] "null"] [= [$string $t] ""]] [then "(untitled milestone)"] [else [$string $t]]]]]]]]
[?def is-pr scope=public ($i) [$map:contains $i "pull_request"]]
# stamp: an ISO-8601 UTC time as the integer its digits spell (2026-10-03T01:00:00Z
# -> 20261003010000), so two can be ordered; a time that does not read as one
# sorts after every cutoff, so an issue gh dates oddly is judged, never skipped. Only
# the UTC form GitHub answers reads (a null, a missing field or an offset do
# not: REFUTE-1 i01).
[?def stamp scope=public ($t)
  [?let [= $m [$re:find [$re:compile "^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})Z$"] $t]]
    [?match $m
      [case () 99999999999999]
      [else [$strings:to-int [$concat [$re:group $m 1] [$re:group $m 2] [$re:group $m 3]
                                        [$re:group $m 4] [$re:group $m 5] [$re:group $m 6]]]]]]]
[?def member scope=public ($seq $x) [> [$count [?for [in $y $seq] [where [= $y $x]] [yield 1]]] 0]]
# is-board: the issue carries the `board` label. AUDIT-1018 C (a) (the owner,
# 2026-10-18T15:08:28Z): boards come off the milestone, so a board is not judged
# by the m rule (its t rule stands).
[?def is-board scope=public ($i)
  [> [$count [?for [in $l [?else [$map:get $i "labels"] ()]]
               [where [= [$string [?else [$map:get $l "name"] ""]] "board"]]
               [yield 1]]] 0]]
# version-in: the first version of this line the issue's title, then body, names; '' for none.
[?def version-in scope=public ($rel $i)
  [?let [= $m [$re:find [$version-rx $rel] [$concat [$title $i] "\n" [$body $i]]]]
    [?match $m [case () ""] [else [$re:group $m 1]]]]]

# issues-of: the issues of one `gh api --paginate --slurp` answer (an array
# of pages), pull requests left out — the issues endpoint lists both.
[?def issues-of scope=public ($pages)
  [?for [in $p $pages] [in $i $p] [where [not [$is-pr $i]]] [yield $i]]]

# ── the decision ─────────────────────────────────────────────────────────
# judge: every refusal key, in order -- m then t (the case table's want=
# grammar). $repos is a sequence of maps {repo: <name>, issues: <issues>}.
[?def judge scope=public ($release $cutoff $repos)
  [?let [= $allowed ($release, [$next-of $release], BACKLOG)]
        [= $m [?for [in $p $repos]
                [= $repo [$string [$map:get $p "repo"]]]
                [in $i [$map:get $p "issues"]]
                [where [and [not [$is-board $i]] [not [$member $allowed [$milestone $i]]]]]
                [yield [$concat "m:" $repo "#" [$num $i]]]]]
        [= $t [?for [in $p $repos]
                [= $repo [$string [$map:get $p "repo"]]]
                [in $i [$map:get $p "issues"]]
                [where [> [$stamp [$string [?else [$map:get $i "created_at"] ""]]] [$stamp $cutoff]]]
                [where [not [= [$version-in $release $i] ""]]]
                [yield [$concat "t:" $repo "#" [$num $i]]]]]
    [?to-array [?for [in $xs ($m, $t)] [in $x $xs] [where [not [= [$string $x] ""]]] [yield $x]]]]]

# ── what is printed ──────────────────────────────────────────────────────
# Refusals go to stdout, the step's log, which the flow's red message tails
# (run4 of batch H4 printed them on stderr alone and its tail named none),
# and a count goes to stderr. A read that failed is printed on both.
#
# find-issue: the issue <repo>#<n> of the answers read, or null.
[?def find-issue scope=public ($repo $n $repos)
  [?let [= $hits [?for [in $p $repos] [where [= [$string [$map:get $p "repo"]] $repo]]
                   [in $i [$map:get $p "issues"]] [where [= [$num $i] $n]] [yield $i]]]
    [?if [$empty $hits] [then null] [else [$first $hits]]]]]
# refusal-line: the line one refusal key prints -- the key, why, the issue's
# title and the fix, spelled as the command that makes it (the case table's
# [line] rows grade it).
[?def refusal-line scope=public ($release $key $repos)
  [?let [= $m [$re:find [$re:compile "^(m|t):([^#]*)#(.*)$"] $key]]
    [?match $m
      [case () [$concat "issue-label-gate: REFUSED " $key]]
      [else [?let [= $kind [$re:group $m 1]] [= $repo [$re:group $m 2]] [= $n [$re:group $m 3]]
                  [= $i [$find-issue $repo $n $repos]]
                  [= $found [not [= [$string $i] "null"]]]
                  [= $t [?if $found [then [$concat ": '" [$title $i] "'"]] [else ""]]]
                  [= $slug [$concat ORG "/" $repo]]
                  [= $names [$concat $release " / " [$next-of $release] " / " BACKLOG]]
                  [= $why [?if [= $kind "m"]
                            [then [?let [= $ms [?if $found [then [$milestone $i]] [else ""]]]
                                    [$concat [?if [= $ms ""] [then "on no milestone"] [else [$concat "on the milestone '" $ms "'"]]]
                                             ", not one of " $names " (MS-1)"]]]
                            [else [$concat "created " [?if $found [then [$string [?else [$map:get $i "created_at"] "(no date)"]]] [else "(no date)"]]
                                           ", after NOVER-1, and names the version '" [?if $found [then [$version-in $release $i]] [else ""]]
                                           "' in its title or body (the milestone carries the release)"]]]]
                  [= $fix [?if [= $kind "m"]
                            [then [$concat " -- fix: gh issue edit " $n " --repo " $slug " --milestone " $release
                                           " (or " [$next-of $release] ", or " BACKLOG ")"]]
                            [else [$concat " -- fix: gh issue edit " $n " --repo " $slug " --title/--body without the version"]]]]
              [$concat "issue-label-gate: REFUSED " $key " -- " $why $t $fix]]]]]]
# read-line: the line a read that failed prints, exit 2 -- the environment,
# never a milestone refusal (the case table's [read-case] rows grade it).
[?def read-line scope=public ($repo $why)
  [$concat "issue-label-gate: ENVIRONMENT -- the open issues of " $repo " could not be read (" $why
           "); nothing was judged, this is not a milestone refusal (exit 2)"]]


# ── the self-test (offline) ──────────────────────────────────────────────
[?def self-test scope=public impure ()
  [?let [= $raw [$io:read-file CASES]]
        [= $_r [?match $raw
                  [case [err$e] [?let [= $_c [$cry [$concat "issue-label-gate --self-test: REFUSED -- cannot read " CASES ": " [$string $e@message]]]] [$env:exit 2]]]
                  [else ()]]]
        [= $root [$cx:parse $raw]]
        [= $_n [?if [= [$count [?for [in $c $root/case] [yield 1]]] 0]
                  [then [?let [= $_c [$cry [$concat "issue-label-gate --self-test: REFUSED -- " CASES " holds no case; a table that grades nothing vouches for nothing"]]] [$env:exit 2]]]
                  [else ()]]]
        [= $release [$attr $root "release" ""]]
        [= $cutoff [$attr $root "cutoff" ""]]
        [= $rows [?for [in $c $root/case]
                   [= $repos [?for [in $p $c/issues]
                               [yield {repo: [$attr $p "repo" ""],
                                       issues: [?to-array [$issues-of [$json:parse [$concat "[" [$string $p] "]"]]]]}]]]
                   [= $keys [$judge $release $cutoff $repos]]
                   [= $got [$strings:join $keys " "]]
                   [= $want [$attr $c "want" ""]]
                   [= $id [$attr $c "id" "?"]]
                   [; a case with [line] rows grades the printed lines too, in order ]
                   [= $want-lines [?for [in $l $c/line] [yield [$string $l]]]]
                   [= $got-lines [?if [$empty $want-lines] [then ()]
                                   [else [?for [in $k $keys] [yield [$refusal-line $release $k $repos]]]]]]
                   [= $lines-ok [= [$strings:join $got-lines "\n"] [$strings:join $want-lines "\n"]]]
                   [= $ok [and [= $got $want] $lines-ok]]
                   [= $got-shown [?if $lines-ok [then $got] [else [$concat $got " | printed: " [$strings:join $got-lines " / "]]]]]
                   [= $want-shown [?if $lines-ok [then $want] [else [$concat $want " | printed: " [$strings:join $want-lines " / "]]]]]
                   [yield [row id=$id ok=$ok got=$got-shown want=$want-shown]]]]
        [= $reads [?for [in $c $root/read-case]
                    [= $got [$read-line [$attr $c "repo" ""] [$attr $c "why" ""]]]
                    [= $want [$attr $c "want" ""]]
                    [= $id [$attr $c "id" "?"]]
                    [= $ok [= $got $want]]
                    [yield [row id=$id ok=$ok got=$got want=$want]]]]
        [= $rows [?to-array [?for [in $xs ($rows, $reads)] [in $x $xs] [yield $x]]]]
        [= $_l [?for [in $r $rows]
                 [yield [$say [$concat "  " [?if $r@ok [then "ok "] [else "RED"]] " " [$string $r@id] ": refused '"
                                       [$string $r@got] "'" [?if $r@ok [then ""] [else [$concat " — the table wants '" [$string $r@want] "'"]]]]]]]]
        [= $red [$count [?for [in $r $rows] [where [not $r@ok]] [yield 1]]]]
    [?if [= $red 0]
      [then [?let [= $_k [$say [$concat "issue-label-gate --self-test: " [$string [$count $rows]] " case(s), every one as the table says"]]]
              [$env:exit 0]]]
      [else [?let [= $_k [$cry [$concat "issue-label-gate --self-test: " [$string $red] " of " [$string [$count $rows]] " case(s) RED"]]]
              [$env:exit 1]]]]]]

# ── the live reading ─────────────────────────────────────────────────────
# fetch: every open issue of one repository, or exit 2 naming why not.
[?def gh-argv scope=public ($repo)
  ('gh', 'api', '--paginate', '--slurp', [$concat "repos/" ORG "/" $repo "/issues?state=open&per_page=100"])]
# refuse-read: exit 2 naming the repository and why its answer is not one.
[?def refuse-read scope=public impure ($repo $why)
  [?let [= $line [$read-line $repo $why]] [= $_o [$say $line]] [= $_c [$cry $line]] [$env:exit 2]]]
[?def fetch scope=public impure ($repo)
  [?let [= $r [$process:run [$gh-argv $repo]]]
    [?match $r
      [case [err$e] [$refuse-read $repo [$concat "gh could not be run: " [$string $e@message]]]]
      [else [?if [= [$string $r@exit-code] "0"]
              [then [?let [= $out [$strings:trim [$string $r@stdout]]]
                          [= $d [$json:parse $out]]
                      [; --slurp answers an array of pages, each an array: anything
                         else (no output, not JSON, an object) is a read that
                         failed, exit 2, never an empty tracker (REFUTE-1 g02-g04). ]
                      [?match $d
                        [case [err$e] [$refuse-read $repo [$concat "gh answered no JSON (" [$string $e@message] ")"]]]
                        [else [?if [$strings:starts-with $out "[["]
                                [then [?to-array [$issues-of $d]]]
                                [else [$refuse-read $repo "gh did not answer an array of pages"]]]]]]]
              [else [$refuse-read $repo [$concat "`gh api` exited " [$string $r@exit-code] ": " [$strings:trim [$string $r@stderr]]]]]]]]]]

[?let
  [= $_st [?if [> [$count [?for [in $x [$env:argv]] [where [= $x "--self-test"]] [yield $x]]] 0]
            [then [$self-test]] [else ()]]]
  [= $release [$release-of [$io:read-file "VERSION"]]]
  [= $components [?for [in $r [$cx:parse [$io:read-file REPOS]]//repo]
                   [where [or [= [$attr $r "status" ""] "extracted"] [= [$attr $r "status" ""] "created"]]]
                   [= $n [$attr $r "name" ""]]
                   [where [not [$member FRONT $n]]]
                   [yield $n]]]
  [= $names [?to-array [?for [in $xs (FRONT, $components)] [in $x $xs] [yield $x]]]]
  [= $repos [?to-array [?for [in $n $names] [yield {repo: $n, issues: [$fetch $n]}]]]]
  [= $keys [?to-array [$judge $release CUTOFF $repos]]]
  [= $_r [?for [in $k $keys] [yield [$say [$refusal-line $release $k $repos]]]]]
  [= $_n [?if [$empty $keys] [then ()]
           [else [$cry [$concat "issue-label-gate: " [$string [$count $keys]] " refusal(s), each named on stdout -- a milestone refusal (exit 1)"]]]]]
  [?if [$empty $keys]
    [then [?let [= $_k [$say [$concat "issue-label-gate: " [$string [$count [?for [in $c $repos] [in $i [$map:get $c "issues"]] [yield 1]]]]
                                      " open issue(s) across " [$string [$count $names]] " deliverable repositories, each on one of "
                                      $release " / " [$next-of $release] " / " BACKLOG "; none filed since NOVER-1 names a version"]]]
            [$env:exit 0]]]
    [else [$env:exit 1]]]]
