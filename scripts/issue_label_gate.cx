# scripts/issue_label_gate.cx — release membership is the label (#1781,
# RULED: LBL-1, SHIP-2, CXF-1, CXF-8).
#
# LBL-1 (the owner, 2026-10-04): the release label is the one truth of what
# ships in the release; the release milestone retires from open issues; every
# issue carries the label at creation — in a component repository, whose
# LABELS.md carries no release label, the title prefix `<release> ` (SHIP-2).
# Two issues filed on 10-04 had no label and 40 open ones still carried the
# milestone when that was ruled. This step refuses, on the live tracker:
#
#   a  an open cx-private issue created after CUTOFF (2026-10-02, the owner's
#      rule of that day) without the release label, unless it is on a
#      [parking] milestone (parked out of the release by the owner's word);
#   b  an open cx-private issue on a milestone, unless a [parking] row of the
#      register names it (v0.19 stays a parking milestone, LBL-1);
#   c  an open issue of a status=extracted repository of registry/repos.cxd
#      whose title does not start with `<release> ` (or `<release>: `);
#
# unless an [exclude] row of scripts/issue_label_exclusions.cxd names the
# issue with its reason (SHIP-2's named exclusions). A register row without a
# why= is refused and excludes nothing. The release is derived from VERSION
# (`v` and its first two numbers), never written here.
#
# It reaches GitHub (`gh api`, the subprocess grant), so it is on the daily
# full run (TEST_TARGETS) and a selected run picks it only when its own inputs
# change (its selection row names this program, its case table, its register,
# the registry and VERSION). A read gh cannot make is a refusal, exit 2, never
# a pass. `--self-test` first grades the decision offline on
# scripts/issue_label_gate_cases.cxd (planted GitHub answers).
#
# Run (from the repository root):
#   cx --allow-read --allow-write --allow-env --allow-subprocess scripts/issue_label_gate.cx [--self-test]
# Exit: 0 nothing refused; 1 a refusal (each named on stdout, the step's log,
# with why and the issue's title; a count on stderr); 2 a read that failed --
# the ENVIRONMENT (no gh, no auth, no network, an answer that is not one),
# printed as its own sentence on both streams, never a label refusal. Under
# make either red shows as make's exit 2: the printed sentence says which.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/json'    as=json]
[?lib 'cx-stdlib/map'     as=map]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/re'      as=re]

[?const REGISTER "scripts/issue_label_exclusions.cxd"]
[?const CASES    "scripts/issue_label_gate_cases.cxd"]
[?const REPOS    "registry/repos.cxd"]
[?const ORG      "cx-home"]
[?const HOME     "cx-private"]
[?const CUTOFF   "2026-10-02T23:59:59Z"]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]

[?def attr scope=public ($e $k $d)
  [?let [= $hits [?for [in $a [$attrs $e]] [where [= [$string $a@name] $k]] [yield [$string $a]]]]
    [?if [$empty $hits] [then $d] [else [$first $hits]]]]]

# release-of: `v<major>.<minor>` from VERSION's text (0.18.0-pre.1 -> v0.18).
[?def release-of scope=public ($v)
  [?let [= $parts [$strings:split [$strings:trim $v] "."]]
    [$concat "v" [$nth $parts 1] "." [$nth $parts 2]]]]

# ── one issue, as GitHub answers it ──────────────────────────────────────
[?def num    scope=public ($i) [$string [$map:get $i "number"]]]
[?def title  scope=public ($i) [$string [$map:get $i "title"]]]
# labels: the label names; a missing or null `labels` is none (REFUTE-1 i01).
[?def labels scope=public ($i)
  [?let [= $v [?else [$map:get $i "labels"] null]]
    [?if [= [$string $v] "null"] [then ()]
      [else [?for [in $l $v] [yield [$string [?else [$map:get $l "name"] ""]]]]]]]]
# milestone: '' for none (missing or null); any other value is a milestone,
# and one with no readable title is named `(untitled milestone)` -- so an
# empty milestone object is refused like any other (REFUTE-1 i01).
[?def milestone scope=public ($i)
  [?let [= $m [?else [$map:get $i "milestone"] null]]
    [?if [= [$string $m] "null"] [then ""]
      [else [?let [= $t [?else [$map:get $m "title"] null]]
              [?if [or [= [$string $t] "null"] [= [$string $t] ""]] [then "(untitled milestone)"] [else [$string $t]]]]]]]]
[?def is-pr scope=public ($i) [$map:contains $i "pull_request"]]
# stamp: an ISO-8601 UTC time as the integer its digits spell (2026-10-03T01:00:00Z
# -> 20261003010000), so two can be ordered; a time that does not read as one
# sorts after every cutoff, so an issue gh dates oddly is judged, never skipped. Only
# the UTC form GitHub answers reads (a null, a missing field or an offset do
# not: REFUTE-1 i01).
[?def stamp scope=public ($t)
  [?let [= $m [$re:find [$re:compile "^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})Z$"] $t]]
    [?match $m
      [case () 99999999999999]
      [else [$strings:to-int [$concat [$re:group $m 1] [$re:group $m 2] [$re:group $m 3]
                                        [$re:group $m 4] [$re:group $m 5] [$re:group $m 6]]]]]]]
[?def member scope=public ($seq $x) [> [$count [?for [in $y $seq] [where [= $y $x]] [yield 1]]] 0]]

# issues-of: the issues of one `gh api --paginate --slurp` answer (an array
# of pages), pull requests left out — the issues endpoint lists both.
[?def issues-of scope=public ($pages)
  [?for [in $p $pages] [in $i $p] [where [not [$is-pr $i]]] [yield $i]]]

# ── the decision ─────────────────────────────────────────────────────────
# judge: every refusal key, in order — register rows without a why, then a,
# b and c (the case table's want= grammar). $reg is the register document,
# $private the cx-private issues, $components a sequence of maps
# {repo: <name>, issues: <issues>}.
[?def judge scope=public ($release $cutoff $reg $private $components)
  [?let [= $why-ok [?fn ($r) [not [= [$strings:trim [$attr $r "why" ""]] ""]]]]
        [= $bad-rows (
            [?for [in $x $reg//exclude] [where [or [not [$why-ok $x]] [= [$attr $x "number" ""] ""]]]
              [yield [$concat "register:" [$attr $x "repo" "?"] "#" [$attr $x "number" "?"]]]],
            [?for [in $x $reg//parking] [where [not [$why-ok $x]]]
              [yield [$concat "register:milestone#" [$attr $x "milestone" "?"]]]])]
        [= $excluded [?for [in $x $reg//exclude] [where [$why-ok $x]] [where [not [= [$attr $x "number" ""] ""]]]
                       [yield [$concat [$attr $x "repo" ""] "#" [$attr $x "number" ""]]]]]
        [= $parked [?for [in $x $reg//parking] [where [$why-ok $x]] [yield [$attr $x "milestone" ""]]]]
        [= $prefix [$concat $release " "]]
        # `<release>: ` is the same prefix (STREAM-1's brief spells it so,
        # 2026-10-05; eighteen issues were filed that way the first hour).
        [= $colon-prefix [$concat $release ": "]]
        [= $a [?for [in $i $private]
                [where [> [$stamp [$string [?else [$map:get $i "created_at"] ""]]] [$stamp $cutoff]]]
                [where [not [$member [$labels $i] $release]]]
                [where [not [$member $excluded [$concat HOME "#" [$num $i]]]]]
                # an issue the owner files on a [parking] milestone is parked
                # out of the release by that word (#1836-#1840, parked on
                # 2026-10-06): it owes no release label.
                [where [not [$member $parked [$milestone $i]]]]
                [yield [$concat "a:" HOME "#" [$num $i]]]]]
        [= $b [?for [in $i $private]
                [= $m [$milestone $i]]
                [where [not [= $m ""]]]
                [where [not [$member $parked $m]]]
                [yield [$concat "b:" HOME "#" [$num $i]]]]]
        [= $c [?for [in $p $components]
                [= $repo [$string [$map:get $p "repo"]]]
                [in $i [$map:get $p "issues"]]
                [where [not [or [$strings:starts-with [$title $i] $prefix]
                                [$strings:starts-with [$title $i] $colon-prefix]]]]
                [where [not [$member $excluded [$concat $repo "#" [$num $i]]]]]
                [yield [$concat "c:" $repo "#" [$num $i]]]]]
    [?to-array [?for [in $xs ($bad-rows, $a, $b, $c)] [in $x $xs] [where [not [= [$string $x] ""]]] [yield $x]]]]]

# ── what is printed ──────────────────────────────────────────────────────
# Refusals go to stdout, the step's log, which the flow's red message tails
# (run4 of batch H4 printed them on stderr alone and its tail named none),
# and a count goes to stderr. A read that failed is printed on both.
#
# find-issue: the issue <repo>#<n> of the answers read, or null.
[?def find-issue scope=public ($repo $n $private $components)
  [?let [= $pool [?if [= $repo HOME] [then $private]
                   [else [?for [in $p $components] [where [= [$string [$map:get $p "repo"]] $repo]]
                           [in $i [$map:get $p "issues"]] [yield $i]]]]]
        [= $hits [?for [in $i $pool] [where [= [$num $i] $n]] [yield $i]]]
    [?if [$empty $hits] [then null] [else [$first $hits]]]]]
# refusal-line: the line one refusal key prints -- the key, why, and the
# issue's title (the case table's [line] rows grade it).
[?def refusal-line scope=public ($release $key $private $components)
  [?let [= $m [$re:find [$re:compile "^(a|b|c|register):([^#]*)#(.*)$"] $key]]
    [?match $m
      [case () [$concat "issue-label-gate: REFUSED " $key]]
      [else [?let [= $kind [$re:group $m 1]] [= $repo [$re:group $m 2]] [= $n [$re:group $m 3]]
                  [= $i [$find-issue $repo $n $private $components]]
                  [= $t [?if [or [= $kind "register"] [= [$string $i] "null"]] [then ""] [else [$concat ": '" [$title $i] "'"]]]]
                  [= $why [?match $kind
                            [case "a" [$concat "created " [$string [?else [$map:get $i "created_at"] "(no date)"]]
                                               " without the label " $release]]
                            [case "b" [$concat "on the milestone '" [$milestone $i] "', which no [parking] row names"]]
                            [case "c" [$concat "the title does not start with '" $release " '"]]
                            [else [$concat "a row of " REGISTER " without a why= or a number=; it excludes nothing"]]]]
              [$concat "issue-label-gate: REFUSED " $key " -- " $why $t]]]]]]
# read-line: the line a read that failed prints, exit 2 -- the environment,
# never a label refusal (the case table's [read-case] rows grade it).
[?def read-line scope=public ($repo $why)
  [$concat "issue-label-gate: ENVIRONMENT -- the open issues of " $repo " could not be read (" $why
           "); nothing was judged, this is not a label refusal (exit 2)"]]


# ── the self-test (offline) ──────────────────────────────────────────────
[?def self-test scope=public impure ()
  [?let [= $raw [$io:read-file CASES]]
        [= $_r [?match $raw
                  [case [err$e] [?let [= $_c [$cry [$concat "issue-label-gate --self-test: REFUSED -- cannot read " CASES ": " [$string $e@message]]]] [$env:exit 2]]]
                  [else ()]]]
        [= $root [$cx:parse $raw]]
        [= $_n [?if [= [$count [?for [in $c $root/case] [yield 1]]] 0]
                  [then [?let [= $_c [$cry [$concat "issue-label-gate --self-test: REFUSED -- " CASES " holds no case; a table that grades nothing vouches for nothing"]]] [$env:exit 2]]]
                  [else ()]]]
        [= $release [$attr $root "release" ""]]
        [= $cutoff [$attr $root "cutoff" ""]]
        [= $rows [?for [in $c $root/case]
                   [= $regs [?for [in $r $c/register] [yield $r]]]
                   [= $reg [?if [$empty $regs] [then [$cx:parse "[register]"]] [else [$first $regs]]]]
                   [= $private [?for [in $p $c/private] [in $i [$issues-of [$json:parse [$concat "[" [$string $p] "]"]]]] [yield $i]]]
                   [= $components [?for [in $p $c/component]
                                    [yield {repo: [$attr $p "repo" ""],
                                                      issues: [?to-array [$issues-of [$json:parse [$concat "[" [$string $p] "]"]]]]}]]]
                   [= $keys [$judge $release $cutoff $reg $private $components]]
                   [= $got [$strings:join $keys " "]]
                   [= $want [$attr $c "want" ""]]
                   [= $id [$attr $c "id" "?"]]
                   [; a case with [line] rows grades the printed lines too, in order ]
                   [= $want-lines [?for [in $l $c/line] [yield [$string $l]]]]
                   [= $got-lines [?if [$empty $want-lines] [then ()]
                                   [else [?for [in $k $keys] [yield [$refusal-line $release $k $private $components]]]]]]
                   [= $lines-ok [= [$strings:join $got-lines "\n"] [$strings:join $want-lines "\n"]]]
                   [= $ok [and [= $got $want] $lines-ok]]
                   [= $got-shown [?if $lines-ok [then $got] [else [$concat $got " | printed: " [$strings:join $got-lines " / "]]]]]
                   [= $want-shown [?if $lines-ok [then $want] [else [$concat $want " | printed: " [$strings:join $want-lines " / "]]]]]
                   [yield [row id=$id ok=$ok got=$got-shown want=$want-shown]]]]
        [= $reads [?for [in $c $root/read-case]
                    [= $got [$read-line [$attr $c "repo" ""] [$attr $c "why" ""]]]
                    [= $want [$attr $c "want" ""]]
                    [= $id [$attr $c "id" "?"]]
                    [= $ok [= $got $want]]
                    [yield [row id=$id ok=$ok got=$got want=$want]]]]
        [= $rows [?to-array [?for [in $xs ($rows, $reads)] [in $x $xs] [yield $x]]]]
        [= $_l [?for [in $r $rows]
                 [yield [$say [$concat "  " [?if $r@ok [then "ok "] [else "RED"]] " " [$string $r@id] ": refused '"
                                       [$string $r@got] "'" [?if $r@ok [then ""] [else [$concat " — the table wants '" [$string $r@want] "'"]]]]]]]]
        [= $red [$count [?for [in $r $rows] [where [not $r@ok]] [yield 1]]]]
    [?if [= $red 0]
      [then [?let [= $_k [$say [$concat "issue-label-gate --self-test: " [$string [$count $rows]] " case(s), every one as the table says"]]]
              [$env:exit 0]]]
      [else [?let [= $_k [$cry [$concat "issue-label-gate --self-test: " [$string $red] " of " [$string [$count $rows]] " case(s) RED"]]]
              [$env:exit 1]]]]]]

# ── the live reading ─────────────────────────────────────────────────────
# fetch: every open issue of one repository, or exit 2 naming why not.
[?def gh-argv scope=public ($repo)
  ('gh', 'api', '--paginate', '--slurp', [$concat "repos/" ORG "/" $repo "/issues?state=open&per_page=100"])]
# refuse-read: exit 2 naming the repository and why its answer is not one.
[?def refuse-read scope=public impure ($repo $why)
  [?let [= $line [$read-line $repo $why]] [= $_o [$say $line]] [= $_c [$cry $line]] [$env:exit 2]]]
[?def fetch scope=public impure ($repo)
  [?let [= $r [$process:run [$gh-argv $repo]]]
    [?match $r
      [case [err$e] [$refuse-read $repo [$concat "gh could not be run: " [$string $e@message]]]]
      [else [?if [= [$string $r@exit-code] "0"]
              [then [?let [= $out [$strings:trim [$string $r@stdout]]]
                          [= $d [$json:parse $out]]
                      [; --slurp answers an array of pages, each an array: anything
                         else (no output, not JSON, an object) is a read that
                         failed, exit 2, never an empty tracker (REFUTE-1 g02-g04). ]
                      [?match $d
                        [case [err$e] [$refuse-read $repo [$concat "gh answered no JSON (" [$string $e@message] ")"]]]
                        [else [?if [$strings:starts-with $out "[["]
                                [then [?to-array [$issues-of $d]]]
                                [else [$refuse-read $repo "gh did not answer an array of pages"]]]]]]]
              [else [$refuse-read $repo [$concat "`gh api` exited " [$string $r@exit-code] ": " [$strings:trim [$string $r@stderr]]]]]]]]]]

[?let
  [= $_st [?if [> [$count [?for [in $x [$env:argv]] [where [= $x "--self-test"]] [yield $x]]] 0]
            [then [$self-test]] [else ()]]]
  [= $release [$release-of [$io:read-file "VERSION"]]]
  [= $reg [$cx:parse [$io:read-file REGISTER]]]
  [= $names [?for [in $r [$cx:parse [$io:read-file REPOS]]//repo]
              [where [= [$attr $r "status" ""] "extracted"]]
              [yield [$attr $r "name" ""]]]]
  [= $private [$fetch HOME]]
  [= $components [?for [in $n $names] [yield {repo: $n, issues: [$fetch $n]}]]]
  [= $keys [?to-array [$judge $release CUTOFF $reg $private $components]]]
  [= $_r [?for [in $k $keys] [yield [$say [$refusal-line $release $k $private $components]]]]]
  [= $_n [?if [$empty $keys] [then ()]
           [else [$cry [$concat "issue-label-gate: " [$string [$count $keys]] " refusal(s), each named on stdout -- a label refusal (exit 1)"]]]]]
  [= $stale [?for [in $x $reg/exclude]
              [where [= [$attr $x "repo" ""] HOME]]
              [where [not [$member [?for [in $i $private] [yield [$num $i]]] [$attr $x "number" ""]]]]
              [yield [$concat HOME "#" [$attr $x "number" ""]]]]]
  [= $_s [?for [in $s $stale] [yield [$say [$concat "issue-label-gate: NOTE — the exclusion of " $s " names an issue that is not open; the row can go"]]]]]
  [?if [$empty $keys]
    [then [?let [= $_k [$say [$concat "issue-label-gate: " [$string [$count $private]] " open " HOME " issue(s) and "
                                      [$string [$count [?for [in $c $components] [in $i [$map:get $c "issues"]] [yield 1]]]]
                                      " open issue(s) across " [$string [$count $names]] " component repositories hold to "
                                      $release " (" [$string [$count $reg//exclude]] " excluded by name)"]]]
            [$env:exit 0]]]
    [else [$env:exit 1]]]]
