[issue-label-gate-cases release='v7.7' cutoff='2026-10-16T00:15:05Z'
  [doc [#
scripts/issue_label_gate_cases.cxd — issue-label-gate's case table (#1781,
RULED: STREAM-1; the owner's MS-1, NOVER-1, LGATE-1). `cx scripts/issue_label_gate.cx --self-test`
grades every case offline on PLANTED GitHub answers: each [issues repo=] is
the JSON of that repository's open issues. The release is the root's
release= (a made-up one, so the table carries no real version; its next minor
and Backlog are the other two milestones) and the cutoff NOVER-1's hour.

want= is every refusal the gate must make, space-separated, in order:
  m:<repo>#N   an open issue on none of <release> / <next minor> / Backlog
               (no milestone, or another one)
  t:<repo>#N   an open issue created after the cutoff whose title or body
               names a version of the release's line (v<major>.<n> or
               <major>.<n>.<n>)
want='' is a case the gate passes.

  [line '…']          (optional, inside a case) a line the refusals must
                     PRINT, in order; a case with any grades all of them
  [read-case repo= why= want=]  the sentence a read that failed prints
                     (exit 2) for that repository and reason
#]]

  [; m: the milestone is the release (MS-1) ]
  [case id=m-release want=''
    [issues repo=cx-private '[{"number": 1790, "created_at": "2026-10-03T01:00:00Z", "title": "x", "labels": [], "milestone": {"title": "v7.7"}}]']]
  [case id=m-next-and-backlog want=''
    [issues repo=cx-platform-xap '[{"number": 4, "created_at": "2026-09-01T00:00:00Z", "title": "x", "labels": [], "milestone": {"title": "v7.8"}},
                                   {"number": 5, "created_at": "2026-09-01T00:00:00Z", "title": "y", "labels": [], "milestone": {"title": "Backlog"}}]']]
  [; m: a board is off the milestone (AUDIT-1018 C (a)); its label exempts it, another label does not ]
  [case id=m-board-off-milestone want='m:cx-private#1795'
    [issues repo=cx-private '[{"number": 1591, "created_at": "2026-09-20T00:00:00Z", "title": "repo split board", "labels": [{"name": "v0.18"}, {"name": "board"}], "milestone": null},
                              {"number": 1795, "created_at": "2026-09-20T00:00:00Z", "title": "not a board", "labels": [{"name": "boardwalk"}], "milestone": null}]']]
  [case id=m-none want='m:cx-private#1791 m:v#22'
    [issues repo=cx-private '[{"number": 1791, "created_at": "2026-10-03T01:00:00Z", "title": "x", "labels": [{"name": "v7.7"}], "milestone": null}]']
    [issues repo=v '[{"number": 22, "created_at": "2026-10-03T01:00:00Z", "title": "x", "labels": []}]']]
  [case id=m-label-is-not-membership want='m:cx-private#1792'
    [issues repo=cx-private '[{"number": 1792, "created_at": "2026-10-03T01:00:00Z", "title": "x", "labels": [{"name": "v7.7"}], "milestone": {"title": "store phase 1"}}]']]
  [case id=m-near-miss want='m:cx#1 m:cx#2 m:cx#3 m:cx#4'
    [issues repo=cx '[{"number": 1, "created_at": "2026-09-01T00:00:00Z", "title": "x", "milestone": {"title": "v7.70"}},
                      {"number": 2, "created_at": "2026-09-01T00:00:00Z", "title": "x", "milestone": {"title": "V7.7"}},
                      {"number": 3, "created_at": "2026-09-01T00:00:00Z", "title": "x", "milestone": {"title": "backlog"}},
                      {"number": 4, "created_at": "2026-09-01T00:00:00Z", "title": "x", "milestone": {"title": "v7.9"}}]']]
  [case id=m-empty-milestone-object want='m:cx-private#1800'
    [issues repo=cx-private '[{"number": 1800, "created_at": "2026-09-01T00:00:00Z", "title": "x", "labels": [], "milestone": {}}]']]
  [case id=m-pull-request-skipped want=''
    [issues repo=cx-private '[{"number": 1793, "created_at": "2026-10-03T01:00:00Z", "title": "x", "milestone": null, "pull_request": {"url": "u"}}]']]

  [; t: no version in a title or body filed after NOVER-1; before it the text stays ]
  [case id=t-title-after want='t:cx-private#1950'
    [issues repo=cx-private '[{"number": 1950, "created_at": "2026-10-16T00:15:06Z", "title": "v7.7: the runner failed", "body": "", "milestone": {"title": "v7.7"}}]']]
  [case id=t-body-after want='t:cx-platform-net#30 t:cx-platform-net#31 t:cx-platform-net#32'
    [issues repo=cx-platform-net '[{"number": 30, "created_at": "2026-10-16T01:00:00Z", "title": "x", "body": "lands before the V7.7 cut", "milestone": {"title": "v7.7"}},
                                   {"number": 31, "created_at": "2026-10-16T01:00:00Z", "title": "x", "body": "seen on 7.7.0-pre.1", "milestone": {"title": "v7.7"}},
                                   {"number": 32, "created_at": "2026-10-16T01:00:00Z", "title": "x", "body": "(v7.12)", "milestone": {"title": "Backlog"}}]']]
  [case id=t-before-cutoff-kept want=''
    [issues repo=cx-private '[{"number": 1945, "created_at": "2026-10-15T09:00:00Z", "title": "the keystore in v7.7", "body": "v7.7 7.7.0", "milestone": {"title": "v7.7"}}]']]
  [case id=t-other-versions-are-not-the-line want=''
    [issues repo=cx-private '[{"number": 1951, "created_at": "2026-10-16T01:00:00Z", "title": "Python 3.12.15 vs Go 1.27.0", "body": "TLS 1.3, 0.90x at W=1, sqlite-3.53.3, UCD 16.0.0, v17.1, 77.7.1, v7", "milestone": {"title": "v7.7"}}]']]
  [; an IPv4 address is not a version: with the line's major 0, 127.0.0.1 holds 0.0.1 and a bind on 0.0.0.0 holds 0.0.0
     (cx-platform-fabric#6's 'bind health 127.0.0.1:49647' read RED); the table's major is 7 ]
  [case id=t-ipv4-is-not-a-version want=''
    [issues repo=cx-platform-fabric '[{"number": 6, "created_at": "2026-10-17T03:37:49Z", "title": "x", "body": "bind health 127.7.7.1:49647, then 7.7.7.7:80, 10.7.7.1 and 7.7.0.1", "milestone": {"title": "v7.7"}}]']]
  [case id=t-version-beside-punctuation want='t:cx-private#1960 t:cx-private#1961 t:cx-private#1962 t:cx-private#1963'
    [issues repo=cx-private '[{"number": 1960, "created_at": "2026-10-17T01:00:00Z", "title": "x", "body": "seen on 7.7.0.", "milestone": {"title": "v7.7"}},
                              {"number": 1961, "created_at": "2026-10-17T01:00:00Z", "title": "a planted tag: version-literal-ok", "body": "the v7.7.0 tag", "milestone": {"title": "v7.7"}},
                              {"number": 1962, "created_at": "2026-10-17T01:00:00Z", "title": "x", "body": "line one\\nv7.7: line two", "milestone": {"title": "v7.7"}},
                              {"number": 1963, "created_at": "2026-10-17T01:00:00Z", "title": "before 7.7.1", "body": "", "milestone": {"title": "v7.7"}}]']]
  [case id=t-body-null want=''
    [issues repo=cx-private '[{"number": 1952, "created_at": "2026-10-16T01:00:00Z", "title": "x", "body": null, "milestone": {"title": "v7.7"}}]']]
  [case id=t-created-at-null-is-judged want='t:cx-private#1953'
    [issues repo=cx-private '[{"number": 1953, "created_at": null, "title": "v7.8 later", "milestone": {"title": "v7.8"}}]']]
  [case id=t-created-at-offset-is-judged want='t:cx-private#1954'
    [issues repo=cx-private '[{"number": 1954, "created_at": "2026-10-03T01:00:00+02:00", "title": "v7.8 later", "milestone": {"title": "v7.8"}}]']]
  [case id=m-and-t-in-order want='m:cx-examples#9 t:cx-examples#8'
    [issues repo=cx-examples '[{"number": 8, "created_at": "2026-10-16T02:00:00Z", "title": "v7.7 x", "milestone": {"title": "v7.7"}},
                               {"number": 9, "created_at": "2026-09-01T00:00:00Z", "title": "x", "milestone": null}]']]

  [; What a refusal PRINTS (run4 of batch H4: the flow's red message tails the
     step's stdout). A case with [line] rows grades every printed line, in
     order: the key, why, the issue's title and the fix. ]
  [case id=line-m-names-milestone-and-fix want='m:cx-private#1802'
    [issues repo=cx-private '[{"number": 1802, "created_at": "2026-09-01T00:00:00Z", "title": "a parked thing", "milestone": {"title": "store phase 1"}}]']
    [line "issue-label-gate: REFUSED m:cx-private#1802 -- on the milestone 'store phase 1', not one of v7.7 / v7.8 / Backlog (MS-1): 'a parked thing' -- fix: gh issue edit 1802 --repo cx-home/cx-private --milestone v7.7 (or v7.8, or Backlog)"]]
  [case id=line-m-none want='m:cx-platform-xap#6'
    [issues repo=cx-platform-xap '[{"number": 6, "created_at": "2026-09-01T00:00:00Z", "title": "the umbrella panics", "milestone": null}]']
    [line "issue-label-gate: REFUSED m:cx-platform-xap#6 -- on no milestone, not one of v7.7 / v7.8 / Backlog (MS-1): 'the umbrella panics' -- fix: gh issue edit 6 --repo cx-home/cx-platform-xap --milestone v7.7 (or v7.8, or Backlog)"]]
  [case id=line-t-names-the-version want='t:cx-private#1955'
    [issues repo=cx-private '[{"number": 1955, "created_at": "2026-10-16T03:00:00Z", "title": "the runner failed", "body": "first seen on v7.7", "milestone": {"title": "v7.7"}}]']
    [line "issue-label-gate: REFUSED t:cx-private#1955 -- created 2026-10-16T03:00:00Z, after NOVER-1, and names the version 'v7.7' in its title or body (the milestone carries the release): 'the runner failed' -- fix: gh issue edit 1955 --repo cx-home/cx-private --title/--body without the version"]]

  [; A read that failed (exit 2) is the ENVIRONMENT, not a milestone refusal:
     its own sentence, so an unreachable GitHub (no gh, no auth, no network)
     is never read as an issue off its milestone. ]
  [read-case id=read-gh-not-authenticated repo=cx-private why='`gh api` exited 4: To get started with GitHub CLI, please run:  gh auth login'
    want="issue-label-gate: ENVIRONMENT -- the open issues of cx-private could not be read (`gh api` exited 4: To get started with GitHub CLI, please run:  gh auth login); nothing was judged, this is not a milestone refusal (exit 2)"]
  [read-case id=read-gh-absent repo=cx-platform-xap why='gh could not be run: no such file'
    want="issue-label-gate: ENVIRONMENT -- the open issues of cx-platform-xap could not be read (gh could not be run: no such file); nothing was judged, this is not a milestone refusal (exit 2)"]
]
