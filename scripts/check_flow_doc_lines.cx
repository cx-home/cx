# scripts/check_flow_doc_lines.cx -- every flow document's DOCUMENTED command
# line runs as written (#1688, RULED: CXF-8).
#
# WHY. A flow document's header tells its reader how to check it:
# `cx flow validate <doc> --env <env> …`, and each simulated-path results file
# says `cx flow simulate <doc> <results> --env <env> …`. Those lines are
# examples, and AGENTS.md rule 2 says an example no fixture backs is a
# liability: flows/repo-gate.flow.cx's validate line carried no `--allow-read`
# for a year and was refused CXER0271 exactly as written (the env document
# imports ./flows/repo-acts.cx, and a path-form [?lib] charges read, #1539) —
# the dogfood gate ran its OWN argv beside the header, never the header's.
#
# WHAT IT DOES. For every flow document, env program and simulated-results file
# under flows/ and docs-src/flow/ — in this tree and in the pinned
# cx-platform-flow (deps/cx-platform-flow/) — it reads the comment lines,
# joins a line ending in `\` with the next, and RUNS each one that starts
# `cx flow validate` or `cx flow simulate` as written: the leading `cx` is the
# binary under grade (CX_BIN), every other token is passed verbatim, and the
# working directory is the repository root that owns the document (a relative
# [?lib] resolves against it). A line passes when it exits 0 and its answer is
# its own answer: `validate` must answer `[valid …]` and `simulate`
# `[simulation …]` (a refusal can print a CXER0271 on
# stdout at exit 0, so the status alone would pass the very line #1688 found).
#
# WHAT IT DOES NOT RUN, said out loud: `cx flow run` lines. A run performs its
# acts — the repository gate's are `make build-vcx` and `make <target>` — and
# nesting make inside the matrix is what the dogfood gate already refuses to
# do; the run surface is graded by cx-platform-flow's real/flow_cli.cx (its
# GRANT case runs repo-gate to :done). A tree with NO documented line is a
# failure, never a pass over nothing.
#
# Run via:  CX_BIN=<cx> cx --allow-read --allow-write --allow-env --allow-subprocess scripts/check_flow_doc_lines.cx
# (`--allow-write` is the report: a line to a standard stream is a write.)

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/fp'      as=fp]

[?def cry scope=private impure ($s) [$io:write-line [$env:stderr] $s]]
[?def cat scope=private pure [returns string] ($parts) [$strings:join $parts '']]
[?def cat-seqs scope=private ($ss) [$fp:flat-map $ss [?fn ($x) $x]]]

# the repository roots this tree grades, each with the directories its flow
# documents live in. A pinned repository absent from deps/ is a refusal, not
# a skip: a check over half the documents is not this check.
[?const ROOTS ('.', 'deps/cx-platform-flow')]
[?const PATTERNS ('flows/*.cx', 'flows/sim/*.cx', 'flows/sim/*/*.cx', 'docs-src/flow/*.cx')]

# comment-texts: a file's comment lines with the leading `#` run and the
# surrounding spacing removed, in order.
[?def comment-texts scope=private impure [returns any] ($path)
  [?to-array [?for [in $l [$strings:split-lines [$io:read-file $path]]]
    [where [$strings:starts-with [$strings:trim $l] "#"]]
    [yield [$strings:trim [$strings:trim-start-chars [$strings:trim $l] "#"]]]]]]

# assemble: the command starting at comment line i, its `\` continuations
# joined with a space.
[?def assemble scope=private pure [returns string] ($ts $i)
  [?let [= $t [$nth $ts $i]]
    [?if [and [$strings:ends-with $t "\\"] [< $i [$count $ts]]]
      [then [$cat ([$strings:trim [$strings:trim-end-chars $t "\\"]], " ", [$assemble $ts [+ $i 1]])]]
      [else $t]]]]

[?def documented scope=private pure [returns bool] ($t)
  [or [$strings:starts-with $t "cx flow validate "] [$strings:starts-with $t "cx flow simulate "]]]

# lines-of: every documented validate/simulate line of one file, as
# (root, file, line) records.
[?def lines-of scope=private impure [returns any] ($root $file)
  [?let [= $ts [$comment-texts $file]]
    [?to-array [?for [in $i [$range 1 [$count $ts]]]
      [where [$documented [$nth $ts $i]]]
      [yield [rec root=$root file=$file line=[$assemble $ts $i]]]]]]]

# argv-of: the line's tokens with `cx` replaced by the binary; a shell-quoted
# empty value (`--x=""`) is the empty string the shell would pass.
[?def argv-of scope=private pure [returns any] ($bin $line)
  [?let [= $toks [$str-split-whitespace $line]]
    [?to-array [?for [in $i [$range 1 [$count $toks]]]
      [yield [?if [= $i 1] [then $bin]
               [else [$strings:replace [$nth $toks $i] '=""' '=']]]]]]]]

[?def has scope=private pure [returns bool] ($s $needle) [$strings:contains $s $needle]]

# run-line: '' when the documented line runs as written, else why not. The
# answer is the verb's own value on stdout: `validate` answers `[valid …]` and
# `simulate` answers `[simulation …]`. A refusal is printed `cx flow: cx-err:…`
# (on stdout at exit 0 for some, #1688), so the status alone is not the test,
# and a simulated RED path legitimately carries err values inside its answer,
# so "no cx-err anywhere" is not the test either.
[?def run-line scope=private impure [returns string] ($bin $r)
  [?let [= $p [$process:run [$argv-of $bin $r@line] cwd=$r@root]]
        [= $stdout [$strings:trim [$string $p@stdout]]]
        [= $out [$cat ($stdout, " ", [$strings:trim [$string $p@stderr]])]]
        [= $want [?if [$strings:starts-with $r@line "cx flow validate "] [then "[valid"] [else "[simulation"]]]
        [= $where $r@file]
    [?if [not [= [$string $p@exit-code] '0']]
      [then [$cat ($where, ": `", $r@line, "` exits ", [$string $p@exit-code], " as written -- ", [$strings:slice $out 1 400])]]
      [else [?if [not [$strings:starts-with $stdout $want]]
        [then [$cat ($where, ": `", $r@line, "` does not answer ", $want, " …] as written -- ", [$strings:slice $out 1 400])]]
        [else '']]]]]]

[?let [= $bin [$strings:trim [$env:var-or-default 'CX_BIN' '']]]
      [= $_bin [?if [= $bin '']
        [then ([$cry "check-flow-doc-lines: REFUSED -- CX_BIN is not set; name the cx under grade"], [$env:exit 2])]
        [else ()]]]
      [= $missing [?to-array [?for [in $root ROOTS]
        [where [not [$io:is-directory [$cat ($root, '/flows')]]]]
        [yield $root]]]]
      [= $_m [?if [> [$count $missing] 0]
        [then ([$cry [$cat ("check-flow-doc-lines: REFUSED -- no flows/ under ", [$strings:join $missing ', '],
                             "; the pins are not synced (make deps-sync), and a check over half the documents is not this check")]],
               [$env:exit 2])]
        [else ()]]]
      [= $records [$cat-seqs [?to-array [?for [in $root ROOTS]
        [in $pat PATTERNS]
        [= $prefix [?if [= $root '.'] [then ''] [else [$cat ($root, '/')]]]]
        [in $hit [$io:glob [$cat ($prefix, $pat)]]]
        [yield [$lines-of $root $hit]]]]]]
      [= $_e [?if [= [$count $records] 0]
        [then ([$cry "check-flow-doc-lines: REFUSED -- no documented `cx flow validate|simulate` line found; a check over nothing is not a pass"],
               [$env:exit 2])]
        [else ()]]]
      [= $fails [?to-array [?for [in $r $records]
        [= $why [$run-line $bin $r]]
        [where [not [= $why '']]]
        [yield $why]]]]
  [?if [> [$count $fails] 0]
    [then ([?for [in $f $fails] [yield [$cry [$cat ("check-flow-doc-lines: ", $f)]]]],
           [$cry [$cat ("check-flow-doc-lines FAILED -- ", [$string [$count $fails]], " of ", [$string [$count $records]],
                        " documented flow line(s) do not run as written (#1688, CXF-8)")]],
           [$env:exit 1])]
    [else ([$io:write-line [$env:stdout] [$cat ("check-flow-doc-lines OK -- ", [$string [$count $records]],
                                                " documented `cx flow validate|simulate` line(s) run as written")]],
           [$env:exit 0])]]]
