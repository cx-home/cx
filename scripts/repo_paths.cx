# scripts/repo_paths.cx — the path list of ONE repository, for the history
# filter (#1591 item 10, RULED: RS-7; RS-12 is the extraction order it feeds).
#
# Brought in from the sso extraction prep's tools/repo_files.cx (the first-match
# path lister written for #1591 item 11) and extended here with the rename
# closure its own REPORT.md flag F-10 asked for. The matcher below — rule-key,
# rule-matches, first-rule — is scripts/repos_allocation_gate.cx's, unchanged,
# so this program and the gate can never disagree about where a file lands:
# they apply the same rule, in the same document order, to the same file list.
#
# Written in CX (AGENTS.md rule 6). Run from a cx-private checkout root:
#
#   cx --allow-all scripts/repo_paths.cx cx-platform-sso
#   cx --allow-all scripts/repo_paths.cx cx-platform-sso --with-history
#   cx --allow-all scripts/repo_paths.cx cx
#   cx --allow-all scripts/repo_paths.cx cx --with-history --published=<git-dir>
#   cx --allow-all scripts/repo_paths.cx --self-test
#
# The repository is the argument EQUAL to a `[repo name=]` of the registry (the
# first such name in document order), so the front door `cx` is named like any
# other; an argument naming no row gets the usage refusal (#1658).
#
# Output: one path per line on stdout, in `git ls-files` order, then a census
# line on stderr. With REPO_PATHS_RULES=1 each line is `<path>\t<rule>`, so the
# rule that placed a file reads off beside it.
#
# --with-history adds the paths the live ones USED to have, derived per file
# with `git log --follow --diff-filter=AR`. Those paths no longer exist and no
# allocation rule can name them, but `git filter-repo` needs them or it
# silently truncates a file's history at its last rename — the sso prep found
# exactly two (`spec/03-approved/std-lib/sso.md`, `conformance/stdlib/sso.cxd`,
# both from the #1427 ring move) and without them the spec's and the corpus's
# history stopped there. A truncated history is not a failure anyone sees.
#
# --published=<git-dir> (with --with-history; RULED: REFR-1, cx-private#1800)
# adds the paths a PUBLISHED history carries that H no longer tracks: the
# history of <git-dir>'s main, every path any of its commits added, deleted or
# changed. A refresh derives the public history again from the whole private
# ancestry, so a path the list drops loses its history in every commit since
# it was added: deleting a published file (bench/repr/run.sh, 57dd5f925)
# rewrote 4 500 published commits and the push was no fast-forward. The
# deleted file's history is already public, so it stays. A published path
# H's rules now send to ANOTHER repository is left out and named on stderr:
# that is an allocation change, and its non-fast-forward is the forced push
# Letter 12 (a) describes, never a silent publication of the other repo's
# commits. An unreadable <git-dir> is exit 2, never a shorter list.
#
# cx-tooling's tooling/repo-template/HISTORY-FILTER.md is the `git filter-repo` invocation
# that consumes this list.
#
# Exit: 0 the list was produced, 1 no repository named / no file allocated to
# it, 2 the registry is unreadable.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]

[?def say scope=private impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=private impure ($s) [$io:write-line [$env:stderr] $s]]

[?def member scope=private pure [returns bool] ($x::string $xs)
  [> [$count [?for [in $y $xs] [where [= $y $x]] [yield 1]]] 0]]

# -- the matcher: scripts/repos_allocation_gate.cx's, unchanged --------------

[?def rule-key scope=private pure [returns string] ($r)
  [?let [= $e [$string [?else $r@exact ""]]]
        [= $p [$string [?else $r@prefix ""]]]
    [?if [not [= $e ""]] [then [$concat "exact=" $e]] [else [$concat "prefix=" $p]]]]]

[?def rule-matches scope=private pure [returns bool] ($r $f::string)
  [?let [= $e [$string [?else $r@exact ""]]]
        [= $p [$string [?else $r@prefix ""]]]
    [?if [not [= $e ""]]
      [then [= $e $f]]
      [else [?if [not [= $p ""]]
              [then [$strings:starts-with $f $p]]
              [else false]]]]]]

[?def first-rule scope=private pure ($rules $f::string)
  [?let [= $hits [?for [in $r $rules] [where [$rule-matches $r $f]]
                   [yield [hit repo=[$string $r@repo] key=[$rule-key $r]]]]]
    [?if [= [$count $hits] 0] [then [miss]] [else [$first $hits]]]]]

[?def nonblank scope=private pure ($text::string)
  [?for [in $l [$strings:split-lines $text]]
    [where [not [= [$strings:trim $l] ""]]]
    [yield [$strings:trim $l]]]]

# allocs: every file with the repo the first matching rule sends it to.
[?def allocs scope=private pure ($rules $files)
  [?for [in $f $files]
    [yield [?let [= $h [$first-rule $rules $f]]
             [a file=$f
                repo=[?match $h [case [miss] ""] [else [$string $h@repo]]]
                key=[?match $h [case [miss] "<none>"] [else [$string $h@key]]]]]]]]

# claimed: the files $rules send to $want, in the order they arrive.
[?def claimed scope=private pure ($rules $files $want::string)
  [?for [in $a [$allocs $rules $files]] [where [= [$string $a@repo] $want]] [yield $a]]]

# -- which repository the command line names --------------------------------

# pick-repo: the repository the arguments name -- the first declared name, in
# registry/repos.cxd's document order, that some argument EQUALS; "" when none
# does (the caller refuses with the usage line). #1658: the front door's row
# is [repo name=cx] and the working tree's is [repo name=cx-private], so the
# prefix test this replaced (the first argument starting `cx-`) could name
# neither, and it took an undeclared `cx-` word for a repository.
[?def pick-repo scope=private pure [returns string] ($argv $declared)
  [$string [?else [$first [?for [in $n $declared]
                             [where [$member $n $argv]]
                             [yield $n]]] ""]]]

# -- the rename closure (the prep's flag F-10) ------------------------------

# `git log --follow` restricts the walk to ONE file's chain, so every rename
# line in its output is a link of that chain and the SOURCE of each is a path
# the file used to have. Reading `--name-status` rather than `--name-only` is
# what keeps it exact: `--name-only` also prints the other side of a rename
# commit, and on this tree that put two unrelated `.gitkeep` paths in the list.
[?def former-paths scope=private impure ($path::string)
  [?let [= $r [$process:run ("git", "log", "--follow", "--name-status",
                             "--format=", "--", $path)]]
    [?if [not [= [$string $r@exit-code] "0"]]
      [then ()]
      [else [?for [in $l [$nonblank [$string $r@stdout]]]
              [where [$strings:starts-with $l "R"]]
              [in $f [?let [= $cols [$strings:split $l "\t"]]
                       [?if [< [$count $cols] 2] [then ()] [else ([$nth $cols 2])]]]]
              [yield $f]]]]]]

# -- the published history (--published=<git-dir>) --------------------------

# published-arg: the <git-dir> of the first `--published=` argument, "" when
# none names one.
[?def published-arg scope=private pure [returns string] ($argv)
  [$string [?else [$first [?for [in $a $argv]
                             [where [$strings:starts-with [$string $a] "--published="]]
                             [yield [$strings:replace [$string $a] "--published=" ""]]]] ""]]]

# history-paths: every path a commit of <git-dir>'s main added, deleted or
# changed. `-m` reads a merge against each parent and `--no-renames` names both
# sides of a rename, so no path that was ever in a published tree is missed.
[?def history-paths scope=private impure ($gitdir::string)
  [$process:run ("git", "--git-dir", $gitdir, "log", "-m", "--no-renames", "--name-only", "--format=", "main")]]

# -- the self-test: the matcher, red on a synthetic violation ----------------
#
# #1591: "Every moved gate is red-proofed on a synthetic violation before its
# row moves." The property here is that the emitted list is EXACTLY first-match
# — specific rules above general ones win, a shadowed rule contributes nothing,
# and a file no rule claims is in no list at all.

[?if [$member "--self-test" [$env:argv]]
  [then
    [?let
      [= $reg [$cx:parse "[repo-allocation
        [repo name=a] [repo name=b]
        [path exact='x/one.md' repo=a]
        [path prefix='x/' repo=b]
        [path prefix='x/one' repo=a]
      ]"]]
      [= $rules [?for [in $r $reg//path] [yield $r]]]
      [= $files ("x/one.md", "x/two.md", "z/none.md")]
      [= $a-list [?for [in $h [$claimed $rules $files "a"]] [yield [$string $h@file]]]]
      [= $b-list [?for [in $h [$claimed $rules $files "b"]] [yield [$string $h@file]]]]
      [= $got [$concat "a=[" [$strings:join $a-list " "] "] b=[" [$strings:join $b-list " "] "]"]]
      [= $want "a=[x/one.md] b=[x/two.md]"]
      # The front door (#1658): the argument is the one EQUAL to a declared
      # name, in the registry's document order -- `cx` and `cx-private` are
      # names like any other, a flag or an undeclared `cx-` word is not.
      [= $names ("cx", "cx-platform-sso", "cx-private")]
      [= $picks ([$pick-repo ("cx") $names],
                 [$pick-repo ("--with-history", "cx") $names],
                 [$pick-repo ("cx-private", "--with-history") $names],
                 [$pick-repo ("cx-private", "cx") $names],
                 [$pick-repo ("cx-nope") $names],
                 [$pick-repo ("--with-history") $names])]
      [= $got-pick [$strings:join $picks "|"]]
      [= $want-pick "cx|cx|cx-private|cx||"]
      [?if [and [= $got $want] [= $got-pick $want-pick]]
        [then [?let [= $_ [$say [$concat "repo-paths self-test OK -- first match wins (x/one.md to a, not b), "
                                         "the shadowed prefix=x/one rule adds nothing, and an unclaimed file "
                                         "(z/none.md) is in no list: " $got
                                         "; the argument equal to a declared name is the repository, in "
                                         "document order (cx and cx-private included, a flag or an undeclared "
                                         "cx- word refused): " $got-pick]]]
                [$env:exit 0]]]
        [else [?let [= $_ [$cry [$concat "repo-paths self-test FAILED -- want " $want " got " $got
                                         "; picks want " $want-pick " got " $got-pick]]]
                [$env:exit 1]]]]]]
  [else ""]]

# -- the run ----------------------------------------------------------------

[?let [= $reg-path "registry/repos.cxd"]
  [?if [not [$io:exists $reg-path]]
    [then [?let [= $_ [$cry [$concat "repo-paths: cannot read " $reg-path " -- run from the checkout root"]]]
            [$env:exit 2]]]
    [else ""]]]

[?let
  [= $argv [$env:argv]]
  [= $reg [$cx:parse [$io:read-file "registry/repos.cxd"]]]
  [= $rules [?for [in $r $reg//path] [yield $r]]]
  [= $declared [?for [in $r $reg//repo] [yield [$string $r@name]]]]
  [= $want [$pick-repo $argv $declared]]
  [= $_no-repo [?if [= $want ""]
                 [then [?let [= $_ [$cry "repo-paths: name a repository, as registry/repos.cxd spells it (e.g. cx, cx-platform-sso) -- no argument equals a [repo name=] there"]]
                         [$env:exit 1]]]
                 [else ()]]]
  [= $history [$member "--with-history" $argv]]
  [= $withrules [= [$string [$env:var-or-default "REPO_PATHS_RULES" ""]] "1"]]
  [= $files [?let [= $r [$process:run ("git", "ls-files")]]
              [?if [not [= [$string $r@exit-code] "0"]]
                [then [?let [= $_ [$cry [$concat "repo-paths: git ls-files failed: " [$string $r@stderr]]]]
                        [?let [= $_x [$env:exit 2]] ()]]]
                [else [$nonblank [$string $r@stdout]]]]]]
  [= $mine [$claimed $rules $files $want]]
  [= $live [?for [in $h $mine] [yield [$string $h@file]]]]
  [= $pairs [?if $history
              [then [?for [in $p $live] [in $q [$former-paths $p]]
                      [where [not [$member $q $live]]]
                      [yield [f path=$q from=$p]]]]
              [else ()]]]
  [= $former [?for [in $x $pairs] [group-by [$string $x@path]] [yield $key]]]
  # the published paths H no longer tracks (--published=, REFR-1): kept when
  # H's rules send them nowhere else, named and left out when they do.
  [= $pubdir [?if $history [then [$published-arg $argv]] [else ""]]]
  [= $ph [?if [= $pubdir ""] [then ""] [else [$history-paths $pubdir]]]]
  [= $_no-pub [?if [= $pubdir ""] [then ()]
                [else [?if [= [$string $ph@exit-code] "0"] [then ()]
                  [else [?let [= $_ [$cry [$concat "repo-paths: --published=" $pubdir " -- git log of its main failed: "
                                                   [$strings:trim [$string $ph@stderr]]]]]
                          [$env:exit 2]]]]]]]
  [= $gone [?if [= $pubdir ""] [then ()]
             [else [?for [in $q [?to-sequence [?for [in $l [$nonblank [$string $ph@stdout]]] [group-by $l] [yield $key]]]]
                     [where [not [or [$member $q $files] [$member $q $former]]]]
                     [yield [?let [= $h [$first-rule $rules $q]]
                              [g path=$q repo=[?match $h [case [miss] ""] [else [$string $h@repo]]]]]]]]]]
  [= $published [?for [in $g $gone] [where [$member [$string $g@repo] ("", $want)]] [yield [$string $g@path]]]]
  [= $elsewhere [?for [in $g $gone] [where [not [$member [$string $g@repo] ("", $want)]]] [yield $g]]]
  [= $_p [?for [in $h $mine]
           [yield [$say [?if $withrules
                          [then [$concat [$string $h@file] "	" [$string $h@key]]]
                          [else [$string $h@file]]]]]]]
  [= $_h [?for [in $q $former]
           [yield [$say [?if $withrules
                          [then [$concat $q "	<renamed away; no rule claims it>"]]
                          [else $q]]]]]]
  [= $_g [?for [in $q $published]
           [yield [$say [?if $withrules
                          [then [$concat $q "	<published; H no longer tracks it>"]]
                          [else $q]]]]]]
  # Every former path, on stderr, beside the live path `--follow` derived it
  # from. READ THIS LIST. `--follow` can chase a rename between two files that
  # merely have the same content: measured on this tree,
  # examples/platform/sso/deployment/expected.txt follows back to
  # spec/misc/.gitkeep at R100. A wrong entry carries an unrelated file's
  # history into the new repository, which is why the list is reviewed rather
  # than piped straight into `git filter-repo`.
  [= $_hr [?for [in $x $pairs]
            [yield [$cry [$concat "  " [$string $x@path] "  <- --follow from " [$string $x@from]]]]]]
  [= $_gr [?for [in $q $published] [yield [$cry [$concat "  " $q "  <- published, H no longer tracks it"]]]]]
  [= $_er [?for [in $g $elsewhere]
            [yield [$cry [$concat "  " [$string $g@path] "  <- published, but H's rules send it to "
                                  [$string $g@repo] ": left out (an allocation change)"]]]]]
  [= $_c [$cry [$concat $want ": " [$string [$count $live]] " of " [$string [$count $files]] " tracked files"
                        [?if $history
                          [then [$concat ", plus " [$string [$count $former]] " former path(s) the rename closure adds"]]
                          [else ""]]
                        [?if [= $pubdir ""] [then ""]
                          [else [$concat ", plus " [$string [$count $published]] " published path(s) H no longer tracks"
                                         [?if [= [$count $elsewhere] 0] [then ""]
                                           [else [$concat " (" [$string [$count $elsewhere]] " left out: the rules send them elsewhere)"]]]]]]]]]
  [?if [= [$count $live] 0]
    [then [?let [= $_ [$cry [$concat "repo-paths: no tracked file lands in " $want]]] [$env:exit 1]]]
    [else [$env:exit 0]]]]
