# scripts/stdlib_catalog_gate.cx -- stdlib catalog drift gate.
#
# Eat-our-own-dog-food: this gate is written entirely in CX and runs
# as `cx <file>`. It verifies ONE invariant about the standard-library
# catalog, whose single source of truth is the [module-meta ...] block
# fenced near the top of each spec under spec/03-approved/std-lib/*.md:
#
#     SPEC_SET == (BUNDLE_SET union DISPATCH_SET)
#     SYNTH_SET == CODEC_SET - (BUNDLE_SET union DISPATCH_SET)
#
# where
#   SPEC_SET     = name= of every [module-meta] with status=current in
#                  spec/03-approved/std-lib/*.md. status=new modules
#                  (e.g. xap in spec/01-new) are EXCLUDED -- not yet
#                  implemented.
#   BUNDLE_SET   = basenames of stdlib/*.cx (the .cx stripped).
#   DISPATCH_SET = every <name>_stdlib_builtin prefix in
#                  vcx/code/stdlib_dispatch.v, deduplicated.
#   SYNTH_SET    = `cx stdlib list --synthesized` -- the SYNTHESIZED codec
#                  module surfaces (vcx/code/stdlib_bundle.v ::
#                  register_bundled_codecs). They have NO file on disk, so
#                  no glob can see them.
#   CODEC_SET    = `cx stdlib list --codecs` -- every codec with a full TEXT
#                  contract that is not a dialect of another, derived from
#                  the codec registry (codec.md §3/§4, §6's one source of
#                  truth). This is the INDEPENDENT basis SYNTH_SET is
#                  measured against.
#
# The gate FAILS (process exit 1) when any direction breaks:
#   (1) a SPEC_SET module is in neither BUNDLE_SET nor DISPATCH_SET
#       -- a specced module with no implementation; OR
#   (2) a BUNDLE_SET/DISPATCH_SET module is not in SPEC_SET
#       -- an orphan impl/bundle with no spec; OR
#   (3) a CODEC_SET codec with no bundle and no dispatch is missing from
#       SYNTH_SET -- codec.md §3 mandates its `[?lib 'cx-stdlib/<c>']`
#       surface and nothing synthesizes it; OR
#   (4) a SYNTH_SET name is not a CODEC_SET codec, or already ships a
#       bundle/dispatch module -- a synthesized surface over something that
#       is not (or no longer needs to be) synthesized; OR
#   (5) a SYNTH_SET name also has a status=current std-lib spec page --
#       2(c) rules these modules EXEMPT from SPEC_SET, their normative text
#       being codec.md §3 itself, so a page would be a second source.
#
# Why (3)/(4) exist at all (#1368, RULED: 1368-a). Before them the invariant
# held VACUOUSLY for five shipping modules: `cx`, `xml`, `yaml`, `toml` and
# `md` reach a program through `register_bundled_codecs`, a FOURTH
# registration path, and appeared in none of the three sets -- not exempted,
# unseen. A set that is only listed is not checked, so SYNTH_SET is compared
# against CODEC_SET, which a DIFFERENT function derives from the registry:
# drop a name from the enumeration in stdlib_bundle.v and (3) reds.
#
# On success it writes a one-line OK to stdout and exits 0.
#
# -- Output / exit mechanism --------------------------------------------
# A normal CLI shape: write the human-facing report with cx-stdlib/io's
# `write-line` to the cx-stdlib/env standard-stream handle -- stdout on the
# happy path, stderr on drift -- then terminate with `env:exit <code>` (0
# pass / 1 fail). `write-line` to a std-stream flushes immediately, and
# `env:exit` flushes pending stdout/stderr before terminating, so no output
# is lost. Effect-then-exit is sequenced with `[?let]` (bind the write, then
# evaluate the exit in the body). (NOTE: `[- a b]` is the subtraction
# operator; block comments are `[; … ]` and `#` runs to end-of-line.)
#
# Capabilities: glob / read-file need `read`; write-line needs `write`;
# the env standard streams + exit are ambient (never gated, env.md §7).
# Run via:  vcx/target/cx --allow-all scripts/stdlib_catalog_gate.cx
# (flags bind BEFORE the file — everything after the file is program args.)
# (or:      make stdlib-catalog-gate)

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]

# -- helpers ------------------------------------------------------------
# has-name: set membership, the idiom this gate already used inline.
[?def has-name scope=private pure [returns bool] ($set::[sequence string] $x::string)
  [> [$count [?for [in $s $set] [where [= $s $x]] [yield $s]]] 0]]

# cx-lines: one `cx stdlib list <flag>` run, its stdout split into non-empty
# lines. The binary is the RUNNING one ([$env:executable-path]) -- the gate
# must interrogate the toolchain it is gating, never a stale one on PATH. A
# non-zero exit is fatal with exit 2 (a usage failure, distinct from the
# gate's own 1 = drift), because an absence-based check cannot report its own
# death: an empty listing read as "no synthesized modules" would pass every
# direction below while measuring nothing.
[?def cx-lines scope=private impure [returns any] ($flag::string)
  [?let [= $bin [$env:executable-path]]
        [= $r [$process:run ($bin, 'stdlib', 'list', $flag)]]
    [?if [not [= $r@exit-code 0]]
      [then ([$io:write-line [$env:stderr]
               [$concat "stdlib-catalog-gate: `cx stdlib list " $flag "` failed (exit "
                        [$string $r@exit-code] ") -- cannot enumerate the synthesized set"]],
             [$env:exit 2], ())]
      [else [?for [in $l [$strings:split [$string $r@stdout] "\n"]]
              [where [not [= $l ""]]]
              [yield $l]]]]]]

# -- SPEC_SET -----------------------------------------------------------
# One [module-meta name=... tier=... status=...] line per spec file. Pull
# the name= and status= via RE2; keep only status=current.
[?let [= $meta-rx [$re:compile "\\[module-meta name=([a-z0-9_]+) tier=[A-D] status=([a-z]+)"]]
      # -- SYNTH_SET / CODEC_SET (the fourth registration path) ----------
      # Both come from the RUNNING binary's loader and registry, not from a
      # glob: these modules have no file to glob. Bound HERE, in the outermost
      # [?let], because they depend on nothing above them.
      [= $synth-set [$cx-lines '--synthesized']]
      [= $codec-set [$cx-lines '--codecs']]

  [?let [= $spec-set
    [?for [in $f [$io:glob "spec/03-approved/std-lib/*.md"]]
      [= $m [$re:find $meta-rx [$io:read-file $f]]]
      [where [not [?match $m [case [no-match] true] [else false]]]]
      [where [= [$re:group $m 2] "current"]]
      [yield [$re:group $m 1]]]]

    # -- BUNDLE_SET -----------------------------------------------------
    # basenames of stdlib/*.cx with the extension stripped.
    [?let [= $bundle-set
      [?for [in $b [$io:glob "stdlib/*.cx"]]
        [yield [$path:stem $b]]]]

      # -- DISPATCH_SET -------------------------------------------------
      # every <name>_stdlib_builtin prefix across BOTH dispatch halves:
      # the Ring-1 chain (vcx/code/stdlib_dispatch.v) and the Ring-2
      # registrations (vcx/platform/ring2_register.v) — the I3 ring split
      # moved the platform modules' dispatch behind the seam-G registry,
      # so reading only the code/ half reports them as unimplemented
      # (same both-halves rule as check-completions-drift). find-all
      # yields one match per occurrence; the membership tests below
      # tolerate duplicates and the orphan walk dedups explicitly.
      # Normalizations: the seam-H split serves http as two halves
      # (http_client_stdlib_builtin Ring 1 / http_serve_stdlib_builtin
      # Ring 2) — the catalog module is still `http`; `ring2` is the
      # seam probe itself, not a module, and is excluded.
      [?let [= $dispatch-rx [$re:compile "([a-z0-9_]+)_stdlib_builtin"]]
             [= $dispatch-raw [$concat [$io:read-file "vcx/code/stdlib_dispatch.v"]
                                       [$io:read-file "vcx/platform/ring2_register.v"]]]
        [?let [= $dispatch-set
          [?for [in $dm [$re:find-all $dispatch-rx $dispatch-raw]]
            [where [not [= [$re:group $dm 1] "ring2"]]]
            [yield [?if [or [= [$re:group $dm 1] "http_client"]
                            [= [$re:group $dm 1] "http_serve"]]
              [then "http"]
              [else [$re:group $dm 1]]]]]]


          # -- Direction (1): specced modules with no implementation.
          # A spec module is satisfied iff it is a member of BUNDLE_SET
          # OR DISPATCH_SET.
          [?let [= $missing
            [?for [in $s $spec-set]
              [where [not [or
                [> [$count [?for [in $bx $bundle-set]   [where [= $bx $s]] [yield $bx]]] 0]
                [> [$count [?for [in $dx $dispatch-set] [where [= $dx $s]] [yield $dx]]] 0]]]]
              [yield $s]]]

            # -- Direction (2): orphan impls/bundles with no spec.
            # Walk BUNDLE_SET; then DISPATCH_SET, skipping any name already
            # in BUNDLE_SET so the union is reported once. Membership of
            # $spec-set decides the orphan condition.
            [?let [= $orphan-bundle
              [?for [in $b $bundle-set]
                [where [not [> [$count [?for [in $sx $spec-set] [where [= $sx $b]] [yield $sx]]] 0]]]
                [yield $b]]]

              [?let [= $orphan-dispatch
                [?for [in $d $dispatch-set]
                  [where [not [> [$count [?for [in $bx $bundle-set] [where [= $bx $d]] [yield $bx]]] 0]]]
                  [where [not [> [$count [?for [in $sx $spec-set]   [where [= $sx $d]] [yield $sx]]] 0]]]
                  [yield $d]]]

              # -- Direction (3): a text codec nobody surfaces. codec.md §3
              # mandates `[?lib 'cx-stdlib/<c>']` for every codec with a full
              # text contract; a codec that ships neither a bundle module nor
              # a native dispatch module must therefore be SYNTHESIZED. This
              # is the direction that makes the enumeration a CHECK: drop a
              # name from bundled_codec_module_names() and it fires.
              [?let [= $synth-missing
                [?for [in $c $codec-set]
                  [where [not [$has-name $bundle-set $c]]]
                  [where [not [$has-name $dispatch-set $c]]]
                  [where [not [$has-name $synth-set $c]]]
                  [yield $c]]]

              # -- Direction (4): a synthesized surface over something that
              # is not a text codec, or that already ships a real module.
              [?let [= $synth-extra
                [?for [in $y $synth-set]
                  [where [or [not [$has-name $codec-set $y]]
                             [or [$has-name $bundle-set $y] [$has-name $dispatch-set $y]]]]
                  [yield $y]]]

              # -- Direction (5): 2(c)'s exemption, enforced in the one
              # direction it can break. A synthesized module is exempt from
              # SPEC_SET because codec.md §3 IS its normative text; a std-lib
              # page for one would be a SECOND source of truth for a surface
              # that is generated — the drift the synthesis exists to prevent.
              [?let [= $synth-specced
                [?for [in $y $synth-set]
                  [where [$has-name $spec-set $y]]
                  [yield $y]]]

                # Pre-format each violation list into one line per module.
                # An empty list joins to "" and is dropped below.
                [?let [= $missing-lines
                  [?for [in $s $missing]
                    [yield [$concat "  [specced, no impl]  " $s "  -- in SPEC_SET but in neither BUNDLE_SET nor DISPATCH_SET"]]]]
                  [?let [= $orphan-bundle-lines
                    [?for [in $b $orphan-bundle]
                      [yield [$concat "  [orphan bundle]     " $b "  -- stdlib/" $b ".cx exists but no status=current spec"]]]]
                    [?let [= $orphan-dispatch-lines
                      [?for [in $d $orphan-dispatch]
                        [yield [$concat "  [orphan dispatch]   " $d "  -- " $d "_stdlib_builtin dispatched but no status=current spec"]]]]
                      [?let [= $synth-missing-lines
                        [?for [in $c $synth-missing]
                          [yield [$concat "  [codec, no surface] " $c "  -- a full text codec with no stdlib/" $c ".cx, no " $c "_stdlib_builtin and no synthesized module; codec.md §3 mandates [?lib 'cx-stdlib/" $c "']"]]]]
                        [?let [= $synth-extra-lines
                          [?for [in $y $synth-extra]
                            [yield [$concat "  [orphan synth]      " $y "  -- synthesized as a codec module but not a non-dialect text codec, or already served by a bundle/dispatch module"]]]]
                          [?let [= $synth-specced-lines
                            [?for [in $y $synth-specced]
                              [yield [$concat "  [synth + spec page] " $y "  -- synthesized modules are EXEMPT from SPEC_SET (codec.md §3 is their normative text); spec/03-approved/std-lib/" $y ".md would be a second source"]]]]

                      [?let [= $n-violations
                        [+ [$count $missing]
                           [+ [$count $orphan-bundle]
                              [+ [$count $orphan-dispatch]
                                 [+ [$count $synth-missing]
                                    [+ [$count $synth-extra] [$count $synth-specced]]]]]]]

                        [?if [= $n-violations 0]
                          # PASS: write a one-line OK to stdout, exit 0.
                          [then
                            [?let [= $_ok [$io:write-line [$env:stdout]
                                [$concat "stdlib-catalog-gate OK -- "
                                  [$count $spec-set]
                                  " specced (status=current) modules, all implemented via bundle and/or dispatch; no orphans. "
                                  [$count $synth-set]
                                  " synthesized codec module(s) of "
                                  [$count $codec-set]
                                  " non-dialect text codec(s), all accounted for."]]]
                              [$env:exit 0]]]

                          # FAIL: gather every non-empty violation block, join
                          # with newlines, prepend a header, write the full
                          # report to stderr, and exit 1.
                          [else
                            [?let [= $blocks
                              [?for [in $blk (
                                  [$strings:join $missing-lines "\n"],
                                  [$strings:join $orphan-bundle-lines "\n"],
                                  [$strings:join $orphan-dispatch-lines "\n"],
                                  [$strings:join $synth-missing-lines "\n"],
                                  [$strings:join $synth-extra-lines "\n"],
                                  [$strings:join $synth-specced-lines "\n"])]
                                [where [not [= $blk ""]]]
                                [yield $blk]]]
                              [?let [= $_fail [$io:write-line [$env:stderr]
                                  [$concat "stdlib catalog drift -- "
                                    $n-violations
                                    " violation(s):\n"
                                    [$strings:join $blocks "\n"]]]]
                                [$env:exit 1]]]]]]]]]]]]]]]]]]]]]]]
