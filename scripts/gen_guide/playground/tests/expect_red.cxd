[playground-examples
 [; FIXTURE CORPUS for #1170 §C4 (RULED: 1170-g) — run only through
    `gen_examples.cx --lint-only <this file>`; never rendered, never pinned.
    One entry whose [expect] IS in the output (green on its own), one whose
    [expect] is NOT (the red this corpus exists to prove), one with no
    [expect] (ungraded). The checker must exit 1 and name `expect-wrong`
    with both the expectation and the output — and, since #1620, name every
    failed example with a non-empty message (06, 07 below). ]
 [ex key=01-expect-right
  [label [# right #]]
  [src [#
[$concat "ab" "cd"]
#]]
  [note [# The answer is `abcd`. #]]
  [expect [# abcd #]]]
 [ex key=02-expect-wrong
  [label [# wrong #]]
  [src [#
[$concat "ab" "cd"]
#]]
  [note [# The note promises `abce`, which the program does not compute. #]]
  [expect [# abce #]]]
 [ex key=03-no-expect
  [label [# ungraded #]]
  [src [#
[$concat "x" "y"]
#]]
  [note [# No expectation pinned — not graded by §C4. #]]]
 [; The [grants] pair (RULED: CXF-2, #1522). 04 and 05 run the SAME program
    under the SAME declared grants and differ only in the pinned expectation,
    so together they pin the field in both directions:
      04 — a wrong expectation under grants still REDS, exactly as an
           ungranted one does. §C4 does not soften for a granted child.
      05 — the right expectation PASSES, which it can only do if the child
           really received `--allow-read --allow-write`. Were the field
           silently dropped, this program would answer CXER0271 and 05 would
           red too — so a green 05 beside a red 04 is the proof that the
           grants reach the child and that the check still grades it. ]
 [ex key=04-expect-wrong-under-grants
  [label [# wrong, under grants #]]
  [grants [# --allow-read --allow-write #]]
  [src [#
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?let [= $d [$io:temp-dir 'cx-expect-red-']]
      [= $f [$path:join $d 'x.txt']]
      [= $w [$io:write-file $f 'granted']]
      [= $back [$io:read-file $f]]
      [= $rm [$io:remove-tree $d]]
  [probe text=$back]]
#]]
  [note [# The program really writes and reads a temp file; the note promises `denied`, which it does not compute. #]]
  [expect [# text=denied #]]]
 [ex key=05-expect-right-under-grants
  [label [# right, under grants #]]
  [grants [# --allow-read --allow-write #]]
  [src [#
[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/path']
[?let [= $d [$io:temp-dir 'cx-expect-red-']]
      [= $f [$path:join $d 'x.txt']]
      [= $w [$io:write-file $f 'granted']]
      [= $back [$io:read-file $f]]
      [= $rm [$io:remove-tree $d]]
  [probe text=$back]]
#]]
  [note [# The same program with the expectation the granted run actually produces. #]]
  [expect [# text=granted #]]]
 [; The silent-failure pair (#1620). The post-merge run on a3b6593e5 printed
    `FAIL  295-send-mail-to-a-server-you-started` and NOTHING after the key: a
    child that exits non-zero with both captures empty left the row's message
    empty, so the red named no exit code, no stream and no expectation.
      06 — the child exits 3 and writes nothing to either stream. The checker
           must name it as a FAIL whose message carries the exit code and says
           `stderr empty`, never a bare key.
      07 — the child's answer is an err VALUE (exit 1, the shape a refused
           bind takes), and its [expect] promises the success answer. The
           EXPECT line must carry the expectation, the actual output and the
           exit code. ]
 [ex key=06-silent-nonzero-exit
  [label [# silent non-zero exit #]]
  [src [#
[?lib 'cx-stdlib/env']
[$env:exit 3]
#]]
  [note [# Exits 3 with nothing on stdout or stderr. #]]]
 [ex key=07-err-answer-vs-expect
  [label [# err answer against an expectation #]]
  [src [#
[?let [= $e [err code='bind-refused' message='address in use']] [delivery $e]]
#]]
  [note [# The answer is the propagated err, not the delivery the expectation promises. #]]
  [expect [# [delivery accepted='true' #]]]
]
