# scripts/gen_guide/playground/gen_examples.cx — CX Playground example
# generator (#922 / PYE-5: the Python generator retires; this is its CX
# successor).
#
# Reads the example corpus from examples.cxd (one [ex key=…] per example:
# [label]/[src]/[note] raw-text payloads, byte-verbatim), CLI-audits every
# entry against vcx/target/cx, and writes playground.examples.js. Run with
# --check to verify the checked-in file without rewriting it (the drift
# gate `make verify-playground-examples`).
#
#   vcx/target/cx --allow-read --allow-write --allow-subprocess --allow-env \
#     --allow-clock scripts/gen_guide/playground/gen_examples.cx [--check]
#
# (--allow-clock: the per-example bound is CALIBRATED from a measured
# reference probe rather than hard-coded, and every child is timed — see
# BOUND-FLOOR-MS / audit-bounded.)
#
# Fidelity decisions, made deliberately (wave-3A of #922):
#   - ONE process per example, no batching. The audit's contract is to run
#     each example exactly as the playground does: an isolated evaluation
#     with ZERO capability grants (mirroring the file:// wasm sandbox), so
#     a CXER0271 in one entry marks that entry runnable:false without
#     leaking grants or state into any other. Same deliberate choice as
#     snippet_check.cx: the SHIPPED binary is what gets tested.
#   - The audit evaluates the COMPOSED form (src + the note wrapped in a
#     block comment), because that is the exact string the playground's
#     Run handler executes — an unbalanced bracket in note prose turns the
#     comment unterminated and must fail the gate.
#   - Per-example timeout: a CALIBRATED bound via process wait-timeout,
#     then kill — 20s on an idle machine, stretched by whatever the
#     measured reference probe says contention is doing (#988), and a
#     fired bound is re-measured and retried once before it is believed.
#     The
#     child's stdout/stderr are REDIRECTED TO FILES, never read back off a
#     pipe (#988). Draining a pipe only after the child exits is a
#     deadlock: a child whose output exceeds the kernel pipe buffer (16-64
#     KiB) blocks forever in write(), the parent's wait-timeout expires,
#     and a fast example is reported as "TIMEOUT after 20s". Files have no
#     such bound, so output size stops being a correctness variable. The
#     child is still ONE grant-free process running the shipped binary:
#     `sh -c 'exec …'` replaces the shell with cx, so the handle's pid IS
#     the child cx and kill still reaches it directly.
#   - JSON string escaping reproduces Python json.dumps ensure_ascii
#     byte-for-byte (non-ASCII → lowercase \uXXXX, surrogate pairs above
#     the BMP) so the regenerated file stays byte-identical across the
#     migration.
#   - RawText is opaque to the in-process CXDM (core/cxdm.md: "preserved,
#     not introspectable"), so the corpus is read through `cx --ast
#     --compact` — the parse-AST JSON carries RawText values byte-exact.
#
# All defs are strictly define-before-use.

[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/process']
[?lib 'cx-stdlib/strings']
[?lib 'cx-stdlib/json']
[?lib 'cx-stdlib/re']
[?lib 'cx-stdlib/path']
[?lib 'cx-stdlib/map']
[?lib 'cx-stdlib/array']
[?lib 'cx-stdlib/bytes']
[?lib 'cx-stdlib/fp']
[?lib 'cx-stdlib/time']

[?def cat scope=public ($parts) [$strings:join $parts '']]
# seq-flat: splice one level of nested sequences (sequence literals and
# nested [?for] yields do NOT auto-splice — measured on v0.16.0).
[?def seq-flat scope=public ($xs) [$fp:flat-map $xs [?fn ($x) $x]]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def die scope=public impure ($msg)
  [?let [= $w [$cry $msg]] [$env:exit 2]]]
[?def must scope=public impure ($ctx $x)
  [?match $x
    [case [err $e] [$die [$cat ('gen_examples: INTERNAL — ', $ctx, ': ', $e@message)]]]
    [else $x]]]

# ── Python-parity JSON string escaping (json.dumps, ensure_ascii) ────
# Everything outside 0x20-0x7E is escaped; short escapes for the quote,
# the backslash, and the five control characters Python shortens; \uXXXX
# otherwise, with a surrogate pair for codepoints above the BMP.

[?const BS '\\']
[?const HEXDIGITS '0123456789abcdef']

[?def hex4 scope=public ($cp)
  [$cat ([$strings:at HEXDIGITS [+ [$mod [$idiv $cp 4096] 16] 1]],
         [$strings:at HEXDIGITS [+ [$mod [$idiv $cp 256] 16] 1]],
         [$strings:at HEXDIGITS [+ [$mod [$idiv $cp 16] 16] 1]],
         [$strings:at HEXDIGITS [+ [$mod $cp 16] 1]])]]

[?def uesc scope=public ($cp)
  [?if [< $cp 65536]
    [then [$cat (BS, 'u', [$hex4 $cp])]]
    [else [$cat (BS, 'u', [$hex4 [+ 55296 [$idiv [- $cp 65536] 1024]]],
                 BS, 'u', [$hex4 [+ 56320 [$mod [- $cp 65536] 1024]]])]]]]

# esc-rare: a non-literal ASCII byte — quote, backslash, control, DEL.
[?def esc-rare scope=public ($b0)
  [?let [= $tbl ([t b=34 o=[$cat (BS, '"')]],
                 [t b=92 o=[$cat (BS, BS)]],
                 [t b=8  o=[$cat (BS, 'b')]],
                 [t b=9  o=[$cat (BS, 't')]],
                 [t b=10 o=[$cat (BS, 'n')]],
                 [t b=12 o=[$cat (BS, 'f')]],
                 [t b=13 o=[$cat (BS, 'r')]])]
        [= $hit [?for [in $p $tbl] [where [= $p@b $b0]] [yield [$string $p@o]]]]
    [?if [$empty $hit] [then [$uesc $b0]] [else $hit[1]]]]]

# esc-multi: a non-ASCII byte — continuation bytes yield ''; each lead
# byte decodes its full codepoint and escapes it.
[?def esc-multi scope=public ($b $i $b0)
  [?if [< $b0 192]
    [then '']
    [else [?if [< $b0 224]
      [then [$uesc [+ [* [- $b0 192] 64]
                      [- [$bytes:at $b [+ $i 1]] 128]]]]
      [else [?if [< $b0 240]
        [then [$uesc [+ [+ [* [- $b0 224] 4096]
                          [* [- [$bytes:at $b [+ $i 1]] 128] 64]]
                        [- [$bytes:at $b [+ $i 2]] 128]]]]
        [else [$uesc [+ [+ [+ [* [- $b0 240] 262144]
                             [* [- [$bytes:at $b [+ $i 1]] 128] 4096]]
                          [* [- [$bytes:at $b [+ $i 2]] 128] 64]]
                        [- [$bytes:at $b [+ $i 3]] 128]]]]]]]]]]

# esc-byte: one byte position → its emitted text (fast path: plain ASCII).
[?def esc-byte scope=public ($b $i $b0)
  [?if [and [>= $b0 32] [<= $b0 126]]
    [then [?if [or [= $b0 34] [= $b0 92]]
      [then [$esc-rare $b0]]
      [else [$bytes:to-string-utf8 [$bytes:slice $b $i [+ $i 1]]]]]]
    [else [?if [< $b0 128]
      [then [$esc-rare $b0]]
      [else [$esc-multi $b $i $b0]]]]]]

# json-esc: escape one string, walking its UTF-8 bytes.
[?def json-esc scope=public ($s)
  [?let [= $b [$bytes:from-string-utf8 $s]]
        [= $n [$bytes:length $b]]
    [$cat [?for [in $i [$range 0 [- $n 1]]]
      [yield [$esc-byte $b $i [$bytes:at $b $i]]]]]]]

# jstr: json.dumps of one string — quotes around the escaped body.
[?def jstr scope=public ($s) [$cat ('"', [$json-esc $s], '"')]]

# jlist: json.dumps of a string list — '[]' or '["a", "b"]' (comma-space).
[?def jlist scope=public ($xs)
  [?if [$empty $xs]
    [then '[]']
    [else [$cat ('[', [$strings:join [?for [in $x $xs] [yield [$jstr $x]]] ', '], ']')]]]]

# ── tag inference (port of infer_tags, field for field) ──────────────

[?const DIRECTIVE-RX-SRC '\[\?([a-z][a-z0-9-]*)']
[?const DOLLARPATH-RX-SRC '\$\w+/']
[?const BRACKET-RX-SRC '\[([a-z][a-z0-9-]*)\b']

[?const SLOT-KWS (
  [t needle=':par' tag='par'],       [t needle=':ordered' tag='ordered'],
  [t needle=' mock]' tag='mock'],    [t needle=':where' tag='where'],
  [t needle=':yield' tag='yield'],   [t needle=':let' tag='let'],
  [t needle=':init' tag='init'],     [t needle=':using' tag='using'],
  [t needle=':case' tag='case'],     [t needle=':when' tag='when'],
  [t needle=':else' tag='else'],     [t needle=':then' tag='then'],
  [t needle=':in' tag='in'],         [t needle=':body' tag='body'],
  [t needle=':set-attr' tag='set-attr'], [t needle=':delete' tag='delete'],
  [t needle=':limit' tag='limit'],   [t needle=':order-by' tag='order-by'],
  [t needle=':group-by' tag='group-by'])]

[?const BUILTIN-NAMES (
  'head', 'tail', 'reverse', 'distinct', 'count', 'sum',
  'min', 'max', 'avg', 'name', 'concat', 'string-length',
  'contains', 'starts-with', 'ends-with', 'substring',
  'normalize-space', 'abs', 'round', 'floor', 'ceiling',
  'nth', 'position', 'cast', 'and', 'or', 'not',
  'mod', 'modulo', 'rem')]

[?const OP-PAIRS (
  [t sym='[+ ' name='add'], [t sym='[- ' name='sub'], [t sym='[* ' name='mul'],
  [t sym='[/ ' name='div'], [t sym='[= ' name='eq'],  [t sym='[> ' name='gt'],
  [t sym='[< ' name='lt'],  [t sym='[>= ' name='ge'], [t sym='[<= ' name='le'])]

[?def member scope=public ($x $xs)
  [> [$count [?for [in $y $xs] [where [= $y $x]] [yield 1]]] 0]]

# uniq: first occurrence of each value, input order preserved.
[?def uniq scope=public ($xs)
  [?for [in $i [$range 1 [$count $xs]]]
    [where [= [$count [?for [in $j [$range 1 [- $i 1]]]
                [where [= $xs[$j] $xs[$i]]] [yield 1]]] 0]]
    [yield $xs[$i]]]]

[?def infer-tags scope=public ($key $src $note)
  [?let
    [= $directive-tags [?for [in $m [$re:find-all [$re:compile DIRECTIVE-RX-SRC] $src]]
        [yield [$re:group $m 1]]]]
    [= $slot-tags [?for [in $p SLOT-KWS]
        [where [$strings:contains $src [$string $p@needle]]]
        [yield [$string $p@tag]]]]
    [= $cxpath-tags [?if [or [not [$empty [$re:find [$re:compile DOLLARPATH-RX-SRC] $src]]]
                             [$strings:contains $src '/@']]
        [then ('cxpath',)] [else ()]]]
    [= $desc-tags [?if [$strings:contains $src '//'] [then ('descendant',)] [else ()]]]
    [= $attr-tags [?if [and [$strings:contains $src '@']
                            [not [$strings:contains $src '/@']]
                            [not [$strings:contains $src '"@']]]
        [then ('attr',)] [else ()]]]
    [= $bracket-names [?for [in $m [$re:find-all [$re:compile BRACKET-RX-SRC] $src]]
        [= $nm [$re:group $m 1]]
        [where [$member $nm BUILTIN-NAMES]]
        [yield $nm]]]
    [= $builtin-tags [?if [$empty $bracket-names]
        [then ()] [else [$seq-flat ($bracket-names, 'builtin')]]]]
    [= $op-tags [?for [in $p OP-PAIRS]
        [where [$strings:contains $src [$string $p@sym]]]
        [yield [$string $p@name]]]]
    [= $concept-tags [$seq-flat (
        [?if [$strings:contains [$strings:lower $key] 'par'] [then ('parallel',)] [else ()]],
        [?if [$strings:contains [$strings:lower $note] 'streaming'] [then ('streaming',)] [else ()]],
        [?if [$strings:contains $src 'retry'] [then ('retry',)] [else ()]],
        [?if [$strings:contains $src 'timeout'] [then ('timeout',)] [else ()]],
        [?if [$strings:contains $src 'fallback'] [then ('fallback',)] [else ()]],
        [?if [$strings:contains $src 'circuit'] [then ('resilience',)] [else ()]],
        [?if [$strings:contains $src 'bulkhead'] [then ('resilience',)] [else ()]],
        [?if [$strings:contains $src 'rate-limit'] [then ('resilience',)] [else ()]])]]
    [$sort [$uniq [$seq-flat ($directive-tags, $slot-tags, $cxpath-tags, $desc-tags,
                              $attr-tags, $builtin-tags, $op-tags, $concept-tags)]]]]]

# ── corpus loading (examples.cxd → parse-AST JSON → entries) ─────────

[?def items-of scope=public ($el)
  [$array:flatten [?else $el.items []]]]
[?def attrs-of scope=public ($el)
  [$array:flatten [?else $el.attrs []]]]

[?def raw-text-of scope=public ($el)
  [$cat [?for [in $it [$items-of $el]]
    [where [= [$string $it.type] 'RawText']]
    [yield [$string $it.value]]]]]

# strip-edges: the loader rule — one leading and one trailing newline.
[?def strip-edges scope=public ($s)
  [?let [= $a [?if [$strings:starts-with $s '\n']
                 [then [$strings:slice $s 2 [$strings:length $s]]] [else $s]]]
    [?if [$strings:ends-with $a '\n']
      [then [$strings:slice $a 1 [- [$strings:length $a] 1]]]
      [else $a]]]]

[?def attr-of scope=public ($el $name)
  [$cat [?for [in $a [$attrs-of $el]]
    [where [= [$string $a.name] $name]]
    [yield [$string $a.value]]]]]

[?def section-of scope=public ($kids $name)
  [$cat [?for [in $c $kids]
    [where [= [$string $c.type] 'Element']]
    [where [= [$string $c.name] $name]]
    [yield [$raw-text-of $c]]]]]

# load-examples: sequence of
# [entry key=… label=… src=… note=… wasm-unsupported=…].
#
# `[wasm-unsupported [# reason #]]` is the #1033 marker: an example the
# SHIPPED wasm engine cannot reproduce faithfully — either it REFUSES the
# program (the `[?worker]` / `[?async]` class, which needs `go` and the
# default single-threaded build has none) or it EVALUATES IT TO A
# DIFFERENT VALUE than native cx (example 57: a `[?bulkhead]` never
# saturates when `[par]` is sequential). Either way the reason is what
# the page shows the reader instead of a raw engine error or a quietly
# wrong answer.
#
# OPTIONAL — `section-of` yields '' when the section is absent, which is
# the case for all but a handful of the corpus. `make test-playground-wasm-eval`
# keeps the
# set honest in BOTH directions: an unmarked refusal or divergence fails,
# and so does a marker on an example that actually matches native.
#
# `[no-stable-value [# reason #]]` is the THIRD state, and it is not a
# softer spelling of the second: the example has NO single expected value
# to compare against, because its native result is a race. Example 57's
# `[?bulkhead]` over `[par]` measured 10 distinct results in 12 native
# runs. Comparing wasm to a freshly-derived native value there produces a
# FLAKY gate — it flipped between "justified marker" and "stale marker"
# on consecutive runs, which is how a gate teaches people to ignore it.
# So the sweep asserts the weaker, true property for these: the example
# must still EVALUATE in wasm (a refusal is a different defect and does
# NOT get to hide behind this marker), and the value is not compared.
#
# THE SET IS CURRENTLY EMPTY (#1043). Example 57 — the only example that
# ever used this state — was redesigned to be deterministic: `[par N]`
# bounds the width and the `[?bulkhead]` is sized so it cannot shed, so
# its value no longer depends on thread timing and it is compared against
# native like every other example. The state is KEPT because the hazard
# is real and structural (any example whose value depends on which worker
# wins a race), not because anything needs it today. Prefer redesigning a
# racy example over reaching for this marker.
[?def load-examples scope=public impure ($cxbin $data-path)
  [?let
    [= $r [$process:run ($cxbin, '--ast', '--compact', $data-path)]]
    [= $rc [?if [= $r@exit-code 0] [then 0]
        [else [$die [$cat ('gen_examples: cx --ast failed on ', $data-path, ': ',
                           [$strings:trim [$string $r@stderr]])]]]]]
    [= $ast [$must 'parsing --ast JSON' [$json:parse [$string $r@stdout]]]]
    [= $t [?if [= [$string $ast.type] 'Document'] [then 0]
        [else [$die [$cat ('gen_examples: expected a single Document AST from ',
                           $data-path)]]]]]
    [$seq-flat [?for [in $root [$array:flatten $ast.elements]]
      [where [= [$string $root.name] 'playground-examples']]
      [yield [?for [in $ex [$items-of $root]]
        [where [= [$string $ex.type] 'Element']]
        [where [= [$string $ex.name] 'ex']]
        [= $kids [$items-of $ex]]
        [yield [entry
          key=[$attr-of $ex 'key']
          label=[$section-of $kids 'label']
          src=[$strip-edges [$section-of $kids 'src']]
          note=[$strip-edges [$section-of $kids 'note']]
          wasm-unsupported=[$strings:trim [$section-of $kids 'wasm-unsupported']]
          no-stable-value=[$strings:trim [$section-of $kids 'no-stable-value']]
          bare-builtin-ok=[$strings:trim [$section-of $kids 'bare-builtin-ok']]
          expect=[$strings:trim [$section-of $kids 'expect']]
          grants=[$strings:trim [$section-of $kids 'grants']]
          section=[$strings:trim [$section-of $kids 'section']]]]]]]]]]

# ── audit (one isolated, grant-free child per example) ───────────────

[?const NOTE-RULE '────────────────────']

# CAPTURE-CAP: the most output one example may emit (stdout + stderr) and
# still be read back. 4 MiB is ~4000x the largest current example and far
# past anything the playground could put on screen, so exceeding it means
# the example is wrong, not that the cap is tight.
[?const CAPTURE-CAP 4194304]

# ── the per-example bound: CALIBRATED, never a wall-clock constant ────
#
# #988's surviving symptom was a 20 s TIMEOUT on 168-erd-large-org-structure,
# an example that MEASURES 0.058 s standalone and emits 552 B. A fixed 20 s
# wall-clock deadline is load-BLIND: it says nothing about how fast this
# machine is running right now, so on a contended box it fires on a
# perfectly healthy example and reports it as broken. Measured on this
# corpus (2026-08-26, 12 logical cores):
#
#   idle                    182 examples in  19.8 s   (mean 108 ms/example)  [at 182]
#   48 spinners (4x oversub) 182 examples in 146.6 s   (mean 805 ms/example)  [at 182]
#
# — a 7.4x uniform stretch of every example from one source of contention,
# with nothing wrong anywhere. The bound has to stretch with it.
#
# So: measure the machine, then derive the bound. PROBE-MS times the
# shipped binary on a trivial evaluation — one spawn + one interpreter
# start + one tiny eval, i.e. the fixed cost EVERY entry pays before its
# own work — and the bound is BOUND-SLACK times that, floored at
# BOUND-FLOOR-MS so an idle machine keeps the bound #922 shipped with.
# The floor is what the constant used to be; the slack is what makes it
# load-aware.
[?const BOUND-FLOOR-MS 20000]
[?const BOUND-SLACK 200]

# PROBE-SRC: the smallest thing the binary can be asked to evaluate. Its
# cost is process spawn + runtime init, which is what contention inflates.
[?const PROBE-SRC '1\n']

[?def compose scope=public ($src $note)
  [$cat ($src, '\n\n[; ', NOTE-RULE, '\n', $note, '\n', NOTE-RULE, ' ]\n')]]

# probe-ms: what a trivial grant-free evaluation costs on THIS machine at
# THIS moment, in milliseconds. Same shape as the audit child (sh -c exec,
# output to files) so the two measure the same thing.
[?def probe-ms scope=public impure ($cxbin $probe-tmp $out-path $err-path)
  [?let
    [= $w [$must 'writing calibration probe' [$io:write-file $probe-tmp PROBE-SRC]]]
    [= $t0 [$time:monotonic-now]]
    [= $r [$process:run ('sh', '-c', 'exec "$1" "$2" >"$3" 2>"$4"',
                         'gen_examples-probe', $cxbin, $probe-tmp,
                         $out-path, $err-path)]]
    [= $t1 [$time:monotonic-now]]
    [$idiv [- $t1 $t0] 1000000]]]

# bound-of: the per-example deadline derived from one probe reading.
[?def bound-of scope=public pure ($probe)
  [?let [= $scaled [* $probe BOUND-SLACK]]
    [?if [> $scaled BOUND-FLOOR-MS] [then $scaled] [else BOUND-FLOOR-MS]]]]

# audit: [res status=… runnable=… msg=… ms=…]; status 'ok' unless a
# top-level parse/eval error (a printed [err …] VALUE is a legitimate
# result). `ms` is this child's measured wall time — reported on every
# TIMEOUT and folded into the run's profile line, so "the bound fired" is
# never again a claim without a number behind it.
#
# $grants is the entry's `[grants [# … #]]` field (RULED: CXF-2): the
# capability flags THIS child is launched with, and only this child. The
# audit stays one isolated process per example — an entry without the
# field is launched exactly as before, with an empty capability set — so
# a granted example can no more leak into its neighbour than a grant-free
# one can. The flags ride in as `$5` and are deliberately UNQUOTED inside
# the `sh -c` body so the shell word-splits them into separate argv
# entries; every token is proved to start with `--allow-` before the
# corpus is audited (see `grant-shape-bad` at the call site), so the
# splitting can only ever produce grant flags.
[?def audit scope=public impure ($cxbin $tmp $out-path $err-path $composed $bound $grants)
  [?let
    [= $w [$must 'writing audit tmp file' [$io:write-file $tmp $composed]]]
    # Truncate the capture files here, not just via the shell's `>`, so
    # whatever we read back is unambiguously THIS example's output — a
    # killed child must never be reported with its predecessor's bytes.
    [= $w1 [$must 'truncating stdout capture' [$io:write-file $out-path '']]]
    [= $w2 [$must 'truncating stderr capture' [$io:write-file $err-path '']]]
    # >$out-path 2>$err-path: the child never writes into a pipe, so its
    # output volume can never wedge the wait (#988). `exec` means the
    # process we wait on and kill IS the child cx, not a shell wrapper;
    # the args ride in as $1..$4 so no path needs quoting by hand.
    [= $t0 [$time:monotonic-now]]
    [= $h [$must 'spawning cx' [$process:spawn
        ('sh', '-c', 'exec "$1" $5 "$2" >"$3" 2>"$4"', 'gen_examples-audit',
         $cxbin, $tmp, $out-path, $err-path, $grants)]]]
    [= $rcw [$process:wait-timeout $h $bound]]
    [= $ms [$idiv [- [$time:monotonic-now] $t0] 1000000]]
    [?if [$empty $rcw]
      [then [?let [= $k [$process:kill $h]]
                  [= $c [$process:close $h]]
        # Report what the child DID emit before the kill. A bare "TIMEOUT"
        # is undiagnosable — that is exactly what left #988 guessing at an
        # output-volume cause for an example that emits 552 bytes. Sizes
        # come from stat, never from reading the file, so a runaway child
        # cannot make the report the next problem.
        [= $osz [$must 'sizing killed child stdout' [$io:size $out-path]]]
        [= $esz [$must 'sizing killed child stderr' [$io:size $err-path]]]
        [res status='fail' runnable=true ms=$ms out='' err=''
             msg=[$cat ('TIMEOUT after ', [$string $ms], ' ms (bound ',
                        [$string $bound], ' ms) — captured ', [$string $osz],
                        ' B stdout / ', [$string $esz],
                        ' B stderr before the kill')]]]]
      [else [?let
        [= $c [$process:close $h]]
        # A pipe used to bound the child's output by deadlocking on it; a
        # file does not, so the bound has to be STATED. Measure before
        # reading — past the cap the example fails loudly on its volume
        # instead of the generator inhaling it.
        [= $osz [$must 'sizing child stdout' [$io:size $out-path]]]
        [= $esz [$must 'sizing child stderr' [$io:size $err-path]]]
        [= $over [> [+ $osz $esz] CAPTURE-CAP]]
        [= $out [?if $over [then '']
            [else [$string [$must 'reading child stdout' [$io:read-file $out-path]]]]]]
        [= $errout [?if $over [then '']
            [else [$string [$must 'reading child stderr' [$io:read-file $err-path]]]]]]
        [= $combined [$cat ($out, $errout)]]
        [= $msg [?if [= [$strings:trim $out] '']
            [then [$strings:trim $errout]] [else [$strings:trim $out]]]]
        [= $runnable [not [$strings:contains $combined 'CXER0271']]]
        # An err value ANYWHERE in the result means the program produced one,
        # so a nonzero rc is expected — and the rule is asked ONCE, of the
        # runtime that rendered the bytes (#1351, RULED: 1351-a1).
        #
        # This auditor used to TRANSLITERATE `code.output_carries_err` in CX:
        # three prefix constants (`[err `, `([err `, `, [err `) and a per-line
        # scan. #1058 T1.1 changed the contract — an err INSIDE a sequence now
        # exits 1 — and the rule turned out to have five independent
        # implementations, three of them prefix scanners over rendered text.
        # The two scanners each needed FOUR rounds of widening, every round
        # failing on a different err POSITION rather than a different err:
        #   57-map-par-bulkhead   (1, 4, 9, 16, [err code=shard-offline …], …)
        #                         — the err sits FIFTH, so neither `[err ` nor
        #                         `([err ` matches
        #   97-rate-limit-over    [ok i=1] / [ok i=2] / [err …CXER0151…]
        #                         — the run surface prints each top-level
        #                         result on its own line, so the err is on the
        #                         THIRD one
        # A prefix test can never see either, and a scanner that fails to
        # recognise an err grades the case as an ordinary mismatch or, worse,
        # tolerates it. One verb now owns the byte contract, so the day the run
        # surface renders a fourth shape this auditor learns it for free.
        #
        # The converse must NOT be asserted: an err in the output does not make
        # rc=1 REQUIRED — a literal err in a data document is DATA echoing
        # itself and legitimately exits 0. This stays a TOLERANCE test.
        [= $err-value-result [$cx:carries-err $out]]
        [?if $over
          [then [res status='fail' runnable=true ms=$ms out='' err=''
                 msg=[$cat ('output too large: ', [$string [+ $osz $esz]],
                            ' B exceeds the ', [$string CAPTURE-CAP],
                            ' B capture cap — the playground cannot show this')]]]
          [else [?if [or [$strings:starts-with $out 'error:']
                         [and [not [= $rcw 0]] [not $err-value-result]]]
            [then [res status='fail' runnable=$runnable ms=$ms msg=$msg
                       out=$out err=$errout]]
            [else [res status='ok' runnable=$runnable ms=$ms msg=$msg
                       out=$out err=$errout]]]]]]]]]]

# ── the timeout is RE-MEASURED before it is believed (#988) ───────────
#
# A bound that fired tells you the child outlived the deadline; it does
# NOT tell you whether the child was hung or merely starved. The two are
# distinguishable by measurement, so distinguish them: re-probe the
# machine (a fresh PROBE-MS reading carries whatever contention arrived
# mid-run, which a start-of-run calibration cannot), re-derive the bound
# from it, and run the example ONCE more under that bound.
#
#   - starved: the re-probe is slow, the retry passes, and the run says so
#     on stderr with both attempts' numbers and both bounds. A healthy
#     example is not failed for the machine's state.
#   - hung: the re-probe is fast — the machine is fine — and the example
#     times out AGAIN. That is a defect, and it fails the gate with two
#     measurements and a reference reading, which is exactly the evidence
#     #988 was originally filed without.
#
# The retry is CLASSIFIED: only a TIMEOUT is retried, never a parse/eval
# failure, never an over-cap capture.
[?def audit-bounded scope=public impure
    ($cxbin $tmp $probe-tmp $out-path $err-path $key $composed $bound $grants)
  [?let
    [= $r0 [$audit $cxbin $tmp $out-path $err-path $composed $bound $grants]]
    [?if [not [$strings:starts-with [$string $r0@msg] 'TIMEOUT']]
      [then $r0]
      [else [?let
        [= $p2 [$probe-ms $cxbin $probe-tmp $out-path $err-path]]
        [= $b2 [$bound-of $p2]]
        [= $c1 [$cry [$cat ('RETRY  ', $key, ' — hit the ', [$string $bound],
                            ' ms bound at ', [$string $r0@ms],
                            ' ms; re-probe measures ', [$string $p2],
                            ' ms, so retrying once under a ', [$string $b2],
                            ' ms bound')]]]
        [= $r1 [$audit $cxbin $tmp $out-path $err-path $composed $b2 $grants]]
        [= $again [$strings:starts-with [$string $r1@msg] 'TIMEOUT']]
        [= $c2 [$cry [?if $again
            [then [$cat ('RETRY  ', $key, ' — TIMED OUT AGAIN at ',
                         [$string $r1@ms], ' ms: the machine measures ',
                         [$string $p2], ' ms for a trivial evaluation, so this',
                         ' is the example, not the load')]]
            [else [$cat ('RETRY  ', $key, ' — passed in ', [$string $r1@ms],
                         ' ms on the re-derived bound: attempt 1 was STARVED,',
                         ' not hung')]]]]]
        [?if $again
          [then [res status='fail' runnable=true ms=$r1@ms out='' err=''
                 msg=[$cat ('TIMEOUT twice — ', [$string $r0@ms], ' ms under a ',
                            [$string $bound], ' ms bound, then ', [$string $r1@ms],
                            ' ms under a re-derived ', [$string $b2],
                            ' ms bound, on a machine measuring ', [$string $p2],
                            ' ms for a trivial evaluation')]]]
          [else $r1]]]]]]]

# ── render ────────────────────────────────────────────────────────────

[?const HEADER-TAIL (
  '// Single ordered list, simple → complex:',
  '//   1-39   data / bindings / control flow      ·  40-60  comprehensions, map/reduce ([par])',
  '//   61-100 modify / pipe / cxpath / builtins   ·  concurrency / resilience',
  '//   101-160 cxpath + transforms / composition  ·  161-172 diagrams',
  '//   173-182 functional composition (cx-stdlib/fp)',
  '//   183-203 the v0.14 → v0.18 surface: [?loop] / [?do] / % / seeded random,',
  '//          [$present], the operand-consuming err rule, uniform postfix steps,',
  '//          the map + array module surfaces, the read/construct split,',
  '//          [?group-by], [?with-caps [deny]], [?secret], checked int arithmetic,',
  '//          [?const] + [?def], [?str], [?else], [?quote]',
  '//   246-268 everyday scripts: files and directories, text and regex,',
  '//          collections as scripts use them',
  '//   269-285 everyday scripts: CX documents as data, arguments /',
  '//          environment / processes, dates and durations, CLI errors',
  '// runnable:false marks an example that needs a wasm-unavailable capability',
  '// (net / subprocess / fs); it is exempt from the clean-run gate.',
  '// grants carries the capability flags the example names (RULED: CXF-2).',
  '// The native audit ran the example UNDER them, so the recorded answer is',
  '// real; the browser cannot grant them, so such an entry is runnable:false',
  '// and the page shows `cx <grants> program.cx` instead of claiming a run.',
  '// wasmUnsupported marks an example the SHIPPED wasm engine cannot reproduce',
  '// faithfully (#1033) — it refuses the program, or evaluates it to a different',
  '// value than native cx — carrying the reason the page shows the reader; the',
  '// set is pinned in both directions by `make test-playground-wasm-eval`.',
  '// noStableValue marks an example with NO single expected value (its native',
  '// result is a race); the sweep then requires only that it still evaluates.',
  '// Generator: scripts/gen_guide/playground/gen_examples.cx — re-run (or `make guide`)',
  '// after any syntax change; `--check` verifies this file without rewriting it.',
  '',
  '(function () {',
  "  'use strict';",
  '',
  '  const program = {')]

[?const FOOTER-LINES (
  '  };',
  '',
  '  window.cxPlaygroundExamples = { program };',
  '})();')]

# render-block: the emitted lines for one passing example, as ONE string.
#
# The `wasmUnsupported` line is emitted ONLY when the corpus carries a
# reason (#1033), so the 170-odd examples the wasm engine runs fine do
# not each grow an empty field. The page keys its honest banner off the
# presence of this field; `make test-playground-wasm-eval` keeps the set
# from drifting in either direction.
# `grants` (RULED: CXF-2) is emitted only when the corpus carries the
# field, and it forces `runnable: false` whatever the grant-free audit
# said. The audit runs the example WITH those grants natively, so the
# recorded answer is a real one; the browser has no way to give the same
# capabilities, so the page must not claim it ran the program — it shows
# the reader the command line the field spells instead.
[?def render-block scope=public ($key $label $src $note $runnable $wasm-unsupported
                                $no-stable-value $section $grants)
  [$strings:join [$seq-flat (
    [$cat ('    ', [$jstr $key], ': {')],
    [$cat ('      label: ', [$jstr $label], ',')],
    [$cat ('      input: ', [$jstr $src], ',')],
    [$cat ('      note:  ', [$jstr $note], ',')],
    [$cat ('      tags:  ', [$jlist [$infer-tags $key $src $note]], ',')],
    [$cat ('      section: ', [$jstr $section], ',')],
    [?if [= $grants '']
      [then ()]
      [else ([$cat ('      grants: ', [$jstr $grants], ',')])]],
    [$cat ('      runnable: ',
           [?if [and $runnable [= $grants '']] [then 'true'] [else 'false']], ',')],
    [?if [= $wasm-unsupported '']
      [then ()]
      [else ([$cat ('      wasmUnsupported: ', [$jstr $wasm-unsupported], ',')])]],
    [?if [= $no-stable-value '']
      [then ()]
      [else ([$cat ('      noStableValue: ', [$jstr $no-stable-value], ',')])]],
    '    },')] '\n']]

# ── the RECORDED ANSWER (#1170 §C1, RULED: 1170-a) ────────────────────
#
# Until this landed, `make verify-playground-examples` proved only that
# each example RUNS: it failed on a non-zero exit or an unterminated note
# comment and compared no value, because the corpus recorded none. So a
# semantics change retired an example's MEANING while the gate stayed
# green — R-A1's bare-head retirement (2026-08-25) left FOURTEEN examples
# echoing their own arguments (`[concat "a" "b"]` → `[concat 'a', 'b']`)
# with every note still promising the computed answer, and #1033's wasm
# sweep could not see it either: it compares wasm against native for the
# SAME source, and both agree on the wrong answer.
#
# The fix is to record what the binary actually did, in a file a human
# reviews. A changed answer then becomes a diff the author must accept —
# which is exactly the review moment all fourteen never got.
#
# WHERE it is recorded is RULED: 1170-a
# (ledger/rulings_2026_09_08_playground_output_pin_1170.md) — a SEPARATE
# generated `examples.out.cxd`, never spliced into the hand-authored
# `examples.cxd`. A generator must not rewrite its own hand-authored
# input: the corpus is read through `cx --ast --compact` (RawText is
# opaque to the in-process CXDM), so a rewrite from that AST would lose
# the hand-written [doc] block and every formatting choice, and the
# alternative — line-splicing the raw file — puts a fragile text
# transform in the path of the only copy of 182 hand-authored examples.
# This repo already has one generator documented as owning a
# hand-authored corpus (design/787/tools/gen_ux_fixtures.cx) and it would
# DELETE seven fixtures if run as documented. There is not a second.
#
# `[out-text [# … #]]` is the house spelling for a pinned program answer
# — the same element conformance/*.cxd uses — so this repository has ONE
# shape for "what this program prints", not two.

[?const RAW-TERM '#]']

[?const OUT-HEADER-TAIL (
  ' [doc [#',
  'GENERATED — do not hand-edit. Written by',
  'scripts/gen_guide/playground/gen_examples.cx from a grant-free audit run',
  'of every [ex] in examples.cxd, and verified without rewriting by',
  '`make verify-playground-examples` (the generator with --check).',
  'Regenerate with `make playground-examples-regen`.',
  '',
  'One [ex] per corpus entry, in corpus order. [out-text] is the child',
  "process's stdout, [err-text] its stderr (emitted only when non-empty),",
  'both as raw-text payloads under the corpus convention: the content',
  'starts on the line after the opening marker and the closing marker sits',
  'on its own line, so exactly one leading and one trailing newline are',
  'the delimiters and not content. That convention normalizes away a final',
  'newline, so `chars=` carries the captured length as measured — a',
  'truncation can never hide behind the payload shape.',
  '',
  'An entry marked no-stable-value=true carries no payload: its native',
  'result is a race (see the [no-stable-value] marker in examples.cxd), so',
  'there is no single answer to pin and the sweep asserts only that it',
  'still evaluates. That is the SAME three-state vocabulary',
  '`make test-playground-wasm-eval` grades, not a fourth spelling.',
  '',
  'THIS FILE IS THE REVIEW MOMENT. A diff here means an example now',
  'computes something else. Read it against the entry\'s [note] before',
  'accepting it: a note that promises an answer this file contradicts is',
  'the defect #1170 was filed for.',
  '#]]',
  '')]

# out-payload: one raw-text payload under the corpus convention. An empty
# capture renders as an empty payload (`[#` then `#]`), which is a
# DELIBERATE record — 30-match-no-else and 45-for-empty legitimately print
# nothing, and on a page whose contract is "press Run and read the answer"
# an empty pane has to be pinned as the answer rather than left ambiguous.
[?def out-payload scope=public ($text)
  [$cat ('[#\n', $text,
         [?if [$strings:ends-with $text '\n'] [then ''] [else '\n']],
         '#]')]]

# ── §C2: the BARE-BUILTIN-HEAD lint (RULED: 1170-b) ──────────────────
#
# §C1 makes an R-A1 casualty visible in review. This makes it visible to
# the machine, so the class cannot come back one example at a time.
#
# Post R-A1 (2026-08-25) a bare `[name …]` head is DATA CONSTRUCTION and
# the builtin is reached through the `$`-head call form. Fourteen
# examples still used the retired spelling: they echoed their own
# arguments, exited 0, and every note still promised the computed answer.
#
# HOW THE NAMES ARE KNOWN — measured, not copied. `[$NAME]` answers
#
#   [err code=cx-err:CXER0136 message='E_NO_CALLABLE: no callable   not a builtin
#                                      "pizza"']
#   [err code=cx-err:CXER0100 message='concat: expected at least 1  a builtin
#                                      argument(s), got 0 …']
#
# The MISS code is what this reads, and it is read positively. It was
# `user-undefined` until #1058 T1.6-b gave the miss a real code and
# REMOVED that string (RULED: 1058-T1.6-b, vcx/code/eval.v). This
# predicate was spelled as the ABSENCE of the old string, so the rename
# made it vacuously TRUE for every name: every bare head read as a
# builtin and the gate printed 52 false BAREs (red at c281b4130). An
# absence is not evidence — hence the discrimination self-test at the
# call site, which fails loudly the next time the engine's spelling
# moves instead of failing silently.
#
# so the ENGINE is the authority and there is no second copy of
# `builtin_dispatchable` (vcx/code/eval.v) to go stale. Note what this
# does NOT use: BUILTIN-NAMES above is a 30-name list for TAG inference
# and it is already wrong — it carries `modulo` and `rem`, which are not
# callable at all. A lint must not be built on it.
#
# WHY THE NAME ALONE IS NOT ENOUGH. Over the corpus, seventeen distinct
# bare heads resolve as builtins and five of them are LEGITIMATE, each
# for a different reason:
#
#   and, or, not   bare-spelled OPERATORS — `[and]` gives an arity error,
#                  so dispatch really happens
#   cast           dispatched bare WITH arguments: `[cast 3.7 :int]`
#                  refuses with CXER0290, while bare `[cast]` echoes
#   log, name      DATA elements named after a builtin — `[log 10]` and
#                  `[name "Alice"]` are documents, not calls
#
# `cast` is why the obvious zero-argument probe is refused as the second
# condition: `[and]` errors (dispatched) but `[cast]` echoes, so a
# zero-arg probe misclassifies it.
#
# THE SECOND CONDITION IS THE PIN. R-A1's symptom is not "a builtin name
# appears bare", it is "the construct CAME TO REST as data". §C1 already
# has every answer in hand, so the rule is: a bare head H in `src`, AND
# `[$H]` resolves, AND the recorded answer holds a construct headed H.
# That is clean on 25-logical (`[and …]` computes to a boolean) and on
# 35-cast-float-int (the answer is the CXER0290 refusal), and leaves only
# a genuine data element named after a builtin — which is what
# `[bare-builtin-ok [# reason #]]` is for, graded in BOTH directions like
# the wasm marker so the corpus cannot be defeated by marking it
# wholesale.

[?def is-builtin-head scope=public impure ($cxbin $tmp $out-path $err-path $name)
  [?let
    [= $w [$must 'writing builtin probe' [$io:write-file $tmp [$cat ('[$', $name, ']\n')]]]]
    [= $w1 [$must 'truncating probe stdout' [$io:write-file $out-path '']]]
    [= $w2 [$must 'truncating probe stderr' [$io:write-file $err-path '']]]
    [= $r [$process:run ('sh', '-c', 'exec "$1" "$2" >"$3" 2>"$4"',
                         'gen_examples-builtin-probe', $cxbin, $tmp,
                         $out-path, $err-path)]]
    [= $o [$string [$must 'reading probe stdout' [$io:read-file $out-path]]]]
    [= $e [$string [$must 'reading probe stderr' [$io:read-file $err-path]]]]
    [not [$strings:contains [$cat ($o, $e)] 'cx-err:CXER0136']]]]

# resting-heads-of: the bare heads a source names whose construct came to
# rest in that example's answer.
[?def resting-heads-of scope=public ($src $answer)
  [$uniq [?for [in $m [$re:find-all [$re:compile BRACKET-RX-SRC] $src]]
    [= $h [$re:group $m 1]]
    [where [$strings:contains $answer [$cat ('[', $h)]]]
    [yield $h]]]]

# ── §C3: the [?let]-CASCADE lint (RULED: 1170-c) ──────────────────────
#
# `[?let]` takes ALL its bindings in ONE flat list, and each one can read
# the ones before it (code.md §8.5). Reaching for a second `[?let]` to add
# a second binding is a Scheme habit (#361), and the corpus TAUGHT it: 16
# of 202 examples cascaded, `172` six deep. `17-let-nested` was the worst
# case because its own note presented the cascade as the idiom.
#
# THE RULE IS STRUCTURAL, AND ASKED OF THE ENGINE. A `[?let]` directive
# that has another `[?let]` directive as a DIRECT child is a cascade: the
# inner one sits in the outer one's BODY position, which is the only place
# a second binding list can go. Everything else nests through something —
# a `[?for]`, a `[?fn]`, a `[?worker]`'s `[body …]`, an element — and is a
# genuinely different scope.
#
# THAT EXCLUSION IS NOT A SPECIAL CASE, which is the point worth keeping.
# The §C3 sketch on #1170 asked for the `[?async]`/`[?worker]` bodies to be
# exempted by NAME. They do not need to be: measured over the corpus, the
# four surviving multi-`[?let]` entries that are NOT cascades — `84`, `85`,
# `87`, `90` — all nest their inner `[?let]` inside an `[?async]`/`[?worker]`
# body, so the direct-child rule already passes them, and a rule with no
# name list cannot go stale when a fifth scoping directive is added.
#
# AND THERE IS NO ALLOW-LIST, deliberately (1170-c, 1(a)). A marker like
# `bare-builtin-ok` exists because §C2's rule has legitimate exceptions —
# a data element named after a builtin. This rule has none: a nested
# `[?let]` in a genuinely different scope is never in body position, so it
# is never flagged, and an escape hatch would only ever be used to keep a
# cascade. `162`/`171`/`172` — the three §C1 left standing because
# `make test-playground-mermaid` grades the emitter's shape
# classification — are flattened in this same change under a green run of
# that gate, so the list this lint would have needed is EMPTY.
#
# ATTRIBUTES ARE NOT WALKED, and cannot need to be: a node-valued
# attribute is refused outright (D2 — `value=[…]` is `E211`), so a `[?let]`
# can only ever be an item.

[?const LET-RX-SRC '\[\?let\b']

# The picker's sections (#1375): two top-level groups, domain subcategories,
# nothing chronological. Display names live in playground.js SECTION_NAMES.
[?const KNOWN-SECTIONS ('data/elements', 'data/collections', 'data/numbers', 'data/text',
  'data/formats', 'data/schema',
  'code/bindings', 'code/control-flow', 'code/patterns', 'code/functions',
  'code/comprehensions', 'code/paths', 'code/transforms', 'code/queries', 'code/errors',
  'code/effects', 'code/builtins', 'code/concurrency', 'code/resilience',
  'code/metaprogramming', 'code/diagrams',
  'everyday/files', 'everyday/text', 'everyday/collections',
  'everyday/documents', 'everyday/process', 'everyday/time', 'everyday/cli-errors',
  'everyday/testing', 'everyday/world')]

# A member that is not there is an ERROR, not an absence: `$n.name` on a
# `Scalar`/`Hole`/`RawText` node answers CXER0001 `no member "name"` and
# takes the whole run down, so both reads are guarded — the same `[?else]`
# the corpus loader already uses for `items`.
[?def is-let-node scope=public ($n)
  [and [= [$string [?else $n.type '']] 'EvalDirective']
       [= [$string [?else $n.name '']] 'let']]]

# node-let-cascades: how many `[?let]`s in this subtree open another
# `[?let]` directly in their body.
[?def node-let-cascades scope=public ($node)
  [?let
    [= $kids [$items-of $node]]
    [= $here [?if [$is-let-node $node]
        [then [$count [?for [in $k $kids] [where [$is-let-node $k]] [yield 1]]]]
        [else 0]]]
    [= $below [?for [in $k $kids] [yield [$node-let-cascades $k]]]]
    [+ $here [?if [$empty $below] [then 0] [else [$sum $below]]]]]]

# src-cascades: the cascade count of ONE example's source, from the
# engine's own parse. `--ast` does not evaluate, so a `[?lib]` head or a
# missing grant cannot reach this.
[?def src-cascades scope=public impure ($cxbin $tmp $key $src)
  [?let
    [= $w [$must 'writing cascade probe' [$io:write-file $tmp [$cat ($src, '\n')]]]]
    [= $r [$process:run ($cxbin, '--ast', '--compact', $tmp)]]
    [= $ok [?if [= $r@exit-code 0] [then 0]
        [else [$die [$cat ('gen_examples: cx --ast failed on the src of ', $key,
                           ' (#1170 §C3) — a source the audit RAN must project: ',
                           [$strings:trim [$string $r@stderr]])]]]]]
    [= $a [$must 'parsing src --ast JSON' [$json:parse [$string $r@stdout]]]]
    [= $t [?if [= [$string [?else $a.type '']] 'Document'] [then 0]
        [else [$die [$cat ('gen_examples: expected a Document AST from the src of ',
                           $key, ' (#1170 §C3)')]]]]]
    [= $cs [?for [in $e [$array:flatten [?else $a.elements []]]]
        [yield [$node-let-cascades $e]]]]
    [?if [$empty $cs] [then 0] [else [$sum $cs]]]]]

[?def render-out-block scope=public ($key $out $err $no-stable-value)
  [?if [not [= $no-stable-value '']]
    [then [$cat (' [ex key=', $key, ' no-stable-value=true]')]]
    [else [$strings:join [$seq-flat (
        [$cat (' [ex key=', $key,
               ' chars=', [$string [$strings:length $out]],
               [?if [= $err ''] [then '']
                 [else [$cat (' err-chars=', [$string [$strings:length $err]])]]])],
        [$cat ('  [out-text ', [$out-payload $out], ']')],
        [?if [= $err ''] [then ()]
          [else ([$cat ('  [err-text ', [$out-payload $err], ']')])]],
        ' ]')] '\n']]]]

# ── main ──────────────────────────────────────────────────────────────

[?let
  [= $argv [$env:argv]]
  [= $check [$member '--check' $argv]]
  # --timings: dump every entry's measured wall time, slowest first. The
  # profile line below always names the maximum; this is for the question
  # #988 asked and the harness could not answer — "where does the time
  # actually GO across the corpus?".
  [= $timings [$member '--timings' $argv]]
  # --lint-only PATH: audit and lint the corpus at PATH, write NOTHING, compare
  # against no pin, and exit by the lints alone (RULED: 1170-g) — how a
  # fixture corpus proves a lint reds without touching the shipped corpus.
  [= $lint-only-at [?let [= $hits [?for [in $a $argv] [where [= $a '--lint-only']] [yield 1]]]
      [?if [$empty $hits] [then '']
        [else [?let [= $after [$fp:fold $argv {take: false, path: ''} [?fn ($acc $a)
                  [?if $acc.take [then {take: false, path: [?if [= $acc.path ''] [then $a] [else $acc.path]]}]
                    [else [?if [= $a '--lint-only'] [then {take: true, path: $acc.path}] [else $acc]]]]]]]
                $after.path]]]]]
  [= $lint-only [not [= $lint-only-at '']]]
  [= $self-dir [$path:dirname [$path:absolute $argv[1]]]]
  [= $data-path [?if $lint-only [then [$path:absolute $lint-only-at]] [else [$path:join $self-dir 'examples.cxd']]]]
  [= $js-path [$path:join $self-dir 'playground.examples.js']]
  # The recorded answer (#1170 §C1, RULED: 1170-a) — a generated sibling of
  # the corpus, never the corpus itself.
  [= $pin-path [$path:join $self-dir 'examples.out.cxd']]
  [= $cxbin 'vcx/target/cx']
  # PER-RUN temp dir (the pid in the name). Measured 2026-09-10 00:20Z: the
  # gate's run of this checker and an impl lane's run shared
  # $TMPDIR/cx-gen-examples, each read the other's probe files, and the
  # §C2 lint flagged eight entries that were clean alone; at 00:44Z the same
  # collision made the gate's --check DISAGREE on three examples whose
  # answers had not moved. A fixed name is a race between any two checkers.
  [= $tmpdir [$cat ([$env:var-or-default 'TMPDIR' '/tmp'], '/cx-gen-examples-', [$string [$env:pid]])]]
  [= $mk [$must 'creating tmp dir' [$io:make-dirs $tmpdir]]]
  [= $tmp [$cat ($tmpdir, '/example.cx')]]
  # Per-example capture files — see `audit`: output goes to disk, never a
  # pipe, so no example can deadlock the wait on its own volume (#988).
  [= $out-path [$cat ($tmpdir, '/example.out')]]
  [= $err-path [$cat ($tmpdir, '/example.err')]]
  # A SEPARATE tmp for the calibration probe: the audit's tmp holds the
  # composed example being retried, and the re-probe must not overwrite it.
  [= $probe-tmp [$cat ($tmpdir, '/probe.cx')]]
  # A THIRD tmp, for §C3's `--ast` projection of an example's own src: the
  # audit's tmp holds the composed example and the probe's holds the
  # builtin-head probe, and neither may be overwritten under the other.
  [= $cascade-tmp [$cat ($tmpdir, '/cascade.cx')]]

  [= $entries [$load-examples $cxbin $data-path]]
  [= $n [$count $entries]]
  [= $sanity [?if [= $n 0]
      [then [$die [$cat ('gen_examples: no [ex] entries found in ', $data-path)]]]
      [else 0]]]

  # ── the [grants] field is proved to be GRANTS before any child runs ──
  # (RULED: CXF-2). `audit` hands the field to `sh -c` unquoted so the
  # shell splits it into argv words; a token that is not a `--allow-*`
  # flag would therefore become an arbitrary argument of the child cx.
  # Checked here, once, over the whole corpus, before the first spawn:
  # refuse by KEY rather than audit a corpus that can widen its own
  # command line.
  [= $grant-shape-bad [$seq-flat [?for [in $e $entries]
      [= $g [$string $e@grants]]
      [where [not [= $g '']]]
      [yield [?for [in $tok [$strings:split-whitespace $g]]
        [where [not [$strings:starts-with $tok '--allow-']]]
        [yield [$cat ([$string $e@key], ' → ', [$jstr $tok])]]]]]]]
  [= $grant-shape [?if [$empty $grant-shape-bad] [then 0]
      [else [$die [$cat ('gen_examples: a [grants] field carries a token that ',
                         'is not a --allow-* capability flag: ',
                         [$strings:join $grant-shape-bad '; '])]]]]]

  # Calibrate BEFORE the corpus: one trivial evaluation on the shipped
  # binary sets the per-example bound for this run (see BOUND-FLOOR-MS).
  [= $probe0 [$probe-ms $cxbin $probe-tmp $out-path $err-path]]
  [= $bound0 [$bound-of $probe0]]
  [= $t-start [$time:monotonic-now]]

  # One row per entry: audit verdict + the pre-rendered block ('' on fail).
  [= $rows [?for [in $e $entries]
      [= $key [$string $e@key]]
      [= $src [$string $e@src]]
      [= $note [$string $e@note]]
      [= $grants [$string $e@grants]]
      [= $r [$audit-bounded $cxbin $tmp $probe-tmp $out-path $err-path $key
               [$compose $src $note] $bound0 $grants]]
      [yield [row key=$key status=[$string $r@status] msg=[$string $r@msg]
                ms=$r@ms
                out=[$string $r@out] err=[$string $r@err]
                src=$src bare-ok=[$string $e@bare-builtin-ok]
                expect=[$string $e@expect] no-stable=[$string $e@no-stable-value]
                section=[$string $e@section]
                block=[?if [= [$string $r@status] 'ok']
                  [then [$render-block $key [$string $e@label] $src $note $r@runnable
                          [$string $e@wasm-unsupported] [$string $e@no-stable-value]
                          [$string $e@section] $grants]]
                  [else '']]
                out-block=[?if [= [$string $r@status] 'ok']
                  [then [$render-out-block $key [$string $r@out] [$string $r@err]
                          [$string $e@no-stable-value]]]
                  [else '']]]]]]
  [= $fails [?for [in $x $rows] [where [= [$string $x@status] 'fail']] [yield $x]]]
  [= $nfails [$count $fails]]

  # The run's PROFILE, printed unconditionally. #988 was filed against a
  # harness that could say "TIMEOUT after 20s" and nothing else — no
  # per-example cost, no machine speed, no idea whether 20 s was a lot or
  # a little here. These three numbers answer that from the log alone.
  [= $total-ms [$idiv [- [$time:monotonic-now] $t-start] 1000000]]
  [= $ms-list [?for [in $x $rows] [yield $x@ms]]]
  [= $ms-max [$max $ms-list]]
  [= $slow-keys [$strings:join [?for [in $x $rows]
      [where [= $x@ms $ms-max]] [yield [$string $x@key]]] ', ']]
  [= $prof [$cry [$cat (
      '=== gen_examples profile: ', [$string $n], ' examples in ',
      [$string $total-ms], ' ms (mean ', [$string [$idiv $total-ms $n]],
      ' ms) — reference probe ', [$string $probe0], ' ms, per-example bound ',
      [$string $bound0], ' ms; slowest ', [$string $ms-max], ' ms (', $slow-keys,
      ') ===')]]]
  [= $timing-dump [?if $timings
      [then [?for [in $ms [$reverse [$sort [$uniq $ms-list]]]]
        [yield [?for [in $x $rows] [where [= $x@ms $ms]]
          [yield [$cry [$cat ('TIME  ', [$strings:pad-end [$string $x@key] 40 ' '],
                              ' ', [$string $ms], ' ms')]]]]]]]
      [else ()]]]

  [= $text [$cat ([$strings:join [$seq-flat (
      [$cat ('// CX Playground — ', [$string $n],
             ' progressive eval examples (every entry CLI-audited).')],
      HEADER-TAIL,
      [?for [in $x $rows] [where [= [$string $x@status] 'ok']] [yield [$string $x@block]]],
      FOOTER-LINES)] '\n'], '\n')]]

  # ── §C2: the bare-builtin-head lint (RULED: 1170-b) ────────────────
  # Runs BEFORE anything is written, so a corpus that trips it cannot be
  # regenerated past — the fix is by hand in examples.cxd, which is the
  # whole point.
  [= $pairs [$seq-flat [?for [in $x $rows]
      [where [= [$string $x@status] 'ok']]
      [= $k [$string $x@key]]
      [yield [?for [in $h [$resting-heads-of [$string $x@src] [$string $x@out]]]
        [yield [pair key=$k head=$h]]]]]]]
  # Each distinct head is probed ONCE, not once per example.
  [= $probe-names [$uniq [?for [in $p $pairs] [yield [$string $p@head]]]]]
  # The probe is asserted to DISCRIMINATE before a single verdict is read
  # from it: a known-missing name must answer `false` and a known builtin
  # must answer `true`. Two extra probe runs, and they are the difference
  # between this lint failing loudly and failing vacuously.
  [= $probe-miss [$is-builtin-head $cxbin $probe-tmp $out-path $err-path
      'zz-no-such-callable-1058']]
  [= $probe-hit [$is-builtin-head $cxbin $probe-tmp $out-path $err-path 'concat']]
  [= $probe-broken [not [and [not $probe-miss] $probe-hit]]]
  [= $builtin-names [?for [in $n $probe-names]
      [where [$is-builtin-head $cxbin $probe-tmp $out-path $err-path $n]]
      [yield $n]]]
  [= $flagged [?for [in $p $pairs]
      [where [$member [$string $p@head] $builtin-names]]
      [yield $p]]]
  [= $flagged-keys [$uniq [?for [in $p $flagged] [yield [$string $p@key]]]]]
  [= $marked-keys [?for [in $x $rows]
      [where [= [$string $x@status] 'ok']]
      [where [not [= [$string $x@bare-ok] '']]]
      [yield [$string $x@key]]]]
  [= $unmarked [?for [in $k $flagged-keys]
      [where [not [$member $k $marked-keys]]] [yield $k]]]
  [= $unjustified [?for [in $k $marked-keys]
      [where [not [$member $k $flagged-keys]]] [yield $k]]]
  # §C2 and §C3 both REPORT here and neither exits: the two classes are
  # independent, and a corpus that trips both should learn about both in
  # one run. 1170-b's own warning is that a gate which is painful to act
  # on teaches people to ignore it, and "fix one, rerun, discover the
  # other" is that pain.
  [= $c2-bad [or $probe-broken [not [and [$empty $unmarked] [$empty $unjustified]]]]]
  [= $c2 [?if $c2-bad
      [then (
        [$cry [$cat ('=== gen_examples: the bare-builtin-head lint FAILED ',
                     '(#1170 §C2, RULED: 1170-b) — refusing to ',
                     [?if $check [then 'verify'] [else 'write']], ' ===')]],
        [?for [in $b [?if $probe-broken [then (1)] [else ()]]]
          [yield [$cry [$cat ('PROBE the builtin probe no longer DISCRIMINATES ',
              '(missing-name=', [$string $probe-miss],
              ' builtin=', [$string $probe-hit], ', both should differ). ',
              'is-builtin-head reads the name-resolution MISS code; the engine ',
              'has changed its spelling, so every verdict below is vacuous. ',
              'Fix the predicate, not the corpus (#1058 T1.6-b did this once).')]]]],
        [?for [in $k $unmarked] [yield [$cry [$cat ('BARE  ',
            [$strings:pad-end $k 40 ' '], ' builds ',
            [$strings:join [?for [in $p $flagged]
              [where [= [$string $p@key] $k]]
              [yield [$cat ('[', [$string $p@head], ' …]')]]] ', '],
            ' as DATA — a bare head is not a call since R-A1; write [$',
            [$string [?for [in $p $flagged]
              [where [= [$string $p@key] $k]] [yield [$string $p@head]]][1]],
            ' …], or add [bare-builtin-ok [# why this is data #]] to the entry')]]]],
        [?for [in $k $unjustified] [yield [$cry [$cat ('MARK  ',
            [$strings:pad-end $k 40 ' '],
            ' carries [bare-builtin-ok] but builds no bare builtin head —',
            ' an unjustified marker is a failure too; remove it')]]]],
        1)]
      [else 0]]]

  # ── §C3: the [?let]-cascade lint (RULED: 1170-c) ───────────────────
  # The PREFILTER is sound rather than convenient: a cascade needs two
  # `[?let]` directives in one src, and `[?let` is the ONLY spelling —
  # `[? let` is `expected name` and `[?LET` parses as a processing
  # instruction, neither of them a let. So an src with fewer than two
  # occurrences cannot cascade and is not worth a process; over the
  # corpus that is 7 parses, not 202.
  [= $multi-let [?for [in $x $rows]
      [where [= [$string $x@status] 'ok']]
      [where [>= [$count [$re:find-all [$re:compile LET-RX-SRC] [$string $x@src]]] 2]]
      [yield $x]]]
  [= $cascaded [?for [in $x $multi-let]
      [= $n [$src-cascades $cxbin $cascade-tmp [$string $x@key] [$string $x@src]]]
      [where [> $n 0]]
      [yield [hit key=[$string $x@key] n=$n]]]]
  [= $c3-bad [not [$empty $cascaded]]]
  [= $c3 [?if $c3-bad
      [then (
        [$cry [$cat ('=== gen_examples: the [?let]-cascade lint FAILED ',
                     '(#1170 §C3, RULED: 1170-c) — refusing to ',
                     [?if $check [then 'verify'] [else 'write']], ' ===')]],
        [?for [in $h $cascaded] [yield [$cry [$cat ('CASCADE  ',
            [$strings:pad-end [$string $h@key] 40 ' '], ' ',
            [$string $h@n], ' [?let] in a [?let] BODY — [?let] takes all its',
            ' bindings in ONE flat list and each reads the ones before it',
            ' (code.md §8.5); a second [?let] for a second binding is the',
            ' Scheme habit tracked as #361. Merge them into the outer [?let].')]]]],
        1)]
      [else 0]]]

  # ONE exit for both classes. The two `[= $c2 …]` / `[= $c3 …]` bindings
  # above are what PRINT (a sequence literal evaluates its elements; a
  # bare `[?for]` bound to nothing would not), and this reads the verdict
  # off the booleans rather than off their shape.
  # ── §C4: the [expect] check (RULED: 1170-g) — EXACT, never heuristic ─
  # An entry may carry `[expect [# … #]]`: a literal substring its pinned
  # output must contain. The prose [note] is never read by this check —
  # 1170-b's warning is that a heuristic extractor false-reds and teaches
  # people to ignore the gate — so a note that promises an answer without
  # pinning it in [expect] is a REVIEW finding, not a lint. An entry marked
  # no-stable-value has no single answer and is not graded here.
  [= $expect-misses [?for [in $x $rows]
      [where [= [$string $x@status] 'ok']]
      [where [= [$string $x@no-stable] '']]
      [where [not [= [$string $x@expect] '']]]
      [where [not [$strings:contains [$string $x@out] [$string $x@expect]]]]
      [yield $x]]]
  [= $expect-count [$count [?for [in $x $rows]
      [where [not [= [$string $x@expect] '']]] [yield 1]]]]
  [= $c4-bad [not [$empty $expect-misses]]]
  [= $c4 [?if $c4-bad
      [then (
        [$cry [$cat ('=== gen_examples: the [expect] check FAILED (#1170 §C4, RULED: 1170-g) — ',
                     [$string [$count $expect-misses]], ' of ', [$string $expect-count],
                     ' pinned expectations are not in the output ===')]],
        [?for [in $x $expect-misses] [yield [$cry [$cat ('EXPECT ',
            [$strings:pad-end [$string $x@key] 40 ' '],
            ' output does not contain ', [$jstr [$string $x@expect]],
            '; the output is ', [$jstr [$string $x@out]],
            ' — fix the example, or the [expect], never the pin')]]]],
        1)]
      [else 0]]]
  [= $c4-note [$cry [$cat ('=== [expect] pins graded: ', [$string $expect-count],
                            ' of ', [$string $n], ' entries carry one (#1170 §C4)')]]]
  # ── §C5: every entry names a SECTION the picker knows (#1375) ─────────
  # The picker groups by this field, so an entry without one, or with a
  # misspelt one, would silently vanish from the page. Closed list; the
  # display names live beside it in playground.js.
  [= $section-misses [?for [in $e $entries]
      [where [not [$member [$string $e@section] KNOWN-SECTIONS]]]
      [yield [$cat ([$string $e@key], ' section=', [$jstr [$string $e@section]])]]]]
  [= $c5-bad [not [$empty $section-misses]]]
  [= $c5 [?if $c5-bad
      [then (
        [$cry [$cat ('=== gen_examples: the SECTION check FAILED (#1375) — ',
                     [$string [$count $section-misses]], ' entries carry no known section ===')]],
        [?for [in $x $section-misses] [yield [$cry [$cat ('SECTION ', $x)]]]],
        1)]
      [else 0]]]
  [= $lint [?if [or $c2-bad $c3-bad $c4-bad $c5-bad] [then [$env:exit 1]] [else 0]]]
  # --lint-only stops here: the lints ARE the verdict and nothing is written.
  [= $lint-only-exit [?if $lint-only
      [then ([$cry [$cat ('=== gen_examples --lint-only: ', [$string $n], ' entries, lints clean ===')]], [$env:exit 0])]
      [else 0]]]

  # The raw-text payload has ONE limit and it is the corpus's own: a
  # literal terminator inside a payload cannot be written. Refuse by KEY
  # rather than emit a malformed pin — a pin file that does not parse is
  # worse than no pin, because --check compares text and would go green
  # over it forever.
  [= $raw-term-hits [?for [in $x $rows]
      [where [= [$string $x@status] 'ok']]
      [where [or [$strings:contains [$string $x@out] RAW-TERM]
                 [$strings:contains [$string $x@err] RAW-TERM]]]
      [yield [$string $x@key]]]]
  [= $raw-term-check [?if [$empty $raw-term-hits] [then 0]
      [else [$die [$cat ('gen_examples: captured output contains the raw-text ',
                         'terminator, which examples.out.cxd cannot carry: ',
                         [$strings:join $raw-term-hits ', '])]]]]]

  [= $pin-text [$cat ([$strings:join [$seq-flat (
      [$cat ('[playground-example-outputs  # ', [$string $n],
             ' audited answers, corpus order')],
      OUT-HEADER-TAIL,
      [?for [in $x $rows] [where [= [$string $x@status] 'ok']]
        [yield [$string $x@out-block]]],
      ']')] '\n'], '\n')]]

  [= $done (
    [?if [> $nfails 0]
      [then (
        [$cry [$cat ('=== gen_examples: ', [$string $nfails],
                     ' example(s) FAILED — refusing to ',
                     [?if $check [then 'verify'] [else 'write']], ' ===')]],
        [?for [in $x $fails] [yield
          [$cry [$cat ('FAIL  ', [$strings:pad-end [$string $x@key] 40 ' '], ' ',
                       [$strings:slice [$string $x@msg] 1 160])]]]],
        [$env:exit 1])]
      [else ()]],
    [?if $check
      [then [?let
        [= $exists [$io:exists $js-path]]
        [= $current [?if $exists
            [then [$must 'reading current js' [$io:read-file $js-path]]]
            [else '']]]
        [= $js-ok [and $exists [= [$string $current] $text]]]
        # The pin is checked in the SAME pass and reported SEPARATELY:
        # "the bundle is current" and "every example still computes what
        # it computed" are two different claims, and a reader of the gate
        # log has to be able to tell which one broke (#1170 §C1).
        [= $pin-exists [$io:exists $pin-path]]
        [= $pin-current [?if $pin-exists
            [then [$must 'reading current pin' [$io:read-file $pin-path]]]
            [else '']]]
        [= $pin-ok [and $pin-exists [= [$string $pin-current] $pin-text]]]
        [?if [and $js-ok $pin-ok]
          [then ([$cry [$cat ('=== gen_examples --check: OK — ', [$string $n],
                              ' examples clean & current, ', [$string $n],
                              ' answers unchanged ===')]],
                 [$env:exit 0])]
          [else (
            [?if $js-ok [then ()]
              [else ([$cry '=== gen_examples --check: playground.examples.js is STALE ==='],)]],
            [?if $pin-ok [then ()]
              [else ([$cry [$cat ('=== gen_examples --check: examples.out.cxd ',
                                  [?if $pin-exists
                                    [then 'DISAGREES with this run — an example computes something else than the recorded answer']
                                    [else 'is MISSING']], ' ===')]],
                     [; NAME the entries, do not just say one moved. The first
                        cut of this check compared the two pin files as whole
                        strings and reported only that "an example computes
                        something else", which is a gate that reds without
                        saying what — and it cost a full diagnosis detour to
                        find out which of 202 entries had moved. An entry's
                        recorded block is a contiguous run of the pin, so
                        containment names it with no new string surface. An
                        entry present in the pin and GONE from this run is not
                        named here; the corpus is the source of truth for what
                        exists, and the audited-answer count above covers it. ]
                     [?for [in $x $rows]
                       [where [= [$string $x@status] 'ok']]
                       [where [not [$strings:contains $pin-current [$string $x@out-block]]]]
                       [yield [$cry [$cat ('    DISAGREES  ', [$string $x@key])]]]],
                     [$cry '    Read the diff against each entry\'s [note] before accepting it:'],
                     [$cry '    a note promising an answer the pin contradicts is the defect (#1170).'])]],
            [$cry '    Run: make playground-examples-regen'],
            [$env:exit 1])]]]]
      [else (
        [$must 'writing playground.examples.js' [$io:write-file $js-path $text]],
        [$cry [$cat ('=== wrote: ', $js-path)]],
        [$must 'writing examples.out.cxd' [$io:write-file $pin-path $pin-text]],
        [$cry [$cat ('=== wrote: ', $pin-path)]],
        [$cry [$cat ('=== passing: ', [$string $n], '/', [$string $n], ' (all clean) ===')]])]]
  )]
  [?if false [then '']]]
