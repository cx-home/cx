# scripts/gen_guide/stdlib_docs_check.cx -- co-located stdlib doc freshness gate.
#
# Eat-our-own-dog-food: written entirely in CX, run under `cx eval`. It
# guards the co-located documentation in stdlib/*.cx AND x/*.cx (stream 18,
# L143 -- a description that becomes agent-facing tool contract cannot be
# ungated) ([module-doc] / [fn-doc]) against drift from the implementation
# and the conformance corpus. It enforces, for every bundled module:
#
#   (1) PRESENCE PARITY  -- every public [?def NAME ...] has a matching
#       [fn-doc name=NAME ...], and every [fn-doc] names a real public def
#       (no orphan docs). This is what makes a "38 != N functions" drift
#       impossible to ship silently.
#   (2) PURITY AGREEMENT -- each [?def]'s `pure`/`impure` keyword matches
#       its [fn-doc]'s `purity=` attribute.
#   (6) DOC EXTRACTABILITY -- every bundled module projects at least one
#       [module-doc]/[fn-doc] span through [$cx:ast], which is what the
#       guide's stdlib pages are built from.
#   (3) EXAMPLE BACKING  -- every [fn-doc]/[example]'s code block AND its
#       expected output appear verbatim in the module's conformance corpus
#       (conformance/stdlib/<m>.cxd). Because that corpus is executed green
#       by `make test-vcx-suite` (test_stdlib_module_fixtures), a documented
#       example that is backed by it is, transitively, an example that runs
#       green -- and a hand-edited example that drifts from real behavior
#       (wrong call or wrong output) is no longer backed and fails here.
#       Modules with no .cxd (the new `xap`, whose examples come from the
#       live demo ladder, not a fixture file) are skipped for backing.
#   (4) SUMMARY REQUIRED FOR COMMANDS (stream 18, L143) -- an
#       [effects]-bearing public [?def] whose [fn-doc] lacks a [summary]
#       fails the gate: the same condition the agent-tool projection
#       (cx-x/tools) fails loudly on at list time, caught here at commit
#       time instead. Commands are found structurally via [$cx:ast]
#       (clause PRESENCE, zero-item included) -- never by regex.
#   (5) PARAM-DOC NAME VALIDITY (stream 18, L143) -- every
#       [param-doc name=N] under [fn-doc name=F] names a real parameter
#       of def F (params from the [$cx:ast] projection).
#
# Fail-loud contract (#811): any internal [err] from a probe (a regex
# group miss, a parse failure) FAILS the gate naming the module -- an
# error must never render-and-exit-0.
#
# Module-set parity (the bundle vs the status=current spec set, incl. the
# bundled-but-separately-specced `xap`) is owned by a separate gate,
# `make stdlib-catalog-gate` (SPEC == BUNDLE union DISPATCH); it is not
# re-checked here.
#
# Why example-backing rather than "examples ARE the fixtures": the per-
# module .cxd is the full conformance matrix (happy + error + edge +
# ambiguous, with err-codes and levels) -- typically far more cases than
# the one illustrative example per function -- so collapsing the test
# source onto the doc examples would discard negative/edge coverage. The
# .cxd stays authoritative; the examples are pinned to it. (Design note
# recorded in spec/03-approved/process/stdlib_colocated_docs.md.)
#
# Capabilities: glob / read-file need `read`; the env standard streams +
# exit are ambient (env.md §7). Run:
#   vcx/target/cx eval --allow-read scripts/gen_guide/stdlib_docs_check.cx
#   (or: make guide-check)

[?lib 'cx-stdlib/cx']
[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/json'    as=json]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/process' as=process]

# example child-text extractors (mirror guide_build's ex-part).
[?def ex-code ($ex)
  [$strings:join [?for [in $c $ex/*] [yield [?match $c [case [code $t] $t] [else ()]]]] '']]
[?def ex-expect ($ex)
  [$strings:join [?for [in $c $ex/*] [yield [?match $c [case [expect $t] $t] [else ()]]]] '']]

# ── the SYNTHESIZED modules (#1368, RULED: 1368-a) ─────────────────────
# Five module surfaces reach a program through register_bundled_codecs and
# have NO FILE ON DISK, so the globs below cannot see them and their
# [fn-doc]s were ungraded — the gap #1368 measured. They are read from the
# LOADER instead, through `cx stdlib`, which answers for a disk-backed and a
# synthesized module identically.
#
# A non-zero exit is FATAL (exit 2, distinct from the gate's 1 = drift):
# an empty listing read as "no synthesized modules" would skip five modules
# while reporting a pass, which is the absence-based check that cannot
# report its own death.
[?def cx-run impure ($args)
  [?let [= $r [$process:run $args]]
    [?if [not [= $r@exit-code 0]]
      [then ([$io:write-line [$env:stderr]
               [$concat "stdlib-docs-check: `" [$strings:join $args " "]
                        "` failed (exit " [$string $r@exit-code]
                        ") -- cannot read the synthesized module set"]],
             [$env:exit 2], "")]
      [else [$string $r@stdout]]]]]

# registry-corpus: the {name, source, corpus} of every registry row, read
# once. #1427-c moved a module's corpus into its RING's directory, so
# "conformance/stdlib/<m>.cxd" is no longer where half of them are; the
# registry is where a surface's corpus is DECLARED (RULED: 1427-f), and
# reading it here means this gate follows a corpus wherever the tree puts it
# instead of quietly finding no .cxd and skipping the example check — the
# vacuous shape #1427 exists to remove.
[?def registry-corpus scope=private impure [returns any] ()
  [?let [= $reg [$cx:parse [$io:read-file "registry/modules.cxd"]]]
    [?for [in $m $reg//module]
      [yield {name:   [$string $m@name]
              source: [$string [?else $m@source "none"]]
              corpus: [$string [?else $m@corpus "none"]]}]]]]

# corpus-path: the corpus a module's rows declare. A module is matched on its
# bundled SOURCE first, because `term` is two surfaces with one name (the
# `$term-*` natives family and cx-x/term) and only the source tells them
# apart; a synthesized module has no source and falls back to the name.
[?def corpus-path scope=private pure [returns string] ($rows::[sequence any] $name::string $source::string)
  [?let [= $by-source
          [?for [in $r $rows]
            [where [not [= $source "none"]]]
            [where [= $r.source $source]]
            [where [not [= $r.corpus "none"]]]
            [yield $r.corpus]]]
        [= $by-name
          [?for [in $r $rows]
            [where [= $r.name $name]]
            [where [not [= $r.corpus "none"]]]
            [yield $r.corpus]]]
    [?if [> [$count $by-source] 0] [then [$first $by-source]]
      [else [?if [> [$count $by-name] 0] [then [$first $by-name]]
        [else [$concat "conformance/stdlib/" $name ".cxd"]]]]]]]

[?def synth-names impure ()
  [?for [in $l [$strings:split [$cx-run ([$env:executable-path], 'stdlib', 'list', '--synthesized')] "\n"]]
    [where [not [= $l ""]]]
    [yield $l]]]

[?def synth-source impure ($m)
  [$cx-run ([$env:executable-path], 'stdlib', 'source', $m)]]

# RE2 over the raw module text: every public [?def] with its purity word.
[?def def-rx () [$re:compile "\\[\\?def\\s+([a-z0-9-]+)\\s+scope=public(\\s+(pure|impure))?"]]

[?let [= $rx [$def-rx]]
  # The bundled sources, wherever the build reads them from. `deps/*/stdlib/*.cx`
  # is not a second directory to keep in step: it is the SAME set, for the
  # modules that have been extracted into their own repositories (RULED: RS-7,
  # RS-12). registry/modules.cxd's `repo=` row names the pinned path, the
  # profile builds embed it, and this check reads it -- so a module does not
  # stop owing its [fn-doc]s the day it moves. The corpus each example is
  # matched against comes from the same row (`corpus-path` below reads
  # `source=`), which is the pinned repository's corpus at the pinned sha, so
  # the two halves can never be from different versions. A tree with no deps/
  # would simply not see the module here -- which is why `placement-gate` fails
  # loudly on the missing path rather than leaving that silence to this step.
  [?let [= $bundle-files [?for [in $g ([$io:glob "stdlib/*.cx"], [$io:glob "x/*.cx"], [$io:glob "deps/*/stdlib/*.cx"])] [in $f $g] [yield $f]]]

    # Every module this gate grades, as {name, text} — a file on disk and a
    # synthesized surface are the same thing to every check below, which is
    # the point: the checks read a module's SOURCE, and where that source
    # comes from is the loader's business, not theirs.
    [?let [= $modules
      [?for [in $src (
              [?for [in $f $bundle-files] [yield {name: [$path:stem $f], text: [$io:read-file $f], source: $f}]],
              [?for [in $n [$synth-names]]  [yield {name: $n, text: [$synth-source $n], source: "none"}]])]
            [in $mod $src]
            [yield $mod]]]
          [= $reg-rows [$registry-corpus]]

    # --- per-module (1)(2)(3)(4)(5): one violation blob per module -----
    [?let [= $blobs
      [?for [in $mod $modules]
        [= $m $mod.name]
        [= $txt $mod.text]
        [= $cxdpath [$corpus-path $reg-rows $m $mod.source]]
        [= $has-cxd [$io:exists $cxdpath]]
        [= $cxdraw [?if $has-cxd [then [$io:read-file $cxdpath]] [else ""]]]
        # the structured def view (stream 18: [$cx:ast] — commands by clause
        # PRESENCE + per-def param lists; fail LOUD on a malformed module).
        [= $ast-raw [$cx:ast $txt]]
        [= $ast-bad [?match $ast-raw [case [err @code=$c] true] [else false]]]
        [= $astviol [?if $ast-bad
                      [then ([$concat "  [" $m "] cx:ast refused the module source: " [$string $ast-raw]])]
                      [else ()]]]
        [= $ast [?if $ast-bad [then {}] [else [$json:parse $ast-raw]]]]
        [= $defs [?else $ast.defs []]]
        # the doc lane: fn-doc/example elements from the VERBATIM docs spans
        # (a whole-module data parse chokes on program-bearing def bodies).
        [= $spans [?else $ast.docs []]]
        [= $fn-docs [?for [in $sp $spans]
                      [= $el [$cx:parse $sp]]
                      [where [= [$name $el] "fn-doc"]]
                      [yield $el]]]
        # (6) DOC EXTRACTABILITY -- the guide's stdlib pages are projected
        # from these same spans (scripts/gen_guide/guide_build.cx ::
        # module-docs). A module whose docs stop projecting must fail HERE,
        # loudly, instead of taking every stdlib page of the guide down with
        # it at `make guide` time (#889: diagram.cx was the first module to
        # use program-only syntax, and the guide's whole-file data parse died
        # on it).
        [= $spanviol [?if [= [$count $spans] 0]
                       [then ([$concat "  [" $m "] no [module-doc]/[fn-doc] blocks project from the module source (guide_build cannot render its page)"],)]
                       [else ()]]]
        # (4) summary-required-for-commands
        [= $cmdviol
          [?for [in $cd [$filter $defs [?fn ($q) [?match $q [case {effects: $e} true] [else false]]]]]
            [= $nm $cd.name]
            [= $has-summary [> [$count [?for [in $fd $fn-docs] [where [= $fd@name $nm]] [where [$exists $fd/summary]] [yield 1]]] 0]]
            [where [not $has-summary]]
            [yield [$concat "  [" $m "] command def `" $nm "` has no [fn-doc][summary] — unprojectable (L143)"]]]]
        # (5) param-doc name validity
        [= $pdviol
          [?for [in $fd $fn-docs]
            [= $fnm $fd@name]
            [= $owner [$filter $defs [?fn ($q) [= $q.name $fnm]]]]
            [in $pd $fd//param-doc]
            [= $pnm $pd@name]
            [= $ownerdef [$first $owner]]
            [= $valid [?if [$exists $owner]
                        [then [> [$count [?to-sequence [$filter [?else $ownerdef.params []] [?fn ($pp) [= $pp.name $pnm]]]]] 0]]
                        [else false]]]
            [where [not $valid]]
            [yield [$concat "  [" $m "] [param-doc name=" $pnm "] on `" $fnm "` names no parameter of that def (L143)"]]]]
        [= $defviol
          [?for [in $dm [$re:find-all $rx $txt]]
            [= $nm [$re:group $dm 1]]
            [= $dpur [?fallback [$re:group $dm 3] [recover-with ""]]]
            [= $doc-exists [> [$count [?for [in $fd $fn-docs] [where [= $fd@name $nm]] [yield 1]]] 0]]
            [= $pur-ok [or [= $dpur ""]
                           [> [$count [?for [in $fd $fn-docs] [where [= $fd@name $nm]] [where [= $fd@purity $dpur]] [yield 1]]] 0]]]
            [= $line [?if [not $doc-exists]
                       [then [$concat "  [" $m "] missing [fn-doc] for public def: " $nm]]
                       [else [?if [not $pur-ok]
                               [then [$concat "  [" $m "] purity mismatch on " $nm ": def=" $dpur " but fn-doc differs"]]
                               [else ""]]]]]
            [where [not [= $line ""]]]
            [yield $line]]]
        [= $docviol
          [?for [in $fd $fn-docs]
            [= $nm $fd@name]
            [= $def-exists [> [$count [?for [in $dm [$re:find-all $rx $txt]] [where [= [$re:group $dm 1] $nm]] [yield 1]]] 0]]
            [where [not $def-exists]]
            [yield [$concat "  [" $m "] orphan [fn-doc] with no public def: " $nm]]]]
        [= $exviol
          [?for [in $fd $fn-docs]
            [in $ex $fd//example]
            [= $code [$strings:trim [$ex-code $ex]]]
            [= $expect [$strings:trim [$ex-expect $ex]]]
            [where $has-cxd]
            [where [not [and [$strings:contains $cxdraw $code] [$strings:contains $cxdraw $expect]]]]
            [yield [$concat "  [" $m "] example not backed by " $m ".cxd:\n      " $code "\n      => " $expect]]]]

        [= $parts [?for [in $blk ([$strings:join $astviol "\n"], [$strings:join $spanviol "\n"], [$strings:join $cmdviol "\n"], [$strings:join $pdviol "\n"], [$strings:join $defviol "\n"], [$strings:join $docviol "\n"], [$strings:join $exviol "\n"])]
                    [where [not [= $blk ""]]] [yield $blk]]]
        [= $blob [$strings:join $parts "\n"]]
        [where [not [= $blob ""]]]
        [yield $blob]]]

    [?let [= $n-bad [$count $blobs]]
      [?if [= $n-bad 0]
        [then
          [?let [= $_ok [$io:write-line [$env:stdout]
              [$concat "guide-check OK -- " [$count $modules]
                       " modules (" [$count $bundle-files] " on disk, "
                       [- [$count $modules] [$count $bundle-files]]
                       " synthesized): every public def has a [fn-doc] (presence + purity), and every example is backed by its conformance corpus."]]]
            [$env:exit 0]]]
        [else
          [?let [= $_fail [$io:write-line [$env:stderr]
              [$concat "guide-check FAILED -- co-located stdlib docs drifted:\n"
                       [$strings:join $blobs "\n"]]]]
            [$env:exit 1]]]]]]]]]
