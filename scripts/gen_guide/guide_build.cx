[# scripts/gen_guide/guide_build.cx — the CX-native guide build driver.

   Replaces scaffold.sh + the _*.py helpers. ONE cx program reads
   docs-src/canonical/ and emits the multi-page site at docs/guide/ —
   render = .cx, dogfooded end to end (codec.md §1 in-memory pipeline:
   read → [$cx:parse] → transform → [$xml:emit] → [$io:write-file], no
   Python). It is NOT subprocess-free any more: since #1368 (RULED 1368-a's
   rider) `synth-libfiles` and `module-source-of` below spawn the binary for
   `cx stdlib list --synthesized` and `cx stdlib source <m>` — a synthesized
   codec module has no file on disk, so its source comes from the
   synthesizer, never from a glob.

   Run: cx --allow-read --allow-write --allow-subprocess
   scripts/gen_guide/guide_build.cx
   (the Makefile `guide` target builds the binary + passes the grants).

   Pipeline per section:
     1. read sections/NN-slug.cxd, [$cx:parse] → DocumentNode
     2. //section → the section element; render its children into an
        HTML-shaped CX tree (h1 + blocks + nested child sections)
     3. [$xml:emit] → HTML fragment; post-process (strip the empty-name
        <>/</> sequence wrappers [$xml:emit] puts around [?for] bodies,
        rewrite <code lang="X"> → class="language-X")
     4. wrap with chrome (sidebar nav + head + scripts) → write <slug>.html

   Section metadata (number, slug, title) comes straight from each
   section file's own [section n= id= title=] header — no separate
   manifest parse needed; glob order is the reading order. #]

[?lib 'cx-stdlib/io']
[?lib 'cx-stdlib/cx']
[?lib 'cx-stdlib/xml']
[?lib 'cx-stdlib/strings']
[?lib 'cx-stdlib/format']
[?lib 'cx-stdlib/json']
[?lib 'cx-stdlib/re']
[?lib 'cx-stdlib/fp']
[?lib 'cx-stdlib/env']
[?lib 'cx-stdlib/process']
[?lib 'cx-stdlib/map']
[; RS-30: the primer's fixture index, replay and freshness check, and the
   landing page's registry counts — imported, never read a second time (see
   "fixture-backed examples" below). Neither file's top-level run executes on
   import. ]
[?lib './scripts/gen_docs/primer_build.cx' as=pb]
[?lib './scripts/gen_site/site_build.cx' as=sb]
[; DOCS-42: the ring figure and the plug-in figures, rendered from the
   registries — inlined by a [figure name=…] block and on the guide home, and
   written untracked as assets/rings.svg. ]
[?lib './scripts/gen_site/ring_svg.cx' as=rs]
[; DOCS-41 / DOCS-49 waves 2–4: the repository pages — one prose file under
   docs-src/repos/<name>.cxd, every fact projected from the registries by
   repo_page.cx, the plug-in figure by plugs_svg.cx, rendered here as
   repo-<name>.html with the guide's chrome. ]
[?lib './scripts/gen_site/repo_page.cx'  as=rp]
[?lib './scripts/gen_site/plugs_svg.cx'  as=plugs]

[# ── string helpers ──────────────────────────────────────────────────── #]

[# cat: join string parts with no separator. #]
[?def cat scope=public ($parts) [$strings:join $parts '']]

[; asset cache-busting suffix (#953) — see copy-stamped-if below. ]
[?def stamp scope=public ($path $ver) [$cat ($path, '?v=', $ver)]]

[# parse-or-die: read + parse a source file; a parse failure names the
   file on stderr and exits 1. A failed section must never be silently
   dropped from the site (issue #425: 10 of 16 pages vanished with
   rc=0 while [$cx:parse]'s [err] value quietly navigated to ()). #]
[?def parse-or-die scope=public impure ($f)
  [?let [= $d [$cx:parse [$io:read-file $f]]]
    [?match $d
      [case [err $e]
        ([$io:write-line [$env:stderr]
           [$cat ('guide_build: PARSE FAILED — ', $f, ' — ', $e@message)]],
         [$env:exit 1])]
      [else $d]]]]

[# slug-of: '…/sections/02-data-language.cxd' → 'data-language'
   (basename, strip NN- prefix + .cxd). #]
[?def slug-of scope=public ($f)
  [?let [= $b [$strings:slice $f [+ [$strings:rfind $f '/'] 1] [$strings:length $f]]]
        [= $i [$strings:find $b '-']]
    [$strings:replace [$strings:slice $b [+ $i 1] [$strings:length $b]] '.cxd' '']]]

[# ── inline-markdown rendering ───────────────────────────────────────────
   The .cxd sections carry GFM inline spans in prose strings — `code`,
   **bold**, *italic* — a convention the docs→guide migration brought over
   in ~900 places. The projection engine owns rendering them (the same way
   §3.6 says CX projects markdown), so they become real elements here
   rather than shipping as literal sigils. Existing <code>/<pre> regions
   are content, not markup: they are skipped verbatim.

   md-emph: bold/italic on a chunk with no code spans. Both patterns are
   boundary-guarded (start / whitespace / '(' / '>' before, end / space /
   punctuation / '<' after) so prose arithmetic ('3 * 4') and glob stars
   ('a/*.cx and b/*.md') never read as emphasis. NOTE the engine quirk:
   \s inside a character class silently matches nothing (and an unescaped
   '(' beside it is E_RE_PATTERN_INVALID), so whitespace is spelled out. #]
[?def md-emph-once impure ($s)
  [$re:replace [$re:compile '(^|[ \n\t(>])\*([^ \n\t*<](?:[^*<]*[^ \n\t*<])?)\*($|[ \n\t).,;:!?<])']
    [$re:replace [$re:compile '(^|[ \n\t(>])\*\*([^*<]+)\*\*($|[ \n\t).,;:!?<])']
      $s '$1<b>$2</b>$3']
    '$1<i>$2</i>$3']]
[; TWO passes: the trailing boundary guard CONSUMES its character (this
   regex engine has no lookahead), so of two ADJACENT emphasis spans the
   second loses its leading boundary to the first match and fails; on the
   second pass the rewritten text supplies a fresh '>' or space boundary. ]
[?def md-emph scope=public impure ($s)
  [$md-emph-once [$md-emph-once $s]]]

[# md-ticks: pair backticks into <code> spans; emphasis runs only on the
   text BETWEEN them, so `a ** b` inside ticks stays verbatim. An unmatched
   trailing tick is kept literal. The composite forms **`x`** / *`x`* are
   folded FIRST — the tick split would otherwise part an emphasis pair
   around its own code span, and the '<'-excluding content classes in
   md-emph would then (correctly) refuse the crossing match. #]
[?def md-tick-composites impure ($s)
  [$re:replace [$re:compile '(^|[ \n\t(>])\*`([^`]+)`\*($|[ \n\t).,;:!?<])']
    [; boundary-guarded like md-emph — without the guards this pattern
       cross-pairs a CLOSING ** with a later OPENING ** whenever a code
       span sits between two bold pairs ('**a** … `x` … **b**' matched
       as one bold). Two passes for the same consumed-boundary reason
       as md-emph. ]
    [$re:replace [$re:compile '(^|[ \n\t(>])\*\*([^*`<]*)`([^`]+)`([^*`<]*)\*\*($|[ \n\t).,;:!?<])']
      $s '$1<b>$2<code>$3</code>$4</b>$5']
    '$1<i><code>$2</code></i>$3']]
[; md-links: markdown [label](url) → <a> — the corpus has always authored
   links this way and the renderer never had a pass for them (143 literal
   link spellings shipped on 14 pages). Runs BEFORE tick segmentation so a
   label carrying `code` stays attached to its url; the url must contain
   a / . # or : so prose like 'array[0](x)' can never read as a link. ]
[?def md-links impure ($s)
  [$re:replace [$re:compile '\[([^\[\]<]+)\]\(([^() \n\t]*[/.#:][^() \n\t]*)\)']
    $s '<a href="$2">$1</a>']]
[; md-tick-pairs: every `x` pair → <code>x</code> in ONE global regex pass.
   The former per-pair self-recursion hit the evaluator's call-depth ceiling
   at ~195 spans and RETURNED EARLY, silently truncating nine rendered pages
   (#826 verification find, 2026-08-20 — the Ring 0/1 arcs shipped at 34%/31%).
   An unpaired trailing tick has no match and stays literal, matching the old
   behavior. ]
[?def md-tick-pairs impure ($s)
  [$re:replace [$re:compile '`([^`]*)`'] $s '<code>$1</code>']]

[; walk-emph: apply md-emph to the prose BETWEEN <code>…</code> regions —
   iteratively: a [?for] over the '<code' split makes one FLAT call per
   region, never a nested one, so span count can never meet a depth cap. ]
[?def walk-emph impure ($s)
  [?let [= $parts [$strings:split $s '<code']]
    [$cat (
      [$md-emph [$first $parts]],
      [$strings:join
        [?for [in $p [$tail $parts]]
          [yield
            [?let [= $end [$strings:find $p '</code>']]
              [?if [not [$present $end]]
                [then [$cat ('<code', $p)]]
                [else [$cat ('<code',
                             [$strings:slice $p 1 [- [+ $end 7] 1]],
                             [$md-emph [$strings:slice $p [+ $end 7] [$strings:length $p]]])]]]]]]
        ''])]]]

[?def md-ticks scope=public impure ($s0)
  [$walk-emph
    [$md-tick-pairs
      [$md-tick-composites [$md-tick-composites [$md-links $s0]]]]]]

[# md-inline: walk the emitted fragment, passing existing <code>…</code>
   regions through untouched (mirrors escape-code-xrefs; every [pre] body
   is a [code], so this shields code blocks too). Same flat-iteration shape
   as walk-emph: prose chunks between pre-existing code regions go through
   md-ticks; the regions themselves are copied verbatim. #]
[?def md-inline scope=public impure ($h)
  [?let [= $parts [$strings:split $h '<code']]
    [$cat (
      [$md-ticks [$first $parts]],
      [$strings:join
        [?for [in $p [$tail $parts]]
          [yield
            [?let [= $end [$strings:find $p '</code>']]
              [?if [not [$present $end]]
                [then [$cat ('<code', $p)]]
                [else [$cat ('<code',
                             [$strings:slice $p 1 [- [+ $end 7] 1]],
                             [$md-ticks [$strings:slice $p [+ $end 7] [$strings:length $p]]])]]]]]]
        ''])]]]

[# post-body: clean an [$xml:emit] fragment.
   - strip the empty-name <>/</> wrappers [$xml:emit] emits around a
     [?for]/yield sequence in body position (structural noise, the
     in-program analogue of the old cx --xml <__cx_seq__> wrapper);
   - rewrite <code lang="X"> → <code class="language-X"> for highlight.js;
   - render the inline-markdown authoring convention (md-inline above). #]
[?def post-body scope=public impure ($h)
  [?let [= $in [$strings:replace
                 [$strings:replace
                   [$strings:replace $h '</>' '']
                   '<>' '']
                 '<code lang="' '<code class="language-']]
        [= $out [$md-inline $in]]
    [; render-completeness gate: every md pass is strictly ADDITIVE (they only
       insert markup around existing bytes), so a shorter output than input is
       proof of truncation — the defect class that silently shipped nine
       truncated pages past all seven doc gates (2026-08-20). Refuse loudly. ]
    [?if [< [$strings:length $out] [$strings:length $in]]
      [then [err code=guide-truncated
        [$cat ('post-body: md-inline SHRANK the fragment (',
               [$string [$strings:length $in]], ' -> ',
               [$string [$strings:length $out]],
               ' bytes) — render truncation; refusing to emit a partial page')]]]
      [else $out]]]]

[# ── per-section render (recursive) ─────────────────────────────────────
   render-section renders a [section] element to an HTML fragment string;
   render-block dispatches one content block, recursing into nested [child]
   subsections (h2…h6 by depth). Prose blocks (intro/body/note) are RETAGGED
   in place with [?modify … [rename …]] so mixed inline content survives.
   Children emit into their container's body via [?for]/[yield] — the empty
   <>/</> sequence wrappers are stripped by post-body.
   Tables are authored as [table [tr [th …]…] [tr [td …]…]…] (attrs are
   scalar-only — D2/E211 — so header labels and cells are child elements,
   never a columns=(…) attribute). Rows whose cells are [th] go to <thead>,
   the rest to <tbody>, so the style.css thead/tbody rules apply. #]
[# ── fixture-backed examples (RULED: RS-30) ─────────────────────────────
   RS-30 holds the guide to the primer's discipline: a claim keeps a runnable
   corpus example or a measured number beside it. A section writes
   [fixture id=<case>] where a claim needs its example, and the guide home
   names its own cases in HOME-FIXTURES. Every such case is REPLAYED against
   the running cx when the guide is built, through primer_build.cx's own
   index, replay and freshness check (pb) — so a page can only show an output
   this binary produces, and a case whose output moved stops the render,
   naming it. The suites a case may come from are docs-src/site/manifest.cxd's
   [suites]: the site's one list, which the landing page cites from too.

   Numbers: a {{COUNT:modules}}, {{COUNT:directives}} or {{COUNT:repositories}}
   in section prose (and on the guide home) is counted, when the guide is
   built, from the file that declares it by site_build.cx's own count-of (sb),
   so the guide and the landing page cannot print two different counts. #]
[?const SITE-MANIFEST 'docs-src/site/manifest.cxd']
[?const HOME-FIXTURES ('program-for-002-active-emails', 'ap-decimal-float-mix-right',
                       'io-001-read-file-cap-denied', 'program-modify-003-original-unchanged',
                       'mcp-001-call-tool-request-shape')]

[?def guide-die scope=public impure ($s)
  ([$io:write-line [$env:stderr] [$cat ('guide_build: ', $s)]], [$env:exit 1])]

[?def site-manifest scope=public impure () [$cx:parse [$io:read-file SITE-MANIFEST]]]
[?def site-suites scope=public impure ()
  [$fp:flat-map [$sb:child-named [$site-manifest] 'suites'] [?fn ($k) [$sb:raw-lines $k]]]]
[?def site-self scope=public impure ()
  [$string [$first [$sb:child-named [$site-manifest] 'site']]@repo]]

[?def fixture-ids-in scope=public ($doc)
  [$pb:cat-seqs (([?for [in $f $doc//fixture] [yield [$string $f@id]]]),
                 ([?for [in $p $doc//pair] [yield [$string $p@wrong]]]),
                 ([?for [in $p $doc//pair] [yield [$string $p@right]]]))]]

[# load-fixtures: index the site's suites, then replay and verify every case
   the guide home and the sections cite, once each. The replay scratch lives
   under the output directory and is removed before the pages are written. #]
[?def load-fixtures scope=public impure ($metas $repos $out)
  [?let [= $index [$pb:load-index [$site-suites]]]
        [= $ids [$distinct [$pb:cat-seqs (HOME-FIXTURES, [$pb:tldr-ids],
                  [$fp:flat-map $metas [?fn ($m) [$fixture-ids-in [$parse-or-die $m@srcpath]]]],
                  [; the repository pages' one example each (DOCS-47) ]
                  [$fp:flat-map $repos [?fn ($r) [$fixture-ids-in [$parse-or-die $r@path]]]])]]]
        [= $missing [?for [in $id $ids] [where [not [$map:contains $index $id]]] [yield $id]]]
        [= $_m [?if [$empty $missing] [then 0]
                 [else [$guide-die [$cat ('unknown fixture id(s) ', [$strings:join $missing ' '],
                                          ' — cite a case from a suite that the [suites] block of ', SITE-MANIFEST,
                                          ' declares, or declare its suite there')]]]]]
        [= $tmp [$cat ($out, '/.fixture-replay')]]
        [= $_md [$io:make-dirs $tmp]]
        [= $replays [$fp:fold $ids {}
          [?fn ($acc $id) [$pb:add-replay $acc $id $index [$env:executable-path] $tmp]]]]
        [= $_rm [$io:remove-tree $tmp]]
    {index: $index, replays: $replays}]]

[# fixture-block: one replayed case as the page shows it — its document and
   program when it has them, the exact invocation with the LIVE output, and
   where the case lives. #]
[?def fixture-block scope=public impure ($fx $id)
  [?let [= $sec [$map:get [$map:get $fx 'index'] $id]]
        [= $rep [$map:get [$map:get $fx 'replays'] $id]]
        [= $data [?else [$map:get $sec 'in-cx'] '[empty]']]
        [; a program passed ON the command line (`cx -e '…'`, a [cli-argv]
           naming %CODE% and no %FILE%) is shown once, in the invocation —
           never also as a prog.cx file the command does not read
           (RULED: DOCSOK-1) ]
        [= $argv [?else [$map:get $sec 'cli-argv'] '']]
        [= $inline [and [$strings:contains $argv '%CODE%'] [not [$strings:contains $argv '%FILE%']]]]
        [= $code [?if $inline [then ''] [else [?else [$map:get $sec 'in-code'] '']]]]
        [= $parts [$pb:cat-seqs (
          [?if [= $data '[empty]'] [then ()]
            [else ([p class='fixture-file' [code 'input.cx']], [pre [code lang=cx $data]])]],
          [?if [= $code ''] [then ()]
            [else ([p class='fixture-file' [code 'prog.cx']], [pre [code lang=cx $code]])]],
          ([pre class='sample-output' [code [$cat ('$ ', [$string $rep@cmd], '\n', [$string $rep@out])]]],
           [p class='fixture-src' 'Fixture ' [code $id] ' in ' [code [$string [$map:get $sec 'suite']]]
              ' — replayed against this cx when the page was built.']))]]
    [div class='fixture' [?splice $parts]]]]
[?def fixture-html scope=public impure ($fx $id)
  [$post-body [$xml:emit [$fixture-block $fx $id]]]]

[# tldr-block: the one lead (docs-src/site/tldr.cxd) as a section block —
   the lead, the standard, and every clause with its fixture replayed beside
   it, so the standard we state is proved on the page that states it
   (RULED: DOCS-49, DOCS-47). The prose carries the site's inline Markdown,
   which post-body renders as it does for every other block. #]
[?def tldr-block scope=public impure ($fx)
  [div class='tldr'
    [p class='lede' [$pb:tldr-part 'lead']]
    [p [$pb:tldr-part 'standard']]
    [?splice [$pb:cat-seqs [?for [in $c [$pb:tldr-clauses]]
      [yield ([p class='tldr-clause' [$string $c@text]],
              [$fixture-block $fx [$string $c@fixture]])]]]]]]

[# pair-block: a before/after panel from an anti-pattern PAIR of
   conformance/llm/antipatterns.cxd (the primer's {{PAIR:}} brought to the
   guide, RULED: DOCS-47): the wrong half's [title] as the panel's heading,
   both halves replayed side by side, the wrong one labelled as the form that
   fails. The claim it illustrates is the section's own prose; the fixture
   pair is the evidence, never the other way round. #]
[?def pair-block scope=public impure ($fx $wid $rid)
  [?let [= $wsec [$map:get [$map:get $fx 'index'] $wid]]
        [= $rsec [$map:get [$map:get $fx 'index'] $rid]]
    [div class='pair'
      [div class='pair-half pair-before'
        [p class='pair-label' 'Before — the form that fails']
        [p class='pair-title' [?else [$map:get $wsec 'title'] $wid]]
        [$fixture-block $fx $wid]]
      [div class='pair-half pair-after'
        [p class='pair-label' 'After — the CX form']
        [p class='pair-title' [?else [$map:get $rsec 'title'] $rid]]
        [$fixture-block $fx $rid]]]]]

[# expand-figures: every @@FIGURE:<name>@@ token a page carries, replaced by
   the figure (DOCS-42). An unknown figure name is refused, never printed. #]
[?def expand-figures scope=public impure ($html)
  [?if [not [$present [$strings:find $html '@@FIGURE:']]] [then $html]
    [else [?let [= $rings [$cat ('<figure class="ring-figure"><a href="assets/rings.svg" aria-label="The ring figure, as an SVG file">',
                                 [$rs:ring-svg],
                                 '</a><figcaption class="fig-caption">Fig. 1 — two rings, the groups above them, one-directional imports · drawn from <code>registry/modules.cxd</code> and <code>registry/repos.cxd</code> when this page was built</figcaption></figure>\n')]]
                [= $out [$strings:replace $html '<div class="ring-fig">@@FIGURE:rings@@</div>' $rings]]
      [?if [$present [$strings:find $out '@@FIGURE:']]
        [then [$guide-die 'a [figure name=…] block names a figure this build does not draw (the one figure is rings)']]
        [else $out]]]]]]

[# expand-counts: every {{COUNT:<what>}} in a rendered page, counted. An
   unclosed one is refused, never printed. #]
[?def expand-counts scope=public impure ($html $self)
  [?let [= $chunks [$strings:split $html '{{COUNT:']]
        [= $n [$count $chunks]]
    [$strings:join (
      [$first $chunks],
      [$strings:join [?for [in $i [$range 2 $n]]
        [= $ch [$nth $chunks $i]]
        [= $j [$strings:find $ch '}}']]
        [yield [?if [not [$present $j]]
          [then [$guide-die 'an unclosed {{COUNT: in a guide page']]
          [else [$cat ([$sb:count-of [$strings:slice $ch 1 [- $j 1]] $self 0],
                       [$strings:slice $ch [+ $j 2] [$strings:length $ch]])]]]]] '']) '']]]

[?def heading scope=public ($depth $title)
  [?if [<= $depth 2] [then [h2 $title]]
    [else [?if [= $depth 3] [then [h3 $title]]
      [else [?if [= $depth 4] [then [h4 $title]]
        [else [?if [= $depth 5] [then [h5 $title]] [else [h6 $title]]]]]]]]]]
[?def render-block scope=public impure ($c $depth $fx)
  [?match $c
    [case [intro] [?modify $c //intro [rename p]]]
    [case [body]  [?modify $c //body  [rename p]]]
    [case [note]  [?modify $c //note  [set-attr class 'note'] [rename p]]]
    [case [output $t] [pre class="sample-output" [code $t]]]
    [case [example $code] [pre [code lang=$c@lang $code]]]
    [case [fixture] [$fixture-block $fx [$string $c@id]]]
    [; DOCS-49 / the design's voice rule 2: a section opens on the one lead of
       docs-src/site/tldr.cxd — the lead, the standard stated as ours, then
       each clause beside the case that proves it, replayed like every other
       citation (the guide home and the primer §0 project the same source). ]
    [case [tldr] [$tldr-block $fx]]
    [; DOCS-42: a figure rendered from the registries rides through [$xml:emit]
       as a token (raw SVG would be escaped there) and is placed by
       expand-figures once the page is a string. ]
    [case [figure] [div class='ring-fig' [$cat ('@@FIGURE:', [$string $c@name], '@@')]]]
    [; DOCS-47 / the design's §3: a before/after panel — two replayed cases,
       the form that fails on the left and the CX form on the right, never a
       hand-typed "before". ]
    [case [pair] [$pair-block $fx [$string $c@wrong] [$string $c@right]]]
    [case [list]
      [ul [?for [in $i $c/*] [yield
        [?match $i [case [item] [?modify $i //item [rename li]]] [else ()]]]]]]
    [case [table]
      [table
        [thead [?for [in $r $c/tr] [yield
          [?if [$empty $r/th] [then ()] [else $r]]]]]
        [tbody [?for [in $r $c/tr] [yield
          [?if [$empty $r/th] [then $r] [else ()]]]]]]]
    [case [child]
      [section id=$c@id
        [$heading $depth $c@title]
        [?for [in $k $c/*] [yield [$render-block $k [+ $depth 1] $fx]]]]]
    [else [p class="unhandled" "[unhandled directive]"]]]]
[?def render-section scope=public impure ($s $fx)
  [$post-body [$xml:emit
    [section id=$s@id
      [h1 $s@title]
      [?for [in $c $s/*] [yield [$render-block $c 2 $fx]]]]]]]
[?def render-doc scope=public impure ($doc $fx)
  [$render-section $doc//section $fx]]

[# ── chrome ──────────────────────────────────────────────────────────── #]

[# nav-link: one <li>. The section-number span shows only for a non-empty
   numeric n (guide sections); stdlib/xap pages pass n='' (bare title). #]
[?def nav-link scope=public ($slug $title $n $active)
  [$cat ('    <li><a',
         [?if [= $slug $active] [then ' class="active"'] [else '']],
         ' href="', $slug, '.html">',
         [?if [= $n ''] [then '']
           [else [$cat ('<span class="sec-n">',
                        [$strings:replace [$format:compact $n] "'" ''],
                        '</span> ')]]],
         $title, '</a></li>\n')]]
[?def nav-item scope=public ($m $active) [$nav-link $m@slug $m@title $m@n $active]]
[# nav-raw-link: one <li> whose href is taken as written (a path outside the
   guide directory: the LLM layer, the developer notes, the llms.txt pair). #]
[?def nav-raw-link scope=public ($href $title)
  [$cat ('    <li><a href="', $href, '">', $title, '</a></li>\n')]]

[# nav-section: wrap a group's <li> html in a titled <section>, or '' if empty. #]
[?def nav-section scope=public ($title $items)
  [?if [= $items ''] [then '']
    [else [$cat ('  <section><h4>', $title, '</h4><ul>\n', $items, '  </ul></section>\n')]]]]

[# group item builders — each iterates ONE source exactly once (combining
   for-results into a single sequence nests them, so we never do that). #]
[?def guide-nav-items scope=public ($metas $active)
  [$strings:join [?for [in $m $metas] [yield [$nav-item $m $active]]] '']]
[# group-nav-items: the sections whose group= matches, in reading order.
   #826 — the nav is the ring model made visible, so a group is a ring and
   the order is inward-out. #]
[?def group-nav-items scope=public ($metas $g $active)
  [$strings:join [?for [in $m $metas] [where [= $m@group $g]]
    [yield [$nav-item $m $active]]] '']]
[# lib-nav-items RETIRED with the flat Standard-library group (#826 ruling
   3a) — see lib-ring-items, which indexes the packs under the ring that owns
   each one. #]
[# ── pack → ring (#826 §3, ruling 3a) ────────────────────────────────────
   `Standard library` stops being a top-level nav group: each ring indexes
   the packs it OWNS, so the ring page answers "what can I do with only this
   ring" completely — and a reader on Ring 0 sees, in the same breath, that
   `http` is not among them.
        
   THE ASSIGNMENT IS DERIVED, NOT CURATED. cx_partition.md §2's membership
   test is "every stdlib pack whose imports stay within Rings 0-1" is Ring 1,
   and the platform group owns the protocol/service packs. A pack is a thin CX wrapper
   over native `$<pack>-*` builtins, so the ring or group it belongs to is the ring of
   the vcx tree that IMPLEMENTS those builtins — `vcx/code` is Ring 1,
   `vcx/platform` and `vcx/cxstore` are in the platform group. That derivation resolved 44 of
   46 packs mechanically; `test` resolved to vcx/code/stdlib_testkit.v (Ring 1)
   and `jsonrpc` is pure CX over [$json:…] with no native builtins (Ring 1).
   Re-derive rather than hand-edit when a pack moves.
        
   RING 0 HAS NO PACKS, and that is a fact about the architecture rather than
   an omission: Ring 0 has no evaluator, so it has nothing to call a pack
   from. Its surface is the format itself plus the bindings. #]
[# THE RING IS READ, NOT LISTED (RULED: 1427-f, OL-15). This used to be a
   hand-kept `ring2-packs` string, and by #1427 it was already wrong in five
   places — it still put `email` in the platform group and had never heard of `audit`,
   `sso`, `flow`, `smtp` or `imap`. A second list of where a module lives is
   free to disagree with the first, which is the whole defect OL-15 names.
   registry/modules.cxd is the ONE declaration; `make placement-gate` holds
   the tree to it, and this page now reads the same row. Since RS-1 the rows
   carry two rings and a group, and the platform packs are the rows whose
   `group=` is `platform` (a platform row is `ring=1 group=platform`). #]
[?def ring2-packs scope=public impure [returns string] ()
  [?let [= $reg [$cx:parse [$io:read-file 'registry/modules.cxd']]]
    [$cat (' ',
      [$strings:join [?for [in $m $reg//module]
        [where [= [$string [?else $m@kind 'module']] 'module']]
        [where [= [$string [?else $m@group '']] 'platform']]
        [yield [$string $m@name]]] ' '],
      ' ')]]]
[# pack-ring answers a QUESTION ABOUT DATA, so it takes the data: the platform-group
   name set its caller read once. That is not a style choice here. #1427-f
   turned `ring2-packs` from a hand-kept string into a registry READ, which
   made it impure and made this def impure with it — and this def is called
   from inside a `[?for]`'s `[where]`, whose enclosing `[?def]` declares no
   purity and is therefore PURE, so the guide stopped rendering at all
   (CXER0233 E_PURITY_VIOLATION, the failed post-merge run on 100989e09). Marking the
   caller impure is the honest half of the answer -- `lib-ring-items` and the
   three defs above it (nav-html, wrap-page, index-body) DO transitively read a
   file, and they say so now, terminating at the top level, which was always
   impure. It is not the whole answer: left alone it would also parse the
   registry once per FILE per RING per PAGE, from inside a `[where]` that
   cannot legally call it at all. So the read is hoisted to one `[?let]` in
   `lib-ring-items` and the SET is passed here -- the effect stays where the
   read is, the predicate stays pure where a `[where]` needs it, and the
   registry is parsed once per call instead of once per file. #]
[?def pack-ring scope=public pure [returns int] ($packs::string $name::string)
  [?if [>= [$strings:find $packs [$cat (' ', $name, ' ')]] 0]
    [then 2] [else 1]]]
[# lib-ring-items: the pack links for ONE ring, in name order.

   The standalone `libraries.html` index page RETIRED here (#826 ruling 3a):
   with the packs indexed per ring, a single flat index is a second answer to
   "which packs exist" that is free to disagree with the ring pages — and it
   was the only page in the tree left reachable from nothing. #]
[?def lib-ring-items scope=public impure ($libfiles $ring $active)
  [?let [= $packs [$ring2-packs]]
    [$strings:join [?for [in $f $libfiles]
      [where [and [and [not [$is-x-file $f]] [not [$is-synth-file $f]]]
                  [= [$pack-ring $packs [$stdlib-slug $f]] $ring]]]
      [yield [$nav-link [$cat ('lib-', [$stdlib-slug $f])] [$stdlib-slug $f] '' $active]]] '']]]

[# x-tier-items: the experimental tier's own links, in name order. Its own
   group rather than a ring, because the tier is a STABILITY statement and not
   a layering one — a reader needs to know the promise before the position. #]
[?def x-tier-items scope=public ($libfiles $active)
  [$strings:join [?for [in $f $libfiles]
    [where [$is-x-file $f]]
    [yield [$nav-link [$module-page $f] [$stdlib-slug $f] '' $active]]] '']]

[?def xap-nav-items scope=public ($active)
  [$cat ([$nav-link 'xap' 'Overview' '' $active],
         [$strings:join [?for [in $d [$xap-demos]] [yield
           [$nav-link $d@slug $d@title '' $active]]] ''])]]
[# ref-nav-items: the two reference pages (directives + core syntax). #]
[?def ref-nav-items scope=public ($active)
  [$cat ([$nav-link 'directives' 'Directives' '' $active],
         [$nav-link 'syntax' 'Core syntax' '' $active])]]

[# nav-sub: one sub-heading of a group as a <details>, open only when it
   holds the active page (its items then carry class="active"), so a reader
   sees the sections of the ring they are in and one line for each other.
   Empty items render nothing. $level is 'nav-sub' or, for a sub-list inside
   a sub-list (Reference's module lists), 'nav-subsub' — nav_shape_check.cx
   parses the two by class. #]
[?def nav-sub scope=public ($level $title $items)
  [?if [= $items ''] [then '']
    [else [$cat ('  <details class="', $level, '"',
                 [?if [$present [$strings:find $items 'class="active"']] [then ' open'] [else '']],
                 '><summary>', $title, '</summary><ul>\n', $items, '  </ul></details>\n')]]]]

[# nav-groups: the FIVE groups of the navigation — the reader journeys
   (RULED: DOCS-51 §3, PLAY-2): Start here, Guide, Reference, Repositories,
   LLM. The sidebar and the guide home's table of contents render the same
   five, so a reader meets one shape. Inside Guide the two rings, the platform
   group, the groups above them, the application host and the tours are
   sub-headings (nav-sub), each open only on its own pages; inside Reference
   the module pages sit under one Modules sub-list, by ring, beside the
   codecs and the x/ tier — a module page is listed nowhere else; the
   Repositories group opens on the assessment page (group='Repositories',
   RULED: DOCS-48 — the enterprise journey lands there and leaves from the
   front door's page) and holds the repositories as one sub-list of every
   served page; LLM is the door, the
   primer, llms.txt and the developer notes. `make nav-shape-check` holds
   the shape: five groups, at most seven visible items in a group and in a
   sub-heading, the module pages under Reference only, every served page
   within three links of the landing. #]
[?def nav-groups scope=public impure ($metas $libfiles $active)
  [$cat (
    [$nav-section 'Start here'
      [$cat ([$nav-link 'index' 'Home' '' $active],
             [$group-nav-items $metas 'Start here' $active])]],
    [$nav-section 'Guide'
      [$cat ([$nav-sub 'nav-sub' 'Ring 0 — Data' [$group-nav-items $metas 'Ring 0 — Data' $active]],
             [$nav-sub 'nav-sub' 'Ring 1 — Code' [$group-nav-items $metas 'Ring 1 — Code' $active]],
             [$nav-sub 'nav-sub' 'The platform group' [$group-nav-items $metas 'The platform group' $active]],
             [$nav-sub 'nav-sub' 'The bindings and ecosystem groups' [$group-nav-items $metas 'The bindings and ecosystem groups' $active]],
             [$nav-sub 'nav-sub' 'XAP — the application host' [$xap-nav-items $active]],
             [$nav-sub 'nav-sub' 'Tours — 50 ways' [$group-nav-items $metas 'Tours' $active]])]],
    [$nav-section 'Reference'
      [$cat ([$ref-nav-items $active],
             [$group-nav-items $metas 'Reference' $active],
             [$nav-sub 'nav-sub' 'Modules'
               [$cat ([$nav-sub 'nav-subsub' 'Ring 1 — Code' [$lib-ring-items $libfiles 1 $active]],
                      [$nav-sub 'nav-subsub' 'The platform group' [$lib-ring-items $libfiles 2 $active]],
                      [$nav-sub 'nav-subsub' 'Codecs — core, synthesized' [$codec-tier-items $libfiles $active]],
                      [$nav-sub 'nav-subsub' 'x/ tier — experimental' [$x-tier-items $libfiles $active]])]])]],
    [$nav-section 'Repositories'
      [$cat ([$group-nav-items $metas 'Repositories' $active],
             [$nav-sub 'nav-sub' [$cat ('All ', [$string [$count [$rp:repo-sources]]], ' repositories')] [$repo-nav-items $active]])]],
    [$nav-section 'LLM'
      [; these resolve on the assembled site (docs/llm/ under llm/, the dev/
         door, the llms.txt pair at the root — the manifest's map); the
         guide directory alone does not serve them ]
      [$cat ([$nav-raw-link 'llm/index.html' 'For LLMs — the door'],
             [$nav-raw-link 'llm/primer.md' 'The primer'],
             [$nav-raw-link 'llms.txt' 'llms.txt'],
             [$nav-raw-link 'dev/index.html' 'Developer notes — where they went'])]])]]

[# nav-html: the sidebar <aside> — the five groups of nav-groups under the
   brand and the search box. #826's six ring-shaped groups, each appending
   every module page, retired here (RULED: DOCS-51 §3): the navigation is the
   reader journeys, and a module page is found under Reference. #]
[?def nav-html scope=public impure ($metas $libfiles $active)
  [$cat (
    '<aside class="sidebar">\n',
    '  <a class="brand" href="index.html" aria-label="CX — home">\n',
    '    <svg class="brand-mark" viewBox="0 0 1254 1254" role="img" aria-label="CX"><g fill="currentColor"><path d="M217 170 H604 L603 260 H327 V1005 L581 1006 V1096 H217 Z"/><path d="M429 338 H586 L1093 992 H943 Z"/><path d="M1070 338 H928 L776 521 L846 609 Z"/><path d="M648 675 L716 761 L562 939 H419 Z"/></g></svg>\n',
    '  </a>\n',
    '  <a class="brand-sub" href="https://github.com/cx-home/cx" target="_blank" rel="noopener">GitHub →</a>\n',
    '  <a class="brand-sub" href="playground.html">Playground →</a>\n',
    '  <a class="brand-sub" href="downloads.html">Downloads →</a>\n',
    '  <a class="brand-sub" href="about.html">About →</a>\n',
    '  <div class="side-search">\n',
    '    <input id="side-search-input" type="search"\n',
    '           placeholder="Search the guide…"\n',
    '           autocomplete="off" spellcheck="false" data-prefix="" />\n',
    '    <ul id="side-search-results" class="side-search-results" hidden></ul>\n',
    '  </div>\n',
    [$nav-groups $metas $libfiles $active],
    '</aside>\n')]]

[# ── the repository pages (RULED: DOCS-41, DOCS-49 waves 2–4) ─────────────
   One page per docs-src/repos/<name>.cxd: the prose is the file's, in the
   guide's own block vocabulary; every fact on the page — what it ships, its
   status, the pinned sha, what it builds on, where its spec and corpus live —
   is repo_page.cx's projection of the registries; the one example is a
   [fixture] replayed like every other citation; the plug-in figure is
   plugs_svg.cx's, inlined the way the ring figure is. The page's shape is
   fixed here (why → what it gives you → try it → status → links) so the
   twenty-four pages read as one set. #]

[# repo-nav-items: the sidebar group, one link per source, in name order. #]
[?def repo-nav-items scope=public impure ($active)
  [$strings:join [?for [in $r [$rp:repo-sources]]
    [yield [$nav-link $r@slug $r@name '' $active]]] '']]

[# repo-blocks: the source's children of the given names, in document order,
   each rendered by render-block (a `gives`/`try`/`status` paragraph is a
   body paragraph under another name). #]
[?def repo-blocks scope=public impure ($doc $names $fx)
  [?for [in $c $doc//repo/*]
    [where [$plugs:member $names [?else [$name $c] '']]]
    [yield [?match $c
      [case [gives]  [?modify $c //gives  [rename p]]]
      [case [try]    [?modify $c //try    [rename p]]]
      [case [status] [?modify $c //status [rename p]]]
      [else [$render-block $c 3 $fx]]]]]]

[?const REPO-WHY ('intro', 'body', 'note', 'list', 'table', 'example')]

[# render-repo-page: the page body for one source. The plug-in figure rides
   through [$xml:emit] as a token and is placed once the page is a string,
   exactly as the ring figure is. #]
[?def render-repo-page scope=public impure ($r $fx $files)
  [?let [= $name [$string $r@name]]
        [= $slug [$string $r@slug]]
        [= $doc [$parse-or-die [$string $r@path]]]
        [= $row [$rp:row $name]]
        [= $token [$cat ('@@FIGURE:plugs:', $name, '@@')]]
        [= $html [$post-body [$xml:emit
          [section id=$slug
            [h1 $name]
            [p class="lede" [$rs:attr $row "about" ""]]
            [section id=[$cat ($slug, '-why')]
              [h2 'Why reach for it']
              [?splice [$repo-blocks $doc REPO-WHY $fx]]]
            [section id=[$cat ($slug, '-gives')]
              [h2 'What it gives you']
              [?splice [$repo-blocks $doc ('gives',) $fx]]
              [$rp:face-table $name $files]]
            [section id=[$cat ($slug, '-try')]
              [h2 'Try it']
              [?splice [$repo-blocks $doc ('try',) $fx]]
              [?splice [$repo-blocks $doc ('fixture',) $fx]]]
            [section id=[$cat ($slug, '-status')]
              [h2 'Status']
              [?splice [$repo-blocks $doc ('status',) $fx]]
              [$rp:status-table $name]
              [div class="ring-fig" $token]]
            [section id=[$cat ($slug, '-links')]
              [h2 'Links']
              [$rp:links $name]]]]]]
        [= $figure [$cat ('<figure class="ring-figure plugs-figure">', [$plugs:plugs-svg $name],
                          '<figcaption class="fig-caption">Fig. — what <code>', $name,
                          '</code> plugs into: the repositories it builds on (left), the modules it ships (centre), the repositories that build on it (right) · drawn from <code>registry/repos.cxd</code>, <code>deps.cxd</code> and <code>registry/modules.cxd</code> when this page was built</figcaption></figure>\n')]]
    [$strings:replace $html [$cat ('<div class="ring-fig">', $token, '</div>')] $figure]]]

[# wrap-page: body fragment + chrome → full HTML document string.
   Drawing-office chrome (ruled 2026-08-20): Google Fonts (Archivo display,
   Newsreader body, IBM Plex Mono annotations), a mono sheet bar above the
   content, and a title-block footer on every page — the guide is a set of
   engineering sheets, and the title block is where a sheet says what it is,
   which revision, and who checked it. #]
[?def wrap-page scope=public impure ($title $active $metas $libfiles $ver $body)
  [$cat (
    '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n',
    '<meta name="viewport" content="width=device-width, initial-scale=1">\n',
    '<title>', $title, ' — CX Guide</title>\n',
    '<link rel="icon" type="image/svg+xml" href="assets/cx-logo.svg">\n',
    '<link rel="preconnect" href="https://fonts.googleapis.com">\n',
    '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n',
    '<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet">\n',
    '<link rel="stylesheet" href="', [$stamp 'style.css' $ver], '">\n</head>\n<body>\n',
    [$nav-html $metas $libfiles $active],
    '<header class="sheet-bar">\n',
    '  <div class="sb-left"><span class="sb-brand">CX · Reference guide</span>',
    '<span class="sb-title">', $title, '</span></div>\n',
    '  <div class="sb-right"><a href="playground.html">Playground</a>',
    '<a href="downloads.html">Downloads</a>',
    '<a href="about.html">About</a>',
    '<span class="sb-rev">v', $ver, '</span></div>\n',
    '</header>\n',
    '<main>\n', [$strings:trim-end-chars $body '\n'], '\n</main>\n',
    '<footer class="title-block">\n',
    '  <div class="tb-cell tb-project"><span>Project</span><b>CX — one language, data format to platform</b></div>\n',
    '  <div class="tb-cell"><span>Drawing</span><b>', $title, '</b></div>\n',
    '  <div class="tb-cell"><span>Rev</span><b>', $ver, '</b></div>\n',
    '  <div class="tb-cell"><span>Checked by</span><b class="tb-accent">The compiler</b></div>\n',
    '  <div class="tb-cell"><span>Issued</span><b>cxhome.org</b></div>\n',
    '</footer>\n',
    '<script src="', [$stamp 'highlight/highlight.js' $ver], '" defer></script>\n',
    '<script src="', [$stamp 'search-index.js' $ver], '" defer></script>\n',
    '<script src="', [$stamp 'search/search.js' $ver], '" defer></script>\n',
    '</body>\n</html>\n')]]

[# ── [[anchor]] cross-reference resolution ───────────────────────────────
   The manifest carries the TOC: each [section id= file=] and its nested
   [child id=] entries. Section ids resolve to <slug>.html; child ids to
   <slug>.html#<child-id> (slug = owning section's file slug). A reference
   on its own page drops to a bare #fragment. Unknown [[name]] tokens become
   a visible <span class="xref-unresolved">. #]

[# escape-code-xrefs: HTML-entity-escape '[[' inside <code>…</code> spans
   so literal double brackets in code samples (TOML [[array-of-tables]],
   xref syntax shown as syntax) are never treated as cross-references. #]
[?def escape-code-xrefs scope=public impure ($h)
  [; flat [?for] walker, same shape as md-inline — the former per-span
     self-recursion was the SECOND site of the ~195-span depth-cap
     truncation (2026-08-20; md-ticks/md-inline were the first). ]
  [?let [= $parts [$strings:split $h '<code']]
    [$cat (
      [$first $parts],
      [$strings:join
        [?for [in $p [$tail $parts]]
          [yield
            [?let [= $end [$strings:find $p '</code>']]
              [?if [not [$present $end]]
                [then [$cat ('<code', $p)]]
                [else [$cat ('<code',
                             [$strings:replace [$strings:slice $p 1 [- [+ $end 7] 1]] '[[' '&#91;&#91;'],
                             [$strings:slice $p [+ $end 7] [$strings:length $p]])]]]]]]
        ''])]]]

[# anchor-href: target href for one reference, given the current page slug. #]
[?def anchor-href scope=public ($cur $slug $frag $name)
  [?let [= $base [?if [= $slug $cur] [then ''] [else [$cat ($slug, '.html')]]]]
        [= $wf [?if [= $frag ''] [then $base] [else [$cat ($base, '#', $frag)]]]]
    [?if [= $wf ''] [then [$cat ('#', $name)]] [else $wf]]]]

[# anchor-sub: replace every [[name]] of one anchor with its <a> link. #]
[?def anchor-sub scope=public ($acc $cur $a)
  [$strings:replace $acc [$cat ('[[', $a@name, ']]')]
    [$cat ('<a class="xref" href="', [$anchor-href $cur $a@slug $a@frag $a@name],
           '">', $a@name, '</a>')]]]

[# resolve-anchors: fold every known anchor into $body, then wrap any
   remaining [[…]] token in the unresolved span. #]
[?def resolve-anchors scope=public impure ($body $cur $sec $chl)
  [$re:replace [$re:compile '\[\[[a-z][a-z0-9-]*\]\]']
    [$fp:fold $chl
      [$fp:fold $sec
        [$strings:replace [$escape-code-xrefs $body] '`[[' '`&#91;&#91;']
        [?fn ($acc $a) [$anchor-sub $acc $cur $a]]]
      [?fn ($acc $a) [$anchor-sub $acc $cur $a]]]
    '<span class="xref-unresolved">$0</span>']]

[# ring-figure RETIRED (RULED: DOCS-42): the guide home's Fig. 1 was 540×500 of
   hand-authored geometry reading nothing from the registry, and its colours
   were spelled here rather than read from style.css. The figure is now
   scripts/gen_site/ring_svg.cx's — every module a tick in its ring, drawn
   from registry/modules.cxd and registry/repos.cxd when the guide is built,
   the colours read from the stylesheet's tokens — inlined here and on
   rings.html and written as assets/rings.svg. #]

[# index-body: the guide home (docs/guide/index.html, the site's guide.html)
   body — the hero (the lead of why to reach for CX, the ring ladder, the
   Fig. 1 ring figure), then "what you can do with it": HOME-FIXTURES, each
   replayed when the guide is built, and the registry counts beside them
   (RULED: RS-30); then the grouped table of contents (reusing nav-group),
   source note. #]
[?def proof-item scope=public impure ($fx $title $claim $id)
  [$cat ('<h3>', $title, '</h3>\n<p>', $claim, '</p>\n', [$fixture-html $fx $id], '\n')]]
[?def index-body scope=public impure ($metas $libfiles $ver $fx)
  [$cat (
    '<div class="hero">\n',
    '<div class="hero-text">\n',
    '<div class="hero-eyebrow">Sheet 01 · Why reach for CX</div>\n',
    '<div class="hero-head">\n',
    '  <svg class="hero-mark" viewBox="0 0 1254 1254" role="img" aria-label="CX"><g fill="currentColor"><path d="M217 170 H604 L603 260 H327 V1005 L581 1006 V1096 H217 Z"/><path d="M429 338 H586 L1093 992 H943 Z"/><path d="M1070 338 H928 L776 521 L846 609 Z"/><path d="M648 675 L716 761 L562 939 H419 Z"/></g></svg>\n',
    '  <h1>One syntax.<br>Data to platform.<br><span class="accent">Agentic ready.</span></h1>\n',
    '</div>\n',
    [; the one lead, from docs-src/site/tldr.cxd (RULED: DOCS-49): the same
       text the landing page and the primer's §0 open with; its clauses'
       cases are replayed by this build like every fixture on the page. ]
    [$pb:tldr-html],
    '<p class="note">Every claim on this page stands beside a conformance fixture this <code>cx</code> replayed when the page was built.</p>\n',
    '<div class="ring-ladder">\n',
    '<div class="rr"><span class="rn">R0</span><span class="rt">Data</span><span class="rd">documents · schemas · values — nothing executes</span></div>\n',
    '<div class="rr"><span class="rn">R1</span><span class="rt">Code</span><span class="rd">evaluation · deny-by-default capabilities</span></div>\n',
    '<div class="rr"><span class="rn">G</span><span class="rt">Platform</span><span class="rd">the store · transports · live surfaces</span></div>\n',
    '<div class="rr"><span class="rn">G</span><span class="rt">Ecosystem</span><span class="rd">bindings · tooling · the registry</span></div>\n',
    '</div>\n',
    '<div class="hero-cta"><a href="why.html">WHY CX <span class="arr">—&gt;</span></a> &nbsp;·&nbsp; <a href="choosing.html">CHOOSE YOUR RING <span class="arr">—&gt;</span></a></div>\n',
    '</div>\n',
    '<div class="hero-fig">\n',
    '<a href="rings.html" aria-label="The rings, page">', [$rs:ring-svg], '</a>\n',
    '<div class="fig-caption">Fig. 1 — two rings, the groups above them, one-directional imports · drawn from the registry when this page was built · <a href="rings.html">read it</a></div>\n',
    '</div>\n',
    '</div>\n',
    '<section class="proof"><h2>What you can do with it</h2>\n',
    '<p>Five things we promise, each with the conformance case that proves it; <a href="why.html">the why page</a> states the case in eight before/after panels.</p>\n',
    [$proof-item $fx 'Query a document by its shape'
      'A query is a pattern over the document — every <code>user</code> whose <code>active</code> is true, and its <code>email</code>. There is no object model to build first and no parser to call.'
      'program-for-002-active-emails'],
    [$proof-item $fx 'Keep exact numbers exact'
      'A fraction literal is an exact decimal and arithmetic keeps it one; mixing it with a binary float is refused out loud rather than rounded in silence, so money stays money.'
      'ap-decimal-float-mix-right'],
    [$proof-item $fx 'Grant effects instead of inheriting them'
      'A program reads nothing it was not granted, and the refusal is an ordinary value that names the flag which would allow it.'
      'io-001-read-file-cap-denied'],
    [$proof-item $fx 'Update without mutation'
      '<code>[?modify]</code> answers a new document; the one it started from is unchanged, so no reader ever sees a half-updated tree.'
      'program-modify-003-original-unchanged'],
    [$proof-item $fx 'Speak an agent protocol as plain values'
      'An MCP request is an ordinary CX value projected to its wire form — no bespoke serializer anywhere in the path.'
      'mcp-001-call-tool-request-shape'],
    '<p class="note"><b>{{COUNT:modules}} shipped modules</b> · <b>{{COUNT:directives}} directives</b> · ',
    '<b>{{COUNT:repositories}} repositories</b> — counted from <code>registry/modules.cxd</code>, the ',
    "specification's directive registry and <code>registry/repos.cxd</code> when this page was built.</p>\n",
    '</section>\n',
    '<section class="toc-groups"><h2>Table of contents</h2>\n',
    [; the same five groups as the sidebar (nav-groups), every sub-heading closed here too: one shape, one vocabulary ]
    [$nav-groups $metas $libfiles ''],
    '</section>\n',
    '<p class="note">\n',
    '  Source: <code>docs-src/canonical/sections/*.cxd</code> +\n',
    '  the co-located docs in <code>stdlib/*.cx</code> and <code>x/*.cx</code>. Built by\n',
    '  <code>make guide</code>.\n',
    '</p>\n')]]

[# downloads-body: the Downloads page (ruled 2026-08-20: prebuilt profile
   tarballs land in the docs, top-nav slot between Playground and About).
   The build matrix IS the ring model as artifacts — the same cx binary name,
   a build-decided surface. What a release carries is what the release flow
   publishes: the four builds for darwin-arm64 (Phase 2) and for linux-arm64
   (Phase 2b, release_linux.sh, default-on; x86_64 only with
   RELEASE_LINUX_AMD64=1), the conformance bundle, the VS Code extension
   (RULED: CO-20) and SHA256SUMS.txt — the asset list of the latest release
   read with `gh release view` said exactly that on 2026-09-25 (RULED: RS-30;
   the measurement is _gate_evidence/pipeline_docs_voice/release_assets.txt).
   No playground wasm bundle is a release asset. Links use the
   releases/latest/download stable names. #]
[?def dl-link scope=public ($name)
  [$cat ('<a href="https://github.com/cx-home/cx/releases/latest/download/', $name, '">', $name, '</a>')]]
[?def dl-row scope=public ($build $rings $surface $stem)
  [$cat ('<tr><td><code>', $build, '</code></td><td>', $rings, '</td><td>', $surface, '</td><td>',
         [$dl-link [$cat ($stem, 'darwin-arm64.tar.gz')]], '</td><td>',
         [$dl-link [$cat ($stem, 'linux-arm64.tar.gz')]], '</td></tr>\n')]]
[?def downloads-body scope=public ($ver)
  [$cat (
    '<section id="downloads">\n',
    '<h1>Downloads</h1>\n',
    '<p class="lede">Every release ships the four builds of one <code>cx</code> — <code>data</code>, <code>embed</code>, <code>cli</code> and <code>platform</code> — for macOS on Apple Silicon and for Linux on arm64. A build is the ring model as an artifact: the same binary name with a build-decided surface, so you install only as much of CX as you take on.</p>\n',
    '<h2>Install</h2>\n',
    '<p>The installer resolves the latest release for your OS and architecture, verifies the tarball against <code>SHA256SUMS.txt</code> from the same release and installs under <code>~/.local</code> (<code>PREFIX=</code> overrides); the <code>platform</code> build is the default:</p>\n',
    '<pre><code class="language-shell">curl -sSL https://cxhome.org/install | sh</code></pre>\n',
    '<p>A leaner build installs with <code>CX_PROFILE=</code>:</p>\n',
    '<pre><code class="language-shell">curl -sSL https://cxhome.org/install | CX_PROFILE=data sh</code></pre>\n',
    '<h2>Builds</h2>\n',
    '<table>\n',
    '<thead><tr><th>Build</th><th>Rings</th><th>Surface</th><th>macOS (Apple Silicon)</th><th>Linux (arm64)</th></tr></thead>\n',
    '<tbody>\n',
    [$dl-row 'platform' '0–1 + the platform group' 'evaluator + local-effect stdlib + store/fabric/XAP daemons; ships <code>libcx</code> + <code>cx.h</code>' 'cx-'],
    [$dl-row 'cli' '0–1' 'evaluator + local-effect stdlib packs + http client; no servers — the binary is the deliverable' 'cx-cli-'],
    [$dl-row 'embed' '0–1 core' 'evaluator only, no local-effect packs; ships the embed-shape <code>libcx</code> + <code>cx.h</code>' 'cx-embed-'],
    [$dl-row 'data' '0' 'parse / convert / canonical / hash / diff / validate — cannot execute programs (no evaluator in the artifact); ships <code>libcx-core</code> + <code>cx.h</code>' 'cx-data-'],
    '</tbody></table>\n',
    '<h2>Verify</h2>\n',
    '<p>Every release carries a <code>SHA256SUMS.txt</code> over all of its assets:</p>\n',
    '<pre><code class="language-shell">shasum -a 256 -c SHA256SUMS.txt --ignore-missing</code></pre>\n',
    '<h2>Also on every release</h2>\n',
    '<ul>\n',
    '<li><b>Conformance bundle</b> — <code>cx-conformance-v', $ver, '.zip</code>: the full fixture corpus, for independent implementations and audits.</li>\n',
    '<li><b>VS Code extension</b> — <code>cx-language-', $ver, '.vsix</code>: <code>code --install-extension cx-language-', $ver, '.vsix</code>.</li>\n',
    '<li><b>All releases</b> — <a href="https://github.com/cx-home/cx/releases">github.com/cx-home/cx/releases</a>, each with notes and checksums.</li>\n',
    '</ul>\n',
    '<p>The WebAssembly engine of the <a href="playground.html">playground</a> is not a release asset; <code>make guide-wasm</code> builds it from source.</p>\n',
    '<h2>Other platforms</h2>\n',
    '<p>No prebuilt build is published for Linux on x86_64, for Intel Macs or for Windows; the installer says so and points at the source build. A source build fetches its pinned repositories with a released <code>cx</code> (<code>make deps-sync</code> finds one on <code>PATH</code> or at <code>~/.local/bin/cx</code>; <code>CX_BIN=</code> names another):</p>\n',
    '<pre><code class="language-shell">git clone --recursive https://github.com/cx-home/cx && cd cx\nmake -C third_party/v     # the vendored V toolchain, once\nmake deps-sync            # the pinned repositories, under deps/\nmake build-vcx            # libcx + cx, at deps/cx-core-code/vcx/target/cx\nmake promote-cli          # verify, then install to /usr/local/bin (PREFIX= overrides)</code></pre>\n',
    '<p class="note">See the <a href="quickstart.html#install">quickstart install section</a> for per-platform detail.</p>\n',
    '</section>\n')]]

[# copy-if: copy $from → $to only when $from exists (optional assets:
   playground bundle, wasm artifacts, png logo — present only after their
   own build steps). #]
[?def copy-if scope=public impure ($from $to)
  [?if [$io:exists $from] [then [$io:copy $from $to]] [else ()]]]

[# member: is $x anywhere in $seq (linear scan; the lists this gates are the
   guide's own page count, a few hundred at most — site_assemble.cx's
   --check uses the same shape against the same order of magnitude). #]
[?def member scope=public ($seq $x)
  [> [$count [?for [in $y $seq] [where [= $y $x]] [yield 1]]] 0]]

[# clean-stale-pages: docs/guide/ is never wiped between runs (the wasm reuse
   this file's header describes only works because #1005's copy-if leaves the
   directory alone), so a module that MOVES tiers or a page that is RENAMED
   or RETIRED leaves its old file behind forever — nothing here ever deletes.
   #1672 found docs/guide/x-term.html dated three days stale: `term` used to
   glob as an x/ file and render x-term.html; once it was promoted to the
   frozen stdlib packs (lib-term.html), the render kept writing the new page
   and never removed the old one, so the main checkout's long-lived tree
   carried both — and `site-check` (docs-src/site/manifest.cxd) correctly
   refused to vouch for a page no current source produces. This sweeps every
   top-level *.html this run does NOT intend to (re)write and removes it
   before the write loop below, so `docs/guide/` — and `site/`, which copies
   it verbatim — holds exactly what THIS run's sources justify, regardless of
   what a previous run with different sources left there. #]
[?def clean-stale-pages scope=public impure ($out $expected)
  [?for [in $p [$io:glob [$cat ($out, '/*.html')]]]
    [= $base [$strings:slice $p [+ [$strings:rfind $p '/'] 1] [$strings:length $p]]]
    [where [not [$member $expected $base]]]
    [yield [$io:remove $p]]]]

[# ── asset cache-busting (#953) ───────────────────────────────────────────
   A returning visitor loading the site across a deploy got the NEW page HTML
   with their CACHED pre-release style.css: the sidebar styled from old rules
   while the sheet-bar (newer markup) rendered as bare glued text. Nothing was
   wrong with the server — the live bytes were diff-identical to the repo — and
   a hard refresh cleared it, but every deploy re-opened that window for every
   cached visitor.

   So every LOCAL asset reference carries `?v=<VERSION>`. The version is
   DERIVED from the repo-root VERSION file that $ver already reads, never
   spelled a second time. Third-party references (Google Fonts) are left alone:
   their URLs are already immutable-versioned and are not ours to stamp. The
   mermaid renderer used to be in that category and no longer is — since #1007
   it is a vendored local asset and gets stamped like every other one.

   `stamp` is for hrefs this file emits. `copy-stamped-if` is for the static
   playground page, which is copied verbatim and carries its own <head>: it
   would otherwise be the one page still able to pair fresh HTML with a stale
   sheet. #]

[?def copy-stamped-if scope=public impure ($from $to $ver $assets)
  [?if [not [$io:exists $from]] [then ()]
    [else [?let [= $src [$io:read-file $from]]
      [= $out [$fp:fold $assets $src [?fn ($acc $a)
        [$strings:replace $acc [$cat ('"', $a, '"')]
                               [$cat ('"', [$stamp $a $ver], '"')]]]]]
      [$io:write-file $to $out]]]]]

[# ── search index ─────────────────────────────────────────────────────────
   Mirrors the old inline-Python builder: per rendered page, drop
   aside/script/style, take the <h1> as the title, strip the rest to plain
   text (entities unescaped, whitespace collapsed, capped at 4000 chars), and
   emit window.CXSearchIndex = [{slug,title,summary,text}, …]. #]
[?def strip-tags scope=public impure ($s) [$re:replace [$re:compile '<[^>]+>'] $s ' ']]
[?def collapse-ws scope=public impure ($s) [$strings:trim [$re:replace [$re:compile '\s+'] $s ' ']]]
[?def strip-blocks scope=public impure ($h)
  [$re:replace [$re:compile '(?s)<style[^>]*>.*?</style>']
    [$re:replace [$re:compile '(?s)<script[^>]*>.*?</script>']
      [$re:replace [$re:compile '(?s)<aside[^>]*>.*?</aside>'] $h ' '] ' '] ' ']]
[?def cap4000 scope=public ($s)
  [?if [> [$strings:length $s] 4000] [then [$strings:slice $s 1 4000]] [else $s]]]
[?def search-entry scope=public impure ($f)
  [?let [= $slug [$strings:replace [$strings:slice $f [+ [$strings:rfind $f '/'] 1] [$strings:length $f]] '.html' '']]
        [= $clean [$strip-blocks [$io:read-file $f]]]
        [= $h1pat [$re:compile '(?s)<h1[^>]*>(.*?)</h1>']]
        [= $title [?if [$empty [$re:find-all $h1pat $clean]]
          [then $slug]
          [else [$collapse-ws [$strings:unescape-html [$strip-tags [$re:group [$re:find $h1pat $clean] 1]]]]]]]
        [= $text [$cap4000 [$collapse-ws [$strings:unescape-html [$strip-tags $clean]]]]]
    {slug: $slug, title: $title, summary: '', text: $text}]]

[# ── section metadata ────────────────────────────────────────────────────
   One [m group= n= slug= srcpath= title=] per hand-authored section file
   (glob = reading order). The GROUP comes from the section's own `group=`
   attribute (#826): placement lives beside the content it places, so a
   section cannot drift from a mapping table kept somewhere else. A section
   with no group= falls to Reference rather than vanishing from the nav. README.cxd carries no [section] (skipped via
   the empty check). The old generated 16-libraries.cxd is skipped — the
   Standard-library group is now projected fresh from stdlib/*.cx below. #]
[?def load-metas scope=public impure ($src)
  [?for [in $f [$io:glob [$cat ($src, '/sections/*.cxd')]]] [yield
    [?if [>= [$strings:find $f '16-libraries'] 0] [then ()] [else
      [?let [= $d [$parse-or-die $f]]
            [= $s $d//section]
        [?if [$empty $s] [then ()] [else
          [m group=[?else $s@group 'Reference'] n=$s@n id=$s@id slug=[$slug-of $f] srcpath=$f title=$s@title]]]]]]]]]

[# ── Standard-library projection ──────────────────────────────────────────
   Reads the co-located [module-doc] / [fn-doc] blocks in stdlib/<m>.cx
   (single source of truth; spec/02-inprogress/stdlib_colocated_docs.md) and
   reshapes them into guide [section] trees — one page per module + a landing
   index. Pure projection: read → [$cx:parse] → extract → reshape. #]

[# stdlib-slug: 'stdlib/path.cx' → 'path'. #]
[# is-x-file: which TIER a module file belongs to, read off its path. The x/
   tier is experimental by decision D3, and every surface that shows it says so.
   #]
[# The reference covers BOTH module tiers (XD-1a): stdlib/*.cx and x/*.cx are
   globbed into one list and told apart by their PATH, so the nav can group them
   separately without threading a second parameter through every page signature.
   The x/ tier is exempt from the frozen-stability promise (std-lib README,
   decision D3), so it is never mixed in with the frozen packs — it gets its own
   nav group and a banner on every page. #]
[?def is-x-file scope=public [returns bool] ($f)
  [$strings:starts-with $f 'x/']]
[# ── the SYNTHESIZED codec modules (#1368, RULED: 1368-a) ──────────────────
   Five module surfaces (`cx`, `xml`, `yaml`, `toml`, `md`) are built from the
   codec registry at registration time and have NO FILE ON DISK, so the globs
   below cannot see them and their pages were never rendered. They ride the
   same path-shaped pipeline under a SYNTHETIC path, `synth/<m>.cx`: every
   helper here is a string operation on that path and answers correctly, and
   the ONE place that touches the disk (`module-source-of`) reads the loader
   instead. Nothing else in this file learns that a module can be sourceless.

   They get their own nav group rather than a ring, for the same reason the
   x/ tier does: codec.md's opening line is that codecs are CORE, not stdlib
   modules, so their position is a STATEMENT about what they are, and filing
   them under Ring 1 beside the packs would say the opposite. #]
[?def is-synth-file scope=public [returns bool] ($f)
  [$strings:starts-with $f 'synth/']]

[?def synth-libfiles scope=public impure [returns [sequence string]] ()
  [?let [= $r [$process:run ([$env:executable-path], 'stdlib', 'list', '--synthesized')]]
    [?if [not [= $r@exit-code 0]]
      [then ([$io:write-line [$env:stderr]
               [$cat ('guide_build: `cx stdlib list --synthesized` failed (exit ',
                      [$string $r@exit-code], ') — the synthesized module pages cannot be rendered')]],
             [$env:exit 1], ())]
      [else [?for [in $l [$strings:split [$string $r@stdout] "\n"]]
              [where [not [= $l ""]]]
              [yield [$cat ('synth/', $l, '.cx')]]]]]]]

[# module-source-of: a module's SOURCE, wherever the loader keeps it. A
   `synth/` path has no file, so it is read back through `cx stdlib source`,
   which answers for a disk-backed and a synthesized module identically. #]
[?def module-source-of scope=public impure [returns string] ($f)
  [?if [not [$is-synth-file $f]]
    [then [$io:read-file $f]]
    [else
      [?let [= $r [$process:run ([$env:executable-path], 'stdlib', 'source', [$stdlib-slug $f])]]
        [?if [not [= $r@exit-code 0]]
          [then ([$io:write-line [$env:stderr]
                   [$cat ('guide_build: `cx stdlib source ', [$stdlib-slug $f],
                          '` failed (exit ', [$string $r@exit-code], ')')]],
                 [$env:exit 1], "")]
          [else [$string $r@stdout]]]]]]]

[# codec-tier-items: the synthesized codec modules' nav links, in name order. #]
[?def codec-tier-items scope=public ($libfiles $active)
  [$strings:join [?for [in $f $libfiles]
    [where [$is-synth-file $f]]
    [yield [$nav-link [$module-page $f] [$stdlib-slug $f] '' $active]]] '']]
[# the page slug for a module: the frozen packs keep `lib-`, the experimental
   tier takes `x-`, so a URL states which promise applies to what it shows. #]
[?def module-page scope=public ($f)
  [$cat ([?if [$is-x-file $f] [then 'x-']
          [else [?if [$is-synth-file $f] [then 'codec-'] [else 'lib-']]]],
         [$stdlib-slug $f])]]
[?def stdlib-slug scope=public ($f)
  [$strings:replace [$strings:slice $f [+ [$strings:rfind $f '/'] 1] [$strings:length $f]] '.cx' '']]

[# pull a named text child out of an element (a child path auto-coerces
   unreliably, so iterate + [?match]). #]
[?def sig-of scope=public ($fd)
  [$strings:join [?for [in $c $fd/*] [yield [?match $c [case [sig $t] $t] [else ()]]]] '']]
[?def summary-of scope=public ($fd)
  [$strings:join [?for [in $c $fd/*] [yield [?match $c [case [summary $t] $t] [else ()]]]] '']]
[?def ex-part scope=public ($ex $tag)
  [$strings:join [?for [in $c $ex/*] [yield
    [?match $c [case [code $t]   [?if [= $tag 'code']   [then $t] [else ()]]]
               [case [expect $t] [?if [= $tag 'expect'] [then $t] [else ()]]]
               [else ()]]]] '']]

[# module-scope: the [module-doc]/[scope] prose, or a fallback. #]
[?def module-scope scope=public ($d)
  [?let [= $md $d//module-doc]
    [?if [$empty $md] [then 'Bundled cx-stdlib module.']
      [else [$strings:join [?for [in $c $md/*] [yield
        [?match $c [case [scope $t] $t] [else ()]]]] '']]]]]

[# first-sentence: the lede for the module index. #]
[?def first-sentence scope=public ($s)
  [?let [= $i [$strings:find $s '. ']]
    [?if [not [$present $i]] [then $s] [else [$strings:slice $s 1 [- [+ $i 1] 1]]]]]]

[# fn-html: one [fn-doc] → its HTML block (built directly so [$xml:emit]
   spreads the per-example [?for]; a constructed guide-[section] navigated via
   CXPath would collapse the for-result into one node). #]
[?def fn-html scope=public ($m $fd)
  [section id=[$cat ('fn-', $m, '-', $fd@name)] class="fn"
    [h3 [$cat ($m, ':', $fd@name)]]
    [p class="fn-sig" [code [$cat ('[$', $m, ':', $fd@name, ']  ', [$sig-of $fd])]]
       [?let [= $s [$summary-of $fd]] [?if [= $s ''] [then ''] [else [$cat ('  —  ', $s)]]]]]
    [?for [in $ex $fd/example] [yield
      [div class="example"
        [pre [code lang=cx [$ex-part $ex 'code']]]
        [pre class="sample-output" [code [$ex-part $ex 'expect']]]]]]]]

[# module-docs: the co-located [module-doc] / [fn-doc] blocks of a
   bundled module, WITHOUT data-parsing the whole file.

   A stdlib module is a PROGRAM, and a program is entitled to
   program-only syntax the DATA reader is right to refuse: a bare
   singleton sequence in call-argument position, a node-valued
   attribute, program directives in element bodies. stdlib/diagram.cx
   is the first module to use them, and the whole-file [$cx:parse] this
   projection used to do died on it — taking every stdlib page of the
   guide with it (the #425 class of failure: a doc source that stops
   projecting must FAIL, never silently render an empty page).

   [$cx:ast] returns the verbatim doc SPANS alongside the structured
   def view, so each doc block is parsed on its own and the module body
   is never data-read. This is the technique the sibling gate
   scripts/gen_guide/stdlib_docs_check.cx already uses; both now read
   docs the same way, so they cannot disagree about a module. #]
[?def module-docs scope=public impure ($f)
  [?let [= $raw [$cx:ast [$module-source-of $f]]]
    [?match $raw
      [case [err $e]
        ([$io:write-line [$env:stderr]
           [$cat ('guide_build: AST FAILED — ', $f, ' — ', $e@message)]],
         [$env:exit 1])]
      [else
        [?let [= $ast [$json:parse $raw]]
              [= $spans [?else $ast.docs []]]
          [?if [$empty $spans]
            [then
              ([$io:write-line [$env:stderr]
                 [$cat ('guide_build: NO DOC BLOCKS — ', $f,
                        ' — the module projects no [module-doc]/[fn-doc]')]],
               [$env:exit 1])]
            [else [docs [?splice [?for [in $sp $spans] [yield [$cx:parse $sp]]]]]]]]]]]]

[# render-module: stdlib/<m>.cx → the module page body (HTML fragment). #]
[?def render-module scope=public impure ($f)
  [?let [= $m [$stdlib-slug $f]]
        [= $d [$module-docs $f]]
        [= $fns $d//fn-doc]
    [$post-body [$xml:emit
      [section id=[$module-page $f]
        [h1 $m]
        [p class="lede" [$module-scope $d]]
        [# XD-1a: the experimental tier says so on every page it publishes. A
           reader who takes an x/ surface for a frozen one has been misled by
           the page, not by their own inattention. #]
        [?if [$is-x-file $f]
          [then [p class="note" [$cat ('Experimental x/ tier — imported as cx-x/', $m,
            '. Bundled and gated in-tree like any other module, but EXEMPT from the frozen-surface stability promise (std-lib README, decision D3): a semver-breaking change is allowed here while the surface settles, and the frozen-surface canary never counts it. Pin behaviour you depend on with your own fixtures.')]]]
          [else '']]
        [# R-A1 (#847-1a): the [?if]'s VALUE lands in content position, and a
           [?for]-built sequence of fn sections is a sequence VALUE there — the
           settled semantics refuse it; [?splice] is the syntactic adopter.
           This was the one unmigrated site of the ~150-site cutover: it only
           fires for a module with 2+ fn-docs, and the last full guide build
           predated the final semantics wave. #]
        [?splice [?if [$empty $fns]
          [then ([p class="note" """Per-function prose and examples are being migrated into this module. The public surface is specified in the module spec and exercised by the conformance fixtures."""])]
          [else [?for [in $fd $fns] [yield [$fn-html $m $fd]]]]]]]]]]]

[# landing-row / render-landing RETIRED with `libraries.html` (#826 ruling
   3a): the packs are indexed per RING now, so the flat module index has no
   consumer. A def with no live consumer is a partial implementation, so it
   goes rather than waiting to be rediscovered. #]

[# ── Reference projection ────────────────────────────────────────────────────
   The directive + core-syntax reference is projected from the co-located
   doc sources docs-src/canonical/reference/{directives,syntax}.cx — the
   same single-source-of-truth pattern as the stdlib pages, but the source
   is the §4.1 directive registry and the lexicon/grammar surface rather
   than the bundled module code. Read → [$cx:parse] → select → reshape into
   the HTML-shaped CX tree, [$xml:emit], post-body. The drift gate
   scripts/gen_guide/directive_docs_check.cx keeps it honest. #]

[# directive-html: one [directive-doc] → its HTML block. Mirrors fn-html
   (built directly so [$xml:emit] spreads the per-example [?for]). #]
[?def directive-html scope=public ($dd)
  [section id=[$cat ('dir-', [$strings:replace $dd@name '?' ''])] class="fn"
    [h3 [code $dd@name]]
    [p class="fn-sig" [code [$sig-of $dd]]
       [?let [= $s [$summary-of $dd]] [?if [= $s ''] [then ''] [else [$cat ('  —  ', $s)]]]]]
    [p class="note" [$cat ($dd@category, '  ·  ', $dd@spec)]]
    [?for [in $ex $dd/example] [yield
      [div class="example"
        [pre [code lang=cx [$ex-part $ex 'code']]]
        [pre class="sample-output" [code [$ex-part $ex 'expect']]]]]]]]

[# syntax-html: one [syntax-doc] → its HTML block (same shape as
   directive-html, `kind` in place of category/spec). #]
[?def syntax-html scope=public ($sd)
  [section id=[$cat ('syn-', $sd@name)] class="fn"
    [h3 [code $sd@name]]
    [p class="fn-sig" [code [$sig-of $sd]]
       [?let [= $s [$summary-of $sd]] [?if [= $s ''] [then ''] [else [$cat ('  —  ', $s)]]]]]
    [p class="note" [$cat ('Kind · ', $sd@kind)]]
    [?for [in $ex $sd/example] [yield
      [div class="example"
        [pre [code lang=cx [$ex-part $ex 'code']]]
        [pre class="sample-output" [code [$ex-part $ex 'expect']]]]]]]]

[# render-directive: reference/directives.cx → the directive-reference page
   body (HTML fragment). Mirrors render-module. #]
[?def render-directive scope=public impure ($f)
  [?let [= $d [$parse-or-die $f]]
        [= $dds $d//directive-doc]
    [$post-body [$xml:emit
      [section id=directives
        [h1 'Directive reference']
        [p class="lede"
          'Every directive in the closed directive registry ('
          [code 'spec/core/code.md'] ' §4.1) — the bracketed '
          [code '[?…]'] ' forms that drive pattern dispatch, comprehensions, '
          'binding, iterators, resilience, services, concurrency, and async. '
          'Each entry is generated from the co-located reference source and, '
          'where the conformance corpus backs it, carries a runnable example '
          'pinned verbatim to a passing fixture.']
        [?for [in $dd $dds] [yield [$directive-html $dd]]]]]]]]

[# render-syntax: reference/syntax.cx → the core-syntax page body. #]
[?def render-syntax scope=public impure ($f)
  [?let [= $d [$parse-or-die $f]]
        [= $sds $d//syntax-doc]
    [$post-body [$xml:emit
      [section id=syntax
        [h1 'Core syntax']
        [p class="lede"
          'The CX surface syntax — the data / document layer specified in '
          [code 'lexicon.ebnf'] ', ' [code 'grammar.ebnf'] ', and '
          [code 'code.md'] ' §3 / ' [code 'cxdm.md'] '. Elements, attributes, '
          'scalars and type annotations, atoms, anchors / merges / ids, '
          'comments, raw and block content, entity references, namespaces, '
          'and table literals. Each example shows a source snippet and its '
          [code 'cx fmt'] ' canonical render, pinned verbatim to the data '
          'conformance corpora.']
        [?for [in $sd $sds] [yield [$syntax-html $sd]]]]]]]]

[# ── XAP projection ─────────────────────────────────────────────────────────
   XAP is its own major area: a landing (just enough to get familiar) + the
   D1→D4 demo ladder. Each demo page embeds the demo's ACTUAL source and its
   recorded expected-output, read at build time from
   spec/03-approved/xap/demos/ — so the guide can't drift from the demos. #]

[# xap-demos: the ordered demo ladder as data (literal sequence, iterated
   once per use). file = the page's headline source; run = the command. #]
[?def xap-demos scope=public ()
  ([demo slug='xap-d1' dir='d1-greeting-cli' file='greeting.cx' run='cx greeting.cx'
     title='D1 · Greeting CLI'
     blurb='The smallest real XAP — a parameterized view rendered by a one-shot CLI, exercising only the pure component / surface / panel / render constructors. No journal, no bus, no socket.'],
   [demo slug='xap-d2' dir='d2-guestbook-cli-tui' file='guestbook.cx' run='cx guestbook.cx'
     title='D2 · Guestbook (the cascade)'
     blurb='Adds state and one control: signs the guestbook twice — each committing once to the journal — then renders the surface from the resulting fold. This is the committed cascade (run / emit / state).'],
   [demo slug='xap-d3' dir='d3-guestbook-web' file='serve.cx' run='cx --allow-net serve.cx'
     title='D3 · Guestbook on the web'
     blurb='Attaches a browser and a live terminal client to the SAME runtime: the surface materializes as HTML while a TUI rides an SSE feed of the same fold. Same capability, same intents, new media. [$xap:serve] holds GET /events open and pushes a frame on every committed intent.'],
   [demo slug='xap-d4' dir='d4-guestbook-agent' file='agent.cx' run='cx agent.cx'
     title='D4 · Guestbook + agent'
     blurb='Adds an agent as a fourth peer alongside the human clients. It emits the SAME [do :sign …] intents (agent-parity); the dial — an authz delegation — governs how much it does on its own.'])]

[# xap-demo-page: one demo dir → its page body (blurb · run · source · output).
   K3 (RULED: RS-12, RS-8, RS-7, RS-20; #1591 item K3): spec/03-approved/xap/
   left with cx-platform-xap's extraction -- read the local path while a
   repository has not done its own leave yet, the pin once it is gone
   (scripts/gen_docs/primer_platform.cx's platform-path fallback, same
   shape). #]
[?def xap-demos-root scope=private impure [returns string] ()
  [?if [$io:exists 'spec/03-approved/xap/demos']
   [then 'spec/03-approved/xap/demos/']
   [else 'deps/cx-platform-xap/spec/03-approved/xap/demos/']]]

[?def xap-demo-page scope=public impure ($d)
  [?let [= $base [$cat ([xap-demos-root], $d@dir, '/')]]
        [= $src [$io:read-file [$cat ($base, $d@file)]]]
        [= $out [$io:read-file [$cat ($base, 'expected-output.txt')]]]
    [$post-body [$xml:emit
      [section id=$d@slug
        [h1 $d@title]
        [p class="lede" $d@blurb]
        [h3 'Run it']
        [pre [code lang=sh $d@run]]
        [h3 [$cat ('Source — ', $d@file)]]
        [pre [code lang=cx $src]]
        [h3 'Expected output']
        [pre class="sample-output" [code $out]]]]]]]

[# xap-ladder-item: one <li> on the landing linking to a demo. #]
[?def xap-ladder-item scope=public ($d)
  [li [a href=[$cat ($d@slug, '.html')] $d@title] [$cat ('  —  ', $d@blurb)]]]

[# xap-landing: the XAP overview page body. #]
[?def xap-landing scope=public impure ()
  [$post-body [$xml:emit
    [section id=xap
      [h1 'XAP — the experience layer']
      [p class="lede"
        'XAP is the experience layer at the top of the CX web stack. It composes the '
        [code 'cx-stdlib'] ' primitives — '
        [code 'bus'] ', ' [code 'journal'] ', ' [code 'authz'] ', ' [code 'session'] ', '
        [code 'sched'] ', over ' [code 'http'] ' — into one orchestrator, so you build a '
        'capability once and surface it through many clients (CLI, TUI, web, agent) without rewriting it.']
      [h3 'The cascade']
      [p 'Every intent commits through one synchronous, server-authoritative, journal-folded path. The bus is the single enforcement point: it calls the policy decision once, appends to the hash-chained journal, and re-folds state. A rejected intent is a value on the failure channel — not a crash. Reads are a deterministic fold over the log, always live and present.']
      [h3 'Agent-parity']
      [p 'Agents are first-class peers. They emit the same intents as humans and are gated by the same authz dial — a delegation you can attenuate, time-bound, or revoke. Surfaces are medium-agnostic, so the same capability renders for a terminal, a browser, or an agent.']
      [h3 'Using it']
      [p [code "[?lib 'cx-platform/xap' :as xap]"] ' imports the runtime — it is bundled in the binary, no install. The four demos below are a ladder: one capability, surfaced through progressively more clients — each rung turns on exactly one more subsystem. Run each with the command on its page.']
      [h3 'The demo ladder']
      [ul [?for [in $d [$xap-demos]] [yield [$xap-ladder-item $d]]]]]]]]

[# ── main: render every section page ───────────────────────────────────
   Cross-reference anchors are derived from the section files themselves
   (their [section id=] and nested [child id=]s) — the manifest is a
   descriptive outline and is NOT consulted, so anchors can never go
   stale against it. #]
[?let
  [= $src 'docs-src/canonical']
  [= $gen 'scripts/gen_guide']
  [= $out 'docs/guide']
  [= $metas [$load-metas $src]]
  [; #1662: the bundled module sources live in the PINS since the extractions
     (RULED: RS-12) — deps/<repo>/stdlib/*.cx, and deps/<repo>/x/*.cx for the
     eleven modules the x/ tier graduated (D45a), which kept that path. The
     same three globs guide-check (stdlib_docs_check.cx) reads, so the pages
     rendered and the docs graded are one set; slug order is the reading order
     every nav group assumes. A pinned x/ path is NOT the retired x/ tier
     (D63a): is-x-file reads the front door's own top-level x/ only. ]
  [= $libfiles [$fp:flat-map (
                   ([?for [in $f [$fp:flat-map ([$io:glob 'stdlib/*.cx'], [$io:glob 'x/*.cx'],
                                               [$io:glob 'deps/*/stdlib/*.cx'], [$io:glob 'deps/*/x/*.cx'])
                                  [?fn ($g) $g]]]
                     [order-by [$stdlib-slug $f]]
                     [yield $f]]),
                   [$synth-libfiles])
                 [?fn ($g) $g]]]
  [= $ver [$strings:trim [$io:read-file 'VERSION']]]
  [; DOCS-41: the repository pages' sources, checked whole before any page is
     written — each names a shown repository, cites one fixture, is declared
     in the site manifest, links modules that have a reference page. ]
  [= $repos [$rp:repo-sources]]
  [= $_rc [?match [$rp:check]
            [case [err $e] [$guide-die [$cat ("the repository pages' self-test failed before it could grade: ", [$string $e@message])]]]
            [else 0]]]
  [= $site-files [$sb:site-files [$site-manifest]]]
  [; RS-30: every fixture the guide home, the sections and the repository
     pages cite, replayed and verified once, before any page is written (a
     moved output stops here). ]
  [= $fx [$load-fixtures $metas $repos $out]]
  [= $self [$site-self]]
  [= $sec-ancs [?for [in $m $metas] [yield
    [anc name=$m@id slug=$m@slug frag='']]]]
  [= $child-ancs [$fp:flat-map $metas [?fn ($m)
    [?let [= $d [$parse-or-die $m@srcpath]]
      [?for [in $c $d//child] [yield
        [anc name=$c@id slug=$m@slug frag=$c@id]]]]]]]
  [; every top-level page THIS run writes — the fixed pages, one per section,
     one per stdlib/x/synth module, one per XAP demo — is the ONLY set
     `docs/guide/*.html` may hold once this run ends (#1672). ]
  [= $expected-pages [$fp:flat-map (
                         ('index.html', 'about.html', 'downloads.html',
                          'directives.html', 'syntax.html', 'xap.html'),
                         ([?for [in $m $metas] [yield [$cat ($m@slug, '.html')]]]),
                         ([?for [in $r $repos] [yield [$cat ($r@slug, '.html')]]]),
                         ([?for [in $f $libfiles] [yield [$cat ([$module-page $f], '.html')]]]),
                         ([?for [in $d [$xap-demos]] [yield [$cat ($d@slug, '.html')]]]))
                       [?fn ($g) $g]]]
  (
    [$clean-stale-pages $out $expected-pages],
    [$io:make-dirs [$cat ($out, '/assets')]],
    [$io:make-dirs [$cat ($out, '/highlight')]],
    [$io:make-dirs [$cat ($out, '/search')]],
    [$io:make-dirs [$cat ($out, '/playground')]],
    [$io:make-dirs [$cat ($out, '/playground/vendor')]],
    [$io:copy [$cat ($gen, '/style.css')]              [$cat ($out, '/style.css')]],
    [$io:copy [$cat ($gen, '/highlight/highlight.js')] [$cat ($out, '/highlight/highlight.js')]],
    [$io:copy [$cat ($gen, '/search/search.js')]       [$cat ($out, '/search/search.js')]],
    [$io:copy [$cat ($src, '/../assets/cx-logo.svg')]  [$cat ($out, '/assets/cx-logo.svg')]],
    [; DOCS-42: the ring figure as a file, untracked, from the registries ]
    [$io:write-file [$cat ($out, '/assets/rings.svg')] [$rs:ring-svg]],
    [$copy-if [$cat ($src, '/../assets/cx-logo.png')]  [$cat ($out, '/assets/cx-logo.png')]],
    [$copy-if [$cat ($gen, '/playground/playground.js')]          [$cat ($out, '/playground/playground.js')]],
    [$copy-if [$cat ($gen, '/playground/playground.examples.js')] [$cat ($out, '/playground/playground.examples.js')]],
    [; PLAY-1 — the picker: the primer's own fixtures, projected by
       playground/primer_examples.cx (`make docs`). ]
    [$copy-if [$cat ($gen, '/playground/playground.primer.js')]   [$cat ($out, '/playground/playground.primer.js')]],
    [$copy-if [$cat ($gen, '/playground/playground.css')]         [$cat ($out, '/playground/playground.css')]],
    [$copy-if [$cat ($gen, '/playground/jspi_probe.html')]        [$cat ($out, '/playground/jspi_probe.html')]],
    [; #1007 — the diagram renderer is a VENDORED asset, not a CDN <script>, so
       the Graph pane works over file:// and offline like the rest of the page,
       and the bytes that draw a reader's diagram move only by commit. Its MIT
       license travels beside it, the way third_party/re2's does into every
       release tarball. ]
    [$copy-if [$cat ($gen, '/playground/vendor/mermaid.min.js')]
              [$cat ($out, '/playground/vendor/mermaid.min.js')]],
    [$copy-if [$cat ($gen, '/playground/vendor/LICENSE-mermaid.txt')]
              [$cat ($out, '/playground/vendor/LICENSE-mermaid.txt')]],
    [; #953 — the playground page carries its own <head>, so it is stamped on
       the way out rather than copied verbatim. Its LOCAL assets only, which
       since #1007 includes the vendored renderer: it is ours now, it changes
       when the pin moves, and a visitor holding a cached 3 MB bundle from the
       previous pin is exactly the stale-asset window ?v= exists to close. The
       Google Fonts URLs are still left alone — already immutable-versioned and
       not ours to rewrite. ]
    [$copy-stamped-if [$cat ($gen, '/playground/playground.html')]
                      [$cat ($out, '/playground.html')] $ver
                      ('playground/playground.css', 'playground/playground.js',
                       'playground/playground.primer.js',
                       'playground/playground.examples.js', 'highlight/highlight.js',
                       'playground/vendor/mermaid.min.js',
                       'wasm/cxlib.js')],
    [$io:make-dirs [$cat ($out, '/wasm')]],
    [$copy-if 'dist/wasm/cxlib.js'            [$cat ($out, '/wasm/cxlib.js')]],
    [$copy-if 'dist/wasm/libcx-async.js'      [$cat ($out, '/wasm/libcx-async.js')]],
    [$copy-if 'dist/wasm/libcx-sync.js'       [$cat ($out, '/wasm/libcx-sync.js')]],
    [$copy-if 'dist/wasm/libcx-async.wasm'    [$cat ($out, '/wasm/libcx-async.wasm')]],
    [$copy-if 'dist/wasm/libcx-pthreads.js'   [$cat ($out, '/wasm/libcx-pthreads.js')]],
    [$copy-if 'dist/wasm/libcx-pthreads.wasm' [$cat ($out, '/wasm/libcx-pthreads.wasm')]],
    [$copy-if 'dist/wasm/libcx.js'            [$cat ($out, '/wasm/libcx.js')]],
    [$copy-if 'dist/wasm/libcx.wasm'          [$cat ($out, '/wasm/libcx.wasm')]],
    [$io:write-file [$cat ($out, '/index.html')]
      [$wrap-page 'CX Guide' 'index' $metas $libfiles $ver [$expand-counts [$index-body $metas $libfiles $ver $fx] $self]]],
    [$io:write-file [$cat ($out, '/about.html')]
      [$wrap-page 'About' 'about' $metas $libfiles $ver [$io:read-file [$cat ($src, '/about.html')]]]],
    [$io:write-file [$cat ($out, '/downloads.html')]
      [$wrap-page 'Downloads' 'downloads' $metas $libfiles $ver [$downloads-body $ver]]],
    [?for [in $m $metas] [yield
      [?let [= $doc [$parse-or-die $m@srcpath]]
            [= $raw [$expand-figures [$expand-counts [$render-doc $doc $fx] $self]]]
            [= $body [$resolve-anchors $raw $m@slug $sec-ancs $child-ancs]]
            [= $page [$wrap-page $m@title $m@slug $metas $libfiles $ver $body]]
        [$io:write-file [$cat ($out, '/', $m@slug, '.html')] $page]]]],
    [; DOCS-41: one page per repository source, the facts from the registries ]
    [?for [in $r $repos] [yield
      [?let [= $raw [$expand-figures [$expand-counts [$render-repo-page $r $fx $site-files] $self]]]
            [= $body [$resolve-anchors $raw $r@slug $sec-ancs $child-ancs]]
            [= $page [$wrap-page $r@name $r@slug $metas $libfiles $ver $body]]
        [$io:write-file [$cat ($out, '/', $r@slug, '.html')] $page]]]],
    [?for [in $f $libfiles] [yield
      [?let [= $m [$stdlib-slug $f]]
            [= $slug [$module-page $f]]
            [= $body [$render-module $f]]
            [= $page [$wrap-page $m $slug $metas $libfiles $ver $body]]
        [$io:write-file [$cat ($out, '/', $slug, '.html')] $page]]]],
    [$io:write-file [$cat ($out, '/directives.html')]
      [$wrap-page 'Directive reference' 'directives' $metas $libfiles $ver
        [$render-directive [$cat ($src, '/reference/directives.cx')]]]],
    [$io:write-file [$cat ($out, '/syntax.html')]
      [$wrap-page 'Core syntax' 'syntax' $metas $libfiles $ver
        [$render-syntax [$cat ($src, '/reference/syntax.cx')]]]],
    [$io:write-file [$cat ($out, '/xap.html')]
      [$wrap-page 'XAP' 'xap' $metas $libfiles $ver [$xap-landing]]],
    [?for [in $d [$xap-demos]] [yield
      [?let [= $page [$wrap-page $d@title $d@slug $metas $libfiles $ver [$xap-demo-page $d]]]
        [$io:write-file [$cat ($out, '/', $d@slug, '.html')] $page]]]],
    [$io:write-file [$cat ($out, '/search-index.js')]
      [$cat ('window.CXSearchIndex = ',
             [$json:emit [$fp:map [$io:glob [$cat ($out, '/*.html')]] [?fn ($f) [$search-entry $f]]]],
             ';\n')]]
  )]
