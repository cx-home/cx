# scripts/ci_flow_gate.cx <doc> — the ONE gate of the repository's flow
# documents (RULED: RFLOW-1 L104, PRIVMK-1, CICD-1, CXF-1).
#
#   cx --allow-read --allow-write --allow-env --allow-subprocess --allow-clock \
#     scripts/ci_flow_gate.cx <doc>
#   make release-flow-gate    make docs-flow-gate           (public)
#   make merge-flow-gate      make premerge-flow-gate  …    (flows/private.mk)
#
# One engine over a case table per document, so a red names its document (one
# target each) and no second copy of the engine can drift. A document lives in
# one of the HOMES below, as <home>/<doc>.flow.cx, and its table is
# <home>/sim/<doc>/cases.cxd. The table's `env=` names the env its acts
# resolve through. The engine reads the REAL document through THIS TREE's
# binary: `cx flow validate`, `simulate` and `run`, the shipped surface, run
# as subprocesses. For each document it holds:
#
#   A. IT VALIDATES against its env, every act resolving.
#   B. EVERY TERMINAL STATUS SIMULATES as the table names it: `:done`, each
#      pre-pivot refusal `:compensated` with the steps before it wound back in
#      reverse, and each post-pivot one `:incomplete` with its count.
#   C. AN ACT'S OWN REFUSAL RUNS: one real `cx flow run`, which the first act
#      refuses before anything moves, under the grants its Makefile caller
#      passes. It exits 1 with the refusal in the record.
#   D. IT CANNOT GO GREEN OVER NOTHING:
#      - the table is non-empty;
#      - its expectation count is pinned in the table;
#      - every <home>/*.flow.cx has a table;
#      - every program under the table's directory is named by a case.
#   E. (verb `real`) A REAL RUN against a throwaway world. The document's own
#      world program, `program=`, builds the world under a temp root. That
#      root is removed before the gate answers (#1511). The world program
#      prints the arguments the run takes, and after the run it reports what
#      the world holds. Each [world …] attribute of the case must equal it.
#      The world is checked, not only the record.
#   F. (verb `probe`) A document-specific check that is not a run: a program
#      under the table's directory, whose answer carries the [s] facts (for
#      example premerge's load rows, and its runner routing).
#
# The engine names no document's acts and imports none. The worlds and probes
# are programs beside their tables. That is what lets this one file be public
# (the release document and the documentation flow are public, L96) while the
# integrator protocol's documents and their worlds stay private (PRIVMK-1).
[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/cx'      as=cx]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def cat-seqs scope=public ($ss) [$fp:flat-map $ss [?fn ($x) $x]]]
[?def member scope=public pure [returns bool] ($x $xs)
  [> [$count [?to-sequence [?for [in $y $xs] [where [= [$string $y] [$string $x]]] [yield $y]]]] 0]]

# where a flow document lives: the CI/CD documents under flows/, the
# documentation flow under docs-src/flow/ (CICD-1).
[?const HOMES ('flows', 'docs-src/flow')]

# the grants every run, probe and world program gets: those the documents'
# Makefile callers pass. --allow-clock is included because the post-merge
# verdict stamps its lines, as `date -u` did.
[?const GRANTS ('--allow-read', '--allow-write', '--allow-subprocess', '--allow-env', '--allow-clock')]

# ── the binary: CX_BIN (the Makefile passes this tree's build), else the
# tree's own build. PATH is not this tree, so it is not searched (#929). ─────
[?def locate-cx scope=public impure ()
  [?let [= $envbin [$strings:trim [?else [$env:var "CX_BIN"] ""]]]
        [= $bin [?if [= $envbin ""] [then "deps/cx-core-code/vcx/target/cx"] [else $envbin]]]
    [?if [$io:is-file $bin] [then $bin]
      [else [?let [= $_ [$cry [$cat ("ci-flow-gate: no cx binary at ", $bin,
                                     " — build it (`make build-vcx`) or point CX_BIN at it")]]]
              [?let [= $_x [$env:exit 2]] ""]]]]]]

[?def argv-words scope=public pure ($s)
  [?if [= [$strings:trim [$string $s]] ''] [then ()]
    [else [?to-sequence [?for [in $w [$strings:split [$strings:trim [$string $s]] " "]] [where [not [= $w '']]] [yield $w]]]]]]

# The grants ride AFTER the subcommand word: flags bind before a FILE and
# `flow` is not one. validate/simulate read only; a run carries the grants
# the document's Makefile caller passes.
[?def argv-of scope=public pure [returns any] ($bin $flow $env $c $extra)
  [?let [= $verb [$string $c@verb]]
        [= $head [?if [= $verb 'validate']
           [then ($bin, 'flow', 'validate', $flow, '--env', $env, '--allow-read=.')]
           [else [?if [= $verb 'simulate']
             [then ($bin, 'flow', 'simulate', $flow, [$string $c@results], '--env', $env, '--allow-read=.')]
             [else [$cat-seqs (($bin, 'flow', 'run', $flow, '--env', $env, '--ephemeral'), $GRANTS)]]]]]]
    [$cat-seqs ($head, [$argv-words $c@args], $extra)]]]

[?def label-of scope=public pure ($c) [$cat ('case ', [$string $c@id], ' (', [$string $c@verb], ')')]]

[?def expect-misses scope=public pure ($c $out)
  [?to-sequence [?for [in $e $c/expect/s]
    [where [not [$strings:contains $out [$string $e]]]]
    [yield [$cat ([$label-of $c], ': the answer does not carry `', [$string $e], '` — got: ',
                  [$strings:slice $out 0 600])]]]]]

[?def exit-miss scope=public pure ($c $r $out)
  [?if [= [$string $r@exit-code] [$string $c@exit]] [then ()]
    [else ([$cat ([$label-of $c], ': exited ', [$string $r@exit-code], ', the table names ',
                  [$string $c@exit], ' — ', [$strings:slice $out 0 600], ' ',
                  [$strings:slice [$strings:trim [$string $r@stderr]] 0 600])])]]]

[?def run-flow scope=public impure ($bin $flow $env $c $extra)
  [?let [= $r [$process:run [$argv-of $bin $flow $env $c $extra] timeout-ms=900000]]
        [= $out [$string $r@stdout]]
        [= $em [$exit-miss $c $r $out]]
    [?if [> [$count $em] 0] [then $em] [else [$expect-misses $c $out]]]]]

# ── F — a probe: a program beside the table, its answer read for the [s] ────
[?def run-program scope=public impure ($bin $program $args)
  [$process:run [$cat-seqs (($bin), $GRANTS, ($program), $args)] timeout-ms=900000]]

[?def probe-case scope=public impure ($bin $c)
  [?let [= $r [$run-program $bin [$string $c@program] [$argv-words $c@args]]]
        [= $out [$cat ([$string $r@stdout], ' ', [$string $r@stderr])]]
        [= $em [$exit-miss $c $r $out]]
    [?if [> [$count $em] 0] [then $em] [else [$expect-misses $c $out]]]]]

# ══ E — a real run in a throwaway world ══════════════════════════════════════
# The world program answers `build <root> <scenario>` with one [world …]
# element: `args=` (the flow arguments this world's run takes) and `errs=`
# ('' when the world stands). After the run it answers `observe <root>` with
# one [seen …] element, whose attributes are the world's facts in the table's
# words.
[?def answer-of scope=public pure ($out $head)
  [?let [= $doc [?else [$cx:parse [$string $out]] ()]]
        [= $hits [?to-sequence [?for [in $x $doc] [where [= [$name $x] $head]] [yield $x]]]]
    [?if [= [$count $hits] 0] [then [none]] [else [$first $hits]]]]]

[?def world-misses scope=public pure ($c $seen)
  [?to-sequence [?for [in $want $c/world] [in $a [$attrs $want]] [= $k [$string $a@name]]
    [where [not [= [$string [$attr $want $k]] [$string [?else [$attr $seen $k] '']]]]]
    [yield [$cat ([$label-of $c], ': the world after the run has ', [$string $k], '=',
                  [$string [?else [$attr $seen $k] '(nothing)']], ', the table names ', [$string [$attr $want $k]])]]]]]

[?def real-case scope=public impure ($bin $flow $env $c)
  [?let [= $root [$io:temp-dir 'ci-flow-gate']]
        [= $program [$string $c@program]]
        [= $b [$run-program $bin $program ('build', $root, [$string $c@scenario])]]
        [= $w [$answer-of $b@stdout 'world']]
        [= $misses [?if [or [not [= [$name $w] 'world']] [not [= [$string $w@errs] '']]]
                     [then ([$cat ([$label-of $c], ': the world could not be built — ',
                                   [$string [?else $w@errs '']], ' ', [$strings:slice [$string $b@stdout] 0 400], ' ',
                                   [$strings:slice [$strings:trim [$string $b@stderr]] 0 400])])]
                     [else [?let [= $rm [$run-flow $bin $flow $env $c [$argv-words $w@args]]]
                                 [= $o [$run-program $bin $program ('observe', $root)]]
                                 [= $seen [$answer-of $o@stdout 'seen']]
                       [$cat-seqs ($rm, [$world-misses $c $seen])]]]]]
        [= $_rm [$io:remove-tree $root]]
    $misses]]

# ── the run ─────────────────────────────────────────────────────────────────
[?def run-case scope=public impure ($bin $flow $env $c)
  [?let [= $verb [$string $c@verb]]
    [?if [= $verb 'real'] [then [$real-case $bin $flow $env $c]]
      [else [?if [= $verb 'probe'] [then [$probe-case $bin $c]]
        [else [$run-flow $bin $flow $env $c ()]]]]]]]

[?def expectation-count scope=public pure [returns int] ($cs)
  [$count [$cat-seqs [?to-sequence [?for [in $c $cs]
    [yield [$cat-seqs ([?to-sequence [?for [in $e $c/expect/s] [yield $e]]],
                       [?to-sequence [?for [in $wv $c/world] [in $a [$attrs $wv]] [yield $a]]])]]]]]]]

[?def home-of scope=public impure [returns string] ($doc)
  [?let [= $hits [?to-sequence [?for [in $h $HOMES] [where [$io:is-file [$cat ($h, '/', $doc, '.flow.cx')]]] [yield $h]]]]
    [?if [= [$count $hits] 0] [then ''] [else [$first $hits]]]]]

[?def flow-docs scope=public impure ($home)
  [?if [not [$io:is-directory $home]] [then ()]
    [else [?to-sequence [?for [in $f [$io:list-dir $home]] [where [$strings:ends-with [$string $f] '.flow.cx']]
            [yield [$strings:replace [$string $f] '.flow.cx' '']]]]]]]

[?let
  [= $doc [$strings:trim [?else [$nth [$env:argv] 2] '']]]
  [= $bin [$locate-cx]]
  [= $home [$home-of $doc]]
  [= $flow [$cat ($home, '/', $doc, '.flow.cx')]]
  # a document not found still has a table where its home would be (flows/),
  # so the refusals below name the real path.
  [= $simdir [$cat ([?if [= $home ''] [then 'flows'] [else $home]], '/sim/', $doc)]]
  [= $table-path [$cat ($simdir, '/cases.cxd')]]
  [= $tdoc [?if [$io:is-file $table-path] [then [$cx:parse [$io:read-file $table-path]]] [else [none]]]]
  [= $table [$first [?to-sequence [?for [in $x $tdoc] [where [= [$name $x] 'cases']] [yield $x]]]]]
  [= $env [?else [$string $table@env] 'flows/ci.env.cx']]
  [= $cs [?to-sequence [?for [in $c $table/case] [yield $c]]]]
  [= $named [?to-sequence [?for [in $c $cs] [in $k ('results', 'program')]
              [where [not [= [$string [?else [$attr $c $k] '']] '']]] [yield [$string [$attr $c $k]]]]]]
  [= $sims [?if [$io:is-directory $simdir]
             [then [?to-sequence [?for [in $f [$io:list-dir $simdir]] [where [$strings:ends-with [$string $f] '.cx']]
                     [yield [$cat ($simdir, '/', [$string $f])]]]]]
             [else ()]]]
  [= $misses [$cat-seqs
    ([?if [= $doc ''] [then ('ci-flow-gate: name the document — e.g. release, docs, merge (usage in the header)')] [else ()]],
     [?if [= $home ''] [then ([$cat ('ci-flow-gate: no ', $doc, '.flow.cx in any of ', [$strings:join $HOMES ', '])])] [else ()]],
     [?if [= [$count $cs] 0]
       [then ([$cat ('ci-flow-gate: ', $table-path, ' holds no case — this gate cannot pass over nothing')])] [else ()]],
     [?if [not [= [$string [$expectation-count $cs]] [$string $table@expectations]]]
       [then ([$cat ('ci-flow-gate: ', $table-path, ' addresses ', [$string [$expectation-count $cs]],
                     ' expectations but pins expectations=', [$string $table@expectations],
                     ' — an expectation that is not addressable is not checked')])]
       [else ()]],
     [?to-sequence [?for [in $d [$flow-docs $home]] [where [not [$io:is-file [$cat ($home, '/sim/', $d, '/cases.cxd')]]]]
       [yield [$cat ($home, '/', $d, '.flow.cx: a flow document with no ', $home, '/sim/', $d, '/cases.cxd')]]]],
     [?to-sequence [?for [in $s $sims] [where [not [$member $s $named]]]
       [yield [$cat ($s, ': a program under the table that no case names')]]]],
     [?if [= $home ''] [then ()]
       [else [$cat-seqs [?to-sequence [?for [in $c $cs] [yield [$run-case $bin $flow $env $c]]]]]]])]]
  [?if [> [$count $misses] 0]
    [then [?let [= $_ [?for [in $m $misses] [yield [$cry [$string $m]]]]]
            [?let [= $_x [$env:exit 2]] '']]]
    [else [$cat ('ci-flow-gate OK — ', $flow, ': ', [$string [$count $cs]], ' cases, ',
                 [$string [$expectation-count $cs]], ' expectations')]]]]
