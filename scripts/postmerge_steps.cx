# scripts/postmerge_steps.cx — the post-merge run's steps (cx-private issue
# 1817, Letter 201 (a)(1); RULED: STREAM-1, RFLOW-1, CXF-1).
#
# ci/postmerge-run (flows/private-acts.cx) runs this under the post-merge
# runner, scripts/build-slot.sh holding it for the run's life, with the
# program's two streams appended to the checkout's vcx/target/gate.log, in
# place of the one `make test` / `make test-changed BASE=<sha>` it ran before.
# That make was a `-k -j<cores>` storm (make test's storm line,
# test_changed.sh's run_step_set) with the load-sensitive steps inside it and
# VJOBS-wide `v test` runners in many of its targets: on 069b93f57's run one
# V test compiled for 26 minutes that compiles in two on a quiet box.
#
# THE RUN, in order:
#   1. prebuild — `make deps-sync`, the plan (2.), `make build-re2-shim` on the
#      post-merge runner, then side by side on own runners `make -j2 build-vcx`,
#      `make -j2 build-vcx-dev`, the profile matrix and db-real-cx when the plan
#      needs them (cx-private#1946, THE PREBUILD'S OVERLAP below): every step
#      after runs `-o` of what it built, so none relinks. Each build's two
#      artifacts (lib and cli, lib-dev and cli-dev) are independent
#      single-threaded compiles, so -j2 builds them side by side
#      (cx-private#1917, PREBUILD-JOBS below).
#   2. the plan — test_changed.sh's own --dry-run split, `parallel (-j):` and
#      `serial tail:`, of the full union (its build-infra escalation, over a
#      change list naming the Makefile) or of the selection from BASE; its
#      test-vcx-suite narrowing kept as SUITE_FILES. One source for the step
#      list, never a second copy.
#   3. the storm's load-INSENSITIVE steps, in parallel: flows/load.cxd's
#      [parallel steps=N] at a time, each on its own runner (<slot>-own<k>,
#      under scripts/build-slot.sh), with VJOBS = the box's cores / N, each
#      under the liveness watch (#1787) — ci-acts' pool-run;
#   4. the storm's load-SENSITIVE steps (flows/load.cxd's rows), one at a time
#      on the post-merge runner itself, the box quiet;
#   5. the serial tail, in its order, only after every step before it passed
#      (site-live-check last: SITER-1); a site reader after a site step that
#      passed reads that step's site/ (`make -o site`, THE TAIL'S SITE below).
# Every step is red or green on its own and every red one is named (-k, RUN-2):
# each ended step's output goes to the log between its STEP-START and
# STEP-END lines with make's own `make: *** [<step>] Error <n>` line for a red
# one, so every reader of gate.log (the refresh's site-live-check reading, a
# person's grep) reads what it read. The exit is 0 when every step passed and
# 2 otherwise, a red storm's code.
#
#   cx --allow-read --allow-write --allow-subprocess --allow-env --allow-clock \
#      scripts/postmerge_steps.cx --checkout=<checkout> test
#   cx … scripts/postmerge_steps.cx --checkout=<checkout> test-changed BASE=<sha>
#   cx … scripts/postmerge_steps.cx --checkout=<checkout> idle   (UNION-1 (a): flows/load.cxd's
#      [idle step=X] rows, one at a time on the post-merge runner — the loop's idle-rows tick)
#   cx … scripts/postmerge_steps.cx --checkout=<checkout> order <step>…   (the pool's
#      longest-first order of the named steps from the checkout's previous runs, one a line;
#      scripts/postmerge_order_selftest.cx grades it)
#
# Its cwd is the tree whose flows/ it reads (the acts', the checkout on the
# box); every make and test_changed.sh runs in the checkout.
[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]
[?lib './flows/ci-acts.cx' as=c]
[?lib './flows/private-acts.cx' as=ci]

[?def say scope=private impure ($s) [$io:write-line [$env:stdout] $s]]

[?def arg-value scope=private pure [returns string] ($words $key)
  [?let [= $hits [?to-sequence [?for [in $w $words] [where [$strings:starts-with [$string $w] $key]] [yield [$string $w]]]]]
    [?if [= [$count $hits] 0] [then ''] [else [$strings:slice [$first $hits] [+ [$strings:length $key] 1] [$strings:length [$first $hits]]]]]]]

# the box's cores: sysctl, else nproc, else 8.
[?def cores scope=private impure [returns int] ()
  [?let [= $a [$process:run ('sysctl', '-n', 'hw.ncpu') timeout-ms=10000]]
        [= $b [?if [$c:ok $a] [then $a] [else [$process:run ('nproc') timeout-ms=10000]]]]
        [= $n [?else [$strings:to-int [$c:out $b]] 0]]
    [?if [> $n 0] [then $n] [else 8]]]]

# the plan: test_changed.sh --dry-run's split, the words after its two labels.
[?def plan-words scope=private pure [returns any] ($out $label)
  [?let [= $ls [?to-sequence [?for [in $l [$c:nonblank-lines $out]] [where [$strings:contains $l $label]] [yield $l]]]]
        [= $rest [?if [= [$count $ls] 0] [then ''] [else [$strings:trim [$re-after [$first $ls] $label]]]]]
    [?if [or [= $rest ''] [= $rest 'none']] [then ()] [else [$str-split-whitespace $rest]]]]]

[?def re-after scope=private pure [returns string] ($s $label)
  [$strings:join [?to-sequence [?drop 1 [?to-sequence [$strings:split [$string $s] $label]]]] $label]]

# test_changed.sh's narrowing of test-vcx-suite: `test-vcx-suite: <n> of <m>
# test files: <files>` — the files, '' when the whole suite runs.
[?def suite-files scope=private pure [returns string] ($out)
  [?let [= $ls [?to-sequence [?for [in $l [$c:nonblank-lines $out]] [where [$strings:contains $l ' test files: ']] [yield $l]]]]
    [?if [= [$count $ls] 0] [then ''] [else [$strings:trim [$re-after [$first $ls] ' test files: ']]]]]]

[?def plan scope=private impure [returns element] ($c $words)
  [?let [= $base [$arg-value $words 'BASE=']]
        [= $union [$c:member 'test' $words]]
        [= $cf [$concat $c '/vcx/target/postmerge-union-changes.txt']]
        [= $_w [?if $union [then [$io:write-file $cf "Makefile\n"]] [else null]]]
        [= $argv [?if $union [then ('bash', 'scripts/test_changed.sh', 'HEAD', '--dry-run', '--changed-files', $cf)]
                   [else ('bash', 'scripts/test_changed.sh', $base, '--dry-run')]]]
        [= $r [$process:run $argv cwd=$c timeout-ms=600000]]
        [= $out [$string $r@stdout]]
    [?if [not [$c:ok $r]] [then [plan-refused why=[$concat 'test_changed.sh --dry-run exited ' [$string $r@exit-code] ': ' [$c:why $r]]]]
      [else [?if [and [not $union] [= $base '']] [then [plan-refused why='test-changed without BASE=']]
        [else [plan storm=[$strings:join [$plan-words $out 'parallel (-j):'] ' ']
                    tail=[$strings:join [$plan-words $out 'serial tail:'] ' ']
                    suite=[$suite-files $out]]]]]]]]

# one step's make words: -o of both binaries and the docs targets' own builds
# (ci/make's BUILT), -o of what this run's prebuild built besides them ($po,
# THE PREBUILD'S OVERLAP below), SUITE_FILES for a narrowed test-vcx-suite, the target.
[?def make-words scope=private pure [returns any] ($t $suite $po)
  [$c:cat2 [$c:cat2 [$c:cat2 ('make', '--no-print-directory') [$ci:built-flags]] $po]
           [?if [and [= $t 'test-vcx-suite'] [not [= $suite '']]] [then ([$concat 'SUITE_FILES=' $suite], $t)] [else ($t)]]]]

# a step run on the post-merge runner, alone: the liveness watch, the block.
[?def serial-step scope=private impure [returns element] ($c $t $argv $runner)
  [?let [= $log [$concat $c '/vcx/target/steps/' $t '.log']]
        [= $_d [$io:make-dirs [$concat $c '/vcx/target/steps']]]
        [= $t0 [$c:now-sec]] [= $t0s [$c:utc-iso]]
        [= $r [?else [$c:watched-run-in $c $argv {} $log '' [$ci:stall-ms $t] 60000 [$c:make-ms]]
                     [proc-result exit-code='2' stalled='false' why='the step could not be started']]]
        [= $_w [?if [= [$string [?else $r@why '']] ''] [then null]
                 [else [$io:append-file [$concat $log '.err'] [$concat 'postmerge-steps: ' [$string $r@why] "\n"]]]]]
        [= $e [ran-step name=$t runner=$runner rc=[$string $r@exit-code] stalled=[$string $r@stalled]
                        t0=[$string $t0] t0s=$t0s t1=[$string [$c:now-sec]] log=$log]]
        [= $_s [$c:say-step $e]]
    $e]]

# THE ORPHAN REAP (cx-private#1903). Only a post-merge run takes the own
# runners <slot>-own<k>, and this run holds the post-merge runner <slot> for
# its life, so a LIVE holder of an own runner when this run starts is an
# orphan of a run that died. Measured on 715d2262a's tick (2026-10-09): pid
# 9523 — scripts/build-slot.sh over a test-playground-mermaid make whose node
# child had slept at 0 % CPU since 6581a4588's run was killed (RUN-EXIT=70,
# 2026-10-07) — still held own3, and every step pool-run gave own3 waited
# BUILD_SLOT_TIMEOUT (60 s) and exited 75 unrun: nine steps red on that tick,
# 9 to 25 on each of the eight ticks before it. The liveness watch (#1787)
# cannot see it: the watcher died with the killed run.
#
# So, before the pool starts and ONLY when the runner's holder is this
# process's ancestor (a hand run outside the runner reaps nothing), each own
# runner's live holder has its process group killed — TERM, 5 s, KILL (a
# holder that leads no group: it and its children) — and the directory
# removed, one line per reap naming what it held.
[?def ancestors scope=private impure [returns any] ()
  [?let [= $rows [$c:ps-rows]]
        [= $pp [?to-sequence [?for [in $w $rows] [yield ([$string [$first $w]], [$string [$nth $w 2]])]]]]
    [?loop [= $cur [$string [$env:pid]]] [= $acc ()] [= $hops 0]
      [?let [= $up [?to-sequence [?for [in $r $pp] [where [= [$first $r] $cur]] [yield [$nth $r 2]]]]]
        [?if [or [= [$count $up] 0] [>= $hops 64] [= $cur '1']] [then [break $acc]]
          [else [continue [$first $up] [$c:cat2 $acc ([$first $up])] [+ $hops 1]]]]]]]]

[?def file-word scope=private impure [returns string] ($p)
  [?if [$io:is-file $p] [then [$strings:trim [$io:read-file $p]]] [else '']]]

[?def reap-own scope=private impure [returns any] ($slot $n)
  [?let [= $holder [$file-word [$concat $slot '/pid']]]
        [= $mine [and [not [= $holder '']] [$c:member $holder [$ancestors]]]]
    [?if [not $mine]
      [then [?let [= $_s [$say [$concat 'postmerge-steps: the runner ' $slot ' is not held by this run (holder ' [?if [= $holder ''] [then 'none'] [else $holder]] ') — no own-runner reap']]] ()]]
      [else [?to-sequence [?for [in $k [$range 1 $n]]
              [= $d [$concat $slot '-own' [$string $k]]]
              [= $pid [$file-word [$concat $d '/pid']]]
              [where [and [not [= $pid '']] [$c:ok [$process:run ('kill', '-0', $pid) timeout-ms=10000]]]]
              [yield [?let [= $since [$file-word [$concat $d '/since']]] [= $cmd [$file-word [$concat $d '/cmd']]]
                           [= $g [$c:out [$process:run ('ps', '-o', 'pgid=', '-p', $pid) timeout-ms=10000]]]
                           [= $kids [?to-sequence [?for [in $w [$c:ps-rows]] [where [= [$string [$nth $w 2]] $pid]] [yield [$string [$first $w]]]]]]
                           [= $tgt [?if [= $g $pid] [then ([$concat '-' $pid])] [else [$c:cat2 ($pid) $kids]]]]
                           [= $_t [$process:run [$c:cat2 ('kill', '-TERM', '--') $tgt] timeout-ms=10000]]
                           [= $_z [?sleep 5s]]
                           [= $_k [$process:run [$c:cat2 ('kill', '-KILL', '--') $tgt] timeout-ms=10000]]
                           [= $_r [?if [$io:exists $d] [then [$io:remove-tree $d]] [else null]]]
                           [= $_s [$say [$concat 'postmerge-steps: REAPED own' [$string $k] ' — holder pid ' $pid ' (group ' $g ', since '
                                                 $since ') outlived its run: ' $cmd]]]
                       [$string $k]]]]]]]]]

# THE WIDE STEPS (cx-private#1903). The parallel phase ends when its longest
# step does, and on 715d2262a's tick that was test-vcx-suite: 999 s of a
# 1,016 s phase, 46 `v test` files on VJOBS=4 (cores / 6), comptime 2,367 s
# against runtime 1,025 s — one C compile per file, single-threaded, four at
# a time — while every other step of the phase had ended by 1,189 s with the
# box half idle. A step named here starts FIRST and runs with VJOBS = half the
# cores (never below the pool's share); the rest keep cores / N.
[?const WIDE ('test-vcx-suite', 'test-vcx-code')]

# THE PREBUILD'S WIDTH (cx-private#1917). build-vcx is two compiles, libcx
# (-prod) and cx, each one V-to-C pass and one cc of one C file, so each runs
# on one core. Core's `build: re2-shim lib cli` ran them one after the other,
# with nothing else of the run started: 213 s of c4b29e8f8's 270 s serial
# prebuild. cx relinks on every tick because its build id carries the
# cx-private commit. Under -j2 the one make builds re2-shim first, then lib
# and cli side by side; build-vcx-dev's lib-dev and cli-dev are the same
# shape. Measured on the core tree at c8414c87 (load 31-166): lib + cli one
# after the other 248 s, -j2 140 s.
[?const PREBUILD-JOBS '-j2']

# THE BENCH BUILDS (cx-private#1903). perf-pair and bench-code-pattern-compile
# are load-sensitive rows — their CLOCKS are — but each compiled the evaluator
# at -prod inside the quiet phase every tick (streaming_bench alone: 164 s of
# compile, 3.4 GB peak, for a 1 s run, measured 2026-10-09 at load 78). When
# either is in the plan, `make bench-bins` joins the pool right after the
# wide steps, so the quiet phase finds the binaries built under an unchanged
# key and only runs them (the Makefile's BENCH_COMPILE).
[?const BENCH-RUNS ('perf-pair', 'bench-code-pattern-compile', 'perf-record')]

# LONGEST FIRST (cx-private#1917). After the wide steps and bench-bins, the
# pool takes the rest longest first, by each step's seconds on the previous
# run (the newest vcx/target/gate-prev-*.log's STEP-END lines). In the plan's
# order the long steps started late and the phase waited for them: on
# f834bf117's tick test-playground-mermaid (2,532 s) started at +604 s,
# premerge-record (2,086 s) at +1,100 s and postmerge-flow-gate (1,371 s) at
# +1,473 s, so the phase's last step ended 3,186 s in although its longest took 2,581 s.
# A step with no row (new, or no previous run) keeps its plan position after
# the measured ones; the order among equals is the plan's.
# The socket phase's pool takes its steps the same way: on 2ddbf280c's tick it
# ran them in plan order, 4 at a time, and test-net-real (241 s, the phase's
# longest) started 24 s in behind four short ones, so the phase took 265 s;
# longest first it starts at 0 and the phase is about its own length.
# A step's seconds are the MEDIAN of its rows in the last FIVE previous runs
# (the upper middle of an even count), not the newest run's alone
# (cx-private#1917, the 93fd77d2b tick): that tick
# followed a SELECTED run of 94 steps, so ledger-index-check (138 s),
# repr-guard-selftest (120 s), check-effect-alignment (66 s) and
# check-selection-manifest (57 s) had no row, kept their plan position after
# every measured step and started 581-653 s in; the phase ended at 791 s
# (ledger-index-check) where e7ab18c2d's full run, ordered from a full run,
# ended at 595 s, and the union read 1,281 s against 942. The median, not the
# largest: the largest (c2dd5d935) let one loaded run order the pool — on the
# 702e67b5b tick f7dba6c7b's run at load 50-210 (reader-parity 556 s,
# check-selection-manifest 439 s against 53-242 and 57-144 on the quiet runs)
# put both ahead of test-flow-umbrella (261-296 s on every run), which started
# 213 s late and ended the phase with ledger-index-check.
[?def last-seconds scope=private impure [returns any] ($c)
  [?let [= $r [$process:run ('sh', '-c', 'for f in $(ls -1 "$0"/vcx/target/gate-prev-*.log 2>/dev/null | tail -5); do grep -a "^STEP-END " "$f"; done; exit 0', $c) timeout-ms=60000]]
    [?to-sequence [?for [in $l [$strings:split [$string $r@stdout] "\n"]]
                        [= $w [$str-split-whitespace $l]]
                        [where [and [= [$count $w] 5] [$strings:starts-with [$nth $w 5] 'seconds=']]]
      [yield [row name=[$nth $w 3] s=[$strings:replace [$nth $w 5] 'seconds=' '']]]]]]]

[?def longest-first scope=private pure [returns any] ($ts $rows)
  [?let [= $keyed [?to-sequence [?for [in $i [$range 1 [$count $ts]]] [= $t [$string [$nth $ts $i]]]
                    [= $hit [?to-sequence [?for [in $r $rows] [where [= [$string $r@name] $t]] [yield [?else [$strings:to-int [$string $r@s]] -1]]]]]
                    [= $sec [?if [= [$count $hit] 0] [then -1] [else [$nth [$sort $hit] [+ [$floor [/ [$count $hit] 2]] 1]]]]]
                    [yield [$concat [$strings:pad-start [$string [- 9999999 [?if [< $sec 0] [then 0] [else $sec]]]] 7 '0']
                                    [?if [< $sec 0] [then '1'] [else '0']]
                                    [$strings:pad-start [$string $i] 5 '0'] ' ' $t]]]]]
    [?to-sequence [?for [in $k [$sort $keyed]] [yield [$nth [$str-split-whitespace $k] 2]]]]]]

# THE PREBUILD'S OVERLAP (cx-private#1946, SELRUN). On 504a6632f's quiet
# selected tick (1,174 s against the 1,200 s selected-run bound) three
# load-insensitive compiles ran where nothing else could use the box:
#   - build-vcx-dev (62 s) ran after build-vcx (154 s: cx relinks on every
#     head, its build id carries the commit) one after the other, with libcx
#     current and 26 of 28 cores idle;
#   - test-db-real's prerequisite db-real-cx (the cx with the postgres and
#     mysql engines) relinked for 213 s of the step's 239 s, inside the
#     load-sensitive socket phase, whose length that step set (the union tick
#     on the same head, cx-db-real up to date, read 23 s);
#   - the profile matrix (#1449's build-profiles-dev: data, embed, cli) was
#     built THREE times. test-flow-umbrella's prerequisite built it at the
#     pool's start, while test-vcx-suite and test-vcx-code ran (CX_SRC_HASH,
#     a hash over the pins' vcx/ trees tests included, read 98847d3f there and
#     dc9d9d4e before and after them). test-extraction-gate's prerequisite
#     rebuilt the data half, and test-profile-gate's rebuilt embed and cli in
#     the serial tail (~53 s). Two writers of one artifact in one pool is the
#     race #1449 named.
# So the prebuild is deps-sync, build-re2-shim alone (the one vcx artifact
# every build shares, written in place), and then side by side, each on its
# own runner: build-vcx, build-vcx-dev, the profile matrix when a step of the
# plan has it as a prerequisite, and db-real-cx when test-db-real is planned.
# Every step after runs `-o` of what was built, so nothing builds it again.
# This is `make test`'s storm order (build-profiles-dev first) made one node
# per artifact again. A step not named here that needs one of these
# prerequisites builds it itself, as before: no -o is passed for anything the
# prebuild did not build.
[?const PROFILE-STEPS ('test-flow-umbrella', 'test-extraction-gate', 'abi-gc-gate', 'test-profile-gate')]

[?def pre-targets scope=private pure [returns any] ($all)
  [$c:cat2 [$c:cat2 ('build-vcx', 'build-vcx-dev')
                    [?if [> [$count [?to-sequence [?for [in $t $all] [where [$c:member $t PROFILE-STEPS]] [yield $t]]]] 0]
                      [then ('build-profiles-dev')] [else ()]]]
           [?if [$c:member 'test-db-real' $all] [then ('db-real-cx')] [else ()]]]]

[?def pre-old scope=private pure [returns any] ($pts)
  [$c:cat2 [?if [$c:member 'build-profiles-dev' $pts] [then ('-o', 'build-profiles-dev', '-o', 'build-profile-data')] [else ()]]
           [?if [$c:member 'db-real-cx' $pts] [then ('-o', 'db-real-cx')] [else ()]]]]

# a prebuild job's make words: build-vcx and build-vcx-dev at PREBUILD-JOBS; the
# profile matrix `-o build-vcx` (build-profile-data names it only to order the
# one make it shared with it; build-vcx is this prebuild's own job beside it).
[?def pre-words scope=private pure [returns any] ($t)
  [?if [or [= $t 'build-vcx'] [= $t 'build-vcx-dev']] [then ('make', '--no-print-directory', PREBUILD-JOBS, $t)]
    [else [?if [= $t 'build-profiles-dev'] [then ('make', '--no-print-directory', '-o', 'build-vcx', $t)]
      [else ('make', '--no-print-directory', $t)]]]]]

# THE TAIL'S SITE (cx-private#1917). Three tail steps read site/ and each one's
# make assembled it again first: test-playground-primer (`make site` in its
# recipe), test-site-phone-width and nav-shape-check (`site` a prerequisite),
# ~11 s of guide render each, one after another in the serial tail. Nothing
# else writes site/ once the storm has drained (test_changed.sh's SERIAL_TAIL
# note) and none of the three writes it, so once one of them has passed — its
# site/ assembled whole from this tree — a later reader runs `make -o site`:
# it reads the site that step assembled. A red builder proves nothing about
# site/, so the next reader assembles it again.
[?const SITE-BUILDERS ('test-playground-primer', 'test-site-phone-width', 'nav-shape-check')]
[?const SITE-READERS ('test-site-phone-width', 'nav-shape-check')]

[?def run-tail scope=private impure [returns any] ($c $tail $suite $po)
  [?loop [= $i 1] [= $acc ()] [= $fresh '']
    [?if [> $i [$count $tail]] [then [break $acc]]
      [else [?let [= $t [$string [$nth $tail $i]]]
                  [= $w [$make-words $t $suite $po]]
                  [= $reuse [and [not [= $fresh '']] [$c:member $t SITE-READERS]]]
                  [= $_s [?if $reuse [then [$say [$concat 'postmerge-steps: ' $t ' reads the site ' $fresh ' assembled (make -o site)']]] [else null]]]
                  [= $e [$serial-step $c $t [?if $reuse [then [$c:cat2 ('make', '-o', 'site') [?to-sequence [?drop 1 $w]]]] [else $w]] 'tail']]
                  [= $ok [= [$string $e@rc] '0']]
        [continue [+ $i 1] [$c:cat2 $acc ($e)]
                  [?if [and $ok [$c:member $t SITE-BUILDERS]] [then [?if [= $fresh ''] [then $t] [else $fresh]]]
                    [else [?if [$c:member $t SITE-BUILDERS] [then ''] [else $fresh]]]]]]]]]]

[?def red-names scope=private pure [returns any] ($es)
  [?to-sequence [?for [in $e $es] [where [not [= [$string $e@rc] '0']]] [yield [$string $e@name]]]]]

# THE REPORT STEPS (cx-private#1946). check-verification-budget judges the
# timings rows EARLIER runs wrote, not this tree, and the verdict writes this
# run's row only when the serial tail ran (flows/private-acts.cx tail-skipped:
# a run without its tail is partial and writes none). Its red stopping the tail
# was a lock: from 2026-10-15T17:11Z every run on a head whose selected-run
# median stood over the bound was red on that step alone, ran no tail, wrote no
# row, and so the median (26m15s) could never move again, whatever a cut did to
# the run. A report step's red still reds the run (exit 2, named); it no longer
# stops the tail, so the run is whole and its row is written.
[?const REPORT-STEPS ('check-verification-budget',)]

[?def tail-blockers scope=private pure [returns any] ($es)
  [?to-sequence [?for [in $n [$red-names $es]] [where [not [$c:member $n REPORT-STEPS]]] [yield $n]]]]

[?def finish scope=private impure ($es $why)
  [?let [= $reds [$red-names $es]]
        [= $_s [$say [$concat 'postmerge-steps: ' [$string [$count $es]] ' step(s), ' [$string [$count $reds]] ' red'
                              [?if [= [$count $reds] 0] [then ''] [else [$concat ': ' [$strings:join $reds ' ']]]]
                              [?if [= $why ''] [then ''] [else [$concat ' — ' $why]]]]]]
    [$env:exit [?if [= [$count $reds] 0] [then 0] [else 2]]]]]

# UNION-1 (a) (cx-private#1917): the idle period's run — flows/load.cxd's
# [idle step=X] rows, one at a time on the post-merge runner, in the tree the
# union just graded (no prebuild: its binaries are the union's, and every step
# runs -o of both). Each step's old log goes first, so a reader of
# vcx/target/steps/ reads this run's; the union's other step logs stay.
# THE PERF SLOT (cx-private#1946, PROC-1). A landing gate's perf judge holds
# STREAMS/state/perf-slot and takes it only while the loop is idle; it cannot see an
# idle period that starts after it. On 2026-10-15 the loop's IDLE-START (16:13:58Z)
# fell 8 minutes into a gate's slot (taken 16:05Z), two perf-pairs on one box. So
# each idle-period step waits while the slot exists (CX_PERF_SLOT names another
# path), at most an hour, then runs and says so.
[?def wait-perf-slot scope=private impure ($t)
  [?let [= $f [$env:var-or-default 'CX_PERF_SLOT' [$concat [$env:var-or-default 'HOME' ''] '/git-repos/cx/STREAMS/state/perf-slot']]]
    [?loop [= $n 0]
      [?if [or [not [$io:exists $f]] [>= $n 720]]
        [then [break [?if [= $n 0] [then null]
                       [else [$say [$concat 'postmerge-steps: ' $t ' waited ' [$string [* $n 5]] ' s for the perf slot ' $f
                                            [?if [>= $n 720] [then ' — still held after an hour; it runs now'] [else '']]]]]]]]
        [else [?let [= $_w [?if [= $n 0] [then [$say [$concat 'postmerge-steps: ' $t ' waits: the perf slot ' $f ' is held']]] [else null]]]
                    [= $_z [?sleep 5s]]
                [continue [+ $n 1]]]]]]]]

[?def run-idle scope=private impure ($c)
  [?let [= $ts [$ci:idle-steps]]
        [= $_h [$say [$concat 'postmerge-steps: the idle period (flows/load.cxd [idle], UNION-1 (a)): '
                              [?if [= [$count $ts] 0] [then 'none'] [else [$strings:join $ts ' ']]] ', one at a time on the post-merge runner']]]
        [= $_r [?to-sequence [?for [in $t $ts] [in $x ('.log', '.log.err')] [= $f [$concat $c '/vcx/target/steps/' $t $x]]
                 [yield [?if [$io:is-file $f] [then [$io:remove $f]] [else null]]]]]]
        [= $es [?to-sequence [?for [in $t $ts] [yield [?let [= $_p [$wait-perf-slot $t]] [$serial-step $c $t [$make-words $t '' ()] 'post-merge']]]]]]
    [$finish $es '']]]

[?let [= $argv [?to-sequence [?for [in $a [$env:argv]] [yield [$string $a]]]]]
      [= $words [?to-sequence [?drop 1 $argv]]]
      [= $c [$arg-value $words '--checkout=']]
      [= $rest [?to-sequence [?for [in $w $words] [where [not [$strings:starts-with $w '--checkout=']]] [yield $w]]]]
      [= $slot0 [$env:var-or-default 'CX_BUILD_SLOT' '']]
      [= $slot [?if [= $slot0 ''] [then [$concat [$env:var-or-default 'HOME' ''] '/git-repos/cx/.build-slot']] [else $slot0]]]
      [= $lr [$ci:load-refusals [$ci:load-doc]]]
  [?if [or [= $c ''] [= [$count $rest] 0]]
    [then [?let [= $_e [$say 'usage: postmerge_steps.cx --checkout=<checkout> test | test-changed BASE=<sha>']] [$env:exit 64]]]
  [else [?if [> [$count $lr] 0]
    [then [?let [= $_e [$say [$strings:join $lr "\n"]]] [$env:exit 2]]]
  [else [?if [= [$first $rest] 'reap']
    [then [?let [= $_r [$reap-own $slot [$ci:parallel-steps]]] [$env:exit 0]]]
  [else [?if [= [$first $rest] 'idle']
    [then [$run-idle $c]]
  [else [?if [= [$first $rest] 'order']
    [then [?let [= $_o [?to-sequence [?for [in $t [$longest-first [?to-sequence [?drop 1 $rest]] [$last-seconds $c]]] [yield [$say $t]]]]] [$env:exit 0]]]
  [else [?let
    [= $_d [?if [$io:exists [$concat $c '/vcx/target/steps']] [then [$io:remove-tree [$concat $c '/vcx/target/steps']]] [else null]]]
    [= $ds [$serial-step $c 'deps-sync' ('make', '--no-print-directory', 'deps-sync') 'post-merge']]
    [?if [> [$count [$red-names ($ds)]] 0] [then [$finish ($ds) 'the prebuild is red: no step ran']]
    [else [?let
      [= $p [$plan $c $rest]]
      [?if [= [$name $p] 'plan-refused'] [then [?let [= $_e [$say [$concat 'postmerge-steps: ' [$string $p@why]]]] [$env:exit 2]]]
      [else [?let
        [= $idle [$ci:idle-steps]]
        [= $storm0 [$str-split-whitespace [$string $p@storm]]]
        [= $tail0 [$str-split-whitespace [$string $p@tail]]]
        [= $ss [$ci:idle-split $storm0 $idle]] [= $ts [$ci:idle-split $tail0 $idle]]
        [= $storm [$str-split-whitespace [$string $ss@run]]]
        [= $tail [$str-split-whitespace [$string $ts@run]]]
        [= $left [$str-split-whitespace [$strings:trim [$concat [$string $ss@left] ' ' [$string $ts@left]]]]]
        [= $_i [?if [= [$count $left] 0] [then null]
                 [else [$say [$concat 'postmerge-steps: ' [$string [$count $left]] ' idle-period step(s) not in this run (flows/load.cxd [idle], UNION-1 (a)): '
                                      [$strings:join $left ' '] ' — the loop runs them once the tip passed']]]]]
        [= $n [$ci:parallel-steps]]
        [= $vj [?if [< [$floor [/ [$cores] $n]] 1] [then 1] [else [$floor [/ [$cores] $n]]]]]
        [= $slotsh ('sh', [$concat $c '/scripts/build-slot.sh'])]
        [= $pts [$pre-targets [$c:cat2 $storm $tail]]]
        [= $po [$pre-old $pts]]
        [= $_reap0 [$reap-own $slot $n]]
        [= $re [$serial-step $c 'build-re2-shim' ('make', '--no-print-directory', 'build-re2-shim') 'post-merge']]
        [= $_ph0 [$say [$concat 'postmerge-steps: the prebuild, side by side after build-re2-shim (cx-private#1946): ' [$strings:join $pts ' ']]]]
        [= $pjobs0 [?to-sequence [?for [in $t $pts]
                     [yield [job name=$t log=[$concat $c '/vcx/target/steps/' $t '.log'] stall-ms=[$string [$ci:stall-ms $t]] cwd=$c
                              [?splice [?to-sequence [?for [in $w [$c:cat2 $slotsh [$pre-words $t]]] [yield [arg v=$w]]]]]]]]]]
        [= $pb [?if [= [$string $re@rc] '0'] [then [$c:pool-run $pjobs0 [$count $pjobs0] $slot $vj 60000]] [else ()]]]
        [= $pre [$c:cat2 ($ds, $re) $pb]]
        [?if [> [$count [$red-names $pre]] 0] [then [$finish $pre 'the prebuild is red: no step ran']]
        [else [?let
        [= $sens [$ci:sensitive]]
        [= $own [?to-sequence [?for [in $t $storm] [where [not [$c:member $t $sens]]] [yield $t]]]]
        [= $shared [?to-sequence [?for [in $t $storm] [where [$c:member $t $sens]] [yield $t]]]]
        [= $_h [$say [$concat 'postmerge-steps: ' [$string [$count $own]] ' load-insensitive step(s), ' [$string $n]
                              ' at a time on their own runners (VJOBS=' [$string $vj] '; first and VJOBS=' [$string [?if [< [$floor [/ [$cores] 2]] $vj] [then $vj] [else [$floor [/ [$cores] 2]]]]] ': ' [$strings:join WIDE ' '] '); then ' [$string [$count $shared]]
                              ' load-sensitive on the post-merge runner: ' [?if [= [$count $shared] 0] [then 'none'] [else [$strings:join $shared ' ']]]
                              '; then the tail: ' [?if [= [$count $tail] 0] [then 'none'] [else [$strings:join $tail ' ']]]]]]
        [= $vw [?if [< [$floor [/ [$cores] 2]] $vj] [then $vj] [else [$floor [/ [$cores] 2]]]]]
        [= $bb [?if [> [$count [?to-sequence [?for [in $t [$c:cat2 $storm $tail]] [where [$c:member $t BENCH-RUNS]] [yield $t]]]] 0]
                 [then ('bench-bins')] [else ()]]]
        [= $ord [$c:cat2 [$c:cat2 [?to-sequence [?for [in $t $own] [where [$c:member $t WIDE]] [yield $t]]] $bb]
                         [$longest-first [?to-sequence [?for [in $t $own] [where [not [$c:member $t WIDE]]] [yield $t]]]
                                         [$last-seconds $c]]]]
        [= $jobs [?to-sequence [?for [in $t $ord]
                   [yield [job name=$t log=[$concat $c '/vcx/target/steps/' $t '.log'] stall-ms=[$string [$ci:stall-ms $t]] cwd=$c
                            vjobs=[$string [?if [$c:member $t WIDE] [then $vw] [else $vj]]]
                            [?splice [?to-sequence [?for [in $w [$c:cat2 $slotsh [$make-words $t [$string $p@suite] $po]]]
                                       [yield [arg v=$w]]]]]]]]]]
        [= $_reap [$reap-own $slot $n]]
        [= $par [$c:pool-run $jobs $n $slot $vj 60000]]
        [= $wall [$ci:sensitive-wall]]
        [= $sn [$ci:sensitive-parallel]]
        [= $ports [?if [> $sn 1] [then [$longest-first [?to-sequence [?for [in $t $shared] [where [not [$c:member $t $wall]]] [yield $t]]]
                                                        [$last-seconds $c]]] [else ()]]]
        [= $alone [?to-sequence [?for [in $t $shared] [where [not [$c:member $t $ports]]] [yield $t]]]]
        [= $pjobs [?to-sequence [?for [in $t $ports]
                    [yield [job name=$t log=[$concat $c '/vcx/target/steps/' $t '.log'] stall-ms=[$string [$ci:stall-ms $t]] cwd=$c
                             [?splice [?to-sequence [?for [in $w [$c:cat2 $slotsh [$make-words $t [$string $p@suite] $po]]]
                                        [yield [arg v=$w]]]]]]]]]]
        [= $_ph [?if [> [$count $ports] 0]
                  [then [$say [$concat 'postmerge-steps: ' [$string [$count $ports]] ' load-sensitive socket step(s), ' [$string $sn]
                                       ' at a time (cx-private#1903): ' [$strings:join $ports ' '] '; then alone: ' [$strings:join $alone ' ']]]]
                  [else null]]]
        [= $sp [?if [> [$count $ports] 0] [then [$c:pool-run $pjobs $sn $slot [?if [< [$floor [/ [$cores] $sn]] 1] [then 1] [else [$floor [/ [$cores] $sn]]]] 60000]] [else ()]]]
        [= $sh [$c:cat2 $sp [?to-sequence [?for [in $t $alone] [yield [$serial-step $c $t [$make-words $t [$string $p@suite] $po] 'post-merge']]]]]]
        [= $before [$c:cat2 [$c:cat2 $pre $par] $sh]]
        [= $tl [?if [> [$count [$tail-blockers $before]] 0] [then ()]
                 [else [$run-tail $c $tail [$string $p@suite] $po]]]]
        [$finish [$c:cat2 $before $tl]
                 [?if [and [> [$count [$tail-blockers $before]] 0] [> [$count $tail] 0]] [then 'the serial tail did not run: a step before it is red'] [else '']]]]]]]]]]]]]]]]]]]]]]]]
