# scripts/gen_docs/contributor_facts.cx — the contributor front door's
# generated fragments (RULED: K11a, RS-30, RS-28).
#
# docs/llm/contributor*.md is the CONTRIBUTOR's front door, beside the primer
# (the language's). The rules in it are hand-written and cite their `RULED:`
# id; every FACT a registry row, a pin, the step roster or the ledger already
# states is projected from that source here instead, so the document cannot
# say something the tree does not. primer_build.cx reads the files and calls
# these functions from its placeholders; `make docs-check` then holds the
# committed bytes to a fresh projection, the same drift gate the primer has.
#
# Everything here is PURE: text in, Markdown out. Reading files and failing
# the run on an empty derivation are primer_build.cx's business.
#
#   [$facts:repo-rows TEXT]              registry/repos.cxd -> the repository map
#   [$facts:pin-rows TEXT]               deps.cxd -> what the front door pins
#   [$facts:module-census TEXT]          registry/modules.cxd -> rows per repository
#   [$facts:module-columns TEXT]         registry/modules.cxd -> the row's columns
#   [$facts:step-rows MAKEFILE INCLUDES FLOW] Makefile TEST_TARGETS -> the step roster
#   [$facts:ruling-rows PAGES]           ledger pages -> RS-1…RS-n, the ledger's words
#   [$facts:row-count TABLE]             how many body rows a fragment carries
#
# The volatile columns stay in their files: a pin's sha, a row's `at=`, a
# row's `why=`. Projecting them would make every pin bump a docs change; the
# fragment names the file that carries them instead.

[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/strings' as=strings]

# -- small helpers ---------------------------------------------------------

[?def attr-or scope=private pure [returns string] ($e $k::string $d::string)
  [?let [= $hits [?for [in $a [$attrs $e]] [where [= [$string $a@name] $k]] [yield [$string $a]]]]
    [?if [= [$count $hits] 0] [then $d] [else [$first $hits]]]]]

[?def matched scope=private pure [returns bool] ($m) [= [$name $m] "match"]]

# num: a run of digits the regex already vouched for, as an int.
[?def num scope=private pure [returns int] ($s::string) [?else [$strings:to-number $s] 0]]

# join-lines: `$strings:join` over a sequence LITERAL. A namespaced call head
# beside a whitespace-delimited literal is read differently by the data reader
# (#1536, reader-parity), so the literal goes through this local head instead.
# The record shapes this file builds, each through one constructor: an
# attribute computed in place (`id=[…]`) is a program-only form the data
# reader refuses (reader-parity), a bound value is not.
[?def mk-var   scope=private pure ($n $v) [var name=$n value=$v]]
[?def mk-pick  scope=private pure ($at $text) [pick at=$at text=$text]]
[?def mk-hit   scope=private pure ($id $text $page) [hit id=$id text=$text page=$page]]
[?def mk-range scope=private pure ($lo $hi $text $page) [range lo=$lo hi=$hi text=$text page=$page]]

[?def join-lines scope=private pure [returns string] ($xs $sep::string) [$strings:join $xs $sep]]

[?def fp-cat scope=private pure ($ss) [?for [in $s $ss] [in $x $s] [yield $x]]]

[?def max-of scope=private pure ($xs)
  [?let [= $hi [?for [in $x $xs] [where [= [$count [?for [in $y $xs] [where [> $y $x]] [yield 1]]] 0]] [yield $x]]]
    [$first $hi]]]

[?def member scope=private pure [returns bool] ($x::string $xs)
  [> [$count [?for [in $y $xs] [where [= $y $x]] [yield 1]]] 0]]

# cell: one Markdown table cell's text — a `|` inside it would split the row.
[?def cell scope=private pure [returns string] ($s::string)
  [$strings:replace $s "|" "\\|"]]

[?def code scope=private pure [returns string] ($s::string)
  [?if [= $s ""] [then "—"] [else [$concat "`" $s "`"]]]]

[?def codes scope=private pure [returns string] ($s::string)
  [?let [= $ws [$strings:split-whitespace $s]]
    [?if [= [$count $ws] 0]
      [then "—"]
      [else [$strings:join [?for [in $w $ws] [yield [$concat "`" $w "`"]]] " "]]]]]

[?def provenance scope=private pure [returns string] ($what::string $n::int)
  [$concat "<sub>Generated by `scripts/gen_docs/contributor_facts.cx` from " $what
           " (" [$string $n] " rows) — do not edit here: change the source, run `make docs`.</sub>"]]

# row-count: the body rows of a fragment this file rendered (every line that
# opens a table row, less the header and the separator).
[?def row-count scope=public pure [returns int] ($table::string)
  [- [$count [?for [in $l [$strings:split-lines $table]]
               [where [$strings:starts-with $l "| "]] [yield 1]]] 1]]

# -- registry/repos.cxd: the repository map ---------------------------------

[?def repos-of scope=private pure ($text::string)
  [?for [in $r [$cx:parse $text]//repo] [yield $r]]]

[?def repo-rows scope=public pure [returns string] ($text::string)
  [?let
    [= $rs [$repos-of $text]]
    [= $body [?for [in $r $rs]
      [yield [$concat "| `" [$attr-or $r "name" ""] "` | "
                      [$attr-or $r "group" ""] " | "
                      [$attr-or $r "ring" ""] " | "
                      [$attr-or $r "ships" ""] " | "
                      [$code [$attr-or $r "vmodule" ""]] " | "
                      [$codes [$attr-or $r "pins" ""]] " | "
                      [$attr-or $r "status" "—"] " | "
                      [$cell [$attr-or $r "about" ""]] " |"]]]]
    [$join-lines (
      [$provenance "`registry/repos.cxd`'s `[repo]` rows; `at=` (the pinned sha) and `why=` stay in the file" [$count $rs]],
      "",
      "| repository | group | ring | ships | V module (`vcx/<m>/`) | pins | status | what it is |",
      "|---|---|---|---|---|---|---|---|",
      [$strings:join $body "\n"]) "\n"]]]

# -- deps.cxd: what the front door pins -----------------------------------------

[?def pin-rows scope=public pure [returns string] ($text::string)
  [?let
    [= $ds [?for [in $d [$cx:parse $text]//dep] [yield $d]]]
    [= $body [?for [in $d $ds]
      [= $mods [$strings:split-whitespace [$attr-or $d "module" ""]]]
      [yield [$concat "| `" [$attr-or $d "repo" ""] "` | "
                      [$string [$count $mods]] " | "
                      [?if [= [$attr-or $d "v-fork" ""] ""] [then "no"] [else "yes"]] " | "
                      [$strings:join [?for [in $m $mods] [yield [$concat "`" $m "`"]]] " "] " |"]]]]
    [$join-lines (
      [$provenance "`deps.cxd`'s `[dep]` rows; each row's `sha` and `v-fork` sha stay in the file" [$count $ds]],
      "",
      "| pinned repository | modules | V repository (carries `v-fork`) | the modules the pin provides |",
      "|---|---|---|---|",
      [$strings:join $body "\n"]) "\n"]]]

# -- registry/modules.cxd: rows per repository, and the row's columns ------

[?def modules-of scope=private pure ($text::string)
  [?for [in $m [$cx:parse $text]//module] [yield $m]]]

[?def module-census scope=public pure [returns string] ($text::string)
  [?let
    [= $ms [$modules-of $text]]
    [= $repos [$distinct [?for [in $m $ms] [yield [$attr-or $m "repo" "none"]]]]]
    [= $body [?for [in $rp $repos]
      [= $mine [?for [in $m $ms] [where [= [$attr-or $m "repo" "none"] $rp]] [yield $m]]]
      [= $r0 [$count [?for [in $m $mine] [where [= [$attr-or $m "ring" ""] "0"]] [yield 1]]]]
      [= $r1 [$count [?for [in $m $mine]
                        [where [and [= [$attr-or $m "ring" ""] "1"] [= [$attr-or $m "group" ""] ""]]]
                        [yield 1]]]]
      [= $pg [$count [?for [in $m $mine] [where [= [$attr-or $m "group" ""] "platform"]] [yield 1]]]]
      [= $planned [$count [?for [in $m $mine] [where [= [$attr-or $m "status" ""] "planned"]] [yield 1]]]]
      [yield [$concat "| `" $rp "` | " [$string [$count $mine]] " | " [$string $r0] " | "
                      [$string $r1] " | " [$string $pg] " | " [$string $planned] " | "
                      [$strings:join [?for [in $m $mine] [yield [$attr-or $m "name" ""]]] ", "] " |"]]]]
    [$join-lines (
      [$provenance "`registry/modules.cxd`'s `[module]` rows, grouped by `repo=`" [$count $ms]],
      "",
      "| repository | rows | ring 0 | ring 1 | `group=platform` | `status=planned` | the rows (`name=`) |",
      "|---|---|---|---|---|---|---|",
      [$strings:join $body "\n"]) "\n"]]]

[?def module-columns scope=public pure [returns string] ($text::string)
  [?let
    [= $ms [$modules-of $text]]
    [= $names [$distinct [?for [in $m $ms] [in $a [$attrs $m]] [yield [$string $a@name]]]]]
    [= $body [?for [in $k $names]
      [= $n [$count [?for [in $m $ms] [where [$member $k [?for [in $a [$attrs $m]] [yield [$string $a@name]]]]] [yield 1]]]]
      [= $vals [$distinct [?for [in $m $ms] [yield [$attr-or $m $k ""]]]]]
      [yield [$concat "| `" $k "=` | " [$string $n] " | "
                      [?if [<= [$count $vals] 6]
                        [then [$strings:join [?for [in $v $vals] [where [not [= $v ""]]] [yield [$concat "`" $v "`"]]] " "]]
                        [else [$concat [$string [$count $vals]] " distinct values"]]] " |"]]]]
    [$join-lines (
      [$provenance "the attribute names `registry/modules.cxd`'s `[module]` rows carry, in first-use order" [$count $names]],
      "",
      "| column | rows carrying it | its values (six or fewer), or how many |",
      "|---|---|---|",
      [$strings:join $body "\n"]) "\n"]]]

# -- the Makefile: the step roster ----------------------------------------------
#
# TEST_TARGETS is the one list `make test` runs and `scripts/test_changed.sh`
# selects from; DOC_TARGETS is the doc pipeline's (RULED: INT-10). The third
# column is the first program a step's recipe names — a script, a tool, or the
# pinned repository's own `vcx/` make target it delegates to — read from the
# rule in the Makefile or in one of the files it includes.

[?def var-words scope=private pure ($lines $var::string)
  [?let
    [= $n [$count $lines]]
    [= $starts [?for [in $i [$range 1 $n]]
                 [where [$strings:starts-with [$nth $lines $i] [$concat $var " :="]]]
                 [yield $i]]]
    [?if [= [$count $starts] 0]
      [then ()]
      [else [?let
        [= $s [$first $starts]]
        [= $ends [?for [in $i [$range $s $n]]
                   [where [not [$strings:ends-with [$nth $lines $i] "\\"]]]
                   [yield $i]]]
        [= $e [?if [= [$count $ends] 0] [then $n] [else [$first $ends]]]]
        [= $text [$strings:join [?for [in $i [$range $s $e]] [yield [$nth $lines $i]]] " "]]
        [= $body [$strings:slice $text [+ [$strings:length $var] 4] [$strings:length $text]]]
        [?for [in $w [$strings:split-whitespace $body]] [where [not [= $w "\\"]]] [yield $w]]]]]]]

# rule-line: the index of `<step>:` that opens the step's recipe (a line
# setting a target-specific variable, `step: X ?= …`, opens none).
[?def rule-lines scope=private pure ($lines $step::string)
  [?let [= $head [$concat $step ":"]]
    [?for [in $i [$range 1 [$count $lines]]]
      [= $l [$nth $lines $i]]
      [where [$strings:starts-with $l $head]]
      [= $rest [$strings:slice $l [+ [$strings:length $head] 1] [$strings:length $l]]]
      [where [not [$strings:contains $rest "="]]]
      [where [not [$strings:starts-with [$strings:trim $rest] "export "]]]
      [yield $i]]]]

[?def recipe-of scope=private pure ($lines $i::int)
  [?let [= $n [$count $lines]]
        [= $after [?for [in $j [$range [+ $i 1] $n]]
                    [where [not [$strings:starts-with [$nth $lines $j] "\t"]]]
                    [yield $j]]]
        [= $end [?if [= [$count $after] 0] [then $n] [else [- [$first $after] 1]]]]
    [?if [< $end [+ $i 1]]
      [then ""]
      [else [$strings:join [?for [in $j [$range [+ $i 1] $end]] [yield [$nth $lines $j]]] "\n"]]]]]

# simple-vars: `NAME := dir` definitions whose one-word value is a DIRECTORY (no
# extension on its last segment) -- the only way a recipe spells a program
# path through a variable ($(DOCS_GEN)/primer_build.cx). A variable naming a
# FILE is what a step reads or checks, not what it runs, so it stays unexpanded.
[?def simple-vars scope=private pure ($lines)
  [?for [in $l $lines]
    [= $m [$re:find [$re:compile "^([A-Z][A-Z0-9_]*) *:?= *([A-Za-z0-9_./-]*/[A-Za-z0-9_-]+)$"] $l]]
    [where [$matched $m]]
    [yield [$mk-var [$re:group $m 1] [$re:group $m 2]]]]]

[?def expand-vars scope=private pure [returns string] ($s::string $vars)
  [$fp:fold $vars $s
    [?fn ($acc $v) [$strings:replace $acc [$concat "$(" [$string $v@name] ")"] [$string $v@value]]]]]

# The three shapes a recipe line runs something in, earliest on the line wins:
# a script or tool path; a `v … test|run <path>`; a delegation to a pinned
# repository's own vcx/ make target.
[?const RX-PATH "(?:^|[\\s\"'@=(;{])((?:scripts|tools|bench|deps/[A-Za-z0-9_-]+/(?:scripts|tools))/[A-Za-z0-9_./-]*[A-Za-z0-9_])"]
[?const RX-VTEST "\\s(test|run) ((?:deps/[A-Za-z0-9_-]+/)?vcx/[A-Za-z0-9_./-]*[A-Za-z0-9_/])"]
[?const RX-MAKE "-C (deps/[A-Za-z0-9_-]+/vcx)((?:\\s+[A-Z_]+=\\S+)*)\\s+([a-z][a-z0-9-]*)"]

[?def line-pick scope=private pure ($l::string)
  [?let
    [= $a [$re:find [$re:compile RX-PATH] $l]]
    [= $b [$re:find [$re:compile RX-VTEST] $l]]
    [= $c [$re:find [$re:compile RX-MAKE] $l]]
    [= $cands [$fp-cat (
      [?if [$matched $a] [then ([$mk-pick $a@start [$concat "`" [$re:group $a 1] "`"]],)] [else ()]],
      [?if [$matched $b] [then ([$mk-pick $b@start [$concat "`v " [$re:group $b 1] " " [$re:group $b 2] "`"]],)] [else ()]],
      [?if [$matched $c] [then ([$mk-pick $c@start [$concat "`make -C " [$re:group $c 1] " " [$re:group $c 3] "`"]],)] [else ()]])]]
    [?for [in $p $cands]
      [where [= [$count [?for [in $q $cands] [where [< $q@at $p@at]] [yield 1]]] 0]]
      [yield $p]]]]

[?def program-of scope=private pure [returns string] ($recipe::string $vars)
  [?let
    [= $picks [?for [in $l [$strings:split-lines [$expand-vars $recipe $vars]]]
                [where [not [$strings:starts-with [$strings:trim $l] "#"]]]
                [in $p [$line-pick $l]]
                [yield $p]]]
    [?if [= [$count $picks] 0] [then "—"] [else [$string [$first $picks]@text]]]]]

# flow-targets: every make target the documentation flow's document names —
# the `[target …]` and `[targets '…']` fields of its `[do …]` acts (RULED:
# CICD-1). The doc pipeline runs those through `docs-flow`, so a step the flow
# runs is in the doc pipeline even though DOC_TARGETS names only the flow.
# FLOW is the parsed document, or () where the tree carries none.
[?def flow-targets scope=public pure ($flow)
  [$fp:flat-map
    ([?to-sequence [?for [in $t $flow//do/target] [yield [$strings:trim [$string $t]]]]],
     [?to-sequence [?for [in $t $flow//do/targets]
                     [in $w [$strings:split-whitespace [$string $t]]] [yield $w]]])
    [?fn ($x) $x]]]

[?def step-rows scope=public pure [returns string] ($makefile::string $includes $flow)
  [?let
    [= $mk [$strings:split-lines $makefile]]
    [= $all [$strings:split-lines [$join-lines ($makefile, [$strings:join $includes "\n"]) "\n"]]]
    [= $steps [$var-words $mk "TEST_TARGETS"]]
    [= $docs [$var-words $mk "DOC_TARGETS"]]
    [= $viaflow [?if [$member "docs-flow" $docs] [then [$flow-targets $flow]] [else ()]]]
    [= $vars [$simple-vars $all]]
    [= $body [?for [in $i [$range 1 [$count $steps]]]
      [= $s [$nth $steps $i]]
      [= $at [$rule-lines $all $s]]
      [= $prog [?if [= [$count $at] 0] [then "—"] [else [$program-of [$recipe-of $all [$first $at]] $vars]]]]
      [yield [$concat "| " [$string $i] " | `" $s "` | "
                      [?if [$member $s $docs] [then "yes"]
                        [else [?if [$member $s $viaflow] [then "yes, in the docs flow"] [else ""]]]]
                      " | " $prog " |"]]]]
    [$join-lines (
      [$provenance "the Makefile's `TEST_TARGETS` (in order), `DOC_TARGETS`, the targets `docs-src/flow/docs.flow.cx` names, and each step's own rule" [$count $steps]],
      "",
      "| # | step | in the doc pipeline | the first program its recipe names |",
      "|---|---|---|---|",
      [$strings:join $body "\n"]) "\n"]]]

# -- the ledger: RS-1…RS-n in the ledger's own words ------------------------------
#
# Two shapes carry an RS id's statement: a decision-table row whose first cell
# is `**RS-n**` (the lead in bold is the rule; a lead that is not a whole
# sentence takes the rest of its first sentence), and a heading `RS-n — <statement>`. An id with
# neither is named by the range heading `RS-a…RS-b — …` that covers it. An id
# no heading on any page names is not allocated on this ledger (ids are taken
# on parallel branches and merge in any order) and is left out; an id a heading
# names with neither shape is rendered MISSING-FROM-LEDGER, which primer_build.cx
# refuses: the reader missed a statement the page carries.

[?def row-lead scope=private pure ($line::string)
  [?let
    [= $m [$re:find [$re:compile "^\\| \\*\\*RS-([0-9]+)\\*\\* \\| \\*\\*(.+?)\\*\\*(.*)$"] $line]]
    [?if [not [$matched $m]]
      [then ()]
      [else [?let
        [= $lead [$re:group $m 2]]
        [= $rest [$re:group $m 3]]
        [= $more [?if [not [$strings:ends-with $lead "."]]
                   [then [?let [= $s [$re:find [$re:compile "^\\s*(.+?\\.)(?:\\s|$)"] $rest]]
                           [?if [$matched $s] [then [$concat " " [$re:group $s 1]]] [else ""]]]]
                   [else ""]]]
        ([$mk-hit [$re:group $m 1] [$concat $lead $more] ""],)]]]]]

[?def heading-hit scope=private pure ($line::string)
  [?let [= $m [$re:find [$re:compile "^#{1,3} RS-([0-9]+) — (.+)$"] $line]]
    [?if [$matched $m]
      [then ([$mk-hit [$re:group $m 1] [$re:group $m 2] ""],)]
      [else ()]]]]

[?def range-hit scope=private pure ($line::string)
  [?let [= $m [$re:find [$re:compile "^#{1,3} RS-([0-9]+)…RS-([0-9]+) — (.+)$"] $line]]
    [?if [$matched $m]
      [then ([$mk-range [$re:group $m 1] [$re:group $m 2]
                    [$concat "RS-" [$re:group $m 1] "…RS-" [$re:group $m 2] " — " [$re:group $m 3]] ""],)]
      [else ()]]]]

# ruling-rows: PAGES is a sequence of `page` elements, each with a path and a text attribute.
[?def ruling-rows scope=public pure [returns string] ($pages)
  [?let
    [= $hits [?for [in $p $pages] [in $l [$strings:split-lines [$string $p@text]]]
               [in $h [$fp-cat ([$row-lead $l], [$heading-hit $l])]]
               [yield [$mk-hit [$string $h@id] [$string $h@text] [$string $p@path]]]]]
    [= $ranges [?for [in $p $pages] [in $l [$strings:split-lines [$string $p@text]]]
                 [in $h [$range-hit $l]]
                 [yield [$mk-range [$num [$string $h@lo]] [$num [$string $h@hi]] [$string $h@text] [$string $p@path]]]]]
    [= $named-re [$re:compile "RS-([0-9]+)"]]
    [= $named [?for [in $p $pages] [in $l [$strings:split-lines [$string $p@text]]]
                [where [$strings:starts-with $l "#"]]
                [in $m [$re:find-all $named-re $l]]
                [yield [$num [$re:group $m 1]]]]]
    [= $ids [?for [in $h $hits] [yield [$num [$string $h@id]]]]]
    [= $top [?if [= [$count $ids] 0] [then 0] [else [$max-of $ids]]]]
    [= $body [?for [in $n [$range 1 $top]]
      [= $own [?for [in $h $hits] [where [= [$num [$string $h@id]] $n]] [yield $h]]]
      [= $cover [?for [in $r $ranges] [where [and [<= $r@lo $n] [>= $r@hi $n]]] [yield $r]]]
      [= $said [?for [in $x $named] [where [= $x $n]] [yield $x]]]
      [where [or [> [$count $own] 0] [or [> [$count $cover] 0] [> [$count $said] 0]]]]
      [= $pick [?if [> [$count $own] 0] [then [$first $own]]
                 [else [?if [> [$count $cover] 0] [then [$first $cover]]
                         [else [hit text="MISSING-FROM-LEDGER" page="—"]]]]]]
      [yield [$concat "| `RS-" [$string $n] "` | " [$cell [$string $pick@text]] " | `ledger/"
                      [$string $pick@page] "` |"]]]]
    [$join-lines (
      [$provenance "the ledger pages' `RS-n` decision rows and headings, verbatim" [$count $body]],
      "",
      "| id | the ledger's statement | page |",
      "|---|---|---|",
      [$strings:join $body "\n"]) "\n"]]]


# -- the umbrella test files ----------------------------------------------------
#
# An umbrella is the one `*_umbrella_test.v` that owns an area's test functions
# (a new standalone test file costs a whole-graph link on every run). PATHS are
# the files a glob over the front door and its pinned checkouts found; the
# repository is read from the `deps/<repo>/` prefix.

[?def umbrella-rows scope=public pure [returns string] ($paths)
  [?let
    [= $body [?for [in $p $paths]
      [= $m [$re:find [$re:compile "^deps/([A-Za-z0-9_-]+)/(.*)$"] $p]]
      [= $repo [?if [$matched $m] [then [$re:group $m 1]] [else "cx"]]]
      [= $rel [?if [$matched $m] [then [$re:group $m 2]] [else $p]]]
      [yield [$concat "| `" $rel "` | `" $repo "` |"]]]]
    [$join-lines (
      [$provenance "the `*_umbrella_test.v` files in the front door and its pinned checkouts" [$count $paths]],
      "",
      "| umbrella (path in its repository) | repository |",
      "|---|---|",
      [$strings:join $body "\n"]) "\n"]]]
