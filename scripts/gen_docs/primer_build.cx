# scripts/gen_docs/primer_build.cx — the LLM onboarding layer generator (#938).
#
# Emits docs/llm/ from docs-src/llm/ templates:
#
#   primer.md          the single ~10-15k-token primer (the one file to load)
#   reference-*.md     thin per-area references, loaded on demand
#   llms.txt           the llmstxt.org index (site root after publish)
#   llms-full.txt      primer + every reference, one concatenation
#
# ZERO hand-maintained example code. Every code block in every output comes
# from a conformance fixture, and every expected output is RE-RECORDED by
# running the shipped binary. A wrong example in an LLM primer is worse than
# no example — it poisons in-context learning — so drift here is structurally
# impossible rather than reviewed away.
#
# ── Template placeholders ────────────────────────────────────────────────
#
#   {{VERSION}}                 the repo-root VERSION contents
#   {{EXAMPLE:<id> block}}      the whole worked example: input document (when
#                               the fixture has one), program, the exact
#                               `$ cx …` invocation, and the LIVE output
#   {{EXAMPLE:<id> code}}       the program, fenced
#   {{EXAMPLE:<id> data}}       the input document, fenced
#   {{EXAMPLE:<id> out}}        the LIVE output, fenced as a console block
#   {{EXAMPLE:<id> raw-out}}    the LIVE output, unfenced (for tables)
#   {{EXAMPLE:<id> cmd}}        the invocation line, unfenced
#   {{EXAMPLE:<id> cite}}       the case id alone, as inline code — for a claim
#                               in prose that names its fixture (RULED: RS-30):
#                               the case is replayed and verified like any other
#   {{PAIR:<wrong-id> <right-id>}}   one anti-pattern entry: heading, the
#                               `[why]` prose, then both halves as blocks
#   {{TLDR}}                    the one lead of why to reach for CX, from
#                               docs-src/site/tldr.cxd: its lead, its standard,
#                               one bullet per clause citing the case the page
#                               replays for it (RULED: DOCS-49)
#   {{DIRECTIVES}}              the NORMATIVE directive registry, projected
#                               from the spec's own §4.1 table (name +
#                               category; § references deliberately dropped)
#   {{MODULES:stdlib}}          markdown table rows for one BUNDLED NAMESPACE
#   {{MODULES:platform}}        (`cx-<name>`), its population read from
#   {{MODULES:x}}               registry/modules.cxd and its prose projected
#                               from each module's own [module-doc]
#   {{CXHELP}}                  the binary's own `--help`, captured live
#   {{REPOS}} {{PINS}}          the contributor front door's FACTS (RULED: K11a),
#   {{MODULE-CENSUS}}           each projected by scripts/gen_docs/
#   {{MODULE-COLUMNS}}          contributor_facts.cx from the file that declares
#   {{STEPS}} {{RULINGS}}       it: registry/repos.cxd, deps.cxd,
#   {{UMBRELLAS}}               registry/modules.cxd, the Makefile's TEST_TARGETS,
#                               the ledger's RS-n rows and headings, the
#                               umbrella test files of the pinned checkouts
#
# The last three carry no example code and make no output claim; they are
# projections of the spec and the bundle, which is exactly why they must not
# be transcribed by hand into an LLM-facing document — an invented directive
# or a plausible-but-absent module name is the most expensive kind of error
# this layer can ship.
#
# `<id>` is a `[case id=…]` from one of the suites the manifest declares in
# its `[suites]` block. Declaring them keeps the index bounded (the corpus is
# ~1200 cases in code.cxd alone) and records the primer's provenance.
#
# ── The freshness contract ───────────────────────────────────────────────
#
# For EVERY referenced case the generator executes the fixture and requires
#
#   live stdout-else-stderr == the fixture's [out-text] / [out-err]
#
# and, where the fixture declares one, live exit code == [exit-code]. A
# mismatch is a HARD FAILURE naming the case — never a silently re-recorded
# output. That is what makes the primer's examples trustworthy: the shipped
# binary agreed with the corpus at generation time.
#
# `--check` additionally requires the regenerated bytes to equal what is
# committed under docs/llm/, and writes nothing. That is the drift gate
# (`make docs-check`, in TEST_TARGETS, with a tools/release-verify.sh row):
# a primer example whose output moved without its fixture moving is red.
#
# Run:
#   cx --allow-read --allow-write --allow-subprocess --allow-env \
#      scripts/gen_docs/primer_build.cx [--check]
#   (or: make docs / make docs-check)
#
# Exit: 0 green; 1 any failure (missing case, output mismatch, drift).

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/map'     as=map]
[?lib 'cx-stdlib/array'   as=array]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/math'    as=math]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/re'      as=re]
[; The per-repository documentation fragments (RULED: RS-9) and the pin
   document that says which repositories to look in (RULED: RS-7). Both are
   spelled from the CHECKOUT ROOT — see #1604. ]
[?lib './scripts/docs_fragment.cx' as=frag]
[?lib './scripts/deps_pins.cx'     as=pins]
[; The contributor front door's generated fragments (RULED: K11a): the
   repository map, the pins, the module census, the step roster and the
   ledger's RS-n statements, projected from the files that declare them. ]
[?lib './scripts/gen_docs/contributor_facts.cx' as=facts]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]

[?def die scope=public impure ($s)
  [?let [= $_e [$cry [$concat "primer_build: " $s]]] [$env:exit 1]]]

# ── fixture plumbing (the check_code_fixtures.cx idiom) ──────────────────

# raw-of: the string payload of a section node carrying [#…#] raw blocks.
# RawText is opaque to [$text]; the serialization is the defined byte-exact
# projection, so serialize, take what lies between the first opener and the
# last terminator, and join the blocks. A payload that must itself carry a
# raw block's terminator is written in the corpus as two adjacent blocks
# split inside it (`…##][#]…`, the idiom of core.cxd 012-rawtext and
# fmt.cxd's header), and the serializer separates adjacent blocks with one
# space, so every `#] [#` between the outer delimiters is a junction of two
# blocks and never payload — a payload cannot hold `#]` (RULED: DOCSOK-1).
[?def raw-of scope=public ($rt)
  [?let [= $s [$cx:serialize $rt]]
        [= $i [$strings:find $s "[#"]]
        [= $j [$strings:rfind $s "#]"]]
    [?if [or [not [$present $i]] [not [$present $j]] [< $j $i]]
      [then ""]
      [else [$strings:replace [$strings:slice $s [+ $i 2] [- $j 1]] "#] [#" ""]]]]]

# normalize: the fixture-loader rule — strip ONE leading and ONE trailing
# newline (the [# ⏎ … ⏎ #] layout newlines), then any inline padding.
[?def normalize scope=public ($raw)
  [?let [= $a [?if [$starts-with $raw "\n"]
                [then [$strings:slice $raw 2 [$strings:length $raw]]] [else $raw]]]
        [; #1177: strip exactly ONE trailing newline. The end is
           length-derived, NOT find-sourced, so it does not move: the
           1-based inclusive range 1..len-1 covers the same text the
           0-based half-open range 0..len-1 did.

           The migration decremented it because $a is ALSO the name of a
           find result further down this file, and the tool's
           find-sourced set is per-FILE and name-based. It dropped two
           characters instead of one, which truncated every declared
           suite name — stdlib/validate became stdlib/validat — and the
           docs build failed on the missing file. ]
        [= $b [?if [$ends-with $a "\n"]
                [then [$strings:slice $a 1 [- [$strings:length $a] 1]]] [else $a]]]
    [?if [$strings:contains $b "\n"] [then $b] [else [$strings:trim $b]]]]]

# The primer's PLATFORM chapter is itself GENERATED — projected from
# composition.md §1-§3 and deployment-topology.md §1-§4 by
# scripts/gen_docs/primer_platform.cx (RULED: COMP-1). It reaches the primer
# as an ordinary placeholder, so this generator neither knows nor restates
# what is in it; `make primer-platform-check` is what holds the chapter to
# those two pages, and this file's own drift gate then holds the primer to the
# chapter.
[?const PLATFORM-CHAPTER-PATH "docs-src/llm/primer-platform.chapter.md"]

[?def member scope=public ($seq $x)
  [> [$count [?for [in $s $seq] [where [= $s $x]] [yield $s]]] 0]]

# cat-seqs: concatenate a tuple of sequences (sequence literals nest;
# flat-map with identity removes exactly one level).
[?def cat-seqs scope=public ($ss) [$fp:flat-map $ss [?fn ($x) $x]]]

# sections-of: one [case] element → map of section-name → normalized payload.
[?def sections-of scope=public ($c)
  [$fp:fold [?for [in $k $c/*]
      [where [not [= [?else [$name $k] ""] "tags"]]]
      [yield $k]] {}
    [?fn ($acc $k)
      [$map:put $acc [?else [$name $k] ""] [$normalize [$raw-of $k]]]]]]

# load-suite: one conformance suite path → map of case-id → section map.
# Each entry carries `suite` (provenance, printed under every rendered
# example) and `grant` (the case's own `grant=` attribute, which some suites
# use to declare the capability their program needs).
[?def load-suite scope=public impure ($path)
  [?let [= $doc [$cx:parse [$io:read-file $path]]]
    [$fp:fold [?for [in $c $doc/*]
        [where [= [?else [$name $c] ""] "case"]]
        [yield $c]] {}
      [?fn ($acc $c)
        [$map:put $acc [$string [?else $c@id ""]]
          [$map:put [$map:put [$sections-of $c] "suite" $path]
                    "grant" [$string [?else $c@grant ""]]]]]]]]

# load-index: the declared suites → one flat case index. Ids are flat ACROSS
# suites (the placeholder syntax names an id, not a suite/id pair), so a
# collision would silently make one suite shadow another — it is a hard
# failure instead, naming both files.
#
# A suite whose module has left for its own repository is declared by its
# PINNED path, `deps/<repo>/conformance/<ring>/<name>` (RULED: RS-7, RS-12):
# the corpus is the pinned repository's at the pinned sha, the same checkout
# the build embeds the module from, so the example and the binary that replays
# it cannot be from different versions. Until that repository publishes the
# docs fragment RS-9 describes, this is how its cases stay citable here.
[?def suite-path scope=private pure [returns string] ($s::string)
  [?if [$strings:starts-with $s "deps/"] [then [$concat $s ".cxd"]]
    [else [$concat "conformance/" $s ".cxd"]]]]

[?def load-index scope=public impure ($suites)
  [$fp:fold $suites {}
    [?fn ($acc $s)
      [?let [= $p [$suite-path $s]]
        [?if [not [$io:is-file $p]]
          [then [$die [$concat "declared suite not found: " $p]]]
          [else [?let
            [= $new [$load-suite $p]]
            [= $dupes [?for [in $k [$map:keys $new]]
                        [where [$map:contains $acc $k]]
                        [yield [$concat "    " $k " (also in "
                                        [$map:get [$map:get $acc $k] "suite"] ")"]]]]
            [?if [not [$empty $dupes]]
              [then [$die [$concat "duplicate case id(s) between declared suites — "
                                   $p " collides:\n" [$strings:join $dupes "\n"]]]]
              [else [$map:merge ($acc, $new)]]]]]]]]]]

# ── execution: replay one fixture against the shipped binary ────────────

# The friendly names the invocation line shows (never the temp paths).
[?const DATA-NAME "input.cx"]
[?const PROG-NAME "prog.cx"]
[?const XML-NAME  "input.xml"]

# argv-tokens: the fixture's [cli-argv] (one token per line), or the default
# run-surface invocation — flags first, resource last, always.
#
# Three defaults, one per fixture shape:
#   program + document   `cx --data=input.cx prog.cx`
#   program only         `cx prog.cx`
#   document only        `cx --from=cx --to=cx input.cx` — the Ring-0 data
#                        reading round-tripped through its own cx emitter,
#                        which is exactly what a data fixture's [out-cx]
#                        records. (Bare `cx input.cx` also evaluates a
#                        pure-data document to itself, and `cx canonical`
#                        emits the strict form — but neither is the projection
#                        the fixture pins, and citing a fixture against the
#                        wrong projection is how a primer starts lying.)
#   XML document only    `cx --from=xml --to=cx input.xml` — the XML lane of
#                        the same reading (conformance/xml.cxd fixtures carry
#                        [in-xml] rather than [in-cx]).
#
# A document-only case that records no [out-cx] (nor [out-text]/[out-err])
# pins another projection of the same reading, and is replayed by the
# projection it records (RULED: DOCSOK-1) — so an identity or a JSON case of
# cx-core-data is citable as it stands, graded by its own suite and replayed
# here against the same expectation:
#   [out-canonical]      `cx canonical input.cx` — the strict form
#                        (identity.cxd, canonical.md §2.8)
#   [out-json]           `cx --from=cx --to=json input.cx` — the JSON
#                        projection (atoms.cxd, conversions.cxd)
[?def data-projection scope=public ($sec)
  [?if [or [$map:contains $sec "out-cx"]
           [or [$map:contains $sec "out-text"] [$map:contains $sec "out-err"]]]
    [then ("--from=cx", "--to=cx", "%DATA%")]
    [else [?if [$map:contains $sec "out-canonical"]
      [then ("canonical", "%DATA%")]
      [else [?if [$map:contains $sec "out-json"]
        [then ("--from=cx", "--to=json", "%DATA%")]
        [else ("--from=cx", "--to=cx", "%DATA%")]]]]]]]

[?def argv-tokens scope=public ($sec)
  [?let [= $raw [?else [$map:get $sec "cli-argv"] ""]]
        [= $code [?else [$map:get $sec "in-code"] ""]]
        [= $xml [?else [$map:get $sec "in-xml"] ""]]
        [= $data [?if [and [= [?else [$map:get $sec "in-cx"] ""] ""]
                           [not [= $xml ""]]]
                   [then ""]
                   [else [?else [$map:get $sec "in-cx"] "[empty]"]]]]
    [?if [not [= $raw ""]]
      [then [?for [in $l [$strings:split-lines $raw]]
              [where [not [= [$strings:trim $l] ""]]]
              [yield [$strings:trim $l]]]]
      [else [?let
        # a case's own `grant=` attribute names the capabilities its program
        # needs; they become --allow-<cap> flags, BEFORE the resource.
        [= $grants [?for [in $g [$strings:split-whitespace
                                  [?else [$map:get $sec "grant"] ""]]]
                     [yield [$concat "--allow-" $g]]]]
        [= $tail [?if [not [= $xml ""]]
                   [then ("--from=xml", "--to=cx", "%XML%")]
                   [else [?if [= $code ""]
                     [then [$data-projection $sec]]
                     [else [?if [= $data "[empty]"]
                             [then ("%FILE%",)]
                             [else ("--data=%DATA%", "%FILE%")]]]]]]]
        [$cat-seqs ($grants, $tail)]]]]]]

# resolve-token: one argv token with its placeholders bound. `$mode` is
# 'run' (real paths, for the subprocess) or 'show' (friendly names + shell
# quoting, for the invocation line the reader copies).
[?def resolve-token scope=public ($tok $mode $data-path $prog-path $xml-path $code)
  [?let [= $dp [?if [= $mode "run"] [then $data-path] [else DATA-NAME]]]
        [= $pp [?if [= $mode "run"] [then $prog-path] [else PROG-NAME]]]
        [= $xp [?if [= $mode "run"] [then $xml-path]  [else XML-NAME]]]
        [= $cd [?if [= $mode "run"] [then $code] [else [$concat "'" $code "'"]]]]
    [$strings:replace
      [$strings:replace
        [$strings:replace [$strings:replace $tok "%DATA%" $dp] "%FILE%" $pp]
        "%XML%" $xp]
      "%CODE%" $cd]]]

# replay: execute one case; returns [replay out=… rc=… cmd=…].
[?def replay scope=public impure ($cxbin $tmpdir $id $sec)
  [?let
    [= $data [?else [$map:get $sec "in-cx"] "[empty]"]]
    [= $code [?else [$map:get $sec "in-code"] ""]]
    [= $xml [?else [$map:get $sec "in-xml"] ""]]
    [= $data-path [$path:join $tmpdir [$concat $id ".data.cx"]]]
    [= $prog-path [$path:join $tmpdir [$concat $id ".prog.cx"]]]
    [= $xml-path  [$path:join $tmpdir [$concat $id ".data.xml"]]]
    [= $_w1 [$io:write-file $data-path [$concat $data "\n"]]]
    [= $_w2 [$io:write-file $prog-path [$concat $code "\n"]]]
    [= $_w3 [$io:write-file $xml-path  [$concat $xml "\n"]]]
    [= $toks [$argv-tokens $sec]]
    [= $argv [?for [in $t $toks]
               [yield [$resolve-token $t "run" $data-path $prog-path $xml-path $code]]]]
    [= $shown [?for [in $t $toks]
               [yield [$resolve-token $t "show" $data-path $prog-path $xml-path $code]]]]
    [= $r [$process:run [$cat-seqs (($cxbin,), $argv)]]]
    [= $so [$strings:trim-end-chars [$string $r@stdout] "\n"]]
    [= $se [$strings:trim-end-chars [$string $r@stderr] "\n"]]
    [replay out=[?if [= [$strings:trim $so] ""] [then $se] [else $so]]
            rc=[$string $r@exit-code]
            cmd=[$concat "cx " [$strings:join $shown " "]]]]]

# expected-of: the fixture's recorded output, whichever section carries it.
#
# The conformance corpus's [out-err] deliberately records the ERROR CODE
# (cx-err:CXER0001), not the wording: the corpus pins semantics, so a message
# rewrite is not a conformance break. Holding such a fixture to byte-equality
# against a live diagnostic would hold it to a contract it never made, so a
# bare single-line `cx-err:` payload is matched by CONTAINMENT. Anything else
# -- including conformance/llm/antipatterns.cxd, whose whole point IS the
# wording the reader will see -- is byte-exact.
[?def err-mode scope=public ($e)
  [?if [and [not [$strings:contains $e "\n"]] [$strings:starts-with $e "cx-err:"]]
    [then 'contains'] [else 'exact']]]

[?def expected-of scope=public ($sec)
  [?match $sec
    [when [$map:contains $sec "out-text"]
      [exp text=[$map:get $sec "out-text"] mode='exact']]
    [when [$map:contains $sec "out-err"]
      [exp text=[$map:get $sec "out-err"] mode=[$err-mode [$map:get $sec "out-err"]]]]
    [when [$map:contains $sec "out-cx"]
      [exp text=[$map:get $sec "out-cx"] mode='exact']]
    [when [$map:contains $sec "out-canonical"]
      [exp text=[$map:get $sec "out-canonical"] mode='exact']]
    [when [$map:contains $sec "out-json"]
      [exp text=[$map:get $sec "out-json"] mode='exact']]
    [else [exp text="" mode='missing']]]]

# matches: the freshness predicate for one mode.
[?def matches scope=public ($mode $exp $got)
  [?match $mode
    [case 'exact'    [= $exp $got]]
    [case 'contains' [$strings:contains $got $exp]]
    [else false]]]

# verify: the freshness contract. Fails loud, naming the case.
[?def verify scope=public impure ($id $sec $rep)
  [?let [= $e [$expected-of $sec]]
        [= $exp [$string $e@text]]
        [= $mode [$string $e@mode]]
        [= $got [$string $rep@out]]
        [= $rc-exp [?else [$map:get $sec "exit-code"] ""]]
        [= $rc-got [$string $rep@rc]]
    [?match $mode
      [case 'missing'
        [$die [$concat "case '" $id "' records no [out-text]/[out-err]/[out-cx]/[out-canonical]/[out-json] -- "
                       "the primer can only cite fixtures with a recorded output"]]]
      [when [not [$matches $mode $exp $got]]
        [$die [$concat "EXAMPLE FRESHNESS: case '" $id "' -- the binary no longer "
                       "reproduces its fixture (" $mode ").\n  invocation: "
                       [$string $rep@cmd] "\n  fixture:    " $exp
                       "\n  live:       " $got
                       "\n  Fix the code or update the fixture, then re-run `make docs`."]]]
      [when [and [not [= $rc-exp ""]] [not [= $rc-exp $rc-got]]]
        [$die [$concat "EXAMPLE FRESHNESS: case '" $id "' exit code moved: fixture "
                       $rc-exp ", live " $rc-got]]]
      [else 0]]]]

# ── rendering ───────────────────────────────────────────────────────────

[?def fence scope=public ($lang $body)
  [$concat "```" $lang "\n" $body "\n```"]]

[?def render-code scope=public ($sec) [$fence "cx" [$map:get $sec "in-code"]]]
[?def render-data scope=public ($sec) [$fence "cx" [$map:get $sec "in-cx"]]]

[?def render-out scope=public ($rep)
  [$fence "console" [$concat "$ " [$string $rep@cmd] "\n" [$string $rep@out]]]]

# render-block: the whole worked example. Each half is shown only when the
# fixture has one — `[empty]` is the corpus's "no document" marker and
# printing it teaches a form nobody should copy; a data-only fixture has no
# program at all.
[?def render-block scope=public ($sec $rep)
  [?let [= $data [?else [$map:get $sec "in-cx"] "[empty]"]]
        [= $code [?else [$map:get $sec "in-code"] ""]]
        [= $xml [?else [$map:get $sec "in-xml"] ""]]
        [= $head [?if [= $data "[empty]"]
                   [then ""]
                   [else [$concat "`" DATA-NAME "`\n" [$render-data $sec] "\n\n"]]]]
        [= $xhead [?if [= $xml ""]
                    [then ""]
                    [else [$concat "`" XML-NAME "`\n" [$fence "xml" $xml] "\n\n"]]]]
        [= $prog [?if [= $code ""]
                   [then ""]
                   [else [$concat "`" PROG-NAME "`\n" [$render-code $sec] "\n\n"]]]]
    [$concat $xhead $head $prog [$render-out $rep]]]]

# render-pair: one anti-pattern entry — heading, the wrong half's [why]
# prose, then both halves side by side.
[?def render-pair scope=public ($wid $wsec $wrep $rid $rsec $rrep)
  [$strings:join (
    [$concat "#### " [?else [$map:get $wsec "title"] $wid]],
    "",
    [?else [$map:get $wsec "why"] ""],
    "",
    "**Do not write this:**",
    "",
    [$render-block $wsec $wrep],
    "",
    [$concat "**Write this:** " [?else [$map:get $rsec "title"] $rid]],
    "",
    [$render-block $rsec $rrep],
    "",
    [$concat "<sub>Fixtures: `" $wid "` / `" $rid "` in `"
             [$string [$map:get $wsec "suite"]] "`</sub>"]) "\n"]]

# ── generated catalogs (no example code; pure projections) ──────────────

# first-sentence: up to the first ". ", collapsed to one line.
[?def first-sentence scope=public ($s)
  [?let [= $flat [$strings:replace [$strings:trim $s] "\n" " "]]
        [= $i [$strings:find $flat ". "]]
    [?if [not [$present $i]] [then $flat] [else [$strings:slice $flat 1 [- [+ $i 1] 1]]]]]]

# module-rows: a markdown table body for ONE bundled namespace, projected from
# each module's own [module-doc][scope] prose. Generated — never a hand-kept
# list, so a new module appears here the moment it is bundled.
#
# The population comes from registry/modules.cxd, not from a directory glob
# (RULED: 1427-f). #1427-b split the bundled surface into `cx-stdlib` (Ring 1)
# and `cx-platform` (Ring 2) while BOTH rings' bundled sources still sit in
# stdlib/*.cx — so a glob over that directory would print sixteen Ring-2
# modules under an import line that no longer resolves, which is precisely
# the invented-module-name poison this projection exists to prevent. The
# registry is where a module's namespace is declared, so it is what is read.
[?def module-rows scope=public impure ($ns)
  [?let [= $reg [$cx:parse [$io:read-file "registry/modules.cxd"]]]
  [$strings:join [?for [in $m $reg//module]
    [= $f [$string [?else $m@source "none"]]]
    [where [= [$string [?else $m@ns "none"]] $ns]]
    [where [= [$string [?else $m@kind "module"]] "module"]]
    [where [= [$string [?else $m@status "current"]] "current"]]
    [where [not [= $f "none"]]]
    [= $txt [$io:read-file $f]]
    [= $i [$strings:find $txt "[module-doc"]]
    [where [$present $i]]
    [= $rest [$strings:slice $txt $i [$strings:length $txt]]]
    [= $a [$strings:find $rest '[scope """']]
    [where [$present $a]]
    [= $from [+ $a 10]]
    [= $tail [$strings:slice $rest $from [$strings:length $rest]]]
    [= $b [$strings:find $tail '"""']]
    [where [$present $b]]
    [yield [$concat "| `" [$string $m@name] "` | "
                    [$first-sentence [$strings:slice $tail 1 [- $b 1]]] " |"]]] "\n"]]]

# directive-rows: the NORMATIVE directive registry, projected from the spec's
# own §4.1 table. The primer must not carry a hand-kept directive list — a
# missing or invented directive is exactly the poison an LLM-facing document
# cannot afford — and it must not carry § numbers either (specs stay loosely
# coupled), so the reference column is dropped and only name + category ship.
[?const REGISTRY-SPEC "deps/cx-core-code/spec/03-approved/core/code.md"]
[?const REGISTRY-HEADING "### §4.1 Directive registry"]

[?def registry-row scope=public ($line)
  [?let [= $parts [$strings:split $line "|"]]
    [?if [< [$count $parts] 5]
      [then ""]
      [else [$concat "| " [$strings:trim [$nth $parts 2]]
                     " | " [$strings:trim [$nth $parts 4]] " |"]]]]]

[?def directive-rows scope=public impure ()
  [?let
    [= $lines [$strings:split-lines [$io:read-file REGISTRY-SPEC]]]
    [= $n [$count $lines]]
    [= $starts [?for [in $i [$range 1 $n]]
      [where [$strings:starts-with [$nth $lines $i] REGISTRY-HEADING]]
      [yield $i]]]
    [= $start [?if [$empty $starts]
                [then [$die [$concat REGISTRY-HEADING " not found in " REGISTRY-SPEC]]]
                [else [$first $starts]]]]
    [= $ends [?for [in $i [$range [+ $start 1] $n]]
      [where [$strings:starts-with [$nth $lines $i] "#"]]
      [yield $i]]]
    [= $end [?if [$empty $ends] [then $n] [else [$first $ends]]]]
    [= $rows [?for [in $i [$range [+ $start 1] [- $end 1]]]
      [= $r [$registry-row [$nth $lines $i]]]
      [where [$strings:starts-with $r "| `[?"]]
      [yield $r]]]
    [?if [< [$count $rows] 20]
      [then [$die [$concat "the §4.1 registry projection found only "
                           [$string [$count $rows]] " directives — the table shape "
                           "moved; fix directive-rows rather than shipping a "
                           "truncated registry"]]]
      [else [$strings:join $rows "\n"]]]]]

# cx-help: the binary's own `--help`, verbatim. Not an example — the tool's
# self-description, which is exactly why it must not be transcribed by hand.
[?def cx-help scope=public impure ($cxbin)
  [?let [= $r [$process:run ($cxbin, "--help")]]
    [$fence "console" [$concat "$ cx --help\n"
      [$strings:trim-end-chars [$string $r@stdout] "\n"]]]]]

# ── the contributor front door's facts (RULED: K11a) ────────────────────

# Each placeholder projects one file the tree already declares; the floor is
# the fewest body rows a projection may carry before it is refused as a
# truncated derivation (the directive-rows idiom: a table shape that moved
# must fail here, not ship a short table).
[?const FACT-KINDS ("REPOS", "PINS", "MODULE-CENSUS", "MODULE-COLUMNS", "STEPS", "RULINGS", "UMBRELLAS")]

[?def fact-floor scope=public pure [returns int] ($kind)
  [?match $kind
    [case "REPOS" 20] [case "PINS" 10] [case "MODULE-CENSUS" 10]
    [case "MODULE-COLUMNS" 8] [case "STEPS" 50] [case "RULINGS" 30] [case "UMBRELLAS" 10]
    [else 1]]]

# makefile-includes: the files the Makefile splices in (`-include <path>`),
# whose rules are as much a step's recipe as its own — EXCEPT flows/private.mk
# (RULED: PRIVMK-1). That include is the private orchestration's: the public
# tree has no such file, and the docs/llm/ layer is committed in both trees, so
# a roster read through it would project rows the public tree regenerates
# differently (cx main cb0b22a78's Site run: docs-check DRIFT). The roster is
# the public tree's, read with the include disabled, and the private steps
# never sit on the public `TEST_TARGETS :=` line (check-selection-manifest).
[?const PRIVATE-INCLUDE "flows/private.mk"]

[?def makefile-includes scope=public impure ($mk)
  [?for [in $l [$strings:split-lines $mk]]
    [where [or [$strings:starts-with $l "-include "] [$strings:starts-with $l "include "]]]
    [= $p [$strings:trim [$strings:slice $l [+ [$strings:find $l " "] 1] [$strings:length $l]]]]
    [where [not [= $p $PRIVATE-INCLUDE]]]
    [where [$io:is-file $p]]
    [yield [$io:read-file $p]]]]

[?def ledger-pages scope=public impure ()
  [?for [in $f [$io:glob "ledger/*.md"]]
    [where [not [= [$path:basename $f] "README.md"]]]
    [yield [page path=[$path:basename $f] text=[$io:read-file $f]]]]]

# umbrella-paths: the front door's own umbrellas, then each pinned checkout's, in
# deps.cxd order, each sorted -- a deterministic list for the drift gate.
[?def umbrella-paths scope=public impure ()
  [?let [= $own [$sort [$io:glob "vcx/tests/*_umbrella_test.v"]]]
        [= $repos [?if [$io:is-file "deps.cxd"]
                     [then [?for [in $r [$pins:rows [$pins:read [$io:read-file "deps.cxd"]]]] [yield [$string $r@repo]]]]
                     [else ()]]]
        [= $pinned [?for [in $r $repos]
                      [in $d ("vcx/tests", "vcx/code")]
                      [in $f [$sort [$io:glob [$concat "deps/" $r "/" $d "/*_umbrella_test.v"]]]]
                      [yield $f]]]
    [$cat-seqs ($own, $pinned)]]]

[?def fact-table scope=public impure ($kind)
  [?match $kind
    [case "REPOS" [$facts:repo-rows [$io:read-file "registry/repos.cxd"]]]
    [case "PINS" [$facts:pin-rows [$io:read-file "deps.cxd"]]]
    [case "MODULE-CENSUS" [$facts:module-census [$io:read-file "registry/modules.cxd"]]]
    [case "MODULE-COLUMNS" [$facts:module-columns [$io:read-file "registry/modules.cxd"]]]
    [case "STEPS" [?let [= $mk [$io:read-file "Makefile"]]
                        [= $flow [?if [$io:is-file "docs-src/flow/docs.flow.cx"]
                                   [then [$cx:parse [$io:read-file "docs-src/flow/docs.flow.cx"]]]
                                   [else ()]]]
                    [$facts:step-rows $mk [$makefile-includes $mk] $flow]]]
    [case "RULINGS" [$facts:ruling-rows [$ledger-pages]]]
    [case "UMBRELLAS" [$facts:umbrella-rows [$umbrella-paths]]]
    [else [$die [$concat "unknown fact placeholder " $kind]]]]]

[?def fact-fragment scope=public impure ($kind)
  [?let [= $t [$fact-table $kind]]
        [= $n [$facts:row-count $t]]
    [?if [< $n [$fact-floor $kind]]
      [then [$die [$concat "{{" $kind "}} projected only " [$string $n] " rows (floor "
                           [$string [$fact-floor $kind]] ") — the source's shape moved; fix "
                           "scripts/gen_docs/contributor_facts.cx rather than shipping a short table"]]]
      [else [?if [$strings:contains $t "MISSING-FROM-LEDGER"]
        [then [$die [$concat "{{" $kind "}}: an RS id a ledger heading names has no "
                             "statement the reader found — record it in a shape the reader takes:\n"
                             [$strings:join [?for [in $l [$strings:split-lines $t]]
                                              [where [$strings:contains $l "MISSING-FROM-LEDGER"]]
                                              [yield [$concat "  " $l]]] "\n"]]]]
        [else $t]]]]]]
# ── the one lead (RULED: DOCS-49; the design's voice rule 2) ───────────
#
# docs-src/site/tldr.cxd is the one place the lead of why to reach for CX is
# written: a [lead] paragraph, the [standard] we hold ourselves to, and one
# [clause fixture=<id>] per term of it. It is projected here into Markdown
# (`{{TLDR}}` in the primer's §0 and in the landing page's source) and into
# HTML (the guide home, through tldr-html), and every clause's fixture is
# replayed by the page that shows it — refs-of-directive below counts them
# as citations — so the three pages that open with the lead carry one text
# and one set of verified cases.
[?const TLDR-PATH "docs-src/site/tldr.cxd"]

[?def tldr-doc scope=public impure () [$cx:parse [$io:read-file TLDR-PATH]]]

[?def tldr-part scope=public impure ($what)
  [$strings:join [?for [in $k [$tldr-doc]/*] [where [= [?else [$name $k] ""] $what]]
                   [yield [$normalize [$raw-of $k]]]] ""]]

[?def tldr-clauses scope=public impure ()
  [?for [in $k [$tldr-doc]/*] [where [= [?else [$name $k] ""] "clause"]]
    [yield [clause fixture=[$string $k@fixture] text=[$normalize [$raw-of $k]]]]]]

[?def tldr-ids scope=public impure ()
  [?for [in $c [$tldr-clauses]] [yield [$string $c@fixture]]]]

# tldr-md: the lead, the standard, then one bullet per clause citing its case.
[?def tldr-md scope=public impure ()
  [$strings:join (
    [$tldr-part "lead"],
    "",
    [$tldr-part "standard"],
    "",
    [?let [= $cs [$tldr-clauses]] [= $n [$count $cs]]
      [$strings:join [?for [in $i [$range 1 $n]] [= $c [$nth $cs $i]]
        [yield [$concat "- " [$string $c@text] " — `" [$string $c@fixture] "`"
                        [?if [= $i $n] [then "."] [else ";"]]]]] "\n"]]) "\n"]]

# tldr-html: the same text as HTML — the two inline forms the source uses,
# **bold** and `code`, rendered and nothing else.
[?def tldr-inline scope=public impure ($s)
  [$re:replace [$re:compile "`([^`]+)`"]
    [$re:replace [$re:compile "\\*\\*([^*]+)\\*\\*"]
      [$strings:replace [$strings:replace [$strings:replace $s "&" "&amp;"] "<" "&lt;"] ">" "&gt;"]
      "<b>$1</b>"]
    "<code>$1</code>"]]

[?def tldr-html scope=public impure ()
  [$strings:join (
    [$concat "<p class=\"lede\">" [$tldr-inline [$tldr-part "lead"]] "</p>"],
    [$concat "<p>" [$tldr-inline [$tldr-part "standard"]] "</p>"],
    "<ul class=\"tldr\">",
    [$strings:join [?for [in $c [$tldr-clauses]]
      [yield [$concat "<li>" [$tldr-inline [$string $c@text]] " — <code>" [$string $c@fixture] "</code></li>"]]] "\n"],
    "</ul>") "\n"]]

# ── placeholder expansion ───────────────────────────────────────────────

# lookup: the case's section map, or a hard failure naming the template.
[?def lookup scope=public impure ($index $id $where)
  [?if [$map:contains $index $id]
    [then [$map:get $index $id]]
    [else [$die [$concat "unknown fixture id '" $id "' referenced by " $where
                         " — add the case to a conformance suite and declare "
                         "the suite in docs-src/llm/manifest.cxd"]]]]]

# render-field: `{{EXAMPLE:<id> <field>}}` — which projection of the case.
[?def render-field scope=public impure ($field $sec $rep $where)
  [?match $field
    [case 'block'   [$render-block $sec $rep]]
    [case 'code'    [$render-code $sec]]
    [case 'data'    [$render-data $sec]]
    [case 'out'     [$render-out $rep]]
    [case 'raw-out' [$string $rep@out]]
    [case 'cmd'     [$string $rep@cmd]]
    [else [$die [$concat "unknown EXAMPLE field '" $field "' in " $where]]]]]

# expand-example / expand-pair: the two fixture-citing directives.
[?def expand-example scope=public impure ($parts $index $replays $where)
  [?let [= $id [$strings:slice [$first $parts] 9 [$strings:length [$first $parts]]]]
        [= $field [?if [>= [$count $parts] 2] [then [$nth $parts 2]] [else 'block']]]
        [= $sec [$lookup $index $id $where]]
    [?if [= $field 'cite'] [then [$concat "`" $id "`"]]
      [else [$render-field $field $sec [$map:get $replays $id] $where]]]]]

[?def expand-pair scope=public impure ($parts $index $replays $where)
  [?let [= $wid [$strings:slice [$first $parts] 6 [$strings:length [$first $parts]]]]
        [= $rid [?if [>= [$count $parts] 2] [then [$nth $parts 2]]
                  [else [$die [$concat "PAIR needs two ids in " $where]]]]]
    [$render-pair $wid [$lookup $index $wid $where] [$map:get $replays $wid]
                  $rid [$lookup $index $rid $where] [$map:get $replays $rid]]]]

# expand-one: the text a single `{{…}}` directive expands to. Flat arms —
# every placeholder form is visible in one screen.
[?def expand-one scope=public impure ($body $index $replays $version $cxbin $where)
  [?let [= $parts [$strings:split-whitespace $body]]
        [= $kind [?if [$empty $parts] [then ""] [else [$first $parts]]]]
    [?match $kind
      [when [= $kind "VERSION"] $version]
      [when [= $kind "TLDR"] [$tldr-md]]
      [when [= $kind "PLATFORM-CHAPTER"] [$io:read-file PLATFORM-CHAPTER-PATH]]
      [when [= $kind "CXHELP"]  [$cx-help $cxbin]]
      [when [= $kind "DIRECTIVES"] [$directive-rows]]
      [when [$member FACT-KINDS $kind] [$fact-fragment $kind]]
      [when [$strings:starts-with $kind "MODULES:"]
        [$module-rows [$concat "cx-" [$strings:slice $kind 9 [$strings:length $kind]]]]]
      [when [$strings:starts-with $kind "REPOS:"]
        [?let [= $group [$strings:slice $kind 7 [$strings:length $kind]]]
              [= $names [$facts:repo-names [$io:read-file "registry/repos.cxd"] $group]]
          [?if [= $names ""]
            [then [$die [$concat "no shipped repository in group '" $group "' for " $where]]]
            [else $names]]]]
      [when [$strings:starts-with $kind "EXAMPLE:"]
        [$expand-example $parts $index $replays $where]]
      [when [$strings:starts-with $kind "PAIR:"]
        [$expand-pair $parts $index $replays $where]]
      [else [$die [$concat "unknown placeholder '" $body "' in " $where]]]]]]

# expand: the whole template. Split on the opening delimiter; every chunk
# after the first opens with a directive that must close before any literal
# text resumes (an unclosed `{{` is a hard failure, never silent output).
[?def expand scope=public impure ($tmpl $index $replays $version $cxbin $where)
  [?let [= $chunks [$strings:split $tmpl "{{"]]
        [= $n [$count $chunks]]
    [$strings:join (
      [$first $chunks],
      [$strings:join [?for [in $i [$range 2 $n]]
        [= $ch [$nth $chunks $i]]
        [= $j [$strings:find $ch "}}"]]
        [yield [?if [not [$present $j]]
          [then [$die [$concat "unclosed '{{' in " $where]]]
          [else [$concat
            [$expand-one [$strings:slice $ch 1 [- $j 1]] $index $replays $version $cxbin $where]
            [$strings:slice $ch [+ $j 2] [$strings:length $ch]]]]]]] ""]) ""]]]

# refs-of-directive: the fixture ids ONE `{{…}}` body cites. `EXAMPLE:` cites
# its own id and nothing else (the second word is a field name, not an id);
# `PAIR:` cites both halves; `TLDR` cites every clause's fixture. Anything
# else cites nothing.
[?def refs-of-directive scope=public impure ($body)
  [?let [= $parts [$strings:split-whitespace $body]]
        [= $kind [?if [$empty $parts] [then ""] [else [$first $parts]]]]
    [?if [$strings:starts-with $kind "EXAMPLE:"]
      [then ([$strings:slice $kind 9 [$strings:length $kind]],)]
      [else [?if [= $kind "TLDR"]
      [then [$tldr-ids]]
      [else [?if [$strings:starts-with $kind "PAIR:"]
        [then [?if [>= [$count $parts] 2]
                [then ([$strings:slice $kind 6 [$strings:length $kind]],
                       [$nth $parts 2])]
                [else ([$strings:slice $kind 6 [$strings:length $kind]],)]]]
        [else ()]]]]]]]]

# refs-in: every fixture id a template cites (so only those get replayed).
[?def refs-in scope=public impure ($tmpl)
  [?let [= $chunks [$strings:split $tmpl "{{"]]
        [= $n [$count $chunks]]
    [?for [in $i [$range 2 $n]]
      [= $ch [$nth $chunks $i]]
      [= $j [$strings:find $ch "}}"]]
      [where [$present $j]]
      [in $id [$refs-of-directive [$strings:slice $ch 1 [- $j 1]]]]
      [yield $id]]]]

# ── the llmstxt.org index ───────────────────────────────────────────────

# one-line: llms.txt is a LINE-ORIENTED index — one entry per line, the
# description after the colon. The manifest's prose is wrapped for humans
# reading the manifest, so it is reflowed here rather than requiring authors to
# write single 200-column lines.
[?def one-line scope=public ($s)
  [$strings:trim [$strings:replace [$strings:replace $s "\n" " "] "  " " "]]]

# entry-line: one llms.txt row.
[?def entry-line scope=public ($base $d)
  [$concat "- [" [$string $d@title] "](" $base [$string $d@out] "): "
           [$one-line [$string $d@summary]]]]

# section-block: one `## Heading` plus every entry whose `section=` names it,
# in manifest order. A heading with no entries emits nothing, so retiring the
# last document of a section does not leave an empty heading behind.
[?def section-block scope=public ($base $docs $key $heading)
  [?let [= $rows [?for [in $d $docs]
                   [where [= [$string $d@section] $key]]
                   [yield [$entry-line $base $d]]]]
    [?if [$empty $rows]
      [then ""]
      [else [$concat "## " $heading "\n\n" [$strings:join $rows "\n"] "\n"]]]]]

# The section vocabulary is CLOSED — an [output] naming a section not in this
# list is a hard failure rather than a document that silently vanishes from
# the index (the index IS the discovery surface; a file missing from it is
# a file nobody loads).
[?const SECTION-KEYS ("start", "build", "contribute", "reference")]

[?def check-sections scope=public impure ($docs)
  [?let [= $bad [?for [in $d $docs]
                  [where [not [$member SECTION-KEYS [$string $d@section]]]]
                  [yield [$concat "    " [$string $d@id] " -> section='"
                                  [$string $d@section] "'"]]]]
    [?if [$empty $bad]
      [then 0]
      [else [$die [$concat "unknown section= on [output] entr(ies); the "
                           "llms.txt index has no heading to file them under:\n"
                           [$strings:join $bad "\n"]
                           "\n  valid: " [$strings:join SECTION-KEYS " "]]]]]]]

[?def render-llms-txt scope=public ($version $base $root $tagline $docs)
  [$strings:join (
    [$concat "# CX " $version],
    "",
    [$concat "> " [$one-line $tagline]],
    "",
    [$concat "Generated from the CX conformance corpus at the v" $version
             " cut by scripts/gen_docs/primer_build.cx. Every code example in "
             "every file below is a conformance fixture whose output was "
             "re-recorded from the v" $version " binary."],
    "",
    [$section-block $base $docs "start" "Start here"],
    [$section-block $base $docs "build" "Building something"],
    [$section-block $base $docs "contribute" "Contributing to CX"],
    [$section-block $base $docs "reference" "Reference"],
    "## Optional",
    "",
    [$concat "- [Everything above, concatenated](" $root "llms-full.txt): "
             "one fetch, the whole layer."],
    "") "\n"]]

# ── main ────────────────────────────────────────────────────────────────

[?const SRC-DIR "docs-src/llm"]
[?const OUT-DIR "docs/llm"]

# The three fold steps, each named so its body stays one shallow expression.
# A docref carries EITHER a `template`, which this generator renders against
# the conformance corpus, OR a `file`, which is a document another repository
# already rendered at its own release and published in its fragment (RS-9).
# `cx` copies a published document; it does not run another repository's
# generator, and a fragment carrying a `template=` is refused by
# scripts/docs_fragment.cx before it reaches here.
[?def published scope=public [returns bool] ($d) [not [= [$string [?else $d@file ""]] ""]]]

[?def add-source scope=public impure ($acc $d)
  [?let [= $p [?if [$published $d]
                [then [$string $d@file]]
                [else [$path:join SRC-DIR [$string $d@template]]]]]
    [?if [not [$io:is-file $p]]
      [then [$die [?if [$published $d]
                    [then [$concat "the fragment of " [$string $d@repo]
                                   " declares " [$string $d@out] " and " $p " is not there"]]
                    [else [$concat "template not found: " $p]]]]]
      [else [$map:put $acc [$string $d@id] [$io:read-file $p]]]]]]

[?def add-replay scope=public impure ($acc $id $index $cxbin $tmpdir)
  [?let [= $sec [$lookup $index $id "a template"]]
        [= $rep [$replay $cxbin $tmpdir $id $sec]]
        [= $_v [$verify $id $sec $rep]]
    [$map:put $acc $id $rep]]]

[?def add-body scope=public impure ($acc $d $sources $index $replays $version $cxbin)
  [?let [= $id [$string $d@id]]
    [?if [$published $d]
      [; A published document's bytes are what the producing repository's gate
         rendered from ITS corpus at ITS release. Expanding them here would be
         this repository rendering another's documents against a corpus it does
         not have — "the docs of exactly the module versions it compiles in"
         means these bytes, unchanged. ]
      [then [$map:put $acc $id [$map:get $sources $id]]]
      [else [$map:put $acc $id
              [$expand [$map:get $sources $id] $index $replays $version $cxbin
                       [$concat SRC-DIR "/" [$string $d@template]]]]]]]]

[?def total-chars scope=public ($docs $bodies)
  [$fp:fold $docs 0
    [?fn ($a $d) [+ $a [$strings:length [$map:get $bodies [$string $d@id]]]]]]]

# declared-outputs: every basename `make docs` is responsible for — one per
# [output] entry, plus the two llmstxt.org files the generator always emits.
[?def declared-outputs scope=public ($docs)
  [$cat-seqs (([?for [in $d $docs] [yield [$string $d@out]]]),
              ("llms.txt", "llms-full.txt"))]]

# orphans: files under OUT-DIR that no manifest entry claims.
#
# The freshness contract above covers every document the manifest DECLARES.
# It cannot see one it does not know about — and a retired or renamed output
# leaves exactly that: a file still committed, still served from the site,
# still linked from wherever it was linked, and never
# again regenerated or drift-checked. That is a stale primer with the gate
# green, which is the one failure this layer exists to make impossible. So
# the SET OF FILES is part of what the gate checks, not just their bytes.
#
# Retiring a document therefore means deleting the file in the same change
# that drops its [output] entry.
[?def orphans scope=public impure ($docs)
  [?let [= $decl [$declared-outputs $docs]]
    [?for [in $f [$io:glob [$concat OUT-DIR "/*"]]]
      [= $b [$path:basename $f]]
      [where [not [$member $decl $b]]]
      [yield [$concat "  ORPHAN: " $f " — present under " OUT-DIR
                      "/ but declared by no [output] entry in "
                      SRC-DIR "/manifest.cxd. Delete it, or declare it."]]]]]

[?def write-or-check scope=public impure ($check $path $body)
  [?if $check
    [then [?let [= $old [?if [$io:is-file $path] [then [$io:read-file $path]] [else "absent"]]]
      [?if [= $old $body]
        [then ""]
        [else [$concat "  DRIFT: " $path
                       [?if [= $old "absent"] [then " (not committed)"] [else ""]]]]]]]
    [else [?let [= $_w [$io:write-file $path $body]] ""]]]]

[?let
  [= $argv [$env:argv]]
  [= $check [$member $argv "--check"]]
  [= $cxbin [$env:var-or-default "CX_BIN" "deps/cx-core-code/vcx/target/cx"]]
  [= $version [$strings:trim [$io:read-file "VERSION"]]]
  [= $manifest [$cx:parse [$io:read-file [$path:join SRC-DIR "manifest.cxd"]]]]

  [= $base [$strings:join [?for [in $k $manifest/*]
      [where [= [?else [$name $k] ""] "site"]] [yield [$string $k@base]]] ""]]
  [= $root [$strings:join [?for [in $k $manifest/*]
      [where [= [?else [$name $k] ""] "site"]] [yield [$string $k@root]]] ""]]
  [= $tagline [$strings:join [?for [in $k $manifest/*]
      [where [= [?else [$name $k] ""] "tagline"]]
      [yield [$normalize [$raw-of $k]]]] ""]]
  [= $suites [$fp:flat-map [?for [in $k $manifest/*]
      [where [= [?else [$name $k] ""] "suites"]]
      [yield [?for [in $l [$strings:split-lines [$normalize [$raw-of $k]]]]
               [where [not [= [$strings:trim $l] ""]]]
               [yield [$strings:trim $l]]]]] [?fn ($x) $x]]]
  [= $own-docs [?for [in $k $manifest/*]
      [where [= [?else [$name $k] ""] "output"]]
      [yield [docref id=[$string $k@id] out=[$string $k@out]
                     template=[$string $k@template] title=[$string $k@title]
                     file="" repo=cx
                     section=[$string [?else $k@section 'reference']]
                     summary=[$strings:join [?for [in $s $k/*]
                       [where [= [?else [$name $s] ""] "summary"]]
                       [yield [$normalize [$raw-of $s]]]] ""]]]]]

  [; ── the union (RULED: RS-9) ───────────────────────────────────────────
     "The closed [output] list of docs-src/llm/manifest.cxd becomes the union
     of per-repository doc manifests." deps.cxd names the repositories this
     one pins; each may publish docs/llm/manifest-fragment.cxd beside the
     Markdown it rendered at its own release. A pinned repository with NO
     fragment is not an error — "nothing waits on the site", and the front
     door indexes what WAS published rather than demanding publication. A
     fragment that is there and does not conform is a hard failure, because a
     site that lists some of a repository's documents and not others is worse
     than one that lists none: the reader cannot tell which. ]
  [= $pinned [?if [$io:is-file "deps.cxd"]
               [then [?for [in $r [$pins:rows [$pins:read [$io:read-file "deps.cxd"]]]]
                       [yield [$string $r@repo]]]]
               [else ()]]]
  [= $collected [$frag:collect $pinned "deps"]]
  [= $refused [?for [in $r $collected/refused] [yield $r]]]
  [= $_f1 [?if [$empty $refused] [then 0]
            [else [$die [$concat "a pinned repository's documentation fragment does not conform:\n"
                          [$strings:join [?for [in $r $refused] [in $l $r/line]
                            [yield [$concat "  " [$string $r@repo] ": " [$string $l]]]] "\n"]]]]]]
  [= $frag-docs [?for [in $f $collected/found] [in $e $f/entry]
      [yield [docref id=[$string $e@id] out=[$string $e@out]
                     template="" title=[$string $e@title]
                     file=[$string $e@file] repo=[$string $e@repo]
                     section=[$string $e@section]
                     summary=[$string $e@summary]]]]]
  [= $frag-file-refusals [?for [in $f $collected/found] [in $e $f/entry]
                           [in $r [$frag:entry-refusals $e]] [yield $r]]]
  [= $_f2 [?if [$empty $frag-file-refusals] [then 0]
            [else [$die [$concat "a published document is not where its fragment says, or is not rendered:\n"
                          [$strings:join [?for [in $r $frag-file-refusals]
                            [yield [$concat "  " [$string $r@kind] " " [$string $r@id] ": " [$string $r@what]]]] "\n"]]]]]]
  [= $docs [$cat-seqs ($own-docs, $frag-docs)]]
  [= $collide [$frag:collisions
                [?for [in $d $docs] [yield [$string $d@id]]]
                [?for [in $d $docs] [yield [$string $d@out]]]]]
  [= $_f3 [?if [$frag:ok $collide] [then 0]
            [else [$die [$concat "the document union collides:\n"
                          [$strings:join [?for [in $l [$frag:render $collide]] [yield [$concat "  " $l]]] "\n"]]]]]]
  [; A fragment is read WHEN PRESENT: with no deps/ checkout, or no pinned
     repository publishing one, the union is the front door's own rows and the
     line says `none` rather than a count of zero that reads like a failure. ]
  [= $found-n [$count [?for [in $f $collected/found] [yield 1]]]]
  [= $_f4 [$say [$concat "primer_build: " [$string [$count $own-docs]] " own documents; fragments from the pins: "
                         [?if [= $found-n 0]
                           [then "none"]
                           [else [$concat [$string [$count $frag-docs]] " documents from "
                                          [$string $found-n] " of " [$string [$count $pinned]]
                                          " pinned repositories"]]]
                         " (RULED: RS-9)"]]]

  [= $_s1 [?if [$empty $docs] [then [$die "manifest declares no [output] entries"]] [else 0]]]
  [= $_s2 [$check-sections $docs]]
  [= $index [$load-index $suites]]

  # every template's text, read once
  [= $sources [$fp:fold $docs {} [?fn ($acc $d) [$add-source $acc $d]]]]

  # every cited fixture, replayed ONCE and verified against its fixture
  [= $refs [$distinct [$fp:flat-map [?for [in $d $docs]
      [yield [$refs-in [$map:get $sources [$string $d@id]]]]] [?fn ($x) $x]]]]
  [= $tmpdir [$path:join [$env:var-or-default "TMPDIR" "/tmp"] "cx-primer-build"]]
  [= $_md [$io:make-dirs $tmpdir]]
  [= $replays [$fp:fold $refs {}
    [?fn ($acc $id) [$add-replay $acc $id $index $cxbin $tmpdir]]]]

  # render + write (or diff)
  [= $_mo [?if $check [then 0] [else [$io:make-dirs OUT-DIR]]]]
  [= $bodies [$fp:fold $docs {}
    [?fn ($acc $d)
      [$add-body $acc $d $sources $index $replays $version $cxbin]]]]

  [= $drifts [?for [in $d $docs]
    [= $msg [$write-or-check $check [$path:join OUT-DIR [$string $d@out]]
                             [$map:get $bodies [$string $d@id]]]]
    [where [not [= $msg ""]]]
    [yield $msg]]]

  [= $llms [$render-llms-txt $version $base $root $tagline $docs]]
  [= $llms-full [$strings:join [?for [in $d $docs]
      [yield [$concat "<!-- " $base [$string $d@out] " -->\n\n"
                      [$map:get $bodies [$string $d@id]]]]] "\n\n"]]

  [= $d2 [$write-or-check $check [$path:join OUT-DIR "llms.txt"] $llms]]
  [= $d3 [$write-or-check $check [$path:join OUT-DIR "llms-full.txt"] $llms-full]]
  [= $orphaned [$orphans $docs]]
  [= $all-drifts [?for [in $m ($drifts, ($d2, $d3), $orphaned)] [in $x $m]
                   [where [not [= $x ""]]] [yield $x]]]

  [= $chars [$total-chars $docs $bodies]]
  [= $primer-chars [$strings:length [$map:get $bodies "primer"]]]

  [?if [not [$empty $all-drifts]]
    [then [?let
      [= $_h [$cry [$concat "docs-check: " OUT-DIR "/ does not match the manifest — "
                            [$string [$count $all-drifts]] " file(s). A DRIFT line means "
                            "the committed bytes differ from a fresh generation: run "
                            "`make docs` and commit the result. An ORPHAN line means a "
                            "file no [output] entry claims: delete it, or declare it."]]]
      [= $_b [$cry [$strings:join $all-drifts "\n"]]]
      [$env:exit 1]]]
    [else [?let
      [= $_o [$say [$concat "primer_build: " [$string [$count $docs]] " document(s), "
                            [$string [$count $refs]] " fixture(s) replayed green, "
                            "primer ~" [$string [$math:floor [/ $primer-chars 4]]] " tokens ("
                            [$string $primer-chars] " chars), layer "
                            [$string $chars] " chars"
                            [?if $check [then " — no drift"] [else [$concat " → " OUT-DIR "/"]]]]]]
      [$env:exit 0]]]]]
