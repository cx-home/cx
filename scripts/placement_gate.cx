# scripts/placement_gate.cx -- the PLACEMENT check (RULED: 1427-f, OL-15).
#
# Eat-our-own-dog-food: written entirely in CX; runs as `cx <file>`.
#
# OL-15 asks for one place where a surface's placement is STATED, and a check
# that refuses a tree where any artifact disagrees with it. The statement is
# registry/modules.cxd. This program is the check. It reads one other
# declaration and only for one fact: registry/repos.cxd's `vmodule=` column,
# which names the directories each split V product compiles from (RULED:
# RS-24) -- platform-group places as vcx/platform/ is (RS-1). Everything else below is a
# registry row compared against what is actually on disk.
#
# THE ONE THING TO UNDERSTAND. A row's path columns name where the artifact
# IS; a `<column>-to` names where a move PUTS it, and exists only while that
# move is still owed. So a dimension with NO `-to` is held to its ring on
# every run -- that is the live half -- and a dimension WITH one is held to
# the destination instead, plus the two refusals that keep the declaration
# from going stale: a `-to` equal to its column, and a `-to` naming a path
# that already exists. A finished move is therefore not expressible as a
# lingering `-to`, and the outstanding `-to` set IS the census of what the
# move still owes. The same contract governs `suite-ring=` (the corpus
# header's ring while it disagrees with the row). #1427's cutover is spent:
# no row carries one of these any more, and the census below reads zero on
# every dimension.
#
# NOT WRITTEN YET is the OTHER statement, and it is `status=planned`, not a
# `-to`: a planned row's columns name where its artifacts WILL be, and the
# check holds it to its ring and its directories but not to existence. The
# row is refused once every artifact is on disk, so a declaration written
# ahead of the code cannot outlive the code.
#
# What it refuses
#   [missing]        a `status=current` row whose declared artifact is not
#                    on disk
#   [stale planned]  a `status=planned` row whose artifacts are ALL on disk
#                    -- the writing is done; the row says `current` now
#   [corpus none]    a graded, non-planned kind with no corpus -- a surface
#                    nothing holds to its spec
#   [suite ring]     a corpus whose `ring=` header is neither the row's ring
#                    nor its declared `suite-ring=`
#   [stale]          a `-to` equal to its column, a `-to` that already
#                    exists, or a `suite-ring=` equal to the row's ring
#   [ring group]     a row whose own `ring=`, `group=` and `ns=` disagree
#                    (RULED: RS-1): the rings are 0 and 1 and a `ring=2` is
#                    refused by name; the one group this registry declares is
#                    `platform`; an `ns=cx-platform` row carries
#                    `group=platform` and an `ns=cx-stdlib` row carries none
#                    (`ns=none` takes either); `ns=cx-x`, the experimental
#                    tier, retired with no member left and is refused by
#                    name (RULED: RS-31, D63a). The same rule reads every `[catalog]` row
#   [code ring]      a code file outside its row's V directory, with no
#                    `code-to` declaring the move (Ring 0 and Ring 1 share
#                    vcx/code; the platform group is vcx/platform and, since
#                    RS-24, each product's vcx/<vmodule>/ -- registry/repos.cxd
#                    declares them; the one other declaration read here)
#   [half ring]      a declared half outside vcx/code, or declared by a row
#                    that is not in the platform group -- a half exists only
#                    to let a platform module keep a pure Ring-1 piece
#   [spec ring] / [corpus ring]
#                    an artifact under a directory that belongs to the other
#                    side of the rings/platform line, with no `-to` declaring
#                    the move (1427-c: the directory IS the placement)
#   [dest ring]      a destination -- a `-to`, or the column itself when the
#                    row declares no move -- under the other side's directory
#
# TWO RINGS, THEN GROUPS (RULED: RS-1). Ring 0 is the data format and Ring 1
# the language; they are the only rings. Everything above them is a GROUP,
# and the platform group is the one this registry carries: a `group=platform`
# row's ring is the ring of its highest verb (0 or 1), and the group is what
# says it may import the platform graph -- so its artifacts sit in the
# platform directories whatever its ring. A row's PLACE is therefore
# `platform` for a group=platform row and its ring otherwise, and every
# directory check below compares places. A corpus header's `ring=` is a
# DIFFERENT attribute -- the lane that grades the suite -- which RS-1 does not
# rename: a group=platform row's corpus grades in the platform lane, ring=2.
#   [orphan ...]     a spec, corpus or bundled source that no row and no
#                    `[move]` claims
#   [dep path]       a `repo=` row -- an EXTRACTED module (RULED: RS-7,
#                    RS-12) -- whose spec, corpus or source does not begin
#                    `deps/<repo>/`. The row still declares the surface the
#                    binary ships; what moved is where the artifacts are, and
#                    the pinned checkout is where they are. Without this the
#                    ring checks below would go vacuous the day a module
#                    leaves, because `place-of-dir` answers "" -- agrees with
#                    every ring -- for any path outside the ring-legible
#                    space, and `deps/…` is outside it
#   [integration map] a platform specification with no `Integration map`
#                    heading (RULED: COMP-1) -- the section that restates
#                    composition.md §2's rows for that module
#
# THE INTEGRATION-MAP RULE, and why it is here. Placement is where a surface
# sits; COMP-1's third deliverable is that a reader of any platform page can
# see, without leaving it, which modules meet it and what each of them is
# refused. That is a property of the page, checked the same way its directory
# is. The exempt page is the ring catalog
# spec/03-approved/platform/README.md: it indexes the modules and is not one,
# so it owes no map. composition.md and deployment-topology.md are catalog
# pages in registry/modules.cxd and are NOT exempt -- each already carries its
# own map, and the rule is what keeps that true.
#
# Exit: 0 clean, 1 placement drift, 2 the registry itself is unreadable.
#
# Run from the checkout root:
#   vcx/target/cx --allow-all scripts/placement_gate.cx [--self-test]
# (or: make placement-gate, which runs the self-test then the tree)

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/strings' as=strings]

# -- helpers ------------------------------------------------------------
# named: set membership over a sequence of strings.
[?def named scope=private pure [returns bool] ($set::[sequence string] $x::string)
  [> [$count [?for [in $s $set] [where [= $s $x]] [yield $s]]] 0]]

# words: an attribute holding one or more paths, split on whitespace, with
# the explicit `none` marker dropped. A registry row always spells the
# absence, so a missing attribute is itself drift.
[?def words scope=private pure [returns any] ($v::string)
  [?for [in $w [$strings:split-whitespace $v]]
    [where [not [= $w ""]]]
    [where [not [= $w "none"]]]
    [yield $w]]]

# place-of-dir: the place a path's DIRECTORY declares -- a ring ("1", or
# "01" for `vcx/code`, where 1427-d puts Ring 0 and Ring 1 both) or the
# platform group ("platform", RULED: RS-1) -- or "" when the path is outside
# the ring-legible space (spec/03-approved/core, xap/, x/, the top-level
# corpora -- none of which the stdlib/platform split touches).
# `$pdirs` is the V product modules registry/repos.cxd declares (`vmodule=`,
# RULED: RS-24): each `vcx/<vmodule>/` is a platform-group place exactly as
# vcx/platform/ is, so a platform row's code under a split product's
# directory is held to its place rather than falling into the "" answer
# that agrees with every place.
[?def place-of-dir scope=private pure [returns string] ($p::string $pdirs)
  [?if [$strings:starts-with $p "spec/03-approved/stdlib/"] [then "1"]
  [else [?if [$strings:starts-with $p "spec/03-approved/platform/"] [then "platform"]
  [else [?if [$strings:starts-with $p "conformance/stdlib/"] [then "1"]
  [else [?if [$strings:starts-with $p "conformance/platform/"] [then "platform"]
  [else [?if [$strings:starts-with $p "vcx/code/"] [then "01"]
  [else [?if [$strings:starts-with $p "vcx/platform/"] [then "platform"]
  [else [?if [> [$count [?for [in $d $pdirs] [where [$strings:starts-with $p [$concat "vcx/" $d "/"]]] [yield 1]]] 0] [then "platform"]
  [else ""]]]]]]]]]]]]]]]

# dep-prefix: the `deps/<repo>/` a `repo=` row's every path begins with.
[?def dep-prefix scope=private pure [returns string] ($repo::string)
  [?if [= $repo ""] [then ""] [else [$concat "deps/" $repo "/"]]]]

# in-repo: the path as the OWNING repository spells it -- the ring-legible
# path, with the pinned-checkout prefix taken off. A row with no `repo=` is
# its own owner and the path is already that. This is what every ring check
# reads, so an extracted module is held to its ring exactly as a tracked one
# is rather than sliding into `place-of-dir`'s "outside the split" answer.
[?def in-repo scope=private pure [returns string] ($p::string $repo::string)
  [?let [= $pre [$dep-prefix $repo]]
    [?if [= $pre ""] [then $p]
      [else [?if [$strings:starts-with $p $pre]
              [then [$strings:slice $p [+ [$strings:length $pre] 1] [$strings:length $p]]]
              [else $p]]]]]]

# in-repo-all: `in-repo` over a whitespace-joined column.
[?def in-repo-all scope=private pure [returns string] ($col::string $repo::string)
  [$strings:join [?for [in $f [$words $col]] [yield [$in-repo $f $repo]]] " "]]


# suite-ring-of: the `ring=` on a suite header, "" when the file is
# unreadable or carries none.
[?def suite-ring-of scope=private impure [returns string] ($p::string)
  [?if [$io:exists $p]
    [then [?let [= $t [$cx:parse [$io:read-file $p]]] [$string [?else $t@ring ""]]]]
    [else ""]]]

# member: is this string one of these? (the argv read)
[?def member scope=private pure [returns bool] ($x::string $xs::[sequence string])
  [> [$count [?for [in $y $xs] [where [= $y $x]] [yield 1]]] 0]]

# has-integration-map: does this page carry a HEADING whose text names the
# section? The heading is the check, not the words in a paragraph: a page that
# mentions an integration map in prose has not written one.
[?def has-integration-map scope=private pure [returns bool] ($text::string)
  [> [$count [?for [in $l [$strings:split-lines $text]]
               [where [$strings:starts-with $l "#"]]
               [where [$strings:contains $l "Integration map"]]
               [yield 1]]] 0]]

# -- the ring/group shape of one row (RULED: RS-1) ----------------------
# ring-shape: the refusals a row's own `ring=`, `group=` and `ns=` earn,
# joined with "; ", or "" when the triple is well formed (RULED: RS-1).
[?def ring-shape scope=private pure [returns string] ($ring::string $group::string $ns::string)
  [?let
    [= $r [?if [or [= $ring "0"] [= $ring "1"]] [then ""]
            [else [?if [= $ring "2"]
              [then "ring=2 left the vocabulary (RULED: RS-1) -- write ring=1 group=platform or ring=0/1"]
              [else [$concat "ring=" $ring " is not a ring -- the rings are 0 (data) and 1 (code) (RULED: RS-1)"]]]]]]
    [= $g [?if [or [= $group ""] [= $group "platform"]] [then ""]
            [else [$concat "group=" $group " is not a group this registry declares -- the one it carries is group=platform"]]]]
    [= $n [?if [and [= $ns "cx-platform"] [not [= $group "platform"]]]
            [then "ns=cx-platform is the platform group's namespace -- the row carries group=platform"]
            [else [?if [and [= $ns "cx-stdlib"] [not [= $group ""]]]
              [then [$concat "ns=cx-stdlib is the rings' own namespace -- a group=" $group " row is cx-platform"]]
              [else [?if [= $ns "cx-x"]
                [then "ns=cx-x was the experimental tier, retired with no member left (RULED: RS-31, D63a) -- a module is cx-stdlib or cx-platform"]
                [else ""]]]]]]]
    [$strings:join [?for [in $x ($r, $g, $n)] [where [not [= $x ""]]] [yield $x]] "; "]]]

# row-place: the directory family a row's artifacts must sit in -- what
# `place-dir-ok` compares a path's directory against. A group=platform row
# sits in the platform directories whatever its ring; any other row, in its
# ring's.
[?def row-place scope=private pure [returns string] ($ring::string $group::string)
  [?if [= $group "platform"] [then "platform"] [else $ring]]]

# place-dir-ok: does this path sit in a directory that agrees with `place`?
# A path outside the ring-legible space agrees with every place -- the split
# does not reach it, and pretending otherwise would refuse core/codec.md.
[?def place-dir-ok scope=private pure [returns bool] ($p::string $place::string $pdirs)
  [?let [= $d [$place-of-dir $p $pdirs]]
    [?if [= $d ""] [then true] [else [$strings:contains $d $place]]]]]

# suite-lane: the `ring=` a row's corpus HEADER must carry -- the lane that
# grades the suite, the corpus's own attribute, which RS-1 does not rename.
# A group=platform row's corpus grades in the platform lane (ring=2); any
# other row's, in its ring's.
[?def suite-lane scope=private pure [returns string] ($ring::string $group::string)
  [?if [= $group "platform"] [then "2"] [else $ring]]]

# -- the self-test (RULED: COMP-1, RS-12, RS-1) --------------------------
# One catch and one no-catch case for [integration map], and the same pair for
# the extracted-module prefix (RS-12) -- over strings: it touches no file, and
# the tree scan below does not run under `--self-test`.
[?if [$member "--self-test" [$env:argv]]
  [then
    [?let
      [= $catch  "# `cx-x` -- a module\n\n## §1. Scope\n\n## §2. Cross-references\n"]
      [= $clean  "# `cx-x` -- a module\n\n## §1. Scope\n\n## §2. Integration map -- what `x` owes each module, and what it refuses\n"]
      [= $f1 [?if [$has-integration-map $catch]
               [then "MISSED (should catch): a platform page whose headings carry no integration map"]
               [else ""]]]
      [= $f2 [?if [$has-integration-map $clean]
               [then ""]
               [else "FALSE POSITIVE: a page whose §2 heading IS the integration map"]]]
      # [dep path] and the ring read beneath it. The catch is the shape an
      # extraction actually produces by accident: the row gained `repo=` and
      # the path columns were left as they were, which would make the tree
      # look fine while the artifacts are nowhere.
      [= $f3 [?if [$strings:starts-with "spec/03-approved/platform/sso.md"
                    [$dep-prefix "cx-platform-sso"]]
               [then "MISSED (should catch): a repo= row whose spec column is still the old in-tree path"]
               [else ""]]]
      [= $f4 [?if [= [$in-repo "deps/cx-platform-sso/conformance/platform/sso.cxd" "cx-platform-sso"]
                     "conformance/platform/sso.cxd"]
               [then ""]
               [else "FALSE POSITIVE: a pinned-checkout path must read its ring from what follows deps/<repo>/"]]]
      [= $f5 [?if [= [$in-repo "conformance/platform/store.cxd" ""] "conformance/platform/store.cxd"]
               [then ""]
               [else "FALSE POSITIVE: a row with no repo= is its own owner and its path is untouched"]]]
      # RS-1: two rings, then groups. `ring=2` left the vocabulary and is
      # refused BY NAME; a cx-platform row carries group=platform; a
      # cx-stdlib row carries none; ns=none takes either; ns=cx-x (the retired
      # experimental tier) is refused by name;
      # take either; a group this registry does not declare is refused.
      [= $r1 [?if [$strings:contains [$ring-shape "2" "" "cx-platform"] "ring=2 left the vocabulary"]
               [then ""]
               [else "MISSED (should catch): a ring=2 row, refused by name -- ring=2 left the vocabulary"]]]
      [= $r2 [?if [= [$ring-shape "1" "platform" "cx-platform"] ""]
               [then ""]
               [else "FALSE POSITIVE: ring=1 group=platform ns=cx-platform is the platform row's shape"]]]
      [= $r3 [?if [= [$ring-shape "1" "" "cx-platform"] ""]
               [then "MISSED (should catch): an ns=cx-platform row with no group=platform"]
               [else ""]]]
      [= $r4 [?if [= [$ring-shape "1" "platform" "cx-stdlib"] ""]
               [then "MISSED (should catch): an ns=cx-stdlib row carrying group=platform -- cx-stdlib is the rings' own namespace"]
               [else ""]]]
      [; D63a (RULED: RS-31): the experimental tier retired with no member left, so
         an ns=cx-x row is refused by name, with or without the platform group. ]
      [= $r5 [?if [and [$strings:contains [$ring-shape "1" "platform" "cx-x"] "ns=cx-x"]
                       [$strings:contains [$ring-shape "1" "" "cx-x"] "ns=cx-x"]]
               [then ""]
               [else "MISSED (should catch): an ns=cx-x row -- the experimental tier retired (RULED: RS-31, D63a)"]]]
      [= $r6 [?if [= [$ring-shape "1" "dist" "none"] ""]
               [then "MISSED (should catch): a group this registry does not declare"]
               [else ""]]]
      [= $r7 [?if [= [$ring-shape "0" "platform" "cx-platform"] ""]
               [then ""]
               [else "FALSE POSITIVE: a group=platform row's ring is the ring of its highest verb, 0 or 1"]]]
      # the directories: a group=platform row sits in the platform
      # directories, whatever its ring; a row with no group sits in the rings'.
      [= $r8 [?if [$place-dir-ok "vcx/platform/stdlib_net.v" [$row-place "1" "platform"] ("platform")]
               [then ""]
               [else "FALSE POSITIVE: a ring=1 group=platform row's code is in vcx/platform/"]]]
      [= $r9 [?if [$place-dir-ok "vcx/platform/stdlib_net.v" [$row-place "1" ""] ("platform")]
               [then "MISSED (should catch): a ring=1 row with no group whose code is in vcx/platform/"]
               [else ""]]]
      [= $r10 [?if [$place-dir-ok "vcx/code/stdlib_json.v" [$row-place "1" "platform"] ("platform")]
                [then "MISSED (should catch): a group=platform row whose code= is in vcx/code/ (that is half=)"]
                [else ""]]]
      [= $r11 [?if [$place-dir-ok "spec/03-approved/platform/net.md" [$row-place "1" "platform"] ("platform")]
                [then ""]
                [else "FALSE POSITIVE: a group=platform row's spec is in spec/03-approved/platform/"]]]
      # the corpus header: its `ring=` is the corpus's own attribute -- the
      # lane that grades it -- and RS-1 does not rename it. A group=platform
      # row's corpus is graded in the platform lane, ring=2.
      [= $r12 [?if [and [= [$suite-lane "1" "platform"] "2"]
                        [and [= [$suite-lane "1" ""] "1"] [= [$suite-lane "0" ""] "0"]]]
                [then ""]
                [else "FALSE POSITIVE: a group=platform row's corpus header carries ring=2 (the platform lane); a row with no group, its ring"]]]
      # RS-24 read through RS-1: a split product's directory is a
      # platform-group place, and without the declaration it reads as nothing
      # -- the vacuity [code ring] must not have.
      [= $f6 [?if [= [$place-of-dir "vcx/cxnet/stdlib_net.v" ("cxnet", "platform")] "platform"]
               [then ""]
               [else "MISSED (should read the platform group): a code file under a declared product directory (vmodule=)"]]]
      [= $f7 [?if [= [$place-of-dir "vcx/cxnet/stdlib_net.v" ("platform")] ""]
               [then ""]
               [else "FALSE POSITIVE: an undeclared directory under vcx/ must not read as a place"]]]
      # a `[catalog]` row's own `repo=` (RS-7, RS-12), the same transport a
      # `[module]` row's `[dep path]` carries: the catch is a catalog whose
      # path is still the old in-tree spelling despite repo= being set; the
      # no-catch is a pinned catalog path reading its ring correctly once the
      # deps/<repo>/ prefix is stripped.
      [= $f8 [?if [$strings:starts-with "spec/03-approved/platform/file_surface.md"
                    [$dep-prefix "cx-platform-net"]]
               [then "MISSED (should catch): a catalog repo= row whose path column is still the old in-tree path"]
               [else ""]]]
      [= $f9 [?if [= [$in-repo "deps/cx-platform-net/spec/03-approved/platform/file_surface.md" "cx-platform-net"]
                     "spec/03-approved/platform/file_surface.md"]
               [then ""]
               [else "FALSE POSITIVE: a pinned catalog path must read its ring from what follows deps/<repo>/"]]]
      [= $failures [?for [in $x ($f1, $f2, $f3, $f4, $f5, $f6, $f7, $f8, $f9, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12)] [where [not [= $x ""]]] [yield $x]]]
      [?if [> [$count $failures] 0]
        [then
          [?let [= $_bad [$io:write-line [$env:stderr]
                  [$concat "placement-gate self-test FAILED -- "
                           [$strings:join $failures "; "]]]]
            [$env:exit 1]]]
        [else
          [?let [= $_ok [$io:write-line [$env:stdout]
                  "placement-gate self-test OK -- 1 catch + 1 no-catch case for [integration map], 1 catch + 2 no-catch cases for [dep path] and the ring read beneath deps/<repo>/ (RS-12), 1 catch + 1 no-catch case for a split product's directory reading as the platform group (RS-24), 1 catch + 1 no-catch case for a catalog row's own repo= (RS-12), and 7 catch + 5 no-catch cases for the two rings and the platform group (RS-1, RS-31), pass."]]
            [$env:exit 0]]]]]]
  [else ""]]

# -- the registry -------------------------------------------------------
[?let [= $reg-path "registry/modules.cxd"]
      [= $reg-ok [$io:exists $reg-path]]

  [?if [not $reg-ok]
    [then
      [?let [= $_m [$io:write-line [$env:stderr]
          "placement-gate: registry/modules.cxd is missing -- the placement declaration (RULED: 1427-f) is the input this check has no substitute for"]]
        [$env:exit 2]]]
    [else

[?let [= $reg [$cx:parse [$io:read-file $reg-path]]]
      [= $rows [?for [in $m $reg//module] [yield $m]]]
      # the V product directories (RULED: RS-24): platform-group places, like vcx/platform/ (RS-1).
      [= $pdirs [?if [$io:exists "registry/repos.cxd"]
                   [then [?for [in $x [$cx:parse [$io:read-file "registry/repos.cxd"]]//repo]
                           [where [not [= [$string [?else $x@vmodule ""]] ""]]]
                           [yield [$string $x@vmodule]]]]
                   [else ()]]]
      [= $moves [?for [in $m $reg//move] [yield $m]]]
      # the two ring catalogs (1427-a/g): a README is not a surface, so no
      # row can claim it, and a ring directory that lost its catalog would
      # otherwise be invisible here.
      [= $catalogs [?for [in $m $reg//catalog] [yield $m]]]

      # Every path any row or move claims, in either position -- the input to
      # the orphan sweeps. An artifact is claimed by where it is OR by where
      # it is going; both are statements about it.
      [= $claimed
        [$strings:split-whitespace
          [$strings:join
            [?for [in $m $rows]
              [= $c1 [$string [?else $m@spec ""]]]
              [= $c2 [$string [?else $m@spec-to ""]]]
              [= $c3 [$string [?else $m@corpus ""]]]
              [= $c4 [$string [?else $m@corpus-to ""]]]
              [= $c5 [$string [?else $m@source ""]]]
              [= $c6 [$string [?else $m@source-to ""]]]
              [yield [$concat $c1 " " $c2 " " $c3 " " $c4 " " $c5 " " $c6]]]
            " "]]]
      [= $moved
        [$strings:split-whitespace
          [$strings:join
            [?for [in $m $moves]
              [yield [$concat [$string [?else $m@from ""]] " " [$string [?else $m@to ""]]]]]
            " "]]]
      [= $catalogued
        [?for [in $m $catalogs] [yield [$string [?else $m@path ""]]]]]

      # -- per-row placement ------------------------------------------
      [= $row-lines
        [?for [in $m $rows]
          [= $name    [$string $m@name]]
          [= $ring    [$string $m@ring]]
          [= $group   [$string [?else $m@group ""]]]
          [= $ns      [$string [?else $m@ns "none"]]]
          [= $kind    [$string [?else $m@kind "module"]]]
          [= $status  [$string [?else $m@status "current"]]]
          [= $tag     [$concat $name " (" $ns ")"]]
          [= $place   [$row-place $ring $group]]
          [= $rg      [?if [= $group ""] [then [$concat "ring=" $ring]]
                        [else [$concat "ring=" $ring " group=" $group]]]]

          # the five artifact dimensions, each as (column, destination)
          [= $spec      [$string [?else $m@spec "none"]]]
          [= $spec-to   [$string [?else $m@spec-to ""]]]
          [= $corpus    [$string [?else $m@corpus "none"]]]
          [= $corpus-to [$string [?else $m@corpus-to ""]]]
          [= $source    [$string [?else $m@source "none"]]]
          [= $source-to [$string [?else $m@source-to ""]]]
          [= $code      [$string [?else $m@code "none"]]]
          [= $code-to   [$string [?else $m@code-to ""]]]
          [= $half      [$string [?else $m@half "none"]]]
          [= $suite-ring [$string [?else $m@suite-ring ""]]]
          [= $ns-to     [$string [?else $m@ns-to ""]]]
          # `repo=` -- the module is EXTRACTED (RULED: RS-7, RS-12): its
          # artifacts are tracked in that repository and reach this tree only
          # as the pinned checkout deps.cxd names. Three path columns then
          # begin `deps/<repo>/`, and the RING of each is read from what
          # follows, so the checks below mean the same thing they meant
          # before the module left.
          [= $repo      [$string [?else $m@repo ""]]]
          [= $spec-r    [$in-repo-all $spec   $repo]]
          [= $corpus-r  [$in-repo-all $corpus $repo]]

          # -- [dep path]: a `repo=` row's paths are the pinned checkout's.
          [= $v-dep-path
            [?if [= $repo ""] [then ""]
              [else
                [?let [= $pre [$dep-prefix $repo]]
                      [= $bad
                        [$strings:join
                          [?for [in $d ($spec, $corpus, $source)]
                            [in $f [$words $d]]
                            [where [not [$strings:starts-with $f $pre]]]
                            [yield $f]]
                          " "]]
                  [?if [= $bad ""] [then ""]
                    [else [$concat "  [dep path]       " $tag
                             "  -- repo=" $repo " says the artifacts are in that repository;"
                             " every path column then names the pinned checkout " $pre
                             ", and these do not: " $bad]]]]]]]

          # -- [stale planned]: a row written AHEAD of its artifacts says so
          #    with `status=planned`, and its columns name where they will
          #    be. The declaration is spent the moment every one of them is
          #    on disk -- at which point `planned` would be a second, silent
          #    statement that the code is not written, next to code that is.
          #    That is the drift this file exists to refuse, so the row is
          #    refused here and the commit that lands the artifacts flips it.
          #    ALL, not any: connector's spec and corpus landed first by
          #    design, and a row is only finished when nothing is left.
          [= $v-stale-planned
            [?if [not [= $status "planned"]] [then ""]
              [else
                [?let [= $decl
                        [?for [in $g ($spec, $corpus, $source, $code, $half)]
                          [yield [$strings:join [$words $g] " "]]]]
                      [= $files
                        [$strings:split-whitespace [$strings:join $decl " "]]]
                      [= $absent
                        [$count [?for [in $f $files]
                                  [where [not [$io:exists $f]]]
                                  [yield $f]]]]
                  [?if [and [> [$count $files] 0] [= $absent 0]]
                    [then [$concat "  [stale planned]  " $tag
                             "  -- every artifact this row declares is on disk;"
                             " the writing is done, so the row says status=current now"]]
                    [else ""]]]]]]

          # -- [corpus none]: a graded kind must name a corpus. A planned row
          #    is exempt: its corpus is one of the artifacts not written yet,
          #    and [stale planned] is what holds it to writing one.
          [= $graded
            [?if [= $kind "design"] [then false]
              [else [?if [= $kind "backend"] [then false]
                [else [?if [= $status "planned"] [then false] [else true]]]]]]]
          [= $v-corpus-none
            [?if $graded
              [then [?if [> [$count [$words $corpus]] 0] [then ""]
                [else [$concat "  [corpus none]    " $tag
                         "  -- a surface graded by nothing; every row names a corpus"]]]]
              [else ""]]]

          # -- [suite ring]: the corpus header against the row.
          [= $lane       [$suite-lane $ring $group]]
          [= $want-suite [?if [= $suite-ring ""] [then $lane] [else $suite-ring]]]
          [= $v-suite
            [$strings:join
              [?for [in $c [$words $corpus]]
                [= $sr [$suite-ring-of $c]]
                [where [not [= $sr ""]]]
                [where [not [= $sr $want-suite]]]
                [yield [$concat "  [suite ring]     " $tag "  -- " $c
                         " carries ring=" $sr ", the row (" $rg ") grades it in lane ring=" $want-suite]]]
              "\n"]]
          [= $v-stale-suite
            [?if [= $suite-ring $lane]
              [then [$concat "  [stale]          " $tag
                       "  -- suite-ring=" $suite-ring " repeats the row's lane; drop it"]]
              [else ""]]]

          # -- [code ring] / [half ring].
          # -- [ring group]: the row's own ring/group/ns (RULED: RS-1).
          [= $shape [$ring-shape $ring $group $ns]]
          [= $v-shape
            [?if [= $shape ""] [then ""]
              [else [$concat "  [ring group]     " $tag "  -- " $rg ": " $shape]]]]
          [= $want-code [?if [= $place "platform"] [then "vcx/platform/ or a product's vcx/<vmodule>/"] [else "vcx/code/"]]]
          [= $v-code-ring
            [?if [not [= $code-to ""]] [then ""]
              [else [$strings:join
                [?for [in $f [$words $code]]
                  [where [not [$place-dir-ok $f $place $pdirs]]]
                  [yield [$concat "  [code ring]      " $tag "  -- " $rg
                           " wants " $want-code ", found " $f
                           " (a platform module's pure piece belongs in half=, not code=)"]]]
                "\n"]]]]
          [= $v-half-ring
            [$strings:join
              [?for [in $f [$words $half]]
                [where [not [$strings:starts-with $f "vcx/code/"]]]
                [yield [$concat "  [half ring]      " $tag
                         "  -- a declared half is Ring 1 and lives in vcx/code/, found " $f]]]
              "\n"]]
          [= $v-half-ring1
            [?if [= $group "platform"] [then ""]
              [else [?if [= [$count [$words $half]] 0] [then ""]
                [else [$concat "  [half ring]      " $tag
                         "  -- only a group=platform module declares a half; this row is " $rg]]]]]]

          # -- [spec ring] / [corpus ring]: the directory IS the ring, unless
          #    the row declares the move.
          [= $v-spec-ring
            [?if [not [= $spec-to ""]] [then ""]
              [else [$strings:join
                [?for [in $f [$words $spec-r]]
                  [where [not [$place-dir-ok $f $place $pdirs]]]
                  [yield [$concat "  [spec ring]      " $tag "  -- " $rg
                           ", but " $f " is in the other side's directory"]]]
                "\n"]]]]
          [= $v-corpus-ring
            [?if [not [= $corpus-to ""]] [then ""]
              [else [$strings:join
                [?for [in $f [$words $corpus-r]]
                  [where [not [$place-dir-ok $f $place $pdirs]]]
                  [yield [$concat "  [corpus ring]    " $tag "  -- " $rg
                           ", but " $f " is in the other side's directory"]]]
                "\n"]]]]

          # -- [dest ring]: where the row SAYS the artifact goes must agree
          #    with the ring, whether that is a `-to` or the column itself.
          [= $v-dest
            [$strings:join
              [?for [in $d ("spec", "corpus", "source", "code")]
                [= $to  [?if [= $d "spec"] [then $spec-to]
                          [else [?if [= $d "corpus"] [then $corpus-to]
                            [else [?if [= $d "source"] [then $source-to] [else $code-to]]]]]]]
                [where [not [= $to ""]]]
                [= $bad
                  [$strings:join
                    [?for [in $f [$words $to]]
                      [where [not [$place-dir-ok $f $place $pdirs]]]
                      [yield $f]]
                    " "]]
                [where [not [= $bad ""]]]
                [yield [$concat "  [dest ring]      " $tag "  -- " $rg
                         ", but " $d "-to names " $bad]]]
              "\n"]]

          # -- [stale]: a `-to` that repeats its column, or that already
          #    exists. Either one would let a finished move keep declaring
          #    itself unfinished, which is the whole failure mode this file
          #    was written against.
          [= $v-stale-to
            [$strings:join
              [?for [in $d ("spec", "corpus", "source", "code")]
                [= $col [?if [= $d "spec"] [then $spec]
                          [else [?if [= $d "corpus"] [then $corpus]
                            [else [?if [= $d "source"] [then $source] [else $code]]]]]]]
                [= $to  [?if [= $d "spec"] [then $spec-to]
                          [else [?if [= $d "corpus"] [then $corpus-to]
                            [else [?if [= $d "source"] [then $source-to] [else $code-to]]]]]]]
                [where [not [= $to ""]]]
                [= $why
                  [?if [= $to $col]
                    [then [$concat $d "-to repeats " $d "="]]
                    [else [?if [$io:exists $to]
                      [then [$concat $to " already exists -- the move is made; drop " $d "-to and set " $d "="]]
                      [else ""]]]]]
                [where [not [= $why ""]]]
                [yield [$concat "  [stale]          " $tag "  -- " $why]]]
              "\n"]]
          [= $v-stale-ns
            [?if [= $ns-to $ns]
              [then [$concat "  [stale]          " $tag "  -- ns-to repeats ns="]]
              [else ""]]]

          [= $parts
            [?for [in $p ($v-shape, $v-stale-planned, $v-corpus-none, $v-suite, $v-stale-suite,
                          $v-code-ring, $v-half-ring, $v-half-ring1,
                          $v-spec-ring, $v-corpus-ring, $v-dest,
                          $v-stale-to, $v-stale-ns, $v-dep-path)]
              [where [not [= $p ""]]]
              [yield $p]]]
          [yield [$strings:join $parts "\n"]]]]

      # -- existence, as its own sweep (one line per file, not per row) --
      [= $missing-lines
        [?for [in $m $rows]
          [= $status [$string [?else $m@status "current"]]]
          [where [= $status "current"]]
          [= $name [$string $m@name]]
          [= $ns   [$string [?else $m@ns "none"]]]
          # A `status=planned` row is skipped above: its columns name where
          # the artifacts WILL be, and [stale planned] is what holds it to
          # writing them. An absent artifact spelled `none` is dropped by
          # `words`, so this sweep only ever sees a declared path.
          [= $g1 [$string [?else $m@spec "none"]]]
          [= $g2 [$string [?else $m@corpus "none"]]]
          [= $g3 [$string [?else $m@source "none"]]]
          [= $g4 [$string [?else $m@code "none"]]]
          [= $g5 [$string [?else $m@half "none"]]]
          [= $repo [$string [?else $m@repo ""]]]
          # An EXTRACTED module's artifacts arrive as the pinned checkout, so
          # the absence has one cause and one cure and the line says both.
          # This is the loud half of RS-12's transport: a `cx` built without
          # `deps/` does not drop the module quietly, it stops here by name.
          [= $why [?if [= $repo ""] [then ""]
                    [else [$concat "  (repo=" $repo "; run `make deps-sync`)"]]]]
          [= $files
            [?for [in $g ($g1, $g2, $g3, $g4, $g5)]
              [yield [$strings:join [$words $g] " "]]]]
          [= $hit
            [$strings:join
              [?for [in $f [$strings:split-whitespace [$strings:join $files " "]]]
                [where [not [$io:exists $f]]]
                [yield [$concat "  [missing]        " $name " (" $ns ")  -- " $f $why]]]
              "\n"]]
          [where [not [= $hit ""]]]
          [yield $hit]]]

      # -- orphans -----------------------------------------------------
      # Every artifact under a directory the split governs must be claimed by
      # a row (where it is, or where it is going) or by a `[move]`.
      # The sweep is written over a JOINED string rather than a sequence of
      # sequences: a `yield` of a sequence nests, and three directories that
      # each hold a few dozen files would come back as three lists to walk
      # instead of one. Paths carry no spaces, so joining and re-splitting is
      # lossless. The directory guard matters because two of the three do not
      # exist until #1427 phase 2 makes them.
      [= $all-specs
        [$strings:split-whitespace
          [$strings:join
            [?for [in $d ("spec/03-approved/std-lib", "spec/03-approved/stdlib",
                          "spec/03-approved/platform")]
              [where [$io:is-directory $d]]
              [yield [$strings:join [$io:glob [$concat $d "/**/*.md"]] " "]]]
            " "]]]
      [= $all-corpora
        [$strings:split-whitespace
          [$strings:join
            [?for [in $d ("conformance/stdlib", "conformance/platform")]
              [where [$io:is-directory $d]]
              [yield [$strings:join [$io:glob [$concat $d "/*.cxd"]] " "]]]
            " "]]]
      [= $all-sources
        [$strings:split-whitespace
          [$strings:join
            [?for [in $d ("stdlib", "x")]
              [where [$io:is-directory $d]]
              [yield [$strings:join [$io:glob [$concat $d "/*.cx"]] " "]]]
            " "]]]

      [= $orphan-spec
        [?for [in $s $all-specs]
          [where [not [$named $claimed $s]]]
          [where [not [$named $moved $s]]]
          [where [not [$named $catalogued $s]]]
          [yield [$concat "  [orphan spec]    " $s "  -- no row in registry/modules.cxd"]]]]
      [= $orphan-corpus
        [?for [in $c $all-corpora]
          [where [not [$named $claimed $c]]]
          [where [not [$named $moved $c]]]
          [yield [$concat "  [orphan corpus]  " $c "  -- graded, but no row claims it"]]]]
      [= $orphan-source
        [?for [in $s $all-sources]
          [where [not [$named $claimed $s]]]
          [where [not [$named $moved $s]]]
          [yield [$concat "  [orphan source]  " $s "  -- bundled, but no row claims it"]]]]

      # -- the catalogs: declared, well formed, placed, and on disk -----
      # A catalog row carries the same ring/group pair a module row does
      # (RULED: RS-1), so `ring=2` is refused here too, and its page sits in
      # the directory its place names.
      [= $catalog-lines
        [?for [in $m $catalogs]
          [= $p [$string [?else $m@path ""]]]
          [= $r [$string [?else $m@ring "?"]]]
          [= $g [$string [?else $m@group ""]]]
          # `repo=` -- an extracted catalog page (RULED: RS-7, RS-12), same
          # transport a `[module]` row's `[dep path]` uses: the page still
          # indexes the group from here, but it reaches this tree only as
          # the pinned checkout deps.cxd names, so the ring is read from
          # what follows `deps/<repo>/` and existence is checked at the
          # literal (pinned) path.
          [= $repo [$string [?else $m@repo ""]]]
          [= $rg [?if [= $g ""] [then [$concat "ring=" $r]] [else [$concat "ring=" $r " group=" $g]]]]
          [= $shape [$ring-shape $r $g "none"]]
          [= $l1 [?if [= $shape ""] [then ""]
                   [else [$concat "  [ring group]     catalog " $p "  -- " $rg ": " $shape]]]]
          [= $l2 [?if [$place-dir-ok [$in-repo $p $repo] [$row-place $r $g] $pdirs] [then ""]
                   [else [$concat "  [spec ring]      catalog " $p "  -- " $rg
                           ", but the page is in the other side's directory"]]]]
          [= $l3 [?if [$io:exists $p] [then ""]
                   [else [$concat "  [catalog]        " $rg
                           "  -- the catalog page " $p " is declared and not on disk"
                           [?if [= $repo ""] [then ""] [else [$concat "  (repo=" $repo "; run `make deps-sync`)"]]]]]]]
          [= $l4 [?if [= $repo ""] [then ""]
                   [else [?if [$strings:starts-with $p [$dep-prefix $repo]] [then ""]
                     [else [$concat "  [dep path]       catalog " $p "  -- repo=" $repo
                             " says the page is in that repository; path must begin " [$dep-prefix $repo]]]]]]]
          [= $hit [$strings:join [?for [in $x ($l1, $l2, $l3, $l4)] [where [not [= $x ""]]] [yield $x]] "\n"]]
          [where [not [= $hit ""]]]
          [yield $hit]]]

      # -- the integration maps (RULED: COMP-1) -------------------------
      # Every page under the platform group's spec directory except its catalog
      # states its own seams. The catalog is the one page that indexes the
      # modules instead of being one.
      [= $map-lines
        [?for [in $f [$io:glob "spec/03-approved/platform/**/*.md"]]
          [where [not [= $f "spec/03-approved/platform/README.md"]]]
          [where [not [$has-integration-map [$io:read-file $f]]]]
          [yield [$concat "  [integration map] " $f
                   "  -- a platform specification with no Integration map heading;"
                   " the section restates composition.md §2's rows for this module (RULED: COMP-1)"]]]]

      # -- assemble ----------------------------------------------------
      [= $row-hits [?for [in $x $row-lines] [where [not [= $x ""]]] [yield $x]]]
      [= $n-violations
        [+ [$count $map-lines]
        [+ [$count $row-hits]
           [+ [$count $catalog-lines]
           [+ [$count $missing-lines]
              [+ [$count $orphan-spec]
                 [+ [$count $orphan-corpus] [$count $orphan-source]]]]]]]]

      [= $b1 [$strings:join $row-hits "\n"]]
      [= $b0 [$strings:join $catalog-lines "\n"]]
      [= $b2 [$strings:join $missing-lines "\n"]]
      [= $b3 [$strings:join $orphan-spec "\n"]]
      [= $b4 [$strings:join $orphan-corpus "\n"]]
      [= $b5 [$strings:join $orphan-source "\n"]]
      [= $b6 [$strings:join $map-lines "\n"]]
      [= $blocks
        [?for [in $b ($b0, $b1, $b2, $b3, $b4, $b5, $b6)]
          [where [not [= $b ""]]]
          [yield $b]]]

      # -- the census: what the cutover still owes, counted from the rows.
      [= $n-ring1 [$count [?for [in $m $rows] [where [= [$string $m@ring] "1"]] [yield $m]]]]
      [= $n-ring0 [$count [?for [in $m $rows] [where [= [$string $m@ring] "0"]] [yield $m]]]]
      [= $n-platform [$count [?for [in $m $rows] [where [= [$string [?else $m@group ""]] "platform"]] [yield $m]]]]
      [= $n-spec-to   [$count [?for [in $m $rows] [where [not [= [$string [?else $m@spec-to ""]] ""]]] [yield $m]]]]
      [= $n-corpus-to [$count [?for [in $m $rows] [where [not [= [$string [?else $m@corpus-to ""]] ""]]] [yield $m]]]]
      [= $n-source-to [$count [?for [in $m $rows] [where [not [= [$string [?else $m@source-to ""]] ""]]] [yield $m]]]]
      [= $n-code-to   [$count [?for [in $m $rows] [where [not [= [$string [?else $m@code-to ""]] ""]]] [yield $m]]]]
      [= $n-ns-to     [$count [?for [in $m $rows] [where [not [= [$string [?else $m@ns-to ""]] ""]]] [yield $m]]]]
      [= $n-suite     [$count [?for [in $m $rows] [where [not [= [$string [?else $m@suite-ring ""]] ""]]] [yield $m]]]]
      # The planned and incoming rows are NAMED, not just counted: a bare
      # count tells a reader that something is declared ahead of its code
      # without telling them what, and "which module is unwritten?" is the
      # first question the number raises.
      [= $planned-rows [?for [in $m $rows] [where [= [$string [?else $m@status "current"]] "planned"]] [yield [$string $m@name]]]]
      [= $incoming-rows [?for [in $m $rows] [where [= [$string [?else $m@status "current"]] "incoming"]] [yield [$string $m@name]]]]
      [= $n-planned   [$count $planned-rows]]
      [= $n-incoming  [$count $incoming-rows]]
      [= $named-of
        [?if [= [$count $planned-rows] 0] [then ""]
          [else [$concat " (" [$strings:join $planned-rows " "] ")"]]]]
      [= $named-in
        [?if [= [$count $incoming-rows] 0] [then ""]
          [else [$concat " (" [$strings:join $incoming-rows " "] ")"]]]]

      [= $census
        [$concat
          "cutover still owed (RULED: 1427-a/b/c/d/e): "
          [$string $n-spec-to] " spec, "
          [$string $n-corpus-to] " corpus, "
          [$string $n-source-to] " source, "
          [$string $n-code-to] " code, "
          [$string $n-ns-to] " namespace, "
          [$string $n-suite] " corpus-header ring; "
          [$string [$count $moves]] " non-row move(s); "
          [$string $n-planned] " planned" $named-of ", "
          [$string $n-incoming] " incoming row(s)" $named-in "."]]

  [?if [= $n-violations 0]
    [then
      [?let [= $_ok [$io:write-line [$env:stdout]
          [$concat "placement-gate OK -- " [$string [$count $rows]]
            " rows in registry/modules.cxd (" [$string $n-ring0] " ring 0, "
            [$string $n-ring1] " ring 1; " [$string $n-platform]
            " of them group=platform); every row's ring is 0 or 1 and its group and namespace agree (RULED: RS-1), every artifact sits where its row says, every row's place agrees with the directories it is not declared to be leaving, nothing under the ring and platform directories is unclaimed, and every platform specification but the platform catalog carries an integration-map section (RULED: COMP-1).\n  " $census]]]
        [$env:exit 0]]]
    [else
      [?let [= $_bad [$io:write-line [$env:stderr]
          [$concat "placement drift -- " [$string $n-violations]
            " site(s) disagree with registry/modules.cxd, or with the integration-map rule (RULED: 1427-f, OL-15, COMP-1); a site is one row, one unclaimed artifact or one page with no map, and a row may carry several lines:\n"
            [$strings:join $blocks "\n"]
            "\n  " $census]]]
        [$env:exit 1]]]]]]]]
