# scripts/site_live_check_cases.cxd — the case table of the live-stamp step's
# decision (RULED: DOCS-51 criterion 6; #1758), read by
# `scripts/site_live_check.cx --self-test` (`make site-live-check`'s first
# half). Each case gives the readings the live half takes from the network,
# and the verdict the decision must answer:
#   stamp    the live site's stamp.txt ('' when it serves none, a 404);
#   lm       the landing page's Last-Modified, as served ('' when none);
#   maxage   the stamp response's Cache-Control max-age, in seconds;
#   public   the public main (`git ls-remote`; '' when unreadable);
#   run      the Site run on the public main, 'none' when there is none,
#            'unread' when gh could not answer, else
#            '<status> <conclusion> <createdAt> <updatedAt>';
#   prev     the last successful Site run's duration in seconds ('' when
#            unread), the window for a run still in progress;
#   now      the moment of the reading (RFC 3339);
#   ok       the verdict; `why` a substring its reason must carry.
# P below is the public main, S an older build.
[cases expectations=13
  [case id=stamp-equal ok=true why='live: the stamp is the public main'
        stamp='4d499e603f55f7bf0e6534bee0aba3a339ea6a73' lm='' maxage='600'
        public='4d499e603f55f7bf0e6534bee0aba3a339ea6a73' run='unread' prev='' now='2026-10-03T07:00:00Z']
  [case id=deploying ok=true why='deploying'
        stamp='eb8f1600230784e01931098816d9f357df42d182' lm='' maxage='600'
        public='4d499e603f55f7bf0e6534bee0aba3a339ea6a73'
        run='in_progress - 2026-10-03T06:00:00Z 2026-10-03T06:10:00Z' prev='2100' now='2026-10-03T06:20:00Z']
  [case id=deployed-cache ok=true why='deploying'
