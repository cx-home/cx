        public='4d499e603f55f7bf0e6534bee0aba3a339ea6a73'
        run='completed success 2026-10-03T06:00:00Z 2026-10-03T06:35:00Z' prev='2100' now='2026-10-03T06:40:00Z']
  [case id=stale-after-success ok=false why='stale'
        stamp='eb8f1600230784e01931098816d9f357df42d182' lm='' maxage='600'
        public='4d499e603f55f7bf0e6534bee0aba3a339ea6a73'
        run='completed success 2026-10-03T06:00:00Z 2026-10-03T06:35:00Z' prev='2100' now='2026-10-03T07:00:00Z']
