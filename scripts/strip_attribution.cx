# scripts/strip_attribution.cx — the RS-33 history strip tool.
#
# Given repository names (or `--all-public`: every `registry/repos.cxd`
# `[repo name=]` row that is not `cx-private`, plus the V fork, named `v`),
# for each one: mirror-clone it, run `git filter-repo --message-callback` to
# drop exactly the RS-33 lines from every commit message (message text only —
# no path, author or date is touched), verify with this gate's own scanner
# that zero remain across the WHOLE rewritten history and that the commit
# count is unchanged, write the old-sha -> new-sha map, and print the re-pin
# list every mover and the integrator needs.
#
# It PUSHES NOTHING. The integrator force-pushes from the mirrors this tool
# produces and applies the printed re-pins; this tool only prepares.
#
# The four RS-33 patterns are held split across string literals, here and in
# the Python callback source this tool builds, for the same reason
# scripts/check_no_ai_attribution.cx's are: a whole pattern sitting
# contiguously in this file's own tracked text would make the gate flag this
# file the moment it scans it. The pattern set is scripts/check_no_ai_attribution.cx's
# to define; this file's copy must be kept in step with it by hand (no CX
# import-from-script exists yet to share it — noted, not filed as a cx-gap:
# every other checker in this tree duplicates its own small helpers the same
# way).
#
# Usage (run from the checkout root; needs `git-filter-repo` from
# ~/Library/Python/3.9/bin on this box):
#   cx --allow-read --allow-write --allow-subprocess --allow-env \
#     scripts/strip_attribution.cx cx-platform-fabric work=/path/to/work \
#     source:cx-platform-fabric=/path/to/local/mirror.git
#   cx ... scripts/strip_attribution.cx --all-public work=/path/to/work --dry-run
#
# Flags are single tokens (this tree's own key=value idiom, not getopt):
#   --all-public          every public repository (registry/repos.cxd minus
#                          cx-private) plus the V fork ("v")
#   --dry-run              print the plan; clone, rewrite and verify nothing
#   --repins-only          clone and rewrite nothing: print the re-pin list
#                          from the mirrors and maps an earlier run left in
#                          work= (a second run — the fork's — adds its map to
#                          the first run's without redoing it)
#   work=<dir>             where each <name>.git mirror and <name>.map land
#                          (default: a fresh temp dir, printed)
#   source:<name>=<path>   clone FROM <path> instead of the default
#                          git@github.com:cx-home/<name>.git (a local mirror
#                          path for testing, or an alternate remote)
#   refs:<name>=<spec>     rewrite and verify only <spec> (git-filter-repo
#                          `--refs`): a branch (`cx-patches-0.18`) or a
#                          two-dot range (`<base>..cx-patches-0.18`); every
#                          count, scan and tree check reads the same spec. A
#                          mirror's other refs are left as they were
#   verify-only:<name>     mirror <name> and count its hits over every ref;
#                          rewrite nothing (a repository stripped at its
#                          push, verified instead; added to the list if not
#                          already in it)
#   skip:<name>            drop <name> from the list (`--all-public` minus one)
#
# Per rewritten repository the tool reports commits before -> after (equal),
# hits before -> after (0), every ref's tree before = after, `git fsck --full`
# clean, the tip before -> after and the map path.
#
# Exit 0 every named repository verified clean (and, where rewritten, count-,
# tree- and fsck-preserving), 1 a repository failed verification, 2 an
# environment fault (git, git-filter-repo, a clone, or a rewrite failed).

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/fp'      as=fp]

[?def say scope=private impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=private impure ($s) [$io:write-line [$env:stderr] $s]]
[?def cat scope=private pure ($parts) [$strings:join $parts '']]

[?def nonblank scope=private pure ($text::string)
  [?for [in $l [$strings:split-lines $text]]
    [where [not [= [$strings:trim $l] ""]]]
    [yield [$strings:trim $l]]]]

[?def member scope=private pure [returns bool] ($x $xs)
  [> [$count [?for [in $y $xs] [where [= $y $x]] [yield 1]]] 0]]

# -- the RS-33 patterns (split; see the header note) -------------------------

[?def all-patterns scope=private pure ()
  [?let
    [= $p1 [$cat ("Co-Authored-By", ":", " Claude")]]
    [= $p2 [$cat ("noreply", "@", "anthropic.com")]]
    [= $p3 [$cat ("Generated with", " ", "[Claude Code]")]]
    [= $p4 [$cat ("Generated with", " ", "Claude")]]
    [= $p5 [$cat ("🤖", " ", "Generated")]]
    ($p1, $p2, $p3, $p4, $p5)]]

[?def line-hit scope=private pure [returns bool] ($l::string)
  [> [$count [?for [in $p [$all-patterns]] [where [$strings:contains $l $p]] [yield 1]]] 0]]

# the git-filter-repo `--message-callback` source. Assembled at run time from
# parts that never sit contiguous in THIS file (the header note again): every
# `\n` below is a REAL newline in the assembled Python source (a CX escape),
# every `\\n` is the two characters backslash-n, Python's OWN newline escape
# inside the byte literals the callback splits and rejoins on.
[?def message-callback-code scope=private pure ()
  [$cat (
    "pats = [b'", "Co-Authored-By", "'", " + b':'", " + b' Claude',\n",
    "        b'", "noreply", "'", " + b'@'", " + b'anthropic.com',\n",
    "        b'Generated with'", " + b' '", " + b'[Claude Code]',\n",
    "        b'Generated with'", " + b' '", " + b'Claude',\n",
    "        '🤖'.encode('utf-8')", " + b' Generated']\n",
    "lines = message.split(b'\\n')\n",
    "kept = [l for l in lines if not any(p in l for p in pats)]\n",
    "return b'\\n'.join(kept)\n")]]

# -- git / filter-repo plumbing ----------------------------------------------

[?def run-git scope=private impure ($dir::string $argv $what::string)
  [?let
    [= $full ("git", "-C", $dir, [?splice $argv])]
    [= $r [?fallback [$process:run $full]
            [recover-with ([$cry [$cat ("strip-attribution: cannot run git (", $what, ")")]],
                           [$env:exit 2], null)]]]
    [?if [not [= [$string $r@exit-code] "0"]]
      [then [?let [= $_f ([$cry [$cat ("strip-attribution: git ", $what, " failed (exit ",
                                       [$string $r@exit-code], ")")]],
                          [$cry [$string $r@stderr]])]
              [?let [= $_x [$env:exit 2]] ""]]]
      [else [$string $r@stdout]]]]]

# A SCOPE is what one repository's rewrite and verification cover: "" is
# every ref of the mirror (`--all`), anything else is a rev spec handed to
# git-filter-repo's `--refs` — one branch (`cx-patches-0.18`) or a two-dot
# range (`<base>..cx-patches-0.18`) — and every count, scan and tree check
# below reads exactly that spec, so a branch-only rewrite is verified over the
# history it rewrote and nothing else.

# tip-of: the ref a scope ends at (the right side of a two-dot range).
[?def tip-of scope=private pure [returns string] ($spec::string)
  [?let [= $parts [$strings:split $spec ".."]]
    [$nth $parts [$count $parts]]]]

[?def scope-label scope=private pure [returns string] ($spec::string)
  [?if [= $spec ""] [then "every ref"] [else [$cat ("refs ", $spec)]]]]

[?def commit-count scope=private impure ($dir::string $spec::string)
  [$strings:trim
    [?if [= $spec ""]
      [then [$run-git $dir ("rev-list", "--count", "--all") "rev-list --count --all"]]
      [else [$run-git $dir ("rev-list", "--count", $spec) "rev-list --count <scope>"]]]]]

# scan-messages: every hit over the scope's whole history — one `git log`
# whose records are split on a sentinel line, not one process per commit (the
# V fork's branch is tens of thousands of commits). Message text only: a bare
# mirror has no working tree, and messages are the only thing this tool ever
# touches.
[?def scan-messages scope=private impure ($dir::string $spec::string)
  [?let
    [= $sep "::cx-strip-attribution-commit::"]
    [= $fmt [$cat ("--format=", $sep, "%H%n%B")]]
    [= $out [?if [= $spec ""]
              [then [$run-git $dir ("log", "--all", $fmt) "log --all"]]
              [else [$run-git $dir ("log", $spec, $fmt) "log <scope>"]]]]
    [$fp:flat-map [$strings:split $out $sep] [?fn ($chunk)
      [?let [= $kv [$strings:split-limit $chunk "\n" 1]]
        [?if [< [$count $kv] 2]
          [then ()]
          [else [?let [= $sha [$strings:trim [$nth $kv 1]]]
                  [?for [in $l [$nonblank [$nth $kv 2]]]
                    [where [$line-hit $l]]
                    [yield [hit sha=$sha line=$l]]]]]]]]]]]

# ref-trees: "<ref> <tree>" per ref in scope, one text — equal before and
# after is the proof that the rewrite touched messages and nothing else.
[?def ref-trees scope=private impure ($dir::string $spec::string)
  [?let
    [= $refs [?if [= $spec ""]
               [then [$nonblank [$run-git $dir ("for-each-ref", "--format=%(refname)") "for-each-ref"]]]
               [else ([$tip-of $spec])]]]
    [$strings:join
      [?for [in $r $refs]
        [yield [$cat ($r, " ", [$strings:trim [$run-git $dir ("rev-parse", [$cat ($r, "^{tree}")]) "rev-parse <ref>^{tree}"]])]]]
      "\n"]]]

[?def tip-sha scope=private impure ($dir::string $spec::string)
  [$strings:trim [$run-git $dir ("rev-parse", [?if [= $spec ""] [then "HEAD"] [else [$tip-of $spec]]]) "rev-parse <tip>"]]]

[?def fsck-clean scope=private impure [returns bool] ($dir::string)
  [?let [= $r [?fallback [$process:run ("git", "-C", $dir, "fsck", "--full", "--no-progress")]
                [recover-with null]]]
    [?if [= $r null] [then false] [else [= [$string $r@exit-code] "0"]]]]]

[?def default-source scope=private pure [returns string] ($name::string)
  [$cat ("git@github.com:cx-home/", $name, ".git")]]

[?def source-for scope=private pure [returns string] ($name::string $overrides)
  [?let [= $hit [?for [in $o $overrides] [where [= [$string $o@name] $name]] [yield [$string $o@value]]]]
    [?if [= [$count $hit] 0] [then [$default-source $name]] [else [$first $hit]]]]]

[?def refs-for scope=private pure [returns string] ($name::string $refs)
  [?let [= $hit [?for [in $o $refs] [where [= [$string $o@name] $name]] [yield [$string $o@value]]]]
    [?if [= [$count $hit] 0] [then ""] [else [$first $hit]]]]]

# -- the re-pin list ----------------------------------------------------------
# every sha=/at=/v-fork=/upstream-base= naming an OLD sha in $text, and every
# gitlink (mode 160000) naming one, printed with its NEW sha. A pin whose sha
# the rewrite left unchanged (a commit older than the first attributed one)
# needs no action and is not listed.
[?def new-for scope=private pure ($old::string $map)
  [?for [in $pr $map] [where [= [$string $pr@old] $old]] [where [not [= [$string $pr@new] $old]]] [yield [$string $pr@new]]]]

[?def re-pins-text scope=private pure ($label::string $file::string $text::string $map)
  [?if [= $text ""]
    [then ()]
    [else
      [?let [= $rx [$re:compile "(sha|at|v-fork|upstream-base)=([0-9a-fA-F]{40})"]]
        [?for
          [in $m [$re:find-all $rx $text]]
          [= $key [$re:group $m 1]]
          [= $old [$strings:lower [$re:group $m 2]]]
          [in $new [$new-for $old $map]]
          [yield [repin label=$label file=$file key=$key old=$old new=$new]]]]]]]

# gitlink-repins: `git ls-files -s` ("160000 <sha> 0<TAB><path>") or
# `git ls-tree -r` ("160000 commit <sha><TAB><path>") text.
[?def gitlink-repins scope=private pure ($label::string $text::string $map)
  [?let [= $rx [$re:compile "160000 (?:commit )?([0-9a-f]{40})[^\t\n]*\t([^\n]+)"]]
    [?for
      [in $m [$re:find-all $rx $text]]
      [= $old [$re:group $m 1]]
      [= $path [$re:group $m 2]]
      [in $new [$new-for $old $map]]
      [yield [repin label=$label file=$path key=gitlink old=$old new=$new]]]]]

# try-git: a git command's stdout, or "" — a repository with no deps.cxd (a
# ships=package/binding/archived row) is not an environment fault, just
# nothing to scan.
[?def try-git scope=private impure ($dir::string $argv)
  [?let [= $r [?fallback [$process:run ("git", "-C", $dir, [?splice $argv])]
                [recover-with null]]]
    [?if [or [= $r null] [not [= [$string $r@exit-code] "0"]]] [then ""] [else [$string $r@stdout]]]]]

[?def pin-files scope=private pure () ("deps.cxd", "registry/repos.cxd", "scripts/v_fork_register.cxd")]

[?def read-map scope=private impure ($path::string)
  [?let [= $text [?fallback [$io:read-file $path] [recover-with ""]]]
    [?for [in $l [$nonblank $text]]
      [= $cols [$strings:split-whitespace $l]]
      [where [= [$count $cols] 2]]
      [= $c1 [$strings:lower [$nth $cols 1]]]
      [= $c2 [$strings:lower [$nth $cols 2]]]
      [where [not [= $c1 "old"]]]
      [yield [pair old=$c1 new=$c2]]]]]

# -- one repository -----------------------------------------------------------

[?def dry-one scope=private impure ($name::string $source::string $mirror::string $map-path::string $spec::string $verify::bool)
  [?let
    [= $_p1 [$say [$cat ("[dry-run] ", $name, ": clone --mirror ", $source, " -> ", $mirror)]]]
    [= $_p2 [?if $verify
      [then [$say [$cat ("[dry-run] ", $name, ": verify-only -- count the attribution hits over every ref, rewrite nothing")]]]
      [else [?let
        [= $refs-arg [?if [= $spec ""] [then ""] [else [$cat (" --refs ", $spec)]]]]
        [= $_a [$say [$cat ("[dry-run] ", $name, ": git-filter-repo --message-callback <RS-33 code> --force", $refs-arg)]]]
        [= $_b [$say [$cat ("[dry-run] ", $name, ": verify over ", [$scope-label $spec], ": hits -> 0, rev-list --count unchanged, every tree unchanged, fsck --full clean")]]]
        [$say [$cat ("[dry-run] ", $name, ": write ", $map-path, " from filter-repo's commit-map")]]]]]]
    [ok name=$name clean=true]]]

[?def clone-mirror scope=private impure ($name::string $source::string $mirror::string $work::string)
  [?let
    [= $_mk [$io:make-dirs $work]]
    [= $cl [$process:run ("git", "clone", "--mirror", $source, $mirror)]]
    [?if [not [= [$string $cl@exit-code] "0"]]
      [then [?let [= $_e ([$cry [$cat ("strip-attribution: ", $name, ": git clone --mirror failed")]],
                          [$cry [$string $cl@stderr]])]
              [$env:exit 2]]]
      [else ()]]]]

[?def verify-one scope=private impure ($name::string $source::string $mirror::string $work::string)
  [?let
    [= $_c [$clone-mirror $name $source $mirror $work]]
    [= $n [$commit-count $mirror ""]]
    [= $hits [$scan-messages $mirror ""]]
    [= $head [$tip-sha $mirror ""]]
    [= $_r ([$say [$cat ($name, ": verify-only, ", $n, " commits over every ref, ",
                         [$string [$count $hits]], " attribution hit(s), HEAD ", $head)]],
            [?for [in $h $hits] [yield [$cry [$cat ("  HIT ", [$string $h@sha], ": ", [$string $h@line])]]]])]
    [ok name=$name clean=[= [$count $hits] 0]]]]

[?def rewrite-one scope=private impure ($name::string $source::string $mirror::string $map-path::string $work::string $spec::string)
  [?let
    [= $_c [$clone-mirror $name $source $mirror $work]]
    [= $before [$commit-count $mirror $spec]]
    [= $hits-before [$scan-messages $mirror $spec]]
    [= $trees-before [$ref-trees $mirror $spec]]
    [= $tip-before [$tip-sha $mirror $spec]]
    [= $home [$string [$env:var-or-default "HOME" ""]]]
    [= $gfr [$cat ($home, "/Library/Python/3.9/bin/git-filter-repo")]]
    [= $_gfrchk [?if [not [$io:exists $gfr]]
      [then [?let [= $_e [$cry [$cat ("strip-attribution: ", $gfr, " not found — install git-filter-repo")]]]
              [$env:exit 2]]]
      [else ()]]]
    [= $code [$message-callback-code]]
    [= $base-argv ($gfr, "--message-callback", $code, "--force", "--source", $mirror, "--target", $mirror)]
    [= $fr-argv [?if [= $spec ""] [then $base-argv] [else ([?splice $base-argv], "--refs", $spec)]]]
    [= $fr [$process:run $fr-argv]]
    [= $_frchk [?if [not [= [$string $fr@exit-code] "0"]]
      [then [?let [= $_e ([$cry [$cat ("strip-attribution: ", $name, ": git-filter-repo failed")]],
                          [$cry [$string $fr@stderr]])]
              [$env:exit 2]]]
      [else ()]]]
    [= $after [$commit-count $mirror $spec]]
    [= $hits [$scan-messages $mirror $spec]]
    [= $trees-after [$ref-trees $mirror $spec]]
    [= $tip-after [$tip-sha $mirror $spec]]
    [= $fsck-ok [$fsck-clean $mirror]]
    [= $map-src [$cat ($mirror, "/filter-repo/commit-map")]]
    [= $map-text [?fallback [$io:read-file $map-src] [recover-with ""]]]
    [= $_wm [$io:write-file $map-path $map-text]]
    [= $count-ok [= $before $after]]
    [= $trees-ok [= $trees-before $trees-after]]
    [= $clean [and $count-ok [and $trees-ok [and $fsck-ok [= [$count $hits] 0]]]]]
    [= $_report ([$say [$cat ($name, ": ", [$scope-label $spec], ", ", $before, " -> ", $after, " commits (unchanged: ",
                              [$string $count-ok], "), hits ", [$string [$count $hits-before]], " -> ",
                              [$string [$count $hits]], ", trees unchanged: ", [$string $trees-ok],
                              " (", [$string [$count [$nonblank $trees-before]]], " ref(s)), fsck clean: ",
                              [$string $fsck-ok], ", tip ", $tip-before, " -> ", $tip-after,
                              ", map ", $map-path)]],
                 [?for [in $h $hits] [yield [$cry [$cat ("  RESIDUAL ", [$string $h@sha], ": ", [$string $h@line])]]]])]
    [ok name=$name clean=$clean]]]

[?def strip-one scope=private impure ($name::string $work::string $overrides $refs $verify-names $dry::bool)
  [?let
    [= $source [$source-for $name $overrides]]
    [= $spec [$refs-for $name $refs]]
    [= $verify [$member $name $verify-names]]
    [= $mirror [$cat ($work, "/", $name, ".git")]]
    [= $map-path [$cat ($work, "/", $name, ".map")]]
    [?if $dry
      [then [$dry-one $name $source $mirror $map-path $spec $verify]]
      [else [?if $verify
              [then [$verify-one $name $source $mirror $work]]
              [else [$rewrite-one $name $source $mirror $map-path $work $spec]]]]]]]


# -- --all-public --------------------------------------------------------------

[?def all-public-names scope=private impure ()
  [?let
    [= $reg [$cx:parse [$io:read-file "registry/repos.cxd"]]]
    [= $names [?for [in $r $reg//repo] [where [not [= [$string $r@name] "cx-private"]]] [yield [$string $r@name]]]]
    ([?splice $names], "v")]]

# -- the header, the re-pin printer and the verdict (broken out of the final
# ?let so each one's brackets are checkable on their own) --------------------

[?def print-header scope=private impure ($names $work::string $mode::string)
  [?if [= [$count $names] 0]
    [then [?let [= $_ [$cry "strip-attribution: name a repository, or pass --all-public"]] [$env:exit 2]]]
    [else
      [?let
        [= $suffix [?if [= $mode ""] [then ""] [else [$cat (" (", $mode, ")")]]]]
        [= $plural [?if [= [$count $names] 1] [then "y"] [else "ies"]]]
        [$say [$cat ("strip-attribution: work=", $work, $suffix, " -- ",
                     [$string [$count $names]], " repositor", $plural, ": ",
                     [$strings:join $names " "])]]]]]]

# repins-for-mirror: the re-pins in ONE mirrored repository's HEAD — its
# pin files (git show HEAD:<file>) and its gitlinks (git ls-tree -r HEAD).
[?def repins-for-mirror scope=private impure ($n::string $work::string $map)
  [?let
    [= $dir [$cat ($work, "/", $n, ".git")]]
    [= $files [$fp:flat-map [$pin-files] [?fn ($f)
                [$re-pins-text $n $f [$try-git $dir ("show", [$cat ("HEAD:", $f)])] $map]]]]
    [= $links [$gitlink-repins $n [$try-git $dir ("ls-tree", "-r", "HEAD")] $map]]
    ([?splice $files], [?splice $links])]]

[?def print-repins scope=private impure ($names $work::string $map)
  [?let
    [= $r1 [$fp:flat-map [$pin-files] [?fn ($f)
             [$re-pins-text "this tree" $f [?fallback [$io:read-file $f] [recover-with ""]] $map]]]]
    [= $r2 [$gitlink-repins "this tree" [$try-git "." ("ls-files", "-s")] $map]]
    [= $r3 [$fp:flat-map $names [?fn ($n) [$repins-for-mirror $n $work $map]]]]
    [= $all-repins ([?splice $r1], [?splice $r2], [?splice $r3])]
    [= $_n [$say [$cat ("strip-attribution: ", [$string [$count $all-repins]], " re-pin(s)")]]]
    [?for [in $rp $all-repins]
      [yield [$say [$cat ("re-pin  ", [$string $rp@label], " ", [$string $rp@file], ": ",
                          [$string $rp@key], "=", [$string $rp@old], " -> ", [$string $rp@new])]]]]]]

[?def print-verdict scope=private impure ($bad $total::string $mode::string)
  [?if [and [= $mode ""] [> [$count $bad] 0]]
    [then [?let
      [= $_ [$cry [$cat ("strip-attribution: FAILED — ", [$string [$count $bad]], " of ",
                         $total, " repositor(y/ies) did not verify clean")]]]
      [$env:exit 1]]]
    [else [?let
      [= $_ [$say [?if [= $mode "dry-run"]
                    [then "strip-attribution: dry-run OK — plan printed, nothing cloned or rewritten"]
                    [else [?if [= $mode "repins-only"]
                            [then "strip-attribution: re-pins printed from the existing mirrors and maps — nothing cloned or rewritten"]
                            [else "strip-attribution: OK — every named repository verified clean (and, where rewritten, count-, tree- and fsck-preserving)"]]]]]]
      [$env:exit 0]]]]]

# -- argv ----------------------------------------------------------------------

[?def suffixes-of scope=private pure ($argv $prefix::string)
  [?for [in $a $argv] [where [$strings:starts-with $a $prefix]]
    [yield [$strings:slice $a [+ [$strings:length $prefix] 1] [$strings:length $a]]]]]

# name=value pairs after a prefix (`source:`, `refs:`); the value may itself
# contain `=` — only the first one splits.
[?def pairs-of scope=private pure ($argv $prefix::string)
  [?for [in $body [$suffixes-of $argv $prefix]]
    [= $kv [$strings:split-limit $body "=" 1]]
    [where [= [$count $kv] 2]]
    [yield [pair name=[$nth $kv 1] value=[$nth $kv 2]]]]]

[?let
  # $env:argv's first element is the script's own path (proven by probe, not
  # documented in the primer set this branch loaded) — drop it before
  # treating the rest as repository names and flags.
  [= $raw-argv [$env:argv]]
  [= $argv [?for [in $i [$range 2 [$count $raw-argv]]] [yield [$nth $raw-argv $i]]]]
  [= $dry [$member "--dry-run" $argv]]
  [= $repins-only [$member "--repins-only" $argv]]
  [= $mode [?if $dry [then "dry-run"] [else [?if $repins-only [then "repins-only"] [else ""]]]]]
  [= $all-public [$member "--all-public" $argv]]
  [= $work-tok [$suffixes-of $argv "work="]]
  [= $work [?if [= [$count $work-tok] 0]
             [then [$io:temp-dir "cx-strip-attr-"]]
             [else [$first $work-tok]]]]
  [= $overrides [$pairs-of $argv "source:"]]
  [= $refs [$pairs-of $argv "refs:"]]
  [= $verify-names [$suffixes-of $argv "verify-only:"]]
  [= $skips [$suffixes-of $argv "skip:"]]
  [= $flag [?fn ($a) [or [$member $a ("--dry-run", "--all-public", "--repins-only")]
              [> [$count [?for [in $p ("work=", "source:", "refs:", "verify-only:", "skip:")]
                           [where [$strings:starts-with $a $p]] [yield 1]]] 0]]]]
  [= $explicit [?for [in $a $argv] [where [not [$flag $a]]] [yield $a]]]
  [= $base [?if $all-public [then [$all-public-names]] [else $explicit]]]
  [= $extra [?for [in $v $verify-names] [where [not [$member $v $base]]] [yield $v]]]
  [= $names [?for [in $n ([?splice $base], [?splice $extra])] [where [not [$member $n $skips]]] [yield $n]]]
  [= $_hdr [$print-header $names $work $mode]]
  [= $results [?if $repins-only
                [then [?for [in $n $names] [yield [ok name=$n clean=true]]]]
                [else [?for [in $n $names] [yield [$strip-one $n $work $overrides $refs $verify-names $dry]]]]]]
  # every map's pairs, one flat sequence: a [?for] that yields each map's
  # sequence already adopts its members, so a second [in] over a "map" walked
  # a [pair] element's (empty) children and every multi-repository run
  # printed zero re-pins — the fixture's case A found it.
  [= $all-map [?if $dry [then ()] [else [$fp:flat-map $names [?fn ($n) [$read-map [$cat ($work, "/", $n, ".map")]]]]]]]
  [= $_repins [?if $dry [then ()] [else [$print-repins $names $work $all-map]]]]
  [= $bad [?for [in $r $results] [where [not $r@clean]] [yield $r]]]
  [$print-verdict $bad [$string [$count $results]] $mode]]
