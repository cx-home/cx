# scripts/check_version_consistency.cx — the VERSION-CONSISTENCY gate.
#
# CX rewrite of scripts/check_version_consistency.py (RULED: PYE-5,
# ledger/rulings_2026_08_22_python_eradication.md; #922).
#
# The repo-root VERSION file is the single source of truth for the CX
# release version; every place that must carry a literal release version
# has to match it, and the code surfaces must DERIVE it.
#
# Four checks (same contract as the retired Python):
#   1. STATIC MANIFESTS equal VERSION exactly (stamped by
#      scripts/bump_version.sh).
#   2. CODE SURFACES derive via the `cx_version` build define
#      (`$d('cx_version', …)`) — never hardcode.
#   2b. THE DEFINE IS ACTUALLY PASSED to every shared-library recipe,
#      and the values it stamps are part of the library's build
#      identity (#984). Deriving is only half the contract: libcx
#      derived correctly for years while the `lib` recipe passed no
#      version defines at all, so the C-ABI `cx_version()` answered
#      the unstamped fallback in every build, release artifacts
#      included. The artifact-side pin is tests/abi/c_abi_test.c;
#      this static half catches the STALENESS case no runtime test
#      can see — a stamp outside LIB_BUILD_ID lets the up-to-date
#      guard hand back a library whose stamp is a lie.
#   3. README version badges + SECURITY.md supported series (X.Y.x)
#      equal / derive from VERSION.
#   4. STRAY `vX.Y.Z` release literals in every live tree of this
#      repository (issue #67; widened by #1166 C1 to the published and
#      internal trees a reader follows — examples/, conformance/,
#      corpus/, registry/, scripts/, tooling/, spec/, docs-src/ (its .tmpl
#      templates too) and the root README/ROADMAP/CONTRIBUTING/SECURITY),
#      — fails on any hit outside the allowlist (a bare `version='0.8.0'`
#      attribute is not read: a feature's or package's own version is
#      spelled the same way, so #1166 A1's tour attributes were fixed by
#      hand); a line carrying the
#      `version-literal-ok` marker is exempt. A per-run self-test
#      proves the matcher still has detection power.
#   5. DEAD SPEC PATHS (#1166 C1): every `spec/….md|.ebnf|.txt` a live file
#      of those trees (and the Makefile) names must resolve — in this tree,
#      or in a pinned repository's checkout under deps/<repo>/ (RS-8: since
#      the split most of the spec lives in the pins). A path a self-test
#      plants on purpose carries the `spec-path-ok` marker on its line.
#
# Matcher note (this rewrite): the Python anchored the stray pattern
# with lookarounds; RE2 has none, so the boundary is spelled as a
# consumed non-alphanumeric-or-edge class on each side. For per-line
# EXISTENCE (all this gate needs) the two are equivalent; the self-test
# below proves both directions on the same fixtures the Python used.
#
# Run:  cx --allow-read --allow-write scripts/check_version_consistency.cx
# (or:  make check-version-consistency / make bump-version-check)
#
# Exit: 0 all green; 1 any failure (including a broken self-test).

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/strings' as=strings]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]

# cat-seqs: concatenate a tuple of sequences (sequence literals nest;
# flat-map with identity removes exactly one level).
[?def cat-seqs scope=public ($ss) [$fp:flat-map $ss [?fn ($x) $x]]]

# ── Check 4: stray release-version literal scan ─────────────────────────
# A CX release version written `vX.Y.Z` (or a release series `vX.Y.x`),
# anchored on non-alphanumeric-or-edge boundaries (see matcher note).
[?const STRAY-RX [$re:compile "(?:[^A-Za-z0-9]|^)v[0-9]+\\.[0-9]+\\.(?:[0-9]+|x)(?:[^A-Za-z0-9]|$)"]]
[?const STRAY-MARKER "version-literal-ok"]

# Live trees scanned for stray literals: (root, extensions). spec/_archived
# is immutable history (excluded); *_test.v fixtures are excluded.
# spec/02-working scan row RETIRED here (RULED: RS-12, D59a; #1591 item K3):
# the directory left whole for cx-decisions with the rest of the ledger's
# working-spec estate; a stray-literal scan of it is that repository's own
# concern now, not this tree's.
[?const STRAY-SCAN (
  [scan root='vcx'              exts='v'],
  [scan root='spec/01-new'      exts='md ebnf'],
  [scan root='spec/03-approved' exts='md ebnf'],
  [scan root='docs-src'         exts='md cx cxd html'],
  [scan root='stdlib'           exts='cx'],
  [scan root='tooling'          exts='md json vim lua bash zsh fish js scm cx cxd'],
  [; #1166 C1: the trees the 2026-08-31 sweep found unscanned, as they stand
     in this repository after the split ]
  [scan root='examples'         exts='cx cxd md html'],
  [scan root='conformance'      exts='md cxd'],
  [scan root='corpus'           exts='cx md'],
  [scan root='registry'         exts='cxd'],
  [scan root='scripts'          exts='cx cxd sh md mk'],
  [scan root='docs-src'         exts='tmpl'])]

# Root documents scanned whole (#1166 C1).
[?const STRAY-FILES ('README.md', 'ROADMAP.md', 'CONTRIBUTING.md', 'SECURITY.md')]

# ── Check 5: dead spec paths (#1166 C1) ─────────────────────────────────
# A citation may name its repository, `<repo>:spec/…` or a GitHub URL
# `github.com/cx-home/<repo>/blob/<ref>/spec/…`: one deps.cxd pins is
# resolved in its checkout; one registry/repos.cxd names but this tree does
# not pin (cx-decisions — the process specs, the working and archived spec
# trees since the split) cannot be read here and is taken as the deliberate
# cross-repository citation it spells. An unprefixed path resolves here or in
# any pin.
[?const SPEC-PATH-RX [$re:compile "(?:([a-z][a-z0-9-]*):|github\\.com/cx-home/([a-z0-9-]+)/(?:blob|tree)/[^/ )]+/)?(spec/[A-Za-z0-9_./-]+\\.(?:md|ebnf|txt))"]]
[?const REPO-ROW-RX [$re:compile "\\[repo name=([a-z0-9-]+)"]]
[?const SPEC-MARKER "spec-path-ok"]

# Dirs never scanned (build artifacts / vendored deps / immutable history).
[?const STRAY-EXCLUDE-DIRS ('node_modules','dist','_archive','_archived',
                            '_gate_evidence')]

# Whole files allowed to carry release literals (and the spec paths of
# their day) as legitimate history.
[?const STRAY-ALLOW-FILES (
  'docs-src/canonical/sections/10-migration.cxd',
  'ledger/partition_I5_audit.md')]

[?def excluded scope=public ($p)
  [> [$count [?for [in $d STRAY-EXCLUDE-DIRS]
       [where [$strings:contains $p [$concat "/" $d "/"]]]
       [yield $d]]] 0]]

[?def allowed-file scope=public ($p)
  [> [$count [?for [in $a STRAY-ALLOW-FILES]
       [where [= $a $p]] [yield $a]]] 0]]

# stray-hits-in: one "path:line: text" entry per stray literal in one file
# (already prefiltered to files whose whole text matches).
[?def stray-line scope=public ($line)
  [?match [$re:find STRAY-RX $line] [case () false] [else true]]]
# A history block — a released-versions table, say — is exempt whole between
# a line carrying `version-literal-ok:begin` and one carrying
# `version-literal-ok:end` (in Markdown, inside an HTML comment, so a reader
# never sees it); every line between is a deliberate survivor (#1166 C1).
[?def in-history-block scope=public ($lines $i)
  [?let [= $opens [?for [in $k [$range 1 $i]] [where [$strings:contains [$nth $lines $k] [$concat STRAY-MARKER ":begin"]]] [yield $k]]]
        [= $closes [?for [in $k [$range 1 $i]] [where [$strings:contains [$nth $lines $k] [$concat STRAY-MARKER ":end"]]] [yield $k]]]
    [> [$count $opens] [$count $closes]]]]
[?def stray-hits-in-text scope=public ($p $text)
  [?let [= $lines [$strings:split-lines $text]]
        [= $blocks [$strings:contains $text [$concat STRAY-MARKER ":begin"]]]
    [?for [in $i [$range 1 [$count $lines]]]
      [= $line [$nth $lines $i]]
      [where [not [$strings:contains $line STRAY-MARKER]]]
      [where [$stray-line $line]]
      [where [not [and $blocks [$in-history-block $lines $i]]]]
      [; the README version badge is check 3's: stamped by bump_version.sh, equal to VERSION ]
      [where [not [$strings:contains $line "badge/version-v"]]]
      [yield [$concat $p ":" [$string $i] ": " [$strings:trim-end $line]]]]]]
[?def stray-hits-in scope=public impure ($p)
  [$stray-hits-in-text $p [$io:read-file $p]]]

# live-files: every file of the scanned trees and the root documents.
[?def live-files scope=public impure ()
  [$cat-seqs (
    [?for [in $sc STRAY-SCAN]
      [in $ext [$strings:split-whitespace [$string $sc@exts]]]
      [in $p [$io:glob [$concat [$string $sc@root] "/**/*." [$string $ext]]]]
      [where [not [$strings:ends-with $p "_test.v"]]]
      [where [not [$excluded $p]]]
      [yield $p]],
    [?for [in $f STRAY-FILES] [where [$io:exists $f]] [yield $f]])]]

# stray-hits: every live file; per-line.
[?def stray-hits scope=public impure ()
  [?for [in $p [$live-files]]
    [where [not [$allowed-file $p]]]
    [in $hit [$stray-hits-in $p]]
    [yield $hit]]]

# spec-resolves: the path exists under one of the bases — this tree ('.')
# or a pin's checkout (deps/<repo>).
[?def spec-resolves scope=public impure ($path $bases)
  [> [$count [?for [in $d $bases] [where [$io:exists [$concat $d "/" $path]]] [yield $d]]] 0]]

# dead-spec-hits-in: one "path:line: spec/…" per unresolved citation; a
# path is read up to its extension (a trailing '.' of prose is not part).
[?def dead-spec-hits-in scope=public impure ($p $bases)
  [?let [= $lines [$strings:split-lines [$io:read-file $p]]]
    [?for [in $i [$range 1 [$count $lines]]]
      [= $line [$nth $lines $i]]
      [where [not [$strings:contains $line SPEC-MARKER]]]
      [in $m [$re:find-all SPEC-PATH-RX $line]]
      [= $r1 [$string [?else [$re:group $m 1] ""]]]
      [= $repo [?if [= $r1 ""] [then [$string [?else [$re:group $m 2] ""]]] [else $r1]]]
      [= $sp [$re:group $m 3]]
      [where [not [?if [= $repo ""] [then [$spec-resolves $sp $bases]]
                    [else [?if [$io:is-directory [$concat "deps/" $repo]]
                            [then [$spec-resolves $sp ([$concat "deps/" $repo],)]]
                            [else [$has-repo $repo]]]]]]]
      [yield [$concat $p ":" [$string $i] ": " [?if [= $repo ""] [then ""] [else [$concat $repo ":"]]] $sp]]]]]

# has-repo: registry/repos.cxd carries a row of that name.
[?def has-repo scope=public impure ($repo)
  [> [$count [?for [in $m [$re:find-all REPO-ROW-RX [?else [$io:read-file "registry/repos.cxd"] ""]]]
               [where [= [$re:group $m 1] $repo]] [yield 1]]] 0]]

[?def dead-spec-hits scope=public impure ()
  [?let [= $bases [$cat-seqs ((".",), [$io:glob "deps/*"])]]
    [?for [in $p [$cat-seqs ([$live-files], ('Makefile',))]]
      [where [not [$allowed-file $p]]]
      [in $hit [$dead-spec-hits-in $p $bases]]
      [yield $hit]]]]

# self-test: prove the matcher has detection power and no obvious false
# positives — a matcher that silently stops matching turns this gate into
# a no-op; these assertions make that a red build.
[?const MUST-MATCH (
  [$concat "// shipped in v" "0.8.0"],
  [$concat "**Status:** Current for v" "0.11.0."],
  [$concat "error('only foo is recognised at v" "0.7.6')"],
  [$concat "see v" "1.2.3-rc1 notes"],
  [$concat "deferred to v" "0.8.x refinement"])]
[?const MUST-NOT-MATCH (
  "// see §9.1.2 and §6.4.2",
  "bind_host := '127.0.0.1'",
  "const version = $d('cx_version', '0.0.0-dev')",
  "pub const cx_bundled_stdlib_version = '0.8.0'",
  "url = 'https://x/regex-helpers-1.2.3.zip'",
  "the v0.8.xyz identifier is not a version")]

[?def rx-hits scope=public ($s) [$stray-line $s]]
[?def self-test scope=public impure ()
  [?let [= $marked "// kept as history v0.8.0  // version-literal-ok"]
    [$cat-seqs (
      ([?for [in $s MUST-MATCH] [where [not [$rx-hits $s]]]
        [yield [$concat "self-test: matcher FAILED to flag a stray literal: '" $s "'"]]]),
      ([?for [in $s MUST-NOT-MATCH] [where [$rx-hits $s]]
        [yield [$concat "self-test: matcher false-positived on: '" $s "'"]]]),
      [$spec-self-test],
      [?let [= $h [$stray-hits-in-text "t" [$concat "a v" "0.1.0 line\n<!-- " STRAY-MARKER ":begin -->\n| v" "0.2.0 | x |\n<!-- "
                                                   STRAY-MARKER ":end -->\nafter v" "0.3.0\n"]]]
        [?if [and [= [$count $h] 2] [$strings:contains [$string [$first $h]] "t:1:"] [$strings:contains [$string [$nth $h 2]] "t:5:"]]
          [then ()]
          [else ([$concat "self-test: the history block did not exempt exactly its own lines: " [$strings:join [?for [in $x $h] [yield [$string $x]]] " | "]],)]]],
      [?if [and [$strings:contains $marked STRAY-MARKER] [$rx-hits $marked]]
        [then ()]
        [else ("self-test: marker fixture is malformed")]])]]]

# spec-self-test: a planted tree — a live path here, a live path only in a
# planted pin, a dead path, a dead path on a marked line, a path ended by
# prose punctuation, a cx-decisions: citation (a registry repository this
# tree does not pin) and one naming no repository row — must yield exactly
# the dead unmarked path and the unknown repository's.
[?def spec-self-test scope=public impure ()
  [?let [= $root [$io:temp-dir "spec-paths-"]]
        [= $_a [$io:make-dirs [$concat $root "/spec/03-approved/core"]]]
        [= $_b [$io:write-file [$concat $root "/spec/03-approved/core/code.md"] "x"]]
        [= $_c [$io:make-dirs [$concat $root "/pin/spec/03-approved/std-lib"]]]
        [= $_d [$io:write-file [$concat $root "/pin/spec" "/03-approved/std-lib/io.md"] "x"]]
        [= $f [$concat $root "/doc.md"]]
        [= $_e [$io:write-file $f [$concat "see spec/03-approved/core/code.md.\n"
                                       "and spec" "/03-approved/std-lib/io.md\n"
                                       "the old spec" "/code.md is gone\n"
                                       "planted spec/thing.md -- " "spec-path-ok\n"
                                       "cx-decisions:spec/03-approved/core/cx_partition.md\n"
                                       "nosuchrepo:spec" "/03-approved/core/cx_partition.md\n"]]]
        [= $hits [$dead-spec-hits-in $f ($root, [$concat $root "/pin"])]]
        [= $_r [$io:remove-tree $root]]
    [?if [and [= [$count $hits] 2] [$strings:ends-with [$string [$first $hits]] [$concat ":3: spec" "/code.md"]]
              [$strings:ends-with [$string [$nth $hits 2]] [$concat ":6: nosuchrepo:spec" "/03-approved/core/cx_partition.md"]]]
      [then ()]
      [else ([$concat "self-test: the dead-spec-path check answered " [$string [$count $hits]]
                      " hit(s) on the planted tree (want line 3's dead path and line 6's unknown-repository citation): "
                      [$strings:join [?for [in $h $hits] [yield [$string $h]]] " | "]],)]]]]

# read-or: file text, or the [missing] sentinel.
[?def read-or scope=public impure ($p)
  [?match [$io:read-file $p]
    [case [err$e] [missing]]
    [case $t $t]]]

# check-manifest: () when the manifest's version field equals $version;
# a fail-line otherwise.
[?def check-manifest scope=public impure ($path $pattern $version)
  [?let [= $t [$read-or $path]]
    [?match $t
      [case [missing] [$concat $path ": missing (expected a stamped manifest)"]]
      [else
        [?match [$re:find [$re:compile $pattern] $t]
          [case () [$concat $path ": no version field matched '" $pattern "'"]]
          [case $m
            [?if [= [$re:group $m 1] $version] [then ()]
              [else [$concat $path ": version '" [$re:group $m 1]
                             "' != VERSION '" $version "'"]]]]]]]]]

[?let
  [= $version [$strings:trim [$io:read-file "VERSION"]]]
  [= $version-ok [$re:matches [$re:compile "[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?"] $version]]
  [?if [not $version-ok]
    [then [?let [= $_m [$say [$concat "FAIL: VERSION file holds a malformed version: '" $version "'"]]]
            [$env:exit 1]]]
    [else
      [?let
        # 1. Static manifests — must contain the literal VERSION.
        # lang/v/v.mod, lang/rust/cxlib/Cargo.{toml,lock} and lang/python/pyproject.toml
        # rows RETIRED (RULED: RS-12, RS-8; #1591 item K3): the four active
        # bindings left cx-private whole as cx-home/cx-binding-{v,rust,python,go}
        # and each now stamps its own manifest in its own repository — this
        # tree no longer carries a checkout to check. vcx/v.mod (the V FORK's
        # own manifest, not a binding's) stays. tooling/vscode/package{,-lock}.json
        # rows RETIRED the same way (RULED: RS-12, D59a): the VS Code extension left
        # with cx-tooling, which stamps its own manifest.
        [= $manifest-fails [?for [in $m (
            [mf path='deps/cx-core-code/cx.pc.in'                          rx="(?m)^Version:[ \\t]*([^ \\t\\n]+)[ \\t]*$"],
            [mf path='deps/cx-core-code/vcx/v.mod'                         rx="version:\\s*'([^']+)'"])]
          [= $f [$check-manifest [$string $m@path] [$string $m@rx] $version]]
          [where [not [$empty $f]]]
          [yield $f]]]

        # 2. Code surfaces — must DERIVE from the build define.
        [= $derive-fails [?for [in $p ('deps/cx-core-data/vcx/cx/cabi.v', 'deps/cx-core-code/vcx/cmd/main.v')]
          [where [not [$strings:contains [$io:read-file $p] "$d('cx_version'"]]]
          [yield [$concat $p ": release version must derive via $d('cx_version'…), not a hardcoded literal"]]]]

        # 2b. The define must actually be PASSED to every shared-library
        # recipe, and LIB_BUILD_ID must carry what those defines stamp (#984).
        [= $mk-lines [$strings:split-lines [$io:read-file "deps/cx-core-code/vcx/Makefile"]]]
        [= $lib-recipe-fails [?for [in $l $mk-lines]
          [where [$strings:contains $l "-shared -o "]]
          [where [not [$strings:contains $l "$(LIB_VERSION_DEFINES)"]]]
          [yield [$concat "deps/cx-core-code/vcx/Makefile: a shared-library recipe passes no version defines — "
                          "libcx would report the unstamped fallback (add $(LIB_VERSION_DEFINES)): "
                          [$strings:trim $l]]]]]
        [= $lib-build-id-lines [?for [in $l $mk-lines]
          [where [$strings:starts-with $l "LIB_BUILD_ID "]]
          [yield $l]]]
        [= $lib-build-id-fails
          [?if [= [$count $lib-build-id-lines] 0]
            [then ("deps/cx-core-code/vcx/Makefile: no LIB_BUILD_ID assignment found — the up-to-date guard's identity cannot be checked")]
            [else [?for [in $l $lib-build-id-lines]
              [in $v ("$(CX_VERSION)", "$(CX_RELEASE)")]
              [where [not [$strings:contains $l $v]]]
              [yield [$concat "deps/cx-core-code/vcx/Makefile: LIB_BUILD_ID omits " $v
                              " — the library stamps it, so the relink guard could serve an "
                              "artifact whose version stamp no longer matches this tree"]]]]]]

        # 3. README version badges must equal VERSION.
        [= $badge [$concat "badge/version-v" $version "-blue"]]
        [= $badge-rx [$re:compile "badge/version-v([0-9A-Za-z.]+)-blue"]]
        [= $badge-fails [?for [in $p ('README.md', 'deps/cx-core-code/vcx/README.md')]
          [= $f [?match [$read-or $p]
            [case [missing] [$concat $p ": missing (expected the version badge)"]]
            [case $t
              [?if [$strings:contains $t $badge] [then ()]
                [else [?match [$re:find $badge-rx $t]
                  [case () [$concat $p ": version badge 'no version badge' != VERSION '" $version "'"]]
                  [case $m [$concat $p ": version badge '" [$re:group $m 1] "' != VERSION '" $version "'"]]]]]]]]
          [where [not [$empty $f]]]
          [yield $f]]]

        # 3b. SECURITY.md — the supported-versions series (X.Y.x).
        [= $series [$concat [$strings:join [?for [in $i (1,2)]
            [yield [$nth [$strings:split $version "."] $i]]] "."] ".x"]]
        [= $security-fails [?match [$read-or "SECURITY.md"]
          [case [missing] ("SECURITY.md: missing (expected the supported-series text)")]
          [case $t
            [?match [$re:find [$re:compile "\\*\\*([0-9]+\\.[0-9]+\\.x)\\*\\*"] $t]
              [case () ("SECURITY.md: no bolded supported-series token (**X.Y.x**) found")]
              [case $m
                [?if [= [$re:group $m 1] $series] [then ()]
                  [else ([$concat "SECURITY.md: supported series '" [$re:group $m 1]
                                  "' != '" $series "' (derived from VERSION '" $version "')"])]]]]]]]

        # 0. Self-test — prove the stray-literal matcher still has teeth.
        [= $st [$self-test]]
        [?if [> [$count $st] 0]
          [then
            [?let [= $_h [$say "VERSION-CONSISTENCY: FAIL (gate self-test broken — fix the matcher)"]]
                  [= $_l [?for [in $e $st] [yield [$say [$concat "  - " $e]]]]]
              [$env:exit 1]]]
          [else
            [?let
              # 4. Stray release-version literals in live code/spec (#67).
              [= $stray [?for [in $h [$stray-hits]]
                [yield [$concat "stray version literal (genericize or derive): " $h]]]]
              # 5. Dead spec paths (#1166 C1).
              [= $dead [?for [in $h [$dead-spec-hits]]
                [yield [$concat "dead spec path (no such file here or in a pin): " $h]]]]
              [= $fails [$cat-seqs ($manifest-fails, $derive-fails, $lib-recipe-fails,
                                    $lib-build-id-fails, $badge-fails,
                                    $security-fails, $stray, $dead)]]
              [?if [> [$count $fails] 0]
                [then
                  [?let
                    [= $_h [$say [$concat "VERSION-CONSISTENCY: FAIL (source of truth: VERSION = " $version ")"]]]
                    [= $_l [?for [in $f $fails] [yield [$say [$concat "  - " $f]]]]]
                    [= $_f [$say [$concat "\nFix: stamped manifests → run  scripts/bump_version.sh <version>; "
                      "code version surfaces → derive via $d('cx_version', …); "
                      "stray `vX.Y.Z` literals in code/spec → genericize the prose "
                      "(an error/status describes CURRENT behavior, never a release), "
                      "or add the inline `" STRAY-MARKER "` marker for a genuine "
                      "historical-migration note; a dead spec path → name the file that "
                      "exists (here or in deps/<repo>/), or `" SPEC-MARKER "` on a planted one."]]]
                    [$env:exit 1]]]
                [else
                  [?let [= $_ok [$say [$concat "VERSION-CONSISTENCY: OK — manifests + README badges + vscode + "
                      "SECURITY.md series == VERSION (" $version "); cabi.v + main.v derive "
                      "from the build define; every shared-library recipe passes it and "
                      "LIB_BUILD_ID carries what it stamps; no stray release literal and no dead "
                      "spec path in " [$string [$count [$live-files]]] " live files (#1166)"]]]
                    [$env:exit 0]]]]]]]]]]]
