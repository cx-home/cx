# scripts/ring_import_gate_selftest.cx — proves ring_import_gate.cx is RED on every violation class
# it claims to catch (audit F-17 / register R3.10).
#
# ISOLATION (hard requirement): probes are written into a FAKE vcx tree under a temp dir and the gate
# is pointed at it via RING_GATE_ROOT — NEVER into the live vcx/. A synthetic .v file in the real
# vcx/cx/ gets COMPILED by any concurrently-running build job (parallel make), which is exactly how
# the first version of this selftest broke test-extraction-gate (the probe's
# `#include "../code/…"` failed the cli-data-dev build mid-flight).
# The gate runs on the cx running this program (TOOL_CX from the Makefile).
# CXMACH-1 (owner 2026-10-16, (a)): the cx rewrite of ring_import_gate_selftest.sh, the same probes
# and lines.
#   $(TOOL_CX) --allow-all scripts/ring_import_gate_selftest.cx
# Exit: 0 = every probe went red AND the live tree is green;
#       1 = a probe did NOT fail (a live bypass) or the live tree is red.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/strings' as=strings]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$env:write-line $s]]
[?def lines scope=public ($xs) [$strings:join $xs "\n"]]

# gate — [g ok= out=] for one run of the gate on ROOT ('' = the live tree).
[?def gate scope=public impure ($script $root)
  [?let [= $r [$process:run ([$env:executable-path], '--allow-read', '--allow-env', '--allow-subprocess', $script)
                            env=[?if [= $root ''] [then null] [else {RING_GATE_ROOT: $root}]] capture=:both]]
    [?match $r [case [err$e] [g ok=false out=[$string $e]]]
      [else [g ok=[= $r@exit-code 0] out=[$cat ([$string $r@stdout], [$string $r@stderr])]]]]]]
[?def put scope=public impure ($p $s) [$io:write-file $p [$cat ($s, "\n")]]]

# probe — write CONTENT at REL under the fake vcx/, expect the gate RED there, remove it, expect the
# fake tree green again. Returns [p fail= line=].
[?def probe scope=public impure ($script $fake $name $rel $content)
  [?let [= $p [$cat ($fake, '/vcx/', $rel)]]
        [= $_w [$put $p $content]]
        [= $red [not [$gate $script $fake]@ok]]
        [= $_r [$io:remove $p]]
    [?if [not $red]
      [then [p fail=true line=[$cat ('SELFTEST FAIL [', $name, ']: the gate did NOT flag ', $rel, ' — this bypass is live.')]]]
      [else [?if [not [$gate $script $fake]@ok]
              [then [p fail=true line=[$cat ('SELFTEST FAIL [', $name, ']: the fake tree is not clean after removing ', $rel, '.')]]]
              [else [p fail=false line=[$cat ('  ok — ', $name, ' (gate went red on the synthetic violation)')]]]]]]]]

# allowed — write the files, expect the gate GREEN, remove them. Returns [p fail= line=].
[?def allowed scope=public impure ($script $fake $files $okline $failline)
  [?let [= $_w [?to-sequence [?for [in $f $files] [yield [$put [$cat ($fake, '/vcx/', [$nth $f 1])] [$nth $f 2]]]]]]
        [= $green [$gate $script $fake]@ok]
        [= $_r [?to-sequence [?for [in $f $files] [yield [$io:remove [$cat ($fake, '/vcx/', [$nth $f 1])]]]]]]
    [?if $green [then [p fail=false line=$okline]] [else [p fail=true line=$failline]]]]]

[?let
  [= $root [$path:dirname [$path:dirname [$path:absolute [$nth [$env:argv] 1]]]]]
  [= $script [$cat ($root, '/scripts/ring_import_gate.cx')]]
  # live-tree baseline (read-only — no writes to the real vcx/)
  [?if [not [$gate $script '']@ok]
    [then [?do [$say 'SELFTEST FAIL: the gate is RED on the live tree — fix that first.'] [$env:exit 1]]]
    [else [?let
      # fake tree: the sibling-dir set the deny-set derivation needs, empty. RS-24: two declared V
      # product modules -- a lower one (net) and xap, the one above the residue since xap's split --
      # so the product checks are probed too.
      [= $fake [$io:temp-dir 'ring_gate_selftest.']]
      [= $_d [?to-sequence [?for [in $d ('cx', 'code', 'cxstore', 'arrow', 'transport', 'cli', 'cmd_data', 'grading', 'deps', 'target', 'fixtures', 'testenv', 'cxnet', 'xap')]
                             [yield [$io:make-dirs [$cat ($fake, '/vcx/', $d)]]]]]]
      [= $_g [$io:make-dirs [$cat ($fake, '/registry')]]]
      [= $_r [$put [$cat ($fake, '/registry/repos.cxd')] '[repo-allocation [repo name=cx-platform-net vmodule=cxnet] [repo name=cx-platform-xap vmodule=xap]]']]
      [= $_h [$say [$cat ('ring_import_gate selftest (isolated fake tree: ', $fake, '):')]]]
      [= $pr [?fn ($r) [?let [= $_ [$say $r@line]] $r@fail]]]
      [= $fails1 [?to-sequence [?for [in $c (
          # ── F-17 bypass #1: relative ../<sibling> C include from Ring 0 ──
          ('rel-dotdot-include', 'cx/selftest_rel_probe.v', "module cx\n#include \"../code/cx_stack_guard.h\""),
          # ── F-17 bypass #2: @VMODROOT/../vcx/<sibling> up-and-back-down escape ──
          ('vmodroot-updown', 'cx/selftest_updown_probe.v', "module cx\n#flag -I @VMODROOT/../vcx/code"),
          # ── F-17 bypass #3: a RAW .c file in a ring dir including a sibling header ──
          ('raw-c-include', 'cx/selftest_raw_probe.c', "#include \"../cxnet/whatever.h\"\nint selftest_raw(void){return 0;}"),
          # ── the classic V import edge (M34) still caught ──
          ('v-import', 'cx/selftest_import_probe.v', "module cx\nimport code"),
          # ── narrowed allowlist: regex_re2.v may NOT reach a DIFFERENT sibling via a C edge just
          #    because it is the allowlisted file ──
          ('allowlist-not-blanket', 'cx/selftest_re2_blanket.v', "module cx\n#flag -I @VMODROOT/deps/some_other_dir\n#flag -L @VMODROOT/code"),
          # ── new check: arrow (leaf) importing a non-cx sibling ──
          ('arrow-leaf', 'arrow/selftest_arrow_probe.v', "module arrow\nimport cxnet"),
          # ── new check: cli must stay platform-free ──
          ('cli-platform-free', 'cli/selftest_cli_probe.v', "module cli\nimport cxnet"),
          # ── new check: cmd_data must stay platform-free ──
          ('cmd_data-platform-free', 'cmd_data/selftest_cmddata_probe.v', "module main\nimport cxstore"),
          # ── D56a: the corpus grading cores are Ring 0 — the evaluator is denied ──
          ('grading-imports-code', 'grading/selftest_grading_probe.v', "module grading\nimport code"))]
        [yield [$pr [$probe $script $fake [$nth $c 1] [$nth $c 2] [$nth $c 3]]]]]]]
      # ── ...and grading over cx + fixtures, with cmd_data importing grading, stays GREEN ──
      [= $f2 [$pr [$allowed $script $fake (('grading/selftest_grading_ok.v', "module grading\nimport cx\nimport fixtures"),
                                          ('cmd_data/selftest_cmddata_grading.v', "module main\nimport grading"))
                    '  ok — grading-over-data-ring (grading importing cx and fixtures, cmd_data importing grading, is allowed)'
                    'SELFTEST FAIL [grading-over-data-ring]: the gate refused grading over cx + fixtures or cmd_data importing grading.']]]
      [= $fails3 [?to-sequence [?for [in $c (
          # ── Ring 1 (code) importing the platform group's composer (xap) ──
          ('code-imports-xap', 'code/selftest_code_probe.v', "module code\nimport xap"),
          # ── RS-24: Ring 1 importing a split product module ──
          ('code-imports-product', 'code/selftest_code_product_probe.v', "module code\nimport cxnet"),
          # ── RS-24: a product module importing a non-platform sibling ──
          ('product-imports-cli', 'cxnet/selftest_product_probe.v', "module cxnet\nimport cli"),
          # ── RS-24, xap's split: a lower product importing xap ──
          ('product-imports-xap', 'cxnet/selftest_xap_probe.v', "module cxnet\nimport xap"))]
        [yield [$pr [$probe $script $fake [$nth $c 1] [$nth $c 2] [$nth $c 3]]]]]]]
      # ── ...and xap importing a lower product stays GREEN (the residue it once also imported is gone
      #    since xap's PHASE B, RULED: RS-24) ──
      [= $f4 [$pr [$allowed $script $fake (('xap/selftest_xap_down.v', "module xap\nimport cxnet"),)
                    '  ok — xap-imports-lower (xap over a lower product is allowed)'
                    'SELFTEST FAIL [xap-imports-lower]: the gate refused xap importing a product it pins.']]]
      # ── RS-1: the platform GROUP imports the rings and what its manifest declares (cxstore, arrow,
      #    transport) — nothing else. The profile-surface dirs are not in its graph ──
      [= $f5 [$pr [$probe $script $fake 'platform-group-undeclared' 'xap/selftest_group_probe.v' "module xap\nimport cli"]]]
      # ── RS-1: the words. Two rings, data and code, and the platform group above them; "Ring 2" left
      #    the vocabulary, so a violation in a product module is reported as the platform group's, and
      #    neither the refusal nor the live OK line names a Ring 2 ──
      [= $words-p [$cat ($fake, '/vcx/cxnet/selftest_words_probe.v')]]
      [= $_wp [$put $words-p "module cxnet\nimport cmd_data"]]
      [= $words-out [$gate $script $fake]@out]
      [= $_wr [$io:remove $words-p]]
      [= $live-out [$gate $script '']@out]
      [= $w1 [?if [$strings:contains $words-out 'platform group'] [then ()]
               [else ("SELFTEST FAIL [group-words]: a product-module violation is not reported as the platform group's (RULED: RS-1)",)]]]
      [= $both [$cat ($words-out, $live-out)]]
      [= $w2 [?if [or [$strings:contains $both 'Ring-2'] [$strings:contains $both 'Ring 2'] [$strings:contains $both 'Ring-3'] [$strings:contains $both 'Ring 3']]
               [then ('SELFTEST FAIL [ring-words]: the gate still names a Ring 2/Ring 3 — two rings, then groups (RULED: RS-1)',)] [else ()]]]
      [= $words-fail [> [+ [$count $w1] [$count $w2]] 0]]
      [= $_ww [$say [?if $words-fail [then [$lines ([?splice $w1], [?splice $w2])]]
                      [else '  ok — group-words (a product-module refusal names the platform group; no Ring 2/3 in the gate\'s words)']]]]
      # ── the PINNED layout (RULED: RS-7, RS-12): cx-core-data's modules live in deps/cx-core-data/vcx/,
      #    not vcx/. A second fake tree has them ONLY there: it is green clean, red when the pinned
      #    Ring 0 imports a sibling (the gate reads the pin, it does not skip a vcx/ directory that is
      #    no longer there), and red when a pinned module is in neither place. ──
      [= $pfake [$io:temp-dir 'ring_gate_selftest_pin.']]
      [= $_pd [?to-sequence [?for [in $d ('code', 'cxstore', 'transport', 'target', 'testenv')] [yield [$io:make-dirs [$cat ($pfake, '/vcx/', $d)]]]]]]
      [= $pv [$cat ($pfake, '/deps/cx-core-data/vcx')]]
      [= $_pp [?to-sequence [?for [in $d ('cx', 'arrow', 'cli', 'cmd_data', 'grading', 'deps', 'fixtures')] [yield [$io:make-dirs [$cat ($pv, '/', $d)]]]]]]
      [= $pin-fails
        [?if [not [$gate $script $pfake]@ok]
          [then [$pr [p fail=true line='SELFTEST FAIL [pinned-clean]: the pinned-layout fake tree is not green.']]]
          [else [?let
            [= $a [?let [= $f [$cat ($pv, '/cx/selftest_pinned_probe.v')]] [= $_ [$io:write-file $f "module cx\nimport code\n"]]
                        [= $red [not [$gate $script $pfake]@ok]] [= $_x [$io:remove $f]]
                    [$pr [?if $red [then [p fail=false line='  ok — pinned-ring0 (gate went red on a violation in deps/cx-core-data/vcx/cx)']]
                           [else [p fail=true line='SELFTEST FAIL [pinned-ring0]: the gate did NOT flag a violation in the PINNED Ring 0 — it stopped reading cx.']]]]]]
            [= $b [?let [= $f [$cat ($pv, '/grading/selftest_pinned_grading.v')]] [= $_ [$io:write-file $f "module grading\nimport code\n"]]
                        [= $red [not [$gate $script $pfake]@ok]] [= $_x [$io:remove $f]]
                    [$pr [?if $red [then [p fail=false line='  ok — pinned-grading (gate went red on an import of code in deps/cx-core-data/vcx/grading)']]
                           [else [p fail=true line='SELFTEST FAIL [pinned-grading]: the gate did NOT flag an import of code in the PINNED grading module (D56a).']]]]]]
            [= $c [?let [= $_ [$io:remove-dir [$cat ($pv, '/cli')]]] [= $red [not [$gate $script $pfake]@ok]]
                    [$pr [?if $red [then [p fail=false line='  ok — pinned-absent (gate went red on a module in neither vcx/ nor the pin)']]
                           [else [p fail=true line='SELFTEST FAIL [pinned-absent]: a module in neither vcx/ nor the pin passed — a ring the gate cannot read must fail.']]]]]]
            [or $a $b $c]]]]]
      [= $_clean [?do [$io:remove-tree $fake] [$io:remove-tree $pfake]]]
      [= $failed [or [> [$count [?for [in $x $fails1] [where $x] [yield 1]]] 0] $f2
                     [> [$count [?for [in $x $fails3] [where $x] [yield 1]]] 0] $f4 $f5 $words-fail $pin-fails]]
      [?if $failed
        [then [?do [$say 'ring_import_gate selftest: FAILED — see the live bypasses above.'] [$env:exit 1]]]
        [else [?do [$say 'ring_import_gate selftest: OK — every violation class goes red (isolated tree); live tree green.'] [$env:exit 0]]]]]]]]
