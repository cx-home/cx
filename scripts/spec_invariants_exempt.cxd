  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=author match='backed by a parity-matrix row before the gate accepts the divergence' reason='an obligation on the gate operator and binding authors']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=no-lane issue='cx-home/cx-core-code#28' match='`cx diagram` invoked on a fixed manifest of sentinel fixtures' reason='a CLI byte-golden over svg/png/mermaid: no corpus lane runs cx diagram and web/cx-diagram/golden/ does not exist']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=no-lane issue='cx-home/cx-private#1763' match='Gate 9 (diagram round-trip) **MUST** also pass' reason='gate 9 is test-code-diagram plus the round-trip V tests, run by this target']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=author match='`CHANGELOG.md` **MUST** carry the release entry' reason='an obligation on the release author; release-verify checks only that CHANGELOG.md exists']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=no-lane issue='cx-home/cx-private#1763' match='The 99th-percentile compile time **MUST** be' reason='gate 14, a manual bench lane (GATE_REGISTER row 14)']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=no-lane issue='cx-home/cx-private#1763' match='The throughput **MUST** be ≥ 200 MB/s' reason='gate 15, a manual bench lane; RED today, tracked by #804 (GATE_REGISTER row 15)']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=no-lane issue='cx-home/cx-private#1763' match='Every measured shape **MUST** actually stream' reason='gate 15 checks each shape reports a streaming mode and delivers more than one chunk']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=step held-by=release-flow-gate match='refuse to bump, tag, or publish on a red gate' reason='the release flow document refuses before its pivot on a red gate (simulated and one real refused run); scripts/release.sh named here no longer exists']

  [; ── the code ring: cx-core-code stdlib/*.md ── ]
  [exempt file='cx-core-code/spec/03-approved/stdlib/hash.md' class=author
    match='MUST be used when comparing hashes derived from secrets'
    reason='an obligation on the program author choosing a comparison; equals itself is graded by hash-025..028']
  [exempt file='cx-core-code/spec/03-approved/stdlib/re.md' class=author
