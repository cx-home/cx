  [exempt file='cx-core-code/spec/03-approved/stdlib/tar.md' class=author match='MUST treat stored names as untrusted' reason='an obligation on an io-layer consumer writing entries to disk; the codec half of the sentence (names reported as-is, no traversal in the pure codec) is graded by tar-022']
  [exempt file='cx-core-code/spec/03-approved/stdlib/zip.md' class=author match='MUST treat stored names as untrusted' reason='an obligation on an io-layer consumer writing entries to disk (zip-slip); the codec half of the sentence (names reported as-is) is graded by zip-035']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=quoted match='Per RFC 2119: **MUST**, **MUST NOT**' reason='the RFC 2119 definition of the keywords themselves, not a requirement']
  [; ── SPECINV-1 second pass: the pages the first pass did not read ── ]
  [exempt file='cx-core-data/spec/03-approved/core/schema.md' class=no-lane issue='cx-home/cx-core-data#24' match='| `:narrow` | a constraint tightened:' reason='cx schema compat is a CLI verb no corpus lane feeds and no make step calls; measured green (opt->req and a range shrink refuse class=narrow, exit 1)']
  [exempt file='cx-core-data/spec/03-approved/core/schema.md' class=no-lane issue='cx-home/cx-core-data#24' match='| `:remove` | attribute / child element / type declaration removed |' reason='cx schema compat is a CLI verb no corpus lane feeds and no make step calls; measured green (a removed attribute refuses class=remove, exit 1; --allow-remove derives)']
  [exempt file='cx-core-data/spec/03-approved/core/schema.md' class=no-lane issue='cx-home/cx-core-data#24' match='| `:reinterpret` | a declared type changed outside the join lattice;' reason='cx schema compat is a CLI verb no corpus lane feeds and no make step calls; measured green (int -> bool refuses class=reinterpret, exit 1, and --allow-remove does not rescue it)']
  [exempt file='cx-core-code/spec/03-approved/core/codec.md' class=step held-by=libcx-abi-gate match='they are NEVER extended, and a newly registered codec earns ABI reach' reason='the frozen cx_X_to_Y families are C ABI symbols; libcx-abi-gate pins the cx_* export surface, so a new family member moves the pinned surface and reds']
