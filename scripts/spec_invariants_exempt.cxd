  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=no-lane issue='cx-home/cx-core-code#29' match='the CX language server **MUST**' reason='vcx/cmd/lsp_features.v serves a View diagram CodeLens per top-level directive, but no corpus lane speaks LSP and lint_lsp_umbrella_test.v only checks the method answers']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=step held-by=test-vcx-code match='computed in signed 64-bit' reason='a saturating wait cannot be fed to the corpus (the retry wait is real, no mock opt-in); code_module_umbrella_test.v test_retry_backoff_strategies_compute_the_spec_table asserts the clamp']
  [exempt file='cx-core-code/spec/03-approved/core/code.md' class=step held-by=test-vcx-suite match='with no await MUST still ship the order' reason='only observable after the program value is produced; eval_semantics_umbrella_test.v test_fire_and_forget_completes_before_top_level_return grades it (ev-async-006 notes why no case can)']
