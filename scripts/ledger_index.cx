# scripts/ledger_index.cx -- the ledger's decision-id index (#1438, RULED: CFG-1).
#
# WHAT IT IS FOR. Every commit subject in this repo ends `(RULED: <id>)`, and
# `ledger/` is the decision store those ids point into -- but nothing mapped an
# id to the file and heading that carry it, so resolving `RULED: 1085-a` meant
# grepping 265 files. This program regenerates `ledger/README.md` as that map:
# id -> file -> heading.
#
# Eat-our-own-dog-food: written in CX and run as `cx <file>` (make ledger-index).
#
# WHAT AN ID IS. The token `<digits>-<part>[-<part>...]` (1085-a, 728-CK-10,
# 1058-T1.2-b) or `<LETTERS>-<digits>` (CFG-1, INT-5, OL-15, DG-1). An ISO date
# has the first shape and is excluded by name.
#
# DECLARED vs CITED. An id in a HEADING line is DECLARED there -- that is the
# decision's own text, and the three heading shapes in the store all work:
# `# RULED: 1085-a — ...`, `## RULED 1318-A`, and `## 1404-a — ...`. An id that
# appears only in body prose is CITED, and its row names every file that
# mentions it. Both tables are emitted: measured on the 2026-09-13 store, the
# heading table alone resolved 87 of the 130 ids the last 150 commit subjects
# name, and the two tables together resolve all of them.
#
# MODES. No argument regenerates ledger/README.md (exit 0). `--check` compares
# what it would write against what is on disk and exits 1 on drift, naming the
# first differing line -- that is `make ledger-index-check`, the drift step.
#
# Capabilities: glob / read-file need `read`; writing the index needs `write`.
# Run via:  vcx/target/cx --allow-read --allow-write scripts/ledger_index.cx
# (flags bind BEFORE the file -- everything after the file is program args.)

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/array'   as=array]
[?lib 'cx-stdlib/process' as=process]

# -- helpers ------------------------------------------------------------
# uniq-sorted: the distinct values of a sequence, ordered. `[?to-array]`
# materializes the comprehension (a sequence is not an array and
# `[$array:sort]` refuses one), and the duplicate walk compares each item
# with its predecessor in the sorted array.
[?def uniq-sorted scope=private pure [returns any] ($xs::any)
  [?let [= $a [$array:sort [?to-array $xs]]]
    [?to-array [?for [in $i [$range 1 [$count $a]]]
      [where [?if [= $i 1] [then true] [else [not [= [$nth $a $i] [$nth $a [- $i 1]]]]]]]
      [yield [$nth $a $i]]]]]]

# heading-text: a heading line with its leading `#` run and spacing removed,
# and every `|` escaped so the row cannot break the markdown table.
[?def heading-text scope=private pure [returns string] ($line::string)
  [$strings:replace [$strings:trim [$strings:trim-start-chars [$strings:trim $line] "#"]] "|" "\\|"]]

# -- the SUBJECT rule (#1447) -------------------------------------------
# A `(RULED: <id>)` in a commit subject is a claim that a decision governs the
# change. #1438's part 5 found seven ids claimed that way with no page behind
# them; a re-measure over every subject on release/0.18 found eleven. A token
# with no decision behind it is the failure mode this store exists to prevent,
# so `--check` resolves them all and refuses on the first that cannot be.
#
# It scans only tokens that PARSE as decision ids. Much of the history's
# `RULED:` clause is free prose -- `CR-1..CR-6 -- #1126 #1127 #1128`, `EN-4(i`,
# `1573 class D` -- and refusing prose would red the union on three years of
# subjects rather than on the thing #1447 is about.
#
# CX_LEDGER_SUBJECTS_FILE names a file of subjects, one per line, instead of
# git: that is what lets the selftest prove the rule on planted subjects
# without a repository, and it is the only way this reader takes its input
# other than from `git log`.
#
# A READ THAT FAILS IS REFUSED, NEVER COUNTED (#1738, CXF-8). The reader
# answers ('ok', <lines>) or ('refused', <why>). Measured on 63299f88a: with
# --allow-env or --allow-subprocess denied, the `?fallback` arms that used to
# sit here turned the capability denial into data — the env denial reached
# the id list as ONE element and the check said "1 decision id(s) … resolve
# to NO page" over an empty id line, and the subprocess denial became an empty
# history that "all resolve(s)", exit 0. A denied grant, a planted file that
# cannot be read and a `git log` that fails are each the check refusing to
# vouch, out loud, with the flag or the cause named (exit 2).
[?const SUBJECT-REF 'release/0.18']

# IDSH-1 (#1767) -- the rule that refuses an id-SHAPED token the id grammar
# does not parse binds from the decision on: IDSH-CUTOFF is the commit time of
# the ledger page that carries it (deb01933c, 2026-10-04T05:28:50Z). The
# history before it carries 83 distinct such tokens in its `RULED:` clauses
# (measured on deb01933c: T-1..T-9, sect-6, arc-2, CAPADDR-1, PKGFILE-1 ...);
# refusing them would red every head on subjects nobody can rewrite. So the
# history is split by ANCESTRY, not by a date a commit can be given (REFUTE-1
# l15): a subject of a commit the IDSH-1 page's commit (IDSH-COMMIT) does not
# reach is new, whatever its committer date; the commits it reaches are the
# history. A planted subjects file (CX_LEDGER_SUBJECTS_FILE -- the selftest,
# and cx-decisions, whose history has no IDSH-COMMIT) dates each line instead,
# `<epoch>\t<subject>`, judged new from IDSH-CUTOFF (that commit's time); a
# line it cannot date is new. The unresolved rule (#1447) reads every subject.
[?const IDSH-COMMIT 'deb01933c28d6d576499a962fa17613ec2d75678']
[?const IDSH-CUTOFF 1791091730]


# IDSH-EXEMPT (IDSH-1, #1767; the integrator's RULING to core of
# 2026-10-15T22:27:34Z) -- the commits on release/0.18, after IDSH-COMMIT,
# whose subjects cite a token the grammar does not parse and which no
# force-push may rewrite. Each is named by its full sha, so the exemption is
# per COMMIT: the same token in any other subject is refused as before. An
# exempt subject is read as history (mark 0000000000): its unparsed prose is
# not judged, and every id it does parse must still resolve (#1447).
#   4b845faed 132657bb3 eca8df2a9 1daef791e -- cx-private#1934 s2a cited
#   `S2A-1934`; the decision is CXBLD-1934 (its ledger page says so).
[?const IDSH-EXEMPT ('4b845faed9c078e1e2c83d0df7ef5334179fdc54',
                     '132657bb30bacfd51a19088cad71694f38ee49a7',
                     'eca8df2a9139a319b637b1e96c8386d6aaaea590',
                     '1daef791e6e759ec0c46cfab68f40b67fcbb728e')]

[?def git-new-argv scope=private pure [returns any] () ('git', 'log', SUBJECT-REF, [$concat '^' IDSH-COMMIT], '--format=%H%x09%s')]
[?def git-old-argv scope=private pure [returns any] () ('git', 'log', IDSH-COMMIT, '--format=%H%x09%s')]

# sha-line: a `<sha>\t<subject>` line as `<mark>\t<subject>` -- the history's
# mark when the commit is in IDSH-EXEMPT -- and any other line as $other. git
# answers every line in that shape; a planted subjects file may carry it too,
# which is how the selftest proves the exemption is per commit (R).
[?def sha-line scope=private pure [returns any] ($l $mark $other)
  [?let [= $m [$re:find [$re:compile "^([0-9a-f]{40})\t(.*)$"] $l]]
    [?match $m
      [case () $other]
      [else [?let [= $sha [$re:group $m 1]]
              [= $hits [$count [?for [in $x IDSH-EXEMPT] [where [= $x $sha]] [yield $x]]]]
              [$concat [?if [> $hits 0] [then '0000000000'] [else $mark]] "\t" [$re:group $m 2]]]]]]]

[?def git-lines scope=private impure [returns any] ($argv $mark)
  [?let [= $r [$process:run $argv]]
    [?match $r
      [case [err$e] ('refused', [$concat "cannot run `" [$strings:join $argv " "] "` -- " [$string $e@message]])]
      [else [?if [= [$string $r@exit-code] '0']
              [then ('ok', [?to-array [?for [in $l [$strings:split-lines [$string $r@stdout]]] [yield [$sha-line $l $mark [$concat $mark "\t" $l]]]]])]
              [else ('refused', [$concat "`" [$strings:join $argv " "] "` exited " [$string $r@exit-code] " -- "
                                         [$strings:trim [$string $r@stderr]]])]]]]]]

[?def subject-lines scope=private impure [returns any] ()
  [?let [= $planted [$env:var-or-default 'CX_LEDGER_SUBJECTS_FILE' '']]
    [?match $planted
      [case [err$e] ('refused', [$concat "cannot read CX_LEDGER_SUBJECTS_FILE -- " [$string $e@message]])]
      [else
        [?if [not [= $planted '']]
          [then [?let [= $t [$io:read-file $planted]]
                  [?match $t
                    [case [err$e] ('refused', [$concat "cannot read the planted subjects " $planted " -- " [$string $e@message]])]
                    [else ('ok', [?to-array [?for [in $l [$strings:split-lines $t]] [yield [$sha-line $l '9999999999' $l]]]],
                          [$concat "the subjects of " $planted])]]]]
          [else
            [?let [= $new [$git-lines [$git-new-argv] '9999999999']]
                  [= $old [$git-lines [$git-old-argv] '0000000000']]
              [?if [= [$first $new] 'refused'] [then $new]
                [else [?if [= [$first $old] 'refused'] [then $old]
                        [else ('ok', [?to-array [?for [in $xs ([$nth $new 2], [$nth $old 2])] [in $x $xs] [yield $x]]],
                               [$concat "a commit subject on " SUBJECT-REF])]]]]]]]]]]]

# ledger-files: every ledger page except the generated index itself.
[?def ledger-files scope=private impure [returns any] ()
  [?to-array [?for [in $f [$io:glob "ledger/*.md"]]
    [where [not [= [$path:basename $f] "README.md"]]]
    [yield $f]]]]

[; the third shape is the owner-letter id, D<digits><letter>[<digit>] -- D70a1,
   D59a -- parsed and resolved like the others since IDSH-1 (#1767). ]
[?let [= $id-rx   [$re:compile "\\b([1-9][0-9]{2,3}-(?:[A-Za-z][0-9]?[0-9A-Za-z.]{0,2}|[A-Z]{1,3}-[0-9]+[a-z]?)(?:-[0-9A-Za-z]{1,3})?|[A-Z]{2,6}-[0-9]+[a-z]?|D[0-9]+[a-z][0-9]?)\\b"]]
      [; an id-SHAPED token: letters, a dash, digits (CAPADDR-1, zzqx-9, T-1)
         or the owner-letter shape in any case or length (d70a, D7A). What
         is left of a `RULED:` clause once every parsed id is cut out of it
         must carry none (IDSH-1). ]
      [; the clause's text is cut into tokens at every character that is not a
         letter, a digit or a dash -- ASCII or a typographic one (U+2010 to
         U+2015), since CFG with an en dash and 1 is CFG-1 to a reader and to no
         regex (REFUTE-1 l02/l03) -- and a token whole is id-shaped when it is
         letters-or-digits after a leading letter, a dash, a digit (CAPADDR-1,
         zzqx-9, CX2-1), three or four digits, a dash, a letter (1085-a), or the
         owner-letter shape in any case. ]
      [= $gap-rx [$re:compile "[^A-Za-z0-9\\x{2010}-\\x{2015}-]+"]]
      [= $shape-rx [$re:compile "^(?:[A-Za-z][A-Za-z0-9]*[\\x{2010}-\\x{2015}-][0-9][A-Za-z0-9]*|[1-9][0-9]{2,3}[\\x{2010}-\\x{2015}-][A-Za-z][A-Za-z0-9]*|[Dd][0-9]+[A-Za-z][A-Za-z0-9]*)$"]]
      [; the `(RULED: ...)` clause: a new subject's runs to its LAST `)` so a
         parenthesis inside it cannot end it early (REFUTE-1 l05); the history
         keeps the first-`)` reading it was resolved under. ]
      [= $clause-new-rx [$re:compile "\\(RULED:.*\\)"]]
      [= $clause-old-rx [$re:compile "\\(RULED:[^)]*\\)"]]
      [= $dated-rx [$re:compile "^([0-9]{9,11})\t(.*)$"]]
      [= $date-rx [$re:compile "^(19|20)[0-9]{2}-[0-9]{2}"]]
      [= $files   [$ledger-files]]
      [= $check   [> [$count [?for [in $x [$env:argv]] [where [= $x "--check"]] [yield $x]]] 0]]
      [= $is-id   [?fn ($t::string)
                    [?match [$re:find $date-rx $t] [case () true] [else false]]]]
      [= $decls
        [?to-array [?for [in $f $files]
          [in $l [$strings:split-lines [$io:read-file $f]]]
          [where [$strings:starts-with $l "#"]]
          [in $m [$re:find-all $id-rx $l]]
          [where [$is-id [$re:group $m 1]]]
          [= $idv [$strings:lower [$re:group $m 1]]]
          [= $base [$path:basename $f]]
          [= $head [$heading-text $l]]
          [yield [rec id=$idv file=$base heading=$head]]]]]
      [= $cites
        [?to-array [?for [in $f $files]
          [in $m [$re:find-all $id-rx [$io:read-file $f]]]
          [where [$is-id [$re:group $m 1]]]
          [= $idv [$strings:lower [$re:group $m 1]]]
          [= $base [$path:basename $f]]
          [yield [rec id=$idv file=$base]]]]]
      [= $declared-ids [$uniq-sorted [?for [in $d $decls] [yield $d@id]]]]
      [= $cited-only   [$uniq-sorted
        [?for [in $c $cites]
          [where [= 0 [$count [?for [in $x $declared-ids] [where [= $x $c@id]] [yield $x]]]]]
          [yield $c@id]]]]
      [= $decl-rows
        [?to-array [?for [in $id $declared-ids]
          [in $d $decls]
          [where [= $d@id $id]]
          [yield [$concat "| `" $id "` | [" $d@file "](" $d@file ") | " $d@heading " |"]]]]]
      [= $cite-rows
        [?to-array [?for [in $id $cited-only]
          [yield [$concat "| `" $id "` | "
            [$strings:join
              [?for [in $fn [$uniq-sorted [?for [in $c $cites] [where [= $c@id $id]] [yield $c@file]]]]
                [yield [$concat "[" $fn "](" $fn ")"]]]
              ", "]
            " |"]]]]]
      [= $header [$concat
          "# The ledger index\n\n"
          "Every decision id this store carries, and where to read it. **Generated** by\n"
          "[`scripts/ledger_index.cx`](../scripts/ledger_index.cx) -- run `make ledger-index`\n"
          "after adding or editing a ledger page; `make ledger-index-check` is the drift step\n"
          "and fails when this file is stale. Do not edit it by hand.\n\n"
          "A commit subject ends `(RULED: <id>)`; this is how that id resolves.\n\n"
          "## Declared -- the heading that carries the decision\n\n"
          "| id | file | heading |\n|---|---|---|\n"]]
      [= $middle [$concat
          "\n\n## Cited only -- named in a page's prose, with no heading of its own\n\n"
          "| id | pages that name it |\n|---|---|\n"]]
      [= $footer [$concat
          "\n\n*" [$string [$count $files]] " ledger pages; "
          [$string [$count $declared-ids]] " ids declared, "
          [$string [$count $cited-only]] " cited only.*\n"]]
      [= $text [$concat $header [$strings:join $decl-rows "\n"] $middle
                        [$strings:join $cite-rows "\n"] $footer]]

  [?if $check
    [then [?let [= $on-disk [$io:read-file "ledger/README.md"]]
            [= $_drift [?if [= $on-disk $text]
              [then ()]
              [else ([$io:write-line [$env:stderr]
                       "ledger-index-check: DRIFT -- ledger/README.md does not match what scripts/ledger_index.cx generates. Run `make ledger-index` and commit the result."],
                     [$env:exit 1], ())]]]
            [; #1447 -- every id-shaped token in a subject's `RULED:` clause
               resolves to a page. An id resolves when it is DECLARED (a
               heading carries it) or CITED (a page names it in prose): both
               tables of this index are an answer to "where do I read it". ]
            [; #1738 -- the subjects are read once; a read that failed refuses
               here, exit 2, before anything is counted. ]
            [= $sl [$subject-lines]]
            [= $_refused [?if [= [$first $sl] "refused"]
              [then ([$io:write-line [$env:stderr]
                       [$concat "ledger-index-check: REFUSED (#1738) -- " [$nth $sl 2]
                                "; the subject rule cannot vouch for ids it could not read (make ledger-index-check passes --allow-env --allow-subprocess)"]],
                     [$env:exit 2], ())]
              [else ()]]]
            [= $known [$uniq-sorted [?to-array [?for [in $xs ($declared-ids, $cited-only)]
                                                 [in $x $xs] [yield $x]]]]]
            [; IDSH-1 -- each line is `<epoch>\t<subject>` from git (or a planted
               line in that shape), else a bare subject; a bare one is new. ]
            [= $rows [?to-array [?for [in $l [$nth $sl 2]]
              [= $dm [$re:find $dated-rx $l]]
              [yield [?match $dm
                       [case () [subj text=$l new=true]]
                       [else [subj text=[$re:group $dm 2]
                                   new=[>= [$strings:to-int [$re:group $dm 1]] IDSH-CUTOFF]]]]]]]]
            [= $src [$nth $sl 3]]
            [= $clauses [?to-array [?for [in $r $rows]
              [in $clause [$re:find-all [?if $r@new [then $clause-new-rx] [else $clause-old-rx]] [$string $r@text]]]
              [yield [cl text=[$re:group $clause 0] subject=[$string $r@text] new=$r@new]]]]]
            [= $subject-ids [$uniq-sorted
              [?for [in $c $clauses]
                [in $m [$re:find-all $id-rx [$string $c@text]]]
                [where [$is-id [$re:group $m 1]]]
                [yield [$strings:lower [$re:group $m 1]]]]]]
            [; IDSH-1 -- what is left of a clause once every parsed id is cut
               out of it carries no id-shaped token. ]
            [= $unparsed [?to-array [?for [in $c $clauses]
              [in $t [$strings:split [$re:replace $gap-rx [$re:replace $id-rx [$string $c@text] " "] " "] " "]]
              [where [$re:matches $shape-rx $t]]
              [yield [up token=$t subject=[$string $c@subject] new=$c@new]]]]]
            [; IDSH-1 -- a token a ledger page records as `TOKEN` (unparsed, IDSH-1),
               beside the id it was renamed to, is excused: a landed subject cannot be
               rewritten (no force-push), so the page that renames the decision is its
               record (MYSQLCDC-1 -> MYCDC-1, cited in 3f720d7bc). Any other token is
               refused as before. ]
            [= $idsh-rx [$re:compile "`([^`]+)` \\(unparsed, IDSH-1\\)"]]
            [= $excused [$uniq-sorted [?for [in $f $files]
                                         [in $m [$re:find-all $idsh-rx [$io:read-file $f]]]
                                         [yield [$re:group $m 1]]]]]
            [= $unparsed-new [?to-array [?for [in $u $unparsed]
                                          [where [= [$string $u@new] "true"]]
                                          [where [= 0 [$count [?for [in $e $excused] [where [= $e [$string $u@token]]] [yield $e]]]]]
                                          [yield $u]]]]
            [= $unparsed-old [$uniq-sorted [?for [in $u $unparsed] [where [= [$string $u@new] "false"]] [yield [$string $u@token]]]]]
            [; IDSH-1 -- an owner-letter id in a new subject resolves against a page
               that DECLARES it (a heading), not one that only quotes it: D99z9
               is quoted by the IDSH-1 page itself as #1767's example (REFUTE-1
               l01). The history keeps declared-or-cited. ]
            [= $undeclared-d [$uniq-sorted
              [?for [in $c $clauses]
                [where [= [$string $c@new] "true"]]
                [in $m [$re:find-all $id-rx [$string $c@text]]]
                [= $idv [$strings:lower [$re:group $m 1]]]
                [where [$re:matches [$re:compile "^d[0-9]+[a-z][0-9]?$"] $idv]]
                [where [= 0 [$count [?for [in $k $declared-ids] [where [= $k $idv]] [yield $k]]]]]
                [yield $idv]]]]
            [= $unres-known [?to-array
              [?for [in $id $subject-ids]
                [where [= 0 [$count [?for [in $k $known] [where [= $k $id]] [yield $k]]]]]
                [yield $id]]]]
            [= $unresolved [$uniq-sorted [?to-array [?for [in $xs ($unres-known, $undeclared-d)] [in $x $xs] [yield $x]]]]]
            [= $_unp [?if [> [$count $unparsed-new] 0]
              [then ([$io:write-line [$env:stderr]
                       [$concat "ledger-index-check: " [$string [$count $unparsed-new]]
                                " id-shaped token(s) in " $src
                                " that the id grammar does not parse (IDSH-1, #1767):"]],
                     [?for [in $u $unparsed-new]
                       [yield [$io:write-line [$env:stderr]
                                [$concat "    " [$string $u@token] " -- in: " [$string $u@subject]]]]],
                     [$io:write-line [$env:stderr]
                       "  An id is <digits>-<part>[-<part>] (1085-a), <LETTERS>-<digits> with two to six"],
                     [$io:write-line [$env:stderr]
                       "  capitals (CFG-1), or the owner-letter D<digits><letter>[<digit>] (D59a). A token"],
                     [$io:write-line [$env:stderr]
                       "  shaped like one that is none of them cannot resolve: write the id the ledger carries."])]
              [else ()]]]
            [= $_unres [?if [> [$count $unresolved] 0]
              [then ([$io:write-line [$env:stderr]
                       [$concat "ledger-index-check: " [$string [$count $unresolved]]
                                " decision id(s) cited in " $src
                                " resolve to NO page (#1447):"]],
                     [?for [in $id $unresolved]
                       [yield [$io:write-line [$env:stderr] [$concat "    " $id]]]],
                     [$io:write-line [$env:stderr]
                       "  A `RULED:` token with no decision behind it dresses a choice nobody took in"],
                     [$io:write-line [$env:stderr]
                       "  the store's authority. Give each one its page -- the decision recovered from"],
                     [$io:write-line [$env:stderr]
                       "  the issue or commit that made it, dated -- or record it as never-ruled with"],
                     [$io:write-line [$env:stderr]
                       "  the commits that cite it named. ledger/rulings_2026_09_19_cited_ids_without_a_page_1447.md"],
                     [$io:write-line [$env:stderr]
                       "  is the shape, and it carries the eleven this rule was written for."])]
              [else ()]]]
            [= $_fail [?if [or [> [$count $unparsed-new] 0] [> [$count $unresolved] 0]]
              [then [$env:exit 1]]
              [else ()]]]
            ([$io:write-line [$env:stdout]
               [$concat "ledger-index-check: ledger/README.md is current ("
                        [$string [$count $declared-ids]] " declared, "
                        [$string [$count $cited-only]] " cited only); "
                        [$string [$count $subject-ids]] " subject id(s) in " $src
                        " all resolve; no id-shaped token unparsed since IDSH-1 ("
                        [$string [$count $unparsed-old]] " distinct before it, not judged)"]],
             [$env:exit 0], ())]]
    [else [?let [= $_w [$io:write-file "ledger/README.md" $text]]
            ([$io:write-line [$env:stdout]
               [$concat "ledger-index: wrote ledger/README.md -- "
                        [$string [$count $declared-ids]] " ids declared, "
                        [$string [$count $cited-only]] " cited only, across "
                        [$string [$count $files]] " pages"]],
             [$env:exit 0], ())]]]]
