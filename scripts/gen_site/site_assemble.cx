# scripts/gen_site/site_assemble.cx — assembles cxhome.org into site/ and lists
# the result against docs-src/site/manifest.cxd (RULED: RS-28, D57a, D58a, D51d,
# D86b).
#
# ONE site, served from `cx` (D57a): the Pages workflow uploads the directory
# this program writes. The map is the one scripts/publish.sh applied to the
# public tree before it retired with the allowlist mirror (RULED: RS-11), so the
# URLs the site had before `cx`'s main was replaced (D86b) are the URLs it has
# again:
#
#   docs/guide/*            → the site root   (`make guide`; untracked output)
#   docs/guide/index.html   → guide.html      (the guide's own home page — the
#                                              root's index.html is the landing)
#   docs/index.html         → index.html      (the landing page; tracked,
#                                              generated by site_build.cx)
#   docs/llm/*              → llm/            (`make docs`; tracked, generated)
#   docs/llm/llms.txt       → llms.txt        (the llmstxt.org convention: the
#   docs/llm/llms-full.txt  → llms-full.txt    pair at the SITE ROOT, D51d)
#   (rendered)              → dev/index.html  (the developer door, DOCS-46)
#   docs/install, docs/CNAME → the site root  (the README's installer; the
#                                              custom-domain binding)
#   (empty)                 → .nojekyll       (Pages serves the tree as is)
#
# The playground's engine (docs/guide/wasm/, which `make guide` copies from
# dist/wasm/ when it exists; emcc builds it: `make guide-wasm`) is declared in a
# block that is REQUIRED where the engine is built — the Site workflow sets
# CX_SITE_REQUIRE_WASM=1 after its pinned-emsdk build (PLAY-1), so a site
# without it fails `--check` MISSING — and optional on a box with no emcc.
# This program also says so whenever it assembles without it.
#
#   cx --allow-read --allow-write scripts/gen_site/site_assemble.cx          assemble
#   cx --allow-read --allow-write scripts/gen_site/site_assemble.cx --check  list it
#   (or: make site; make site-check)
#
# --check lists the assembled tree against the union of the manifest's [files]
# blocks: a declared file the tree does not hold is MISSING, a file the tree
# holds that no line declares is EXTRA, and either fails the step by name.
# Then (RULED: DOCS-44) it walks EVERY LINK of the tree: every href and src of
# every assembled .html, and every relative Markdown link of every served .md,
# resolved against the tree — the file must be there (a declared optional file,
# the playground's wasm, counts as there) and, when the link carries a
# #fragment, the target page must carry that id (an HTML id= or name=; a
# Markdown heading's slug). External (http, https, mailto, data) links are the
# external-link step's (check_external_links.cx, DOCS-45), not this one's.
# A listing graded through SITE_CHECK_LIST has no file contents to walk, so
# that mode grades the file set only and says so.
# The assembly also writes the two doors (RULED: DOCS-46): llm/index.html, the
# LLM door rendered by llm_index.cx from docs-src/llm/manifest.cxd, and
# dev/index.html, the developer door — the docs/dev/ pages folded into the
# guide, and the old URL answers with where each page went.
# Exit: 0 green; 1 a missing source, a missing or extra file, a dead link.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/strings' as=strings]

# The raw-text reader the LLM layer uses for its own manifest (a [#…#] block is
# opaque to [$text]; primer_build.cx serializes it and strips the delimiters).
[?lib './scripts/gen_docs/primer_build.cx' as=pb]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/map'     as=map]
# The LLM door, llm/index.html, rendered from docs-src/llm/manifest.cxd
# (RULED: DOCS-46) into the assembled tree.
[?lib './scripts/gen_site/llm_index.cx' as=li]

[?const MANIFEST "docs-src/site/manifest.cxd"]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def die scope=public impure ($s)
  [?let [= $_ [$cry [$concat "site_assemble: " $s]]]
    [$env:exit 1]]]

[?def member scope=public ($seq $x)
  [> [$count [?for [in $y $seq] [where [= $y $x]] [yield 1]]] 0]]

# attr-or: $e's $k attribute, or $d when $e carries no such attribute.
[?def attr-or scope=public ($e $k $d)
  [?let [= $hits [?for [in $a [$attrs $e]] [where [= [$string $a@name] $k]] [yield [$string $a]]]]
    [?if [= [$count $hits] 0] [then $d] [else [$first $hits]]]]]

# optional-of: a [files] block's own optional=true|false, AS A STRING (kept
# comparable to a string $want-optional below, the way this file already
# compares $e@is-file's bool to "true" rather than to a bare bool).
#
# required-when=VAR (PLAY-1): a block that is optional=true unless the
# environment variable VAR is "1" — then it is required like any other. The
# Site workflow sets CX_SITE_REQUIRE_WASM=1 after it has built the wasm engine
# with the pinned emsdk, so cxhome.org can never ship the playground without
# it; a box with no emcc (the post-merge doc pipeline) lists the same five
# files as declared-but-optional. Read only under `--check`, which is granted
# --allow-env.
[?def optional-of scope=public impure ($k)
  [?let [= $var [$attr-or $k "required-when" ""]]
        [= $opt [$attr-or $k "optional" "false"]]
    [?if [and [not [= $var ""]] [= [$env:var-or-default $var ""] "1"]]
      [then "false"]
      [else $opt]]]]

# declared-lines: every path named by a manifest [files] block for which
# $want-optional ("true" or "false") matches the block's own optional=
# (default "false").
[?def declared-lines scope=public impure ($want-optional)
  [?for [in $k [$cx:parse [$io:read-file MANIFEST]]/*]
    [where [= [?else [$name $k] ""] "files"]]
    [where [= [$optional-of $k] $want-optional]]
    [in $l [$strings:split-lines [$pb:normalize [$pb:raw-of $k]]]]
    [where [not [= [$strings:trim $l] ""]]]
    [yield [$strings:trim $l]]]]

# files-under: every regular file below $dir, as a path relative to $dir.
[?def files-under scope=public impure ($dir)
  [?for [in $e [$io:walk $dir]]
    [where [= [$string $e@is-file] "true"]]
    [yield [$strings:slice [$string $e@path] [+ [$strings:length $dir] 2]
                           [$strings:length [$string $e@path]]]]]]

[?def place scope=public impure ($out $from $rel)
  [?let [= $to [$path:join $out $rel]]
        [= $_d [$io:make-dirs [$path:dirname $to]]]
    [$io:copy $from $to]]]

[?def need scope=public impure ($p $how)
  [?if [$io:exists $p] [then 0]
    [else [$die [$concat $p " is not there — " $how]]]]]

[?def assemble scope=public impure ($out)
  [?let
    [= $_n1 [$need "docs/guide/index.html" "run `make guide` first (make site does)"]]
    [= $_n2 [$need "docs/index.html" "the landing page is tracked; `make site-index` regenerates it"]]
    [= $_n3 [$need "docs/llm/llms.txt" "the LLM layer is tracked; `make docs` regenerates it"]]
    [= $_rm [?if [$io:exists $out] [then [$io:remove-tree $out]] [else 0]]]
    [= $_mk [$io:make-dirs $out]]
    [= $guide [?for [in $rel [$files-under "docs/guide"]]
                [= $_c [$place $out [$path:join "docs/guide" $rel]
                               [?if [= $rel "index.html"] [then "guide.html"] [else $rel]]]]
                [yield $rel]]]
    [= $_i [$place $out "docs/index.html" "index.html"]]
    [= $llm [?for [in $rel [$files-under "docs/llm"]]
              [= $_c [$place $out [$path:join "docs/llm" $rel] [$path:join "llm" $rel]]]
              [yield $rel]]]
    [= $_ix [$io:write-file [$path:join $out "llm/index.html"]
              [$li:llm-index-html [$strings:trim [$io:read-file "VERSION"]]]]]
    [= $_l1 [$place $out "docs/llm/llms.txt" "llms.txt"]]
    [= $_l2 [$place $out "docs/llm/llms-full.txt" "llms-full.txt"]]
    [= $_dd [$io:make-dirs [$path:join $out "dev"]]]
    [= $_dx [$io:write-file [$path:join $out "dev/index.html"]
              [$li:dev-index-html [$strings:trim [$io:read-file "VERSION"]]]]]
    [= $_r1 [$place $out "docs/install" "install"]]
    [= $_r2 [$place $out "docs/CNAME" "CNAME"]]
    [= $_nj [$io:write-file [$path:join $out ".nojekyll"] ""]]
    [= $wasm [?for [in $rel $guide] [where [$strings:starts-with $rel "wasm/"]] [yield 1]]]
    [= $_w [?if [$empty $wasm]
             [then [$cry [$concat "site_assemble: NOTE — no playground engine: docs/guide/wasm/ is absent "
                                  "(it needs dist/wasm/, built by `make guide-wasm` with emcc), so "
                                  "playground.html would ship without the engine it loads (site-check fails it MISSING under CX_SITE_REQUIRE_WASM=1)"]]]
             [else 0]]]
    [$say [$concat "site_assemble: " $out "/ — " [$string [$count $guide]] " guide files (index.html as guide.html), "
                   "the landing page, " [$string [$count $llm]] " llm/ files, the LLM door llm/index.html and the llms.txt pair at the root, "
                   "the developer door dev/index.html, install, CNAME, .nojekyll"]]]]

# report: the shared verdict over a LISTING $have (a sequence of paths,
# however it was obtained) against the manifest. $label names what $have is,
# for the messages only — this never reads or writes a tree itself, so a
# listing captured from a tree this program must not touch (a read-only main
# checkout, #1672's proof) is exactly as gradable as a live `$out/`.
[?def report scope=public impure ($label $have)
  [?let
    [= $required [$declared-lines "false"]]
    [= $optional [$declared-lines "true"]]
    [= $want [?for [in $grp ($required, $optional)]
               [in $f $grp]
               [yield $f]]]
    [= $_e [?if [$empty $want] [then [$die [$concat MANIFEST " declares no [files] — refusing to vouch"]]] [else 0]]]
    [= $missing [?for [in $f $required] [where [not [$member $have $f]]] [yield $f]]]
    [= $extra [?for [in $f $have] [where [not [$member $want $f]]] [yield $f]]]
    [= $dupes [?for [in $f [$distinct $want]]
                [where [> [$count [?for [in $g $want] [where [= $g $f]] [yield 1]]] 1]]
                [yield $f]]]
    [= $opt-present [$count [?for [in $f $optional] [where [$member $have $f]] [yield 1]]]]
    [?if [and [$empty $missing] [and [$empty $extra] [$empty $dupes]]]
      [then [?let [= $_s [$say [$concat "site-check: " $label " holds exactly the "
                                        [$string [$count $required]] " required files " MANIFEST
                                        " declares, plus " [$string $opt-present] "/" [$string [$count $optional]]
                                        " optional files present"]]]
              [$env:exit 0]]]
      [else [?let
        [= $_h [$cry [$concat "site-check: " $label " does not match " MANIFEST " — "
                              [$string [$count $missing]] " missing, " [$string [$count $extra]]
                              " extra, " [$string [$count $dupes]] " declared twice"]]]
        [= $_m [?for [in $f $missing] [yield [$cry [$concat "  MISSING: " $f
                                                 " — declared required, and the assembled site does not hold it"]]]]]
        [= $_x [?for [in $f $extra] [yield [$cry [$concat "  EXTRA:   " $f
                                                " — assembled, and no line of the manifest declares it"]]]]]
        [= $_d [?for [in $f $dupes] [yield [$cry [$concat "  TWICE:   " $f]]]]]
        [$env:exit 1]]]]]]

# ── the link walk (RULED: DOCS-44) ──────────────────────────────────────

[; two patterns rather than one alternation: [$re:group] refuses a group the
   other branch left unmatched (CXER3202), so each quoting style is its own
   pass. ]
[?def attr-rx scope=public impure () [$re:compile "(?:href|src)=\"([^\"]*)\""]]
[?def attr-rx-sq scope=public impure () [$re:compile "(?:href|src)='([^']*)'"]]
[?def md-rx scope=public impure () [$re:compile "\\]\\(([^) ]+)\\)"]]
[?def id-rx scope=public impure () [$re:compile "(?:id|name)=\"([^\"]*)\""]]
[?def md-head-rx scope=public impure () [$re:compile "(?m)^#{1,6} +(.+)$"]]

[?def external scope=public ($t)
  [or [$strings:starts-with $t "http://"] [or [$strings:starts-with $t "https://"]
      [or [$strings:starts-with $t "mailto:"] [or [$strings:starts-with $t "data:"]
          [or [$strings:starts-with $t "javascript:"] [$strings:starts-with $t "//"]]]]]]]

# markup-only: a page with its <pre>, <code> and <script> regions blanked —
# an example's `href="/orders"` is text the page SHOWS, not a link it makes,
# and a script's string is not markup either.
[?def markup-only scope=public impure ($text)
  [$re:replace [$re:compile "(?s)<script[^>]*>.*?</script>"]
    [$re:replace [$re:compile "(?s)<code[^>]*>.*?</code>"]
      [$re:replace [$re:compile "(?s)<pre[^>]*>.*?</pre>"] $text " "] " "] " "]]

# links-of: every link target one file names — attribute links in an .html
# (its markup only), Markdown links in a .md — less the external ones and
# the empty ones.
[?def links-of scope=public impure ($rel $text)
  [?let [= $html [?if [$strings:ends-with $rel ".html"] [then [$markup-only $text]] [else ""]]]
        [= $raw [?if [$strings:ends-with $rel ".html"]
                  [then [$pb:cat-seqs ([?for [in $m [$re:find-all [$attr-rx] $html]] [yield [$re:group $m 1]]],
                                       [?for [in $m [$re:find-all [$attr-rx-sq] $html]] [yield [$re:group $m 1]]])]]
                  [else [?for [in $m [$re:find-all [$md-rx] $text]] [yield [$re:group $m 1]]]]]]
    [$distinct [?for [in $t $raw]
                 [= $t2 [$strings:trim-end-chars [$first [$strings:split $t "?"]] ""]]
                 [where [not [= $t2 ""]]]
                 [where [not [$external $t2]]]
                 [yield $t2]]]]]

# resolve: a relative target against the directory of $rel, "." and ".."
# folded, as a path relative to the site root.
[?def resolve scope=public ($rel $target)
  [?let [= $dir [?if [$present [$strings:find $rel "/"]]
                  [then [$strings:slice $rel 1 [- [$strings:rfind $rel "/"] 1]]] [else ""]]]
        [= $joined [?if [$strings:starts-with $target "/"] [then [$strings:slice $target 2 [$strings:length $target]]]
                     [else [?if [= $dir ""] [then $target] [else [$concat $dir "/" $target]]]]]]
        [= $parts [$fp:fold [$strings:split $joined "/"] ()
                    [?fn ($acc $p)
                      [?if [or [= $p "."] [= $p ""]] [then $acc]
                        [else [?if [= $p ".."]
                          [then [?for [in $i [$range 1 [- [$count $acc] 1]]] [yield [$nth $acc $i]]]]
                          [else [$pb:cat-seqs ($acc, ($p,))]]]]]]]]
    [$strings:join $parts "/"]]]

# slug: a Markdown heading as the fragment a renderer gives it — lower case,
# punctuation dropped, spaces to hyphens.
[?def slug scope=public impure ($h)
  [$strings:replace [$re:replace [$re:compile "[^a-z0-9 _-]"] [$strings:lower [$strings:trim $h]] ""] " " "-"]]

[?def has-fragment scope=public impure ($path $text $frag)
  [?if [$strings:ends-with $path ".html"]
    [then [> [$count [?for [in $m [$re:find-all [$id-rx] $text]] [where [= [$re:group $m 1] $frag]] [yield 1]]] 0]]
    [else [> [$count [?for [in $m [$re:find-all [$md-head-rx] $text]] [where [= [$slug [$re:group $m 1]] $frag]] [yield 1]]] 0]]]]

# dead-links: every link of every page that does not resolve — as
# "<page> → <target>: <why>" lines.
[?def dead-links scope=public impure ($out $have)
  [?let [= $optional [$declared-lines "true"]]
        [= $pages [?for [in $f $have] [where [or [$strings:ends-with $f ".html"] [$strings:ends-with $f ".md"]]] [yield $f]]]
    [?for [in $p $pages]
      [= $text [$io:read-file [$path:join $out $p]]]
      [in $t [$links-of $p $text]]
      [= $file-part [$first [$strings:split $t "#"]]]
      [= $frag [?if [$present [$strings:find $t "#"]] [then [$strings:slice $t [+ [$strings:find $t "#"] 1] [$strings:length $t]]] [else ""]]]
      [= $target [?if [= $file-part ""] [then $p] [else [$resolve $p $file-part]]]]
      [= $dir-index [?if [or [= $target ""] [$strings:ends-with $target "/"]] [then [$concat $target "index.html"]] [else $target]]]
      [= $present-file [or [$member $have $dir-index] [$member $optional $dir-index]]]
      [= $frag-ok [?if [or [= $frag ""] [not [$present-file]]] [then true]
                    [else [?if [$member $have $dir-index]
                            [then [$has-fragment $dir-index [$io:read-file [$path:join $out $dir-index]] $frag]]
                            [else true]]]]]
      [where [or [not $present-file] [not $frag-ok]]]
      [yield [$concat "  DEAD:    " $p " → " $t
                      [?if [not $present-file] [then [$concat " — no file " $dir-index " in the assembled tree"]]
                        [else [$concat " — " $dir-index " carries no #" $frag]]]]]]]]

[?def walk-links scope=public impure ($out $have)
  [?let [= $dead [$dead-links $out $have]]
        [= $npages [$count [?for [in $f $have] [where [or [$strings:ends-with $f ".html"] [$strings:ends-with $f ".md"]]] [yield 1]]]]
    [?if [$empty $dead]
      [then [$say [$concat "site-check: every internal href, src and Markdown link of the " [$string $npages]
                           " served pages resolves in the tree, fragments included (DOCS-44)"]]]
      [else [?let [= $_h [$cry [$concat "site-check: " [$string [$count $dead]] " dead internal link(s) in the assembled tree"]]]
                  [= $_d [?for [in $l $dead] [yield [$cry $l]]]]
              [$env:exit 1]]]]]]

[?def check scope=public impure ($out)
  [?if [not [$io:is-directory $out]]
    [then [$die [$concat $out "/ is not there — run `make site` first"]]]
    [else [?let [= $have [$files-under $out]]
            [; the walk's own verdict is loud (exit 1 on a dead link); an err
               VALUE out of it — a regex the engine refused, a file it could
               not read — must not rest in a binding while the listing passes ]
            [?match [$walk-links $out $have]
              [case [err $e] [$die [$concat "the link walk failed before it could grade: " [$string $e@message]]]]
              [else [$report [$concat $out "/"] $have]]]]]]]

# check-list: the same verdict against a captured LISTING rather than a live
# tree — one path per line, relative to the site root, exactly what
# `files-under` would have yielded had it walked that tree. Reads a text file,
# never a directory: the way to grade a tree this program is not allowed to
# touch (or copy, when it is large) is to list it elsewhere and hand the list
# here (`make site-check-list LIST=path/to/listing.txt`, #1672).
[?def check-list scope=public impure ($list-path)
  [?if [not [$io:exists $list-path]]
    [then [$die [$concat $list-path " is not there — write one path per line, relative to the site root"]]]
    [else [?let
      [= $have [?for [in $l [$strings:split-lines [$io:read-file $list-path]]]
                 [where [not [= [$strings:trim $l] ""]]]
                 [yield [$strings:trim $l]]]]
      [?let [= $_n [$say "site-check: a listing carries no file contents, so the link walk (DOCS-44) is not graded here — the file set only"]]
        [$report [$concat "the listing at " $list-path] $have]]]]]]

[?let [= $argv [$env:argv]]
      [= $declared-out [$string [$first [?for [in $k [$cx:parse [$io:read-file MANIFEST]]/*]
                                          [where [= [?else [$name $k] ""] "site"]] [yield $k@out]]]]]
      [; SITE_OUT names another assembled tree to grade — how the link walk is
         proved red on a scratch copy with one link broken (DOCS-44). The
         assemble run carries no env grant, so an ungranted read falls back
         to the manifest's directory rather than resting as an [err] in $out
         (an err reaching [?if] runs neither branch and the program would
         exit 0 having done nothing — measured 2026-09-28). ]
      [= $override [?fallback [$env:var-or-default "SITE_OUT" ""] [recover-with ""]]]
      [= $out [?if [= $override ""] [then $declared-out] [else $override]]]
      [; SITE_CHECK_LIST names a captured file listing (one path per line,
         relative to the site root) to grade instead of walking $out/ live —
         how a tree this program must not touch, or must not copy, is graded
         (#1672's proof against the main checkout's own site/). ]
      [= $list-path [$env:var-or-default "SITE_CHECK_LIST" ""]]
  [?if [$member $argv "--check"]
    [then [?if [= $list-path ""] [then [$check $out]] [else [$check-list $list-path]]]]
    [else [?let [= $_a [$assemble $out]] [$env:exit 0]]]]]
