# scripts/gen_site/site_assemble.cx — assembles cxhome.org into site/ and lists
# the result against docs-src/site/manifest.cxd (RULED: RS-28, D57a, D58a, D51d,
# D86b).
#
# ONE site, served from `cx` (D57a): the Pages workflow uploads the directory
# this program writes. The map is the one scripts/publish.sh applied to the
# public tree before it retired with the allowlist mirror (RULED: RS-11), so the
# URLs the site had before `cx`'s main was replaced (D86b) are the URLs it has
# again:
#
#   docs/guide/*            → the site root   (`make guide`; untracked output)
#   docs/guide/index.html   → guide.html      (the guide's own home page — the
#                                              root's index.html is the landing)
#   docs/index.html         → index.html      (the landing page; tracked,
#                                              generated by site_build.cx)
#   docs/llm/*              → llm/            (`make docs`; tracked, generated)
#   docs/llm/llms.txt       → llms.txt        (the llmstxt.org convention: the
#   docs/llm/llms-full.txt  → llms-full.txt    pair at the SITE ROOT, D51d)
#   docs/dev/*              → dev/
#   docs/install, docs/CNAME → the site root  (the README's installer; the
#                                              custom-domain binding)
#   (empty)                 → .nojekyll       (Pages serves the tree as is)
#
# The playground's engine (docs/guide/wasm/, which `make guide` copies from
# dist/wasm/) is REQUIRED since PLAY-1: `make site` and `make site-check` build
# it or prove it fresh first, and the manifest names its five files in a
# required block, so `--check` fails a site without them MISSING. This program
# also says so when it assembles without them — a site whose playground page
# cannot run is never shipped silently.
#
#   cx --allow-read --allow-write scripts/gen_site/site_assemble.cx          assemble
#   cx --allow-read --allow-write scripts/gen_site/site_assemble.cx --check  list it
#   (or: make site; make site-check)
#
# --check lists the assembled tree against the union of the manifest's [files]
# blocks: a declared file the tree does not hold is MISSING, a file the tree
# holds that no line declares is EXTRA, and either fails the step by name.
# Exit: 0 green; 1 a missing source, a missing or extra file.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/strings' as=strings]

# The raw-text reader the LLM layer uses for its own manifest (a [#…#] block is
# opaque to [$text]; primer_build.cx serializes it and strips the delimiters).
[?lib './scripts/gen_docs/primer_build.cx' as=pb]

[?const MANIFEST "docs-src/site/manifest.cxd"]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def die scope=public impure ($s)
  [?let [= $_ [$cry [$concat "site_assemble: " $s]]]
    [$env:exit 1]]]

[?def member scope=public ($seq $x)
  [> [$count [?for [in $y $seq] [where [= $y $x]] [yield 1]]] 0]]

# attr-or: $e's $k attribute, or $d when $e carries no such attribute.
[?def attr-or scope=public ($e $k $d)
  [?let [= $hits [?for [in $a [$attrs $e]] [where [= [$string $a@name] $k]] [yield [$string $a]]]]
    [?if [= [$count $hits] 0] [then $d] [else [$first $hits]]]]]

# optional-of: a [files] block's own optional=true|false, AS A STRING (kept
# comparable to a string $want-optional below, the way this file already
# compares $e@is-file's bool to "true" rather than to a bare bool).
[?def optional-of scope=public ($k) [$attr-or $k "optional" "false"]]

# declared-lines: every path named by a manifest [files] block for which
# $want-optional ("true" or "false") matches the block's own optional=
# (default "false").
[?def declared-lines scope=public impure ($want-optional)
  [?for [in $k [$cx:parse [$io:read-file MANIFEST]]/*]
    [where [= [?else [$name $k] ""] "files"]]
    [where [= [$optional-of $k] $want-optional]]
    [in $l [$strings:split-lines [$pb:normalize [$pb:raw-of $k]]]]
    [where [not [= [$strings:trim $l] ""]]]
    [yield [$strings:trim $l]]]]

# files-under: every regular file below $dir, as a path relative to $dir.
[?def files-under scope=public impure ($dir)
  [?for [in $e [$io:walk $dir]]
    [where [= [$string $e@is-file] "true"]]
    [yield [$strings:slice [$string $e@path] [+ [$strings:length $dir] 2]
                           [$strings:length [$string $e@path]]]]]]

[?def place scope=public impure ($out $from $rel)
  [?let [= $to [$path:join $out $rel]]
        [= $_d [$io:make-dirs [$path:dirname $to]]]
    [$io:copy $from $to]]]

[?def need scope=public impure ($p $how)
  [?if [$io:exists $p] [then 0]
    [else [$die [$concat $p " is not there — " $how]]]]]

[?def assemble scope=public impure ($out)
  [?let
    [= $_n1 [$need "docs/guide/index.html" "run `make guide` first (make site does)"]]
    [= $_n2 [$need "docs/index.html" "the landing page is tracked; `make site-index` regenerates it"]]
    [= $_n3 [$need "docs/llm/llms.txt" "the LLM layer is tracked; `make docs` regenerates it"]]
    [= $_rm [?if [$io:exists $out] [then [$io:remove-tree $out]] [else 0]]]
    [= $_mk [$io:make-dirs $out]]
    [= $guide [?for [in $rel [$files-under "docs/guide"]]
                [= $_c [$place $out [$path:join "docs/guide" $rel]
                               [?if [= $rel "index.html"] [then "guide.html"] [else $rel]]]]
                [yield $rel]]]
    [= $_i [$place $out "docs/index.html" "index.html"]]
    [= $llm [?for [in $rel [$files-under "docs/llm"]]
              [= $_c [$place $out [$path:join "docs/llm" $rel] [$path:join "llm" $rel]]]
              [yield $rel]]]
    [= $_l1 [$place $out "docs/llm/llms.txt" "llms.txt"]]
    [= $_l2 [$place $out "docs/llm/llms-full.txt" "llms-full.txt"]]
    [= $dev [?for [in $rel [$files-under "docs/dev"]]
              [= $_c [$place $out [$path:join "docs/dev" $rel] [$path:join "dev" $rel]]]
              [yield $rel]]]
    [= $_r1 [$place $out "docs/install" "install"]]
    [= $_r2 [$place $out "docs/CNAME" "CNAME"]]
    [= $_nj [$io:write-file [$path:join $out ".nojekyll"] ""]]
    [= $wasm [?for [in $rel $guide] [where [$strings:starts-with $rel "wasm/"]] [yield 1]]]
    [= $_w [?if [$empty $wasm]
             [then [$cry [$concat "site_assemble: NOTE — no playground engine: docs/guide/wasm/ is absent "
                                  "(it needs dist/wasm/, built by `make guide-wasm` with emcc), so "
                                  "playground.html would ship without the engine it loads — site-check fails it MISSING"]]]
             [else 0]]]
    [$say [$concat "site_assemble: " $out "/ — " [$string [$count $guide]] " guide files (index.html as guide.html), "
                   "the landing page, " [$string [$count $llm]] " llm/ files and the llms.txt pair at the root, "
                   [$string [$count $dev]] " dev/ files, install, CNAME, .nojekyll"]]]]

# report: the shared verdict over a LISTING $have (a sequence of paths,
# however it was obtained) against the manifest. $label names what $have is,
# for the messages only — this never reads or writes a tree itself, so a
# listing captured from a tree this program must not touch (a read-only main
# checkout, #1672's proof) is exactly as gradable as a live `$out/`.
[?def report scope=public impure ($label $have)
  [?let
    [= $required [$declared-lines "false"]]
    [= $optional [$declared-lines "true"]]
    [= $want [?for [in $grp ($required, $optional)]
               [in $f $grp]
               [yield $f]]]
    [= $_e [?if [$empty $want] [then [$die [$concat MANIFEST " declares no [files] — refusing to vouch"]]] [else 0]]]
    [= $missing [?for [in $f $required] [where [not [$member $have $f]]] [yield $f]]]
    [= $extra [?for [in $f $have] [where [not [$member $want $f]]] [yield $f]]]
    [= $dupes [?for [in $f [$distinct $want]]
                [where [> [$count [?for [in $g $want] [where [= $g $f]] [yield 1]]] 1]]
                [yield $f]]]
    [= $opt-present [$count [?for [in $f $optional] [where [$member $have $f]] [yield 1]]]]
    [?if [and [$empty $missing] [and [$empty $extra] [$empty $dupes]]]
      [then [?let [= $_s [$say [$concat "site-check: " $label " holds exactly the "
                                        [$string [$count $required]] " required files " MANIFEST
                                        " declares, plus " [$string $opt-present] "/" [$string [$count $optional]]
                                        " optional files present"]]]
              [$env:exit 0]]]
      [else [?let
        [= $_h [$cry [$concat "site-check: " $label " does not match " MANIFEST " — "
                              [$string [$count $missing]] " missing, " [$string [$count $extra]]
                              " extra, " [$string [$count $dupes]] " declared twice"]]]
        [= $_m [?for [in $f $missing] [yield [$cry [$concat "  MISSING: " $f
                                                 " — declared required, and the assembled site does not hold it"]]]]]
        [= $_x [?for [in $f $extra] [yield [$cry [$concat "  EXTRA:   " $f
                                                " — assembled, and no line of the manifest declares it"]]]]]
        [= $_d [?for [in $f $dupes] [yield [$cry [$concat "  TWICE:   " $f]]]]]
        [$env:exit 1]]]]]]

[?def check scope=public impure ($out)
  [?if [not [$io:is-directory $out]]
    [then [$die [$concat $out "/ is not there — run `make site` first"]]]
    [else [$report [$concat $out "/"] [$files-under $out]]]]]

# check-list: the same verdict against a captured LISTING rather than a live
# tree — one path per line, relative to the site root, exactly what
# `files-under` would have yielded had it walked that tree. Reads a text file,
# never a directory: the way to grade a tree this program is not allowed to
# touch (or copy, when it is large) is to list it elsewhere and hand the list
# here (`make site-check-list LIST=path/to/listing.txt`, #1672).
[?def check-list scope=public impure ($list-path)
  [?if [not [$io:exists $list-path]]
    [then [$die [$concat $list-path " is not there — write one path per line, relative to the site root"]]]
    [else [?let
      [= $have [?for [in $l [$strings:split-lines [$io:read-file $list-path]]]
                 [where [not [= [$strings:trim $l] ""]]]
                 [yield [$strings:trim $l]]]]
      [$report [$concat "the listing at " $list-path] $have]]]]]

[?let [= $argv [$env:argv]]
      [= $out [$string [$first [?for [in $k [$cx:parse [$io:read-file MANIFEST]]/*]
                                 [where [= [?else [$name $k] ""] "site"]] [yield $k@out]]]]]
      [; SITE_CHECK_LIST names a captured file listing (one path per line,
         relative to the site root) to grade instead of walking $out/ live —
         how a tree this program must not touch, or must not copy, is graded
         (#1672's proof against the main checkout's own site/). ]
      [= $list-path [$env:var-or-default "SITE_CHECK_LIST" ""]]
  [?if [$member $argv "--check"]
    [then [?if [= $list-path ""] [then [$check $out]] [else [$check-list $list-path]]]]
    [else [?let [= $_a [$assemble $out]] [$env:exit 0]]]]]
