# scripts/gen_site/docs_vocabulary_check.cx — the docs-vocabulary step
# (RULED: DOCS-51 §1 and §5, DG-1, PLAY-2, RS-1, CXF-1).
#
# One vocabulary: the rings' and the delivery grammar's words everywhere —
# data, code, a query is a program over data, two rings and the groups above
# them, decision / merge / step / run. This step counts, in every served
# SOURCE and in the playground's own page and script, the words the site
# does not use — "Ring 2", "Ring 3", an "ecosystem ring", the "monorepo",
# "lane", "campaign", "gate run", "steward", "ruling", "landed", the label
# "TL;DR" (a page opens on its lead, never behind the label), the
# grammar's verdict and unit words "green"/"red", "job", "stage" and "task",
# and the reading names Document / Program as a tab or crumb label — and holds each
# file to docs-src/site/vocabulary.cxd, in the voice ratchet's shape: a file
# with no row for a word must read ZERO of it; a file with a row may read at
# most its `allow=`, and when it reads LESS the step refuses too, naming the
# new count, so the number in the row is always the measured one and only
# ever moves down. Every row carries its `why=` — the sense that is not the
# grammar's (a pipe's stage, a page that records the words leaving), or the
# floor a voice wave lowers to zero (`wave=`).
#
# What is scanned: the served sources docs_voice_check.cx scans (the landing,
# the guide sections and about page, the repository pages, the reference
# sources, the LLM templates, the dev pages) plus the playground's
# playground.js and playground.html and the guide generator (the navigation's
# labels are its strings).
# And the tree's own prose (RULED: WORDS-1): the [tree] rows of the
# vocabulary file name the words (today "lane") also held over the Makefile,
# flows/, scripts/, the approved specs and the three root rule files, in the
# same shape and against the same [allow] rows; a file a served glob reads is
# graded there, once. The ledger and the git history are records, and not
# scanned.
#
# Code spans are not prose (the `prose` def below): a word is counted only
# outside them, so a make target or a directory named with a word keeps its
# spelling inside a code span and nowhere else. A mention of green/red or
# job/stage/task in a sense that is not the pipeline's — a pipe's stage, the
# A2A protocol's task — is a row whose why= names that sense, at its
# measured count. Not scanned, by name: "landing" ("landing page").
#
# Run (from the repository root):
#   cx --allow-read --allow-write scripts/gen_site/docs_vocabulary_check.cx
#   (or: make docs-vocabulary-check)
# Exit: 0 pass (the per-file table on stdout); 1 any file over or under an
# allowance, a row naming a file that is not there, or a row naming no word.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/strings' as=strings]

[?const VOCAB "docs-src/site/vocabulary.cxd"]
[?const GLOBS ("docs-src/site/*.md", "docs-src/site/tldr.cxd",
               "docs-src/canonical/sections/*.cxd", "docs-src/canonical/about.html",
               "docs-src/repos/*.cxd",
               "docs-src/canonical/reference/*.cx",
               "docs-src/llm/*.tmpl", "docs-src/llm/primer-platform.chapter.md",
               "scripts/gen_guide/playground/playground.js",
               "scripts/gen_guide/playground/playground.html",
               "scripts/gen_guide/guide_build.cx")]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]

[?def attr scope=public ($e $k $d)
  [?let [= $hits [?for [in $a [$attrs $e]] [where [= [$string $a@name] $k]] [yield [$string $a]]]]
    [?if [$empty $hits] [then $d] [else [$first $hits]]]]]

# words: the [words]/[word] rows — id, the pattern, its flags, an optional
# path scope (a substring every scanned path must carry) and the words.
[?def words scope=public impure ($doc)
  [?for [in $w $doc//words/word]
    [= $id [$attr $w "id" ""]]
    [= $rx [$attr $w "rx" ""]]
    [= $flags [$attr $w "flags" "(?i)"]]
    [= $scope [$attr $w "scope" ""]]
    [= $say [$attr $w "say" ""]]
    [= $spans [$attr $w "spans" "exempt"]]
    [yield [w id=$id rx=$rx flags=$flags scope=$scope say=$say spans=$spans]]]]

# rows: the [allow]/[page] rows — {path, word, allow, wave, why}.
[?def rows scope=public impure ($doc)
  [?for [in $p $doc//allow/page]
    [= $path [$attr $p "path" ""]]
    [= $word [$attr $p "word" ""]]
    [= $allow [$strings:to-number [$attr $p "allow" "0"]]]
    [= $wave [$attr $p "wave" ""]]
    [= $why [$attr $p "why" ""]]
    [yield [row path=$path word=$word allow=$allow wave=$wave why=$why]]]]

# prose: the text a reader reads as sentences — every code span removed
# before a word is counted: a fenced block (```…```), a fixture citation
# (a case id is a name, not a sentence; spelled \\x5B…\\x5D so the data
# reading balances this file too — reader-parity), an inline `…` span (it
# may wrap one line, as the .cxd bodies do, never a paragraph), an HTML
# <code>…</code>, and a path literal outside one (a token carrying a "/"
# that ends in "/" or in a file extension — `lanes/`, examples/lanes/x.cx).
# A directory, file or make-target name that carries a word keeps its
# spelling there, and only there; "JSON/YAML" or "green/red" is not a path
# and is still counted.
[?const SPAN-RX "(?s)```.*?```|\\x5Bfixture id=[^\\x5D]*\\x5D|`[^`\n]*(?:\n[^`\n]*)?`|<code>.*?</code>"]
[?const PATH-RX "[A-Za-z0-9_.-]*[A-Za-z0-9_-]/[A-Za-z0-9_./-]*"]
[?const PATH-EXT-RX "(?s).*(/|[.][A-Za-z0-9]+)"]
[?def prose scope=public ($text)
  [?let [= $spanless [$re:replace [$re:compile SPAN-RX] $text " "]]
        [= $ext [$re:compile PATH-EXT-RX]]
    [$re:replace-fn [$re:compile PATH-RX] $spanless
      [?fn ($m) [?let [= $t [$re:group $m 0]]
                  [?if [$re:matches $ext $t] [then " "] [else $t]]]]]]]

# count-in: a word's mentions in a file — over the prose, or over the whole
# text for a word whose `spans=keep` (the reading label is a quoted string
# in the playground's own script, so its code is the thing counted).
[?def count-in scope=public impure ($text $plain $w)
  [$count [$re:find-all [$re:compile [$concat [$string $w@flags] [$string $w@rx]]]
                          [?if [= [$string $w@spans] "keep"] [then $text] [else $plain]]]]]

[?def in-scope scope=public ($w $path)
  [?if [= [$string $w@scope] ""] [then true]
    [else [$present [$strings:find $path [$string $w@scope]]]]]]

[?def sources scope=public impure ()
  [$fp:flat-map GLOBS [?fn ($g) [$io:glob $g]]]]

[?def allow-for scope=public ($rows $path $word)
  [?let [= $hits [?for [in $r $rows]
                   [where [and [= [$string $r@path] $path] [= [$string $r@word] $word]]]
                   [yield $r]]]
    [?if [$empty $hits] [then [row path=$path word=$word allow=0 wave="" why=""]] [else [$first $hits]]]]]

# has: whether a sequence of strings carries one.
[?def has scope=public pure ($xs $x)
  [> [$count [?for [in $y $xs] [where [= $y $x]] [yield 1]]] 0]]

# tree-words / tree-files: the [tree] row set (RULED: WORDS-1) — the [word]
# ids it holds over the tree's own prose, and the files its [glob path=…]
# rows match, less every file the served GLOBS already read (a file is
# graded once, as a served source, with every word).
[?def tree-words scope=public impure ($doc)
  [$fp:flat-map [?for [in $t $doc//tree] [yield [$attr $t "words" ""]]]
    [?fn ($s) [$strings:split-whitespace $s]]]]
[?def tree-files scope=public impure ($doc $served)
  [?for [in $p [$fp:flat-map [?for [in $g $doc//tree/glob] [yield [$attr $g "path" ""]]]
                 [?fn ($pat) [$io:glob $pat]]]]
    [where [not [$has $served $p]]]
    [yield $p]]]

# grade: one file's rows — its mentions of each word it is held to, beside
# the allowance its [allow] row gives (zero with no row).
[?def grade scope=public impure ($f $ws $rows)
  [?let [= $text [$io:read-file $f]]
        [= $plain [$prose $text]]
    [?for [in $w $ws]
      [where [$in-scope $w $f]]
      [= $n [$count-in $text $plain $w]]
      [= $id [$string $w@id]]
      [= $say [$string $w@say]]
      [= $r [$allow-for $rows $f $id]]
      [= $allow $r@allow]
      [= $wave [$string $r@wave]]
      [yield [g path=$f word=$id say=$say n=$n allow=$allow wave=$wave]]]]]

[?let
  [= $doc [$cx:parse [$io:read-file VOCAB]]]
  [= $words [$words $doc]]
  [= $rows [$rows $doc]]
  [= $files [$sources]]
  [= $twords [$tree-words $doc]]
  [= $tfiles [$tree-files $doc $files]]
  [= $tws [?for [in $w $words] [where [$has $twords [$string $w@id]]] [yield $w]]]
  [= $ids [?for [in $w $words] [yield [$string $w@id]]]]
  [= $missing [?for [in $r $rows] [where [not [$io:is-file [$string $r@path]]]] [yield [$string $r@path]]]]
  [= $unknown [?for [in $r $rows]
                [where [not [> [$count [?for [in $i $ids] [where [= $i [$string $r@word]]] [yield 1]]] 0]]]
                [yield [$concat [$string $r@path] " → word=" [$string $r@word]]]]]
  [= $graded [$fp:flat-map ([$fp:flat-map $files [?fn ($f) [$grade $f $words $rows]]],
                              [$fp:flat-map $tfiles [?fn ($f) [$grade $f $tws $rows]]])
                [?fn ($part) $part]]]
  [= $over [?for [in $g $graded] [where [> $g@n $g@allow]] [yield $g]]]
  [= $under [?for [in $g $graded] [where [< $g@n $g@allow]] [yield $g]]]
  [= $total [$fp:fold $graded 0 [?fn ($a $g) [+ $a $g@n]]]]
  [= $_table [?for [in $g $graded] [where [> $g@n 0]]
               [yield [$say [$concat "  " [$string $g@n] "\t" [$string $g@word] "\t" [$string $g@path]
                                     [?if [= [$string $g@wave] ""] [then ""]
                                       [else [$concat "\t(floor for wave " [$string $g@wave] ")"]]]]]]]]
  [= $_m [?for [in $p $missing] [yield [$cry [$concat "docs-vocabulary-check: " VOCAB " names " $p " and it is not there — remove the row"]]]]]
  [= $_k [?for [in $u $unknown] [yield [$cry [$concat "docs-vocabulary-check: " VOCAB " row " $u " names no [word] id"]]]]]
  [= $_o [?for [in $g $over] [yield [$cry [$concat "docs-vocabulary-check: " [$string $g@path] " reads " [$string $g@say]
                                                    " " [$string $g@n] " time(s); " VOCAB " allows "
                                                    [$string $g@allow] " — one vocabulary (DOCS-51 §1): "
                                                    "use the site's word, or add the row with the sense that is not the grammar's"]]]]]
  [= $_u [?for [in $g $under] [yield [$cry [$concat "docs-vocabulary-check: " [$string $g@path] " reads " [$string $g@say]
                                                     " " [$string $g@n] " time(s) and " VOCAB " still allows "
                                                     [$string $g@allow] " — ratchet: lower allow= to "
                                                     [$string $g@n] " in the same change"]]]]]
  [?if [and [$empty $missing] [and [$empty $unknown] [and [$empty $over] [$empty $under]]]]
    [then [?let [= $_s [$say [$concat "docs-vocabulary-check: " [$string [$count $files]] " sources and "
                                      [$string [$count $tfiles]] " tree files ("
                                      [$strings:join $twords " "] "), "
                                      [$string [$count $words]] " words, " [$string $total]
                                      " mention(s), every one within " VOCAB "'s allowance; "
                                      [$string [$count [?for [in $g $graded] [where [= $g@n 0]] [yield 1]]]]
                                      " file-word pairs read zero"]]]
            [$env:exit 0]]]
    [else [$env:exit 1]]]]
