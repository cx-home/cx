# scripts/gen_site/site_build.cx — the cxhome.org landing page generator
# (RULED: RS-28, RS-30, D86b).
#
# Renders docs/index.html, the site's front page, from docs-src/site/index.md,
# the page's Markdown source, under docs-src/site/manifest.cxd's [page] row.
# The output is TRACKED and GENERATED, like docs/llm/: `make docs` writes it,
# `make docs-check` (this program's --check) refuses a committed page that a
# fresh generation would not reproduce byte for byte.
#
# RS-30's voice rule is enforced here, not reviewed: every claim on the page
# keeps a runnable corpus example or a measured number beside it. So the
# page's examples are conformance fixtures, and the generator EXECUTES each one
# and requires the live output to equal the fixture's recorded output — the
# primer's freshness contract, reused, not re-read: the fixture index, the
# replay, the verification and the {{EXAMPLE:…}} / {{VERSION}} expansion are
# scripts/gen_docs/primer_build.cx's own public functions (imported below).
# The page's numbers are counted from the files that declare them, at
# generation time, so a stale number is a drift like any other.
#
# ── Placeholders (beside primer_build.cx's own) ─────────────────────────────
#
#   {{PAGE:<path> <label…>}}  a link to a page OF THE SITE — refused unless
#                             <path> (less any #fragment) is a line of the
#                             manifest's [files] blocks, so the landing page
#                             can never link to a file the site does not serve
#   {{REPO-MAP}}              the repository map: the front door ([site repo=])
#                             and every registry/repos.cxd row with
#                             status=extracted, grouped by group=, each linked
#                             to its page of this site (repo-<name>.html) when
#                             the manifest's [files] declare one and to its
#                             repository on GitHub otherwise, with what it
#                             ships and what it is
#   {{COUNT:modules}}         registry/modules.cxd rows with kind=module that
#                             are not status=planned — the shipped modules
#   {{COUNT:directives}}      the rows of the normative directive registry
#                             (the spec's §4.1 table, as the primer projects it)
#   {{COUNT:repositories}}    the rows {{REPO-MAP}} shows
#   {{COUNT:examples}}        the fixtures this page cites, replayed green
#   {{TLDR}}                  the one lead, from docs-src/site/tldr.cxd (the
#                             primer's own placeholder; its clauses' cases are
#                             replayed here too, RULED: DOCS-49)
#   {{FIGURE:rings}}          the ring figure, rendered from the registries by
#                             ring_svg.cx (RULED: DOCS-42), inlined in place
#                             and linked to rings.html
#   {{FIGURE:rings-plain}}    the same figure with the module and repository
#                             names off (ring_svg.cx's ring-svg-plain): the
#                             two rings and the groups above them, the full
#                             figure a link away on rings.html (HOME-1)
#   {{TLDR:lead}}             the lead paragraph alone, as the hero's
#                             lede (the one sentence in one place, DOCS-49)
#   {{FIXTURE:<id>}}          one replayed case in the guide's fixture shape
#                             (its files, the invocation with the LIVE output,
#                             where the case lives) — the block a beat's
#                             sentence stands beside
#   {{HERO:<id>}}             the running example (HOME-1): the case's program
#                             and its recorded answer in the page's bytes, and
#                             a script that runs the same program in the
#                             reader's browser through the playground's engine
#                             (wasm/cxlib.js) and marks the answer as run when
#                             it equals the fixture's — a browser without the
#                             engine keeps the recorded answer and says so; the
#                             case must record an exact answer, never a refusal
#
# The page wears the guide's chrome (HOME-1, DOCS-51 §3): the sidebar is read
# from docs/guide/index.html as `make guide` rendered it (site.mk orders the
# render first), so the first click from the landing does not change the
# frame; the sheet bar and the title block are the guide's shape. Every
# href= and src= the page carries, the sidebar's included, must name a file
# the manifest serves (a query string or fragment aside) or index.html
# itself — the {{PAGE:}} rule, applied to the whole page.
#
# ── The Markdown it renders ─────────────────────────────────────────────────
#
# The subset the page is written in, and nothing else: `#`…`####` headings,
# paragraphs, `- ` lists (a continuation line indented by two spaces), `|`
# tables (header row, separator row, body), ``` fences with a language, and
# inline `code`, **bold** and [label](url). Text is HTML-escaped before any
# inline form is applied; a code span's content is escaped and nothing else.
# A ```html fence is the page's own markup — the hero, the doors, the
# journey cards — emitted as it is; its links are held by the href rule
# above. An unclosed fence or an unpaired backtick is a hard failure, never
# output.
#
# Run (from the repository root):
#   cx --allow-read --allow-write --allow-subprocess --allow-env \
#      scripts/gen_site/site_build.cx [--check]
#   (or: make site-index; make docs / make docs-check run it too)
#
# Exit: 0 green; 1 any failure (a missing case, an output mismatch, a link to a
# file the site does not serve, drift).

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/cx'      as=cx]
[?lib 'cx-stdlib/map'     as=map]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/strings' as=strings]

# The primer's generator, as a library: its fixture index, replay, freshness
# verification and placeholder expansion (every def there is scope=public; its
# top-level run does not execute on import).
[?lib './scripts/gen_docs/primer_build.cx' as=pb]

# The rows the site counts (RULED: DOCS-42) — the figure prints the same ones.
[?lib './scripts/gen_site/site_counts.cx' as=sc]
# The ring figure, rendered from the registries (RULED: DOCS-42), inlined by
# {{FIGURE:rings}}.
[?lib './scripts/gen_site/ring_svg.cx' as=rs]

[?const MANIFEST "docs-src/site/manifest.cxd"]

[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def die scope=public impure ($s)
  [?let [= $_ [$cry [$concat "site_build: " $s]]]
    [$env:exit 1]]]

[?def child-named scope=public ($doc $n)
  [?for [in $k $doc/*] [where [= [?else [$name $k] ""] $n]] [yield $k]]]

# raw-lines: the non-empty trimmed lines of a [#…#] raw-text child.
[?def raw-lines scope=public ($k)
  [?for [in $l [$strings:split-lines [$pb:normalize [$pb:raw-of $k]]]]
    [where [not [= [$strings:trim $l] ""]]]
    [yield [$strings:trim $l]]]]

# site-files: every path the manifest's [files] blocks declare.
[?def site-files scope=public ($m)
  [$fp:flat-map [$child-named $m "files"] [?fn ($k) [$raw-lines $k]]]]

# ── HTML text ────────────────────────────────────────────────────────────────

[?def esc scope=public ($s)
  [$strings:replace [$strings:replace [$strings:replace $s "&" "&amp;"] "<" "&lt;"] ">" "&gt;"]]

[?def link-rx scope=public impure () [$re:compile "\\[([^\\]]+)\\]\\(([^) ]+)\\)"]]
[?def bold-rx scope=public impure () [$re:compile "\\*\\*([^*]+)\\*\\*"]]

# inline-text: one run of prose outside any code span (already escaped).
[?def inline-text scope=public impure ($s)
  [$re:replace [$bold-rx] [$re:replace [$link-rx] $s "<a href=\"$2\">$1</a>"] "<b>$1</b>"]]

# inline: a line of Markdown prose → HTML. Backticks split the text into
# alternating prose and code runs; an odd count is an unpaired backtick.
[?def inline scope=public impure ($s $where)
  [?let [= $segs [$strings:split $s "`"]]
        [= $n [$count $segs]]
    [?if [and [> $n 0] [= [% $n 2] 0]]
      [then [$die [$concat "unpaired backtick in " $where ": " $s]]]
      [else [$strings:join [?for [in $i [$range 1 $n]]
              [= $seg [$nth $segs $i]]
              [yield [?if [= [% $i 2] 1]
                [then [$inline-text [$esc $seg]]]
                [else [$concat "<code>" [$esc $seg] "</code>"]]]]] ""]]]]]


# ── block rendering: a fold over the lines, one open block at a time ────────

[?def cells scope=public ($row)
  [?let [= $parts [$strings:split [$strings:trim $row] "|"]]
        [= $n [$count $parts]]
    [?for [in $i [$range 2 [- $n 1]]] [yield [$strings:trim [$nth $parts $i]]]]]]

[?def render-table scope=public impure ($rows $where)
  [?let [= $n [$count $rows]]
        [= $head [$cells [$first $rows]]]
    [?if [< $n 2]
      [then [$die [$concat "a table needs a header row and a separator row in " $where]]]
      [else [$concat
        "<table>\n<thead><tr>"
        [$strings:join [?for [in $c $head] [yield [$concat "<th>" [$inline $c $where] "</th>"]]] ""]
        "</tr></thead>\n<tbody>\n"
        [$strings:join [?for [in $i [$range 3 $n]]
          [yield [$concat "<tr>"
                   [$strings:join [?for [in $c [$cells [$nth $rows $i]]]
                     [yield [$concat "<td>" [$inline $c $where] "</td>"]]] ""]
                   "</tr>\n"]]] ""]
        "</tbody></table>\n"]]]]]

# list items: a line opening "- " starts an item, an indented line continues it.
[?def list-items scope=public ($rows)
  [$fp:fold $rows ()
    [?fn ($acc $l)
      [?if [$strings:starts-with $l "- "]
        [then [$pb:cat-seqs ($acc, ([$strings:slice $l 3 [$strings:length $l]],))]]
        [else [?let [= $k [$count $acc]]
          [$pb:cat-seqs ([?for [in $i [$range 1 [- $k 1]]] [yield [$nth $acc $i]]],
                         ([$concat [$nth $acc $k] " " [$strings:trim $l]],))]]]]]]]

[?def render-list scope=public impure ($rows $where)
  [$concat "<ul>\n"
    [$strings:join [?for [in $it [$list-items $rows]]
      [yield [$concat "<li>" [$inline $it $where] "</li>\n"]]] ""]
    "</ul>\n"]]

[?def heading scope=public impure ($l $where)
  [?let [= $lvl [?if [$strings:starts-with $l "#### "] [then 4]
                  [else [?if [$strings:starts-with $l "### "] [then 3]
                  [else [?if [$strings:starts-with $l "## "] [then 2] [else 1]]]]]]]
        [= $text [$strings:slice $l [+ $lvl 2] [$strings:length $l]]]
    [$concat "<h" [$string $lvl] ">" [$inline $text $where] "</h" [$string $lvl] ">\n"]]]

# flush: close the open block into the HTML accumulated so far.
[?def flush scope=public impure ($st $where)
  [?let [= $mode [$map:get $st "mode"]]
        [= $buf [$map:get $st "buf"]]
        [= $out [?match $mode
                  [case "para"  [$concat "<p>" [$inline [$strings:join $buf " "] $where] "</p>\n"]]
                  [case "list"  [$render-list $buf $where]]
                  [case "table" [$render-table $buf $where]]
                  [case "code"  [$die [$concat "unclosed ``` fence in " $where]]]
                  [else ""]]]
    {html: [$concat [$map:get $st "html"] $out], mode: "none", lang: "", buf: ()}]]

[?def push-line scope=public ($st $mode $l)
  [$map:put [$map:put $st "mode" $mode] "buf" [$pb:cat-seqs ([$map:get $st "buf"], ($l,))]]]

[?def step scope=public impure ($st $l $where)
  [?let [= $mode [$map:get $st "mode"]]
        [= $t [$strings:trim $l]]
    [?if [= $mode "code"]
      [then [?if [$strings:starts-with $t "```"]
        [then {html: [$concat [$map:get $st "html"]
                        [?if [= [$map:get $st "lang"] "html"]
                          [then [$concat [$strings:join [$map:get $st "buf"] "\n"] "\n"]]
                          [else [$concat
                            "<pre><code class=\"language-" [$map:get $st "lang"] "\">"
                            [$esc [$strings:join [$map:get $st "buf"] "\n"]]
                            "</code></pre>\n"]]]],
               mode: "none", lang: "", buf: ()}]
        [else [$push-line $st "code" $l]]]]
      [else [?if [$strings:starts-with $t "```"]
        [then [$map:put [$map:put [$flush $st $where] "mode" "code"]
                        "lang" [$strings:trim [$strings:slice $t 4 [$strings:length $t]]]]]
      [else [?if [= $t ""]
        [then [$flush $st $where]]
      [else [?if [$strings:starts-with $l "#"]
        [then [?let [= $f [$flush $st $where]]
                [$map:put $f "html" [$concat [$map:get $f "html"] [$heading $t $where]]]]]
      [else [?if [$strings:starts-with $l "|"]
        [then [$push-line [?if [= $mode "table"] [then $st] [else [$flush $st $where]]] "table" $l]]
      [else [?if [$strings:starts-with $l "- "]
        [then [$push-line [?if [= $mode "list"] [then $st] [else [$flush $st $where]]] "list" $l]]
      [else [?if [and [= $mode "list"] [$strings:starts-with $l "  "]]
        [then [$push-line $st "list" $l]]
      [else [$push-line [?if [= $mode "para"] [then $st] [else [$flush $st $where]]] "para" $l]]]]]]]]]]]]]]]]]

[?def markdown scope=public impure ($md $where)
  [$map:get
    [$flush [$fp:fold [$strings:split-lines $md] {html: "", mode: "none", lang: "", buf: ()}
              [?fn ($st $l) [$step $st $l $where]]]
            $where]
    "html"]]

# ── the site's own placeholders ─────────────────────────────────────────────


# The repository map: the front door and every repository the split has
# published (status=extracted), in registry order, grouped by group=.
[?const GROUPS ("dist", "core", "platform", "binding", "ecosystem")]
[?const GROUP-TITLE {dist: "the front door", core: "the two cores", platform: "the platform group",
                     binding: "the bindings", ecosystem: "the ecosystem"}]

[?def shown-repos scope=public impure ($self) [$sc:shown-repos $self]]

[; A row whose group= is not one of GROUPS would silently drop off the map, so
   it is refused by name instead: a new group is a new heading here first. ]
[?def repo-map scope=public impure ($self $files)
  [?let [= $rs [$shown-repos $self]]
        [= $stray [?for [in $r $rs] [where [not [$pb:member GROUPS [$string $r@group]]]]
                    [yield [$string $r@name]]]]
        [= $_g [?if [$empty $stray] [then 0]
                 [else [$die [$concat "registry/repos.cxd row(s) with a group= the repository map has "
                                      "no heading for: " [$strings:join $stray " "]]]]]]
    [$strings:join (
      "| group | repository | what it is | ships |",
      "|---|---|---|---|",
      [$strings:join [?for [in $g GROUPS]
        [= $mine [?for [in $r $rs] [where [= [$string $r@group] $g]] [yield $r]]]
        [in $i [$range 1 [$count $mine]]]
        [= $r [$nth $mine $i]]
        [= $page [$concat "repo-" [$string $r@name] ".html"]]
        [yield [$concat "| " [?if [= $i 1] [then [$map:get GROUP-TITLE $g]] [else ""]]
                        " | [" [$string $r@name] "]("
                        [?if [$pb:member $files $page] [then $page]
                          [else [$concat "https://github.com/cx-home/" [$string $r@name]]]] ")"
                        " | " [$string $r@about]
                        " | " [$string $r@ships] " |"]]] "\n"]) "\n"]]]

[?def count-of scope=public impure ($what $self $nrefs) [$sc:count-of $what $self $nrefs]]

# The ring figure rides through the Markdown pass as a bare token (raw HTML
# would be escaped there) and is substituted into the rendered page after it;
# so do the fixture blocks, the running example and the one lead.
[?const FIGURE-TOKEN "@@FIGURE:rings@@"]
[?const FIGURE-PLAIN-TOKEN "@@FIGURE:rings-plain@@"]
[?const TLDR-LEAD-TOKEN "@@TLDR:lead@@"]
[?def place-figure scope=public impure ($html)
  [$strings:replace
    [$strings:replace $html [$concat "<p>" FIGURE-TOKEN "</p>\n"]
      [$concat "<div class=\"hero-fig site-fig\"><a href=\"rings.html\" aria-label=\"The rings, page\">"
               [$rs:ring-svg]
               "</a><div class=\"fig-caption\">Fig. 1 — two rings, the groups above them, drawn from the registry when this page was built · <a href=\"rings.html\">the rings page</a></div></div>\n"]]
    [$concat "<p>" FIGURE-PLAIN-TOKEN "</p>\n"]
    [$concat "<figure class=\"ring-figure home-rings\"><a href=\"rings.html\" aria-label=\"The rings, page\">"
             [$rs:ring-svg-plain]
             "</a><figcaption class=\"fig-caption\">Fig. 1 — two rings, the groups above them, imports pointing inward · drawn from the registry when this page was built · <a href=\"rings.html\">every module named, on the rings page</a></figcaption></figure>\n"]]]

# esc-attr: text inside a double-quoted attribute.
[?def esc-attr scope=public ($s) [$strings:replace [$esc $s] "\"" "&quot;"]]

# site-refs: the case ids {{HERO:…}} and {{FIXTURE:…}} cite — replayed and
# verified like {{EXAMPLE:…}}'s, and counted by {{COUNT:examples}}.
[?def refs-of-kind scope=public impure ($tmpl $kind)
  [?for [in $m [$re:find-all [$re:compile [$concat "\\{\\{" $kind ":([^} ]+)\\}\\}"]] $tmpl]]
    [yield [$re:group $m 1]]]]
[?def site-refs scope=public impure ($tmpl)
  [$pb:cat-seqs ([$refs-of-kind $tmpl "HERO"], [$refs-of-kind $tmpl "FIXTURE"])]]

# fixture-html: one replayed case as the guide shows one (guide_build.cx's
# fixture-block, the same classes): its document and program when it has
# them, the invocation with the LIVE output, and where the case lives.
[?def fixture-html scope=public impure ($id $ctx)
  [?let [= $sec [$pb:lookup [$map:get $ctx "index"] $id [$map:get $ctx "where"]]]
        [= $rep [$map:get [$map:get $ctx "replays"] $id]]
        [= $data [?else [$map:get $sec "in-cx"] "[empty]"]]
        [= $code [?else [$map:get $sec "in-code"] ""]]
    [$concat
      "<div class=\"fixture\">\n"
      [?if [= $data "[empty]"] [then ""]
        [else [$concat "<p class=\"fixture-file\"><code>input.cx</code></p>\n<pre><code lang=\"cx\">" [$esc $data] "</code></pre>\n"]]]
      [?if [= $code ""] [then ""]
        [else [$concat "<p class=\"fixture-file\"><code>prog.cx</code></p>\n<pre><code lang=\"cx\">" [$esc $code] "</code></pre>\n"]]]
      "<pre class=\"sample-output\"><code>$ " [$esc [$string $rep@cmd]] "\n" [$esc [$string $rep@out]] "</code></pre>\n"
      "<p class=\"fixture-src\">Fixture <code>" [$esc $id] "</code> in <code>" [$esc [$string [$map:get $sec "suite"]]]
      "</code> — replayed against this cx when the page was built.</p>\n"
      "</div>\n"]]]

# hero-html: the running example. The program and the recorded answer are in
# the page's bytes (a browser without the engine sees them, never a blank);
# home-script below runs the same program in the browser and marks the
# answer as run when it equals the fixture's. A case whose recorded answer
# is a refusal, or matched by containment, cannot be the hero.
[?def hero-html scope=public impure ($id $ctx)
  [?let [= $sec [$pb:lookup [$map:get $ctx "index"] $id [$map:get $ctx "where"]]]
        [= $rep [$map:get [$map:get $ctx "replays"] $id]]
        [= $exp [$pb:expected-of $sec]]
        [= $code [?else [$map:get $sec "in-code"] ""]]
        [= $data [?else [$map:get $sec "in-cx"] "[empty]"]]
        [= $_m [?if [and [= [$string $exp@mode] "exact"] [not [$strings:starts-with [$strings:trim [$string $exp@text]] "[err"]]]
                 [then 0]
                 [else [$die [$concat "{{HERO:" $id "}} — the running example must record an exact answer that is not a refusal"]]]]]
        [= $_c [?if [and [not [= $code ""]] [= $data "[empty]"]] [then 0]
                 [else [$die [$concat "{{HERO:" $id "}} — the running example is a program with no input document"]]]]]
    [$concat
      "<figure class=\"home-run\" id=\"home-run\" data-id=\"" [$esc-attr $id] "\" data-expected=\"" [$esc-attr [$string $exp@text]] "\">\n"
      "<p class=\"fixture-file\"><code>prog.cx</code></p>\n"
      "<pre><code lang=\"cx\" id=\"home-run-src\">" [$esc $code] "</code></pre>\n"
      "<pre class=\"sample-output\"><code id=\"home-run-out\">$ " [$esc [$string $rep@cmd]] "\n" [$esc [$string $rep@out]] "</code></pre>\n"
      "<p class=\"home-run-verdict\" id=\"home-run-verdict\" data-state=\"recorded\">Recorded when this page was built · looking for the engine…</p>\n"
      "<p class=\"fixture-src\">Fixture <code>" [$esc $id] "</code> in <code>" [$esc [$string [$map:get $sec "suite"]]]
      "</code> — replayed against this cx when the page was built.</p>\n"
      "</figure>\n"]]]

# place-blocks: every token the Markdown pass carried — a fixture block, the
# running example, the one lead — replaced by its HTML; a token left
# over is refused, never printed.
[?def place-blocks scope=public impure ($html $ctx)
  [?let [= $tmpl [$map:get $ctx "tmpl"]]
        [= $with-fixtures [$fp:fold [$distinct [$refs-of-kind $tmpl "FIXTURE"]] $html
          [?fn ($acc $id)
            [$strings:replace $acc [$concat "<p>@@FIXTURE:" $id "@@</p>\n"] [$fixture-html $id $ctx]]]]]
        [= $with-hero [$fp:fold [$distinct [$refs-of-kind $tmpl "HERO"]] $with-fixtures
          [?fn ($acc $id)
            [?let [= $block [$hero-html $id $ctx]]
              [$strings:replace
                [$strings:replace $acc [$concat "<p>@@HERO:" $id "@@</p>\n"] $block]
                [$concat "@@HERO:" $id "@@"] $block]]]]]
        [= $led [$strings:replace $with-hero [$concat "<p>" TLDR-LEAD-TOKEN "</p>\n"]
                  [$concat "<p class=\"lede\">" [$inline [$pb:tldr-part "lead"] [$map:get $ctx "where"]] "</p>\n"]]]
    [?if [$present [$strings:find $led "@@"]]
      [then [$die "a placeholder token was left in the page — a {{FIXTURE:}}, {{HERO:}} or {{TLDR:lead}} not on a line of its own, or a {{FIGURE:}} this build does not draw"]]
      [else $led]]]]

# guide-sidebar: the sidebar `make guide` rendered into docs/guide/index.html
# — the five groups, Home active — so the landing and the guide share one
# frame (nav_shape_check.cx reads the same markup back from the site).
[?def guide-sidebar scope=public impure ()
  [?let [= $p "docs/guide/index.html"]
        [= $h [?if [$io:is-file $p] [then [$io:read-file $p]]
                [else [$die [$concat $p " is not there — the landing page wears the guide's sidebar; run `make guide` first (make site-index does)"]]]]]
        [= $i [$strings:find $h "<aside class=\"sidebar\">"]]
        [= $j [$strings:find $h "</aside>"]]
    [?if [or [not [$present $i]] [not [$present $j]]]
      [then [$die [$concat $p " carries no <aside class=\"sidebar\"> … </aside> — the guide's frame moved; teach guide-sidebar the new shape"]]]
      [else [$strings:slice $h $i [+ $j 7]]]]]]

# check-links: every href= and src= of the page names a served file (the
# manifest's [files] lines, index.html itself), a query string or fragment
# aside; external and fragment-only targets are not the site's to check.
[?def link-target scope=public ($t)
  [$first [$strings:split [$first [$strings:split $t "#"]] "?"]]]
[?def check-links scope=public impure ($html $files $where)
  [?let [= $targets [?for [in $m [$re:find-all [$re:compile "(?:href|src)=\"([^\"]*)\""] $html]]
                      [yield [$re:group $m 1]]]]
        [= $bad [?for [in $t [$distinct $targets]]
                  [where [not [or [$strings:starts-with $t "http://"] [or [$strings:starts-with $t "https://"]
                                  [or [$strings:starts-with $t "mailto:"] [or [$strings:starts-with $t "#"]
                                      [$strings:starts-with $t "data:"]]]]]]]
                  [= $f [$link-target $t]]
                  [where [not [or [= $f ""] [or [= $f "index.html"] [$pb:member $files $f]]]]]
                  [yield $t]]]
    [?if [$empty $bad] [then [$count $targets]]
      [else [$die [$concat "the page links a file the site does not serve — no line of " MANIFEST
                           "'s [files] blocks is: " [$strings:join $bad " "] " (in " $where ")"]]]]]]

# home-script: the running example's script — the program from the page's
# own <code>, the engine the playground loads (wasm/cxlib.js, already on the
# page), the answer compared with the fixture's recorded one. document.body's
# data-home-run says what happened (pending → ran | differs | recorded), which
# is what scripts/test_landing_run.mjs reads in headless Chrome.
[?def home-script scope=public ()
  [$strings:join (
    "<script>",
    "// Runs once the deferred scripts above (the engine loader among them) have executed.",
    "document.addEventListener('DOMContentLoaded', function () {",
    "  var fig = document.getElementById('home-run');",
    "  if (!fig) return;",
    "  var out = document.getElementById('home-run-out');",
    "  var verdict = document.getElementById('home-run-verdict');",
    "  var src = document.getElementById('home-run-src').textContent;",
    "  var expected = fig.dataset.expected.replace(/\\n+$/, '');",
    "  var cmd = out.textContent.split('\\n')[0];",
    "  function state(s, text) { verdict.dataset.state = s; verdict.textContent = text; document.body.dataset.homeRun = s; }",
    "  function recorded(why) { state('recorded', 'The answer above is the one recorded when this page was built \\u2014 ' + why); }",
    "  document.body.dataset.homeRun = 'pending';",
    "  var lib = globalThis.cxlib;",
    "  if (!lib || !lib.ready) { recorded('this browser did not load our engine.'); return; }",
    "  lib.ready.then(function () {",
    "    var run = (typeof lib.evalCodeAsync === 'function') ? lib.evalCodeAsync(src, 'cx', '') : Promise.resolve(lib.evalCode(src, 'cx', ''));",
    "    return run.then(function (got) {",
    "      var answer = String(got).replace(/\\n+$/, '');",
    "      out.textContent = cmd + '\\n' + answer;",
    "      if (answer === expected) state('ran', 'Run in your browser just now by libcx.wasm \\u2014 the answer the fixture records.');",
    "      else state('differs', 'Run in your browser just now \\u2014 and it differs from the recorded answer, which is a defect we want to hear about.');",
    "    });",
    "  }).catch(function (e) { recorded('the engine could not run it here (' + (e && e.message ? e.message : e) + ').'); });",
    "});",
    "</script>") "\n"]]

[?def page-link scope=public impure ($parts $files $where)
  [?let [= $target [$strings:slice [$first $parts] 6 [$strings:length [$first $parts]]]]
        [= $file [$first [$strings:split $target "#"]]]
        [= $label [$strings:join [?for [in $i [$range 2 [$count $parts]]] [yield [$nth $parts $i]]] " "]]
    [?if [not [$pb:member $files $file]]
      [then [$die [$concat "{{PAGE:" $target "}} in " $where " names a file the site does not "
                           "serve — no line of " MANIFEST "'s [files] blocks is '" $file "'"]]]
      [else [?if [= $label ""]
        [then [$die [$concat "{{PAGE:" $target "}} in " $where " has no label"]]]
        [else [$concat "[" $label "](" $target ")"]]]]]]]

[?def expand-site-one scope=public impure ($body $ctx)
  [?let [= $parts [$strings:split-whitespace $body]]
        [= $kind [?if [$empty $parts] [then ""] [else [$first $parts]]]]
        [= $where [$map:get $ctx "where"]]
    [?match $kind
      [when [$strings:starts-with $kind "PAGE:"] [$page-link $parts [$map:get $ctx "files"] $where]]
      [when [= $kind "REPO-MAP"] [$repo-map [$map:get $ctx "self"] [$map:get $ctx "files"]]]
      [when [= $kind "FIGURE:rings"] FIGURE-TOKEN]
      [when [= $kind "FIGURE:rings-plain"] FIGURE-PLAIN-TOKEN]
      [when [= $kind "TLDR:lead"] TLDR-LEAD-TOKEN]
      [when [$strings:starts-with $kind "HERO:"] [$concat "@@HERO:" [$strings:slice $kind 6 [$strings:length $kind]] "@@"]]
      [when [$strings:starts-with $kind "FIXTURE:"] [$concat "@@FIXTURE:" [$strings:slice $kind 9 [$strings:length $kind]] "@@"]]
      [when [$strings:starts-with $kind "COUNT:"]
        [$count-of [$strings:slice $kind 7 [$strings:length $kind]] [$map:get $ctx "self"] [$map:get $ctx "nrefs"]]]
      [else [$pb:expand-one $body [$map:get $ctx "index"] [$map:get $ctx "replays"]
                            [$map:get $ctx "version"] [$map:get $ctx "cxbin"] $where]]]]]

# expand: the template, every `{{…}}` replaced (an unclosed one is refused).
[?def expand scope=public impure ($tmpl $ctx)
  [?let [= $chunks [$strings:split $tmpl "{{"]]
        [= $n [$count $chunks]]
    [$strings:join (
      [$first $chunks],
      [$strings:join [?for [in $i [$range 2 $n]]
        [= $ch [$nth $chunks $i]]
        [= $j [$strings:find $ch "}}"]]
        [yield [?if [not [$present $j]]
          [then [$die [$concat "unclosed '{{' in " [$map:get $ctx "where"]]]]
          [else [$concat [$expand-site-one [$strings:slice $ch 1 [- $j 1]] $ctx]
                         [$strings:slice $ch [+ $j 2] [$strings:length $ch]]]]]]] ""]) ""]]]

# ── the page ────────────────────────────────────────────────────────────────

# The landing page wears the guide's chrome (HOME-1): its stylesheet
# (style.css sits at the site root beside it), its sidebar as `make guide`
# rendered it, its sheet bar and its title block; the search box needs the
# guide's index and script, and the running example needs the playground's
# engine loader. Asset URLs carry ?v=<VERSION> exactly as the guide's own
# pages do (#953).
[?def wrap scope=public ($title $ver $sidebar $body)
  [$strings:join (
    "<!DOCTYPE html>",
    "<html lang=\"en\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    [$concat "<title>" [$esc $title] "</title>"],
    "<meta name=\"description\" content=\"CX is one bracketed syntax for documents, queries, programs and the compiler's own tree — exact decimals, deny-by-default effects, errors as values, a content-addressed store.\">",
    "<link rel=\"icon\" type=\"image/svg+xml\" href=\"assets/cx-logo.svg\">",
    "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">",
    "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>",
    "<link href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&display=swap\" rel=\"stylesheet\">",
    [$concat "<link rel=\"stylesheet\" href=\"style.css?v=" $ver "\">"],
    "</head>",
    "<body class=\"site-home\">",
    [$strings:trim-end-chars $sidebar "\n"],
    "<header class=\"sheet-bar\">",
    "  <div class=\"sb-left\"><span class=\"sb-brand\">CX · cxhome.org</span><span class=\"sb-title\">Home</span></div>",
    [$concat "  <div class=\"sb-right\"><a href=\"playground.html\">Playground</a>"
             "<a href=\"downloads.html\">Downloads</a><a href=\"about.html\">About</a>"
             "<span class=\"sb-rev\">v" $ver "</span></div>"],
    "</header>",
    "<main>",
    [$strings:trim-end-chars $body "\n"],
    "</main>",
    "<footer class=\"title-block\">",
    "  <div class=\"tb-cell tb-project\"><span>Project</span><b>CX — one language, data format to platform</b></div>",
    "  <div class=\"tb-cell\"><span>Drawing</span><b>Home</b></div>",
    [$concat "  <div class=\"tb-cell\"><span>Rev</span><b>" $ver "</b></div>"],
    "  <div class=\"tb-cell\"><span>Checked by</span><b class=\"tb-accent\">The compiler</b></div>",
    "  <div class=\"tb-cell\"><span>Issued</span><b>cxhome.org</b></div>",
    "</footer>",
    [$concat "<script src=\"highlight/highlight.js?v=" $ver "\" defer></script>"],
    [$concat "<script src=\"search-index.js?v=" $ver "\" defer></script>"],
    [$concat "<script src=\"search/search.js?v=" $ver "\" defer></script>"],
    [$concat "<script src=\"wasm/cxlib.js?v=" $ver "\" defer></script>"],
    [$home-script],
    "</body>",
    "</html>",
    "") "\n"]]

[?let
  [= $argv [$env:argv]]
  [= $check [$pb:member $argv "--check"]]
  [= $cxbin [$env:var-or-default "CX_BIN" "deps/cx-core-code/vcx/target/cx"]]
  [= $version [$strings:trim [$io:read-file "VERSION"]]]
  [= $m [$cx:parse [$io:read-file MANIFEST]]]
  [= $site [$first [$child-named $m "site"]]]
  [= $page [$first [$child-named $m "page"]]]
  [= $self [$string $site@repo]]
  [= $src [$string $page@src]]
  [= $out [$string $page@out]]
  [= $files [$site-files $m]]
  [= $_f [?if [$empty $files] [then [$die [$concat MANIFEST " declares no [files]"]]] [else 0]]]
  [= $suites [$fp:flat-map [$child-named $m "suites"] [?fn ($k) [$raw-lines $k]]]]
  [= $tmpl [?if [$io:is-file $src] [then [$io:read-file $src]]
             [else [$die [$concat "the page source " $src " is not there"]]]]]
  [= $index [$pb:load-index $suites]]
  [= $refs [$distinct [$pb:cat-seqs ([$pb:refs-in $tmpl], [$site-refs $tmpl])]]]
  [= $tmpdir [$path:join [$env:var-or-default "TMPDIR" "/tmp"] "cx-site-build"]]
  [= $_md [$io:make-dirs $tmpdir]]
  [= $replays [$fp:fold $refs {}
    [?fn ($acc $id) [$pb:add-replay $acc $id $index $cxbin $tmpdir]]]]
  [= $_rm [$io:remove-tree $tmpdir]]
  [= $ctx {index: $index, replays: $replays, version: $version, cxbin: $cxbin,
           where: $src, files: $files, self: $self, nrefs: [$count $refs], tmpl: $tmpl}]
  [= $md [$expand $tmpl $ctx]]
  [= $html [$wrap [$string $page@title] $version [$guide-sidebar]
             [$place-blocks [$place-figure [$markdown $md $src]] $ctx]]]
  [= $nlinks [$check-links $html $files $src]]
  [?if $check
    [then [?let [= $old [?if [$io:is-file $out] [then [$io:read-file $out]] [else "absent"]]]
      [?if [= $old $html]
        [then [?let [= $_s [$say [$concat "site_build: " $out " — " [$string [$count $refs]]
                                          " fixture(s) replayed and verified — no drift"]]]
                [$env:exit 0]]]
        [else [?let [= $_c [$cry [$concat "docs-check: DRIFT: " $out
                                          [?if [= $old "absent"] [then " (not committed)"] [else ""]]
                                          " does not match a fresh generation from " $src
                                          " — run `make docs` and commit the result"]]]
                [$env:exit 1]]]]]]
    [else [?let [= $_w [$io:write-file $out $html]]
                [= $_s [$say [$concat "site_build: " $src " → " $out " (" [$string [$count $refs]]
                                      " fixture(s) replayed and verified, "
                                      [$string [$strings:length $html]] " bytes)"]]]
      [$env:exit 0]]]]]
