# scripts/head_is_docs_only.sh <last-passed> <tip> — does this head need the
# FULL post-merge pipeline, or only the DOC pipeline? (RULED: INT-10)
#
# The words are the delivery grammar's (spec/03-approved/process/delivery-grammar.md
# §4): a run is one pipeline on one commit, and §4's pipeline row names the doc
# pipeline. THIS FILE is where the path list lives — the spec names the pipeline,
# the runner names the paths, so adding a path is a code change with a test and
# not a spec edit.
#
#   exit 0  — docs-only: the post-merge runner (flows/postmerge.flow.cx) runs `make test-docs`
#   exit 1  — full run
#   exit 2  — usage/infrastructure (a missing commit, a bad argument)
#
# 1 and 2 are BOTH "full run" for the caller. That is deliberate: every answer
# this script cannot establish must cost a full run, never skip one. The only
# way to reach exit 0 is an enumerated, non-empty diff.
#
# The base is the last head that PASSED, never the last head that RAN
# (INT-10, delivery grammar §5.6). A failed head is fixed by a fix branch; if
# the base were "last run", a docs commit landing on top of a red head would be
# graded by the doc pipeline and the red would vanish from the log without
# anyone fixing it.
#
# The allow-list, from the INT-10 decision row:
#
#   ledger/…            the decision store
#   docs/…              the GENERATED site (docs-check regenerates it; the doc
#                       pipeline runs docs-check, so drift is still caught)
#   _gate_evidence/…    run artifacts
#   registry/README.md  prose beside the registry — NOT registry/modules.cxd,
#                       which declares every module's ring and is read by
#                       placement-gate, ring-import-gate and ring-tag-gate
#   docs-src/flow/…     the DOCUMENTATION FLOW — its document, env, acts and
#                       simulate tables (RULED: CICD-1). The doc pipeline is
#                       the one run that EXECUTES the flow (`docs-flow`) and
#                       grades the document (`docs-flow-gate`); nothing in the
#                       full matrix reads these files except that gate, which
#                       the doc pipeline also runs — so a change to them costs
#                       the doc run, and it is graded more there, not less.
#                       The rest of docs-src/ is NOT admitted: the .cxd guide
#                       sources and the LLM templates feed steps outside it
#   flows/merge-queue.cxd  the MERGE QUEUE (RULED: MQUE-1; Letter 149): the
#                       integrator's queueing commit. Only the post-merge
#                       loop's merge-queue step reads it, and every branch it
#                       names is graded when that step lands it, so a head
#                       that moves only the queue costs the doc run. This one
#                       file, never the rest of flows/
#   *.md                anywhere EXCEPT spec/03-approved/ — an approved spec is
#                       normative, read by spec-freeze-gate,
#                       check-code-spec-consistency and the citation checker,
#                       so it always costs a full run
#
# Everything else — conformance/, scripts/, the Makefile, vcx/, stdlib/, x/,
# reference/, tools/, corpus/, fixtures/ — is a full run.
# CXMACH-1 (owner 2026-10-16, (a)): the cx rewrite of head_is_docs_only.sh — the same contract,
# allow-list in the same order, lines (all on stderr) and exits (0 docs, 1 full, 2 usage or a
# git failure — full run). flows/private-acts.cx's postmerge-classify runs it on its own cx.
#   cx --allow-read --allow-subprocess scripts/head_is_docs_only.cx <last-passed-sha> <tip-sha>

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/strings' as=strings]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def git scope=public impure ($root $args)
  [?let [= $r [$process:run ('git', '-C', $root, [?splice $args]) capture={stdout: :pipe, stderr: :discard}]]
    [?match $r [case [err$e] [res ok=false out='']] [else [res ok=[= $r@exit-code 0] out=[$string $r@stdout]]]]]]
# the doc allow-list, in the shell's case order: true when the path forces the full run
[?def offends scope=public ($f)
  [?if [or [$strings:starts-with $f 'ledger/'] [$strings:starts-with $f 'docs/'] [$strings:starts-with $f '_gate_evidence/']] [then false]
    [else [?if [= $f 'registry/README.md'] [then false]
      [else [?if [$strings:starts-with $f 'docs-src/flow/'] [then false]
        [else [?if [= $f 'flows/merge-queue.cxd'] [then false]
          [else [?if [$strings:starts-with $f 'spec/03-approved/'] [then true]   # normative, even as .md
            [else [?if [$strings:ends-with $f '.md'] [then false] [else true]]]]]]]]]]]]]

[?let
  [= $av [$env:argv]]
  [= $usage [?fn () [?let [= $_ [$cry [$cat ('usage: ', [$nth $av 1], ' <last-passed-sha> <tip-sha>')]]] [$env:exit 2]]]]
  [= $_n [?if [= [$count $av] 3] [then null] [else [$usage]]]]
  [= $base [$nth $av 2]] [= $tip [$nth $av 3]]
  [= $_b [?if [= $base ''] [then [$usage]] [else null]]]
  [= $_t [?if [= $tip ''] [then [$usage]] [else null]]]
  [= $root [$path:dirname [$path:dirname [$path:absolute [$nth $av 1]]]]]
  [= $_cb [?if [$git $root ('cat-file', '-e', [$cat ($base, '^{commit}')])]@ok [then null]
            [else [?let [= $_ [$cry [$cat ('head_is_docs_only: ', $base, ' is not a commit in this repo — full run')]]] [$env:exit 2]]]]]
  [= $_ct [?if [$git $root ('cat-file', '-e', [$cat ($tip, '^{commit}')])]@ok [then null]
            [else [?let [= $_ [$cry [$cat ('head_is_docs_only: ', $tip, ' is not a commit in this repo — full run')]]] [$env:exit 2]]]]]
  [= $d [$git $root ('diff', '--no-renames', '--name-only', $base, $tip)]]
  [= $_d [?if $d@ok [then null]
           [else [?let [= $_ [$cry [$cat ('head_is_docs_only: git diff ', $base, ' ', $tip, ' failed — full run')]]] [$env:exit 2]]]]]
  [= $files [$strings:trim-end-chars $d@out "\n"]]
  [= $_e [?if [= $files ''] [then [?let [= $_ [$cry [$cat ('head_is_docs_only: empty diff ', $base, '..', $tip, ' — full run')]]] [$env:exit 1]]] [else null]]]
  [= $ls [$strings:split $files "\n"]]
  [= $offenders [?to-sequence [?for [in $f $ls] [where [and [not [= $f '']] [$offends $f]]] [yield $f]]]]
  [?if [> [$count $offenders] 0]
    [then [?let [= $_ [$cry [$cat ('head_is_docs_only: full run — ', [$string [$count $offenders]], ' path(s) outside the doc allow-list, first: ', [$nth $offenders 1])]]] [$env:exit 1]]]
    [else [?let [= $_ [$cry [$cat ('head_is_docs_only: docs — ', [$string [$count $ls]], ' path(s), all inside the doc allow-list')]]] [$env:exit 0]]]]]
