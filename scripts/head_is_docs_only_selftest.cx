# head_is_docs_only_selftest.cx — proves the INT-10 classifier's detection power on
# a SYNTHETIC repo (mktemp; never the live tree — the same rule the
# spec-freeze-gate selftest follows). The classifier's whole value is that it
# SKIPS a full post-merge run, so the cases that must be proved are the ones
# where it must NOT skip.
#
#   A  ledger/ + docs/ only                     → docs   (the case INT-10 exists for)
#   B  a file under spec/03-approved/           → FULL   (normative)
#   C  registry/modules.cxd                     → FULL   (rings are declared there)
#   D  root README.md + ledger/                 → docs
#   E  no last-passed head (empty base arg)     → FULL   (fail-safe)
#   F  a .md UNDER spec/03-approved/            → FULL   (markdown is not the test)
#   L  a .md under spec/03-approved/stdlib/    → FULL   (#1427 phase 2 split std-lib/
#   M  a .md under spec/03-approved/platform/  → FULL    into stdlib/ + platform/;
#                                                        the rule keys on the root)
#   G  code + docs in the same head             → FULL   (one code path is enough)
#   H  registry/README.md                       → docs   (prose beside the registry)
#   I  a rename of a test file INTO docs/       → FULL   (--no-renames)
#   J  base == tip, empty diff (the re-run flag) → FULL   (never a vacuous doc run)
#   K  a base sha that is not a commit           → FULL   (fail-safe)
#   N  docs-src/flow/ (the docs flow) + ledger/  → docs   (RULED: CICD-1 — the doc
#                                                        pipeline runs the flow)
#   O  docs-src/ OUTSIDE flow/ (a guide source)  → FULL   (only flow/ is admitted)
#   P  flows/merge-queue.cxd + _gate_evidence/   → docs   (a queueing commit: MQUE-1,
#                                                        Letter 149)
#   Q  flows/merge-queue.cxd + code              → FULL   (the queue admits no code)
#   R  another file under flows/                 → FULL   (only the queue is admitted)
#
# Exit 0 and the count line only when every case matches.
# CXMACH-1 (owner 2026-10-16, (a)): the cx rewrite of head_is_docs_only_selftest.sh — the same
# eighteen cases on the same synthetic repo, the classifier copied beside it and run on the cx running this, the
# same lines on the same streams and the same exit.
#   $(TOOL_CX) --allow-all scripts/head_is_docs_only_selftest.cx

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/strings' as=strings]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$env:write-line $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def run scope=public impure ($t $argv)
  [?let [= $r [$process:run $argv cwd=$t capture=:both]]
    [?match $r [case [err$e] [r rc=127 out='']] [else [r rc=$r@exit-code out=[$string $r@stdout]]]]]]
[?def git scope=public impure ($t $args) [$run $t ('git', [?splice $args])]]
[?def short-head scope=public impure ($t) [$strings:trim-end-chars [$git $t ('rev-parse', '--short', 'HEAD')]@out "\n"]]
[?def put scope=public impure ($t $rel $s) [?let [= $p [$cat ($t, '/', $rel)]] [= $_d [$io:make-dirs [$path:dirname $p]]] [$io:write-file $p $s]]]
[?def add scope=public impure ($t $rel $s) [$io:append-file [$cat ($t, '/', $rel)] $s]]
[?def commit scope=public impure ($t $msg) [?let [= $_a [$git $t ('add', '-A')]] [$git $t ('commit', '-qm', $msg)]]]

# check — one case: the classifier on BASE..HEAD, docs on exit 0, full otherwise; then back to the
# base commit (every case starts from the same base). The verdict: true when it matched.
[?def check scope=public impure ($t $cls $base0 $name $want $base)
  [?let [= $r [$run $t ([$string [$env:executable-path]], '--allow-all', $cls, $base, [$short-head $t])]]
        [= $got [?if [= $r@rc 0] [then 'docs'] [else 'full']]]
        [= $ok [= $got $want]]
        [= $_p [?if $ok
                 [then [$say [$cat ('  ', [$strings:pad-end $name 4 ' '], ' ', [$strings:pad-end $got 5 ' '], ' ok   (exit ', [$string $r@rc], ')')]]]
                 [else [$cry [$cat ('  ', [$strings:pad-end $name 4 ' '], ' ', [$strings:pad-end $got 5 ' '], ' SELFTEST FAILED: wanted ', $want, ' (exit ', [$string $r@rc], ')')]]]]]
        [= $_r [$git $t ('reset', '-q', '--hard', $base0)]]
        [= $_c [$git $t ('clean', '-qfd')]]
    $ok]]

[?let
  [= $here [$path:dirname [$path:absolute [$nth [$env:argv] 1]]]]
  [= $cls0 [$cat ($here, '/head_is_docs_only.cx')]]
  [= $_0 [?if [$io:is-file $cls0] [then null] [else [?let [= $_ [$cry [$cat ('SELFTEST FAILED: no classifier at ', $cls0)]]] [$env:exit 1]]]]]
  [= $t [$string [$io:temp-dir 'head_is_docs_only_selftest.']]]
  [= $cls [$cat ($t, '/scripts/head_is_docs_only.cx')]]
  [= $_1 [$put $t 'scripts/head_is_docs_only.cx' [$io:read-file $cls0]]]
  [= $_g [$git $t ('init', '-q', '.')]]
  [= $_u1 [$git $t ('config', 'user.email', 't@t')]]
  [= $_u2 [$git $t ('config', 'user.name', 't')]]
  [= $_s1 [$put $t 'README.md' "seed\n"]] [= $_s2 [$put $t 'ledger/seed.md' "seed\n"]] [= $_s3 [$put $t 'docs/index.html' "<p>seed</p>\n"]]
  [= $_s4 [$put $t '_gate_evidence/seed.log' "seed\n"]]
  [= $_s5 [$put $t 'spec/03-approved/thing.md' "seed\n"]]  # spec-path-ok (a planted path)
  [= $_s6 [$put $t 'registry/modules.cxd' "rows\n"]] [= $_s7 [$put $t 'registry/README.md' "registry prose\n"]]
  [= $_s8 [$put $t 'vcx/tests/thing_test.v' "code\n"]] [= $_s9 [$put $t 'scripts/keep.sh' "scripts\n"]]
  [= $_sc [$commit $t 'seed']]
  [= $base [$short-head $t]]
  [= $ck [?fn ($name $want $b) [$check $t $cls $base $name $want $b]]]
  [= $_h [$say 'head_is_docs_only selftest:']]
  [= $a [?let [= $_1 [$add $t 'ledger/seed.md' "a decision\n"]] [= $_2 [$put $t 'docs/index.html' "<p>generated</p>\n"]] [= $_c [$commit $t 'A']] [$ck 'A' 'docs' $base]]]
  [= $b [?let [= $_1 [$put $t 'spec/03-approved/process/thing.txt' "normative\n"]] [= $_c [$commit $t 'B']] [$ck 'B' 'full' $base]]]  # spec-path-ok (a planted path)
  [= $c [?let [= $_1 [$add $t 'registry/modules.cxd' "a new row\n"]] [= $_c [$commit $t 'C']] [$ck 'C' 'full' $base]]]
  [= $d [?let [= $_1 [$add $t 'README.md' "prose\n"]] [= $_2 [$add $t 'ledger/seed.md' "more\n"]] [= $_c [$commit $t 'D']] [$ck 'D' 'docs' $base]]]
  [= $e [?let [= $_1 [$add $t 'README.md' "prose\n"]] [= $_c [$commit $t 'E']] [$ck 'E' 'full' '']]]
  [= $f [?let [= $_1 [$add $t 'spec/03-approved/thing.md' "a normative clause\n"]] [= $_c [$commit $t 'F']] [$ck 'F' 'full' $base]]]  # spec-path-ok (a planted path)
  [= $l [?let [= $_1 [$put $t 'spec/03-approved/stdlib/json.md' "a normative clause\n"]] [= $_c [$commit $t 'L']] [$ck 'L' 'full' $base]]]
  [= $m [?let [= $_1 [$put $t 'spec/03-approved/platform/audit.md' "a normative clause\n"]] [= $_c [$commit $t 'M']] [$ck 'M' 'full' $base]]]
  [= $g [?let [= $_1 [$add $t 'vcx/tests/thing_test.v' "fn test_new() {}\n"]] [= $_2 [$add $t 'ledger/seed.md' "and prose\n"]] [= $_c [$commit $t 'G']] [$ck 'G' 'full' $base]]]
  [= $h [?let [= $_1 [$add $t 'registry/README.md' "more prose\n"]] [= $_c [$commit $t 'H']] [$ck 'H' 'docs' $base]]]
  [= $i [?let [= $_1 [$git $t ('mv', 'vcx/tests/thing_test.v', 'docs/thing_test.v')]] [= $_c [$git $t ('commit', '-qm', 'I')]]
              [= $nonempty [not [= [$git $t ('diff', '--name-only', $base, 'HEAD')]@out '']]]
              [= $_e [?if $nonempty [then null] [else [$cry 'SELFTEST FAILED: case I built an empty diff']]]]
          [+ [?if [$ck 'I' 'full' $base] [then 0] [else 1]] [?if $nonempty [then 0] [else 1]]]]]
  [= $j [$ck 'J' 'full' [$short-head $t]]]
  [= $k [?let [= $_1 [$add $t 'ledger/seed.md' "prose\n"]] [= $_c [$commit $t 'K']] [$ck 'K' 'full' 'deadbee']]]
  [= $kbase [$short-head $t]]
  [= $n [?let [= $_1 [$put $t 'docs-src/flow/docs.flow.cx' "[flow name=\"docs\"]\n"]] [= $_2 [$put $t 'docs-src/flow/docs-acts.cx' "[?def generate () [generated]]\n"]]
              [= $_3 [$add $t 'ledger/seed.md' "prose\n"]] [= $_c [$commit $t 'N']] [$ck 'N' 'docs' $kbase]]]
  [= $nbase [$short-head $t]]
  [= $o [?let [= $_1 [$put $t 'docs-src/canonical/page.cxd' "[section]\n"]] [= $_c [$commit $t 'O']] [$ck 'O' 'full' $nbase]]]
  [= $p [?let [= $_1 [$put $t 'flows/merge-queue.cxd' "[merge-queue\n]\n"]] [= $_2 [$add $t '_gate_evidence/seed.log' "evidence\n"]] [= $_c [$commit $t 'P']] [$ck 'P' 'docs' $base]]]
  [= $q [?let [= $_1 [$put $t 'flows/merge-queue.cxd' "[merge-queue\n]\n"]] [= $_2 [$add $t 'vcx/tests/thing_test.v' "more code\n"]] [= $_c [$commit $t 'Q']] [$ck 'Q' 'full' $base]]]
  [= $rr [?let [= $_1 [$put $t 'flows/merge.flow.cx' "[flow name=\"merge\"]\n"]] [= $_c [$commit $t 'R']] [$ck 'R' 'full' $base]]]
  [= $_x [?else [$io:remove-tree $t] null]]
  [= $fails [+ $i [$count [?for [in $v ($a, $b, $c, $d, $e, $f, $l, $m, $g, $h, $j, $k, $n, $o, $p, $q, $rr)] [where [not $v]] [yield 1]]]]]
  [?if [> $fails 0]
    [then [?let [= $_ [$cry [$cat ('head_is_docs_only selftest: ', [$string $fails], ' case(s) FAILED')]]] [$env:exit 1]]]
    [else [?let [= $_ [$say 'head_is_docs_only selftest: 18/18 (docs A/D/H/N/P; full B/C/E/F/G/I/J/K/O/Q/R and L/M, the #1427 stdlib/ + platform/ split)']] [$env:exit 0]]]]]
