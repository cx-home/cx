# scripts/run_bench_json.cx — V7 bench runner with JSON output (#922 CX port
# of the retired scripts/run_bench_json.py).
#
# Drives `make bench-streaming` and parses the human-readable output into a
# machine-readable JSON object suitable for scripts/compare_bench.cx.
#
# Usage (program args are positional after the FILE, cli.md §3 / PYE-2):
#   cx --allow-read --allow-write --allow-subprocess --allow-clock \
#      scripts/run_bench_json.cx                  # emit JSON to stdout
#   cx … scripts/run_bench_json.cx -o bench.json  # write to file
#   cx … scripts/run_bench_json.cx --include-eval # add the T1 evaluator bench
#   (or: make bench-json)
#
# Output schema:
#   {
#     "schema_version": 1,
#     "run_id": "2026-05-18T14:00:00Z",
#     "cx_commit": "abc1234",
#     "uname": "Darwin 25.4.0 arm64",
#     "load_1m_start": 0.8,   (#1450: -1 when this box's load cannot be read)
#     "load_1m_end": 1.1,
#     "load_1m_bound": 8.0,
#     "benchmarks": {
#       "streaming.buffered_ms":  { "median": 320.0, "unit": "ms" },
#       "streaming.streaming_ms": { "median": 280.0, "unit": "ms" },
#       ...
#     }
#   }
#
# Designed so adding more bench harnesses (FLWOR, ?fn, partial app) is a
# matter of appending entries to the `benchmarks` map under stable keys.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/json'    as=json]
[?lib 'cx-stdlib/map'     as=map]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/time'    as=time]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/math'    as=math]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]
[?def matched scope=public ($m) [> [?else $m@start -1] -1]]

[?const ARG_SPEC [argspec
  [flag name="output"       short="o" type=string]
  [flag name="include-eval"           type=bool]]]

# The T1 rows this gate REQUIRES, as a closed set (#759). Parsing whatever
# happens to appear is what let the whole bench die unnoticed: every program
# string had been written in the retired colon-slot FLWOR surface, `run_once`
# panicked on the first case, the harness produced ZERO measurements, and the
# perf gate simply carried fewer keys — a silent coverage loss, not a failure.
# Checked in BOTH directions: a missing row fails (coverage lost), and an
# unexpected row fails too (a new bench case is added here deliberately rather
# than drifting in). Retired rows — `op.arrow` with the postfix arrow,
# `flwor.tumbling` with `[?for-tumbling]` — are simply absent.
[?const T1_EXPECTED_KEYS ('flwor.where', 'flwor.count', 'flwor.order_by',
                          'flwor.group_by', 'fn.call_x500',
                          'partial.invoke_x500', 'op.pipeline',
                          'match.string', 'regex.matches_x500',
                          'op.to_range_10k')]

[?def die scope=public impure ($msg) ([$cry $msg], [$env:exit 1], null)]

# ── the ISOLATION guard (#1450) ──────────────────────────────────────────────
#
# Holding the runner is not enough. Measured on impl/cx-A-1433 (2026-09-14,
# _gate_evidence/pipeline_1433/RESULTS.md): with `.build-slot-impl` HELD,
# `tooling.fmt_8k_ms` read 1902.1 ms against a hot 1304 ms and four unrelated
# rows regressed 36-457 %, because six pre-merge pipelines were compiling on the
# OTHER runner and in worktrees. The runner serialises what goes through it; it
# does not own the box.
#
# So a reading taken on a loaded box is not a reading. This runner REFUSES to
# take one — a named refusal with its own exit code, never a FAIL — and records
# the load either side of the measurement in the artifact, so any row in
# bench/current.json can be classified afterwards from the file alone.
#
# The bound is CX_BENCH_MAX_LOAD, default 8 on this 12-core box. An UNREADABLE
# load (no sysctl, no vm.loadavg) records -1 and measures anyway: the guard
# exists to stop a bad number being believed, not to stop a cut on a platform
# whose load this cannot read.
[?const LOAD-UNREADABLE -1.0e0]
[?const REFUSED-EXIT 3]

[?def load-1m scope=public impure ()
  [?let
    [= $r [?fallback [$process:run ('sysctl', '-n', 'vm.loadavg')]
            [recover-with [proc-result exit-code=1 stdout='']]]]
    [= $txt [?if [= $r@exit-code 0]
              [then [$strings:trim-chars [$strings:trim [$string $r@stdout]] '{} ']]
              [else '']]]
    [= $parts [?to-sequence [$strings:split-whitespace $txt]]]
    [?if [> [$count $parts] 0]
      [then [* [?else [$strings:to-number [$first $parts]] LOAD-UNREADABLE] 1.0e0]]
      [else LOAD-UNREADABLE]]]]

[?def max-load scope=public impure () [$env:var-float 'CX_BENCH_MAX_LOAD' 8.0e0]]

[; a load average is read by a human at a cut, so it is rendered with one
   decimal rather than as `1.7e2`. Round-half-even on the scaled value, the
   same shape scripts/compare_bench.cx's `fixed1` uses. ]
[?def load-str scope=public ($v)
  [?let [= $n [$math:round-half-even [* [* $v 1.0e0] 10.0e0]]]
        [= $neg [< $n 0]]
        [= $a [?if $neg [then [- 0 $n]] [else $n]]]
        [= $body [$cat ([$string [$div $a 10]], '.', [$string [$mod $a 10]])]]
    [?if $neg [then [$cat ('-', $body)]] [else $body]]]]

[?def refuse-if-loaded scope=public impure ($load $bound)
  [?if [and [> $load LOAD-UNREADABLE] [> $load $bound]]
    [then ([$cry [$cat ('run_bench_json: REFUSING TO MEASURE — the one-minute load average is ',
                        [$load-str $load], ', over the bound of ', [$load-str $bound], '.')]],
           [$cry '  A reading taken on a loaded box is not a reading: with the runner held and six'],
           [$cry '  pipelines compiling beside it, tooling.fmt_8k_ms read 1902 ms against a hot 1304'],
           [$cry '  and four unrelated rows regressed 36-457 % (#1450, impl/cx-A-1433 run 4).'],
           [$cry '  This is a REFUSAL, not a regression: wait for the box, or raise CX_BENCH_MAX_LOAD'],
           [$cry '  deliberately. scripts/tag_release.sh waits for the bound rather than aborting.'],
           [$env:exit REFUSED-EXIT], null)]
    [else null]]]

[?def cx-commit scope=public impure ()
  [?let [= $r [?fallback [$process:run ('git', 'rev-parse', '--short', 'HEAD')]
                [recover-with [proc-result exit-code=1 stdout='']]]]
    [?if [= $r@exit-code 0] [then [$strings:trim [$string $r@stdout]]] [else 'unknown']]]]

[?def uname-str scope=public impure ()
  [?let [= $r [?fallback [$process:run ('uname', '-srm')]
                [recover-with [proc-result exit-code=1 stdout='']]]]
    [?if [= $r@exit-code 0] [then [$strings:trim [$string $r@stdout]]] [else 'unknown']]]]

[; UTC timestamp %Y-%m-%dT%H:%M:%SZ — iso8601 truncated to seconds. ]
[?def run-id scope=public impure ()
  [$cat ([$strings:slice [$time:format-iso8601 [$time:utc-now]] 1 19], 'Z')]]

[; Run `make bench-streaming`, parse `buffered : N ms` / `streaming : N ms`. ]
[?def run-streaming-bench scope=public impure ()
  [?let
    [= $r [$process:run ('make', 'bench-streaming')]]
    [= $_fail [?if [not [= $r@exit-code 0]]
      [then ([$cry [$string $r@stderr]],
             [$die [$cat ('bench-streaming exited ', [$string $r@exit-code])]])]
      [else ()]]]
    [= $rx-buf [$re:compile '^\\s*buffered\\s*:\\s*(\\d+)\\s*ms']]
    [= $rx-str [$re:compile '^\\s*streaming\\s*:\\s*(\\d+)\\s*ms']]
    [= $lines [$strings:split [$string $r@stdout] '\n']]
    [= $out
      [$fp:fold $lines {} [?fn ($acc $line)
        [?let [= $mb [$re:find $rx-buf $line]]
              [= $ms [$re:find $rx-str $line]]
          [?if [$matched $mb]
            [then [$map:put $acc 'streaming.buffered_ms'
                    {median: [?else [$strings:to-float [$re:group $mb 1]] 0.0e0], unit: 'ms'}]]
            [else [?if [$matched $ms]
              [then [$map:put $acc 'streaming.streaming_ms'
                      {median: [?else [$strings:to-float [$re:group $ms 1]] 0.0e0], unit: 'ms'}]]
              [else $acc]]]]]]]]
    [?if [not [and [$map:contains $out 'streaming.buffered_ms']
                   [$map:contains $out 'streaming.streaming_ms']]]
      [then ([$cry [$string $r@stdout]],
             [$die 'could not parse streaming bench output; see stdout above'])]
      [else $out]]]]

[; Run `make bench-eval`, parse the T1 evaluator-feature lines, enforce the
   closed key set in both directions. ]
[?def run-eval-features-bench scope=public impure ()
  [?let
    [= $r [$process:run ('make', 'bench-eval')]]
    [= $_fail [?if [not [= $r@exit-code 0]]
      [then ([$cry [$string $r@stderr]],
             [$die [$cat ('bench-eval exited ', [$string $r@exit-code])]])]
      [else ()]]]
    [= $rx [$re:compile '^\\s+(?P<key>[a-z][a-z0-9_.]+)\\s+median=\\s*(?P<median>[\\d.]+)ms']]
    [= $lines [$strings:split [$string $r@stdout] '\n']]
    [= $out
      [$fp:fold $lines {} [?fn ($acc $line)
        [?let [= $m [$re:find $rx $line]]
          [?if [$matched $m]
            [then [$map:put $acc [$cat ('eval.', [$re:group-named $m 'key'])]
                    {median: [?else [$strings:to-float [$re:group-named $m 'median']] 0.0e0],
                     unit: 'ms'}]]
            [else $acc]]]]]]
    [= $_empty [?if [= [$map:size $out] 0]
      [then ([$cry [$string $r@stdout]],
             [$die 'could not parse bench-eval output; see stdout above'])]
      [else ()]]]
    [= $seen [?for [in $k [$map:keys $out]]
               [yield [$strings:slice $k 6 [$strings:length $k]]]]]
    [= $missing [$sort [?for [in $k T1_EXPECTED_KEYS]
                  [where [not [$present [?for [in $s $seen] [where [= $s $k]] [yield 1]]]]]
                  [yield $k]]]]
    [= $unexpected [$sort [?for [in $k $seen]
                     [where [not [$present [?for [in $s T1_EXPECTED_KEYS] [where [= $s $k]] [yield 1]]]]]
                     [yield $k]]]]
    [= $_miss [?if [> [$count $missing] 0]
      [then ([$cry [$string $r@stdout]],
             [$die [$cat ('bench-eval lost T1 coverage — these rows produced no measurement: ',
                          [$strings:join $missing ', '],
                          ' (a row that stops running must FAIL this gate, never silently ',
                          'reduce the key set; see #759)')]])]
      [else ()]]]
    [= $_unex [?if [> [$count $unexpected] 0]
      [then [$die [$cat ('bench-eval emitted T1 rows not in the expected set: ',
                         [$strings:join $unexpected ', '],
                         ' — add them to T1_EXPECTED_KEYS deliberately so the set stays closed')]]]
      [else ()]]]
    $out]]

[; Run `make bench-code-streaming` (gate 15, #804) and parse each shape's
   `mean input throughput : N MB/s` under its `shape NAME : …` header into
   `code_streaming.<name>_mbps`. HIGHER is better — compare_bench inverts the
   ratio for a `_mbps` key (#1249, RULED: 1249-Q1a): this is the number the
   I5 audit found unmeasured for eight releases. ]
[?def run-code-streaming-bench scope=public impure ()
  [?let
    [= $r [$process:run ('make', 'bench-code-streaming')]]
    [; The bench exits 2 when ITS OWN gate-15 verdict is red (the ≥ 200 MB/s
       floor — #804's open map shape). That verdict is data here: the ratchet
       compares against the previous cut, so the numbers are read regardless
       and only an UNPARSEABLE run dies. ]
    [= $_note [?if [not [= $r@exit-code 0]]
      [then [$cry [$cat ('note: bench-code-streaming exited ', [$string $r@exit-code],
                         ' (its own gate-15 verdict); throughput rows still read')]]]
      [else ()]]]
    [= $rx-shape [$re:compile '^\\s+shape\\s+(?P<name>[A-Za-z0-9_-]+)\\s+:']]
    [= $rx-mean [$re:compile '^\\s+mean input throughput\\s+:\\s+(?P<mbps>[\\d.]+)\\s+MB/s']]
    [= $lines [$strings:split [$string $r@stdout] '\n']]
    [= $folded
      [$fp:fold $lines {shape: '', out: {}} [?fn ($acc $line)
        [?let
          [= $ms [$re:find $rx-shape $line]]
          [= $mm [$re:find $rx-mean $line]]
          [?if [$matched $ms]
            [then {shape: [$re:group-named $ms 'name'], out: $acc.out}]
            [else [?if [and [$matched $mm] [not [= $acc.shape '']]]
              [then {shape: '',
                     out: [$map:put $acc.out
                            [$cat ('code_streaming.', [$strings:replace $acc.shape '-' '_'], '_mbps')]
                            {median: [?else [$strings:to-float [$re:group-named $mm 'mbps']] 0.0e0],
                             unit: 'MB/s'}]}]
              [else $acc]]]]]]]]
    [= $out $folded.out]
    [= $_empty [?if [= [$map:size $out] 0]
      [then ([$cry [$string $r@stdout]],
             [$die 'could not parse bench-code-streaming output (no `shape … :` + `mean input throughput` pairs); see stdout above'])]
      [else ()]]]
    $out]]

[; #1281 — `cx fmt` on a generated 8,000-record document (~1.4 MB): the
   standalone formatter was a 26 s / 3.3 GB outlier against ~1 s for
   `--from=cx --to=cx` on the same bytes, because its structural fingerprint
   rendered the whole program AST through V's debug `.str()`. Median wall
   time of five runs of the built binary, so the ratchet holds the fix. The
   document is written under a temp dir and removed. ]
[?def fmt-bench-doc scope=public ()
  [$cat ('[records\n',
         [$strings:join [?for [in $i [$range 1 8000]]
           [yield [$cat ('  [rec id=', [$string $i], ' name="Customer ', [$string $i],
                         '" email="user', [$string $i], '@example.com" total=',
                         [$string [* $i 7]], '.50 status=on-time [note "Line one of the note for record ',
                         [$string $i], '"] [tags [tag a] [tag b] [tag c]]]')]]] '\n'],
         '\n]\n')]]

[?def run-fmt-bench scope=public impure ()
  [?let
    [= $dir [$io:temp-dir 'cx-bench-fmt']]
    [= $path [$cat ($dir, '/records-8k.cx')]]
    [= $_w [$io:write-file $path [$fmt-bench-doc]]]
    [= $samples [?for [in $i [$range 1 5]]
      [= $t0 [$time:monotonic-now]]
      [= $r [$process:run ('vcx/target/cx', 'fmt', $path)]]
      [= $t1 [$time:monotonic-now]]
      [where [= $r@exit-code 0]]
      [yield [/ [- $t1 $t0] 1000000.0e0]]]]
    [= $_rm ([$io:remove $path], [$io:remove-dir $dir])]
    [?if [< [$count $samples] 5]
      [then [$die 'cx fmt failed on the 8k-record bench document — the tooling.fmt_8k_ms row cannot be measured']]
      [else {'tooling.fmt_8k_ms': {median: [$math:median $samples], unit: 'ms'}}]]]]

[; #1226 — `--from=json --to=json` on the bench/repr JSON corpus shape at
   300,000 records (19 MB): the parse-side passes used to hold up to three
   copies of the 144 MB tree live at once and the pacer committed 16 arenas
   (1.18 GB peak RSS). Two rows: wall time, and the PEAK COMMITTED ARENAS read
   from the vgc trace (`arenas=N` on the last cycle — arenas are never
   released, so the last value is the high-water mark; 64 MB each). Arenas are
   the platform-independent proxy for peak RSS the ratchet can hold to. The
   corpus is a pure function of the record index (bench/repr/repr.v gen_json),
   written under a temp dir and removed. ]
[?def convert-bench-doc scope=public ()
  [$cat ('[',
         [$strings:join [?for [in $i [$range 0 299999]]
           [= $id [+ 100000 $i]]
           [yield [$cat ('{"id":', [$string $id], ',"name":"user-', [$string $id], '","active":',
                         [?if [= [% $i 2] 0] [then 'true'] [else 'false']],
                         ',"score":', [$string [+ 100 [% $i 900]]], '.5}')]]] ','],
         ']')]]

[?def trace-peak-arenas scope=public ($trace::string)
  [?let [= $rx [$re:compile 'arenas=(\\d+)']]
        [= $vals [?for [in $m [$re:find-all $rx $trace]] [yield [?else [$strings:to-number [$re:group $m 1]] 0]]]]
    [?if [$exists $vals] [then [$math:max $vals]] [else 0]]]]

[?def run-convert-bench scope=public impure ()
  [?let
    [= $dir [$io:temp-dir 'cx-bench-convert']]
    [= $path [$cat ($dir, '/records-300k.json')]]
    [= $_w [$io:write-file $path [$convert-bench-doc]]]
    [= $runs [?for [in $i [$range 1 3]]
      [= $t0 [$time:monotonic-now]]
      [= $r [$process:run ('vcx/target/cx', '--from=json', '--to=json', $path) env=[map VGC_GCTRACE="1"] capture=:stderr]]
      [= $t1 [$time:monotonic-now]]
      [where [= $r@exit-code 0]]
      [yield {ms: [/ [- $t1 $t0] 1000000.0e0], arenas: [$trace-peak-arenas [$string $r@stderr]]}]]]
    [= $_rm ([$io:remove $path], [$io:remove-dir $dir])]
    [?if [< [$count $runs] 3]
      [then [$die 'cx --from=json --to=json failed on the 300k-record bench document — the convert.json_300k rows cannot be measured']]
      [else {'convert.json_300k_ms': {median: [$math:median [?for [in $x $runs] [yield $x.ms]]], unit: 'ms'},
             'convert.json_300k_arenas': {median: [$math:median [?for [in $x $runs] [yield $x.arenas]]], unit: 'arenas'}}]]]]

[?let
  [= $args [?fallback [$env:parse-args ARG_SPEC]
             [recover-with ([$cry 'usage: run_bench_json.cx [-o FILE] [--include-eval]'],
                            [$env:exit 2], null)]]]
  [; an unpassed string flag surfaces as null — normalize to ''. ]
  [= $output-raw [?else [$env:flag $args 'output'] '']]
  [= $output [?if [= $output-raw null] [then ''] [else $output-raw]]]
  [= $include-eval [?else [$env:flag $args 'include-eval'] false]]

  [; #1450 — the isolation guard runs BEFORE the first harness, so a refusal
     costs seconds rather than the whole bench suite. ]
  [= $bound [$max-load]]
  [= $load-start [$load-1m]]
  [= $_guard [$refuse-if-loaded $load-start $bound]]

  [= $streaming [$map:merge ([$run-streaming-bench], [$run-code-streaming-bench], [$run-fmt-bench], [$run-convert-bench])]]
  [= $benchmarks [?if $include-eval
    [then [$map:merge ($streaming, [$run-eval-features-bench])]]
    [else $streaming]]]

  [; the load either side of the measurement, so a row in this artifact is
     classifiable from the file alone (#1450). load_1m_end is recorded and NOT
     judged: a box that got busy during the run is visible in the artifact, and
     a second refusal after the work is spent would only throw the reading away. ]
  [= $load-end [$load-1m]]
  [= $report {schema_version: 1,
              run_id: [$run-id],
              cx_commit: [$cx-commit],
              uname: [$uname-str],
              load_1m_start: $load-start,
              load_1m_end: $load-end,
              load_1m_bound: $bound,
              benchmarks: $benchmarks}]
  [= $text [$json:emit-with-opts $report {indent: 2, sort-keys: true}]]
  [?if [= $output '']
    [then [?let [= $_p [$say $text]] [$env:exit 0]]]
    [else [?let [= $_w [$io:write-file $output [$cat ($text, '\n')]]]
      [$env:exit 0]]]]]
