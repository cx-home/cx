# scripts/check_verification_budget.cx — the verification-cost BUDGET step
# (#1562, RULED: VCOST-1, CXF-1).
#
# The owner's sentence is "the fixture grader ≤ 20 min, a selected post-merge
# run ≤ 20 min, the union ≤ 60 min", and VCOST-1 says it out loud: a written
# bound "has to be a step or it is a wish". This is the step.
#
# TWO inputs, both data:
#   * scripts/verification_budget.cxd — the BOUNDS, one row each, carrying the
#     measurement that set it and the issue that last moved it. A bound moves
#     only in a commit that names why.
#   * vcx/target/verification_timings.cxd — the MEASUREMENTS a run leaves
#     behind: [timing name= seconds= load= at=]. Written by whatever ran, read
#     here; absent, there is nothing to judge.
#
# THE JUDGING RULE (cx-private#1903, owner 2026-10-09 13:15Z: "every
# repository's pre-merge run back to 20 minutes or under, the budget enforced by
# a gate step"; its acceptance: "measured over five runs"; the owner's
# BUDGET-LOAD = (a), 2026-10-10 12:44Z, on #1917). A bound is judged on the
# MEDIAN of its last FIVE QUIET measurements — rows taken at a one-minute load
# at or under the perf load bound (LOAD-BOUND: $CX_BENCH_MAX_LOAD, else 8, the
# #1450 rule the time rows of perf-pair and compare_bench judge by):
#   * five or more quiet rows of the bound's name → the median of the last five
#     JUDGES. Over the bound, the step FAILS.
#   * one to four quiet rows                      → MEASURING (n of 5), reported,
#     never failing: one slow run is noise, five are the run.
#   * a LOADED row (load over the bound, or no readable load — the writers
#     record 999 for that, the fail-safe direction) is RECORDED and reported on
#     its own line, "not judged (load N)", and never reds the step.
#   * a row stamped before its bound's rows-from= (ROWS-FROM below, #1917) is
#     reported "not judged (written before …)" and counts as neither.
# Why (a): from #1903 to BUDGET-LOAD every row judged at any load, and on a box
# that five to seven streams share the same union read 1,062 s at load 1.9 and
# 6,189 s at load 55-110 on the next tick (2026-10-10): the budget step was red
# on how busy the box was, not on what the union costs. The 1,200 s bound did
# not move; what moved is which ticks may speak to it. The writers keep the
# last five quiet rows of a name beside its last five rows (verification_
# timings_lib.sh, flows/private-acts.cx), so loaded ticks never push the quiet
# ones out of the file before five of them exist.
#
# A bound with NO timing is reported as unmeasured and does not fail — a gate
# that reds because a measurement is missing punishes the run that did not take
# one, and the runs that take them are post-merge.
#
# Exit 0 when every judging measurement is within its bound; 1 when one is over;
# 2 on a malformed manifest.
#
# `--allow-write` as well as `--allow-read`, and it is not decoration: the
# report goes out through `[$io:write-line [$env:stdout] …]`, which charges
# `write` like any other io. Run with `--allow-read` alone, EVERY report line is
# a CXER0271 bound to a name nothing reads — so the step prints nothing and
# exits 0, which is a gate that cannot speak. Measured here before it was
# wired; the sibling gates all take both grants for the same reason.
#
# `--allow-env` joins them with issue 1582: the timings PATH is read from
# $CX_VERIFICATION_TIMINGS when it is set, so the self-test can plant under its
# own temporary directory instead of at the path a step running beside it in the
# same storm is reading.
#
#   cx --allow-read --allow-write --allow-env scripts/check_verification_budget.cx
#   (or: make check-verification-budget)

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/fp'      as=fp]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=public impure ($s) [$io:write-line [$env:stderr] $s]]

# RUNS: how many of a bound's latest measurements its median is taken over,
# and the fewest it judges on (the writers keep this many rows per name).
[?const RUNS 5]

[?const BOUNDS-FILE 'scripts/verification_budget.cxd']

# LOAD-BOUND: the one-minute load at or under which a row is QUIET and judges
# (BUDGET-LOAD = (a); the #1450 bound perf-pair's time rows use, overridable the
# same way). row-load reads a row's load as a float; an absent or unreadable
# one is 999, which is loaded — a number nobody can defend never reds a run.
[?def load-bound scope=public impure () [$env:var-float 'CX_BENCH_MAX_LOAD' 8.0e0]]
[?def row-load scope=public ($t)
  [?let [= $raw [$string [?else $t@load '']]]
    [?if [= $raw ''] [then 999.0e0]
      [else [* [?else [$strings:to-float $raw] 999.0e0] 1.0e0]]]]]
[?def load-bound-text scope=public impure () [$env:var-or-default 'CX_BENCH_MAX_LOAD' '8']]
[?def quiet-row scope=public ($t $lb)
  [?let [= $l [$row-load $t]] [and [>= $l 0.0e0] [<= $l $lb]]]]

# ROWS-FROM (cx-private#1917): a bound row may carry rows-from=<UTC stamp>,
# after which every row of that name was written under the rules the bound now
# relies on. A row stamped before it (or with no at= to place it) is reported
# "not judged (written before …)" and is neither quiet nor loaded: it cannot
# say what the bound needs it to say. The union and selected-run rows up to
# the 2ddbf280c tick (ended 14:49:39Z) were written by a verdict that (1) wrote
# a row even when a red stopped the run before its serial tail (e12dd4148), so
# 956 s and 1,694 s were the steps before the tail, not the union, and (2) read
# the load at the run's start only (497a6f4c9), so 3c2523d22's 10,733 s run at
# load 82-520 read quiet at 3.25. The rules take effect one tick late: launchd
# starts `cx flow run` in the checkout before its pull, so a tick runs the acts
# of the head before it, and the 2ddbf280c tick still wrote 1,210 s with its
# tail unrun. The bound's seconds do not move; which rows may speak to it does,
# the discipline of BUDGET-LOAD. ISO-8601 UTC stamps of one shape sort as strings.
[?def early-row scope=public ($t $from)
  [?if [= $from ''] [then false]
    [else [?let [= $at [$string [?else $t@at '']]]
      [or [= $at ''] [< $at $from]]]]]]

# TIMINGS-DEFAULT is where a run leaves its measurements, and $CX_VERIFICATION_TIMINGS
# names another file instead (issue 1582). The default does not move: the
# Makefile step, the runner and the fixture grader all keep the one path.
#
# The override exists because the SELFTEST used to plant its five cases at that
# very path, in the same -j storm as this step: an over-bound idle row planted
# by the self-test, read by the step running beside it, reds a union on a
# measurement nobody took. A test that writes the thing another step is reading
# is not a test of either. With this, the self-test plants under its own mktemp
# directory and the real path is never written by anything but a run.
#
# It is an override of a PATH, never of a verdict: a named file is read exactly
# as the default one is, and a file that is not there is "nothing measured" the
# same way.
[?const TIMINGS-DEFAULT 'vcx/target/verification_timings.cxd']

# mins renders seconds as a minutes-and-seconds string for the report.
# the median of a non-empty sequence of ints (the lower middle for an even count)
[?def median-int scope=public pure ($xs)
  [?let [= $s [?to-sequence [$sort $xs]]] [= $n [$count $s]]
    [$nth $s [+ [$div [- $n 1] 2] 1]]]]

[?def mins scope=public ($s) [$cat ([$string [$div $s 60]], 'm', [$string [$mod $s 60]], 's')]]

[?let
  [= $bsrc [?fallback [$io:read-file BOUNDS-FILE]
             [recover-with ([$cry [$cat ('check-verification-budget: cannot read ', BOUNDS-FILE)]],
                            [$env:exit 2], '')]]]
  [= $bdoc [?fallback [$cx:parse $bsrc]
             [recover-with ([$cry [$cat ('check-verification-budget: ', BOUNDS-FILE, ' does not parse')]],
                            [$env:exit 2], null)]]]
  [= $bounds [?to-sequence [?for [in $b $bdoc//bound] [yield $b]]]]
  [= $_nb [?if [= [$count $bounds] 0]
    [then ([$cry [$cat ('check-verification-budget: ', BOUNDS-FILE, ' declares no [bound] row')]],
           [$env:exit 2])]
    [else ()]]]

  # The timings are optional: a tree that has run nothing has nothing to judge.
  [= $timings-file [$env:var-or-default 'CX_VERIFICATION_TIMINGS' TIMINGS-DEFAULT]]
  [= $tsrc [?fallback [$io:read-file $timings-file] [recover-with '']]]
  [= $tdoc [?if [= $tsrc ''] [then null] [else [?fallback [$cx:parse $tsrc] [recover-with null]]]]]
  [= $timings [?if [= $tsrc ''] [then ()]
    [else [?to-sequence [?for [in $t $tdoc//timing] [yield $t]]]]]]

  [= $_h [$say [$cat ('check-verification-budget: ', [$string [$count $bounds]], ' bound(s), ',
                      [$string [$count $timings]], ' measurement(s), the median of the last ', [$string RUNS],
                      ' quiet ones (load <= ', [$load-bound-text], ') judges',
                      ', timings ', $timings-file)]]]

  # One verdict per bound.
  # A FAMILY bound (cx-private#1903): a name ending in `*` is one bound per
  # measured name it prefixes — `premerge-*` judges each premerge-<repo> row's
  # median on its own (scripts/premerge_record.cx writes them). With no
  # measured name under it, the family reports itself unmeasured.
  [= $judged [?to-sequence [?for [in $b $bounds]
    [= $bn [$string $b@name]]
    [= $fam [$strings:ends-with $bn '*']]
    [= $pre [?if $fam [then [$strings:slice $bn 1 [- [$strings:length $bn] 1]]] [else '']]]
    [= $members [?if $fam
                  [then [?to-sequence [$distinct [?to-sequence [?for [in $t $timings]
                          [where [$strings:starts-with [$string $t@name] $pre]] [yield [$string $t@name]]]]]]]
                  [else ()]]]
    [in $j [?if [or [not $fam] [= [$count $members] 0]] [then ($b)]
             [else [?to-sequence [?for [in $m $members] [yield [bound name=$m seconds=[$string $b@seconds]]]]]]]]
    [yield $j]]]]
  [= $lb [$load-bound]]
  [= $over [?to-sequence [?for [in $b $judged]
    [= $name [$string $b@name]]
    [= $limit [$str-to-int [$string $b@seconds]]]
    [= $from [$string [?else $b@rows-from '']]]
    [= $all [?to-sequence [?for [in $t $timings]
                [where [= [$string $t@name] $name]] [yield $t]]]]
    [= $early [?to-sequence [?for [in $t $all] [where [$early-row $t $from]] [yield $t]]]]
    [= $cur [?to-sequence [?for [in $t $all] [where [not [$early-row $t $from]]] [yield $t]]]]
    [= $quiet [?to-sequence [?for [in $t $cur] [where [$quiet-row $t $lb]] [yield $t]]]]
    [= $loaded [?to-sequence [?for [in $t $cur] [where [not [$quiet-row $t $lb]]] [yield $t]]]]
    [= $hits [?if [> [$count $quiet] RUNS] [then [?to-sequence [?drop [- [$count $quiet] RUNS] $quiet]]] [else $quiet]]]
    [= $ss [?to-sequence [?for [in $t $hits] [yield [$str-to-int [$string $t@seconds]]]]]]
    [= $secs [?if [= [$count $hits] 0] [then 0] [else [$median-int $ss]]]]
    [= $loads [$strings:join [?to-sequence [?for [in $t $hits] [yield [$string [?else $t@load '?']]]]] ' ']]
    [= $judges [>= [$count $hits] RUNS]]
    [= $line [?if [= [$count $all] 0]
      [then [$cat ('  ', $name, '  bound ', [$mins $limit], '  — NOT MEASURED (nothing to judge)')]]
      [else [?if [= [$count $cur] 0]
        [then [$cat ('  ', $name, '  bound ', [$mins $limit], '  — NO ROW SINCE ', $from, ' (', [$string [$count $early]],
                     ' written before it, judged by none)')]]
      [else [?if [= [$count $hits] 0]
        [then [$cat ('  ', $name, '  bound ', [$mins $limit], '  — NO QUIET RUN (', [$string [$count $loaded]],
                     ' loaded, judged by none; the load bound is ', [$load-bound-text], ')')]]
        [else [$cat ('  ', $name, '  bound ', [$mins $limit], '  median ', [$mins $secs],
                   ' of ', [$string [$count $hits]], ' quiet (', [$strings:join [?to-sequence [?for [in $x $ss] [yield [$mins $x]]]] ' '],
                   ')  loads ', $loads,
                   [?if $judges
                     [then [?if [> $secs $limit] [then '  OVER BOUND'] [else '  ok']]]
                     [else [$cat ('  (MEASURING — ', [$string [$count $hits]], ' of ', [$string RUNS], ' quiet runs; judges nothing yet)')]]])]]]]]]]]
    [= $_p [$say $line]]
    [= $_e [?for [in $t $early]
      [yield [$say [$cat ('    not judged (written before ', $from, '): ',
                          [$mins [$str-to-int [$string $t@seconds]]], ' at ', [$string [?else $t@at '?']],
                          ' load ', [$string [?else $t@load '?']])]]]]]
    [= $_l [?for [in $t $loaded]
      [yield [$say [$cat ('    not judged (load ', [$string [?else $t@load '?']], '): ',
                          [$mins [$str-to-int [$string $t@seconds]]], ' at ', [$string [?else $t@at '?']])]]]]]
    [where [and $judges [> $secs $limit]]]
    [yield [over name=$name limit=$limit measured=$secs]]]]]

  [?if [> [$count $over] 0]
    [then ([$cry ''],
           [$cry [$cat ('check-verification-budget FAILED — ', [$string [$count $over]],
                        ' bound(s) whose median of ', [$string RUNS], ' quiet runs is over:')]],
           [?for [in $o $over]
             [yield [$cry [$cat ('  ', [$string $o@name], ': ', [$mins [$str-to-int [$string $o@measured]]],
                                 ' against a bound of ', [$mins [$str-to-int [$string $o@limit]]])]]]],
           [$cry '  The bound is not the thing to change. Raising a row because a run exceeded it'],
           [$cry '  is the ratchet running backwards; a row moves only in a commit that names why'],
           [$cry [$cat ('  (', BOUNDS-FILE, ' carries the measurement that set each and the issue that last moved it).')]],
           [$env:exit 1])]
    [else ([$say [$cat ('check-verification-budget OK — no bound whose median of ', [$string RUNS], ' quiet runs is over')]],
           [$env:exit 0])]]]
