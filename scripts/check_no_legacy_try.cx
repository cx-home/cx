# scripts/check_no_legacy_try.cx — the NO-LEGACY-TRY gate (SAP C3c).
#
# The [?try]/[catch]/[on-error] surfaces are retired; this guard fails the
# suite if either reappears in the corpus.
#
# Token-aware, NOT a raw grep (review-M8): it matches only
#   - the directive opener `[?try` NOT continued by `-` (so the channel
#     directives `[?try-send]` / `[?try-receive]` pass), and
#   - the for-clause opener `[on-error` NOT followed by a quoted string
#     (the CSV/delimited dialect option `[on-error "raise"]` /
#     `[on-error 'collect']` is a data attribute, not the retired clause).
# RE2 has no lookahead, so each "NOT followed by" is an optional capture
# group on the follower: a match whose group is ABSENT is the retired form.
#
# Scope: conformance/ + docs-src/ + examples/ + lang/** (excl. lang/_archived).
# The live spec/ tree is owned by the NO-LEGACY-SPEC audit (tombstones + the
# retirement prose live there legitimately) and is not scanned here.
#
# Allowlist: the two enforced negative fixtures in conformance/code.cxd that
# PIN the retirement (program-sap-try-01/02) and their section comment.
#
# Exit 0 clean; 1 with hits. Run from the repo root:
#   vcx/target/cx --allow-read --allow-write scripts/check_no_legacy_try.cx
# (or: make check-no-legacy-try)

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/fp'      as=fp]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$io:write-line [$env:stdout] $s]]
[?def matched scope=public ($m) [> [?else $m@start -1] -1]]

# retired-hit: any match in $ms whose optional follower group is ABSENT
# (the retired bare form; a matched group is the live/allowed form).
[?def retired-hit scope=public ($ms)
  [> [$count [?for [in $m $ms]
       [where [= [?else [$re:group $m 1] "ABSENT"] "ABSENT"]]
       [yield 1]]] 0]]

[?let
  [= $scan-dirs ("conformance", "docs-src", "examples", "lang")]
  [= $text-exts (".cx", ".cxd", ".cxs", ".md", ".txt", ".py", ".go", ".rs",
                 ".v", ".ts", ".js", ".json", ".yaml", ".yml", ".toml", ".sh")]

  # `[?try` not continued by `-` (try-send / try-receive are live channel
  # ops): optional capture of the `-`; absent group = retired directive.
  [= $try-rx [$re:compile "\\[\\?try(-)?"]]
  # `[on-error` not followed by a quoted string (CSV dialect option form):
  # optional capture of the quote follower; absent group = retired clause.
  [= $on-error-rx [$re:compile "\\[on-error(\\s+[\"'])?"]]
  # Whole-file prescan (either opener anywhere) — most files skip cheaply.
  [= $prescan-rx [$re:compile "\\[\\?try|\\[on-error"]]

  # (file-relpath, substring) pairs ALLOWED to carry the retired tokens —
  # the negative fixtures pinning the retirement itself.
  [= $allow (
    [a f="conformance/code.cxd" sub="[?try [/ 10 0] [catch $err 0]]"],
    [a f="conformance/code.cxd" sub="[?for [in $x (1, 2)] [on-error $e skip] [yield [/ 10 $x]]]"],
    [a f="conformance/code.cxd" sub="[?try]/[catch]/[on-error] RETIRED"],
    # The Rust binding's SAP parity smoke test pins the retirement the same
    # way the conformance negative does — the retired directive must be
    # rejected.
    [a f="lang/rust/cxlib/tests/program_eval.rs" sub="[?try [/ 10 0] [catch $err 0]]"])]

  # Whole files allowed to REFERENCE the retired tokens: the SAP coverage
  # map (documents the retirement negatives) and the append-only stdlib
  # findings log (historical records predating the retirement).
  [= $allow-files ("conformance/SAP_COVERAGE.md", "conformance/stdlib/SPEC-FINDINGS.md")]

  [= $files
    [$fp:flat-map $scan-dirs [?fn ($d)
      [$fp:flat-map $text-exts [?fn ($e)
        [?for [in $p [$io:glob [$cat ($d, "/**/*", $e)]]]
          [where [not [$strings:starts-with $p "lang/_archived/"]]]
          [yield $p]]]]]]]

  [= $hits
    [$fp:flat-map $files [?fn ($f)
      [?let [= $text [?fallback [$io:read-file $f] [recover-with ""]]]
        [?if [not [$matched [$re:find $prescan-rx $text]]]
          [then ()]
          [else
            [?let [= $in-allow-file
                    [> [$count [?for [in $af $allow-files] [where [= $af $f]] [yield 1]]] 0]]
              [?if $in-allow-file
                [then ()]
                [else
                  [?let [= $lines [$strings:split-lines $text]]
                    [?for [in $i [$range 1 [$count $lines]]]
                      [= $line $lines[$i]]
                      [where [or [$retired-hit [$re:find-all $try-rx $line]]
                                 [$retired-hit [$re:find-all $on-error-rx $line]]]]
                      [where [= [$count [?for [in $a $allow]
                                  [where [and [= [$string $a@f] $f]
                                              [$strings:contains $line [$string $a@sub]]]]
                                  [yield 1]]] 0]]
                      [yield [$cat ($f, ":", [$string $i], ": ", [$strings:trim-end $line])]]]]]]]]]]]]]

  [?if [> [$count $hits] 0]
    [then
      [?let
        [= $_h [$say "NO-LEGACY-TRY gate FAILED — retired [?try]/[on-error] surface found:"]]
        [= $_l [?for [in $h $hits] [yield [$say [$cat ("  ", $h)]]]]]
        [= $_t [$say [$cat ([$string [$count $hits]],
                            " hit(s). Handling unifies on [?match]/[?else]/[?fallback]/",
                            "[?with-error-hook] + ?/! (spec/core/code.md §9.3).")]]]
        [$env:exit 1]]]
    [else
      [?let [= $_ok [$say "NO-LEGACY-TRY gate OK — no retired [?try]/[on-error] surface in corpus."]]
        [$env:exit 0]]]]]
