# scripts/secrets_scan.cx — the SECRETS-SCAN gate (K13, RULED: D59a, RS-28,
# CXF-1: the public-flip precondition — each component repository flips
# public at the v0.18.0 cut only after its own check-no-consumer-terms and a
# secrets scan over its tree).
#
# Scans a tree's tracked files (`--root <path>`, default ".") for six secret
# shapes: a PEM-style private-key block, an AWS `AKIA…` access key id, a
# GitHub `ghp_`/`github_pat_` token, a Slack `xox[abp]-` token, the generic
# `(api|secret|access)[_-]?(key|token) [:=] '...'` assignment, a tracked
# `.pem`/`.p12`/`.key` file (the shape is the file existing, not its
# content), and a `.env`/`.env.*` file that carries at least one VALUE line
# (an empty template is not a secret). `--history` additionally scans every
# BLOB reachable from the tree's `main` (falling back to `HEAD` when `main`
# does not resolve — a secret deleted from HEAD but still reachable is still
# a leak).
#
# Each hit prints `<path>[@<blob>]: <line> [<shape>]`, `ALLOWED ` prefixed
# when its fingerprint is on the allowlist. Exit 1 when any hit is NOT
# allowlisted; exit 0 when clean or every hit is allowlisted; exit 2 on an
# environment fault (git unavailable, a git call failed).
#
# Allowlisting is by EXACT FINGERPRINT ONLY (scripts/secrets_scan_allow.cxd,
# read relative to the invoking checkout, never the scanned `--root`) —
# never by path, because a path-pattern allowlist stops meaning anything the
# day a real secret lands next to a test fixture. A content-shape hit's
# fingerprint is the sha256-hex of the exact matched TEXT (so the same test
# key reused across files/history shares one row); a filename-shape hit's
# (.pem/.p12/.key, .env) fingerprint is the sha256-hex of the whole file's
# content. `secrets_scan_allow.cxd` rows: `[allow fingerprint=<hex>
# why='<why this exact value is a known fixture, e.g. the corpus file that
# needs it>']`.
#
# --self-test (fixture first, wired into `make secrets-scan`) plants one of
# each of the seven shapes in a scratch git tree and proves every one is
# caught; a second scratch tree proves a secret file deleted after being
# committed is invisible to the tracked-file scan and caught only by
# --history; a third proves an exact-fingerprint allowlist entry suppresses
# only the one secret VALUE it names, not the shape in general.
#
# Usage (run from the checkout that carries this script; `--root` is the
# tree being GRADED, which need not be this one):
#   cx --allow-read --allow-write --allow-subprocess --allow-env \
#     scripts/secrets_scan.cx --root <path> [--history]
#   cx --allow-read --allow-write --allow-subprocess --allow-env \
#     scripts/secrets_scan.cx --self-test
# (or: make secrets-scan)

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/re'      as=re]
[?lib 'cx-stdlib/strings' as=strings]
[?lib 'cx-stdlib/path'    as=path]
[?lib 'cx-stdlib/fp'      as=fp]
[?lib 'cx-stdlib/map'     as=map]
[?lib 'cx-stdlib/process' as=process]
[?lib 'cx-stdlib/hash'    as=hash]
[?lib 'cx-stdlib/cx'      as=cx]

[?def say scope=private impure ($s) [$io:write-line [$env:stdout] $s]]
[?def cry scope=private impure ($s) [$io:write-line [$env:stderr] $s]]
[?def cat scope=private pure ($parts) [$strings:join $parts '']]

[?def matched scope=private pure ($m) [> [?else $m@start -1] -1]]

[?def member scope=private pure [returns bool] ($x $xs)
  [> [$count [?for [in $y $xs] [where [= $y $x]] [yield 1]]] 0]]

[?def nonblank scope=private pure ($text::string)
  [?for [in $l [$strings:split-lines $text]]
    [where [not [= [$strings:trim $l] ""]]]
    [yield [$strings:trim $l]]]]

# run-git: exit 2 on a non-zero status or a process fault — every git call
# this gate makes (besides ref-resolves, whose failure is ordinary) is one
# whose failure means the environment is wrong, not the tree.
[?def run-git scope=private impure ($dir::string $argv $what::string)
  [?let
    [= $full ("git", "-C", $dir, [?splice $argv])]
    [= $r [?fallback [$process:run $full]
            [recover-with ([$cry [$cat ("secrets-scan: cannot run git (", $what, ")")]],
                           [$env:exit 2], null)]]]
    [?if [not [= [$string $r@exit-code] "0"]]
      [then [?let [= $_f ([$cry [$cat ("secrets-scan: git ", $what, " failed (exit ",
                                       [$string $r@exit-code], ")")]],
                          [$cry [$string $r@stderr]])]
              [?let [= $_x [$env:exit 2]] ""]]]
      [else [$string $r@stdout]]]]]

[?def ref-resolves scope=private impure ($dir::string $ref::string)
  [?let
    [= $target [$cat ($ref, "^{commit}")]]
    [= $full ("git", "-C", $dir, "rev-parse", "--verify", "-q", $target)]
    [= $r [$process:run $full]]
    [= [$string $r@exit-code] "0"]]]

[?def history-branch scope=private impure ($dir::string)
  [?if [$ref-resolves $dir "main"] [then "main"] [else "HEAD"]]]

# ── the shapes (brief item 1) ────────────────────────────────────────────
[?def rx-private-key scope=private pure () [$re:compile "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----"]]
[?def rx-akia         scope=private pure () [$re:compile "AKIA[0-9A-Z]{16}"]]
[?def rx-gh-token      scope=private pure () [$re:compile "(ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"]]
[?def rx-slack         scope=private pure () [$re:compile "xox[abp]-[A-Za-z0-9-]{10,}"]]
[?def rx-generic       scope=private pure ()
  [$re:compile "(api|secret|access)[_-]?(key|token)\\s*[:=]\\s*['\"][A-Za-z0-9/+_-]{16,}"]]

# A shape RECORD (name= and rx= attributes) can't hold the compiled regex --
# record attributes are scalar-only (code.md §6.4.1) and a regex is not a
# scalar -- so each shape is a plain (name, rx) PAIR instead.
[?def content-shapes scope=private pure ()
  (("private-key-block", [$rx-private-key]),
   ("akia",              [$rx-akia]),
   ("github-token",      [$rx-gh-token]),
   ("slack-token",       [$rx-slack]),
   ("generic-secret",    [$rx-generic]))]

[?def key-file scope=private pure [returns bool] ($p::string)
  [$member [$strings:lower [$path:extension $p]] (".pem", ".p12", ".key")]]

[?def env-basename scope=private pure [returns bool] ($p::string)
  [?let [= $b [$path:basename $p]]
    [or [= $b ".env"] [$strings:starts-with $b ".env."]]]]

[?def env-value-rx scope=private pure () [$re:compile "^[A-Za-z_][A-Za-z0-9_]*=.+"]]

# has-env-value: true when some LINE of $text matches env-value-rx — checked
# per line (not `^...$` over the whole text) because a trailing newline
# stops `$` matching the last line's own end.
[?def has-env-value scope=private pure ($text::string)
  [?let [= $rx [$env-value-rx]]
    [> [$count [?for [in $l [$strings:split-lines $text]]
                 [where [$matched [$re:find $rx $l]]]
                 [yield 1]]] 0]]]

# scan-text: every content-shape hit in $text, one per matching LINE per
# shape — a line two shapes both match yields two hits, each named.
# fp-basis: the text a hit's fingerprint is computed FROM. For every
# single-line shape the matched substring IS the secret, so two different
# secrets never collide. "private-key-block" is the one shape whose regex
# matches only a fixed HEADER LINE ("-----BEGIN RSA PRIVATE KEY-----") that
# is byte-identical across every RSA key that ever existed — fingerprinting
# the header would allowlist every RSA key ever, once. Its fingerprint basis
# is the whole file's content instead, like the two filename shapes below.
[?def fp-basis scope=private pure ($sh-name::string $text::string $matched-text::string)
  [?if [= $sh-name "private-key-block"] [then $text] [else $matched-text]]]

[?def scan-text scope=private pure ($p::string $blob::string $text::string)
  [?let [= $lines [$strings:split-lines $text]]
    [$fp:flat-map [$content-shapes] [?fn ($sh)
      [?let [= $sh-name [$nth $sh 1]] [= $sh-rx [$nth $sh 2]]
        [?for [in $l $lines]
          [= $m [$re:find $sh-rx $l]]
          [where [$matched $m]]
          [yield [hit shape=$sh-name path=$p blob=$blob
                      line=[$strings:trim-end $l]
                      match=[$fp-basis $sh-name $text [$re:group $m 0]]]]]]]]]]

# file-shape-hits: the two FILENAME shapes. A .pem/.p12/.key file always
# hits — the shape is the file existing. A .env*/env file hits only when it
# carries at least one VALUE line (an empty template is not a secret). Both
# fingerprint on the whole file's content, so an identical fixture reused
# under a different path or blob still shares one allowlist row.
[?def file-shape-hits scope=private pure ($p::string $blob::string $text::string)
  [?let
    [= $kf [?if [$key-file $p]
             [then ([hit shape="keyfile" path=$p blob=$blob line="(file)" match=$text])]
             [else ()]]]
    [= $ef [?if [and [$env-basename $p] [$has-env-value $text]]
             [then ([hit shape="envfile" path=$p blob=$blob line="(file)" match=$text])]
             [else ()]]]
    ([?splice $kf], [?splice $ef])]]

[?def fingerprint scope=private pure ($h) [$hash:format-hex [$hash:sha256-string $h@match]]]

# ── tracked-tree scan ────────────────────────────────────────────────────
[?def scan-one-file scope=private impure ($root::string $p::string)
  [?let
    [= $text [?fallback [$io:read-file [$cat ($root, "/", $p)]] [recover-with ""]]]
    ([?splice [$scan-text $p "" $text]], [?splice [$file-shape-hits $p "" $text]])]]

[?def scan-tree scope=private impure ($root::string)
  [?let
    [= $paths [$nonblank [$run-git $root ("ls-files") "ls-files"]]]
    [$fp:flat-map $paths [?fn ($p) [$scan-one-file $root $p]]]]]

# ── history scan: every blob reachable from main (or HEAD) ─────────────
[?def blob-list scope=private impure ($dir::string $branch::string)
  [?let
    [= $revlist [$run-git $dir ("rev-list", "--objects", $branch) "rev-list --objects"]]
    [= $bc-argv ("git", "-C", $dir, "cat-file", "--batch-check=%(objectname) %(objecttype) %(rest)")]
    [= $bc [?fallback [$process:run $bc-argv stdin=$revlist]
             [recover-with ([$cry "secrets-scan: cat-file --batch-check failed"],
                            [$env:exit 2], null)]]]
    [= $lines [$nonblank [$string $bc@stdout]]]
    [?for [in $l $lines]
      [= $parts [$strings:split-limit $l " " 3]]
      [where [= [$count $parts] 3]]
      [where [= [$nth $parts 2] "blob"]]
      [yield [blobref sha=[$nth $parts 1] path=[$nth $parts 3]]]]]]

# dedup-blobs: the SAME blob sha can be listed once per commit/path that
# carries it; scan its content once, keeping the first path seen for
# reporting — the identifying fact for a hit is the blob sha, which anyone
# can verify with `git cat-file -p <sha>` regardless of which path it shows.
[?def dedup-blobs scope=private pure ($refs)
  [?let
    [= $m [$fp:fold $refs {}
      [?fn ($acc $r) [?if [$map:contains $acc $r@sha] [then $acc] [else [$map:put $acc $r@sha $r@path]]]]]]
    [?for [in $sha [$map:keys $m]] [yield [blobref sha=$sha path=[$map:get $m $sha]]]]]]

# A blob that is not valid UTF-8 text (a binary file — png, a compiled
# artifact, …) is SKIPPED for content, exactly like scan-one-file skips an
# undecodable tracked file: `$process:run`'s default encoding refuses with
# CXER4008 rather than hand back mangled text, and that refusal is not an
# environment fault, so it does not go through run-git (which would exit 2).
# A key-file/env-file shape is filename-driven and still checked on "".
[?def scan-one-blob scope=private impure ($dir::string $r)
  [?let
    [= $text [?fallback [$process:run ("git", "-C", $dir, "cat-file", "-p", $r@sha)]@stdout
               [recover-with ""]]]
    ([?splice [$scan-text $r@path $r@sha $text]], [?splice [$file-shape-hits $r@path $r@sha $text]])]]

[?def scan-history scope=private impure ($dir::string)
  [?let
    [= $branch [$history-branch $dir]]
    [= $refs [$dedup-blobs [$blob-list $dir $branch]]]
    [$fp:flat-map $refs [?fn ($r) [$scan-one-blob $dir $r]]]]]

# ── allowlist ─────────────────────────────────────────────────────────
[?def load-allow scope=private impure ()
  [?fallback
    [?for [in $a [$cx:parse [$io:read-file "scripts/secrets_scan_allow.cxd"]]//allow]
      [yield [$string $a@fingerprint]]]
    [recover-with ()]]]

[?def allowed scope=private pure ($fps $fp::string) [$member $fp $fps]]

# ── run + report ──────────────────────────────────────────────────────
[?def loc-of scope=private pure ($h) [?if [= $h@blob ""] [then $h@path] [else [$cat ($h@path, "@", $h@blob)]]]]

[?def run-scan scope=private impure ($root::string $do-history::bool)
  [?let
    [= $tree-hits [$scan-tree $root]]
    [= $hist-hits [?if $do-history [then [$scan-history $root]] [else ()]]]
    [= $all ([?splice $tree-hits], [?splice $hist-hits])]
    [= $allow-fps [$load-allow]]
    [= $_print [?for [in $h $all]
      [= $fp [$fingerprint $h]]
      [= $tag [?if [$allowed $allow-fps $fp] [then "ALLOWED "] [else ""]]]
      [yield [$say [$cat ($tag, [$loc-of $h], ": ", $h@line, " [", $h@shape, " fp=", $fp, "]")]]]]]
    [= $failing [?for [in $h $all] [where [not [$allowed $allow-fps [$fingerprint $h]]]] [yield $h]]]
    [?if [> [$count $failing] 0]
      [then [?let
        [= $_s [$cry [$cat ("secrets-scan: FAILED — ", [$string [$count $failing]],
                            " unallowlisted hit(s) of ", [$string [$count $all]], " total")]]]
        [$env:exit 1]]]
      [else [?let
        [= $_ok [$say [$cat ("secrets-scan: OK — ", [$string [$count $all]],
                             " hit(s), all allowlisted by fingerprint (or none found)")]]]
        [$env:exit 0]]]]]]

# ── self-test (fixture first) ───────────────────────────────────────────
[?def git-ident scope=private pure ()
  ("-c", "user.name=selftest", "-c", "user.email=selftest@example.invalid", "-c", "commit.gpgsign=false")]

[?def commit-all scope=private impure ($root::string $msg::string)
  [?let
    [= $_a [$process:run ("git", "-C", $root, "add", "-A")]]
    [= $_c [$process:run ("git", "-C", $root, [?splice [$git-ident]], "commit", "-q", "-m", $msg)]]
    ""]]

[?def init-repo scope=private impure ($root::string)
  [?let
    [= $_i [$process:run ("git", "init", "-q", "-b", "main", $root)]]
    [= $_f0 [$io:write-file [$cat ($root, "/README.md")] "seed\n"]]
    [$commit-all $root "seed"]]]

[?def selftest-shapes scope=private impure ()
  [?let
    [= $root [$io:temp-dir "cx-secrets-scan-"]]
    [= $_mk [$init-repo $root]]
    [= $_f1 [$io:write-file [$cat ($root, "/id_rsa")]
              [$cat ("-----BEGIN RSA PRIVATE KEY-----\n", "MIIfakekeymaterialfortest\n", "-----END RSA PRIVATE KEY-----\n")]]]
    [= $_f2 [$io:write-file [$cat ($root, "/aws.txt")] "<redacted-test-shape>\n"]]
    [= $_f3 [$io:write-file [$cat ($root, "/gh.txt")] "<redacted-test-shape>\n"]]
    [= $_f4 [$io:write-file [$cat ($root, "/slack.txt")] "<redacted-test-shape>\n"]]
    [= $_f5 [$io:write-file [$cat ($root, "/config.txt")] [$cat ("api_key = ", "\"abcdefghijklmnop1234\"", "\n")]]]
    [= $_f6 [$io:write-file [$cat ($root, "/server.pem")] "keyfile-shaped path, content does not matter\n"]]
    [= $_f7 [$io:write-file [$cat ($root, "/.env")] "SECRET=shhh\n"]]
    [= $_c1 [$commit-all $root "add one of each shape"]]
    [= $hits [$scan-tree $root]]
    [= $seen [?for [in $h $hits] [yield $h@shape]]]
    [= $want ("private-key-block", "akia", "github-token", "slack-token", "generic-secret", "keyfile", "envfile")]
    [= $missing [?for [in $w $want] [where [not [$member $w $seen]]] [yield $w]]]
    [= $_rm [$io:remove-tree $root]]
    [?if [= [$count $missing] 0]
      [then [?let
        [= $_ok [$say [$cat ("secrets-scan shapes self-test OK — all ", [$string [$count $want]], " shapes caught")]]]
        true]]
      [else [?let
        [= $_f [$cry [$cat ("secrets-scan shapes self-test FAILED — missing: ", [$strings:join $missing ", "])]]]
        false]]]]]

[?def selftest-history scope=private impure ()
  [?let
    [= $root [$io:temp-dir "cx-secrets-scan-hist-"]]
    [= $_mk [$init-repo $root]]
    [= $_f1 [$io:write-file [$cat ($root, "/leaked.key")] "<redacted-test-shape>\n"]]
    [= $_c1 [$commit-all $root "oops, a leaked key file"]]
    [= $_rmf [$io:remove [$cat ($root, "/leaked.key")]]]
    [= $_c2 [$commit-all $root "remove the leaked file"]]
    [= $tree-hits [$scan-tree $root]]
    [= $hist-hits [$scan-history $root]]
    [= $tree-clean [= [$count $tree-hits] 0]]
    [= $hist-catches [> [$count $hist-hits] 0]]
    [= $_rm [$io:remove-tree $root]]
    [?if [and $tree-clean $hist-catches]
      [then [?let
        [= $_ok [$say "secrets-scan history self-test OK — a leaked file removed after being committed is invisible to the tracked-tree scan and caught only by --history"]]
        true]]
      [else [?let
        [= $_f [$cry [$cat ("secrets-scan history self-test FAILED — tree-hits=", [$string [$count $tree-hits]],
                            " hist-hits=", [$string [$count $hist-hits]])]]]
        false]]]]]

[?def selftest-allowlist scope=private impure ()
  [?let
    [= $root [$io:temp-dir "cx-secrets-scan-allow-"]]
    [= $_mk [$init-repo $root]]
    [= $_f1 [$io:write-file [$cat ($root, "/a.txt")] "<redacted-test-shape>\n"]]
    [= $_f2 [$io:write-file [$cat ($root, "/b.txt")] "AKIAZZZZZZZZZZZZZZZZ\n"]]
    [= $_c1 [$commit-all $root "two distinct akia-shaped values"]]
    [= $hits [$scan-tree $root]]
    [= $hit-a [$first [?for [in $h $hits] [where [$strings:contains $h@line "<redacted-test-shape>"]] [yield $h]]]]
    [= $fp-a [$fingerprint $hit-a]]
    [= $still-failing [?for [in $h $hits] [where [not [$allowed ($fp-a) [$fingerprint $h]]]] [yield $h]]]
    [= $_rm [$io:remove-tree $root]]
    [?if [and [= [$count $hits] 2] [= [$count $still-failing] 1]]
      [then [?let
        [= $_ok [$say "secrets-scan allowlist self-test OK — an exact-fingerprint entry suppresses only the one secret VALUE it names, the other AKIA-shaped hit still fails"]]
        true]]
      [else [?let
        [= $_f [$cry [$cat ("secrets-scan allowlist self-test FAILED — hits=", [$string [$count $hits]],
                            " still-failing-after-allow=", [$string [$count $still-failing]])]]]
        false]]]]]

[?def run-self-test scope=private impure ()
  [?let
    [= $r1 [$selftest-shapes]]
    [= $r2 [$selftest-history]]
    [= $r3 [$selftest-allowlist]]
    [?if [and $r1 [and $r2 $r3]] [then [$env:exit 0]] [else [$env:exit 1]]]]]

# ── argv ──────────────────────────────────────────────────────────────
[?let
  [= $raw-argv [$env:argv]]
  [= $argv [?for [in $i [$range 2 [$count $raw-argv]]] [yield [$nth $raw-argv $i]]]]
  [?if [$member "--self-test" $argv]
    [then [$run-self-test]]
    [else
      [?let
        [= $do-history [$member "--history" $argv]]
        [= $root-idx [?for [in $i [$range 1 [$count $argv]]] [where [= [$nth $argv $i] "--root"]] [yield $i]]]
        [= $root [?if [= [$count $root-idx] 0]
                   [then "."]
                   [else [$nth $argv [+ [$first $root-idx] 1]]]]]
        [$run-scan $root $do-history]]]]]
