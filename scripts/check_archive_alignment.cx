# check_archive_alignment.cx ARCHIVE… — every object member of each ar archive must begin on an
# 8-byte boundary (#1370).
#
# Apple's ld refuses a 64-bit Mach-O archive member that does not:
#   ld: 64-bit mach-o member 'cx_re2_shim.o' not 8-byte aligned in 'libcx_re2_shim.a'
# The GNU-style `ar` that is first on PATH inside devbox pads members to 2 bytes, so an archive it
# writes links under the devbox linker and fails under the Apple toolchain three steps later, in
# code the author never touched. This walks the `ar` headers and fails HERE, loudly, naming the
# member. Exit 0 = every archive aligned; 1 = a member is not (or a file is not an archive);
# 2 = usage.
#
# Layout walked: 8-byte magic `!<arch>\n`, then per member a 60-byte header (name 16 · mtime 12 ·
# uid 6 · gid 6 · mode 8 · size 10 · fmag 2). A BSD long name `#1/N` puts the N-byte name FIRST in
# the data, so the object begins N bytes after the header; GNU `/N` names live in the `//` table
# and the object begins at the header's end. The symbol table (`__.SYMDEF…`, `/`) is data, not
# Mach-O, and is skipped. Members are padded to 2 bytes. (Byte offsets count from 0.)
# CXMACH-1 (owner 2026-10-16, (a)): the cx rewrite of check_archive_alignment.sh, the same lines.

[?lib 'cx-stdlib/io'      as=io]
[?lib 'cx-stdlib/env'     as=env]
[?lib 'cx-stdlib/bytes'   as=bytes]
[?lib 'cx-stdlib/strings' as=strings]

[?def cat scope=public ($parts) [$strings:join $parts '']]
[?def say scope=public impure ($s) [$env:write-line $s]]
[?def field scope=public ($b $from $to) [$strings:trim [$bytes:to-string-latin1 [$bytes:slice $b $from $to]]]]

# walk — the archive's members as [m name= obj=] from offset $off, or [bad at=] on a malformed header.
[?def walk scope=public ($b $size)
  [?loop [= $off 8] [= $acc ()]
    [?if [>= $off $size] [then [break $acc]]
      [else [?let [= $name [$field $b $off [+ $off 16]]]
                  [= $msize [?else [$strings:to-int [$field $b [+ $off 48] [+ $off 58]]] -1]]
              [?if [< $msize 0] [then [break ([?splice $acc], [bad at=$off])]]
                [else [?let [= $data [+ $off 60]]
                            [= $long [$strings:starts-with $name '#1/']]
                            [= $n [?if $long [then [?else [$strings:to-int [$strings:replace-first $name '#1/' '']] 0]] [else 0]]]
                            [= $real [?if $long
                                       [then [$strings:replace [$bytes:to-string-latin1 [$bytes:slice $b $data [+ $data $n]]] "\u0000" '']]
                                       [else $name]]]
                            [= $next [+ $data $msize]]
                        [continue [+ $next [% $next 2]] ([?splice $acc], [m name=$real obj=[+ $data $n]])]]]]]]]]]

[?def check scope=public impure ($a)
  [?if [not [$io:is-file $a]] [then [?let [= $_ [$say [$cat ('check_archive_alignment: ', $a, ': no such file')]]] 1]]
    [else [?let [= $b [$io:read-file-bytes $a]]
                [= $size [$bytes:length $b]]
            [?if [or [< $size 7] [not [= [$bytes:to-string-latin1 [$bytes:slice $b 0 7]] '!<arch>']]]
              [then [?let [= $_ [$say [$cat ('check_archive_alignment: ', $a, ': not an ar archive')]]] 1]]
              [else [?let [= $ms [$walk $b $size]]
                          [= $bad [?for [in $x $ms] [where [= [$name $x] 'bad']] [yield $x]]]
                          [= $objs [?for [in $x $ms]
                                     [where [and [= [$name $x] 'm'] [not [$strings:starts-with $x@name '__.SYMDEF']]
                                                 [not [= $x@name '/']] [not [= $x@name '//']] [not [= $x@name '']]]]
                                     [yield $x]]]
                          [= $mis [?for [in $x $objs] [where [not [= [% $x@obj 8] 0]]]
                                    [yield [?let [= $_ [$say [$cat ('check_archive_alignment: ', $a, ": member '", $x@name, "' begins at byte ",
                                                                    [$string $x@obj], ' (mod 8 = ', [$string [% $x@obj 8]], ") — Apple's ld refuses the archive")]]] 1]]]]
                          [= $_b [?for [in $x $bad] [yield [$say [$cat ('check_archive_alignment: ', $a, ': malformed member header at offset ', [$string $x@at])]]]]]
                          [= $none [and [= [$count $objs] 0] [?let [= $_ [$say [$cat ('check_archive_alignment: ', $a, ': no object members')]]] true]]]
                      [?if [or [> [$count $mis] 0] [> [$count $bad] 0] $none] [then 1] [else 0]]]]]]]]]

[?let
  [= $argv [$env:argv]]
  [= $_u [?if [< [$count $argv] 2]
           [then [?let [= $_ [$io:write-line [$env:stderr] 'usage: check_archive_alignment.cx ARCHIVE...']] [$env:exit 2]]] [else null]]]
  [= $rcs [?for [in $i [$range 2 [$count $argv]]] [yield [$check [$nth $argv $i]]]]]
  [$env:exit [?if [> [?reduce $rcs [using [?fn ($s $x) [+ $s $x]]] [init 0]] 0] [then 1] [else 0]]]]
