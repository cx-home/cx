+    vgc__ws(" faulting_port="); vgc__wh(vgc_thread_self_port()); vgc__ws("\n");
+    vgc_trace_dump();
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+static inline void vgc_trace_init(void) {
+    signal(SIGSEGV, vgc_crash_handler);
+    signal(SIGBUS, vgc_crash_handler);
+}
